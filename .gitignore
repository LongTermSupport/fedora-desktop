environment/localhost/host_vars/localhost.yml
environment/localhost/host_vars/localhost.yml.backup.*
*.secret
.venv/
.idea
roles/vendor/*

# Ansible runtime cache
.ansible/

# Python bytecode cache
__pycache__/
*.pyc
*.pyo

# Claude Code local settings (keep custom commands)
.claude/settings.local.json
.claude.json

# Claude Code hooks daemon - old backups and temporary files
.claude/hooks-daemon.v*-old/
.claude/*.backup
.claude/*.bak
.claude/*.bak*
*.pre-inject
.claude/*.old-broken
.claude/*backup-*

# CCY session data - has self-excluding .gitignore for documentation and safety
.claude/ccy/*
!.claude/ccy/.gitignore

# MCP cache and runtime data
.playwright-mcp/

# CCY patch QA - cached Claude Code npm install (gitignored, rebuild with qa-ctrl-z-patch.bash --update)
scripts/qa-ccy/node_modules/
scripts/qa-ccy/package-lock.json

# Safety net for common sensitive file types
*.key
*.pem
*.crt
*.p12
*.pfx
.env
.env.*
!.env.example
!.env.dist

# Security incident documentation - DO NOT COMMIT
SECURITY-INCIDENT-LOG.md
FORCE-PUSH-REQUIRED.md
*-incident*.md

# Claude Code Hooks Daemon
.claude/hooks-daemon/

# Claude Code managed worktrees
.claude/worktrees/

# Claude Code runtime artifacts (session-local state, never commit)
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json
.claude/routines/.state/
.claude/checkpoints/
.claude/mailbox/
.claude/agent-registry.json
.claude/agent-memory-local
.claude/first-run
.claude/assistant-daemon-state.json

# ClaudeMdInjector backup (session artifact, never commit)
.CLAUDE.md.pre-inject

# Plan-local script output (triage/acceptance/deploy reports).
# The LOGS live in the plan folder so they travel with the plan (see
# CLAUDE/PlanWorkflow.md "Plan-Local Scripts & Artifacts"), but they are NOT
# committed: they are dumps of live host state — unit files, mount points,
# container names, private IPs, SSIDs — and this is a public repository. The
# pre-commit secret scanner would reject most of them anyway.
CLAUDE/Plan/**/logs/
