#!/usr/bin/env bash
# Pre-push hook, two gates over the same ref lines, both judging what reaches the remote, whoever
# committed it and however (--no-verify on a commit, another clone):
#  1. no commit being pushed may carry an install-specific name (team, seat, container, host,
#     client project) in its message or its added lines (Plan 00245 Phase 3);
#  2. the commits being pushed must carry a passing qa-all verdict (push-without-qa-verdict,
#     CLAUDE/QA.md; issue #187).
# Args and stdin are git's: REMOTE URL, then one "LOCALREF LOCALID REMOTEREF REMOTEID" line per ref.
set -euo pipefail

scripts="$(dirname "${BASH_SOURCE[0]}")/.."
refs="$(cat)"
"$scripts/qa-private-names.bash" push "$@" <<<"$refs"
exec "$scripts/qa-push-gate.bash" "$@" <<<"$refs"
