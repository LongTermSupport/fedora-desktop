#!/usr/bin/env bash
# Pre-push hook, three gates over the same ref lines, each judging what reaches the remote, whoever
# committed it and however (--no-verify on a commit, another clone):
#  1. no commit being pushed may carry an install-specific name (team, seat, container, host,
#     client project) in its message or its added lines (Plan 00245 Phase 3);
#  2. no pushed commit's tree may hold a secret CI's gitleaks scan would find (issue #329);
#  3. a protected branch moves only to a commit GitHub CI's QA workflow passed on a push
#     (push-without-qa-verdict, CLAUDE/QA.md), or a docs-only range that a local qa-changed run
#     passed; other refs are not judged.
# Args and stdin are git's: REMOTE URL, then one "LOCALREF LOCALID REMOTEREF REMOTEID" line per ref.
set -euo pipefail

scripts="$(dirname "${BASH_SOURCE[0]}")/.."
refs="$(cat)"
"$scripts/qa-private-names.bash" push "$@" <<<"$refs"
"$scripts/qa-gitleaks.bash" push "$@" <<<"$refs"
exec "$scripts/qa-push-gate.bash" "$@" <<<"$refs"
