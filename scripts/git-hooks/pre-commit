#!/bin/bash
#
# Pre-commit hook: Prevent committing sensitive information to public repository
# This hook scans staged changes for patterns that might leak private information
#

set -euo pipefail

# ANSI color codes
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Repository root (this hook runs from the repo root via core.hooksPath)
REPO_ROOT=$(git rev-parse --show-toplevel)

# Whitelist filtering and the private-identifier denylist are shared with
# commit-msg — see lib/secret-scan.bash for why they must not drift apart.
HOOK_LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/secret-scan.bash"
if [ ! -f "$HOOK_LIB" ]; then
    echo "ERROR: missing $HOOK_LIB — the secret scanner cannot run." >&2
    echo "  Restore it from git; do NOT commit with --no-verify." >&2
    exit 1
fi
# shellcheck source-path=SCRIPTDIR source=lib/secret-scan.bash
source "$HOOK_LIB"

# Sensitive patterns to detect (using generic patterns, no actual sensitive data).
#
# Each entry has the format "pattern::description::guidance" — :: separates the
# three fields (chosen to avoid conflicts with | inside the regexes). The
# guidance string tells the contributor exactly which reserved placeholder to
# use instead, and is printed alongside any match.
#
# The set of accepted example placeholders (IPs, emails, hostnames, usernames)
# is the documented schema in CLAUDE/ExampleValues.md — RFC 5737 IPs, RFC 2606
# domains/emails, RFC 3849 IPv6. Keep the whitelist logic below and that doc in
# sync.
EXAMPLE_DOC="CLAUDE/ExampleValues.md"
RESERVED_IPS="192.0.2.0/24, 198.51.100.0/24 or 203.0.113.0/24 (RFC 5737)"
RESERVED_EMAIL="name@example.com (subdomains like admin@host.example.com are accepted too)"
declare -a SENSITIVE_PATTERNS=(
    # Any real email address. Reserved example domains (example.com/.org/.net and
    # their subdomains), the .example/.test/.invalid/.localhost TLDs, and
    # <...>/{{...}} placeholders are filtered out in the per-pattern logic below.
    "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}::Email address::Use a reserved example email — ${RESERVED_EMAIL}. See ${EXAMPLE_DOC}"

    # Common username patterns with company/personal identifiers
    # Will exclude example_user, test_user, etc. in the script logic below
    "[a-z]{3,}_[a-z]{3,}\\.(token|key|credential)\\b::Specific username in credential filename::Use a placeholder username (example_user, test_user) or {{ user_login }}. See ${EXAMPLE_DOC}"

    # Private key material (PEM blocks of any key type)
    "-----BEGIN [A-Z ]*PRIVATE KEY-----::Private key block::Never commit key material. Remove it and rotate the key if it was real."

    # SSH/API key patterns (actual keys, not references)
    "ssh-rsa [A-Za-z0-9+/=]{50,}::SSH public key::Remove the key. If an example is needed, redact the body to ssh-rsa AAAA...placeholder."
    "ssh-ed25519 [A-Za-z0-9+/=]{50,}::SSH Ed25519 public key::Remove the key. If an example is needed, redact the body to ssh-ed25519 AAAA...placeholder."
    "sk-ant-oat01-[A-Za-z0-9_-]{20,}::Anthropic OAuth token::This is a live credential. Remove it and rotate the token."
    "sk-ant-[a-z0-9-]{50,}::Anthropic API token::This is a live credential. Remove it and rotate the token."
    "ghp_[A-Za-z0-9]{36,}::GitHub personal access token::This is a live credential. Remove it and rotate the token."
    "gho_[A-Za-z0-9]{36,}::GitHub OAuth token::This is a live credential. Remove it and rotate the token."
    "ghs_[A-Za-z0-9]{36,}::GitHub server-to-server token::This is a live credential. Remove it and rotate the token."
    "ghr_[A-Za-z0-9]{36,}::GitHub refresh token::This is a live credential. Remove it and rotate the token."
    "github_pat_[A-Za-z0-9_]{20,}::GitHub fine-grained personal access token::This is a live credential. Remove it and rotate the token."
    "glpat-[A-Za-z0-9_-]{20,}::GitLab personal access token::This is a live credential. Remove it and rotate the token."

    # AWS credentials
    "AKIA[0-9A-Z]{16}::AWS access key ID::This is a live credential. Remove it and rotate the key."

    # Home directory paths (but allow {{ user_login }} and generic placeholders)
    "/home/[a-z][a-z0-9_-]{2,}[^}]::Hardcoded username in path::Use {{ user_login }} or /home/<user>. See ${EXAMPLE_DOC}"

    # Private IP addresses (specific ones, not documentation). The RFC 5737
    # documentation ranges (192.0.2.x / 198.51.100.x / 203.0.113.x) are NOT
    # matched here, so they pass — use those for examples.
    "192\\.168\\.[0-9]{1,3}\\.[0-9]{1,3}::Private IP address (192.168.x.x)::Use a reserved documentation IP — ${RESERVED_IPS}. See ${EXAMPLE_DOC}"
    "10\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}::Private IP address (10.x.x.x)::Use a reserved documentation IP — ${RESERVED_IPS}. See ${EXAMPLE_DOC}"
)

echo "🔍 Scanning staged changes for sensitive information..."

# Get list of staged files (exclude deletions). A failure of this listing must
# fail the hook (this is a security gate), so no error suppression here.
#
# ACM**RT**, not ACM. Rename detection is on by default (diff.renames, git >=
# 2.9), so a `git mv` plus an edit is classified R and was excluded from this
# list entirely — the file was NEVER SCANNED. Reproduced here on git 2.39.5: a
# 40-line file moved and given one extra line reports `R098` and
# `--diff-filter=ACM` returns nothing at all, so the hook printed
# "✓ No files staged for commit" and passed. That is not a corner case in this
# repo: moving a plan folder into Completed/ is exactly `git mv` plus an edit.
# T (typechange) is included for the same reason.
#
# --name-only yields the NEW path for a rename, which is the one that needs
# scanning. Verified, not assumed.
#
# Note a smaller file may fall below the rename-similarity threshold and be
# recorded as D+A instead, in which case the add WAS scanned — which is why this
# hole was easy to miss: it appears and disappears with file size.
mapfile -t STAGED_FILE_LIST < <(git diff --cached --name-only --diff-filter=ACMRT)

if [ ${#STAGED_FILE_LIST[@]} -eq 0 ]; then
    echo "✓ No files staged for commit"
    exit 0
fi

# Newline-joined view, used only for the cheap CCY-script membership grep below.
STAGED_FILES=$(printf '%s\n' "${STAGED_FILE_LIST[@]}")

# ============================================================================
# CCY Version Bump Validation
# ============================================================================
# The CCY script has hash validation to detect modifications without version bumps
# This prevents deployment issues where modified scripts don't get proper version tracking

CCY_SCRIPT="files/var/local/claude-yolo/claude-yolo"

if echo "$STAGED_FILES" | grep -q "^${CCY_SCRIPT}$"; then
    echo "🔍 Checking CCY version bump requirement..."

    # Extract current staged version. Capture the file content FIRST, then parse
    # with awk. Piping a large `git show` straight into `grep -m1` lets grep exit
    # early and SIGPIPE git; under `set -o pipefail` that aborts the whole hook
    # with status 141 — raced intermittently once claude-yolo grew large enough,
    # and silently blocked every commit that stages the CCY script. awk reading a
    # here-string is a single process over a seekable temp file, so there is no
    # pipe head left to SIGPIPE.
    ccy_staged_src=$(git show ":$CCY_SCRIPT")
    STAGED_VERSION=$(awk -F'"' '/^CCY_VERSION=/{print $2; exit}' <<<"$ccy_staged_src")

    # Extract HEAD version (empty if the file does not exist in HEAD).
    HEAD_VERSION=""
    if ccy_head_src=$(git show "HEAD:$CCY_SCRIPT" 2>/dev/null); then
        HEAD_VERSION=$(awk -F'"' '/^CCY_VERSION=/{print $2; exit}' <<<"$ccy_head_src")
    fi

    # If file exists in HEAD and version hasn't changed
    if [ -n "$HEAD_VERSION" ] && [ "$STAGED_VERSION" = "$HEAD_VERSION" ]; then
        # Check if any REAL code line changed (added/removed), ignoring the
        # +++/--- diff headers and lines that are only comments or blank.
        # grep -q . succeeds (exit 0) iff at least one real code line remains.
        if git diff --cached HEAD -- "$CCY_SCRIPT" \
            | grep -E '^[+-]' \
            | grep -vE '^[+-]{3}' \
            | grep -vE '^[+-][[:space:]]*(#|$)' \
            | grep -q .; then
            echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
            echo -e "${RED}COMMIT REJECTED: CCY version bump required${NC}"
            echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
            echo ""
            echo "The CCY script was modified but CCY_VERSION was not bumped."
            echo "Current version: $STAGED_VERSION"
            echo ""
            echo "Actions to take:"
            echo "  1. Bump CCY_VERSION in $CCY_SCRIPT"
            echo "     - Patch (x.y.Z): Bug fixes, minor changes"
            echo "     - Minor (x.Y.0): New features, backward compatible"
            echo "     - Major (X.0.0): Breaking changes"
            echo ""
            echo "  2. Update the version comment to describe the change"
            echo ""
            echo "Example:"
            echo "  CCY_VERSION=\"3.0.1\"  # Fix: persist sessions in .claude/ccy/"
            echo ""
            echo "To bypass this check (NOT RECOMMENDED):"
            echo "  git commit --no-verify"
            echo ""
            exit 1
        fi
    elif [ -n "$HEAD_VERSION" ]; then
        echo "✓ CCY version bumped: $HEAD_VERSION → $STAGED_VERSION"
    else
        echo "✓ New CCY script (version: $STAGED_VERSION)"
    fi
fi

FOUND_ISSUES=0

# Check each staged file
for FILE in "${STAGED_FILE_LIST[@]}"; do
    # Skip binary files (numstat reports '-' for added/removed lines on binaries)
    if git diff --cached --numstat -- "$FILE" | grep -q '^-'; then
        continue
    fi

    # Get the staged content
    STAGED_CONTENT=$(git show ":$FILE" 2>/dev/null || true)

    if [ -z "$STAGED_CONTENT" ]; then
        continue
    fi

    # Check each pattern
    for PATTERN_DESC in "${SENSITIVE_PATTERNS[@]}"; do
        # Split "pattern::description::guidance" into its three fields.
        PATTERN="${PATTERN_DESC%%::*}"
        _REST="${PATTERN_DESC#*::}"
        DESCRIPTION="${_REST%%::*}"
        GUIDANCE="${_REST#*::}"

        # Collect every line matching this pattern (with line numbers), then
        # drop the whitelisted matches. A flag is raised only if real offending
        # lines remain, so one legitimate reference whitelists neither a leak
        # elsewhere in the same file nor one on the same line.
        MATCH_LINES=$(echo "$STAGED_CONTENT" | grep -nE -e "$PATTERN" || true)
        [ -z "$MATCH_LINES" ] && continue

        # Whitelisting is PER TOKEN, and it now lives in lib/secret-scan.bash
        # because the two hooks had drifted apart: this one filtered tokens,
        # commit-msg still filtered whole LINES — so `git@github.com` sharing a
        # line with a real address deleted the address along with it, in the
        # hook guarding the one surface a follow-up commit cannot fix. Sourcing
        # one implementation twice is what stops that recurring.
        #
        # A filter that cannot run is a hard failure: an empty result would read
        # as "no leak found", which is the defect class this plan is about.
        if ! MATCH_LINES=$(printf '%s\n' "$MATCH_LINES" | hook_filter_match_lines "$PATTERN"); then
            echo -e "${RED}ERROR: whitelist filtering failed for: $DESCRIPTION${NC}" >&2
            exit 1
        fi
        [ -z "$MATCH_LINES" ] && continue

        if [ $FOUND_ISSUES -eq 0 ]; then
            echo ""
            echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
            echo -e "${RED}⚠  SENSITIVE INFORMATION DETECTED${NC}"
            echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
            echo ""
            echo "This is a PUBLIC REPOSITORY. Never commit:"
            echo "  • Personal information (names, emails, usernames)"
            echo "  • Credentials (API keys, tokens, passwords)"
            echo "  • Local paths with usernames"
            echo "  • Company/infrastructure references"
            echo ""
        fi

        echo -e "${YELLOW}File: $FILE${NC}"
        echo -e "${YELLOW}Issue: $DESCRIPTION${NC}"

        # Show context (up to 3 matching lines)
        echo "$MATCH_LINES" | head -3 | while IFS=: read -r LINE_NUM LINE_CONTENT; do
            echo "  Line $LINE_NUM: ${LINE_CONTENT:0:100}"
        done
        echo -e "  ${YELLOW}→ Fix:${NC} $GUIDANCE"
        echo ""

        FOUND_ISSUES=1
    done
done

# ============================================================================
# Dynamic private-identifier denylist (SEC-02)
# ============================================================================
# Build a denylist of PRIVATE identifiers from the gitignored localhost.yml
# (identity fields only), subtract the public-by-design allowlist, and reject
# the commit if any staged content contains one of them. localhost.yml is
# optional in a fresh clone — if it is absent we skip ONLY this local-data
# check (the static patterns above still ran). Private values are NEVER
# printed; matches are reported by source-field name only.

DENYLIST_FILE=$(mktemp)
trap 'rm -f "$DENYLIST_FILE"' EXIT

# The builder is shared with commit-msg (lib/secret-scan.bash) so the message
# and the staged content are held to the same denylist. Return codes:
#   0  built (the file may legitimately be empty)
#   1  could not build — a HARD failure. A security gate that cannot build its
#      denylist has not passed, it has not run
#   2  localhost.yml absent (fresh clone): skip ONLY this local-data check,
#      the static patterns above still ran
DENY_RC=0
hook_build_private_denylist "$REPO_ROOT" "$DENYLIST_FILE" || DENY_RC=$?

if [ "$DENY_RC" -eq 1 ]; then
    echo -e "${RED}ERROR: failed to build private-identifier denylist from localhost.yml${NC}" >&2
    exit 1
elif [ "$DENY_RC" -eq 2 ]; then
    echo "ℹ  localhost.yml not present — skipping optional private-identifier denylist check" >&2
else

    if [ -s "$DENYLIST_FILE" ]; then
        # Concatenate all staged text content once for scanning. A file that
        # cannot be read is a HARD failure: skipping it would leave the gate
        # reporting a pass over content it never looked at.
        ALL_STAGED_CONTENT=""
        for FILE in "${STAGED_FILE_LIST[@]}"; do
            # A `-` in the numstat columns marks a binary blob — nothing to scan.
            if git diff --cached --numstat -- "$FILE" | grep -q '^-'; then
                continue
            fi
            if ! FILE_CONTENT=$(git show ":$FILE"); then
                echo -e "${RED}ERROR: cannot read staged content of $FILE${NC}" >&2
                exit 1
            fi
            ALL_STAGED_CONTENT+="$FILE_CONTENT"$'\n'
        done

        # The scanner reports the source FIELD name only — never the value.
        while IFS= read -r DENY_FIELD; do
            if [ -z "$DENY_FIELD" ]; then
                continue
            fi
            if [ $FOUND_ISSUES -eq 0 ]; then
                echo ""
                echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
                echo -e "${RED}⚠  PRIVATE IDENTIFIER DETECTED (from localhost.yml)${NC}"
                echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
                echo ""
            fi
            echo -e "${YELLOW}Private value from localhost.yml field '${DENY_FIELD}' appears in staged content${NC}"
            FOUND_ISSUES=1
        done < <(printf '%s' "$ALL_STAGED_CONTENT" | hook_scan_text_for_private "$DENYLIST_FILE")
    fi
fi

if [ $FOUND_ISSUES -eq 1 ]; then
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${RED}COMMIT REJECTED${NC}"
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo "Actions to take:"
    echo "  1. For EXAMPLES, swap in a reserved placeholder (see the 'Fix:' line above):"
    echo "       IPs    → 192.0.2.x / 198.51.100.x / 203.0.113.x   (RFC 5737)"
    echo "       Email  → name@example.com (subdomains OK)         (RFC 2606)"
    echo "       Host   → host.example.com / *.test / *.invalid    (RFC 2606)"
    echo "       User   → {{ user_login }} or <user>"
    echo "     Full schema: CLAUDE/ExampleValues.md"
    echo "  2. For REAL secrets, remove them and use Ansible Vault; rotate if exposed."
    echo "  3. Review CLAUDE/SecurityRules.md 'Public Repository Warning' section."
    echo ""
    echo "To bypass this check (NOT RECOMMENDED):"
    echo "  git commit --no-verify"
    echo ""
    exit 1
fi

echo "✓ No sensitive patterns detected in staged changes"
exit 0
