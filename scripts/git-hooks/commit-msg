#!/bin/bash
#
# Commit-msg hook: Prevent committing messages with sensitive information
# This hook scans the commit message for patterns that might leak private information
#

set -euo pipefail

# ANSI color codes
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

COMMIT_MSG_FILE="$1"

if [ ! -f "$COMMIT_MSG_FILE" ]; then
    echo "ERROR: Commit message file not found: $COMMIT_MSG_FILE"
    exit 1
fi

# Read commit message
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Merge commits: do NOT skip wholesale. The auto-generated "Merge branch ..."
# subject can carry branch names, but the human-authored subject/body of a
# merge commit can still leak identifiers/tokens. We strip only the generated
# "Merge branch"/"Merge remote-tracking branch" lines and scan the rest.
SCAN_MSG=$(echo "$COMMIT_MSG" | grep -vE "^Merge (branch|remote-tracking branch|tag|commit) " || true)

# Sensitive patterns specific to commit messages
# Format: "pattern::description::suggested_fix" (using :: to avoid conflicts with | in regex)
declare -a MESSAGE_PATTERNS=(
    # Specific username patterns
    # Will exclude example_user, test_user, etc. in script logic below
    "[a-z]{3,}_[a-z]{3,}\\.(token|key|json)::Specific username in filename::Use: example_user.token"

    # Any real email address. Obvious placeholders (example.com/.org/.net, or
    # addresses inside <...>/{{...}}) are filtered out in the per-pattern logic below.
    "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}::Email address::Use: @example.com"

    # Real usernames in paths (not {{ variables }} or 'username')
    "/home/[a-z][a-z0-9_-]{2,}[^}]::Hardcoded username in path::Use: {{ user_login }} or generic placeholder"

    # Private IP addresses (specific format, not x.x.x.x placeholders)
    "192\\.168\\.[0-9]{1,3}\\.[0-9]{1,3}::Private IP address::Use: 192.168.x.x"
    "10\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}::Private IP address::Use: 10.x.x.x"

    # Private key material (PEM blocks of any key type)
    "-----BEGIN [A-Z ]*PRIVATE KEY-----::Private key block::Remove the key material entirely"

    # Real API tokens/keys (long enough to be real, not examples)
    "sk-ant-oat01-[A-Za-z0-9_-]{20,}::Anthropic OAuth token::Remove or redact"
    "sk-ant-[a-z0-9-]{50,}::Anthropic API token::Remove or redact"
    "ghp_[A-Za-z0-9]{36,}::GitHub token::Remove or redact"
    "gho_[A-Za-z0-9]{36,}::GitHub OAuth token::Remove or redact"
    "ghs_[A-Za-z0-9]{36,}::GitHub server-to-server token::Remove or redact"
    "ghr_[A-Za-z0-9]{36,}::GitHub refresh token::Remove or redact"
    "github_pat_[A-Za-z0-9_]{20,}::GitHub fine-grained PAT::Remove or redact"
    "glpat-[A-Za-z0-9_-]{20,}::GitLab personal access token::Remove or redact"
    "AKIA[0-9A-Z]{16}::AWS access key ID::Remove or redact"
)

FOUND_ISSUES=0

# Check each pattern
for PATTERN_INFO in "${MESSAGE_PATTERNS[@]}"; do
    PATTERN="${PATTERN_INFO%%::*}"
    REMAINDER="${PATTERN_INFO#*::}"
    DESCRIPTION="${REMAINDER%%::*}"
    SUGGESTION="${REMAINDER#*::}"

    # Collect matching lines, then drop whitelisted/placeholder lines PER LINE
    # so one legitimate reference cannot whitelist a real leak elsewhere.
    MATCH_LINES=$(echo "$SCAN_MSG" | grep -nE -e "$PATTERN" || true)
    [ -z "$MATCH_LINES" ] && continue

    case "$PATTERN" in
        *token*|*key*|*json*)
            MATCH_LINES=$(echo "$MATCH_LINES" \
                | grep -vE "(example_|test_|sample_|demo_|user_name|company_name)" || true)
            ;;
    esac
    case "$PATTERN" in
        *@*)
            # Email pattern: drop obvious non-personal "user@host" shapes —
            # placeholders, the SSH git remote user (git@github.com), and systemd
            # unit names (foo@instance.service). Real personal addresses still match.
            MATCH_LINES=$(echo "$MATCH_LINES" \
                | grep -viE "@example\\.(com|org|net)" \
                | grep -vE "<[^>]*@[^>]*>" \
                | grep -vE "\\{\\{[^}]*@[^}]*\\}\\}" \
                | grep -vE "(^|[^A-Za-z0-9._%+-])git@[A-Za-z0-9.-]+" \
                | grep -vE "@[A-Za-z0-9_.:-]+\\.(service|socket|timer|target|mount|path|slice|scope|device|swap|automount)\\b" || true)
            ;;
        */home/*)
            MATCH_LINES=$(echo "$MATCH_LINES" \
                | grep -vE "files/home/(bashrc-includes|[a-z-]+)" \
                | grep -vE "/home/(<user>|\\{\\{ ?user_login ?\\}\\}|\\\$USER|\\\$\\{USER\\}|ansible|runner|deploy|build|user)\\b" || true)
            ;;
    esac

    [ -z "$MATCH_LINES" ] && continue

    if [ $FOUND_ISSUES -eq 0 ]; then
        echo ""
        echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo -e "${RED}⚠  SENSITIVE INFORMATION IN COMMIT MESSAGE${NC}"
        echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo ""
        echo "This commit message contains information that should NOT be in a public repository."
        echo ""
    fi

    echo -e "${YELLOW}Issue: $DESCRIPTION${NC}"
    echo -e "Suggestion: $SUGGESTION"

    # Show matching lines
    echo "$MATCH_LINES" | head -3 | while IFS=: read -r LINE_NUM LINE_CONTENT; do
        echo "  Line $LINE_NUM: ${LINE_CONTENT:0:80}"
    done
    echo ""

    FOUND_ISSUES=1
done

if [ $FOUND_ISSUES -eq 1 ]; then
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${RED}COMMIT REJECTED${NC}"
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo "Actions to take:"
    echo "  1. Edit your commit message to remove/replace sensitive information"
    echo "  2. Use generic placeholders (example_user, company-infra, 192.168.x.x)"
    echo "  3. Remove any hardcoded usernames, emails, or tokens"
    echo ""
    echo "To edit the commit message:"
    echo "  git commit --edit --file=$COMMIT_MSG_FILE"
    echo ""
    echo "To bypass this check (NOT RECOMMENDED):"
    echo "  git commit --no-verify"
    echo ""
    exit 1
fi

echo "✓ Commit message looks clean"
exit 0
