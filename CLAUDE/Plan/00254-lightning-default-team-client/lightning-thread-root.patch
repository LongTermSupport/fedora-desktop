From 0191db89b22cdf35433c42e76386df9d73cb0e91 Mon Sep 17 00:00:00 2001
From: fedora-desktop agent <noreply@example.com>
Date: Fri, 13 Nov 2026 12:48:39 +0000
Subject: [PATCH] Let a long thread root grow to a cap and then scroll instead
 of eliding it

The thread panel's root card was capped at 190 px with clip, and its body Label at six lines with an ellipsis, so a long root message could not be read from the thread at all. The body now sits in a Flickable that grows with its text up to 40% of the panel's height (never under 120 scaled px) and scrolls beyond that; nothing is elided.
---
 qml/ThreadPanel.qml                          | 50 ++++++++----
 tests/ThreadPanelPaginationAnchorQmlTest.cpp | 86 ++++++++++++++++++++
 2 files changed, 119 insertions(+), 17 deletions(-)

diff --git a/qml/ThreadPanel.qml b/qml/ThreadPanel.qml
index 3f92a544..089788ac 100644
--- a/qml/ThreadPanel.qml
+++ b/qml/ThreadPanel.qml
@@ -100,6 +100,9 @@ Rectangle {
     property var rootData: ({})
     function refreshRoot() { rootData = app.thread.rootInfo() }
     readonly property bool rootCollapsed: app.settings.threadRootCollapsed === true
+    // A long root grows to this, then scrolls: it must never be cut off unreadable.
+    readonly property real rootBodyMaxHeight:
+        Math.max(AppTheme.scaled(120), Math.round(height * 0.4))
     function setRootCollapsed(collapsed) {
         app.settings.threadRootCollapsed = collapsed
     }
@@ -646,8 +649,7 @@ Rectangle {
             Layout.topMargin: AppTheme.spacing12
             visible: app.thread.active
                      && app.thread.state !== ThreadController.Failed
-            implicitHeight: Math.min(rootColumn.implicitHeight
-                                     + AppTheme.spacing12 * 2, 190)
+            implicitHeight: rootColumn.implicitHeight + AppTheme.spacing12 * 2
             clip: true
             radius: AppTheme.radiusLg
             readonly property bool navigationHighlighted:
@@ -835,24 +837,38 @@ Rectangle {
                         onClicked: panel.setRootCollapsed(false)
                     }
                 }
-                Label {
-                    objectName: "threadRootBody"
-                    textFormat: Text.PlainText
+                Flickable {
+                    id: rootBodyFlick
+                    objectName: "threadRootBodyScroll"
                     Layout.fillWidth: true
                     Layout.maximumWidth: rootColumn.width
+                    Layout.preferredHeight: Math.min(rootBody.implicitHeight,
+                                                     panel.rootBodyMaxHeight)
                     visible: panel.rootData.loaded === true && !panel.rootCollapsed
-                    text: panel.rootBodyText
-                    font.italic: panel.rootData.redacted === true
-                                 || panel.rootData.undecryptable === true
-                    color: (panel.rootData.redacted === true
-                            || panel.rootData.undecryptable === true)
-                           ? AppTheme.textMuted : AppTheme.text
-                    font.pixelSize: AppTheme.scaled(AppTheme.textBody)
-                    lineHeight: AppTheme.lineHeightBody
-                    lineHeightMode: Text.ProportionalHeight
-                    wrapMode: Text.Wrap
-                    maximumLineCount: 6
-                    elide: Text.ElideRight
+                    contentWidth: width
+                    contentHeight: rootBody.implicitHeight
+                    interactive: contentHeight > height
+                    boundsBehavior: Flickable.StopAtBounds
+                    clip: true
+                    readonly property string shownRootId: panel.rootData.eventId || ""
+                    onShownRootIdChanged: contentY = 0
+                    Label {
+                        id: rootBody
+                        objectName: "threadRootBody"
+                        textFormat: Text.PlainText
+                        width: rootBodyFlick.width
+                        text: panel.rootBodyText
+                        font.italic: panel.rootData.redacted === true
+                                     || panel.rootData.undecryptable === true
+                        color: (panel.rootData.redacted === true
+                                || panel.rootData.undecryptable === true)
+                               ? AppTheme.textMuted : AppTheme.text
+                        font.pixelSize: AppTheme.scaled(AppTheme.textBody)
+                        lineHeight: AppTheme.lineHeightBody
+                        lineHeightMode: Text.ProportionalHeight
+                        wrapMode: Text.Wrap
+                    }
+                    ScrollBar.vertical: AppScrollBar { policy: ScrollBar.AsNeeded }
                 }
                 Label {
                     objectName: "threadRootMissing"
diff --git a/tests/ThreadPanelPaginationAnchorQmlTest.cpp b/tests/ThreadPanelPaginationAnchorQmlTest.cpp
index 37bc4a01..5c8d1ec8 100644
--- a/tests/ThreadPanelPaginationAnchorQmlTest.cpp
+++ b/tests/ThreadPanelPaginationAnchorQmlTest.cpp
@@ -500,6 +500,92 @@ private Q_SLOTS:
         }
     }
 
+    void theThreadRootGrowsToItsCapThenScrollsAndIsNeverElided_data()
+    {
+        QTest::addColumn<int>("lineCount");
+        QTest::addColumn<bool>("scrolls");
+        QTest::newRow("short root fits") << 2 << false;
+        QTest::newRow("long root scrolls") << 60 << true;
+    }
+
+    void theThreadRootGrowsToItsCapThenScrollsAndIsNeverElided()
+    {
+        QFETCH(int, lineCount);
+        QFETCH(bool, scrolls);
+        QSettings().remove(QStringLiteral("timeline/threadRootCollapsed"));
+        AppController controller(AppController::MockBackend);
+        QVERIFY(login(controller));
+        auto *mock = controller.findChild<MockMatrixClient *>();
+        QVERIFY(mock != nullptr);
+
+        const QString rootId = firstThreadRootId(*mock, kGeneral);
+        QVERIFY(!rootId.isEmpty());
+        const auto events = mock->timeline(kGeneral);
+        int rootIndex = -1;
+        for (int i = 0; i < events.size(); ++i) {
+            if (events.at(i).eventId == rootId) {
+                rootIndex = i;
+                break;
+            }
+        }
+        QVERIFY2(rootIndex >= 0, "the thread root is not in the room timeline");
+        TimelineEvent rootEvent = events.at(rootIndex);
+        QStringList lines;
+        for (int i = 1; i <= lineCount; ++i)
+            lines << QStringLiteral("%1. option %1, which the reply has to see").arg(i);
+        rootEvent.body = lines.join(QLatin1Char('\n'));
+        mock->changeEventAtForTest(kGeneral, rootIndex, rootEvent);
+
+        controller.thread()->openThread(kGeneral, rootId);
+        QTRY_COMPARE_WITH_TIMEOUT(controller.thread()->state(),
+                                  ThreadController::Ready, kSignalTimeoutMs);
+
+        QQmlApplicationEngine engine;
+        engine.rootContext()->setContextProperty("app", &controller);
+        QSignalSpy createdSpy(&engine, &QQmlApplicationEngine::objectCreated);
+        engine.loadFromModule(QStringLiteral("MatrixClient"),
+                              QStringLiteral("ThreadPanel"));
+        if (createdSpy.isEmpty())
+            QVERIFY(createdSpy.wait(kSignalTimeoutMs));
+        auto *root = qobject_cast<QQuickItem *>(
+            createdSpy.at(0).at(0).value<QObject *>());
+        QVERIFY(root != nullptr);
+
+        QQuickWindow window;
+        window.resize(340, 700);
+        root->setParentItem(window.contentItem());
+        root->setSize(QSizeF(window.width(), window.height()));
+        window.show();
+        QVERIFY(QTest::qWaitForWindowExposed(&window, kSignalTimeoutMs));
+
+        auto *scroll = root->findChild<QQuickItem *>(
+            QStringLiteral("threadRootBodyScroll"));
+        auto *body = root->findChild<QQuickItem *>(
+            QStringLiteral("threadRootBody"));
+        QVERIFY2(scroll && body, "the thread root card has no scrolling body");
+        QTRY_VERIFY(body->isVisible());
+        QTRY_COMPARE(body->property("text").toString(), rootEvent.body);
+        QVERIFY2(!body->property("truncated").toBool(),
+                 "the thread root is elided, so part of it cannot be read");
+
+        const qreal cap = root->property("rootBodyMaxHeight").toReal();
+        QVERIFY(cap > 0);
+        QVERIFY2(scroll->height() <= cap + 0.5,
+                 qPrintable(QStringLiteral("the root body is %1 px, over its %2 px cap")
+                                .arg(scroll->height()).arg(cap)));
+        QCOMPARE(scroll->property("interactive").toBool(), scrolls);
+        if (!scrolls) {
+            QCOMPARE(qRound(scroll->height()), qRound(body->implicitHeight()));
+            return;
+        }
+        QCOMPARE(qRound(scroll->height()), qRound(cap));
+        const qreal lastY = scroll->property("contentHeight").toReal()
+                            - scroll->height();
+        QVERIFY(lastY > 0);
+        scroll->setProperty("contentY", lastY);
+        QCOMPARE(scroll->property("contentY").toReal(), lastY);
+    }
+
     void theThreadRootCollapsesToOneLineAndRemembersIt()
     {
         QSettings().remove(QStringLiteral("timeline/threadRootCollapsed"));
-- 
2.47.3

