user_login: "yourname"
user_name: "Firstname Lastname"
user_email: "yourname@example.com"

# Required for LXC/GitHub SSH flow (play-lxc-install-config, play-github-cli-multi).
# Set this even if not using LXC — play-github-cli-multi asserts it is defined.
# Encrypt with: ansible-vault encrypt_string 'yourpassphrase' --name 'github_ssh_passphrase'
# github_ssh_passphrase: !vault |
#   $ANSIBLE_VAULT;1.2;AES256;localhost
#   <encrypted-value-goes-here>

# Optional: route GitHub SSH over ssh.github.com:443 when port 22 is firewall-blocked.
# Off by default. ssh.github.com:443 serves the same host keys as github.com:22.
# Do NOT enable on networks that TLS-inspect port 443 — see docs/github-multi-account.md.
# This is the ALWAYS-ON switch: it writes the 443 override block + known_hosts pin
# and exports GITHUB_SSH_443=1 for every shell (so ccy inherits 443 too). For a
# TEMPORARY enable without re-running Ansible, use the `github-ssh-443` CLI instead.
# github_ssh_over_443: true
#
# Optional: extra deploy-key Host alias globs (that redirect to github.com) to
# reroute over 443 alongside github.com and the github.com-<alias> accounts.
# github_443_extra_aliases:
#   - myorg_deploy_*

# Optional Last.fm scrobbling (rescrobbled) credentials
# lastfm_api_key: !vault |
#   $ANSIBLE_VAULT;1.2;AES256;localhost
#   <encrypted-value-goes-here>
# lastfm_api_secret: !vault |
#   $ANSIBLE_VAULT;1.2;AES256;localhost
#   <encrypted-value-goes-here>

# Optional: the SSH key that signs every commit and tag (Plan 00139). Unset, it is
# ~/.ssh/id, the login key run.bash generates. git signs through the ssh-agent that holds
# it, so a passphrase is fine. See docs/configuration.md "Commit Signing".
# git_signing_key: /home/<user>/.ssh/id

# Optional (server): unattended self-update (Plan 00137). Off unless enabled, and turning
# it off removes everything it installed. See docs/configuration.md "Unattended Server
# Self-Update".
# self_update_enabled: true
# self_update_branch: F44
# What the server follows: "tags" (the default) deploys the newest signed release tag
# 44.MINOR.PATCH of that branch; "branch" opts into the newest signed commit on the branch.
# self_update_channel: tags
# self_update_remote_url: https://github.com/example/fedora-desktop.git
# self_update_signing_principal: yourname@example.com
# Every key that signs your commits, one .pub line each: the desktop's ~/.ssh/id.pub, and
# ~/.ssh/github_<alias>.pub for each GitHub account ccy sessions push this repo with. The
# older single self_update_signing_public_key is still accepted and added to the list.
# self_update_signing_public_keys:
#   - "ssh-ed25519 <base64-public-key> yourname@example.com"
#   - "ssh-ed25519 <base64-public-key> github-account"
# self_update_warn_minutes: 3
# Optional Slack alerts: an incoming-webhook URL, vault-encrypted. Undeclared, the play
# asks for it on an interactive run; "" means no Slack alerts and stops the question.
# self_update_slack_webhook_url: !vault |
#   $ANSIBLE_VAULT;1.2;AES256;localhost
#   <encrypted-value-goes-here>
# self_update_become_password: !vault |
#   $ANSIBLE_VAULT;1.2;AES256;localhost
#   <encrypted-value-goes-here>

# Optional: your ISP's name as it appears in Ookla's server list (`speedtest -L`), so
# speedtest-isp (play-network-tools.yml) tests against the ISP's own server. Unset, Ookla
# picks the nearest server.
# speedtest_isp: "ExampleISP"

# Optional: the UniFi controller's web login password (play-unifi-controller.yml, login
# name unifi-admin). Undeclared, the play generates one and vaults it here. Read it with
# ./vault.bash get unifi_admin_password. See docs/UnifiSetupGuide.md.
# unifi_admin_password: !vault |
#   $ANSIBLE_VAULT;1.2;AES256;localhost
#   <encrypted-value-goes-here>

# Optional MOK Password for Secure Boot (DisplayLink, NVIDIA, etc.)
# Required when installing kernel modules with Secure Boot enabled
# mok_password: !vault |
#   $ANSIBLE_VAULT;1.2;AES256;localhost
#   <encrypted-value-goes-here>

# Optional (Plan 00161, agent team bus): the host-wide bus address agent-bus-install puts
# on the NetworkManager dummy interface agentbus0, as <ip>/32; local containers, LXC,
# docker and VM guests reach this host's team homeservers on it. Pick an address this host
# uses nowhere else: on no interface, and under no route but the default (Plan 00161's
# deploy.bash refuses one that is not).
# agent_bus_address: <ip>

# Optional (Plan 00161): the agent teams whose homeservers run on this host, applied by
# play-agent-bus.yml through agent-bus-install. A present entry (state defaults to present)
# is the team file of CLAUDE/Plan/00161-agent-team-bus-matrix/DESIGN.md section 3.4; to
# take a team off this host, set state: absent (purge: true also deletes its data). With
# no teams declared the play still installs the homeserver software.
# Deleting an entry does not remove the team: set state: absent first and run the play.
# agent_bus_teams:
#   - team: <team>
#     port: <port>
#     listen: ["<bus_ip>"]
#     allow_from: ["<cidr>"]     # only other machines (WireGuard) or a non-default bridge; the LXC bridge is added by the play
#     humans: ["<name>"]
#     org: <github-owner>        # every repository it owns is trusted, on any of its branches
#     exclude: ["<repo>"]        # optional, needs org: repositories of it never trusted or referenced
#                                # (every member must run the current pingbus before this is set)
#     repos:                     # and, or instead of org: repositories of any owner
#       - repo: <owner>/<repo>   # on any of its branches
#       - repo: <owner>/<other>
#         branches: ["<branch>"] # optional: only these branches
#     path_prefixes: ["docs/"]   # optional: narrows the paths a ping may name (absent: any)
#     forge_api: https://api.github.com
#   - team: <old-team>
#     state: absent
#     purge: false

# Optional (Plan 00161): existing LXC containers whose agent users join a team hosted here,
# applied by play-agent-bus.yml with README.lxc's steps (docs/agent-bus.md, "Joining a
# team"). The play never creates the container or the user: both must exist, the container
# running. The play admits the LXC bridge's subnet (lxcbr0, or agent_bus_lxc_bridge) to
# every present team itself; allow_from need not list it. A joined member is left alone on later runs; state: absent
# parks its handle, deletes its bundle and takes the team out of its env file. Change
# seat or host only through state: absent first, as they make the handle.
#   team       a team declared present in agent_bus_teams
#   container  the LXC container's name (lxc-ls)
#   user       the agent user inside it
#   host       its HOOKS_DAEMON_HOSTNAME, the handle's <host>: a role, never a hostname
#   checkout   the agent's checkout inside the container, where suggest-handle runs
#   seat       optional; the handle's <seat>, by default the container's name (letters
#              first); a member joined by hand keeps its number: seat: <n>
#   role       optional; worker (the default) or coordinator (at most one per team)
#   human_text optional; false makes a member that takes pings only
#   repo       optional; needed only to park the handle of a container already destroyed
#   state      optional; present (the default) or absent
# agent_bus_lxc_members:
#   - team: <team>
#     container: <container>
#     user: <agent-user>
#     host: <role>
#     checkout: /home/<agent-user>/<repo>
#   - team: <old-team>
#     container: <container>
#     user: <agent-user>
#     host: <role>
#     checkout: /home/<agent-user>/<repo>
#     state: absent

# Optional (Plan 00161): the teams user_login watches in Element Desktop, applied by the
# optional play playbooks/imports/optional/common/play-agent-bus-element.yml (a profile and
# a launcher per team; DESIGN.md section 8). A team may be hosted here or elsewhere:
# base_url is how this desktop reaches it, http:// only to an IP literal (the bus address,
# or a WireGuard address). server_name defaults to <team>.agent-bus.internal. The play
# refuses when user_login has ~/.config/pingbus/: agents never run as the human.
# agent_bus_element_teams:
#   - team: <team>
#     base_url: http://<bus_ip>:<port>
