#!/bin/bash
#
# DAEMON-OWNED FILE - do not edit. Deployed into your project by the
# claude-code-hooks-daemon installer and refreshed on every upgrade, so local
# changes are discarded. See CLAUDE/LLM-INSTALL.md, "Which Files Under
# .claude/ Are Yours?", for the full list and the linter exclusions.
#
# Claude Code Hooks - SessionStart Forwarder
#
# Forwards SessionStart hook calls to daemon via Unix socket.
# CRITICAL: Pipes JSON directly - NEVER store in shell variables.
# CRITICAL: All errors output valid JSON to stdout for agent visibility.
#

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Plan 00477 Task 5.2: a pulled daemon.expected_version upgrade is synced by
# provision.sh --background, started here DETACHED so this hook never waits on
# it. It decides for itself whether anything needs syncing, records its outcome
# for the SessionStart version check to report, and writes its own log. It sits
# above the relay guard block so a relay-enabled project starts it too, and is
# skipped on the relay's --no-relay fallback, which already passed here.
if [[ "${1:-}" != "--no-relay" && -f "$SCRIPT_DIR/../provision.sh" ]]; then
    if command -v setsid > /dev/null; then
        setsid bash "$SCRIPT_DIR/../provision.sh" --background < /dev/null > /dev/null 2>&1 &
    else
        nohup bash "$SCRIPT_DIR/../provision.sh" --background < /dev/null > /dev/null 2>&1 &
    fi
fi
source "$SCRIPT_DIR/../init.sh"

# Try to start daemon - if it fails, output proper JSON error to stdout
if ! ensure_daemon; then
    emit_hook_error "SessionStart" "daemon_startup_failed" \
        "Failed to start hooks daemon. Use the hooks-daemon skill to check logs (Skill tool: skill=hooks-daemon, args=logs)"
    exit 0  # Exit 0 so Claude processes the JSON response
fi

# Plan 00156: no jq. send_request_stdin wraps the raw stdin hook_input into
# {event, hook_input} itself (the python3 transport it already spawns). The
# payload stays on stdin — control-character safe; only the hardcoded event-name
# literal is passed as an argument.
# send_request_stdin handles socket errors internally and outputs JSON on failure.
send_request_stdin "SessionStart"
