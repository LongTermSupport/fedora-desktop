#!/bin/bash
#
# DAEMON-OWNED FILE - do not edit. Deployed into your project by the
# claude-code-hooks-daemon installer and refreshed on every upgrade, so local
# changes are discarded. See CLAUDE/LLM-INSTALL.md, "Which Files Under
# .claude/ Are Yours?", for the full list and the linter exclusions.
#
# Claude Code Hooks - WorktreeCreate Forwarder
#
# Forwards WorktreeCreate hook calls to daemon via Unix socket.
# CRITICAL: Pipes JSON directly - NEVER store in shell variables.
# CRITICAL: All errors output valid JSON to stdout for agent visibility.
#

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# --- init.sh parse guard (generated; Plan 00552) ---
_ip_file="$SCRIPT_DIR/../init.sh"
if ! _ip_err="$(bash -n "$_ip_file" 2>&1)"; then
    _ip_msg="hooks daemon: $_ip_file does not parse (merge conflict markers?), so hooks are not running. Repair: run .claude/hooks-daemon/bin/hooks-daemon repair-install from the project root."
    echo "HOOKS DAEMON ERROR [init_sh_unparseable]: $_ip_msg $_ip_err" >&2
    # This stdout is parsed as a VALUE, so nothing may be printed.
    exit 1
fi
unset _ip_file _ip_err
# --- end init.sh parse guard ---
source "$SCRIPT_DIR/../init.sh"

# Try to start daemon - if it fails, output proper JSON error to stdout
if ! ensure_daemon; then
    # raw_stdout event (generated; Plan 00189): Claude Code reads this
    # hook's stdout RAW, so a JSON error here would be taken literally.
    # Diagnostic on stderr; the exit code is the event's (a value: non-zero =
    # not handled; a display line: 0, as Claude Code blanks a failing one).
    # This stdout is parsed as a VALUE, so nothing may be printed.
    echo "HOOKS DAEMON ERROR [daemon_startup_failed]: WorktreeCreate hook: failed to start hooks daemon. Use the hooks-daemon skill to check logs (Skill tool: skill=hooks-daemon, args=logs)" >&2
    exit 1
fi

# Plan 00188: "worktree" response mode. Claude Code parses this hook's stdout as
# the created worktree PATH, so the transport extracts .worktreePath from the
# daemon response and prints it RAW (never '{}', which would become a bad path).
# send_request_stdin handles socket errors internally (non-zero exit on failure).
send_request_stdin "WorktreeCreate" "worktree"
