# Claude Code Hooks Daemon
# Exclude the cloned daemon repository (users install it themselves).
#
# No trailing slash, deliberately: a trailing slash matches a DIRECTORY only, and in a git
# worktree the daemon tree is commonly a symlink to the install the main checkout holds —
# which git does not treat as a directory, so it showed up as untracked and one `git add -A`
# away from committing an absolute path outside the repository into this PUBLIC repo.
/hooks-daemon

# Backup directories created during installation
hooks.bak/
hooks.bak.*/

# Upgrade preserves the previous copy of any daemon-deployed tree it is about to
# replace (e.g. the skills directory) here. The tracked originals are already in
# git history, so the backup is redundant to version control and would otherwise
# sit in `git status` as untracked noise after every upgrade.
hooks-daemon-backups/

# Environment files (may contain local paths)
hooks-daemon.env

# Daemon runtime files
*.sock
*.pid

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments (if created locally)
venv/
.venv/

# Claude Code Hooks Daemon - runtime files
hooks-daemon/untracked/
