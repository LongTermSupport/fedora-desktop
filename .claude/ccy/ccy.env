# CCY per-project environment.
#
# Sourced INSIDE the container by entrypoint.sh, immediately before `claude` runs
# (never on the host — a project's ccy.env cannot execute host code). Use it to
# declare per-project CCY_* config in a tracked file instead of ad-hoc host exports.
#
# Here it arms the standalone PTY supervisor as the claude wrapper. The supervisor
# (claude-supervise.py) is deployed into this directory AND git-tracked (the daemon
# refreshes the tracked copy on upgrade via ccy.deploy_supervisor: true in
# .claude/hooks-daemon.yaml). It watches the daemon-written context sidecar and,
# when context goes red while the session is idle, injects a /compact trigger.
#
# MODE: --arm (current) injects the REAL /compact (+ continue) when context goes
# red while the session is idle. Change --arm back to --dry-run to return to the
# harmless VISIBLE-MARKER mode (proves the mechanism end-to-end, no real compaction).
#
# PRECEDENCE: the ${CCY_CLAUDE_WRAPPER:-<default>} idiom means a host-set value or
# `ccy --supervise` (a non-empty value forwarded by the launcher) WINS over this
# project default; an empty forwarded value falls through to the default here.
export CCY_CLAUDE_WRAPPER="${CCY_CLAUDE_WRAPPER:-/workspace/.claude/ccy/claude-supervise.py --arm --}"
