# CCY per-project environment.
#
# Sourced INSIDE the container by entrypoint.sh, immediately before `claude` runs
# (never on the host — a project's ccy.env cannot execute host code). Use it to
# declare per-project CCY_* config in a tracked file instead of ad-hoc host exports.
#
# Here it arms the standalone PTY supervisor as the claude wrapper. The supervisor
# (claude-supervise.py) is deployed/refreshed into this directory by the hooks
# daemon (ccy.deploy_supervisor: true in .claude/hooks-daemon.yaml). It watches the
# daemon-written context sidecar and, when context goes red while the session is
# idle, injects a /compact trigger.
#
# MODE: --dry-run (current) injects a harmless VISIBLE MARKER, proving the mechanism
# end-to-end without a real compaction. To go live, change --dry-run to --arm below
# (then it injects the real /compact + continue).
#
# PRECEDENCE: the ${CCY_CLAUDE_WRAPPER:-<default>} idiom means a host-set value or
# `ccy --supervise` (a non-empty value forwarded by the launcher) WINS over this
# project default; an empty forwarded value falls through to the default here.
export CCY_CLAUDE_WRAPPER="${CCY_CLAUDE_WRAPPER:-/workspace/.claude/ccy/claude-supervise.py --dry-run --}"
