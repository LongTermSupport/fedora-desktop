# CCY per-project environment.
#
# Sourced INSIDE the container by entrypoint.sh, immediately before `claude` runs
# (never on the host — a project's ccy.env cannot execute host code). Use it to
# declare per-project CCY_* config in a tracked file instead of ad-hoc host exports.
#
# Here it arms the standalone PTY supervisor as the claude wrapper. The supervisor
# (claude-supervise.py) is deployed into this directory AND git-tracked (the daemon
# refreshes the tracked copy on upgrade via ccy.deploy_supervisor: true in
# .claude/hooks-daemon.yaml). It watches the daemon-written context sidecar and,
# when context goes red while the session is idle, injects a /compact trigger.
#
# MODE: --arm (current) injects the REAL /compact (+ continue) when context goes
# red while the session is idle. Change --arm back to --dry-run to return to the
# harmless VISIBLE-MARKER mode (proves the mechanism end-to-end, no real compaction).
#
# PRECEDENCE: the ${CCY_CLAUDE_WRAPPER:-<default>} idiom means a host-set value or
# `ccy --supervise` (a non-empty value forwarded by the launcher) WINS over this
# project default; an empty forwarded value falls through to the default here.
export CCY_CLAUDE_WRAPPER="${CCY_CLAUDE_WRAPPER:-/workspace/.claude/ccy/claude-supervise.py --arm --}"

# CHILD-CLAUDE SPAWN MODE — off. Uncomment to let this project's sessions spawn
# authenticated child `claude` processes via the `ccy-claude` wrapper, and to install
# the `child-claude` skill that tells the agent the capability exists.
#
# The flag decides whether the TOOLING is installed. It is NOT a security control and
# nothing here restrains the agent: inside CCY it runs as root and the token is already
# in PID 1's environment. What the design buys is that using the feature normally leaks
# nothing — no copy on disk, none in argv, none in an inherited variable.
#
# Turning it back off is a real off: the entrypoint removes the skill it installed,
# which matters because /root/.claude is host-persisted into this directory.
#
# Full reasoning: CLAUDE/Plan/00092-ccy-child-claude-spawn-mode/SECURITY-MODEL.md
# export CCY_CHILD_CLAUDE=1
# export CCY_CHILD_CLAUDE_MAX_DEPTH=1   # a child may not spawn its own child

# BROWSER IDLE TIMEOUT — image default is 5 minutes (300000 ms), down from upstream's
# hour, so a window an agent opened and forgot does not sit on the desktop. Raise it
# here only if someone will genuinely be watching a headed session for longer than
# that between the agent's commands. Agents are still required to close what they
# open; this is the safety net for when they crash, not their cleanup.
# export AGENT_BROWSER_IDLE_TIMEOUT_MS=900000
