[Unit]
Description=teamchat session for agent1
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=6

[Service]
Type=forking
User=agent1
Group=agents
WorkingDirectory=/srv/agent1/src/repo.1
RuntimeDirectory=teamchat-session-agent1
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/teamchat-session-agent1 HOME=/srv/agent1
Environment=PATH=/srv/agent1/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/tmux -L teamchat new-session -d -s teamchat /usr/local/bin/teamchat run --claude --kind lxc --desired /srv/agent1/.config/teamchat/membership --resume-recorded -- claude
TimeoutStopSec=30
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
