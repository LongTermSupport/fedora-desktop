[Unit]
Description=After a boot, start the LXC seats that are down again
# after multi-user.target, which wants it, so its start never holds boot
After=lxc.service multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/teamchat-admin lxc reconcile
TimeoutStartSec=30min
InaccessiblePaths=<D 4.2's six v1 paths, each with its "-">

[Install]
WantedBy=multi-user.target
