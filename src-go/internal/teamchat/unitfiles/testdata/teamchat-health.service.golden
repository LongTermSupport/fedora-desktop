[Unit]
Description=Health of every teamchat team

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/teamchat-admin health --all
TimeoutStartSec=120
SyslogIdentifier=teamchat-health
NoNewPrivileges=yes
ProtectSystem=strict
# the admin state root holds every team's TLS directory, where the tick renews a leaf as team apply writes it
ReadWritePaths=/var/lib/teamchat-status /run/teamchat-admin /var/lib/teamchat-admin
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_CHOWN CAP_SETUID CAP_SETGID CAP_SYS_PTRACE
SystemCallFilter=~ptrace process_vm_readv process_vm_writev
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# a drop-in may add IPAddressAllow= lines (the teams' listen addresses the reach probe dials):
# systemd adds each to this list, and the deny of any stays
IPAddressDeny=any
IPAddressAllow=localhost
InaccessiblePaths=<D 4.2's six v1 paths, each with its "-">
