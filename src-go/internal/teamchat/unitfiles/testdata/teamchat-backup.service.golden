[Unit]
Description=Backups of every teamchat team

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/teamchat-admin backup --all
TimeoutStartSec=30min
SyslogIdentifier=teamchat-backup
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/teamchat-admin /var/lib/teamchat-status /run/teamchat-admin
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_CHOWN CAP_SETUID CAP_SETGID
SystemCallFilter=~ptrace process_vm_readv process_vm_writev
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
InaccessiblePaths=<D 4.2's six v1 paths, each with its "-">
