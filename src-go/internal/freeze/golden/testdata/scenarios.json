{
  "worlds": {
    "pod-mixed": {
      "tools": ["podman", "fzf"],
      "commands": [
        {"argv": ["podman", "ps", "--all", "--format", "{{.Names}}|{{.State}}|{{.Networks}}"],
         "answers": [{"stdout": "web|running|appnet\ndb|paused|appnet\nproj1_yolo|running|podman\nproj2_yolo_2|paused|podman,appnet\nproj3_browser|running|podman\nold_yolo|exited|podman\nlegacy_yolo|running|podman\n"}]},
        {"argv": ["podman", "ps", "--all", "--filter", "label=ccy=true", "--format", "{{.Names}}|{{index .Labels \"ccy-github\"}}|{{index .Labels \"ccy-token\"}}|{{index .Labels \"ccy-ssh-keys\"}}"],
         "answers": [{"stdout": "proj1_yolo|alice|work|id_a id_b\nproj2_yolo_2|alice|none|none\nproj3_browser|bob|work|none\nold_yolo|alice|none|none\n"}]},
        {"argv": ["podman", "network", "ls", "--format", "{{.Name}}"],
         "answers": [{"stdout": "podman\nappnet\n"}]},
        {"argv": ["podman", "ps", "--all", "--filter", "network=appnet", "--format", "{{.Names}}"],
         "answers": [{"stdout": "web\ndb\nproj2_yolo_2\n"}]},
        {"argv": ["podman", "ps", "--all", "--filter", "network=podman", "--format", "{{.Names}}"],
         "answers": [{"stdout": "proj1_yolo\nproj2_yolo_2\nproj3_browser\nold_yolo\nlegacy_yolo\n"}]},
        {"argv": ["podman", "pause", "web"], "answers": [{"stdout": "web\n"}]},
        {"argv": ["podman", "pause", "proj1_yolo"], "answers": [{"stdout": "proj1_yolo\n"}]},
        {"argv": ["podman", "pause", "proj3_browser"], "answers": [{"stderr": "Error: cgroup freezer unavailable\n", "exit": 125}]},
        {"argv": ["podman", "pause", "legacy_yolo"], "answers": [{"stdout": "legacy_yolo\n"}]},
        {"argv": ["podman", "pause", "db"], "answers": [{"stderr": "Error: container db is not running\n", "exit": 125}]},
        {"argv": ["podman", "unpause", "db"], "answers": [{"stdout": "db\n"}]},
        {"argv": ["podman", "unpause", "proj2_yolo_2"], "answers": [{"stdout": "proj2_yolo_2\n"}]},
        {"argv": ["podman", "unpause", "web"], "answers": [{"stderr": "Error: container web is not paused\n", "exit": 125}]}
      ]
    },
    "pod-empty": {
      "tools": ["podman", "fzf"],
      "commands": [
        {"argv": ["podman", "ps", "--all", "--format", "{{.Names}}|{{.State}}|{{.Networks}}"], "answers": [{"stdout": ""}]},
        {"argv": ["podman", "ps", "--all", "--filter", "label=ccy=true", "--format", "{{.Names}}|{{index .Labels \"ccy-github\"}}|{{index .Labels \"ccy-token\"}}|{{index .Labels \"ccy-ssh-keys\"}}"], "answers": [{"stdout": ""}]},
        {"argv": ["podman", "network", "ls", "--format", "{{.Name}}"], "answers": [{"stdout": "podman\n"}]}
      ]
    },
    "lxc-mixed": {
      "tools": ["sudo", "fzf", "lxc-ls", "lxc-info", "lxc-freeze", "lxc-unfreeze", "lxc-attach", "nmcli"],
      "sudo": "cached",
      "commands": [
        {"argv": ["lxc-ls", "-1"], "answers": [{"stdout": "zulu\nmike\nalpha\nkilo\nbravo\nsleeper\n"}]},
        {"argv": ["lxc-info", "-n", "zulu", "-s"], "answers": [{"stdout": "State:          FROZEN\n"}]},
        {"argv": ["lxc-info", "-n", "mike", "-s"], "answers": [{"stdout": "State:          FROZEN\n"}]},
        {"argv": ["lxc-info", "-n", "alpha", "-s"], "answers": [{"stdout": "State:          RUNNING\n"}]},
        {"argv": ["lxc-info", "-n", "kilo", "-s"], "answers": [{"stdout": "State:          FROZEN\n"}]},
        {"argv": ["lxc-info", "-n", "bravo", "-s"], "answers": [{"stdout": "State:          RUNNING\n"}]},
        {"argv": ["lxc-info", "-n", "sleeper", "-s"], "answers": [{"stdout": "State:          STOPPED\n"}]},
        {"argv": ["cat", "/var/lib/lxc/zulu/config"], "answers": [{"stdout": "lxc.uts.name = zulu\nlxc.net.0.type = veth\nlxc.net.0.link = lxcbr0\nlxc.net.0.flags = up\n"}]},
        {"argv": ["cat", "/var/lib/lxc/mike/config"], "answers": [{"stdout": "lxc.uts.name = mike\nlxc.net.0.type = veth\nlxc.net.0.link = virbr1\nlxc.net.0.flags = up\n"}]},
        {"argv": ["cat", "/var/lib/lxc/alpha/config"], "answers": [{"stdout": "lxc.uts.name = alpha\nlxc.net.0.type = veth\nlxc.net.0.link = lxcbr0\nlxc.net.0.flags = up\n"}]},
        {"argv": ["cat", "/var/lib/lxc/kilo/config"], "answers": [{"stdout": "lxc.uts.name = kilo\n"}]},
        {"argv": ["cat", "/var/lib/lxc/bravo/config"], "answers": [{"stdout": "lxc.uts.name = bravo\nlxc.net.0.type = veth\nlxc.net.0.link = virbr1\nlxc.net.0.flags = up\n"}]},
        {"argv": ["lxc-info", "-n", "zulu", "-iH"], "answers": [{"stdout": "192.0.2.11\n"}]},
        {"argv": ["lxc-info", "-n", "mike", "-iH"], "answers": [{"stdout": ""}]},
        {"argv": ["lxc-info", "-n", "alpha", "-iH"], "answers": [{"stdout": "192.0.2.12\n"}]},
        {"argv": ["lxc-info", "-n", "kilo", "-iH"], "answers": [{"stdout": ""}]},
        {"argv": ["lxc-info", "-n", "bravo", "-iH"], "answers": [{"stdout": "198.51.100.5\n"}]},
        {"argv": ["lxc-freeze", "-n", "alpha"], "answers": [{"stdout": ""}]},
        {"argv": ["lxc-freeze", "-n", "bravo"], "answers": [{"stdout": ""}]},
        {"argv": ["lxc-freeze", "-n", "zulu"], "answers": [{"stderr": "lxc-freeze: zulu: Container is already frozen\n", "exit": 1}]},
        {"argv": ["lxc-unfreeze", "-n", "zulu"], "answers": [{"stdout": ""}]},
        {"argv": ["lxc-unfreeze", "-n", "mike"], "answers": [{"stdout": ""}]},
        {"argv": ["lxc-unfreeze", "-n", "kilo"], "answers": [{"stdout": ""}]},
        {"argv": ["lxc-attach", "-n", "zulu", "--", "nmcli", "-t", "-f", "DEVICE,TYPE", "device", "status"], "answers": [{"stdout": "eth0:ethernet\nlo:loopback\n"}]},
        {"argv": ["lxc-attach", "-n", "mike", "--", "nmcli", "-t", "-f", "DEVICE,TYPE", "device", "status"], "answers": [{"stdout": "eth0:ethernet\neth1:ethernet\nlo:loopback\n"}]},
        {"argv": ["lxc-attach", "-n", "kilo", "--", "nmcli", "-t", "-f", "DEVICE,TYPE", "device", "status"], "answers": [{"stdout": "lo:loopback\n"}]},
        {"argv": ["lxc-attach", "-n", "zulu", "--", "nmcli", "device", "connect", "eth0"], "answers": [{"stdout": "Device 'eth0' successfully activated\n"}]},
        {"argv": ["lxc-attach", "-n", "mike", "--", "nmcli", "device", "connect", "eth0"], "answers": [{"stdout": "Device 'eth0' successfully activated\n"}]},
        {"argv": ["lxc-attach", "-n", "mike", "--", "nmcli", "device", "connect", "eth1"], "answers": [{"stderr": "Error: Connection activation failed\n", "exit": 4}]}
      ]
    },
    "lxc-empty": {
      "tools": ["sudo", "fzf", "lxc-ls", "lxc-info", "lxc-freeze", "lxc-unfreeze", "lxc-attach", "nmcli"],
      "sudo": "cached",
      "commands": [
        {"argv": ["lxc-ls", "-1"], "answers": [{"stdout": ""}]}
      ]
    }
  },
