["lxc-ls", "-1"]
["!unscripted", "lxc-info", "-n", "sudo: unable to resolve host box: Name or service not known", "-s"]
["lxc-info", "-n", "zulu", "-s"]
["cat", "/var/lib/lxc/zulu/config"]
["lxc-info", "-n", "zulu", "-iH"]
["lxc-info", "-n", "mike", "-s"]
["cat", "/var/lib/lxc/mike/config"]
["lxc-info", "-n", "mike", "-iH"]
["lxc-info", "-n", "alpha", "-s"]
["cat", "/var/lib/lxc/alpha/config"]
["lxc-info", "-n", "alpha", "-iH"]
["lxc-info", "-n", "kilo", "-s"]
["cat", "/var/lib/lxc/kilo/config"]
["lxc-info", "-n", "kilo", "-iH"]
["lxc-info", "-n", "bravo", "-s"]
["cat", "/var/lib/lxc/bravo/config"]
["lxc-info", "-n", "bravo", "-iH"]
["lxc-info", "-n", "sleeper", "-s"]
