["lxc-ls", "-1"]
["lxc-info", "-n", "zulu", "-s"]
["cat", "/var/lib/lxc/zulu/config"]
["lxc-info", "-n", "zulu", "-iH"]
["lxc-info", "-n", "mike", "-s"]
["cat", "/var/lib/lxc/mike/config"]
["lxc-info", "-n", "mike", "-iH"]
["lxc-info", "-n", "alpha", "-s"]
["cat", "/var/lib/lxc/alpha/config"]
["lxc-info", "-n", "alpha", "-iH"]
["lxc-info", "-n", "kilo", "-s"]
["cat", "/var/lib/lxc/kilo/config"]
["lxc-info", "-n", "kilo", "-iH"]
["lxc-info", "-n", "bravo", "-s"]
["cat", "/var/lib/lxc/bravo/config"]
["lxc-info", "-n", "bravo", "-iH"]
["lxc-info", "-n", "sleeper", "-s"]
["lxc-unfreeze", "-n", "zulu"]
["lxc-attach", "-n", "zulu", "--", "nmcli", "-t", "-f", "DEVICE,TYPE", "device", "status"]
["lxc-attach", "-n", "zulu", "--", "nmcli", "device", "connect", "eth0"]
["lxc-unfreeze", "-n", "mike"]
["lxc-attach", "-n", "mike", "--", "nmcli", "-t", "-f", "DEVICE,TYPE", "device", "status"]
["lxc-attach", "-n", "mike", "--", "nmcli", "device", "connect", "eth0"]
["lxc-attach", "-n", "mike", "--", "nmcli", "device", "connect", "eth1"]
["lxc-unfreeze", "-n", "kilo"]
["lxc-attach", "-n", "kilo", "--", "nmcli", "-t", "-f", "DEVICE,TYPE", "device", "status"]
