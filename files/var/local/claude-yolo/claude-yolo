#!/bin/bash
# Claude Code YOLO Mode Wrapper
# Runs Claude Code with --dangerously-skip-permissions in isolated Docker container
# IMPORTANT: Uses separate token storage from desktop Claude Code to prevent OAuth conflicts
#
# Version: 3.0.0 - Simplified: removed sessions, use project-level .claude/ naturally
#
# IMPORTANT: When modifying this script, ALWAYS increment CCY_VERSION!
# The hash validates script integrity - if hash changes but version doesn't,
# users will get a warning that version wasn't properly updated.
#
# The CCY_VERSION comment is ONE short line describing the CURRENT release only -
# the rebuild banner prints it verbatim to the user. Release notes go in
# docs/ccy-changelog.md; per-change detail is in git. Do NOT append "Prior x.y.z:"
# history here: it grew to 6,881 characters before being moved out.
#
CCY_VERSION="3.32.0"  # Plan 00073: token selection menu and --list-tokens now show each account's 5-hour and weekly usage limits, fetched in parallel from GET /api/oauth/usage with a TTL cache; CCY_TOKEN_USAGE=0 disables

# Load shared helpers
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$SCRIPT_DIR/lib/common.bash" ]; then
    source "$SCRIPT_DIR/lib/common.bash"
else
    # Fallback if library not found
    echo "ERROR: Shared library not found at $SCRIPT_DIR/lib/common.bash" >&2
    exit 1
fi

# Load specialized libraries
for lib in token-management ssh-handling network-management dockerfile-custom docker-health; do
    if [ -f "$SCRIPT_DIR/lib/$lib.bash" ]; then
        source "$SCRIPT_DIR/lib/$lib.bash"
    else
        print_error "Required library not found: $SCRIPT_DIR/lib/$lib.bash"
        exit 1
    fi
done

# IMPORTANT: When modifying the Dockerfile, ALWAYS increment REQUIRED_CONTAINER_VERSION!
# This ensures users automatically rebuild when critical container changes are made.
# ⚠️  THIS VALUE MUST MATCH the "claude-yolo-version" LABEL in Dockerfile!
#     If they don't match, users get infinite rebuild loops.
#     Update BOTH files together: Dockerfile label AND this variable.
REQUIRED_CONTAINER_VERSION="2.26"

set -e

# Debug output helper - only prints when DEBUG_CCY=true
# Usage: debug "message"
debug() {
    if [[ "$DEBUG_CCY" = true ]]; then echo "DEBUG: $*"; fi
}

# Calculate script hash (exclude this variable line to avoid circular dependency)
CCY_HASH=$(grep -v '^CCY_HASH=' "$0" | md5sum | cut -d' ' -f1 | cut -c1-16)

# Configuration file schema version
CONFIG_VERSION=1

# Fail fast: Must be run from a git repository root
check_git_repo || exit 1

# Security check: Ensure no dangerous files are tracked in .claude/ccy/
check_ccy_gitignore_safety || exit 1

# Hostname restriction: prevent running Desktop CCY on projects locked to a specific host
check_allowed_hostname || exit 1

# Migration: detect and offer to remove old session directories (v2.x -> v3.x)
if [ -d ".claude/ccy/sessions" ]; then
    session_count=$(find .claude/ccy/sessions -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)
    if [ "$session_count" -gt 0 ]; then
        echo ""
        echo "════════════════════════════════════════════════════════════════════════════════"
        echo "Migration: Old session directories detected"
        echo "════════════════════════════════════════════════════════════════════════════════"
        echo ""
        echo "CCY v3.0 no longer uses sessions. Found $session_count old session(s) in:"
        echo "  .claude/ccy/sessions/"
        echo ""
        echo "Claude Code now uses .claude/ directly (project-level state)."
        echo ""
        read -rp "Remove old session directories? [y/N] " remove_sessions
        case "$remove_sessions" in
            y|Y|yes|Yes)
                rm -rf .claude/ccy/sessions
                echo "✓ Removed .claude/ccy/sessions/"
                # Also remove config.json if it exists (session config)
                [ -f ".claude/ccy/config.json" ] && rm -f .claude/ccy/config.json && echo "✓ Removed .claude/ccy/config.json"
                # Remove .claude/ccy if empty
                if [ -d ".claude/ccy" ] && [ -z "$(ls -A .claude/ccy 2>/dev/null)" ]; then
                    rmdir .claude/ccy
                    echo "✓ Removed empty .claude/ccy/"
                fi
                echo ""
                ;;
            *)
                echo "Keeping old sessions. You can remove them later with:"
                echo "  rm -rf .claude/ccy/sessions/"
                echo ""
                ;;
        esac
        echo "════════════════════════════════════════════════════════════════════════════════"
        echo ""
    fi
fi

# Get project name from directory (used for container naming)
# Uses parent-project format to avoid collisions (defined in lib/common.bash)
PROJECT_NAME=$(get_project_name)

IMAGE_NAME="claude-yolo:latest"
# Base image (no LSPs) - available for project Dockerfiles that want leaner images
BASE_IMAGE_NAME="claude-yolo:base"
DOCKERFILE_DIR="/opt/claude-yolo"
CCY_ROOT="$HOME/.claude-tokens/ccy"
TOKEN_DIR="$CCY_ROOT/tokens"
PROJECT_DIR="$CCY_ROOT/projects"
# Per-image daily update-check stamps live as files INSIDE this directory
# (one per image tag — claude-yolo:latest, claude-yolo:<project>, …). It used to
# be a single global file; per-image gating means an old project opened today
# still re-checks even if another project already checked earlier today. New path
# (not the old "-version-check" file) avoids a file-vs-directory migration clash.
VERSION_CHECK_CACHE="$HOME/.cache/claude-yolo-update-checks"

# Show version if requested
if [ "$1" = "--version" ] || [ "$1" = "-v" ]; then
    echo "ccy version $CCY_VERSION"
    echo "Hash: $CCY_HASH"
    exit 0
fi

# Show help if requested
if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    cat << 'EOF'
Claude Code YOLO Mode (ccy) - Container-based execution with --dangerously-skip-permissions

Usage: ccy [OPTIONS] [CLAUDE_ARGS...]

Options:
  --rebuild[=MODE]       Rebuild: (default) full clean rebuild; claude=fast npm update base only; project=npm update + rebuild project image
  --debug                Interactive debug layer selection (CCY, entrypoint, Claude Code)
  --engine ENGINE        Use specific container engine (docker/podman, default: podman)
  --ssh-key PATH         SSH private key to mount (can be specified multiple times)
  --no-ssh               Skip SSH key selection (git push will not work)
  --github-443           Route GitHub SSH over ssh.github.com:443 (use when port 22 is firewall-blocked)
                         Equivalent: export GITHUB_SSH_443=1 before launch (host-level enable)
  --token NAME           Use specific named token
  --create-token         Create a new named token
  --update-token=NAME    Replace an existing named token (e.g. invalidated before expiry)
  --list-tokens          List available tokens, with each account's usage limits
  --export-token [NAME]  Export token(s) as portable import script (interactive if no name)
  --network NETWORK      Auto-connect to specified container network on launch
  --no-network           Skip network auto-detection
  --connect [NETWORK]    Connect running container to network
  --custom               Create/edit custom project Dockerfile interactively
  --custom-docker        AI-guided Dockerfile creation and customization
  --disable-custom-docker  Skip custom Dockerfile build, use base image (for fixing broken Dockerfiles)
  --prompt "text"        Start Claude Code with a preseeded prompt
  --headless             Run in headless mode (requires --prompt)
  --supervise            Run claude under an in-container supervisor wrapper by
                         setting+forwarding CCY_CLAUDE_WRAPPER (default:
                         'claude-supervise --', override via that env var).
                         Requires the supervisor command to be present in the
                         image (see fedora-desktop issue #31); until it is
                         vendored this flag is a no-op that fails loudly if the
                         wrapper is missing. Unset => unchanged behaviour.
                         Per-project alternative: declare CCY_CLAUDE_WRAPPER (and
                         other ccy env) in a tracked .claude/ccy/ccy.env file,
                         sourced in-container by entrypoint.sh before claude runs.
  --top                  Container manager: list/stop all CCY containers
  --prevent              Disable CCY for this project folder (writes 'never' to .claude/ccy/allowed-hostnames)
  --help, -h             Show this help message
  --                     End of ccy options; everything after is forwarded raw to claude

Unrecognised --flag args are validated against claude's own --help. Unknown
flags fail fast with did-you-mean suggestions. Use `--` to forward a flag
raw without validation.

Features:
  • Runs in isolated container with git/gh/ssh configured
  • State persists in /workspace/.claude/ (project-level, part of your repo)
  • Long-lived OAuth tokens (sk-ant-oat01-...) - same as GitHub Actions
  • Named tokens with expiry tracking for multiple Claude accounts
  • Automatic expiry checking - forces new token when expired
  • Auto-updates Claude Code once per day, per image (fast in-place npm update
    when behind; noop when current). Set CCY_AUTO_UPDATE=0 for notify-only.
  • Mounts current directory as /workspace
  • Files created have correct host user ownership
  • Project-specific container extensions via .claude/ccy/Dockerfile

Security:
  ⚠  YOLO mode bypasses all permission checks
  ✓  Container isolation prevents unintended host access
  ✓  Cannot run as root user (safety check)
  ✓  Tokens isolated from desktop Claude Code

Examples:
  ccy                           # Start Claude Code in container
  ccy "implement feature X"     # Start with specific task
  ccy --resume                  # Resume previous conversation
  ccy --prompt "fix the bug"    # Start with prompt
  ccy --headless --prompt "run tests"  # Run in headless mode
  ccy --top                     # Container manager

  # Token management:
  ccy --create-token            # Create a new named token
  ccy --update-token=personal   # Renew an existing token (e.g. after invalidation)
  ccy --token personal          # Use "personal" token
  ccy --list-tokens             # List available tokens
  ccy --export-token             # Interactive multi-token export
  ccy --export-token personal    # Export specific token

Custom Dockerfile (Quick template-based):
  ccy --custom                  # Template selection workflow

Custom Dockerfile (AI-guided planning):
  ccy --custom-docker           # Comprehensive workflow with planning

Network Management (run in separate terminal while ccy is running):
  ccy --connect                 # Interactive network selection
  ccy --connect myproject_default  # Connect to specific network

Token Management:
  Tokens stored in: ~/.claude-tokens/ccy/tokens/
  Format: NAME.YYYY-MM-DD.token (expiry date in filename)
  Long-lived OAuth tokens (sk-ant-oat01-...) created via 'claude setup-token'
  Expiry checked on launch - forces recreation when expired or expiring today
  Desktop Claude Code (~/.claude/) is NEVER modified

Token Usage Limits:
  The selection menu shows each account's 5-hour and weekly utilisation, so you
  can pick an account that still has headroom. Fetched in parallel and cached in
  ~/.claude-tokens/ccy/usage-cache/, so it costs about one round trip and
  nothing at all on a repeat launch within the TTL.
  Env overrides: CCY_TOKEN_USAGE=0 disables it entirely
                 CCY_USAGE_TTL=<seconds>     cache lifetime (default 180)
                 CCY_USAGE_TIMEOUT=<seconds> per-fetch timeout (default 4)
  A fetch that fails never blocks a launch - the row shows why (e.g.
  "usage: not authorised", "usage: unreachable") and selection carries on.

State Management:
  Claude Code state (history, todos, settings) persists in /workspace/.claude/
  This is the project-level state directory - you can commit it or .gitignore it
  Each project has its own isolated state

Project-Specific Container Extensions:
  Command: ccy --custom
  Location: .claude/ccy/Dockerfile
  Image cached as: claude-yolo:<project-name>

  Workflow:
    1. Run 'ccy --custom' in your project
    2. Select a template:
       - Dockerfile.example-ansible (Ansible + testing tools)
       - Dockerfile.example-golang (Go + dev tools)
       - Dockerfile.project-template (generic, use for other stacks)
    3. Choose how to proceed:
       - Use Claude to customize (recommended)
       - Edit manually in $EDITOR
       - Use template as-is
    4. If using Claude:
       - Claude checks what's in base container
       - Scans your project files
       - Asks what tools you need
       - Edits the Dockerfile with proper cache mounts
       - Tells you to: exit, 'ccy --rebuild', 'ccy'
    5. Custom image is cached (fast subsequent starts)

  Templates include Claude instructions:
    Each template has comments telling Claude how to customize it
    Templates know what's already installed (git, gh, Node.js, npm, Claude Code)
    Templates use cache mounts for fast rebuilds

  Template Library:
    Directory: /opt/claude-yolo/custom-dockerfiles/
    Pattern: Dockerfile.<name>
    Never overwritten by ansible - safe to customize
    Add your own templates for reuse across projects

EOF

    # Check if container image exists to show Claude Code help
    if container_cmd image inspect "$IMAGE_NAME" &> /dev/null 2>&1; then
        echo "════════════════════════════════════════════════════════════════════════════════"
        echo "Claude Code Help (from container):"
        echo "════════════════════════════════════════════════════════════════════════════════"
        echo ""
        # Run claude --help in container to show actual Claude Code options
        container_cmd run --rm --entrypoint claude "$IMAGE_NAME" --help 2>/dev/null || echo "Note: Container exists but Claude Code help unavailable"
    else
        echo "════════════════════════════════════════════════════════════════════════════════"
        echo "Claude Code Help:"
        echo "════════════════════════════════════════════════════════════════════════════════"
        echo ""
        echo "Container image not built yet. Run 'ccy --rebuild' first to build the container,"
        echo "then run 'ccy --help' again to see Claude Code options."
    fi

    exit 0
fi

# Function to load last launch configuration for current project
# Returns 0 if valid config loaded, 1 if no config or invalid
load_launch_config() {
    local ccy_root="$1"
    local config_file="$ccy_root/.last-launch.conf"

    # Check if config exists
    if [[ ! -f "$config_file" ]]; then
        return 1  # No config, use interactive
    fi

    # Source config
    source "$config_file" 2>/dev/null || {
        echo "Warning: Config file corrupted, reconfiguring..." >&2
        rm -f "$config_file"
        return 1
    }

    # Validate CONFIG_VERSION (schema version)
    if [[ "${SAVED_CONFIG_VERSION:-0}" != "$CONFIG_VERSION" ]]; then
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" >&2
        echo "⚠️  Config schema outdated" >&2
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" >&2
        echo "Saved config:  v${SAVED_CONFIG_VERSION:-0}" >&2
        echo "Expected:      v${CONFIG_VERSION}" >&2
        echo "" >&2
        echo "Your saved launch configuration uses an old format." >&2
        echo "Reconfiguring with interactive prompts..." >&2
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" >&2
        echo "" >&2
        rm -f "$config_file"
        return 1
    fi

    # Validate CCY_VERSION and CCY_HASH together
    local version_match=false
    local hash_match=false

    [[ "${CCY_VERSION}" == "${SAVED_CCY_VERSION:-}" ]] && version_match=true
    [[ "${CCY_HASH}" == "${SAVED_CCY_HASH:-}" ]] && hash_match=true

    if $version_match && $hash_match; then
        # Perfect match - config is valid
        return 0

    elif $version_match && ! $hash_match; then
        # VERSION same but HASH different = Developer forgot to update version!
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" >&2
        echo "⚠️  DEVELOPER ERROR: CCY script modified without version bump" >&2
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" >&2
        echo "Version:       ${CCY_VERSION} (unchanged)" >&2
        echo "Saved hash:    ${SAVED_CCY_HASH:-unknown}" >&2
        echo "Current hash:  ${CCY_HASH}" >&2
        echo "" >&2
        echo "The CCY script has been modified but CCY_VERSION was not updated." >&2
        echo "This is a developer error - version numbers must be incremented" >&2
        echo "when the script changes to ensure config compatibility." >&2
        echo "" >&2
        echo "Forcing reconfiguration for safety..." >&2
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" >&2
        echo "" >&2
        rm -f "$config_file"
        return 1

    elif ! $version_match; then
        # VERSION different = Normal upgrade/downgrade
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" >&2
        echo "ℹ️  CCY version changed" >&2
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" >&2
        echo "Saved config:  v${SAVED_CCY_VERSION:-unknown}" >&2
        echo "Current CCY:   v${CCY_VERSION}" >&2
        echo "" >&2
        echo "Reconfiguring for compatibility with new version..." >&2
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" >&2
        echo "" >&2
        rm -f "$config_file"
        return 1
    fi
}

# Function to save launch configuration for current project
save_launch_config() {
    local ccy_root="$1"
    local token_name="$2"
    local ssh_keys_str="$3"
    local network="$4"

    local config_file="$ccy_root/.last-launch.conf"

    cat > "$config_file" <<EOF
# CCY Launch Configuration
# Config Version: ${CONFIG_VERSION}
# CCY Version: ${CCY_VERSION}
# CCY Hash: ${CCY_HASH}
# Generated: $(date '+%Y-%m-%d %H:%M:%S')
SAVED_CONFIG_VERSION=${CONFIG_VERSION}
SAVED_CCY_VERSION="${CCY_VERSION}"
SAVED_CCY_HASH="${CCY_HASH}"
LAST_TOKEN="${token_name}"
LAST_SSH_KEYS="${ssh_keys_str}"
LAST_NETWORK="${network}"
LAST_LAUNCH_DATE="$(date '+%Y-%m-%d')"
EOF

    chmod 600 "$config_file"
}

# Check for wrapper flags
FORCE_REBUILD=false
REBUILD_MODE="full"
DISABLE_CUSTOM_DOCKER=false
DEBUG_MODE=false
DEBUG_CCY=false
DEBUG_ENTRYPOINT=false
DEBUG_CLAUDE=false
SHOW_DEBUG_CHOOSER=false
SSH_KEYS=()
CLAUDE_ARGS=()
NEXT_IS_SSH_KEY=false
NEXT_IS_TOKEN=false
NEXT_IS_CONNECT=false
NEXT_IS_NETWORK=false
NEXT_IS_PROMPT=false
NEXT_IS_ENGINE=false
SPECIFIED_TOKEN=""
CREATE_TOKEN_MODE=false
UPDATE_TOKEN_MODE=false
UPDATE_TOKEN_NAME=""
NEXT_IS_UPDATE_TOKEN=false
LIST_TOKENS_MODE=false
EXPORT_TOKEN_MODE=false
EXPORT_TOKEN_NAME=""
NEXT_IS_EXPORT_TOKEN=false
CONNECT_MODE=false
CUSTOM_MODE=false
CUSTOM_DOCKER_MODE=false
TOP_MODE=false
PREVENT_MODE=false
CONNECT_NETWORK=""
NO_SSH_MODE=false
GITHUB_443_MODE=false
SPECIFIED_NETWORK=""
NETWORK_FROM_CONFIG=false
NO_NETWORK_MODE=false
HEADLESS_MODE=false
SUPERVISE_MODE=false
PROMPT_TEXT=""
SAW_DOUBLE_DASH=false

for arg in "$@"; do
    if [ "$SAW_DOUBLE_DASH" = true ]; then
        # Everything after `--` is forwarded raw to claude without ccy parsing
        CLAUDE_ARGS+=("$arg")
    elif [ "$arg" = "--" ]; then
        # POSIX-style separator: end of ccy options, rest is for claude
        SAW_DOUBLE_DASH=true
    elif [ "$NEXT_IS_ENGINE" = true ]; then
        # Validate engine choice
        if [[ "$arg" != "docker" ]] && [[ "$arg" != "podman" ]]; then
            print_error "Invalid container engine: $arg"
            echo "Valid options: docker, podman" >&2
            exit 1
        fi
        # Check if engine is available
        if ! command -v "$arg" &>/dev/null; then
            print_error "Container engine '$arg' not found"
            echo "Please install $arg or use a different engine" >&2
            exit 1
        fi
        CONTAINER_ENGINE="$arg"
        export CONTAINER_ENGINE
        NEXT_IS_ENGINE=false
    elif [ "$NEXT_IS_SSH_KEY" = true ]; then
        if [ ! -f "$arg" ]; then
            print_error "SSH key not found: $arg"
            exit 1
        fi
        SSH_KEYS+=("$arg")
        NEXT_IS_SSH_KEY=false
    elif [ "$NEXT_IS_EXPORT_TOKEN" = true ]; then
        EXPORT_TOKEN_NAME="$arg"
        NEXT_IS_EXPORT_TOKEN=false
    elif [ "$NEXT_IS_UPDATE_TOKEN" = true ]; then
        UPDATE_TOKEN_NAME="$arg"
        NEXT_IS_UPDATE_TOKEN=false
    elif [ "$NEXT_IS_TOKEN" = true ]; then
        SPECIFIED_TOKEN="$arg"
        NEXT_IS_TOKEN=false
    elif [ "$NEXT_IS_CONNECT" = true ]; then
        CONNECT_NETWORK="$arg"
        NEXT_IS_CONNECT=false
    elif [ "$NEXT_IS_NETWORK" = true ]; then
        SPECIFIED_NETWORK="$arg"
        NEXT_IS_NETWORK=false
    elif [ "$NEXT_IS_PROMPT" = true ]; then
        PROMPT_TEXT="$arg"
        NEXT_IS_PROMPT=false
    elif [ "$arg" = "--rebuild" ]; then
        FORCE_REBUILD=true
        REBUILD_MODE="full"
    elif [[ "$arg" == "--rebuild="* ]]; then
        FORCE_REBUILD=true
        REBUILD_MODE="${arg#--rebuild=}"
        if [[ "$REBUILD_MODE" != "claude" && "$REBUILD_MODE" != "project" && "$REBUILD_MODE" != "full" ]]; then
            print_error "Invalid --rebuild mode: $REBUILD_MODE"
            echo "Valid modes: claude (default), project, full" >&2
            exit 1
        fi
    elif [ "$arg" = "--disable-custom-docker" ]; then
        DISABLE_CUSTOM_DOCKER=true
    elif [ "$arg" = "--no-ssh" ]; then
        NO_SSH_MODE=true
    elif [ "$arg" = "--github-443" ]; then
        GITHUB_443_MODE=true
    elif [ "$arg" = "--no-network" ]; then
        NO_NETWORK_MODE=true
    elif [ "$arg" = "--headless" ]; then
        HEADLESS_MODE=true
    elif [ "$arg" = "--supervise" ]; then
        SUPERVISE_MODE=true
    elif [ "$arg" = "--prompt" ]; then
        NEXT_IS_PROMPT=true
    elif [ "$arg" = "--debug" ]; then
        SHOW_DEBUG_CHOOSER=true
    elif [ "$arg" = "--engine" ]; then
        NEXT_IS_ENGINE=true
    elif [ "$arg" = "--ssh-key" ]; then
        NEXT_IS_SSH_KEY=true
    elif [ "$arg" = "--token" ]; then
        NEXT_IS_TOKEN=true
    elif [ "$arg" = "--create-token" ]; then
        CREATE_TOKEN_MODE=true
    elif [[ "$arg" == "--update-token="* ]]; then
        UPDATE_TOKEN_MODE=true
        UPDATE_TOKEN_NAME="${arg#--update-token=}"
        if [ -z "$UPDATE_TOKEN_NAME" ]; then
            print_error "--update-token requires a token name (e.g. --update-token=personal)"
            exit 1
        fi
    elif [ "$arg" = "--update-token" ]; then
        UPDATE_TOKEN_MODE=true
        NEXT_IS_UPDATE_TOKEN=true
    elif [ "$arg" = "--list-tokens" ]; then
        LIST_TOKENS_MODE=true
    elif [ "$arg" = "--export-token" ]; then
        EXPORT_TOKEN_MODE=true
        NEXT_IS_EXPORT_TOKEN=true
    elif [ "$arg" = "--network" ]; then
        NEXT_IS_NETWORK=true
    elif [ "$arg" = "--connect" ]; then
        CONNECT_MODE=true
        NEXT_IS_CONNECT=true
    elif [ "$arg" = "--custom" ]; then
        CUSTOM_MODE=true
    elif [ "$arg" = "--custom-docker" ]; then
        CUSTOM_DOCKER_MODE=true
    elif [ "$arg" = "--top" ]; then
        TOP_MODE=true
    elif [ "$arg" = "--prevent" ]; then
        PREVENT_MODE=true
    else
        CLAUDE_ARGS+=("$arg")
    fi
done

# Export the GitHub-443 toggle as the env var consumed BOTH by the host-side SSH
# probe in build_ssh_mounts_and_validate (ssh-handling.bash) and by the container
# entrypoint. Set here — after parsing, before the probe at build_ssh_mounts_and_validate.
#
# Precedence (highest first):
#   1. --github-443 flag           → force 443 on for this run
#   2. inherited GITHUB_SSH_443=1  → host-level enable (e.g. `export GITHUB_SSH_443=1; ccy`,
#                                    a profile.d export, or `eval "$(github-ssh-443 env)"`).
#                                    This is the host→container signal: enabling 443 on the
#                                    desktop makes ccy run in 443 mode automatically.
#   3. otherwise                   → 0, and the launch-time auto-fallback probe still applies.
# Without honouring the inherited value, a host export would be clobbered to 0 here.
if [ "$GITHUB_443_MODE" = true ] || [ "${GITHUB_SSH_443:-0}" = "1" ]; then
    export GITHUB_SSH_443=1
else
    export GITHUB_SSH_443=0
fi
# Snapshot the 443 state BEFORE the SSH probe so the post-validate banner can name
# the trigger: still 1 here means flag/env; flipped 0→1 by the probe means
# auto-fallback (port 22 firewall-blocked).
GITHUB_443_PRELAUNCH="$GITHUB_SSH_443"

# ─────────────────────────────────────────────────────────────────────────────
# Fail-fast flag validation
# ─────────────────────────────────────────────────────────────────────────────
# Anything `--<flag>`-shaped that fell through to CLAUDE_ARGS *before* a `--`
# separator is a candidate claude flag. Validate against `claude --help` from
# the base image so we error out *now*, before SSH/gh/token/container work.
# Args after `--` are forwarded raw and skipped.
# ─────────────────────────────────────────────────────────────────────────────
suspect_flags=()
for a in "${CLAUDE_ARGS[@]}"; do
    [[ "$a" == --* ]] || continue
    suspect_flags+=("${a%%=*}")
done

if [ ${#suspect_flags[@]} -gt 0 ]; then
    # Source `claude --help`. Prefer host binary (instant); fall back to running
    # claude inside the base image if the host doesn't have it. If neither is
    # available, skip validation (claude itself will reject bogus flags later).
    claude_help=""
    if command -v claude &>/dev/null; then
        claude_help=$(claude --help 2>&1) || claude_help=""
    fi
    if [ -z "$claude_help" ] && container_cmd image inspect "$IMAGE_NAME" &>/dev/null; then
        if ! claude_help=$(container_cmd run --rm --entrypoint claude "$IMAGE_NAME" --help 2>&1); then
            print_error "Could not run 'claude --help' in $IMAGE_NAME to validate flags"
            echo "$claude_help" >&2
            exit 1
        fi
    fi

    if [ -z "$claude_help" ]; then
        # No way to validate. Skip and let claude itself reject later.
        :
    else

        unknown=()
        for f in "${suspect_flags[@]}"; do
            if ! grep -qE -- "(^|[[:space:],])${f}([[:space:],=]|$)" <<< "$claude_help"; then
                unknown+=("$f")
            fi
        done

        if [ ${#unknown[@]} -gt 0 ]; then
            ccy_flags=(
                --rebuild --disable-custom-docker --no-ssh --github-443 --no-network
                --headless --supervise --prompt --debug --engine --ssh-key --token --create-token
                --update-token --list-tokens --export-token --network --connect
                --custom --custom-docker --top --prevent --help
            )
            claude_known=$(grep -oE -- '--[a-zA-Z][a-zA-Z0-9-]*' <<< "$claude_help" | sort -u)

            print_error "Unknown flag(s): ${unknown[*]}"
            echo "" >&2
            echo "Neither ccy nor claude recognises these flags." >&2
            echo "" >&2
            for u in "${unknown[@]}"; do
                stem="${u#--}"
                echo "  $u" >&2
                ccy_match=$(printf '%s\n' "${ccy_flags[@]}" | grep -i -- "$stem" | head -3 | tr '\n' ' ')
                [ -n "$ccy_match" ] && echo "    Did you mean (ccy)?    $ccy_match" >&2
                claude_match=$(grep -i -- "$stem" <<< "$claude_known" | head -3 | tr '\n' ' ')
                [ -n "$claude_match" ] && echo "    Did you mean (claude)? $claude_match" >&2
            done
            echo "" >&2
            echo "To forward unrecognised flags raw to claude, use a -- separator:" >&2
            echo "  ccy [ccy-options] -- ${unknown[*]}" >&2
            exit 1
        fi
    fi
fi

# Handle debug layer selection
if [ "$SHOW_DEBUG_CHOOSER" = true ]; then
    echo "════════════════════════════════════════════════════════════════════════════════"
    echo "Debug Layer Selection"
    echo "════════════════════════════════════════════════════════════════════════════════"
    echo ""
