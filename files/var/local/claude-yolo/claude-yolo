#!/bin/bash
# Claude Code YOLO Mode Wrapper
# Runs Claude Code with --dangerously-skip-permissions in isolated Docker container
# IMPORTANT: Uses separate token storage from desktop Claude Code to prevent OAuth conflicts
#
# Version: 3.0.0 - Simplified: removed sessions, use project-level .claude/ naturally
#
# IMPORTANT: When modifying this script, ALWAYS increment CCY_VERSION!
# The hash validates script integrity - if hash changes but version doesn't,
# users will get a warning that version wasn't properly updated.
#
# The CCY_VERSION comment is ONE short line describing the CURRENT release only -
# the rebuild banner prints it verbatim to the user. Release notes go in
# docs/ccy-changelog.md; per-change detail is in git. Do NOT append "Prior x.y.z:"
# history here: it grew to 6,881 characters before being moved out.
#
CCY_VERSION="3.88.1"  # A headless launch never stops at a container menu. See docs/ccy-changelog.md.

# Load shared helpers
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Every library this launcher sources DIRECTLY, in load order. This drives the
# presence check below and nothing else: the integrity hash derives its own set
# from lib/ (see CCY_HASH), because a hand-written list of what the program
# consists of is a list that goes stale — this one omitted common-pure.bash,
# which common.bash sources, for two months.
CCY_LIBS=(common token-management ssh-handling network-management dockerfile-custom docker-health session-registry restart-request session-lifecycle tmux-session agent-bus-seats)

if [ -f "$SCRIPT_DIR/lib/common.bash" ]; then
    source "$SCRIPT_DIR/lib/common.bash"
else
    # Fallback if library not found
    echo "ERROR: Shared library not found at $SCRIPT_DIR/lib/common.bash" >&2
    exit 1
fi

# Load specialized libraries.
#
# Presence is still checked in a loop, so a missing library fails exactly as it
# did before, naming the file. The `source` calls are then written out one per
# line so that each carries a `# shellcheck source=` directive: with a computed
# `$lib.bash` filename shellcheck cannot resolve any of them, and reported five
# unfollowable sources as SC1090 instead of actually checking the libraries this
# script's every function comes from. Same load order, same failure, real
# cross-file analysis.
for lib in "${CCY_LIBS[@]}"; do
    if [ ! -f "$SCRIPT_DIR/lib/$lib.bash" ]; then
        print_error "Required library not found: $SCRIPT_DIR/lib/$lib.bash"
        exit 1
    fi
done

# shellcheck source=lib/token-management.bash
source "$SCRIPT_DIR/lib/token-management.bash"
# shellcheck source=lib/ssh-handling.bash
source "$SCRIPT_DIR/lib/ssh-handling.bash"
# shellcheck source=lib/network-management.bash
source "$SCRIPT_DIR/lib/network-management.bash"
# shellcheck source=lib/dockerfile-custom.bash
source "$SCRIPT_DIR/lib/dockerfile-custom.bash"
# shellcheck source=lib/docker-health.bash
source "$SCRIPT_DIR/lib/docker-health.bash"
# shellcheck source=lib/session-registry.bash
source "$SCRIPT_DIR/lib/session-registry.bash"
# shellcheck source=lib/restart-request.bash
source "$SCRIPT_DIR/lib/restart-request.bash"
# shellcheck source=lib/session-lifecycle.bash
source "$SCRIPT_DIR/lib/session-lifecycle.bash"
# shellcheck source=lib/tmux-session.bash
source "$SCRIPT_DIR/lib/tmux-session.bash"
# shellcheck source=lib/agent-bus-seats.bash
source "$SCRIPT_DIR/lib/agent-bus-seats.bash"

# IMPORTANT: When modifying the Dockerfile, ALWAYS increment REQUIRED_CONTAINER_VERSION!
# This ensures users automatically rebuild when critical container changes are made.
# ⚠️  THIS VALUE MUST MATCH the "claude-yolo-version" LABEL in Dockerfile!
#     If they don't match, users get infinite rebuild loops.
#     Update BOTH files together: Dockerfile label AND this variable.
REQUIRED_CONTAINER_VERSION="2.48"

set -e

# Debug output helper - only prints when DEBUG_CCY=true
# Usage: debug "message"
debug() {
    if [[ "$DEBUG_CCY" = true ]]; then echo "DEBUG: $*"; fi
}

# Calculate script hash (exclude this variable line to avoid circular dependency).
#
# The hash covers the launcher AND every library it sources. It was md5sum of
# "$0" alone, while the six lib/ files total more bytes than the launcher does —
# so a behaviour change in lib/token-management.bash left the hash unchanged and
# the "modified without version bump" guard below never fired. 22 commits in
# this repo's history shipped lib-only changes that way. Plan 00081 F7.
#
# The hashed set is DERIVED from the directory, not enumerated. CCY_LIBS answers
# "in what order are these loaded"; that is a different question from "what is
# part of this program", and using one list for both is what went wrong: the
# enumeration was a file short of lib/ the moment it was written, because
# common-pure.bash predated it by two months and common.bash:12 sources it
# unconditionally. Editing it left this hash unchanged while
# scripts/git-hooks/pre-commit:129 — the other half of the same guard — globbed
# `lib/*.bash` and did gate it. A derived set cannot go stale on the eighth
# library. LC_ALL=C sort, because bash's own glob order follows the locale's
# collation and `common-pure.bash` vs `common.bash` sorts differently under
# en_US.UTF-8 than under C, which would move the hash between machines.
CCY_LIB_COUNT=$(find "$SCRIPT_DIR/lib" -maxdepth 1 -name '*.bash' -type f | wc -l)
if [ "$CCY_LIB_COUNT" -eq 0 ]; then
    print_error "No libraries found in $SCRIPT_DIR/lib — refusing to vouch for an empty hash."
    exit 1
fi
# lib/*.py is the one-key agent (ssh_agent_filter.py), which ships beside the libraries and
# runs as part of a launch, so it is part of the program too.
CCY_HASH=$(
    {
        grep -v '^CCY_HASH=' "$0"
        find "$SCRIPT_DIR/lib" -maxdepth 1 \( -name '*.bash' -o -name '*.py' \) -type f -print0 |
            LC_ALL=C sort -z |
            xargs -0 cat
    } | md5sum | cut -d' ' -f1 | cut -c1-16
)

# The Quick Launch file's format: the keys it holds and what they mean. Bump it only when
# those change. A saved file of this format is kept across CCY_VERSION changes.
CONFIG_VERSION=1

IMAGE_NAME="claude-yolo:latest"
# Base image (no LSPs) - available for project Dockerfiles that want leaner images
BASE_IMAGE_NAME="claude-yolo:base"
DOCKERFILE_DIR="/opt/claude-yolo"
CCY_ROOT="$HOME/.claude-tokens/ccy"
TOKEN_DIR="$CCY_ROOT/tokens"
PROJECT_DIR="$CCY_ROOT/projects"
# Per-image daily update-check stamps live as files INSIDE this directory
# (one per image tag — claude-yolo:latest, claude-yolo:<project>, …). It used to
# be a single global file; per-image gating means an old project opened today
# still re-checks even if another project already checked earlier today. New path
# (not the old "-version-check" file) avoids a file-vs-directory migration clash.
VERSION_CHECK_CACHE="$HOME/.cache/claude-yolo-update-checks"
# The restart budget's history (ccy_handle_restart_exit), one file per project. Its own
# directory, never inside VERSION_CHECK_CACHE: that one is disposable and is deleted on every
# rebuild, and deleting this one would reset the bound that stops a restart loop.
CCY_RESTART_HISTORY_DIR="$HOME/.cache/claude-yolo-restart-history"

# The informational options come BEFORE the repository-root check: they print and exit,
# operate on no project, and must work from any directory. Nothing above this point reads
# or writes the working directory. Every other option goes through the check below.

# Show version if requested
if [ "$1" = "--version" ] || [ "$1" = "-v" ]; then
    echo "ccy version $CCY_VERSION"
    echo "Hash: $CCY_HASH"
    exit 0
fi

# Show help if requested
if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    cat << 'EOF'
Claude Code YOLO Mode (ccy) - Container-based execution with --dangerously-skip-permissions

Usage: ccy [OPTIONS] [CLAUDE_ARGS...]

Options:
  --rebuild[=MODE]       Rebuild: (default) full clean rebuild; claude=fast npm update base only; project=npm update + rebuild project image
  --debug                Interactive debug layer selection (CCY, entrypoint, Claude Code)
  --engine ENGINE        Use specific container engine (docker/podman, default: podman)
  --ssh-key PATH         SSH private key to mount (can be specified multiple times). A
                         key that needs a passphrase, when your ssh-agent holds it, is
                         forwarded from the agent instead: those keys only, no prompt
  --ssh-agent            Forward the session's ssh-agent ($SSH_AUTH_SOCK, e.g. from ssh -A)
                         into the container; pushes authenticate as whoever it signs as.
                         Runs that container with SELinux labelling disabled (the only
                         way container_t can reach an unconfined agent's socket).
  --no-ssh               Skip SSH key selection (git push will not work)
  --github-443           Route GitHub SSH over ssh.github.com:443 (use when port 22 is firewall-blocked)
                         Equivalent: export GITHUB_SSH_443=1 before launch (host-level enable)
  --token NAME           Use specific named token
  --create-token         Create a new named token
  --update-token=NAME    Replace an existing named token (e.g. invalidated before expiry)
  --list-tokens          List available tokens
  --export-token [NAME]  Export token(s) as portable import script (interactive if no name)
  --network NETWORK      Auto-connect to specified container network on launch
  --no-network           Skip network auto-detection
  --connect [NETWORK]    Connect running container to network (also saves it as the
                         project's default, which every later launch reconnects to)
  --disconnect [NETWORK] Disconnect running container from network (picker if no name),
                         and forget that network wherever a later launch reads it: the
                         saved default, Quick Launch, and this project's restore records
  --custom               Create/edit custom project Dockerfile interactively
  --custom-docker        AI-guided Dockerfile creation and customization
  --disable-custom-docker  Skip custom Dockerfile build, use base image (for fixing broken Dockerfiles)
  --prompt "text"        Start Claude Code with a preseeded prompt
  --headless             Run in headless mode (requires --prompt). With no --token,
                         --ssh-key, --ssh-agent, --no-ssh, --network or --no-network it
                         takes this checkout's saved Quick Launch choices without asking,
                         and is refused when there are none; a key that needs a
                         passphrase is refused unless your ssh-agent holds it (ssh-add it)
  --teams SEAT@TEAM[,SEAT@TEAM...]
                         Put this session in agent team bus teams, one seat in each
                         (e.g. --teams dev1@dev-team,qa2@other-team; quote a list with
                         spaces). A seat is created on its first use (sudo agent-bus
                         add-member) and is held by one session at a time. Without
                         --teams a session is in no team. Needs play-agent-bus.yml.
  --supervise            Force the PTY supervisor on and ARMED — it injects a
                         real /compact when context goes red while idle. The
                         supervisor already runs UNARMED by default whenever the
                         project ships one (.claude/ccy/claude-supervise.py,
                         deployed by the hooks daemon), because it carries the
                         only ctrl+z guard; this flag adds the compaction.
                         Override the whole wrap by exporting CCY_CLAUDE_WRAPPER,
                         or per-project via a tracked .claude/ccy/ccy.env (then an
                         untracked ccy.env.local), which entrypoint.sh sources
                         before claude runs.
  --no-supervise         Run claude unwrapped. Disables auto-compaction AND the
                         ctrl+z guard, so ctrl+z can freeze the session.
  --max-age DURATION     Restart the session on a fresh container (and so the newest Claude
                         Code) once it has run this long, at the first idle point after a
                         warning to the session. DURATION is days, hours and minutes:
                         90m, 12h, 3d, 1d12h; between 30m and 30d. Off unless given, or
                         CCY_MAX_AGE is exported. Needs the supervisor.
  --run-for DURATION     Tell the session its time is up after this long (same DURATION
                         form, 1m to 30d). Only announces; it never ends the session.
  --until HH:MM          Same, at the next HH:MM local time. Use one of --run-for/--until.
  --no-restore           Do not bring this session back after a reboot on a machine
                         that restores sessions (ccy-sessions restore; docs/ccy.md)
  --top                  Container manager: list/stop all CCY containers
  --prevent              Disable CCY for this project folder (writes 'never' to .claude/ccy/allowed-hostnames)
  --help, -h             Show this help message
  --                     End of ccy options; everything after is forwarded raw to claude

Unrecognised --flag args are validated against claude's own --help. Unknown
flags fail fast with did-you-mean suggestions. Use `--` to forward a flag
raw without validation.

Features:
  • Runs in isolated container with git/gh/ssh configured
  • State persists in /workspace/.claude/ (project-level, part of your repo)
  • Long-lived OAuth tokens (sk-ant-oat01-...) - same as GitHub Actions
  • Named tokens with expiry tracking for multiple Claude accounts
  • Automatic expiry checking - forces new token when expired
  • Auto-updates Claude Code once per day, per image (fast in-place npm update
    when behind; noop when current). Set CCY_AUTO_UPDATE=0 for notify-only.
  • Mounts current directory as /workspace
  • Files created have correct host user ownership
  • Project-specific container extensions via .claude/ccy/Dockerfile

Security:
  ⚠  YOLO mode bypasses all permission checks
  ✓  Container isolation prevents unintended host access
  ✓  Cannot run as root user (safety check)
  ✓  Tokens isolated from desktop Claude Code

Examples:
  ccy                           # Start Claude Code in container
  ccy "implement feature X"     # Start with specific task
  ccy --resume                  # Resume previous conversation
  ccy --prompt "fix the bug"    # Start with prompt
  ccy --headless --prompt "run tests"  # Run in headless mode
  ccy --top                     # Container manager

  # Token management:
  ccy --create-token            # Create a new named token
  ccy --update-token=personal   # Renew an existing token (e.g. after invalidation)
  ccy --token personal          # Use "personal" token
  ccy --list-tokens             # List available tokens
  ccy --export-token             # Interactive multi-token export
  ccy --export-token personal    # Export specific token

Custom Dockerfile (Quick template-based):
  ccy --custom                  # Template selection workflow

Custom Dockerfile (AI-guided planning):
  ccy --custom-docker           # Comprehensive workflow with planning

Network Management (run in separate terminal while ccy is running):
  ccy --connect                 # Interactive network selection
  ccy --connect myproject_default  # Connect to specific network
  ccy --disconnect              # Pick a network to disconnect from
  ccy --disconnect myproject_default  # Undo a wrong --connect, saved default included

Token Management:
  Tokens stored in: ~/.claude-tokens/ccy/tokens/
  Format: NAME.YYYY-MM-DD.token (expiry date in filename)
  Long-lived OAuth tokens (sk-ant-oat01-...) created via 'claude setup-token'
  Expiry checked on launch - forces recreation when expired or expiring today
  Desktop Claude Code (~/.claude/) is NEVER modified

State Management:
  Claude Code state (history, todos, settings) persists in /workspace/.claude/
  This is the project-level state directory - you can commit it or .gitignore it
  Each project has its own isolated state

Project-Specific Container Extensions:
  Command: ccy --custom
  Location: .claude/ccy/Dockerfile
  Image cached as: claude-yolo:<project-name>

  Workflow:
    1. Run 'ccy --custom' in your project
    2. Select a template:
       - Dockerfile.example-ansible (Ansible + testing tools)
       - Dockerfile.example-golang (Go + dev tools)
       - Dockerfile.project-template (generic, use for other stacks)
    3. Choose how to proceed:
       - Use Claude to customize (recommended)
       - Edit manually in $EDITOR
       - Use template as-is
    4. If using Claude:
       - Claude checks what's in base container
       - Scans your project files
       - Asks what tools you need
       - Edits the Dockerfile with proper cache mounts
       - Tells you to: exit, 'ccy --rebuild', 'ccy'
    5. Custom image is cached (fast subsequent starts)

  Templates include Claude instructions:
    Each template has comments telling Claude how to customize it
    Templates know what's already installed (git, gh, Node.js, npm, Claude Code)
    Templates use cache mounts for fast rebuilds

  Template Library:
    Directory: /opt/claude-yolo/custom-dockerfiles/
    Pattern: Dockerfile.<name>
    Never overwritten by ansible - safe to customize
    Add your own templates for reuse across projects

EOF

    # Check if container image exists to show Claude Code help
    if container_cmd image inspect "$IMAGE_NAME" &> /dev/null 2>&1; then
        echo "════════════════════════════════════════════════════════════════════════════════"
        echo "Claude Code Help (from container):"
        echo "════════════════════════════════════════════════════════════════════════════════"
        echo ""
        # Run claude --help in container to show actual Claude Code options.
        # The engine's own message is kept and shown: "help unavailable" on its
        # own tells the user nothing about WHY, and the reason (image broken,
        # engine not running, entrypoint missing) is what they need.
        if claude_help=$(container_cmd run --rm --entrypoint claude "$IMAGE_NAME" --help 2>&1); then
            printf '%s\n' "$claude_help"
        else
            echo "Note: the image exists, but 'claude --help' would not run inside it."
            echo "  ${CONTAINER_ENGINE:-container engine} said: ${claude_help:-no output}"
        fi
    else
        echo "════════════════════════════════════════════════════════════════════════════════"
        echo "Claude Code Help:"
        echo "════════════════════════════════════════════════════════════════════════════════"
        echo ""
        echo "Container image not built yet. Run 'ccy --rebuild' first to build the container,"
        echo "then run 'ccy --help' again to see Claude Code options."
    fi

    exit 0
fi

# `ccy --list-tokens` on its own reads only the token store. Combined with other options it
# is handled after argument parsing, behind the repository-root check, as any launch is.
if [ "$#" -eq 1 ] && [ "$1" = "--list-tokens" ]; then
    list_tokens "$TOKEN_DIR" "ccy"
    exit 0
fi

# Fail fast: Must be run from a git repository root
check_git_repo || exit 1

# Security check: Ensure no dangerous files are tracked in .claude/ccy/
check_ccy_gitignore_safety || exit 1

# ccy's tracked template for this checkout's ccy.env.local, and a warning if that file is older
ccy_env_local_dist_sync || exit 1

# Hostname restriction: prevent running Desktop CCY on projects locked to a specific host
check_allowed_hostname || exit 1

# Is this the relaunch of a session that asked to restart (ccy_handle_restart_exit, at the end
# of this script)? Nobody is watching it, so it must never wait at a prompt: its arguments
# carry every launch choice the session ran with, the prompts with one safe answer take it,
# and the rest stop the launch with the manual resume command (lib/restart-request.bash).
# Until the container starts, stdin is /dev/null, so a prompt nobody has accounted for here
# fails instead of waiting for ever; the terminal comes back just before `container_cmd run`.
ccy_restart_marker_take || exit 1
if [ -n "$CCY_RESTART_RELAUNCH_SESSION" ]; then
    exec {CCY_RESTART_TTY_FD}<&0 </dev/null
fi

# Migration: detect and offer to remove old session directories (v2.x -> v3.x). A restart
# keeps them without asking: keeping is the answer that changes nothing, and if they are still
# here the person gave that answer when the session was launched.
if [ -d ".claude/ccy/sessions" ] && [ -z "$CCY_RESTART_RELAUNCH_SESSION" ]; then
    session_count=$(find .claude/ccy/sessions -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)  # FAIL-FAST-OK: wc always yields a number, and 0 means "no migration needed" — the safe default
    if [ "$session_count" -gt 0 ]; then
        echo ""
        echo "════════════════════════════════════════════════════════════════════════════════"
        echo "Migration: Old session directories detected"
        echo "════════════════════════════════════════════════════════════════════════════════"
        echo ""
        echo "CCY v3.0 no longer uses sessions. Found $session_count old session(s) in:"
        echo "  .claude/ccy/sessions/"
        echo ""
        echo "Claude Code now uses .claude/ directly (project-level state)."
        echo ""
        read -rp "$CCY_PROMPT_MIGRATION " remove_sessions
        case "$remove_sessions" in
            y|Y|yes|Yes)
                rm -rf .claude/ccy/sessions
                echo "✓ Removed .claude/ccy/sessions/"
                # Also remove config.json if it exists (session config)
                [ -f ".claude/ccy/config.json" ] && rm -f .claude/ccy/config.json && echo "✓ Removed .claude/ccy/config.json"
                # Remove .claude/ccy if empty. `rmdir` refuses a non-empty
                # directory by design, so it IS the emptiness test — asking `ls`
                # first only added a path on which "could not list the directory"
                # was indistinguishable from "the directory is empty", and then
                # rmdir ran anyway on that guess.
                if [ -d ".claude/ccy" ]; then
                    if rmdir_result=$(rmdir .claude/ccy 2>&1); then
                        echo "✓ Removed empty .claude/ccy/"
                    else
                        echo "  Kept .claude/ccy/ — $rmdir_result"
                    fi
                fi
                echo ""
                ;;
            *)
                echo "Keeping old sessions. You can remove them later with:"
                echo "  rm -rf .claude/ccy/sessions/"
                echo ""
                ;;
        esac
        echo "════════════════════════════════════════════════════════════════════════════════"
        echo ""
    fi
fi

# Get project name from directory (used for container naming)
# Uses parent-project format to avoid collisions (defined in lib/common.bash)
PROJECT_NAME=$(get_project_name)

# Function to load last launch configuration for current project
# Returns 0 if valid config loaded, 1 if no config or invalid
load_launch_config() {
    local ccy_root="$1"
    local config_file="$ccy_root/.last-launch.conf"

    # Check if config exists
    if [[ ! -f "$config_file" ]]; then
        return 1  # No config, use interactive
    fi

    # Source config. `source=/dev/null` states a fact rather than silencing a
    # check: .last-launch.conf is user runtime state written at launch, not a
    # file in this repo, so there is nothing for shellcheck to follow. The
    # failure IS handled — the `||` branch below reports and resets it. What the file does
    # not set must not come from the environment, so the keys are cleared first.
    unset SAVED_CONFIG_VERSION SAVED_CCY_VERSION SAVED_CCY_HASH LAST_TOKEN LAST_SSH_KEYS LAST_NETWORK LAST_LAUNCH_DATE
    # shellcheck source=/dev/null
    source "$config_file" 2>/dev/null || {
        echo "Warning: Config file corrupted, reconfiguring..." >&2
        rm -f "$config_file"
        return 1
    }

    # The format decides whether the saved choices can be read, not the ccy version that
    # wrote them. A file with no format line was not written by ccy and is not trusted.
    if [[ "${SAVED_CONFIG_VERSION:-none}" != "$CONFIG_VERSION" ]]; then
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" >&2
        echo "⚠️  Saved launch configuration is in another format" >&2
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" >&2
        echo "Saved format:  ${SAVED_CONFIG_VERSION:-none}" >&2
        echo "This ccy reads format ${CONFIG_VERSION}" >&2
        echo "" >&2
        echo "Reconfiguring with interactive prompts..." >&2
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" >&2
        echo "" >&2
        rm -f "$config_file"
        return 1
    fi

    # Every key of the format is present, even if empty: an empty one is a choice.
    local key
    for key in LAST_TOKEN LAST_SSH_KEYS LAST_NETWORK; do
        if [[ ! -v "$key" ]]; then
            echo "Saved launch configuration $config_file has no $key line; reconfiguring with interactive prompts..." >&2
            rm -f "$config_file"
            return 1
        fi
    done

    # Same version, different hash: the launcher changed without a version bump. Said for
    # the developer; the choices are still in this ccy's format, so they are kept.
    if [[ "${CCY_VERSION}" == "${SAVED_CCY_VERSION:-}" && "${CCY_HASH}" != "${SAVED_CCY_HASH:-}" ]]; then
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" >&2
        echo "⚠️  DEVELOPER ERROR: CCY script modified without version bump" >&2
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" >&2
        echo "Version:       ${CCY_VERSION} (unchanged)" >&2
        echo "Saved hash:    ${SAVED_CCY_HASH:-unknown}" >&2
        echo "Current hash:  ${CCY_HASH}" >&2
        echo "" >&2
        echo "The CCY script has been modified but CCY_VERSION was not updated." >&2
        echo "This is a developer error - version numbers must be incremented" >&2
        echo "when the script changes." >&2
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" >&2
        echo "" >&2
    fi
    return 0
}

# Function to save launch configuration for current project
save_launch_config() {
    local ccy_root="$1"
    local token_name="$2"
    local ssh_keys_str="$3"
    local network="$4"

    local config_file="$ccy_root/.last-launch.conf"

    cat > "$config_file" <<EOF
# CCY Launch Configuration
# Config Version: ${CONFIG_VERSION}
# CCY Version: ${CCY_VERSION}
# CCY Hash: ${CCY_HASH}
# Generated: $(date '+%Y-%m-%d %H:%M:%S')
SAVED_CONFIG_VERSION=${CONFIG_VERSION}
SAVED_CCY_VERSION="${CCY_VERSION}"
SAVED_CCY_HASH="${CCY_HASH}"
LAST_TOKEN="${token_name}"
LAST_SSH_KEYS="${ssh_keys_str}"
LAST_NETWORK="${network}"
LAST_LAUNCH_DATE="$(date '+%Y-%m-%d')"
EOF

    chmod 600 "$config_file"
}

