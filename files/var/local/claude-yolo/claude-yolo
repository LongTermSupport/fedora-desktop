OPT_UNTIL=""
# --teams: its list as given, and where the flag and its value sit in the arguments (1-based;
# the same position for --teams=<list>), so the canonical list can replace them.
NEXT_IS_TEAMS=false
TEAMS_GIVEN=false
TEAMS_LIST=""
TEAMS_FLAG_POS=0
TEAMS_VALUE_POS=0
CCY_ARG_POS=0
SAW_DOUBLE_DASH=false

# The arguments exactly as given, for a supervisor-requested relaunch (see the end of this
# script). The loop below only reads "$@", but a copy cannot be disturbed by a later `set --`.
CCY_ORIG_ARGS=("$@")

for arg in "$@"; do
    CCY_ARG_POS=$((CCY_ARG_POS + 1))
    if [ "$SAW_DOUBLE_DASH" = true ]; then
        # Everything after `--` is forwarded raw to claude without ccy parsing
        CLAUDE_ARGS+=("$arg")
    elif [ "$arg" = "--" ]; then
        # POSIX-style separator: end of ccy options, rest is for claude
        SAW_DOUBLE_DASH=true
    elif [ "$NEXT_IS_TEAMS" = true ]; then
        # An option where the list belongs means the list was left out (exit 64, usage).
        if [[ "$arg" == -* ]]; then
            print_error "--teams needs a list, <seat>@<team>[,<seat>@<team>...], before $arg"
            exit 64
        fi
        TEAMS_LIST="$arg"
        TEAMS_VALUE_POS=$CCY_ARG_POS
        NEXT_IS_TEAMS=false
    elif [ "$NEXT_IS_ENGINE" = true ]; then
        # Validate engine choice
        if [[ "$arg" != "docker" ]] && [[ "$arg" != "podman" ]]; then
            print_error "Invalid container engine: $arg"
            echo "Valid options: docker, podman" >&2
            exit 1
        fi
        # Check if engine is available
        if ! command -v "$arg" &>/dev/null; then
            print_error "Container engine '$arg' not found"
            echo "Please install $arg or use a different engine" >&2
            exit 1
        fi
        CONTAINER_ENGINE="$arg"
        export CONTAINER_ENGINE
        NEXT_IS_ENGINE=false
    elif [ "$NEXT_IS_SSH_KEY" = true ]; then
        if [ ! -f "$arg" ]; then
            print_error "SSH key not found: $arg"
            exit 1
        fi
        SSH_KEYS+=("$arg")
        NEXT_IS_SSH_KEY=false
    elif [ "$NEXT_IS_EXPORT_TOKEN" = true ]; then
        EXPORT_TOKEN_NAME="$arg"
        NEXT_IS_EXPORT_TOKEN=false
    elif [ "$NEXT_IS_UPDATE_TOKEN" = true ]; then
        UPDATE_TOKEN_NAME="$arg"
        NEXT_IS_UPDATE_TOKEN=false
    elif [ "$NEXT_IS_TOKEN" = true ]; then
        SPECIFIED_TOKEN="$arg"
        NEXT_IS_TOKEN=false
    elif [ "$NEXT_IS_CONNECT" = true ]; then
        CONNECT_NETWORK="$arg"
        NEXT_IS_CONNECT=false
    elif [ "$NEXT_IS_DISCONNECT" = true ]; then
        DISCONNECT_NETWORK="$arg"
        NEXT_IS_DISCONNECT=false
    elif [ "$NEXT_IS_NETWORK" = true ]; then
        SPECIFIED_NETWORK="$arg"
        NEXT_IS_NETWORK=false
    elif [ "$NEXT_IS_PROMPT" = true ]; then
        PROMPT_TEXT="$arg"
        NEXT_IS_PROMPT=false
    elif [ "$NEXT_IS_MAX_AGE" = true ]; then
        OPT_MAX_AGE="$arg"
        NEXT_IS_MAX_AGE=false
    elif [ "$NEXT_IS_RUN_FOR" = true ]; then
        OPT_RUN_FOR="$arg"
        NEXT_IS_RUN_FOR=false
    elif [ "$NEXT_IS_UNTIL" = true ]; then
        OPT_UNTIL="$arg"
        NEXT_IS_UNTIL=false
    elif [ "$arg" = "--max-age" ]; then
        NEXT_IS_MAX_AGE=true
    elif [ "$arg" = "--run-for" ]; then
        NEXT_IS_RUN_FOR=true
    elif [ "$arg" = "--until" ]; then
        NEXT_IS_UNTIL=true
    elif [ "$arg" = "--teams" ] || [[ "$arg" == "--teams="* ]]; then
        if [ "$TEAMS_GIVEN" = true ]; then
            print_error "--teams is given once, with every seat in it: --teams <seat>@<team>,<seat>@<team>"
            exit 64
        fi
        TEAMS_GIVEN=true
        TEAMS_FLAG_POS=$CCY_ARG_POS
        if [ "$arg" = "--teams" ]; then
            NEXT_IS_TEAMS=true
        else
            TEAMS_LIST="${arg#--teams=}"
            TEAMS_VALUE_POS=$CCY_ARG_POS
        fi
    elif [ "$arg" = "--rebuild" ]; then
        FORCE_REBUILD=true
        REBUILD_MODE="full"
    elif [[ "$arg" == "--rebuild="* ]]; then
        FORCE_REBUILD=true
        REBUILD_MODE="${arg#--rebuild=}"
        if [[ "$REBUILD_MODE" != "claude" && "$REBUILD_MODE" != "project" && "$REBUILD_MODE" != "full" ]]; then
            print_error "Invalid --rebuild mode: $REBUILD_MODE"
            echo "Valid modes: claude (default), project, full" >&2
            exit 1
        fi
    elif [ "$arg" = "--disable-custom-docker" ]; then
        DISABLE_CUSTOM_DOCKER=true
    elif [ "$arg" = "--no-ssh" ]; then
        NO_SSH_MODE=true
    elif [ "$arg" = "--ssh-agent" ]; then
        SSH_KEYS+=("$SSH_AGENT_SENTINEL")
    elif [ "$arg" = "--github-443" ]; then
        GITHUB_443_MODE=true
    elif [ "$arg" = "--no-network" ]; then
        NO_NETWORK_MODE=true
    elif [ "$arg" = "--headless" ]; then
        HEADLESS_MODE=true
    elif [ "$arg" = "--supervise" ]; then
        SUPERVISE_MODE=true
    elif [ "$arg" = "--no-supervise" ]; then
        NO_SUPERVISE_MODE=true
    elif [ "$arg" = "--no-restore" ]; then
        # The session registry's opt-out (lib/session-registry.bash): consumed by the tmux
        # insulation on the way into the session. It is only still here on the paths where
        # insulation does not apply, and it means nothing to this script — but left
        # unrecognised it would fall through to claude as an unknown option.
        :
    elif [ "$arg" = "--prompt" ]; then
        NEXT_IS_PROMPT=true
    elif [ "$arg" = "--debug" ]; then
        SHOW_DEBUG_CHOOSER=true
    elif [ "$arg" = "--engine" ]; then
        NEXT_IS_ENGINE=true
    elif [ "$arg" = "--ssh-key" ]; then
        NEXT_IS_SSH_KEY=true
    elif [ "$arg" = "--token" ]; then
        NEXT_IS_TOKEN=true
    elif [ "$arg" = "--create-token" ]; then
        CREATE_TOKEN_MODE=true
    elif [[ "$arg" == "--update-token="* ]]; then
        UPDATE_TOKEN_MODE=true
        UPDATE_TOKEN_NAME="${arg#--update-token=}"
        if [ -z "$UPDATE_TOKEN_NAME" ]; then
            print_error "--update-token requires a token name (e.g. --update-token=personal)"
            exit 1
        fi
    elif [ "$arg" = "--update-token" ]; then
        UPDATE_TOKEN_MODE=true
        NEXT_IS_UPDATE_TOKEN=true
    elif [ "$arg" = "--list-tokens" ]; then
        LIST_TOKENS_MODE=true
    elif [ "$arg" = "--export-token" ]; then
        EXPORT_TOKEN_MODE=true
        NEXT_IS_EXPORT_TOKEN=true
    elif [ "$arg" = "--network" ]; then
        NEXT_IS_NETWORK=true
    elif [ "$arg" = "--connect" ]; then
        CONNECT_MODE=true
        NEXT_IS_CONNECT=true
    elif [ "$arg" = "--disconnect" ]; then
        DISCONNECT_MODE=true
        NEXT_IS_DISCONNECT=true
    elif [ "$arg" = "--custom" ]; then
        CUSTOM_MODE=true
    elif [ "$arg" = "--custom-docker" ]; then
        CUSTOM_DOCKER_MODE=true
    elif [ "$arg" = "--top" ]; then
        TOP_MODE=true
    elif [ "$arg" = "--prevent" ]; then
        PREVENT_MODE=true
    else
        CLAUDE_ARGS+=("$arg")
    fi
done

# --teams <seat>@<team>[,...] (lib/agent-bus-seats.bash). Checked here, before any prompt,
# SSH or token work, by `agent-bus seat check`, which holds the seat and team grammar and
# prints the canonical list; its exit code is the launch's. The canonical list then replaces
# the one given in this launch's arguments, so tmux's session record (a restore) and a
# restart replay it. Without --teams nothing here runs and agent-bus is never called.
CCY_SEATS=""
if [ "$NEXT_IS_TEAMS" = true ] || { [ "$TEAMS_GIVEN" = true ] && [ -z "$TEAMS_LIST" ]; }; then
    print_error "--teams needs a list: --teams <seat>@<team>[,<seat>@<team>...]"
    exit 64
fi
if [ "$TEAMS_GIVEN" = true ]; then
    _ccy_teams_rc=0
    CCY_SEATS=$(ccy_seats_check "$TEAMS_LIST") || _ccy_teams_rc=$?
    if [ "$_ccy_teams_rc" -ne 0 ]; then
        # An unquoted `--teams a@x, b@y` reaches ccy as `a@x,` and a separate word.
        _ccy_teams_next="${*:$((TEAMS_VALUE_POS + 1)):1}"
        if [[ "$TEAMS_LIST" =~ ,[[:space:]]*$ ]] && [ -n "$_ccy_teams_next" ]; then
            echo "  The shell split the list at a space. Write it without the space, or quote it:" >&2
            echo "    --teams '${TEAMS_LIST} ${_ccy_teams_next}'" >&2
        fi
        exit "$_ccy_teams_rc"
    fi
    _ccy_teams_args=()
    mapfile -d '' -t _ccy_teams_args < <(ccy_teams_canonical_args "$TEAMS_FLAG_POS" "$TEAMS_VALUE_POS" "$CCY_SEATS" "$@")
    wait "$!" || exit 1
    set -- "${_ccy_teams_args[@]}"
    CCY_ORIG_ARGS=("$@")
    unset _ccy_teams_args _ccy_teams_rc _ccy_teams_next
fi

# Export the GitHub-443 toggle as the env var consumed BOTH by the host-side SSH
# probe in build_ssh_mounts_and_validate (ssh-handling.bash) and by the container
# entrypoint. Set here — after parsing, before the probe at build_ssh_mounts_and_validate.
#
# Precedence (highest first):
#   1. --github-443 flag           → force 443 on for this run
#   2. inherited GITHUB_SSH_443=1  → host-level enable (e.g. `export GITHUB_SSH_443=1; ccy`,
#                                    a profile.d export, or `eval "$(github-ssh-443 env)"`).
#                                    This is the host→container signal: enabling 443 on the
#                                    desktop makes ccy run in 443 mode automatically.
#   3. otherwise                   → 0, and the launch-time auto-fallback probe still applies.
# Without honouring the inherited value, a host export would be clobbered to 0 here.
if [ "$GITHUB_443_MODE" = true ] || [ "${GITHUB_SSH_443:-0}" = "1" ]; then
    export GITHUB_SSH_443=1
else
    export GITHUB_SSH_443=0
fi
# Snapshot the 443 state BEFORE the SSH probe so the post-validate banner can name
# the trigger: still 1 here means flag/env; flipped 0→1 by the probe means
# auto-fallback (port 22 firewall-blocked).
GITHUB_443_PRELAUNCH="$GITHUB_SSH_443"

# Session limits (lib/session-lifecycle.bash). Validated here, before any prompt, so a typo
# costs nothing; the deadline itself is worked out at launch. A value-taking option that ends
# the command line is a mistake, not a request for the default.
for _ccy_dangling in max-age:"$NEXT_IS_MAX_AGE" run-for:"$NEXT_IS_RUN_FOR" until:"$NEXT_IS_UNTIL"; do
    if [ "${_ccy_dangling#*:}" = true ]; then
        print_error "--${_ccy_dangling%%:*} needs a value (see ccy --help)"
        exit 1
    fi
done
unset _ccy_dangling
ccy_lifecycle_validate_options "$OPT_MAX_AGE" "$OPT_RUN_FOR" "$OPT_UNTIL" "$NO_SUPERVISE_MODE" || exit 1

# ─────────────────────────────────────────────────────────────────────────────
# Fail-fast flag validation
# ─────────────────────────────────────────────────────────────────────────────
# Anything `--<flag>`-shaped that fell through to CLAUDE_ARGS *before* a `--`
# separator is a candidate claude flag. Validate against `claude --help` from
# the base image so we error out *now*, before SSH/gh/token/container work.
# Args after `--` are forwarded raw and skipped.
# ─────────────────────────────────────────────────────────────────────────────
suspect_flags=()
for a in "${CLAUDE_ARGS[@]}"; do
    [[ "$a" == --* ]] || continue
    suspect_flags+=("${a%%=*}")
done

if [ ${#suspect_flags[@]} -gt 0 ]; then
    # Source `claude --help`. Prefer host binary (instant); fall back to running
    # claude inside the base image if the host doesn't have it. If neither is
    # available, skip validation (claude itself will reject bogus flags later).
    claude_help=""
    if command -v claude &>/dev/null; then
        claude_help=$(claude --help 2>&1) || claude_help=""
    fi
    if [ -z "$claude_help" ] && container_cmd image inspect "$IMAGE_NAME" &>/dev/null; then
        if ! claude_help=$(container_cmd run --rm --entrypoint claude "$IMAGE_NAME" --help 2>&1); then
            print_error "Could not run 'claude --help' in $IMAGE_NAME to validate flags"
            echo "$claude_help" >&2
            exit 1
        fi
    fi

    if [ -z "$claude_help" ]; then
        # No way to validate. Skip and let claude itself reject later.
        :
    else

        unknown=()
        for f in "${suspect_flags[@]}"; do
            if ! grep -qE -- "(^|[[:space:],])${f}([[:space:],=]|$)" <<< "$claude_help"; then
                unknown+=("$f")
            fi
        done

        if [ ${#unknown[@]} -gt 0 ]; then
            ccy_flags=(
                --rebuild --disable-custom-docker --no-ssh --github-443 --no-network
                --headless --supervise --no-supervise --no-restore --ssh-agent --prompt --debug --engine --ssh-key --token --create-token
                --max-age --run-for --until
                --teams
                --update-token --list-tokens --export-token --network --connect --disconnect
                --custom --custom-docker --top --prevent --help
            )
            claude_known=$(grep -oE -- '--[a-zA-Z][a-zA-Z0-9-]*' <<< "$claude_help" | sort -u)

            print_error "Unknown flag(s): ${unknown[*]}"
            echo "" >&2
            echo "Neither ccy nor claude recognises these flags." >&2
            echo "" >&2
            for u in "${unknown[@]}"; do
                stem="${u#--}"
                echo "  $u" >&2
                ccy_match=$(printf '%s\n' "${ccy_flags[@]}" | grep -i -- "$stem" | head -3 | tr '\n' ' ')
                [ -n "$ccy_match" ] && echo "    Did you mean (ccy)?    $ccy_match" >&2
                claude_match=$(grep -i -- "$stem" <<< "$claude_known" | head -3 | tr '\n' ' ')
                [ -n "$claude_match" ] && echo "    Did you mean (claude)? $claude_match" >&2
            done
            echo "" >&2
            echo "To forward unrecognised flags raw to claude, use a -- separator:" >&2
            echo "  ccy [ccy-options] -- ${unknown[*]}" >&2
            exit 1
        fi
    fi
fi

# Handle debug layer selection
if [ "$SHOW_DEBUG_CHOOSER" = true ]; then
    echo "════════════════════════════════════════════════════════════════════════════════"
    echo "Debug Layer Selection"
    echo "════════════════════════════════════════════════════════════════════════════════"
    echo ""
    echo "Select which layers to debug (enter numbers separated by commas):"
    echo ""
    echo "  1. CCY wrapper (bash -x in ccy script)"
    echo "  2. Container entrypoint (bash -x in entrypoint.sh)"
    echo "  3. Claude Code (--debug flag to claude)"
    echo ""
    echo "Examples:"
    echo "  3       - Only debug Claude Code"
    echo "  1,3     - Debug CCY wrapper and Claude Code"
    echo "  1,2,3   - Debug all layers"
    echo ""
    read -rp "Enter layer numbers (or press Enter for all): " layer_input

    # Default to all if empty
    if [ -z "$layer_input" ]; then
        layer_input="1,2,3"
    fi

    # Parse the CSV input
    IFS=',' read -ra LAYERS <<< "$layer_input"
    for layer in "${LAYERS[@]}"; do
        layer=$(echo "$layer" | xargs) # trim whitespace
        case "$layer" in
            1)
                DEBUG_CCY=true
                ;;
            2)
                DEBUG_ENTRYPOINT=true
                ;;
            3)
                DEBUG_CLAUDE=true
                ;;
            *)
                print_error "Invalid layer number: $layer"
                echo "Valid options are: 1, 2, 3" >&2
                exit 1
                ;;
        esac
    done

    # Show what will be debugged
    echo ""
    echo "Debug configuration:"
    [ "$DEBUG_CCY" = true ] && echo "  ✓ CCY wrapper (bash -x)"
    [ "$DEBUG_ENTRYPOINT" = true ] && echo "  ✓ Container entrypoint (bash -x)"
    [ "$DEBUG_CLAUDE" = true ] && echo "  ✓ Claude Code (--debug)"
    echo ""

    # Confirm
    read -rp "Continue with this configuration? [Y/n]: " confirm
    if [[ "$confirm" =~ ^[Nn] ]]; then
        echo "Aborted."
        exit 0
    fi

    # Only enable DEBUG_MODE and logging for CCY layer
    # Other layers (entrypoint, Claude) don't need log files
    if [ "$DEBUG_CCY" = true ]; then
        DEBUG_MODE=true
        DEBUG_LOG="/tmp/ccy-debug-$(date +%Y%m%d-%H%M%S).log"
        echo ""
        echo "Debug logging to: $DEBUG_LOG"
        echo ""
        # Redirect all output to both terminal and log file
        exec > >(tee -a "$DEBUG_LOG") 2>&1
        set -x
    fi
fi

# Ensure directory structure exists early
mkdir -p "$CCY_ROOT"
chmod 700 "$CCY_ROOT"
mkdir -p "$TOKEN_DIR"
chmod 700 "$TOKEN_DIR"
mkdir -p "$PROJECT_DIR"
chmod 700 "$PROJECT_DIR"

# Validate --headless requires --prompt
if [ "$HEADLESS_MODE" = true ]; then
    if [ -z "$PROMPT_TEXT" ]; then
        print_error "--headless flag requires --prompt with content"
        echo "" >&2
        echo "Usage:" >&2
        echo "  ccy --headless --prompt \"your prompt here\"" >&2
        echo "" >&2
        echo "The --headless flag runs Claude Code in non-interactive mode," >&2
        echo "which requires a prompt to execute." >&2
        exit 1
    fi
fi

# Handle --top mode (global container management: lists and can stop every ccy container)
if [ "$TOP_MODE" = true ]; then
    show_container_top "yolo"
    exit 0
fi

# Handle prevent mode: disable CCY for this project folder
if [ "$PREVENT_MODE" = true ]; then
    allowed_file=".claude/ccy/allowed-hostnames"
    mkdir -p ".claude/ccy"
    if grep -qx "never" "$allowed_file" 2>/dev/null; then
        echo "CCY is already disabled for this project ($allowed_file already contains 'never')."
    else
        echo "never" >> "$allowed_file"
        echo "✓ CCY disabled for this project."
        echo "  Written 'never' to $allowed_file"
        echo ""
        echo "To re-enable CCY, remove or edit that file:"
        echo "  rm $allowed_file"
    fi
    exit 0
fi

# Handle list tokens mode (doesn't need SSH/GH setup)
if [ "$LIST_TOKENS_MODE" = true ]; then
    list_tokens "$TOKEN_DIR" "ccy"
    exit 0
fi

# Handle export token mode (doesn't need SSH/GH setup)
if [ "$EXPORT_TOKEN_MODE" = true ]; then
    if [ -z "$EXPORT_TOKEN_NAME" ]; then
        # Interactive multi-select
        export_tokens_interactive "$TOKEN_DIR"
        exit $?
    fi
    export_token "$TOKEN_DIR" "$EXPORT_TOKEN_NAME"
    exit $?
fi

# Handle connect and disconnect modes (neither needs SSH/GH setup). Both at once would
# attach and detach in one breath, so it is refused rather than one silently winning.
if [ "$CONNECT_MODE" = true ] && [ "$DISCONNECT_MODE" = true ]; then
    print_error "--connect and --disconnect cannot be used together"
    exit 1
fi
if [ "$DISCONNECT_MODE" = true ]; then
    disconnect_from_network "$DISCONNECT_NETWORK" "_yolo" "ccy"
    exit $?
fi
if [ "$CONNECT_MODE" = true ]; then
    connect_to_network "$CONNECT_NETWORK" "_yolo" "ccy"
    exit $?
fi

# Handle custom mode (doesn't need SSH/GH setup)
if [ "$CUSTOM_MODE" = true ]; then
    custom_dockerfile "$0" ".claude/ccy" "ccy"
    exit 0
fi

# Handle custom-docker mode (AI-guided Dockerfile creation)
if [ "$CUSTOM_DOCKER_MODE" = true ]; then
    create_dockerfile_guided "$0" ".claude/ccy" "ccy"
    exit 0
fi

# Terminal-death insulation (lib/tmux-session.bash). Every mode that exits without a
# session and without prompting has returned above; the first prompt (Quick Launch, then
# SSH key selection) comes next. Re-executing the launcher inside tmux HERE means every
# prompt, and the pty itself, happen where a dying terminal cannot reach them — and
# nothing is asked twice. Excluded: headless (no terminal to lose) and the token
# create/renew modes, which prompt but exit without a session. On the way back in (TMUX
# set to the ccy server) ccy_tmux_insulate is a no-op and the banner says how to detach
# and return.
if [ "$HEADLESS_MODE" != true ] && [ "$CREATE_TOKEN_MODE" != true ] && [ "$UPDATE_TOKEN_MODE" != true ]; then
    ccy_tmux_insulate "$PROJECT_NAME" "$SCRIPT_DIR/$(basename "$0")" "$@" || exit 1
    ccy_tmux_banner || exit 1
fi

# Is this launch a session restore (ccy-sessions restore, after a reboot)? The restore sets
# CCY_SESSION_RESTORE=1 on the pane's command and nothing else sets it. Read once and
# removed from the environment, so nothing this launch starts inherits it and a ccy run by
# hand later from inside the session is an ordinary launch. It changes only the prompts
# that have one safe answer; see "Sessions Survive a Reboot" in docs/ccy.md.
SESSION_RESTORE=false
case "${CCY_SESSION_RESTORE:-}" in
"") ;;
1) SESSION_RESTORE=true ;;
*)
    print_error "CCY_SESSION_RESTORE is '${CCY_SESSION_RESTORE}'; only ccy-sessions restore sets it, and only to 1."
    exit 1
    ;;
esac
unset CCY_SESSION_RESTORE
# A restore and a restart both run with nobody at the keyboard, so the prompts that have one
# safe answer (the passphrase file, zombie and sibling containers) take it for either.
CCY_UNATTENDED_LAUNCH="$SESSION_RESTORE"
if [ -n "$CCY_RESTART_RELAUNCH_SESSION" ]; then
    CCY_UNATTENDED_LAUNCH=true
fi
# On a headless server the restore also names the SSH key passphrase file, so the key
# unlocks through askpass with nobody at the keyboard; a restart of such a session hands the
# same file on. Refused on any other launch.
ccy_restore_passphrase_take "$CCY_UNATTENDED_LAUNCH" || exit 1

# Try to load previous launch configuration (if no flags specified).
#
# There is no CONFIG_LOADED flag: it was set in three places and read in none.
# Accepting the quick-launch config takes effect by populating SPECIFIED_TOKEN /
# SSH_KEYS / SPECIFIED_NETWORK below, and declining takes effect by leaving them
# empty so the interactive prompts run. The flag tracked that state a second
# time without anything consulting it. A restart never gets here: its arguments
# always carry --token, and --no-ssh or the keys.
if [[ "$NO_SSH_MODE" = false ]] && [[ ${#SSH_KEYS[@]} -eq 0 ]] && \
   [[ -z "$SPECIFIED_TOKEN" ]] && [[ -z "$SPECIFIED_NETWORK" ]] && \
   [[ "$NO_NETWORK_MODE" = false ]]; then
    # No flags provided - try to load config. All of it is status and prompt, so stderr: a
    # headless session's stdout is its output (CLAUDE/StderrHygiene.md).
    {
    if load_launch_config ".claude/ccy"; then
        echo ""
        echo "════════════════════════════════════════════════════════════════════════════════"
        echo "Quick Launch Available"
        echo "════════════════════════════════════════════════════════════════════════════════"
        echo ""
        echo "Found previous launch configuration (${LAST_LAUNCH_DATE:-unknown}):"
        last_token_label=""
        if [ -n "${LAST_TOKEN:-}" ]; then
            # The same lookup --token NAME makes: the first file with that name.
            last_token_files=("$TOKEN_DIR/${LAST_TOKEN}".*.token)
            if [ -f "${last_token_files[0]}" ]; then
                last_token_label="$(token_expiry_label "${last_token_files[0]}")"
            else
                last_token_label=" (no token file with this name)"
            fi
        fi
        echo "  Token:   ${LAST_TOKEN:-none}${last_token_label}"
        echo "  SSH Key: ${LAST_SSH_KEYS:-none}"
        echo "  Network: ${LAST_NETWORK:-none}"
        echo ""

        while true; do
            # A restore takes the saved configuration without asking: it is the one the
            # person last chose in this project, and the only evidence of what they want.
            # So does a headless launch, whose stdin is the session's own input.
            if [ "$SESSION_RESTORE" = true ]; then
                echo "Session restore: using the previous configuration."
                use_config=Y
            elif [ "$HEADLESS_MODE" = true ]; then
                echo "Headless launch: using the previous configuration."
                use_config=Y
            else
                read -rp "$CCY_PROMPT_QUICK_LAUNCH " use_config
                use_config=${use_config:-Y}
            fi
            echo ""

            case "$use_config" in
                Y|y|Yes|yes)
                    echo "Quick launching with previous configuration..."
                    echo ""

                    # Load config values
                    if [[ -n "$LAST_TOKEN" ]]; then
                        SPECIFIED_TOKEN="$LAST_TOKEN"
                    fi
                    if [[ -n "$LAST_SSH_KEYS" ]]; then
                        IFS=' ' read -ra SSH_KEYS <<< "$LAST_SSH_KEYS"
                    fi
                    if [[ -n "$LAST_NETWORK" ]]; then
                        SPECIFIED_NETWORK="$LAST_NETWORK"
                        NETWORK_FROM_CONFIG=true
                    fi
                    # Headless, an empty saved choice is that choice (no key, no network),
                    # never the picker it would otherwise fall through to; a saved launch
                    # with no token cannot be replayed.
                    if [ "$HEADLESS_MODE" = true ]; then
                        if [[ -z "$LAST_TOKEN" ]]; then
                            print_error "Headless launch: the saved Quick Launch choices name no token, and a headless launch never asks for one."
                            echo "  Launch with --token NAME (and --ssh-key, --ssh-agent or --no-ssh)." >&2
                            exit 1
                        fi
                        [[ -n "$LAST_SSH_KEYS" ]] || NO_SSH_MODE=true
                        [[ -n "$LAST_NETWORK" ]] || NO_NETWORK_MODE=true
                    fi
                    break
                    ;;
                N|n|No|no)
                    # Declining simply leaves SPECIFIED_* unset, so the normal
                    # interactive prompts run below.
                    echo "Reconfiguring with interactive prompts..."
                    echo ""
                    break
                    ;;
                *)
                    echo "Invalid choice. Please enter Y or n"
                    echo ""
                    ;;
            esac
        done

        echo "════════════════════════════════════════════════════════════════════════════════"
        echo ""
    elif [ "$HEADLESS_MODE" = true ]; then
        # Every choice below would be a prompt, read from the session's own input.
        print_error "Headless launch with no launch choices: this checkout has no saved Quick Launch choices this ccy can read, and a headless launch never asks."
        echo "  Launch ccy once here interactively, or give the choices: --token NAME and --ssh-key PATH, --ssh-agent or --no-ssh (and --network NAME or --no-network)." >&2
        exit 1
    fi
    } >&2
fi

# A headless launch never unlocks an SSH key: ssh-add's passphrase prompt would read the
# session's own input, or wait for ever. A key that needs one refuses it here, before the
# container starts (a server restore's passphrase file still counts).
if [ "$HEADLESS_MODE" = true ] \
    && ! ccy_restart_keys_unattended "$RESTORE_SSH_PASSPHRASE_FILE" "${SSH_KEYS[@]}"; then
    print_error "Headless launch: an SSH key needs a passphrase (see above), and a headless launch never asks for one."
    echo "  Load it into your ssh-agent first (ssh-add <key>): ccy then forwards that one key from the agent. Or use a key with no passphrase, or --no-ssh." >&2
    exit 1
fi

# Discover and select SSH keys (sets SSH_KEYS array)
# Only prompt for selection if no SSH keys specified and not in no-ssh mode
if [ "$NO_SSH_MODE" = false ] && [ ${#SSH_KEYS[@]} -eq 0 ]; then
    # Non-zero only when the remote names a GitHub alias whose key is missing:
    # a provisioning fault this box cannot work around, so it stops here.
    discover_and_select_ssh_keys "ccy" || exit 1
    # A key chosen here is in no argument, so a restore of this session after a reboot
    # would stop at the same menu with nobody to answer it. Its record takes the key file
    # (lib/session-registry.bash). A forwarded agent, or no key, cannot be replayed: such a
    # restore still stops at the menu, and verify-restore reports it there. A session with
    # no launch flags is left to Quick Launch, whose saved settings survive a CCY_VERSION
    # change while their format (CONFIG_VERSION) is unchanged (load_launch_config).
    if [ ${#SSH_KEYS[@]} -eq 1 ] && [ "${SSH_KEYS[0]}" != "$SSH_AGENT_SENTINEL" ]; then
        ccy_session_name=$(ccy_tmux_current_session) || exit 1
        if [ -n "$ccy_session_name" ]; then
            ccy_registry_record_ssh_key "$ccy_session_name" "${SSH_KEYS[0]}" || exit 1
        fi
    fi
fi

# Will SELinux confine this container's reads of what we bind? Decided once, from
# getenforce and the engine's own report; every mount below reads the answer.
ccy_selinux_mode

# Until cleanup's trap replaces it below: a launcher killed during the probe (a reboot's
# SIGTERM, a SIGHUP; bash runs the EXIT trap for both) must not leave the probe agent holding
# unlocked keys, nor a restore's passphrase copy on XDG_RUNTIME_DIR. The probe's own RETURN
# trap covers only a normal return.
trap '_probe_agent_stop; ccy_askpass_passphrase_discard; ccy_agent_filter_stop' EXIT

# Selected key files that need a passphrase, which the session's ssh-agent holds: those keys
# are forwarded from the agent through ccy's one-key agent, and their files are neither
# unlocked nor mounted (ccy_agent_forward_select, lib/ssh-handling.bash). SSH_KEYS still
# names the files.
ccy_agent_filter_start || exit 1

# One selected key file, and an SSH_ASKPASS helper that can answer for it: no prompt, here or
# in the container (lib/ssh-handling.bash).
ccy_askpass_passphrase_supply || exit 1

# A restart cannot type a key's passphrase, here or at the container's own ssh-add. The
# launcher that asked for the restart checked this before spending the budget on it; checked
# again because this is where the prompt would be.
if [ -n "$CCY_RESTART_RELAUNCH_SESSION" ] \
    && ! ccy_restart_keys_unattended "$RESTORE_SSH_PASSPHRASE_FILE" "${SSH_KEYS[@]}"; then
    ccy_restart_refuse "$CCY_RESTART_RELAUNCH_SESSION" "an SSH key needs a passphrase (see above)."
    exit 1
fi

# Build SSH mounts and validate GitHub access
# This sets: SSH_MOUNTS, SSH_KEY_PATHS, GITHUB_USERNAME, GH_TOKEN
build_ssh_mounts_and_validate "ccy" || exit 1

# A forwarded agent runs the container with SELinux labelling disabled, so it is
# unconfined: nothing it reads needs a relabel, and none is asked for.
if [ "${SSH_AGENT_FORWARDED:-0}" = "1" ]; then
    CCY_MOUNT_RELABEL=""
fi

if [ -n "$CCY_MOUNT_RELABEL" ]; then
    echo ""
    echo "🔒 SELinux ${CCY_SELINUX_MODE}: the workspace is mounted with a shared relabel (:z) and"
    echo "   key files are staged into a private tmpfs directory (:Z) so the container can read"
    echo "   them. Extra project mounts and display sockets are NOT relabelled: Enforcing blocks"
    echo "   them, Permissive logs every access — see docs/ccy.md."
fi

# Banner: make 443 mode impossible to miss. Fires whenever GitHub SSH ends up
# routed over ssh.github.com:443 — whether forced (--github-443), inherited from
# the host (GITHUB_SSH_443=1), or auto-detected when port 22 is firewall-blocked.
if [ "${GITHUB_SSH_443:-0}" = "1" ]; then
    if [ "$GITHUB_443_MODE" = true ]; then
        github_443_trigger="--github-443 flag"
    elif [ "$GITHUB_443_PRELAUNCH" = "1" ]; then
        github_443_trigger="GITHUB_SSH_443 env (host-level enable)"
    else
        github_443_trigger="auto-detected (port 22 blocked, 443 reachable)"
    fi
    echo ""
    echo -e "${COLOR_YELLOW}════════════════════════════════════════════════════════════════════════════════${COLOR_RESET}"
    echo -e "${COLOR_YELLOW}${COLOR_BOLD}  🔒 GitHub SSH-over-443 MODE ACTIVE${COLOR_RESET}"
    echo -e "${COLOR_YELLOW}════════════════════════════════════════════════════════════════════════════════${COLOR_RESET}"
    echo "  GitHub SSH is routed over ssh.github.com:443 (port-22 firewall bypass)."
    echo "  Same host keys, same identity — only the endpoint changes."
    echo -e "  Trigger: ${COLOR_BOLD}${github_443_trigger}${COLOR_RESET}"
    echo "  Scope:   this ccy session (host + container git over 443)."
    echo -e "${COLOR_YELLOW}════════════════════════════════════════════════════════════════════════════════${COLOR_RESET}"
    echo ""
fi

# Banner: a forwarded agent widens what the container can push as, and costs
# the container its SELinux confinement. Neither should pass unnoticed.
if [ "${SSH_AGENT_FORWARDED:-0}" = "1" ]; then
    echo ""
    echo -e "${COLOR_YELLOW}════════════════════════════════════════════════════════════════════════════════${COLOR_RESET}"
    if [ ${#CCY_AGENT_FILTER_KEYS[@]} -gt 0 ]; then
        ccy_filter_names=""
        for ccy_filter_key in "${CCY_AGENT_FILTER_KEYS[@]}"; do
            ccy_filter_names+="${ccy_filter_names:+, }$(basename "$ccy_filter_key")"
        done
        echo -e "${COLOR_YELLOW}${COLOR_BOLD}  🔑 SELECTED SSH KEYS FORWARDED FROM YOUR SSH-AGENT${COLOR_RESET}"
        echo -e "${COLOR_YELLOW}════════════════════════════════════════════════════════════════════════════════${COLOR_RESET}"
        echo "  Only $ccy_filter_names, through ccy's one-key agent: the container lists"
        echo "  and signs with those keys, as ${GITHUB_USERNAME:-its identity}, and cannot reach,"
        echo "  add, remove or lock any other key in your agent."
    else
        echo -e "${COLOR_YELLOW}${COLOR_BOLD}  🔑 SSH-AGENT FORWARDED INTO THE CONTAINER${COLOR_RESET}"
        echo -e "${COLOR_YELLOW}════════════════════════════════════════════════════════════════════════════════${COLOR_RESET}"
        echo "  The session's agent ($SSH_AUTH_SOCK) is mounted; git inside signs with"
        echo "  every key it holds, as ${GITHUB_USERNAME:-its identity}."
    fi
    echo "  SELinux labelling is DISABLED for this container (--security-opt label=disable):"
    echo "  it is the only way container_t can connect to an unconfined agent's socket."
    echo "  The mount namespace still limits the container to what is mounted."
    echo -e "${COLOR_YELLOW}════════════════════════════════════════════════════════════════════════════════${COLOR_RESET}"
    echo ""
fi

# Handle create token mode (requires SSH/GH setup for container functionality)
if [ "$CREATE_TOKEN_MODE" = true ]; then
    create_token "$TOKEN_DIR" "$GH_TOKEN" "$IMAGE_NAME" "ccy"
    exit $?
fi

# Handle update token mode (renew an existing named token before/after invalidation)
if [ "$UPDATE_TOKEN_MODE" = true ]; then
    if [ -z "$UPDATE_TOKEN_NAME" ]; then
        print_error "--update-token requires a token name (e.g. --update-token=personal)"
        exit 1
    fi
    create_token "$TOKEN_DIR" "$GH_TOKEN" "$IMAGE_NAME" "ccy" "$UPDATE_TOKEN_NAME"
    exit $?
fi

# After an interactive token create/renew, exit the right way. create_token
# (token-management.bash) sets CREATED_TOKEN_FILE on success and leaves it empty
# when the user cancelled, so a successful creation no longer prints a
# misleading "Cancelled" or crashes the caller on an empty token path (BSH-05).
post_create_token_exit() {
    if [ -n "${CREATED_TOKEN_FILE:-}" ]; then
        echo "✓ Token created. Re-run 'ccy' to launch with it."
        exit 0
    fi
    echo "Cancelled. Create a token with: ccy --create-token"
    exit 1
}

# Token selection logic
SELECTED_TOKEN=""
CLAUDE_OAUTH_TOKEN=""

if [ -n "$SPECIFIED_TOKEN" ]; then
    # Token specified via --token flag
    if [[ "$SPECIFIED_TOKEN" =~ / ]]; then
        # Full path provided
        SELECTED_TOKEN="$SPECIFIED_TOKEN"
    else
        # Token name provided, find matching token with any expiry date
        matching_tokens=("$TOKEN_DIR/${SPECIFIED_TOKEN}".*.token)
        if [ -f "${matching_tokens[0]}" ]; then
            SELECTED_TOKEN="${matching_tokens[0]}"
        else
            print_error "No token found with name: $SPECIFIED_TOKEN"
            echo ""
            echo "Available tokens:"
            list_tokens "$TOKEN_DIR" "ccy"
            exit 1
        fi
    fi

    if [ ! -f "$SELECTED_TOKEN" ]; then
        print_error "Token file not found: $SELECTED_TOKEN"
        echo ""
        echo "Available tokens:"
        list_tokens "$TOKEN_DIR" "ccy"
        exit 1
    fi

    # Check if token is expired or expiring today
    if ! is_token_valid "$SELECTED_TOKEN"; then
        filename=$(basename "$SELECTED_TOKEN")
        token_name="${filename%.*.token}"
        # Making a token needs a person at a browser, so a restart stops here.
        if [ -n "$CCY_RESTART_RELAUNCH_SESSION" ]; then
            ccy_restart_refuse "$CCY_RESTART_RELAUNCH_SESSION" \
                "token $filename has expired or expires today. Renew it with: ccy --update-token=$token_name"
            exit 1
        fi
        echo ""
        echo "════════════════════════════════════════════════════════════════════════════════"
        echo "⚠  TOKEN EXPIRED OR EXPIRING TODAY"
        echo "════════════════════════════════════════════════════════════════════════════════"
        echo ""
        echo "Token: $filename"
        echo ""
        echo "This token cannot be used. You must create a new token."
        echo ""
        read -rp "$CCY_PROMPT_TOKEN_EXPIRED " create_now
        if [ "$create_now" != "n" ] && [ "$create_now" != "N" ]; then
            create_token "$TOKEN_DIR" "$GH_TOKEN" "$IMAGE_NAME" "ccy" "$token_name"
            post_create_token_exit
        fi
        echo "Cancelled. Create a token with: ccy --create-token"
        exit 1
    fi

    filename=$(basename "$SELECTED_TOKEN")
    token_name="${filename%.*.token}"
    echo "✓ Using token: $token_name$(token_expiry_label "$SELECTED_TOKEN")"
else
    # No token specified, check if tokens exist.
    # A glob, not `ls`: the glob's no-match is a fact about the directory, where
    # `ls` folded "no tokens" and "could not read the directory" into one empty
    # string and then told the user, confidently, that they had no tokens.
    EXISTING_TOKENS=()
    if [ -d "$TOKEN_DIR" ]; then
        for _token_candidate in "$TOKEN_DIR"/*.token; do
            [ -e "$_token_candidate" ] && EXISTING_TOKENS+=("$_token_candidate")
        done
    fi
    if [ ${#EXISTING_TOKENS[@]} -eq 0 ]; then
        echo ""
        echo "════════════════════════════════════════════════════════════════════════════════"
        echo "No Claude Code Tokens Found"
        echo "════════════════════════════════════════════════════════════════════════════════"
        echo ""
        echo "ccy uses long-lived OAuth tokens for container authentication."
        echo ""
        echo "You need to create a token before using ccy."
        echo ""
        read -rp "$CCY_PROMPT_TOKEN_NONE " create_now

        if [ "$create_now" = "n" ] || [ "$create_now" = "N" ]; then
            echo "Cancelled. Create a token later with: ccy --create-token"
            exit 0
        fi

        # Jump directly to token creation
        create_token "$TOKEN_DIR" "$GH_TOKEN" "$IMAGE_NAME" "ccy"
        post_create_token_exit
    else
        # Multiple tokens exist or single token - show selection
        select_token "$TOKEN_DIR" "container" || {
            echo ""
            echo "════════════════════════════════════════════════════════════════════════════════"
            echo "No Valid Tokens Available"
            echo "════════════════════════════════════════════════════════════════════════════════"
            echo ""
            echo "All tokens are expired or expiring today."
            echo "You must create a new token."
            echo ""
            read -rp "$CCY_PROMPT_TOKEN_NONE " create_now
            if [ "$create_now" != "n" ] && [ "$create_now" != "N" ]; then
                create_token "$TOKEN_DIR" "$GH_TOKEN" "$IMAGE_NAME" "ccy"
                post_create_token_exit
            fi
            echo "Cancelled. Create a token with: ccy --create-token"
            exit 1
        }
    fi
fi

# BSH-05: select_token's create/renew path returns success with SELECTED_TOKEN
# set to the freshly created token (CREATED_TOKEN_FILE) — or empty if the user
# cancelled the create. Empty here means there is nothing to launch with, so
# exit with guidance rather than crashing on `cat ""`.
if [ -z "$SELECTED_TOKEN" ]; then
    post_create_token_exit
fi

# Load token content (it's just the token string)
CLAUDE_OAUTH_TOKEN=$(cat "$SELECTED_TOKEN")
if [ -z "$CLAUDE_OAUTH_TOKEN" ]; then
    print_error "Token file is empty: $SELECTED_TOKEN"
    exit 1
fi

if ! [[ "$CLAUDE_OAUTH_TOKEN" =~ ^sk-ant-oat01- ]]; then
    print_error "Invalid token format in file: $SELECTED_TOKEN"
    echo "Token must start with 'sk-ant-oat01-'"
    exit 1
fi

# Quick validation: Check token byte length (valid tokens are ~90-120 bytes)
# This catches truncated/corrupted tokens before expensive API call
TOKEN_BYTES=${#CLAUDE_OAUTH_TOKEN}
TOKEN_VALIDATION_FAILED=false
VALIDATION_FAILURE_REASON=""

if [ "$TOKEN_BYTES" -lt 90 ] || [ "$TOKEN_BYTES" -gt 120 ]; then
    TOKEN_VALIDATION_FAILED=true
    VALIDATION_FAILURE_REASON="length"
else
    # Validate token against Claude API (sanity check for corruption)
    echo "Validating token..."
    if ! validate_token "$CLAUDE_OAUTH_TOKEN" "$IMAGE_NAME"; then
        TOKEN_VALIDATION_FAILED=true
        VALIDATION_FAILURE_REASON="api"
    else
        echo "✓ Token validated successfully"
    fi
fi

# Handle token validation failure with unified recovery UI
if [ "$TOKEN_VALIDATION_FAILED" = true ]; then
    filename=$(basename "$SELECTED_TOKEN")
    token_name="${filename%.*.token}"

    # Every recovery below is a person's choice, and switching a restarted session to another
    # account unasked would be worse than stopping.
    if [ -n "$CCY_RESTART_RELAUNCH_SESSION" ]; then
        ccy_restart_refuse "$CCY_RESTART_RELAUNCH_SESSION" \
            "token $filename failed validation ($VALIDATION_FAILURE_REASON). Check it with: ccy --list-tokens"
        exit 1
    fi

    echo ""
    echo "════════════════════════════════════════════════════════════════════════════════"
    echo "❌ TOKEN VALIDATION FAILED"
    echo "════════════════════════════════════════════════════════════════════════════════"
    echo ""
    echo "Token: $filename"
    echo "File: $SELECTED_TOKEN"

    if [ "$VALIDATION_FAILURE_REASON" = "length" ]; then
        echo "Length: $TOKEN_BYTES bytes (expected: 90-120 bytes)"
        echo ""
        echo "This token appears corrupted (truncated or has extra characters)."
    else
        echo ""
        echo "The token has valid format, but does not authenticate with Claude API."
    fi

    echo ""
    echo "Common causes:"
    echo "  • Token file corrupted (truncated, extra characters, etc.)"
    echo "  • Token was manually edited incorrectly"
    echo "  • Token was revoked on Claude's side"
    echo "  • File was damaged (filesystem issue, interrupted write, etc.)"
    echo ""
    echo "════════════════════════════════════════════════════════════════════════════════"
    echo ""
    echo "Recovery options:"
    echo ""
    echo "  1) Recreate token (same name: '$token_name')"
    echo "  2) Select different token"
    echo "  3) Exit and fix manually"
    echo ""

    while true; do
        read -rp "$CCY_PROMPT_TOKEN_RECOVERY " recovery_choice
        echo ""

        case "$recovery_choice" in
            1)
                echo "Recreating token: $token_name"
                echo ""
                create_token "$TOKEN_DIR" "$GH_TOKEN" "$IMAGE_NAME" "ccy" "$token_name"
                post_create_token_exit
                ;;
            2)
                echo "Select a different token:"
                echo ""
                select_token "$TOKEN_DIR" "container" || {
                    echo ""
                    echo "No other valid tokens available."
                    echo ""
                    read -rp "$CCY_PROMPT_TOKEN_REPLACE " create_now
                    if [ "$create_now" != "n" ] && [ "$create_now" != "N" ]; then
                        create_token "$TOKEN_DIR" "$GH_TOKEN" "$IMAGE_NAME" "ccy"
                        post_create_token_exit
                    fi
                    echo "Cancelled. Create a token with: ccy --create-token"
                    exit 1
                }
                # BSH-05: a create/renew inside select_token may leave
                # SELECTED_TOKEN empty (cancelled) — don't cat "".
                if [ -z "$SELECTED_TOKEN" ]; then
                    post_create_token_exit
                fi
                # Token selected via select_token, reload and validate
                CLAUDE_OAUTH_TOKEN=$(cat "$SELECTED_TOKEN")

                # Validate the new token (both length and API)
                TOKEN_BYTES=${#CLAUDE_OAUTH_TOKEN}
                if [ "$TOKEN_BYTES" -lt 90 ] || [ "$TOKEN_BYTES" -gt 120 ]; then
                    print_error "Selected token also has invalid length ($TOKEN_BYTES bytes)"
                    echo "Please check your tokens or create a new one with: ccy --create-token"
                    exit 1
                fi

                if ! validate_token "$CLAUDE_OAUTH_TOKEN" "$IMAGE_NAME"; then
                    print_error "Selected token also failed validation"
                    echo "Please check your tokens or create a new one with: ccy --create-token"
                    exit 1
                fi

                echo "✓ Selected token validated successfully"
                echo ""
                break
                ;;
            3)
                echo "Cancelled."
                echo ""
                echo "To fix manually:"
                echo "  • Delete corrupted token: rm \"$SELECTED_TOKEN\""
                echo "  • Create new token: ccy --create-token"
                echo "  • Or view all tokens: ccy --list-tokens"
                exit 1
                ;;
            *)
                echo "Invalid choice. Please enter 1, 2, or 3"
                echo ""
                ;;
        esac
    done
fi
echo ""

# Current user's UID, for the never-run-as-root check below. There is no
# HOST_GID: it was captured under a comment about "proper file ownership" and
# then never used by anything — the container's ownership mapping does not read
# it. Removed rather than left as a hint at a mechanism that does not exist.
HOST_UID=$(id -u)

# Safety check: Never run as root (UID 0)
if [ "$HOST_UID" -eq 0 ]; then
    print_error "Cannot run Claude Code YOLO mode as root user (UID 0)"
    echo "This is a security restriction for --dangerously-skip-permissions mode"
    echo "Please run this command as a regular user, not with sudo or as root"
    exit 1
fi

# Safety check: the ENGINE must report itself rootless (Plan 00072).
#
# The uid-0 check above constrains this CLIENT. It cannot say what the engine is —
# a non-root user can still drive a rootful engine through CONTAINER_HOST /
# DOCKER_HOST pointing at a system socket, or a docker context. So ask the engine.
#
# This replaces two things that only looked like checks:
#   - a docker branch comparing the CONTEXT NAME to the string "rootless", which a
#     context can be named regardless of what it points at, and which DOCKER_HOST
#     overrides entirely;
#   - the comment "Podman running as non-root is inherently rootless - no check
#     needed", which is an inference standing in for a check.
#
# engine_assert_rootless prints its own diagnosis and returns non-zero; unknown is
# a refusal, not a pass. See lib/common-pure.bash for why.
if ! engine_assert_rootless; then
    exit 1
fi

# ═══════════════════════════════════════════════════════════════════════════
# STALE & ZOMBIE CONTAINER CLEANUP
# ═══════════════════════════════════════════════════════════════════════════

# Clean up containers left over from unclean shutdowns (battery death, crash)
# These are stopped/dead containers where --rm never fired — auto-removed
clean_stale_containers_startup "yolo"

# The container menus below have one safe answer when nobody can answer them: a restore, a
# restart, or a headless launch, whose stdin is the session's own input. Under --teams the
# other seats' headless containers are exactly what those menus would list.
CCY_NO_CONTAINER_PROMPTS="$CCY_UNATTENDED_LAUNCH"
if [ "$HEADLESS_MODE" = true ]; then
    CCY_NO_CONTAINER_PROMPTS=true
fi

# A menu answered q (1) is the person's choice to stop; one that got no answer (2) is a failure.
ccy_container_menu_exit() {
    local rc="$1"
    [ "$rc" -eq 0 ] && return 0
    [ "$rc" -eq 1 ] && exit 0
    exit 1
}

# Check for zombie containers (running but with no controlling terminal). Unattended, a
# restore's answer: leave them, since none can be proved dead.
container_menu_rc=0
check_zombie_containers_startup "yolo" "$CCY_NO_CONTAINER_PROMPTS" || container_menu_rc=$?
ccy_container_menu_exit "$container_menu_rc"

# ═══════════════════════════════════════════════════════════════════════════
# EXISTING CONTAINER CHECK
# ═══════════════════════════════════════════════════════════════════════════

# Check for running containers for this project before starting a new session
# This helps users avoid accumulating containers they forgot about. Unattended, a restore's
# answer: start alongside them. A restart's own container is already gone (--rm), so any
# still running belongs to another session, which stopping would kill.
container_menu_rc=0
check_project_containers_startup "$PROJECT_NAME" "yolo" "$CCY_NO_CONTAINER_PROMPTS" || container_menu_rc=$?
ccy_container_menu_exit "$container_menu_rc"

# Set terminal title to project name
printf '\033]0;CCY: %s\007' "$PROJECT_NAME"

# ═══════════════════════════════════════════════════════════════════════════

# Auto-update Claude Code in the image that is about to run, gated daily and
# PER-IMAGE. Once per 24h per image, compare the image's bundled Claude Code
# version against the npm `latest` tag:
#   • already current → NOOP (just refresh the daily stamp)
#   • behind          → fast in-place npm update (update_claude_inplace) + commit,
#                       NO full image rebuild
#   • version unknown → soft-fail, proceed on the existing image (offline-safe)
#
# Per-image (not global) gating: each image — claude-yolo:latest and every
# claude-yolo:<project> — has its OWN daily stamp, so an old project launched for
# the first time today still updates even if another project checked earlier
# today. Must be called with the FINAL resolved $IMAGE_NAME (after the project
# image is selected), so custom/project images are the ones kept current.
#
# Set CCY_AUTO_UPDATE=0 to disable auto-update and fall back to notify-only.
auto_update_claude_code() {
    local image_name="$1"
    local cache_dir="$VERSION_CHECK_CACHE"
    local cache_duration=$((24 * 60 * 60))  # 24 hours in seconds

    # Per-image stamp file: sanitise ':' and '/' in the image tag to a flat name.
    local cache_file="$cache_dir/${image_name//[:\/]/_}"

    # Daily gate. A fresh stamp means we already checked this image today → do
    # nothing (no registry round-trip, no container spawn). This is what makes a
    # second session the same day zero-impact.
    if [ -f "$cache_file" ]; then
        local cache_age cache_stamp
        if ! cache_stamp=$(stat -c %Y "$cache_file" 2>&1); then
            echo "⚠ Could not read the update-check stamp, re-checking: $cache_stamp" >&2
            cache_stamp=0
        fi
        cache_age=$(( $(date +%s) - cache_stamp ))
        if [ "$cache_age" -lt "$cache_duration" ]; then
            return 0
        fi
    fi

    echo "Checking for Claude Code updates (daily, image: $image_name)..."
    mkdir -p "$cache_dir"

    # Bundled version in THIS image. `claude --version` → "X.Y.Z (Claude Code)".
    #
    # The `|| echo "unknown"` this replaces never fired. There is no `pipefail`
    # here, so the pipeline's status is `head`'s — and `head -1` succeeds on
    # empty input. A container that would not start therefore produced an EMPTY
    # version, not "unknown", which walked straight past the offline guard below:
    # two empty versions compare equal and printed "✓ Claude Code is up to date
    # ()", and one empty version started an in-place npm update against a version
    # nothing had read. Capture the command's own status, then require a value.
    local container_version="" version_probe
    if version_probe=$(container_cmd run --rm --entrypoint claude "$image_name" --version 2>&1); then
        container_version=$(printf '%s\n' "$version_probe" | grep -oP '\d+\.\d+\.\d+' | head -1)
    fi
    [ -n "$container_version" ] || container_version="unknown"

    # Latest published version (npm registry API, no npm CLI required).
    local latest_version="" registry_probe
    if registry_probe=$(timeout 5 curl -fsSL "https://registry.npmjs.org/@anthropic-ai/claude-code/latest" 2>&1); then
        latest_version=$(printf '%s\n' "$registry_probe" | grep -oP '"version":\s*"\K[^"]+' | head -1)
    fi
    [ -n "$latest_version" ] || latest_version="unknown"

    # Could not determine a version (offline / registry hiccup). Stamp so we do
    # not re-probe every launch today, and proceed on the existing image.
    # FAIL-FAST-OK: optional launch-time convenience — auto-update must never
    # block starting Claude when the network is down.
    if [ "$container_version" = "unknown" ] || [ "$latest_version" = "unknown" ]; then
        echo "⚠ Could not determine Claude Code version (offline?) — skipping update check for today" >&2
        touch "$cache_file"
        return 0
    fi

    # Already current → NOOP. Refresh the daily stamp and move on.
    if [ "$container_version" = "$latest_version" ]; then
        echo "✓ Claude Code is up to date ($container_version)"
        touch "$cache_file"
        return 0
    fi

    # Behind, but the user opted out → notify-only (the pre-auto-update behaviour).
    if [ "${CCY_AUTO_UPDATE:-1}" = "0" ]; then
        echo ""
        echo "📦 Claude Code update available: $container_version → $latest_version"
        echo "   Auto-update disabled (CCY_AUTO_UPDATE=0). Update manually: ccy --rebuild=claude"
        echo ""
        touch "$cache_file"
        return 0
    fi

    # Behind and auto-update enabled → fast in-place update of the running image.
    echo ""
    echo "📦 Updating Claude Code in $image_name: $container_version → $latest_version"
    echo "   (fast in-place npm update — no full rebuild; first launch today only)"
    echo ""
    if update_claude_inplace "$image_name"; then
        touch "$cache_file"
        echo "✓ Claude Code auto-updated to $latest_version"
    else
        # Update attempt failed mid-flight (e.g. a network drop after the version
        # probe). Do NOT stamp — leave it stale so the next launch retries — and
        # proceed on the working older image rather than blocking the session.
        # FAIL-FAST-OK: optional convenience; a failed auto-update must not stop
        # the user starting Claude on the existing image.
        echo "⚠ Auto-update failed — continuing on existing image ($container_version)." >&2
        echo "  Retry manually with: ccy --rebuild=claude" >&2
    fi
}

# Ensure the per-image update-check cache directory exists
mkdir -p "$VERSION_CHECK_CACHE"

# Best-effort removal of a temporary container. A container that is already gone
# is not an error here, so the failure is logged at debug level rather than
# swallowed with `|| true` (QA-07).
remove_temp_container() {
    if ! container_cmd rm -f "$1" >/dev/null 2>/dev/null; then
        debug "temp container $1 already removed or never created"
    fi
}

# Fast in-place Claude Code update: run npm install in temp container then commit back
update_claude_inplace() {
    local image_name="$1"
    local temp_name="ccy-claude-update-$$"
    echo "  npm install -g @anthropic-ai/claude-code@latest in $image_name..."
    # This used to re-apply the ctrl+z suspend patch straight after the update,
    # because a fresh npm install shipped an UNPATCHED Claude Code. There is no
    # patch to re-apply any more: the PTY supervisor guards ctrl+z from OUTSIDE
    # Claude Code, so an updated binary is protected the moment it starts and
    # this path no longer has a version-churn failure mode to compensate for.
    if ! container_cmd run \
        --name "$temp_name" \
        --entrypoint sh \
        "$image_name" \
        -c 'set -e; npm install -g @anthropic-ai/claude-code@latest 2>&1'; then
        remove_temp_container "$temp_name"
        print_error "Failed to update Claude Code in $image_name"
        return 1
    fi
    # CCY-09: under set -e a failing commit would abort before the rm below and
    # leak the stopped temp container (no --rm on create). Branch explicitly so
    # the container is always cleaned up.
    if ! container_cmd commit \
        --change 'ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]' \
        --change 'CMD ["claude", "--help"]' \
        "$temp_name" "$image_name" >/dev/null; then
        remove_temp_container "$temp_name"
        print_error "Failed to commit updated image $image_name"
        return 1
    fi
    remove_temp_container "$temp_name"
    echo "  ✓ Updated $image_name"
}

# Handle --rebuild flag: mode-aware (claude=fast in-place, project=project image only, full=clean rebuild)
if [ "$FORCE_REBUILD" = true ]; then
    case "$REBUILD_MODE" in
        claude)
            echo "Updating Claude Code in-place (fast path)..."
            if ! container_cmd image inspect "$IMAGE_NAME" &>/dev/null; then
                echo "No base image found - running full build first..."
                if [ ! -f "$DOCKERFILE_DIR/Dockerfile" ]; then
                    echo "Error: Dockerfile not found at $DOCKERFILE_DIR/Dockerfile"
                    echo "Please run the ansible playbook: playbooks/imports/play-claude-yolo.yml"
                    exit 1
                fi
                build_container_with_hash "$IMAGE_NAME" "$DOCKERFILE_DIR" "--no-cache" "$BASE_IMAGE_NAME"
            else
                update_claude_inplace "$IMAGE_NAME"
                if container_cmd image inspect "$BASE_IMAGE_NAME" &>/dev/null; then
                    update_claude_inplace "$BASE_IMAGE_NAME"
                fi
            fi
            rm -rf "$VERSION_CHECK_CACHE"
            echo "✓ Claude Code updated"
            ;;
        project)
            echo "Updating Claude Code and rebuilding project image..."
            if container_cmd image inspect "$IMAGE_NAME" &>/dev/null; then
                update_claude_inplace "$IMAGE_NAME"
                if container_cmd image inspect "$BASE_IMAGE_NAME" &>/dev/null; then
                    update_claude_inplace "$BASE_IMAGE_NAME"
                fi
            fi
            rm -rf "$VERSION_CHECK_CACHE"
            ;;
        full)
            echo "Forcing full container rebuild (no cache)..."
            if [ ! -f "$DOCKERFILE_DIR/Dockerfile" ]; then
                echo "Error: Dockerfile not found at $DOCKERFILE_DIR/Dockerfile"
                echo "Please run the ansible playbook: playbooks/imports/play-claude-yolo.yml"
                exit 1
            fi
            build_container_with_hash "$IMAGE_NAME" "$DOCKERFILE_DIR" "--no-cache" "$BASE_IMAGE_NAME"
            rm -rf "$VERSION_CHECK_CACHE"
            echo "✓ Container image rebuilt successfully"
            ;;
    esac
fi

# Check if Docker image exists
if ! container_cmd image inspect "$IMAGE_NAME" &> /dev/null; then
    echo "Building Claude YOLO container image (first time setup)..."
    if [ ! -f "$DOCKERFILE_DIR/Dockerfile" ]; then
        echo "Error: Dockerfile not found at $DOCKERFILE_DIR/Dockerfile"
        echo "Please run the ansible playbook: playbooks/imports/play-claude-yolo.yml"
        exit 1
    fi
    build_container_with_hash "$IMAGE_NAME" "$DOCKERFILE_DIR" "" "$BASE_IMAGE_NAME"
    echo "✓ Container image built successfully"
fi

# Validate container version and hash (auto-rebuild if needed)
if ! validate_container_version "$IMAGE_NAME" "$DOCKERFILE_DIR/Dockerfile" "$REQUIRED_CONTAINER_VERSION"; then
    # Version/hash mismatch - rebuild required
    build_container_with_hash "$IMAGE_NAME" "$DOCKERFILE_DIR" "" "$BASE_IMAGE_NAME"
    echo "✓ Container image rebuilt with version $REQUIRED_CONTAINER_VERSION"
    # Clear per-image update-check stamps so every image re-checks after rebuild
    rm -rf "$VERSION_CHECK_CACHE"
fi

# Note: the daily per-image auto-update runs LATER, after the project image is
# resolved (so it gates the image that actually runs, not just claude-yolo:latest).

# Function to find next available container name with suffix
# Note: get_next_container_name is now in lib/common.bash

# Check for project-specific Dockerfile extension
# (PROJECT_NAME already set earlier after git repo check)
PROJECT_DOCKERFILE=".claude/ccy/Dockerfile"
PROJECT_IMAGE_NAME="claude-yolo:${PROJECT_NAME}"
PROJECT_DOCKERFILE_HASH_FILE="$HOME/.cache/claude-yolo-${PROJECT_NAME}-dockerfile-hash"
PROJECT_BASE_VERSION_FILE="$HOME/.cache/claude-yolo-${PROJECT_NAME}-base-version"

if [ -f "$PROJECT_DOCKERFILE" ] && [ "$DISABLE_CUSTOM_DOCKER" = false ]; then
    echo ""
    echo "════════════════════════════════════════════════════════════════════════════════"
    echo "✅ Custom Dockerfile detected: .claude/ccy/Dockerfile"
    echo "════════════════════════════════════════════════════════════════════════════════"
    echo ""
    echo "This project uses a custom container image with project-specific tools."
    echo "The container will automatically rebuild if the Dockerfile changes."
    echo ""
    echo "Project image: $PROJECT_IMAGE_NAME"
    echo "To modify: 'ccy --custom-docker' (AI-guided) or 'ccy --custom' (quick edit)"
    echo ""

    # Calculate hash of project Dockerfile (md5sum, 16 char - consistent with base)
    current_project_hash=$(md5sum "$PROJECT_DOCKERFILE" | cut -d' ' -f1 | cut -c1-16)
    previous_project_hash=""
    if [ -f "$PROJECT_DOCKERFILE_HASH_FILE" ]; then
        previous_project_hash=$(cat "$PROJECT_DOCKERFILE_HASH_FILE")
    fi

    # Get current base image version. The fallback is stated separately from the
    # substitution, so "the engine could not be asked" is a decision made here
    # rather than a string that silently becomes the answer.
    if ! current_base_version=$(container_cmd image inspect "claude-yolo:latest" \
        --format '{{index .Config.Labels "claude-yolo-version"}}' 2>&1); then
        current_base_version="unknown"
    fi
    [ -n "$current_base_version" ] || current_base_version="unknown"

    # Get base version that project image was built with
    previous_base_version=""
    if [ -f "$PROJECT_BASE_VERSION_FILE" ]; then
        previous_base_version=$(cat "$PROJECT_BASE_VERSION_FILE")
    fi

    # Build if image doesn't exist, Dockerfile changed, base image updated, or --rebuild flag
    should_build=false
    rebuild_reason=""

    if ! container_cmd image inspect "$PROJECT_IMAGE_NAME" &> /dev/null; then
        echo "Building project-specific image (first time)..."
        should_build=true
        rebuild_reason="first time"
    elif [ "$current_project_hash" != "$previous_project_hash" ]; then
        echo "Project Dockerfile changed, rebuilding image..."
        should_build=true
        rebuild_reason="Dockerfile changed"
    elif [ "$current_base_version" != "$previous_base_version" ]; then
        echo ""
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo "ℹ️  Base image updated - rebuilding project image"
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo "Previous base: v$previous_base_version"
        echo "Current base:  v$current_base_version"
        echo ""
        echo "Project images inherit from claude-yolo:latest."
        # Extract changelog from the CCY_VERSION comment in this script (e.g. "# fix: ...")
        ccy_version_line=$(grep '^CCY_VERSION=' "$0")
        ccy_changelog="${ccy_version_line#*# }"
        echo "Rebuilding to include: $ccy_changelog"
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo ""
        should_build=true
        rebuild_reason="base image updated"
    elif [ "$FORCE_REBUILD" = true ]; then
        if [ "$REBUILD_MODE" = "claude" ] && container_cmd image inspect "$PROJECT_IMAGE_NAME" &>/dev/null; then
            echo "Updating Claude Code in project image (fast)..."
            update_claude_inplace "$PROJECT_IMAGE_NAME"
            echo "$current_project_hash" > "$PROJECT_DOCKERFILE_HASH_FILE"
            echo "$current_base_version" > "$PROJECT_BASE_VERSION_FILE"
        else
            echo "Force rebuild requested..."
            should_build=true
            rebuild_reason="--rebuild flag"
        fi
    else
        echo "✓ Using cached project image (Dockerfile and base unchanged)"
    fi

    if [ "$should_build" = true ]; then
        # Build with buildkit for better caching
        echo ""
        echo "Building with Docker BuildKit for optimal caching..."
        echo "Tip: apt/npm packages are cached between builds for speed"
        echo ""

        # Calculate project Dockerfile hash for build arg
        project_dockerfile_hash=$(md5sum "$PROJECT_DOCKERFILE" | cut -d' ' -f1 | cut -c1-16)

        # Use buildkit for cache mounts and pass Dockerfile hash
        # Capture output to temp file for error reporting while still displaying live
        build_log=$(mktemp /tmp/ccy-build-XXXXXX.log)

        # Defined inline so $project_dockerfile_hash, $PROJECT_IMAGE_NAME, etc. stay in scope.
        # Re-invoked once after a rootless-buildah-cache recovery; see below.
        run_project_build() {
            set -o pipefail
            DOCKER_BUILDKIT=1 container_cmd build \
                --build-arg BUILDKIT_INLINE_CACHE=1 \
                --build-arg DOCKERFILE_HASH="$project_dockerfile_hash" \
                -t "$PROJECT_IMAGE_NAME" \
                -f "$PROJECT_DOCKERFILE" \
                . 2>&1 | tee "$build_log"
        }

        build_succeeded=false
        if run_project_build; then
            build_succeeded=true
        elif is_buildah_cache_permission_failure "$build_log"; then
            # Stale rootless buildah cache (userns ownership drift). Not a Dockerfile
            # bug — purge the per-uid cache dir and retry the build once before
            # falling through to interactive diagnostic mode.
            echo ""
            echo "⚠ Detected stale rootless buildah cache (permission failure)"
            echo "  This is not a Dockerfile bug. Auto-recovering and retrying once..."
            echo ""
            if purge_stale_buildah_cache; then
                : > "$build_log"
                if run_project_build; then
                    build_succeeded=true
                    echo ""
                    echo "✓ Build succeeded after cache recovery"
                fi
            fi
        fi

        if [ "$build_succeeded" = true ]; then

            # Save hashes and versions to track changes
            echo "$current_project_hash" > "$PROJECT_DOCKERFILE_HASH_FILE"
            echo "$current_base_version" > "$PROJECT_BASE_VERSION_FILE"
            rm -f "$build_log"
            echo ""
            echo "✓ Project image built successfully: $PROJECT_IMAGE_NAME"
            [ -n "$rebuild_reason" ] && echo "  Rebuild reason: $rebuild_reason"
        else
            # Build failed — save full log and auto-start in diagnostic mode.
            # Rather than exiting, fall through to start CCY with the base image
            # and inject a diagnostic prompt so Claude can fix the Dockerfile interactively.
            # BSH-10: mktemp so the diagnostic log can't collide across runs or
            # be redirected through a pre-planted symlink at a fixed path.
            build_failure_log=$(mktemp /tmp/ccy-dockerfile-build-failure-XXXXXX.log)
            cp "$build_log" "$build_failure_log"
            rm -f "$build_log"

            # Build diagnostic prompt (full log path + last 50 lines inline for context)
            fix_prompt_file=$(mktemp /tmp/ccy-fix-dockerfile-XXXXXX.txt)
            {
                echo "The custom Dockerfile at .claude/ccy/Dockerfile failed to build."
                echo ""
                echo "Full build log: $build_failure_log"
                echo ""
                echo "Build error (last 50 lines):"
                echo ""
                tail -50 "$build_failure_log"
                echo ""
                echo "Please read the Dockerfile and the error above, diagnose the root cause,"
                echo "and fix it so it builds successfully. Work interactively with the user."
                echo "After fixing, tell them to re-run: ccy"
            } > "$fix_prompt_file"

            # Inject prompt — picked up at Claude launch (line ~2184)
            # Only set if user hasn't already provided --prompt
            if [ -z "$PROMPT_TEXT" ]; then
                PROMPT_TEXT="$(cat "$fix_prompt_file")"
            fi
            rm -f "$fix_prompt_file"

            DOCKER_BUILD_FAILED=true

            echo ""
            print_error "Custom Dockerfile build failed — starting in diagnostic mode"
            echo ""
            echo "Full build log: $build_failure_log"
            echo "Falling back to base image. Claude will help fix the Dockerfile interactively."
            echo ""
        fi
    fi

    # Use project-specific image if it exists (skip if build just failed — use base image for diagnosis)
    if [ "${DOCKER_BUILD_FAILED:-false}" = false ] && container_cmd image inspect "$PROJECT_IMAGE_NAME" &> /dev/null; then
        IMAGE_NAME="$PROJECT_IMAGE_NAME"
        echo "✓ Using project-specific image"
    fi

    echo "════════════════════════════════════════════════════════════════════════════════"
    echo ""
fi

# Daily, per-image Claude Code auto-update. Runs HERE — after the project image
# is resolved — so $IMAGE_NAME is the image that will actually run (project image
# when a custom Dockerfile exists, else claude-yolo:latest). NOOP when already on
# the latest npm version; first launch of the day only when behind.
auto_update_claude_code "$IMAGE_NAME"

echo "✓ Token: Long-lived OAuth (CLAUDE_CODE_OAUTH_TOKEN)"
echo "✓ State: /workspace/.claude/ (project-level, persists in git repo)"

# Repair the permissions on this project's Claude Code state before launching.
#
# entrypoint.sh sets `umask 077` so state created from now on is owner-only, but
# that does nothing for state written before the umask existed. Anthropic
# documents that this state — transcripts, verbatim pre-edit file bodies in
# file-history/, shell snapshots, prompt history — is NOT encrypted at rest and
# that file permissions are its only protection.
#
# This lives here rather than in the playbook because only the launcher knows
# which project directory is in play; the playbook owns the desktop ~/.claude
# store, which is at a fixed path. See Plan 00098.
#
# Advisory by design: it reports and repairs, and never blocks the launch. This
# is the code path EVERY session traverses, so a hard gate here would be a far
# worse failure than the exposure it is fixing.
repair_project_state_permissions() {
    # Scope is the WHOLE project .claude tree, not just .claude/ccy.
    #
    # There is a third transcript store: the hooks daemon's pre_compact
    # transcript_archiver writes verbatim conversation archives to
    # .claude/hooks-daemon/untracked/transcripts/. The daemon calls os.umask(0)
    # when it daemonizes, so those land at 0666 inside a 0777 directory — and no
    # umask in entrypoint.sh can ever reach them, because the daemon overwrites
    # its own umask rather than inheriting ours.
    #
    # That also makes this repair LOAD-BEARING AND PERMANENT, not a one-off
    # migration: a writer exists that re-creates world-writable files after every
    # repair, so this must run on every launch. Do not "optimise" it away once
    # the umask has shipped.
    #
    # Widening to $PWD/.claude is safe for git: git records only the execute bit
    # (100644 vs 100755), so clearing group/other read bits produces no diff on
    # tracked files.
    local state_dir="$PWD/.claude"
    [ -d "$state_dir" ] || return 0

    local offenders
    # -perm /077 = any group or other bit set, so a repaired store matches
    # nothing and this is a no-op on every subsequent launch.
    # -type f/-type d excludes symlinks deliberately: chmod on a symlink applies
    # to its target, which may lie outside this tree.
    offenders="$(find "$state_dir" \( -type f -o -type d \) -perm /077 -print | wc -l)"
    [ "$offenders" -gt 0 ] || return 0

    # `chmod go=` clears group/other and leaves OWNER bits alone. A blanket
    # `chmod 600` here would strip the execute bit from every plugin and skill
    # script in the tree.
    if find "$state_dir" \( -type f -o -type d \) -perm /077 -exec chmod go= {} +; then
        echo "✓ State permissions: repaired $offenders owner-only (was group/other-readable)"
    else
        echo "⚠ State permissions: repair of $offenders entr(ies) under $state_dir failed." >&2
        echo "  Session state there is readable by other local users. Continuing." >&2
    fi
}
repair_project_state_permissions

if [ "$DEBUG_CCY" = true ]; then
    echo ""
    echo "════════════════════════════════════════════════════════════════════════════════"
    echo "DEBUG: Pre-mount setup"
    echo "════════════════════════════════════════════════════════════════════════════════"
    echo "Selected token file: $SELECTED_TOKEN"
    echo "Token exists: $([ -f "$SELECTED_TOKEN" ] && echo "YES" || echo "NO")"
    echo "Token size: $(stat -c%s "$SELECTED_TOKEN" 2>/dev/null || echo "N/A") bytes"  # FAIL-FAST-OK: debug dump for a human, and "N/A" names the stat failure rather than passing off a size nothing measured
    echo ""
fi

# Note: .claude.json is created inside the container by entrypoint.sh
# This avoids single-file bind mount issues on btrfs where atomic rename() fails with EBUSY
debug "Config .claude.json will be created inside container by entrypoint"

# Note:
# - Token passed via CLAUDE_CODE_OAUTH_TOKEN environment variable (no file mount)
# - Long-lived tokens (sk-ant-oat01-...) from `claude setup-token`
# - ALL Claude Code state persists in /workspace/.claude/ (project-local, gitignored)
#   - User state (sessions, history, databases, todos): /workspace/.claude/ccy/
#   - Project state (settings, agents, hooks, plans): /workspace/.claude/
# - Container symlinks /root/.claude -> /workspace/.claude/ccy/
#
# This is the same approach GitHub Actions use:
# - Long-lived OAuth tokens via CLAUDE_CODE_OAUTH_TOKEN env var
# - No credential files, no refresh needed
# - Clean, simple, reliable

# Create temp directory ONLY for gitconfig (can't mount directly into container root)
# BSH-10: mktemp -d (not a predictable /tmp/claude-yolo-$PID) so a hostile or
# leftover directory cannot pre-seed the destination, and 0700/0600 modes keep
# the gitconfig (which may carry credential-helper / signing config) private.
CONFIG_TEMP=$(mktemp -d /tmp/claude-yolo-XXXXXX)
chmod 700 "$CONFIG_TEMP"

# Copy git config to temp location for entrypoint
if [ -f "$HOME/.gitconfig" ]; then
    cp "$HOME/.gitconfig" "$CONFIG_TEMP/gitconfig"
    chmod 600 "$CONFIG_TEMP/gitconfig"
else
    touch "$CONFIG_TEMP/gitconfig"
    chmod 600 "$CONFIG_TEMP/gitconfig"
fi

# Cleanup function
cleanup() {
    # Restore terminal suspend character if we disabled it before container launch.
    # Best-effort: the TTY may already be gone at exit, which is not an error.
    if [[ -n "${_CCY_STTY_SAVED:-}" ]]; then
        if ! stty "$_CCY_STTY_SAVED" 2>/dev/null; then
            debug "could not restore terminal suspend character (no TTY at exit)"
        fi
    fi

    rm -rf "$CONFIG_TEMP"
    # Staged key copies (SELinux-enforcing hosts, lib/ssh-handling.bash) live in
    # a per-session tmpfs directory; they must not outlive the session.
    if [ -n "${CCY_KEY_STAGE_DIR:-}" ]; then
        rm -rf "$CCY_KEY_STAGE_DIR"
        unset CCY_KEY_STAGE_DIR
    fi
    # A restore's container passphrase copy: the entrypoint removes it once its keys are
    # added; this covers a container that never got that far.
    if [ -n "${CCY_RESTORE_ASKPASS_DIR:-}" ]; then
        rm -rf "$CCY_RESTORE_ASKPASS_DIR"
    fi
    # The duty of the probe's trap this one replaces; a no-op once the probe has returned.
    _probe_agent_stop
    ccy_askpass_passphrase_discard
    ccy_agent_filter_stop

    # Show debug log if CCY debugging is enabled
    if [ "$DEBUG_CCY" = true ] && [ -n "$DEBUG_LOG" ]; then
        echo ""
        echo "════════════════════════════════════════════════════════════════════════════════"
        echo "DEBUG LOG (saved to $DEBUG_LOG)"
        echo "════════════════════════════════════════════════════════════════════════════════"
        cat "$DEBUG_LOG"
        echo "════════════════════════════════════════════════════════════════════════════════"
    fi
}
trap cleanup EXIT

# Commit signing (Plan 00139 D5): the container signs through an ssh-agent holding the
# session's primary identity, and the gitconfig copy names it. SSH_KEY_PATHS gains an
# entry only for a key file, so a key-file primary is always its first. After the trap,
# so a refusal still removes the staged files.
# A key forwarded through the one-key agent has no file in the container: the copy names
# its public half instead. Beside such keys every mounted key file has no passphrase
# (ccy_agent_forward_select), so it signs by itself and needs no agent to hold it.
signing_primary="${SSH_KEYS[0]:-}"
signing_in_container=""
signing_filter_sock=""
signing_forwarded="${SSH_AGENT_FORWARDED:-0}"
if [ -n "$signing_primary" ] && ccy_agent_filter_forwards "$signing_primary"; then
    signing_filter_sock="$CCY_AGENT_FILTER_SOCK"
elif [ -n "$signing_primary" ] && [ "$signing_primary" != "$SSH_AGENT_SENTINEL" ]; then
    signing_in_container="${SSH_KEY_PATHS[0]}"
    if [ ${#CCY_AGENT_FILTER_KEYS[@]} -gt 0 ]; then
        signing_forwarded=0
    fi
fi
if ! configure_git_signing "$CONFIG_TEMP/gitconfig" "$PWD" "$signing_primary" \
    "$signing_in_container" "$signing_forwarded" "$signing_filter_sock"; then
    exit 1
fi

# A server's session restore: the entrypoint unlocks the mounted key files with ssh-add too,
# so it gets its own passphrase copy and askpass helper (lib/ssh-handling.bash). Not with a
# forwarded agent, where the entrypoint adds nothing. After the trap, so cleanup removes it.
if [ -n "$RESTORE_SSH_PASSPHRASE_FILE" ] && [ ${#SSH_KEY_PATHS[@]} -gt 0 ] \
    && [ "${SSH_AGENT_FORWARDED:-0}" != "1" ]; then
    ccy_restore_askpass_container "$RESTORE_SSH_PASSPHRASE_FILE" || exit 1
fi
# A passphrase an SSH_ASKPASS helper supplied has now been copied wherever it is needed.
ccy_askpass_passphrase_discard || exit 1

# Convert SSH_KEY_PATHS array to colon-separated string
SSH_KEY_PATHS_STR=$(IFS=:; echo "${SSH_KEY_PATHS[*]}")

if [ "$DEBUG_CCY" = true ]; then
    echo ""
    echo "════════════════════════════════════════════════════════════════════════════════"
    echo "DEBUG: Docker run configuration"
    echo "════════════════════════════════════════════════════════════════════════════════"
    echo "Workspace: $PWD"
    echo "Claude state: /workspace/.claude/ (ALL state - project-local, gitignored)"
    echo "  - Project: settings, agents, hooks, plans"
    echo "  - Sessions: ccy/ (symlinked from /root/.claude in container)"
    echo "Token file: $SELECTED_TOKEN"
    echo "Token type: Long-lived OAuth (CLAUDE_CODE_OAUTH_TOKEN)"
    echo "SSH keys mounted: ${#SSH_KEY_PATHS[@]}"
    echo "SSH agent forwarded: ${SSH_AGENT_FORWARDED:-0}"
    echo "SSH alias stanza: ${SSH_CONFIG_EXTRA_B64:+yes} pins: ${SSH_KNOWN_HOSTS_PINS:-none}"
    echo ""
    echo "Docker command (simplified):"
    echo "  $CONTAINER_ENGINE run -it --rm \\"
    echo "    -e CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-... \\"
    echo "    -v $PWD:/workspace \\"
    echo "    ... (other mounts) ..."
    echo "    $IMAGE_NAME \\"
    echo "    claude --dangerously-skip-permissions ${CLAUDE_ARGS[*]}"
    echo "════════════════════════════════════════════════════════════════════════════════"
    echo ""
    echo "Debug log saved to: $DEBUG_LOG"
    echo ""
    echo "Container will start now. Once inside, you can check:"
    echo "  ls -la /workspace/.claude/"
    echo "  echo \$CLAUDE_CODE_OAUTH_TOKEN"
    echo ""
    echo "After exiting, review the debug log with:"
    echo "  cat $DEBUG_LOG"
    echo ""
    read -rp "Press Enter to continue..."
fi

# Run container with project workspace
# State Management:
# - ALL Claude Code state stored in /workspace/.claude/ (project-local, gitignored)
#   - Project state: settings, agents, hooks, plans (in .claude/ root)
#   - Session state: history, databases, todos (in .claude/ccy/, symlinked from /root/.claude)
# - Container remains ephemeral (--rm) while state persists in project
#
# Authentication:
# - Long-lived OAuth token passed via CLAUDE_CODE_OAUTH_TOKEN environment variable
# - No credential files needed (same approach as GitHub Actions)
# - Token stored in ~/.claude-tokens/ccy/tokens/NAME.YYYY-MM-DD.token on host
#
# Mounts:
# - /workspace: Project directory (includes .claude/ for ALL state)
# - /tmp/claude-config-import: Git configuration
#
# No credentials mounted - token via environment variable

# Build mount arguments
# Note: /workspace includes .claude/ directory - Claude Code uses this for ALL state
# The entrypoint will symlink /root/.claude -> /workspace/.claude/ccy/ for session persistence
# On an SELinux-enforcing host container_t may not read user_home_t (a permissive
# one logs every such read), so the workspace carries the shared relabel (`:z`)
# and the per-session config import the private one; both are empty when the
# verdict is off (ccy_selinux_mode). An entry podman may not relabel would fail the
# container on start, so it is found, explained and offered a fix first.
workspace_relabel_preflight "$PWD" || exit 1
DOCKER_MOUNTS=(
    -v "$PWD:/workspace${CCY_MOUNT_RELABEL:+:$CCY_MOUNT_RELABEL}"
    -v "$CONFIG_TEMP:/tmp/claude-config-import:ro${CCY_MOUNT_RELABEL:+,Z}"
)

# BSH-12: honour CCY_EXTRA_MOUNTS — a space-separated list of `-v src:dst:opts`
# tokens exported by helper wrappers (e.g. scripts/desktop-symlinks) that want
# extra read-only debug mounts. Previously this variable was advertised but never
# read, so the promised mounts silently never appeared. Split on whitespace into
# the mount array (mount paths therefore must not contain spaces).
if [ -n "${CCY_EXTRA_MOUNTS:-}" ]; then
    read -ra _extra_mounts <<< "$CCY_EXTRA_MOUNTS"
    DOCKER_MOUNTS+=("${_extra_mounts[@]}")
    debug "Added ${#_extra_mounts[@]} CCY_EXTRA_MOUNTS token(s) to DOCKER_MOUNTS"
fi

# Tracked per-project binds from .claude/ccy/mounts. Validated line by line;
# any problem aborts here, before a container exists (see load_project_mounts).
load_project_mounts || exit 1
if [ "${#PROJECT_MOUNTS[@]}" -gt 0 ]; then
    DOCKER_MOUNTS+=("${PROJECT_MOUNTS[@]}")
    debug "Added ${#PROJECT_MOUNTS[@]} project mount token(s) to DOCKER_MOUNTS"
fi

# This checkout's ccy.env.local is the install's own (placed by its IaC): read-only inside.
ccy_env_local_mount_args || exit 1
DOCKER_MOUNTS+=("${CCY_ENV_LOCAL_MOUNT[@]}")

# Note: Session state (history, databases, todos) will be stored in /workspace/.claude/ccy/
# This keeps everything project-local and gitignored, while maintaining ephe meral containers

# Auto-detect and offer network connection
NETWORK_FLAG=""
AUTO_CONNECT_NETWORK=""

# Handle network flags
if [[ -n "$SPECIFIED_NETWORK" ]]; then
    # --network flag provided (or loaded from config)
    # Verify network exists
    if container_cmd network ls --format '{{.Name}}' | grep -q "^${SPECIFIED_NETWORK}$"; then
        # Network exists - check if services are running. A restart rejoins the network the
        # session had and starts nothing: whatever ran on it before the restart is unchanged.
        if [ -n "$CCY_RESTART_RELAUNCH_SESSION" ] \
            || check_and_start_compose_services "$SPECIFIED_NETWORK" "$PROJECT_NAME"; then
            # Services running (or were started)
            NETWORK_FLAG="--network $SPECIFIED_NETWORK"
            AUTO_CONNECT_NETWORK="$SPECIFIED_NETWORK"
            if [[ "$NETWORK_FROM_CONFIG" = true ]]; then
                echo "✓ Will connect to network: $SPECIFIED_NETWORK (from saved config)"
            else
                echo "✓ Will connect to network: $SPECIFIED_NETWORK (via --network flag)"
            fi
            echo ""
        else
            # No services running and user declined to start - continue without network
            echo "⚠  Continuing without network connection (no services running)"
            echo ""
            SPECIFIED_NETWORK=""
        fi
    else
        # Network not found - different handling for config vs explicit flag
        if [[ "$NETWORK_FROM_CONFIG" = true ]]; then
            # From config - warn and offer to start compose
            echo ""
            echo "════════════════════════════════════════════════════════════════════════════════"
            echo "⚠  WARNING: Saved network no longer exists"
            echo "════════════════════════════════════════════════════════════════════════════════"
            echo ""
            echo "Network from config: $SPECIFIED_NETWORK"
            echo ""
            echo "This network was saved from your last launch but is no longer available."
            echo "Common causes:"
            echo "  • Docker Compose project stopped (docker-compose down)"
            echo "  • Docker daemon restarted"
            echo "  • Network manually deleted"
            echo ""

            # Try to restore network by starting compose
            if offer_compose_start "$SPECIFIED_NETWORK" "$PROJECT_NAME"; then
                # Compose started successfully and network found
                SPECIFIED_NETWORK="$COMPOSE_NETWORK"
                NETWORK_FLAG="--network $COMPOSE_NETWORK"
                AUTO_CONNECT_NETWORK="$COMPOSE_NETWORK"
                echo ""
            else
                # Compose not available or user declined
                echo ""
                echo "Available networks:"
                # Ask the engine first, so "the engine could not be reached" is
                # not printed as "no user-defined networks found" — grep exits 1
                # on an empty input either way, which made the two identical.
                if ! network_ls_out=$(container_cmd network ls --format "  {{.Name}}" 2>&1); then
                    echo "  (could not list networks — ${CONTAINER_ENGINE} said: ${network_ls_out:-no output})"
                elif ! printf '%s\n' "$network_ls_out" | grep -v "^  bridge$\|^  host$\|^  none$"; then
                    echo "  (no user-defined networks found)"
                fi
                echo ""

                while true; do
                    read -rp "$CCY_PROMPT_NETWORK_CONTINUE " continue_choice
                    continue_choice=${continue_choice:-Y}
                    echo ""

                    case "$continue_choice" in
                        Y|y|Yes|yes)
                            echo "Continuing without network connection..."
                            echo "════════════════════════════════════════════════════════════════════════════════"
                            echo ""
                            # Clear the network flag so we continue without it
                            SPECIFIED_NETWORK=""
                            break
                            ;;
                        N|n|No|no)
                            echo "Cancelled. Fix the network and try again:"
                            echo "  • Restart your docker-compose project"
                            echo "  • Or use: ccy --no-network"
                            echo "  • Or use: ccy --network <different-network>"
                            exit 0
                            ;;
                        *)
                            echo "Invalid choice. Please enter Y or n"
                            echo ""
                            ;;
                    esac
                done
            fi
        else
            # Explicit --network flag - this is an error
            print_error "Network not found: $SPECIFIED_NETWORK"
            echo "" >&2
            echo "Available networks:" >&2
            container_cmd network ls --format "  {{.Name}}" >&2
            exit 1
        fi
    fi
elif [[ "$NO_NETWORK_MODE" = true ]]; then
    # --no-network flag provided
    echo "✓ Skipping network connection (--no-network flag)"
    echo ""
elif [[ -n "$CCY_RESTART_RELAUNCH_SESSION" ]]; then
    # A restart with neither flag: the session joined no project network, so the relaunch
    # joins none either, without the detection and offers below.
    echo "✓ No project network (the session had none before its restart)"
    echo ""
else
    # No network flags - check for persisted network preference first
    # Matches how lib/network-management.bash calls it: a non-zero return means
    # "no preference recorded", which is different from "the file could not be
    # read" — and its stderr is no longer discarded, so the latter is visible.
    if ! PERSISTED_NETWORK=$(load_network_preference); then
        PERSISTED_NETWORK=""
    fi

    if [[ -n "$PERSISTED_NETWORK" ]]; then
        # Found persisted network - verify it exists
        if container_cmd network ls --format '{{.Name}}' | grep -q "^${PERSISTED_NETWORK}$"; then
            # Network exists - check if services are running
            if check_and_start_compose_services "$PERSISTED_NETWORK" "$PROJECT_NAME"; then
                # Services running (or were started)
                SPECIFIED_NETWORK="$PERSISTED_NETWORK"
                NETWORK_FLAG="--network $PERSISTED_NETWORK"
                AUTO_CONNECT_NETWORK="$PERSISTED_NETWORK"
                echo "✓ Will connect to network: $PERSISTED_NETWORK (from saved preference)"
                echo ""
            else
                # No services running and user declined to start
                echo "⚠  Network exists but no services running"
                echo ""
            fi
        else
            echo "⚠  Saved network '$PERSISTED_NETWORK' no longer exists"
            echo ""

            # Try to restore network by starting compose
            if offer_compose_start "$PERSISTED_NETWORK" "$PROJECT_NAME"; then
                # Compose started successfully and network found
                SPECIFIED_NETWORK="$COMPOSE_NETWORK"
                NETWORK_FLAG="--network $COMPOSE_NETWORK"
                AUTO_CONNECT_NETWORK="$COMPOSE_NETWORK"
                echo ""
            fi
        fi
    fi

    # If no persisted network found, auto-detect and offer connection
    if [[ -z "$SPECIFIED_NETWORK" ]]; then
        # Check BOTH docker and podman to detect cross-engine issues
        MATCHING_NETWORKS=()
        DOCKER_NETWORKS=()
        PODMAN_NETWORKS=()
        CROSS_ENGINE_MISMATCH=false

        # Query current engine (podman or docker)
        while IFS= read -r net; do
            # Skip default networks
            if [[ "$net" != "bridge" ]] && [[ "$net" != "host" ]] && [[ "$net" != "none" ]] && [[ "$net" != "podman" ]]; then
                # Check if network name contains project name
                if [[ "$net" == *"$PROJECT_NAME"* ]]; then
                    MATCHING_NETWORKS+=("$net")
                fi
            fi
        done < <(container_cmd network ls --format "{{.Name}}" 2>/dev/null)

    # Query the OTHER engine to detect mismatches
    OTHER_ENGINE=""
    if [[ "$CONTAINER_ENGINE" = "podman" ]]; then
        OTHER_ENGINE="docker"
    else
        OTHER_ENGINE="podman"
    fi

    # Check if other engine is available
    if command -v "$OTHER_ENGINE" &>/dev/null; then
        # Get networks from other engine
        OTHER_ENGINE_NETWORKS=()
        while IFS= read -r net; do
            if [[ "$net" != "bridge" ]] && [[ "$net" != "host" ]] && [[ "$net" != "none" ]] && [[ "$net" != "podman" ]]; then
                OTHER_ENGINE_NETWORKS+=("$net")
                # Check if this network matches project name
                if [[ "$net" == *"$PROJECT_NAME"* ]]; then
                    # Found matching network in OTHER engine but not current engine
                    if [[ ${#MATCHING_NETWORKS[@]} -eq 0 ]]; then
                        CROSS_ENGINE_MISMATCH=true
                        if [[ "$CONTAINER_ENGINE" = "podman" ]]; then
                            DOCKER_NETWORKS+=("$net")
                        else
                            PODMAN_NETWORKS+=("$net")
                        fi
                    fi
                fi
            fi
        done < <("$OTHER_ENGINE" network ls --format "{{.Name}}" 2>/dev/null)
    fi

# Show cross-engine mismatch warning BEFORE normal network detection
if [[ "$CROSS_ENGINE_MISMATCH" = true ]]; then
    echo ""
    echo "════════════════════════════════════════════════════════════════════════════════"
    echo "⚠️  CROSS-ENGINE NETWORK MISMATCH DETECTED"
    echo "════════════════════════════════════════════════════════════════════════════════"
    echo ""

    if [[ "$CONTAINER_ENGINE" = "podman" ]]; then
        # CCY using Podman, but networks found in Docker
        echo "CCY is configured to use Podman, but project networks exist in Docker:"
        echo ""
        for net in "${DOCKER_NETWORKS[@]}"; do
            echo "  • $net (Docker only)"
        done
        echo ""
        echo "Problem:"
        echo "  • Docker and Podman have separate network namespaces"
        echo "  • CCY (using Podman) cannot see Docker networks"
        echo "  • Your compose setup is using Docker"
        echo ""
        echo "────────────────────────────────────────────────────────────────────────────────"
        echo "Options:"
        echo "────────────────────────────────────────────────────────────────────────────────"
        echo ""
        echo "  1) Clean up Docker networks and start with Podman (recommended)"
        echo "  2) Switch CCY to use Docker instead (export CCY_CONTAINER_ENGINE=docker)"
        echo "  3) Continue without network connection"
        echo "  4) Quit"
        echo ""

        while true; do
            read -rp "$CCY_PROMPT_NETWORK_ENGINE_CONFLICT " cleanup_choice
            echo ""

            case "$cleanup_choice" in
                1)
                    # Clean up Docker networks and switch to Podman
                    echo "────────────────────────────────────────────────────────────────────────────────"
                    echo "Docker Network Cleanup"
                    echo "────────────────────────────────────────────────────────────────────────────────"
                    echo ""
                    echo "  a) Remove project networks only:"
                    for net in "${DOCKER_NETWORKS[@]}"; do
                        echo "     docker network rm $net"
                    done
                    echo ""
                    echo "  b) Remove ALL unused Docker networks (docker network prune)"
                    echo ""

                    while true; do
                        read -rp "$CCY_PROMPT_NETWORK_PRUNE " prune_choice
                        echo ""

                        case "$prune_choice" in
                            a|A)
                                echo "Stopping containers and removing project networks..."
                                # Stop containers on these networks first
                                for net in "${DOCKER_NETWORKS[@]}"; do
                                    # Get containers attached to this network.
                                    # An inspect that fails used to read as "no
                                    # containers attached", so nothing was
                                    # stopped and the network removal below then
                                    # failed for a reason the user never saw.
                                    if ! containers=$(docker network inspect "$net" --format '{{range .Containers}}{{.Name}} {{end}}' 2>&1); then
                                        echo "    ⚠ Could not inspect $net — its containers were NOT stopped: $containers"
                                        containers=""
                                    fi
                                    if [[ -n "$containers" ]]; then
                                        echo "  Stopping containers on $net: $containers"
                                        read -ra _ctrs <<< "$containers"
                                        if ! docker stop "${_ctrs[@]}" >/dev/null 2>/dev/null; then
                                            echo "    ⚠ Some containers could not be stopped (continuing)"
                                        fi
                                    fi
                                    echo "  Removing network: $net"
                                    docker network rm "$net" 2>/dev/null && echo "    ✓ Removed" || echo "    ⚠ Could not remove (may still have containers)"
                                done
                                break
                                ;;
                            b|B)
                                echo "Stopping all Docker containers..."
                                if ! docker ps -q | xargs -r docker stop >/dev/null 2>/dev/null; then
                                    echo "  ⚠ Some containers could not be stopped (continuing)"
                                fi
                                echo "Pruning all unused Docker networks..."
                                docker network prune -f
                                echo "✓ Docker networks pruned"
                                break
                                ;;
                            *)
                                echo "Invalid choice. Please enter a or b"
                                echo ""
                                ;;
                        esac
                    done
                    echo ""

                    # Now offer to start podman-compose
                    COMPOSE_FILES_FOUND=()
                    for pattern in "docker-compose.yml" "docker-compose.yaml" "podman-compose.yml" "podman-compose.yaml" "compose.yml" "compose.yaml"; do
                        if [ -f "$pattern" ]; then
                            COMPOSE_FILES_FOUND+=("$pattern")
                        fi
                    done

                    if [ ${#COMPOSE_FILES_FOUND[@]} -gt 0 ]; then
                        echo "────────────────────────────────────────────────────────────────────────────────"
                        echo "Start Podman Compose Services"
                        echo "────────────────────────────────────────────────────────────────────────────────"
                        echo ""
                        echo "Found compose files:"
                        for cf in "${COMPOSE_FILES_FOUND[@]}"; do
                            echo "  • $cf"
                        done
                        echo ""

                        if command -v podman-compose &>/dev/null; then
                            while true; do
                                read -rp "$CCY_PROMPT_COMPOSE_START podman-compose up -d? [Y/n]: " start_compose
                                start_compose=${start_compose:-Y}
                                echo ""

                                case "$start_compose" in
                                    Y|y|Yes|yes)
                                        echo "Starting podman-compose..."
                                        if podman-compose up -d; then
                                            echo ""
                                            echo "✓ Compose services started"
                                            echo ""
                                            # Track for session-end teardown offer
                                            export CCY_COMPOSE_WAS_STARTED=true
                                            export CCY_COMPOSE_CMD="podman-compose"
                                            echo "Waiting for networks..."
                                            sleep 2

                                            # Re-scan for Podman networks
                                            MATCHING_NETWORKS=()
                                            while IFS= read -r net; do
                                                if [[ "$net" != "bridge" ]] && [[ "$net" != "host" ]] && [[ "$net" != "none" ]] && [[ "$net" != "podman" ]]; then
                                                    if [[ "$net" == *"$PROJECT_NAME"* ]]; then
                                                        MATCHING_NETWORKS+=("$net")
                                                    fi
                                                fi
                                            done < <(podman network ls --format "{{.Name}}" 2>/dev/null)

                                            if [ ${#MATCHING_NETWORKS[@]} -gt 0 ]; then
                                                AUTO_CONNECT_NETWORK="${MATCHING_NETWORKS[0]}"
                                                NETWORK_FLAG="--network $AUTO_CONNECT_NETWORK"
                                                echo "✓ Found network: $AUTO_CONNECT_NETWORK"
                                                echo "✓ CCY will connect to this network"
                                                CROSS_ENGINE_MISMATCH=false  # Resolved!
                                            fi
                                            COMPOSE_ALREADY_HANDLED=true
                                        else
                                            echo "⚠ podman-compose failed. Check errors above."
                                            COMPOSE_ALREADY_HANDLED=true
                                        fi
                                        break
                                        ;;
                                    N|n|No|no)
                                        echo "Skipping compose startup"
                                        echo "Run 'podman-compose up -d' manually when ready"
                                        COMPOSE_ALREADY_HANDLED=true
                                        break
                                        ;;
                                    *)
                                        echo "Invalid choice. Please enter y or n"
                                        echo ""
                                        ;;
                                esac
                            done
                        else
                            echo "⚠ podman-compose not installed"
                            echo ""
                            echo "Install with:"
                            echo "  pip install podman-compose"
                            echo "  # Or: ansible-playbook playbooks/imports/optional/common/play-podman.yml"
                            echo ""
                            echo "Then run: podman-compose up -d"
                            COMPOSE_ALREADY_HANDLED=true
                        fi
                    else
                        COMPOSE_ALREADY_HANDLED=true  # No compose files found, mark as handled
                    fi
                    echo "────────────────────────────────────────────────────────────────────────────────"
                    break
                    ;;
                2)
                    echo "To use Docker instead, run:"
                    echo "  export CCY_CONTAINER_ENGINE=docker"
                    echo "  ccy"
                    echo ""
                    echo "Or add to ~/.bashrc:"
                    echo "  export CCY_CONTAINER_ENGINE=docker"
                    exit 0
                    ;;
                3)
                    echo "Continuing without network connection..."
                    COMPOSE_ALREADY_HANDLED=true
                    break
                    ;;
                4)
                    echo "Cancelled."
                    exit 0
                    ;;
                *)
                    echo "Invalid choice. Please enter 1-4"
                    echo ""
                    ;;
            esac
        done

        # Show tip about stopping Docker daemon (informational only)
        if [[ "$cleanup_choice" == "1" ]]; then
            echo ""
            echo "TIP: If you've fully switched to Podman, you can free resources by stopping Docker:"
            echo "  systemctl --user stop docker.socket docker.service"
            echo "  # Or disable permanently: systemctl --user disable --now docker.socket docker.service"
            echo ""
        fi
    else
        # CCY using Docker, but networks found in Podman
        echo "CCY is configured to use Docker, but project networks exist in Podman:"
        echo ""
        for net in "${PODMAN_NETWORKS[@]}"; do
            echo "  • $net (Podman only)"
        done
        echo ""
        echo "Problem:"
        echo "  • Docker and Podman have separate network namespaces"
        echo "  • CCY (using Docker) cannot see Podman networks"
        echo "  • Your compose setup is using Podman"
        echo ""
        echo "Choose one solution (both are valid):"
        echo ""
        echo "OPTION 1: Switch CCY to use Podman (match your compose setup)"
        echo ""
        echo "  • Remove CCY_CONTAINER_ENGINE override (defaults to Podman):"
        echo "    unset CCY_CONTAINER_ENGINE"
        echo "    ccy"
        echo ""
        echo "OPTION 2: Switch compose to use Docker (match CCY setting)"
        echo ""
        echo "  • Install Docker:"
        echo "    ansible-playbook playbooks/imports/optional/common/play-docker.yml"
        echo ""
        echo "  • Update your compose setup to use docker-compose"
        echo "  • Recreate networks with Docker"
        echo ""

        echo "════════════════════════════════════════════════════════════════════════════════"
        echo ""

        while true; do
            read -rp "$CCY_PROMPT_NETWORK_CONTINUE " mismatch_choice
            mismatch_choice=${mismatch_choice:-Y}
            echo ""

            case "$mismatch_choice" in
                Y|y|Yes|yes)
                    echo "Continuing without network connection..."
                    echo "Fix the mismatch and restart CCY to connect to project networks."
                    echo ""
                    break
                    ;;
                N|n|No|no)
                    echo "Cancelled. Fix the container engine mismatch first."
                    exit 0
                    ;;
                *)
                    echo "Invalid choice. Please enter Y or n"
                    echo ""
                    ;;
            esac
        done
    fi
fi

# Only prompt for network if we don't already have a persisted preference
if [ ${#MATCHING_NETWORKS[@]} -gt 0 ] && [ -z "$SPECIFIED_NETWORK" ]; then
    echo ""
    echo "════════════════════════════════════════════════════════════════════════════════"
    echo "Docker Network Auto-Detection"
    echo "════════════════════════════════════════════════════════════════════════════════"
    echo ""

    if [ ${#MATCHING_NETWORKS[@]} -eq 1 ]; then
        # Single match - offer to connect
        AUTO_CONNECT_NETWORK="${MATCHING_NETWORKS[0]}"
        echo "Found network: $AUTO_CONNECT_NETWORK"
        echo ""

        while true; do
            read -rp "$CCY_PROMPT_NETWORK_CONNECT (Y/n): " connect_choice
            connect_choice=${connect_choice:-Y}  # Default to Yes
            echo ""

            case "$connect_choice" in
                Y|y|Yes|yes)
                    # Check if services are running before connecting
                    if check_and_start_compose_services "$AUTO_CONNECT_NETWORK" "$PROJECT_NAME"; then
                        NETWORK_FLAG="--network $AUTO_CONNECT_NETWORK"
                        echo "✓ Will connect to: $AUTO_CONNECT_NETWORK"
                    else
                        echo "⚠  Continuing without network (no services running)"
                        AUTO_CONNECT_NETWORK=""
                    fi
                    break
                    ;;
                N|n|No|no)
                    echo "Skipping network connection"
                    echo "Use 'ccy --connect' later to connect manually"
                    break
                    ;;
                *)
                    echo "Invalid choice. Please enter Y or n"
                    echo ""
                    ;;
            esac
        done
    else
        # Multiple matches - default to first, offer choice
        AUTO_CONNECT_NETWORK="${MATCHING_NETWORKS[0]}"
        echo "Found ${#MATCHING_NETWORKS[@]} matching networks"
        echo "Best match: $AUTO_CONNECT_NETWORK"
        echo ""

        while true; do
            read -rp "$CCY_PROMPT_NETWORK_CONNECT (Y/n/list): " connect_choice
            connect_choice=${connect_choice:-Y}
            echo ""

            case "$connect_choice" in
                Y|y|Yes|yes)
                    # Check if services are running before connecting
                    if check_and_start_compose_services "$AUTO_CONNECT_NETWORK" "$PROJECT_NAME"; then
                        NETWORK_FLAG="--network $AUTO_CONNECT_NETWORK"
                        echo "✓ Will connect to: $AUTO_CONNECT_NETWORK"
                    else
                        echo "⚠  Continuing without network (no services running)"
                        AUTO_CONNECT_NETWORK=""
                    fi
                    break
                    ;;
                N|n|No|no)
                    echo "Skipping network connection"
                    echo "Use 'ccy --connect' later to connect manually"
                    AUTO_CONNECT_NETWORK=""
                    break
                    ;;
                list|l|List|L)
                    # Show full menu
                    echo "Available networks:"
                    echo ""
                    echo "  0) Don't connect"
                    for i in "${!MATCHING_NETWORKS[@]}"; do
                        echo "  $((i+1))) ${MATCHING_NETWORKS[$i]}"
                    done
                    echo ""

                    while true; do
                        read -rp "${CCY_PROMPT_NETWORK_PICK}${#MATCHING_NETWORKS[@]}]: " net_choice
                        echo ""

                        if [ "$net_choice" = "0" ]; then
                            echo "Skipping network connection"
                            AUTO_CONNECT_NETWORK=""
                            break 2
                        elif [ "$net_choice" -ge 1 ] && [ "$net_choice" -le ${#MATCHING_NETWORKS[@]} ] 2>/dev/null; then
                            AUTO_CONNECT_NETWORK="${MATCHING_NETWORKS[$((net_choice-1))]}"
                            # Check if services are running before connecting
                            if check_and_start_compose_services "$AUTO_CONNECT_NETWORK" "$PROJECT_NAME"; then
                                NETWORK_FLAG="--network $AUTO_CONNECT_NETWORK"
                                echo "✓ Will connect to: $AUTO_CONNECT_NETWORK"
                            else
                                echo "⚠  Continuing without network (no services running)"
                                AUTO_CONNECT_NETWORK=""
                            fi
                            break 2
                        else
                            echo "Invalid selection: $net_choice"
                            echo "Please enter 0-${#MATCHING_NETWORKS[@]}"
                            echo ""
                        fi
                    done
                    ;;
                *)
                    echo "Invalid choice. Please enter Y, n, or 'list'"
                    echo ""
                    ;;
            esac
        done
    fi

    echo "════════════════════════════════════════════════════════════════════════════════"
    echo ""
else
    # No matching networks - offer to connect to ANY available network
    ALL_NETWORKS=()
    # No PODMAN_DEFAULT_DETECTED flag: it was assigned here and in the loop, and
    # never read anywhere, so the inner `if` existed only to set it.
    while IFS= read -r net; do
        # Skip default networks
        if [[ "$net" != "bridge" ]] && [[ "$net" != "host" ]] && [[ "$net" != "none" ]]; then
            ALL_NETWORKS+=("$net")
        fi
    done < <(container_cmd network ls --format "{{.Name}}" 2>/dev/null)

    # Check for compose files if no matching network found (and not already handled)
    if [ ${#MATCHING_NETWORKS[@]} -eq 0 ] && [ -z "$SPECIFIED_NETWORK" ] && [ "$COMPOSE_ALREADY_HANDLED" != "true" ]; then
        # Scan for compose files in project root
        COMPOSE_FILES_FOUND=()
        for pattern in "docker-compose.yml" "docker-compose.yaml" "podman-compose.yml" "podman-compose.yaml" "compose.yml" "compose.yaml"; do
            if [ -f "$pattern" ]; then
                COMPOSE_FILES_FOUND+=("$pattern")
            fi
        done

        if [ ${#COMPOSE_FILES_FOUND[@]} -gt 0 ]; then
            echo ""
            echo "════════════════════════════════════════════════════════════════════════════════"
            echo "Compose Files Detected"
            echo "════════════════════════════════════════════════════════════════════════════════"
            echo ""
            echo "Found compose files but no matching project networks are running:"
            for cf in "${COMPOSE_FILES_FOUND[@]}"; do
                echo "  • $cf"
            done
            echo ""
            echo "Would you like to start the compose services?"
            echo ""

            # Determine compose command based on engine
            COMPOSE_CMD=""
            if [[ "$CONTAINER_ENGINE" = "podman" ]]; then
                if command -v podman-compose &>/dev/null; then
                    COMPOSE_CMD="podman-compose"
                else
                    echo "Note: podman-compose not installed. Install with:"
                    echo "  pip install podman-compose"
                    echo ""
                fi
            else
                if command -v docker-compose &>/dev/null; then
                    COMPOSE_CMD="docker-compose"
                elif command -v docker &>/dev/null && docker compose version &>/dev/null 2>&1; then
                    COMPOSE_CMD="docker compose"
                fi
            fi

            if [ -n "$COMPOSE_CMD" ]; then
                while true; do
                    read -rp "$CCY_PROMPT_COMPOSE_START_SAVED ($COMPOSE_CMD up -d) [y/N] " start_compose
                    start_compose=${start_compose:-N}
                    echo ""

                    case "$start_compose" in
                        Y|y|Yes|yes)
                            echo "Starting compose services..."
                            if $COMPOSE_CMD up -d; then
                                echo ""
                                echo "✓ Compose services started"
                                echo ""
                                echo "Waiting for networks to be created..."
                                sleep 2

                                # Re-scan for networks
                                MATCHING_NETWORKS=()
                                while IFS= read -r net; do
                                    if [[ "$net" != "bridge" ]] && [[ "$net" != "host" ]] && [[ "$net" != "none" ]] && [[ "$net" != "podman" ]]; then
                                        if [[ "$net" == *"$PROJECT_NAME"* ]]; then
                                            MATCHING_NETWORKS+=("$net")
                                        fi
                                    fi
                                done < <(container_cmd network ls --format "{{.Name}}" 2>/dev/null)

                                if [ ${#MATCHING_NETWORKS[@]} -gt 0 ]; then
                                    AUTO_CONNECT_NETWORK="${MATCHING_NETWORKS[0]}"
                                    NETWORK_FLAG="--network $AUTO_CONNECT_NETWORK"
                                    echo "✓ Found network: $AUTO_CONNECT_NETWORK"
                                    echo "✓ Will connect CCY to this network"
                                fi
                            else
                                echo ""
                                echo "⚠ Compose failed to start. Check errors above."
                            fi
                            break
                            ;;
                        N|n|No|no|"")
                            echo "Skipping compose startup"
                            break
                            ;;
                        *)
                            echo "Invalid choice. Please enter y or n"
                            echo ""
                            ;;
                    esac
                done
            fi
            echo "════════════════════════════════════════════════════════════════════════════════"
            echo ""
        else
            # No compose files - show info message
            if [ ${#ALL_NETWORKS[@]} -gt 0 ]; then
                echo ""
                echo "No network found matching project name: $PROJECT_NAME"
                echo ""
                echo "Suggested network names:"
                echo "  • ${PROJECT_NAME}-network (folder name)"

                # Show parent-folder-repo-folder option if parent is not generic
                PARENT_FOLDER=$(basename "$(dirname "$PWD")")
                GENERIC_FOLDERS="projects|repos|work|src|code|dev|home"
                if ! echo "$PARENT_FOLDER" | grep -qiE "^($GENERIC_FOLDERS)$"; then
                    echo "  • ${PARENT_FOLDER}-${PROJECT_NAME}-network (parent-folder-repo)"
                fi

                echo ""
                echo "To connect to a network:"
                echo "  • Create: $CONTAINER_ENGINE network create ${PROJECT_NAME}-network"
                echo "  • Connect: ccy --network ${PROJECT_NAME}-network"
                echo "  • Or use: ccy --connect (interactive selection)"
                echo ""
            fi
        fi
    fi
    fi  # End of if [[ -z "$SPECIFIED_NETWORK" ]] (persisted network check)
fi
fi  # End of network flag handling (if/elif/else)

# Network Strategy: Use requested network but verify it has internet access
# =========================================================================
# Claude Code requires internet to communicate with Anthropic's API.
# Fail fast if the selected network doesn't have internet routing.

# Determine which network to use
if [[ -n "$NETWORK_FLAG" ]]; then
    SELECTED_NETWORK="${NETWORK_FLAG#--network }"
elif [[ "$CONTAINER_ENGINE" = "podman" ]] && [[ "$NO_NETWORK_MODE" != true ]]; then
    SELECTED_NETWORK="podman"
    NETWORK_FLAG="--network podman"
fi

# Ensure network has DNS servers configured (fixes WARP/localhost DNS issues)
if [[ -n "$SELECTED_NETWORK" ]] && [[ "$NO_NETWORK_MODE" != true ]]; then
    ensure_network_dns "$SELECTED_NETWORK"
fi

# Verify network has internet access (fail fast)
#
# Skippable via CCY_SKIP_NETWORK_PREFLIGHT=1 — for a caller that has already proved its own
# network's egress by some other means (e.g. a fenced CI runner whose provisioning asserts the
# allowlist before ever invoking ccy) and does not want this check's own two requirements: an
# unpinned `alpine` pull and plain-http reachability to google.com, neither of which such a
# runner necessarily allows. Same idiom as CCY_SKIP_TOKEN_OWNER_CHECK (lib/ssh-handling.bash) —
# an explicit, named opt-out for a specific preflight, not a general "trust me" switch.
if [[ -n "${CCY_SKIP_NETWORK_PREFLIGHT:-}" ]]; then
    echo "✓ Network preflight skipped (CCY_SKIP_NETWORK_PREFLIGHT set)"
    echo ""
elif [[ -n "$SELECTED_NETWORK" ]] && [[ "$NO_NETWORK_MODE" != true ]]; then
    echo "Verifying network '$SELECTED_NETWORK' has internet access..."

    # Test with google.com (simpler, more reliable than api.anthropic.com which needs proper TLS)
    if container_cmd run --rm --network "$SELECTED_NETWORK" alpine wget -q -O- --timeout=10 http://google.com >/dev/null 2>&1; then
        echo "✓ Network '$SELECTED_NETWORK' has internet access"
        echo ""
    else
        echo ""
        echo "════════════════════════════════════════════════════════════════════════════════"
        echo "❌ NETWORK ERROR: '$SELECTED_NETWORK' has no internet access"
        echo "════════════════════════════════════════════════════════════════════════════════"
        echo ""
        echo "Claude Code requires internet to communicate with Anthropic's API."
        echo ""

        # Scan for compose files and check for common issues
        COMPOSE_FILES=$(find . -maxdepth 2 -name "*compose*.yml" -o -name "*compose*.yaml" 2>/dev/null)  # FAIL-FAST-OK: empty means "no compose files here", which the -n check below reads as nothing to scan
        FOUND_ISSUES=false

        if [[ -n "$COMPOSE_FILES" ]]; then
            echo "Scanning compose files for common network issues..."
            echo ""

            for compose_file in $COMPOSE_FILES; do
                # Check for driver: bridge (breaks rootless podman)
                if grep -q "driver:\s*bridge" "$compose_file" 2>/dev/null; then
                    echo "  ⚠  $compose_file: Found 'driver: bridge'"
                    echo "     Rootless podman cannot create NAT rules for bridge networks."
                    echo "     FIX: Remove 'driver: bridge' from the networks section."
                    echo ""
                    FOUND_ISSUES=true
                fi

                # Check for internal: true
                if grep -q "internal:\s*true" "$compose_file" 2>/dev/null; then
                    echo "  ⚠  $compose_file: Found 'internal: true'"
                    echo "     Internal networks have no external connectivity by design."
                    echo "     FIX: Remove 'internal: true' or set to 'internal: false'."
                    echo ""
                    FOUND_ISSUES=true
                fi
            done
        fi

        if [[ "$FOUND_ISSUES" = false ]]; then
            echo "No obvious issues found in compose files."
            echo ""
        fi

        echo "────────────────────────────────────────────────────────────────────────────────"
        echo "Debugging steps:"
        echo "────────────────────────────────────────────────────────────────────────────────"
        echo ""
        echo "  1. Test the network manually:"
        echo "     podman run --rm --network $SELECTED_NETWORK alpine wget -q -O- --timeout=5 http://google.com"
        echo ""
        echo "  2. Check if rootless podman is using pasta (expected):"
        echo "     podman info | grep rootlessNetworkCmd"
        echo ""
        echo "  3. Recreate the network:"
        echo "     podman-compose down"
        echo "     podman network rm $SELECTED_NETWORK"
        echo "     podman-compose up -d"
        echo ""
        echo "  4. Use default podman network instead:"
        echo "     ccy --network podman"
        echo ""
        echo "  5. Check network config:"
        echo "     podman network inspect $SELECTED_NETWORK | grep -E 'internal|driver'"
        echo ""
        echo "  6. Skip this check entirely if you already know the network works — e.g. a"
        echo "     fenced CI runner that proves its own egress before ever calling ccy:"
        echo "     CCY_SKIP_NETWORK_PREFLIGHT=1 ccy"
        echo ""
        echo "════════════════════════════════════════════════════════════════════════════════"
        exit 1
    fi
fi

# Display command preview box and save configuration
# Extract token name from selected token file
TOKEN_NAME_FOR_CONFIG=""
if [[ -n "$SELECTED_TOKEN" ]]; then
    filename=$(basename "$SELECTED_TOKEN")
    TOKEN_NAME_FOR_CONFIG="${filename%.*.token}"
fi

# Build SSH keys string for config
SSH_KEYS_STR="${SSH_KEYS[*]}"

# Save configuration for next launch
save_launch_config ".claude/ccy" "$TOKEN_NAME_FOR_CONFIG" "$SSH_KEYS_STR" "$AUTO_CONNECT_NETWORK"
echo "✓ Configuration saved for quick launch next time"
echo "✓ CCY version: $CCY_VERSION"
echo ""

# Determine container name with appropriate suffix
CONTAINER_NAME=$(get_next_container_name "$PROJECT_NAME" "yolo")
echo "Container name: $CONTAINER_NAME"
echo ""

# Build Claude Code command arguments based on flags
CLAUDE_CMD_ARGS=()

if [ "$HEADLESS_MODE" = true ]; then
    # Headless mode: use -p flag
    CLAUDE_CMD_ARGS+=("-p" "$PROMPT_TEXT")
elif [ -n "$PROMPT_TEXT" ]; then
    # Interactive mode with prompt: pass prompt as argument
    CLAUDE_CMD_ARGS+=("$PROMPT_TEXT")
elif [ ${#CLAUDE_ARGS[@]} -eq 0 ]; then
    # No user arguments - pass startup info via system prompt instead of user message
    # This prevents informational messages from triggering Claude thinking
    STARTUP_INFO_FILE="/opt/claude-yolo/ccy-startup-info.txt"
    if [ ! -f "$STARTUP_INFO_FILE" ]; then
        print_error "Startup info file not found: $STARTUP_INFO_FILE"
        exit 1
    fi
    # Read startup info and pass to Claude via --append-system-prompt
    # Replace placeholder with actual container engine (title case)
    CONTAINER_ENGINE_TITLE="${CONTAINER_ENGINE^}"
    STARTUP_INFO=$(sed "s/__CONTAINER_ENGINE__/${CONTAINER_ENGINE_TITLE}/" "$STARTUP_INFO_FILE")

    # Show tip about custom Dockerfile if not using one (custom Dockerfile info shown earlier in header)
    if [ ! -f ".claude/ccy/Dockerfile" ]; then
        # No custom Dockerfile - show helpful tip
        echo "
💡 TIP: This project doesn't have a custom Dockerfile yet!

You can create one to add project-specific tools (Python, Go, Rust, databases, cloud CLIs, etc.):
  • Quick setup: Exit and run 'ccy --custom' (template-based, fast)
  • AI-guided: Exit and run 'ccy --custom-docker' (investigates project, asks questions, proposes features)

Custom Dockerfiles get cached per-project and rebuild automatically when changed.
More info: https://github.com/LongTermSupport/fedora-desktop/blob/main/docs/containerization.md#custom-dockerfiles"
    fi
    echo ""

    # Also add Dockerfile info to system prompt for Claude
    if [ -f ".claude/ccy/Dockerfile" ]; then
        STARTUP_INFO+="

✅ Custom Dockerfile detected: .claude/ccy/Dockerfile

This project uses a custom container image with project-specific tools.
The container will automatically rebuild if the Dockerfile changes.

To modify: 'ccy --custom-docker' (AI-guided) or 'ccy --custom' (quick edit)"
    else
        STARTUP_INFO+="

💡 TIP: This project doesn't have a custom Dockerfile yet!

You can create one to add project-specific tools (Python, Go, Rust, databases, cloud CLIs, etc.):
  • Quick setup: Exit and run 'ccy --custom' (template-based, fast)
  • AI-guided: Exit and run 'ccy --custom-docker' (investigates project, asks questions, proposes features)

Custom Dockerfiles get cached per-project and rebuild automatically when changed.
More info: https://github.com/LongTermSupport/fedora-desktop/blob/main/docs/containerization.md#custom-dockerfiles"
    fi

    CLAUDE_CMD_ARGS+=("--append-system-prompt" "$STARTUP_INFO")
fi

# Add any other arguments passed through
CLAUDE_CMD_ARGS+=("${CLAUDE_ARGS[@]}")

# Add --debug flag to Claude Code if DEBUG_CLAUDE is enabled
if [ "$DEBUG_CLAUDE" = true ]; then
    CLAUDE_CMD_ARGS+=("--debug")
fi

# Use -it for interactive, -i only for headless (no TTY required)
if [ "$HEADLESS_MODE" = true ]; then
    DOCKER_FLAGS="-i"
else
    DOCKER_FLAGS="-it"
fi

# Add GUI support for browser windows
# Detect Wayland or X11 and mount appropriate display socket
GUI_MOUNTS=()
if [ -n "$WAYLAND_DISPLAY" ]; then
    # SEC-03/CCY-02: mount ONLY the Wayland display socket (read-only), never the
    # whole $XDG_RUNTIME_DIR. That directory also holds the D-Bus session bus,
    # PipeWire/Pulse, and gnome-keyring sockets — bind-mounting all of it would
    # hand a --dangerously-skip-permissions agent the host session bus and
    # keyring, defeating the isolation CCY exists to provide. Only the socket is
    # needed to render browser windows.
    _wayland_socket="$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY"
    if [ -S "$_wayland_socket" ]; then
        GUI_MOUNTS+=(
            "-v" "$_wayland_socket:$_wayland_socket:ro"
            "-e" "WAYLAND_DISPLAY=$WAYLAND_DISPLAY"
            "-e" "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR"
            "-e" "DISPLAY=:0"
        )
    else
        debug "Wayland socket not found at $_wayland_socket — skipping GUI mount"
    fi
elif [ -n "$DISPLAY" ]; then
    GUI_MOUNTS+=(
        "-v" "/tmp/.X11-unix:/tmp/.X11-unix:ro"
        "-e" "DISPLAY=$DISPLAY"
    )
fi

# GPU render nodes for hardware-accelerated browser rendering — only where the host has any.
# A headless server has no /dev/dri, and podman aborts the run on a --device that does not
# exist (gpu_device_flags in lib/common-pure.bash says why and is where this is tested).
GPU_DEVICE_FLAGS=()
mapfile -t GPU_DEVICE_FLAGS < <(gpu_device_flags /dev/dri)
if [ "${#GPU_DEVICE_FLAGS[@]}" -eq 0 ]; then
    debug "No /dev/dri on this host — no GPU passed to the container; browser rendering is software-only"
fi

# Every launch-time prompt is behind us: a restart gets its terminal back for the session
# itself (stdin was /dev/null since ccy_restart_marker_take).
if [ -n "$CCY_RESTART_RELAUNCH_SESSION" ]; then
    exec <&"$CCY_RESTART_TTY_FD" {CCY_RESTART_TTY_FD}<&-
fi

# Disable CTRL+Z (suspend) for this terminal session. Inside a CCY container
# there is no way to foreground a backgrounded podman process, so it only
# causes lost work. Saved state is restored in cleanup() on exit.
if [[ -t 0 ]]; then
    _CCY_STTY_SAVED=$(stty -g)
    stty susp undef
fi

# Show the exact command that will be executed (for debugging)
echo "════════════════════════════════════════════════════════════════════════════════"
echo "Executing Claude Code with arguments:"
echo "  claude --dangerously-skip-permissions ${CLAUDE_CMD_ARGS[*]}"
echo "════════════════════════════════════════════════════════════════════════════════"
echo ""

# Safety net: remove any leftover container with this name
# Handles "external entity" edge case where container storage has the name
# but ps -a doesn't show it (e.g., after unclean shutdown with corrupt state)
if container_cmd rm -f "$CONTAINER_NAME" 2>&1 | grep -q "$CONTAINER_NAME"; then
    echo "Removed leftover container: $CONTAINER_NAME"
fi

# BSH-09: pass the two secrets by env NAME (-e VAR, no '=value') so the token
# values are taken from this process's environment and never appear in the
# `podman run` argv (world-readable via /proc/<pid>/cmdline for the lifetime of
# this long-lived interactive process). GITHUB_USERNAME is not a secret and stays
# inline for clarity.
export CLAUDE_CODE_OAUTH_TOKEN="$CLAUDE_OAUTH_TOKEN"
export GH_TOKEN

# Supervisor wrap. The BASELINE is now decided in-container by entrypoint.sh,
# which turns the project supervisor on by default whenever one is present (CCY
# 3.42.0 — it is the only ctrl+z guard left). Nothing needs forwarding for that.
#
# The two flags here are the explicit overrides, and each beats that default:
#   --supervise     force it on and ARMED (real /compact injection), which the
#                   in-container default deliberately does not do.
#   --no-supervise  force it off entirely, ctrl+z guard included.
#
# A host export of CCY_CLAUDE_WRAPPER still outranks --supervise, so an operator
# can point the wrap at something else without editing this script.
#
# The old default was the bare command `claude-supervise`, which is not on PATH
# in the image and never was (fedora-desktop issue #31) — so --supervise could
# only ever fail at exec. It now names the real, git-tracked supervisor the
# hooks daemon deploys into the project, invoked through python3 so a missing
# exec bit cannot break it.
if [ "$SUPERVISE_MODE" = true ] && [ "$NO_SUPERVISE_MODE" = true ]; then
    print_error "--supervise and --no-supervise are mutually exclusive"
    exit 1
fi
if [ "$SUPERVISE_MODE" = true ]; then
    CCY_CLAUDE_WRAPPER="${CCY_CLAUDE_WRAPPER:-python3 /workspace/.claude/ccy/claude-supervise.py --arm --}"
fi
CCY_NO_SUPERVISOR=""
if [ "$NO_SUPERVISE_MODE" = true ]; then
    CCY_NO_SUPERVISOR=1
fi

# Sub-agent fan-out: CCY sets NO limits here, deliberately. Claude Code's
# cumulative session-lifetime cap (CLAUDE_CODE_MAX_SUBAGENTS_PER_SESSION,
# default 200) was the one dial that false-limited long autonomous sessions —
# it counted spawns over the whole life of a session rather than concurrent
# ones, so hours of ordinary delegation exhausted it mid-task. Upstream removed
# it in Claude Code 2.1.224 ("long-running sessions no longer refuse new
# agents"), and CCY tracks @latest, so forwarding it here would be dead config.
# The surviving dials — CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS (default 20) and
# CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH (default 3) — bound instantaneous load
# and recursion depth, not longevity, so Claude Code's defaults stand. Tune them
# per project in .claude/ccy/ccy.env. See docs/ccy.md.
# --- run-time identity labels ------------------------------------------------
#
# ccy=true marks this container as a live CCY SESSION. The image already carries
# a claude-yolo-version label, but that is inherited by anything built FROM the
# CCY image, so it identifies a lineage rather than a session — `podfreeze --ccy`
# was observed selecting a CCY-derived throwaway that was no session at all. A
# run-time label cannot be inherited, so only a real session has these.
#
# The other four say WHICH session, along the axes a human actually groups by:
# the project, the GitHub identity, the Anthropic token, and the SSH key. That
# makes "freeze every session running as <github id>" a filter rather than a
# guess from container names. Nothing in the container reads them; they exist
# for host-side tooling (podman ps --filter label=ccy-github=<id>).
#
# "none" rather than an empty value, so "this session has no GitHub identity" is
# stated rather than looking like an unlabelled container. ccy-ssh-keys holds
# basenames, space-separated, because more than one key can be mounted — consumers
# word-match it rather than comparing the whole value.
# See CLAUDE/Plan/00079-podman-container-control (F16, D6, D8).
CCY_LABEL_GITHUB="${GITHUB_USERNAME:-none}"
CCY_LABEL_TOKEN="${TOKEN_NAME_FOR_CONFIG:-none}"
CCY_LABEL_SSH_KEYS="none"
if [ "${#SSH_KEYS[@]}" -gt 0 ]; then
    ccy_key_basenames=()
    for ccy_key in "${SSH_KEYS[@]}"; do
        ccy_key_basenames+=("$(basename "$ccy_key")")
    done
    CCY_LABEL_SSH_KEYS="${ccy_key_basenames[*]}"
fi

# --- which MACHINE this session is running on --------------------------------
#
# A container's own HOSTNAME is the short container id podman assigns it, so nothing inside
# can tell one host from another. CCY_HOST_HOSTNAME carries the host's name in, under a
# distinct name: HOSTNAME is deliberately NOT shadowed, because a process that wants the
# container id must keep being able to read it.
#
# Derivation and grammar live in ccy_host_hostname (lib/common-pure.bash), where they are
# unit-tested. A failure here aborts: an absent CCY_HOST_HOSTNAME is indistinguishable from
# "the launcher is too old to set it", so a consumer could not tell a broken host from an
# old one, and silently starting without it would make that ambiguity permanent.
if ! CCY_HOST_HOSTNAME="$(ccy_host_hostname "$(uname -n)")"; then
    print_error "Could not derive the host hostname from 'uname -n' — see the reason above."
    exit 1
fi

# --- a restart requested by the session supervisor --------------------------
#
# Claude Code is baked into the image, so a session that should pick up a newer version (the
# supervisor's max-age plugin, for one) cannot restart inside its container. The supervisor
# types /exit, writes .claude/ccy/state/restart-request.json and exits 75; the container ends
# and this function, on the host, decides what that meant. See lib/restart-request.bash for
# the contract and for why the file is treated as untrusted input.
#
# Returns 0 when the exit was NOT an acted-on restart, so the caller carries on exactly as it
# always did with a container's exit status. When it is one it does not return: it execs a
# fresh launcher. Anything that stops the restart from happening exits non-zero with the
# reason on stderr; it never falls back to relaunching on an old image or a guessed session.
ccy_handle_restart_exit() {
    local request_file="$PWD/$CCY_RESTART_REQUEST_REL"
    local session_id="" read_rc=0
    session_id=$(ccy_restart_request_read "$request_file") || read_rc=$?
    case "$read_rc" in
    0) ;;
    2)
        echo "The container exited with status $CCY_RESTART_EXIT_STATUS but left no restart request at $CCY_RESTART_REQUEST_REL, so this is not a restart. Exiting with that status." >&2
        return 0
        ;;
    *)
        ccy_restart_request_discard "$request_file" || exit 1
        echo "The container exited with status $CCY_RESTART_EXIT_STATUS with an unusable restart request (discarded), so this is not a restart. Exiting with that status." >&2
        return 0
        ;;
    esac

    # Consume the request before acting on it: whatever happens next, it cannot loop.
    ccy_restart_request_discard "$request_file" || exit 1

    # The relaunch runs with nobody at the keyboard. A key passphrase is the one choice its
    # arguments cannot carry, so a key that needs one stops the restart here, before the
    # budget and an image update are spent on a launch that would wait at ssh-add.
    if ! ccy_restart_keys_unattended "$RESTORE_SSH_PASSPHRASE_FILE" "${SSH_KEYS[@]}"; then
        ccy_restart_refuse "$session_id" "the relaunch would wait at an SSH passphrase prompt; an SSH_ASKPASS unlock needs someone present too. For unattended restarts load the key into your ssh-agent (ssh-add), which ccy then forwards as that one key, or launch with a key that has no passphrase (docs/ccy.md)."
        exit 1
    fi

    # The choices this session RAN with (a prompt's answer is in no argument), then the rest of
    # its arguments with those choices taken out. Built before anything is spent on the
    # restart. A process substitution's status is not seen by mapfile, so each builder's is
    # read with `wait`: one that stopped part way could otherwise leave an argv that looks whole.
    local choice_args=() relaunch_args=() builder_rc=0
    mapfile -d '' -t choice_args < <(ccy_restart_choice_args "$SELECTED_TOKEN" \
        "${GITHUB_SSH_443:-0}" "$NO_NETWORK_MODE" "$AUTO_CONNECT_NETWORK" "${SSH_KEYS[@]}")
    wait "$!" || builder_rc=$?
    if [ "$builder_rc" -ne 0 ] || [ "${#choice_args[@]}" -eq 0 ]; then
        ccy_restart_refuse "$session_id" "could not work out the launch choices to relaunch with (see above)."
        exit 1
    fi
    mapfile -d '' -t relaunch_args < <(ccy_restart_relaunch_args "$session_id" "${CCY_ORIG_ARGS[@]}")
    wait "$!" || builder_rc=$?
    if [ "$builder_rc" -ne 0 ] || [ "${#relaunch_args[@]}" -eq 0 ]; then
        ccy_restart_refuse "$session_id" "could not build the relaunch arguments (see above)."
        exit 1
    fi

    local history_file
    if ! mkdir -p "$CCY_RESTART_HISTORY_DIR"; then
        ccy_restart_refuse "$session_id" "could not create the restart history directory $CCY_RESTART_HISTORY_DIR."
        exit 1
    fi
    history_file="$CCY_RESTART_HISTORY_DIR/$(printf '%s' "$PWD" | md5sum | cut -c1-16)"
    if ! ccy_restart_budget_take "$history_file" "$(date +%s)" \
        "${CCY_RESTART_MAX:-$CCY_RESTART_DEFAULT_MAX}" \
        "${CCY_RESTART_WINDOW_SECONDS:-$CCY_RESTART_DEFAULT_WINDOW_SECONDS}"; then
        ccy_restart_refuse "$session_id" "its restart budget is spent (see above)."
        exit 1
    fi

    echo "" >&2
    echo "Session $session_id asked to restart on a fresh container. Updating Claude Code in $IMAGE_NAME first..." >&2
    if ! update_claude_inplace "$IMAGE_NAME"; then
        print_error "Not restarting session $session_id: the image update failed (see above)."
        echo "  Resume it on the existing image: ccy --resume $session_id" >&2
        exit 1
    fi
    # The update just ran, so the relaunch has no reason to repeat the daily check.
    mkdir -p "$VERSION_CHECK_CACHE"
    touch "$VERSION_CHECK_CACHE/${IMAGE_NAME//[:\/]/_}"

    # A deadline is absolute and the relaunch drops --run-for/--until, so it travels in the
    # environment instead. --max-age stays in the arguments: its clock starts again.
    # restarted.json, written by the supervisor beside the request, is deliberately left
    # alone: the next supervisor consumes it to tell the resumed session what changed.
    if [ -n "${CCY_LIFECYCLE_DEADLINE_EPOCH:-}" ]; then
        export CCY_RELAUNCH_DEADLINE_EPOCH="$CCY_LIFECYCLE_DEADLINE_EPOCH"
    fi
    # The mark that makes the relaunch unattended (ccy_restart_marker_take), and a server
    # restore's passphrase file, which is a path; the passphrase never leaves that file.
    export CCY_RESTART_RELAUNCH="$session_id"
    if [ -n "$RESTORE_SSH_PASSPHRASE_FILE" ]; then
        export CCY_RESTORE_SSH_PASSPHRASE_FILE="$RESTORE_SSH_PASSPHRASE_FILE"
    fi
    # exec skips the EXIT trap, so this launch's staged key copies and temp config are
    # removed now rather than left behind.
    trap - EXIT
    cleanup
    # exec also hands over this launch's exported state. A staging directory the cleanup just
    # removed would stop the relaunch making its own (and its mount), so a key file could not
    # be staged on an SELinux-enforcing host; the token values are re-derived from the --token
    # file the relaunch is given. The compose pair stays: this session's stack was started by
    # the first launch, so the resumed session is the one to offer to stop it.
    unset CCY_KEY_STAGE_DIR CLAUDE_CODE_OAUTH_TOKEN GH_TOKEN
    echo "Relaunching session $session_id..." >&2
    exec "$SCRIPT_DIR/claude-yolo" "${choice_args[@]}" "${relaunch_args[@]}"
}

# A request file left by an earlier run must never be mistaken for this run's.
ccy_restart_request_discard "$PWD/$CCY_RESTART_REQUEST_REL" || exit 1

# Resolve a relative deadline against NOW, after every prompt, and give this container its
# launch id (lib/session-lifecycle.bash).
ccy_lifecycle_finalize || exit 1

# --- the auto-compact window ------------------------------------------------
#
# CLAUDE_CODE_AUTO_COMPACT_WINDOW caps how large a session grows before Claude Code
# summarises it. Upstream's recommended value is `auto`, which defers to the model's own
# context window and so imposes no cap at all; CCY deliberately overrides it with a fixed
# 600,000-token ceiling, which is a guard for the 1M-context models this workflow runs. Do
# not revert it back to `auto` as if it were an accident — it is a deliberate cost ceiling.
#
# WRITTEN IN FULL DIGITS, NOT `600k`. This variable has no suffix handling: it is parsed by
# the generic numeric helper shared with BASH_MAX_OUTPUT_LENGTH, so `600k` becomes 600, and
# the resolver then floors it at 100,000. 3.58.0 shipped the suffix and every session ran at
# a 100,000-token ceiling. The `auto`/`500k` grammar belongs to the /autocompact command, not
# here. Do not "tidy" this back to a suffix.
#
# The effective threshold is min(this value, the model's context window), and the variable
# beats the autoCompactWindow setting, so the window can no longer be changed from
# /autocompact, which reports the override instead of applying it.
# The ${VAR:-default} form below preserves both overrides: a host export before launch, and
# an `export` line in a project's .claude/ccy/ccy.env, which the entrypoint sources after
# this environment is in place. See docs/ccy.md.
#
# `set -e` would turn the container's exit status into this script's before the restart
# check below could look at it, so capture it. Any status other than 75 is passed straight
# through, as it always was.
#
# The agent team bus seats of a launch with --teams are taken here, as late as possible, so a
# seat is created (sudo agent-bus add-member) only for a launch that is about to start; a held
# seat or one that cannot be made stops it with agent-bus's code. With nobody to answer
# (headless, a restore, a restart) sudo never prompts. A plain launch calls nothing and its
# container gets no bus variable and no ccy-seats label (lib/agent-bus-seats.bash).
_ccy_seats_unattended="$CCY_UNATTENDED_LAUNCH"
[ "$HEADLESS_MODE" = true ] && _ccy_seats_unattended=true
ccy_seats_take "$CCY_SEATS" "$_ccy_seats_unattended" || exit $?
container_rc=0
container_cmd run $DOCKER_FLAGS --rm \
    --name "$CONTAINER_NAME" \
    --label ccy=true \
    --label "ccy-project=$PROJECT_NAME" \
    --label "ccy-github=$CCY_LABEL_GITHUB" \
    --label "ccy-token=$CCY_LABEL_TOKEN" \
    --label "ccy-ssh-keys=$CCY_LABEL_SSH_KEYS" \
    "${CCY_SEAT_RUN_ARGS[@]}" \
    $NETWORK_FLAG \
    "${GPU_DEVICE_FLAGS[@]}" \
    "${DOCKER_MOUNTS[@]}" \
    "${SSH_MOUNTS[@]}" \
    "${SSH_RUN_OPTS[@]}" \
    "${GUI_MOUNTS[@]}" \
    -e CLAUDE_CODE_OAUTH_TOKEN \
    -e GH_TOKEN \
    -e "GITHUB_USERNAME=$GITHUB_USERNAME" \
    -e "DEBUG_MODE=$DEBUG_MODE" \
    -e "DEBUG_ENTRYPOINT=$DEBUG_ENTRYPOINT" \
    -e "SSH_KEY_PATHS=$SSH_KEY_PATHS_STR" \
    -e "SSH_AGENT_FORWARDED=${SSH_AGENT_FORWARDED:-0}" \
    -e "SSH_CONFIG_EXTRA_B64=${SSH_CONFIG_EXTRA_B64:-}" \
    -e "SSH_KNOWN_HOSTS_PINS=${SSH_KNOWN_HOSTS_PINS:-}" \
    -e "GITHUB_SSH_443=$GITHUB_SSH_443" \
    -e "CCY_HOST_HOSTNAME=$CCY_HOST_HOSTNAME" \
    -e "CCY_CLAUDE_WRAPPER=${CCY_CLAUDE_WRAPPER:-}" \
    -e "CCY_NO_SUPERVISOR=${CCY_NO_SUPERVISOR:-}" \
    -e "CCY_LIFECYCLE_LAUNCH_ID=${CCY_LIFECYCLE_LAUNCH_ID:-}" \
    -e "CCY_LIFECYCLE_MAX_AGE_SECONDS=${CCY_LIFECYCLE_MAX_AGE_SECONDS:-}" \
    -e "CCY_LIFECYCLE_DEADLINE_EPOCH=${CCY_LIFECYCLE_DEADLINE_EPOCH:-}" \
    -e "CCY_LIFECYCLE_WARN_MINUTES=${CCY_LIFECYCLE_WARN_MINUTES:-}" \
    -e "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=${CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS:-1}" \
    -e "CLAUDE_CODE_AUTO_COMPACT_WINDOW=${CLAUDE_CODE_AUTO_COMPACT_WINDOW:-600000}" \
    -e "MAX_THINKING_TOKENS=${MAX_THINKING_TOKENS:-}" \
    -e "TERM=${TERM:-xterm}" \
    -e "COLORTERM=${COLORTERM:-truecolor}" \
    -e "FORCE_COLOR=1" \
    -w /workspace \
    "$IMAGE_NAME" \
    claude --dangerously-skip-permissions "${CLAUDE_CMD_ARGS[@]}" || container_rc=$?

if [ "$container_rc" -eq "$CCY_RESTART_EXIT_STATUS" ]; then
    ccy_handle_restart_exit
fi
if [ "$container_rc" -ne 0 ]; then
    exit "$container_rc"
fi

# Offer to stop compose services if CCY started them this session
if [[ "${CCY_COMPOSE_WAS_STARTED:-}" = "true" ]]; then
    echo ""
    echo "════════════════════════════════════════════════════════════════════════════════"
    echo "CCY Session Ended — Compose Services Running"
    echo "════════════════════════════════════════════════════════════════════════════════"
    echo ""
    echo "Compose services were started for this CCY session."
    echo ""

    # List containers with resource stats so user can tell if anything is active
    echo "Running containers (resource usage):"
    echo ""
    if ! container_cmd stats --no-stream 2>/dev/null; then
        # Fallback if stats unavailable
        if ! container_cmd ps --format "  • {{.Names}} ({{.Image}})" 2>/dev/null; then
            echo "  (could not list running containers)"
        fi
    fi
    echo ""
    echo "Command: $CCY_COMPOSE_CMD down"
    echo ""

    while true; do
        read -rp "$CCY_PROMPT_COMPOSE_STOP [Y/n]: " _stop_choice
        _stop_choice=${_stop_choice:-Y}
        echo ""
        case "$_stop_choice" in
            Y|y|Yes|yes)
                echo "Stopping compose services..."
                if $CCY_COMPOSE_CMD down; then
                    echo ""
                    echo "✓ Compose services stopped"
                else
                    echo ""
                    echo "⚠ Failed to stop compose services"
                    echo "Run manually: $CCY_COMPOSE_CMD down"
                fi
                break
                ;;
            N|n|No|no)
                echo "Compose services left running."
                echo "To stop later: $CCY_COMPOSE_CMD down"
                break
                ;;
            *)
                echo "Invalid choice. Please enter y or n"
                echo ""
                ;;
        esac
    done
    echo "════════════════════════════════════════════════════════════════════════════════"
    echo ""
fi
