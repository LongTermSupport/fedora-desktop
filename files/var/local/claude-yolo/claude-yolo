    discover_and_select_ssh_keys "ccy"
fi

# Build SSH mounts and validate GitHub access
# This sets: SSH_MOUNTS, SSH_KEY_PATHS, GITHUB_USERNAME, GH_TOKEN
build_ssh_mounts_and_validate "ccy" || exit 1

# Banner: make 443 mode impossible to miss. Fires whenever GitHub SSH ends up
# routed over ssh.github.com:443 — whether forced (--github-443), inherited from
# the host (GITHUB_SSH_443=1), or auto-detected when port 22 is firewall-blocked.
if [ "${GITHUB_SSH_443:-0}" = "1" ]; then
    if [ "$GITHUB_443_MODE" = true ]; then
        github_443_trigger="--github-443 flag"
    elif [ "$GITHUB_443_PRELAUNCH" = "1" ]; then
        github_443_trigger="GITHUB_SSH_443 env (host-level enable)"
    else
        github_443_trigger="auto-detected (port 22 blocked, 443 reachable)"
    fi
    echo ""
    echo -e "${COLOR_YELLOW}════════════════════════════════════════════════════════════════════════════════${COLOR_RESET}"
    echo -e "${COLOR_YELLOW}${COLOR_BOLD}  🔒 GitHub SSH-over-443 MODE ACTIVE${COLOR_RESET}"
    echo -e "${COLOR_YELLOW}════════════════════════════════════════════════════════════════════════════════${COLOR_RESET}"
    echo "  GitHub SSH is routed over ssh.github.com:443 (port-22 firewall bypass)."
    echo "  Same host keys, same identity — only the endpoint changes."
    echo -e "  Trigger: ${COLOR_BOLD}${github_443_trigger}${COLOR_RESET}"
    echo "  Scope:   this ccy session (host + container git over 443)."
    echo -e "${COLOR_YELLOW}════════════════════════════════════════════════════════════════════════════════${COLOR_RESET}"
    echo ""
fi

# Handle create token mode (requires SSH/GH setup for container functionality)
if [ "$CREATE_TOKEN_MODE" = true ]; then
    create_token "$TOKEN_DIR" "$GH_TOKEN" "$IMAGE_NAME" "ccy"
    exit $?
fi

# Handle update token mode (renew an existing named token before/after invalidation)
if [ "$UPDATE_TOKEN_MODE" = true ]; then
    if [ -z "$UPDATE_TOKEN_NAME" ]; then
        print_error "--update-token requires a token name (e.g. --update-token=personal)"
        exit 1
    fi
    create_token "$TOKEN_DIR" "$GH_TOKEN" "$IMAGE_NAME" "ccy" "$UPDATE_TOKEN_NAME"
    exit $?
fi

# After an interactive token create/renew, exit the right way. create_token
# (token-management.bash) sets CREATED_TOKEN_FILE on success and leaves it empty
# when the user cancelled, so a successful creation no longer prints a
# misleading "Cancelled" or crashes the caller on an empty token path (BSH-05).
post_create_token_exit() {
    if [ -n "${CREATED_TOKEN_FILE:-}" ]; then
        echo "✓ Token created. Re-run 'ccy' to launch with it."
        exit 0
    fi
    echo "Cancelled. Create a token with: ccy --create-token"
    exit 1
}

# Token selection logic
SELECTED_TOKEN=""
CLAUDE_OAUTH_TOKEN=""

if [ -n "$SPECIFIED_TOKEN" ]; then
    # Token specified via --token flag
    if [[ "$SPECIFIED_TOKEN" =~ / ]]; then
        # Full path provided
        SELECTED_TOKEN="$SPECIFIED_TOKEN"
    else
        # Token name provided, find matching token with any expiry date
        matching_tokens=("$TOKEN_DIR/${SPECIFIED_TOKEN}".*.token)
        if [ -f "${matching_tokens[0]}" ]; then
            SELECTED_TOKEN="${matching_tokens[0]}"
        else
            print_error "No token found with name: $SPECIFIED_TOKEN"
            echo ""
            echo "Available tokens:"
            list_tokens "$TOKEN_DIR" "ccy"
            exit 1
        fi
    fi

    if [ ! -f "$SELECTED_TOKEN" ]; then
        print_error "Token file not found: $SELECTED_TOKEN"
        echo ""
        echo "Available tokens:"
        list_tokens "$TOKEN_DIR" "ccy"
        exit 1
    fi

    # Check if token is expired or expiring today
    if ! is_token_valid "$SELECTED_TOKEN"; then
        filename=$(basename "$SELECTED_TOKEN")
        token_name="${filename%.*.token}"
        echo ""
        echo "════════════════════════════════════════════════════════════════════════════════"
        echo "⚠  TOKEN EXPIRED OR EXPIRING TODAY"
        echo "════════════════════════════════════════════════════════════════════════════════"
        echo ""
        echo "Token: $filename"
        echo ""
        echo "This token cannot be used. You must create a new token."
        echo ""
        read -rp "Create a new token now? (Y/n): " create_now
        if [ "$create_now" != "n" ] && [ "$create_now" != "N" ]; then
            create_token "$TOKEN_DIR" "$GH_TOKEN" "$IMAGE_NAME" "ccy" "$token_name"
            post_create_token_exit
        fi
        echo "Cancelled. Create a token with: ccy --create-token"
        exit 1
    fi

    filename=$(basename "$SELECTED_TOKEN")
    token_name="${filename%.*.token}"
    echo "✓ Using token: $token_name"
else
    # No token specified, check if tokens exist
    if [ ! -d "$TOKEN_DIR" ] || [ -z "$(ls -A "$TOKEN_DIR"/*.token 2>/dev/null)" ]; then
        echo ""
        echo "════════════════════════════════════════════════════════════════════════════════"
        echo "No Claude Code Tokens Found"
        echo "════════════════════════════════════════════════════════════════════════════════"
        echo ""
        echo "ccy uses long-lived OAuth tokens for container authentication."
        echo ""
        echo "You need to create a token before using ccy."
        echo ""
        read -rp "Create a token now? (Y/n): " create_now

        if [ "$create_now" = "n" ] || [ "$create_now" = "N" ]; then
            echo "Cancelled. Create a token later with: ccy --create-token"
            exit 0
        fi

        # Jump directly to token creation
        create_token "$TOKEN_DIR" "$GH_TOKEN" "$IMAGE_NAME" "ccy"
        post_create_token_exit
    else
        # Multiple tokens exist or single token - show selection
        select_token "$TOKEN_DIR" "container" || {
            echo ""
            echo "════════════════════════════════════════════════════════════════════════════════"
            echo "No Valid Tokens Available"
            echo "════════════════════════════════════════════════════════════════════════════════"
            echo ""
            echo "All tokens are expired or expiring today."
            echo "You must create a new token."
            echo ""
            read -rp "Create a token now? (Y/n): " create_now
            if [ "$create_now" != "n" ] && [ "$create_now" != "N" ]; then
                create_token "$TOKEN_DIR" "$GH_TOKEN" "$IMAGE_NAME" "ccy"
                post_create_token_exit
            fi
            echo "Cancelled. Create a token with: ccy --create-token"
            exit 1
        }
    fi
fi

# BSH-05: select_token's create/renew path returns success with SELECTED_TOKEN
# set to the freshly created token (CREATED_TOKEN_FILE) — or empty if the user
# cancelled the create. Empty here means there is nothing to launch with, so
# exit with guidance rather than crashing on `cat ""`.
if [ -z "$SELECTED_TOKEN" ]; then
    post_create_token_exit
fi

# Load token content (it's just the token string)
CLAUDE_OAUTH_TOKEN=$(cat "$SELECTED_TOKEN")
if [ -z "$CLAUDE_OAUTH_TOKEN" ]; then
    print_error "Token file is empty: $SELECTED_TOKEN"
    exit 1
fi

if ! [[ "$CLAUDE_OAUTH_TOKEN" =~ ^sk-ant-oat01- ]]; then
    print_error "Invalid token format in file: $SELECTED_TOKEN"
    echo "Token must start with 'sk-ant-oat01-'"
    exit 1
fi

# Quick validation: Check token byte length (valid tokens are ~90-120 bytes)
# This catches truncated/corrupted tokens before expensive API call
TOKEN_BYTES=${#CLAUDE_OAUTH_TOKEN}
TOKEN_VALIDATION_FAILED=false
VALIDATION_FAILURE_REASON=""

if [ "$TOKEN_BYTES" -lt 90 ] || [ "$TOKEN_BYTES" -gt 120 ]; then
    TOKEN_VALIDATION_FAILED=true
    VALIDATION_FAILURE_REASON="length"
else
    # Validate token against Claude API (sanity check for corruption)
    echo "Validating token..."
    if ! validate_token "$CLAUDE_OAUTH_TOKEN" "$IMAGE_NAME"; then
        TOKEN_VALIDATION_FAILED=true
        VALIDATION_FAILURE_REASON="api"
    else
        echo "✓ Token validated successfully"
    fi
fi

# Handle token validation failure with unified recovery UI
if [ "$TOKEN_VALIDATION_FAILED" = true ]; then
    filename=$(basename "$SELECTED_TOKEN")
    token_name="${filename%.*.token}"

    echo ""
    echo "════════════════════════════════════════════════════════════════════════════════"
    echo "❌ TOKEN VALIDATION FAILED"
    echo "════════════════════════════════════════════════════════════════════════════════"
    echo ""
    echo "Token: $filename"
    echo "File: $SELECTED_TOKEN"

    if [ "$VALIDATION_FAILURE_REASON" = "length" ]; then
        echo "Length: $TOKEN_BYTES bytes (expected: 90-120 bytes)"
        echo ""
        echo "This token appears corrupted (truncated or has extra characters)."
    else
        echo ""
        echo "The token has valid format, but does not authenticate with Claude API."
    fi

    echo ""
    echo "Common causes:"
    echo "  • Token file corrupted (truncated, extra characters, etc.)"
    echo "  • Token was manually edited incorrectly"
    echo "  • Token was revoked on Claude's side"
    echo "  • File was damaged (filesystem issue, interrupted write, etc.)"
    echo ""
    echo "════════════════════════════════════════════════════════════════════════════════"
    echo ""
    echo "Recovery options:"
    echo ""
    echo "  1) Recreate token (same name: '$token_name')"
    echo "  2) Select different token"
    echo "  3) Exit and fix manually"
    echo ""

    while true; do
        read -rp "Select option [1-3]: " recovery_choice
        echo ""

        case "$recovery_choice" in
            1)
                echo "Recreating token: $token_name"
                echo ""
                create_token "$TOKEN_DIR" "$GH_TOKEN" "$IMAGE_NAME" "ccy" "$token_name"
                post_create_token_exit
                ;;
            2)
                echo "Select a different token:"
                echo ""
                select_token "$TOKEN_DIR" "container" || {
                    echo ""
                    echo "No other valid tokens available."
                    echo ""
                    read -rp "Create a new token? (Y/n): " create_now
                    if [ "$create_now" != "n" ] && [ "$create_now" != "N" ]; then
                        create_token "$TOKEN_DIR" "$GH_TOKEN" "$IMAGE_NAME" "ccy"
                        post_create_token_exit
                    fi
                    echo "Cancelled. Create a token with: ccy --create-token"
                    exit 1
                }
                # BSH-05: a create/renew inside select_token may leave
                # SELECTED_TOKEN empty (cancelled) — don't cat "".
                if [ -z "$SELECTED_TOKEN" ]; then
                    post_create_token_exit
                fi
                # Token selected via select_token, reload and validate
                CLAUDE_OAUTH_TOKEN=$(cat "$SELECTED_TOKEN")

                # Validate the new token (both length and API)
                TOKEN_BYTES=${#CLAUDE_OAUTH_TOKEN}
                if [ "$TOKEN_BYTES" -lt 90 ] || [ "$TOKEN_BYTES" -gt 120 ]; then
                    print_error "Selected token also has invalid length ($TOKEN_BYTES bytes)"
                    echo "Please check your tokens or create a new one with: ccy --create-token"
                    exit 1
                fi

                if ! validate_token "$CLAUDE_OAUTH_TOKEN" "$IMAGE_NAME"; then
                    print_error "Selected token also failed validation"
                    echo "Please check your tokens or create a new one with: ccy --create-token"
                    exit 1
                fi

                echo "✓ Selected token validated successfully"
                echo ""
                break
                ;;
            3)
                echo "Cancelled."
                echo ""
                echo "To fix manually:"
                echo "  • Delete corrupted token: rm \"$SELECTED_TOKEN\""
                echo "  • Create new token: ccy --create-token"
                echo "  • Or view all tokens: ccy --list-tokens"
                exit 1
                ;;
            *)
                echo "Invalid choice. Please enter 1, 2, or 3"
                echo ""
                ;;
        esac
    done
fi
echo ""

# Get current user's UID and GID for proper file ownership
HOST_UID=$(id -u)
HOST_GID=$(id -g)

# Safety check: Never run as root (UID 0)
if [ "$HOST_UID" -eq 0 ]; then
    print_error "Cannot run Claude Code YOLO mode as root user (UID 0)"
    echo "This is a security restriction for --dangerously-skip-permissions mode"
    echo "Please run this command as a regular user, not with sudo or as root"
    exit 1
fi

# Safety check: Only run in rootless mode
# Podman is rootless by default when run as non-root user
# Docker requires explicit rootless context setup
if [ "$CONTAINER_ENGINE" = "docker" ]; then
    DOCKER_CONTEXT=$(container_cmd context inspect 2>/dev/null | grep -o '"Name": *"[^"]*"' | head -1 | cut -d'"' -f4)
    if [ "$DOCKER_CONTEXT" != "rootless" ]; then
