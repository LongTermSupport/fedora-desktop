#!/bin/bash
# shellcheck source-path=SCRIPTDIR
# cc — Host Claude Code launcher with token-source parity with ccy
#
# Sources ccy's token-management library to present the same named-token
# chooser experience for host Claude Code invocations. The chooser shows
# every valid token in ~/.claude-tokens/ccy/tokens/ plus a "Desktop"
# pseudo-option that falls through to the standard host ~/.claude/ OAuth
# flow (i.e. the pre-Plan-00048 cc behaviour).
#
# Hard dependency on ccy: play-claude-yolo.yml MUST have been deployed
# (it's not optional in this distro — see playbook-main.yml). The wrapper
# fails fast if the lib is missing rather than silently degrading.
#
# See CLAUDE/Plan/00048-cc-token-source-parity/PLAN.md for full design notes.

set -e

# Desktop Claude Code writes the same plaintext session state as the container
# does, to ~/.claude/ — transcripts, file-history/, shell-snapshots/, prompt
# history — and it is protected by file permissions alone (Anthropic,
# code.claude.com/docs/en/claude-directory, "Plaintext storage"). The default
# umask (022) leaves all of it readable by every local user. See Plan 00098 and
# the matching umask in ccy's entrypoint.sh: the desktop store has no container
# boundary at all, so omitting it here would leave the larger hole open.
umask 077

# Defensive stubs: token-management.bash's container-mode renew/create paths
# reference $GH_TOKEN and $IMAGE_NAME. We never trigger those paths in host
# mode (mode="host" disables them), but pre-export empty stubs anyway so that
# any future tightening to `set -u` would not crash the wrapper.
: "${GH_TOKEN:=}" "${IMAGE_NAME:=}"

CCY_LIB_DIR="/var/local/claude-yolo/lib"
COMMON_PURE="$CCY_LIB_DIR/common-pure.bash"
TOKEN_MGMT="$CCY_LIB_DIR/token-management.bash"

CCY_ROOT="$HOME/.claude-tokens/ccy"
TOKEN_DIR="$CCY_ROOT/tokens"

if [ ! -t 0 ] || [ ! -t 1 ]; then
    echo "cc: requires an interactive shell (the token chooser uses read -p)" >&2
    echo "  For non-interactive use, call 'claude' directly (set CLAUDE_CODE_OAUTH_TOKEN if needed)." >&2
    exit 1
fi

# shellcheck source=../claude-yolo/lib/common-pure.bash
source "$COMMON_PURE"
# shellcheck source=../claude-yolo/lib/token-management.bash
source "$TOKEN_MGMT"
# shellcheck source=../claude-yolo/lib/tmux-session.bash
source "$CCY_LIB_DIR/tmux-session.bash"
# shellcheck source=../claude-yolo/lib/session-registry.bash
source "$CCY_LIB_DIR/session-registry.bash"

# Terminal-death insulation, the same as ccy's and on the same server: the session is
# re-executed inside tmux BEFORE the token chooser, so the prompt and the claude pty both
# live where a dying terminal cannot reach them. Sessions are cc-<project>; a detached one
# is offered on the next cc from this directory, and ccy-sessions lists them with ccy's.
# Inside a tmux of its own already, ccy_tmux_insulate decides (see the library); on the
# way back in it is a no-op and the banner says how to detach and return.
CCY_TMUX_SESSION_PREFIX="cc"
ccy_tmux_insulate "$(get_project_name)" "$(cd "$(dirname "$0")" && pwd)/$(basename "$0")" "$@"
ccy_tmux_banner
# `--no-restore` is the session registry's opt-out, consumed by the insulation above on the
# way INTO tmux. On the way back in, and on the paths where insulation does not apply, it
# is still in this argv — and everything left in it goes to claude, which would refuse an
# option it does not know.
mapfile -t CC_ARGS < <(ccy_registry_launch_args "$@")
set -- "${CC_ARGS[@]}"

# Stale-credential shadow-proofing (full rationale in the named-token branch
# below). claude reads .credentials.json even when CLAUDE_CODE_OAUTH_TOKEN is
# exported; an expired entry there 401s the session. Named-token mode parks
# this file for the duration and restores it on exit.
#
# CLAUDE_CONFIG_DIR is honoured because it relocates the WHOLE config
# directory, credentials included on Linux: "All settings, session history, and
# plugins are stored under this path, as are credentials on Linux and Windows"
# (code.claude.com/docs/en/env-vars; captured verbatim in Plan 00098's
# research/raw-findings.md:240). Hardcoding $HOME/.claude here WOULD mean that
# with the variable set, cc parks a file claude is not reading — the real
# credential keeps shadowing the injected token, and the session runs on the
# Desktop account while /status still reports the env token as active. That is
# a deduction from the documented scope, not an observed failure: nothing in
# this repo sets CLAUDE_CONFIG_DIR, so the state has never been reached here.
# It also settles Decision 7, which rejected the variable as "undocumented in
# scope": it is documented, and this is the scope.
CLAUDE_CONFIG_HOME="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
CRED_FILE="$CLAUDE_CONFIG_HOME/.credentials.json"
CRED_BAK="$CRED_FILE.cc-desktop-bak"

# Finding the backup only where CRED_FILE now lives would orphan one parked at
# the DEFAULT location by an earlier run made before CLAUDE_CONFIG_DIR was set.
# That credential is not recoverable by any later cc run, which is the same
# silent-loss shape the refusal below exists to prevent, so name it explicitly.
CRED_BAK_DEFAULT="$HOME/.claude/.credentials.json.cc-desktop-bak"

# Self-heal: if a previous named-token session was hard-killed (SIGKILL, power
# loss) before its EXIT trap restored the file, the real Desktop credential is
# still parked in the backup with no live credentials file. Put it back before
# we do anything else so the Desktop option / a future login is never silently
# lost.
if [ ! -f "$CRED_FILE" ] && [ -f "$CRED_BAK" ]; then
    mv -f "$CRED_BAK" "$CRED_FILE"
fi

# BOTH files present is the one state the self-heal above cannot resolve, and
# it must never be walked past. It arises when a named-token session was
# hard-killed AFTER claude had written a fresh .credentials.json: the real
# Desktop credential sits in the backup, a newer one is live, and the
# self-heal is skipped because CRED_FILE exists. The park below used `mv -f`,
# which would then overwrite the backup and destroy the Desktop credential
# outright — after which "Desktop" authenticated as whatever the leftover was.
# Which file to keep is a question only a human can answer, so refuse rather
# than guess (this is a human-run interactive script; the recovery is two
# commands and is spelled out).
if [ -f "$CRED_FILE" ] && [ -f "$CRED_BAK" ]; then
    print_error "Two credential files present — cc will not guess which to keep"
    {
        echo "  live:   $CRED_FILE"
        echo "  parked: $CRED_BAK"
        echo
        echo "The parked file is most likely your real Desktop login, left behind"
        echo "when a named-token session was killed after claude wrote a new"
        echo "credential. cc takes no lock, so a second cc running concurrently"
        echo "could also have produced this — check before discarding either."
        echo "Inspect both, then leave exactly one in place:"
        echo
        echo "  # keep the parked Desktop credential:"
        echo "  mv -f '$CRED_BAK' '$CRED_FILE'"
        echo
        echo "  # or discard it and keep the live one:"
        echo "  rm -i '$CRED_BAK'"
    } >&2
    exit 1
fi

# A backup orphaned at the default location by a pre-CLAUDE_CONFIG_DIR run is
# invisible to every check above, because they all resolve under the relocated
# dir. Say so rather than leaving the credential stranded and unmentioned.
if [ "$CRED_BAK" != "$CRED_BAK_DEFAULT" ] && [ -f "$CRED_BAK_DEFAULT" ]; then
    print_error "A parked Desktop credential is stranded at the default location"
    {
        echo "  stranded: $CRED_BAK_DEFAULT"
        echo "  in use:   $CLAUDE_CONFIG_HOME"
        echo
        echo "CLAUDE_CONFIG_DIR moved the config dir after an earlier cc run parked"
        echo "a credential under \$HOME/.claude. No cc run will ever restore it from"
        echo "there. Move it where it belongs, or delete it if it is stale:"
        echo
        echo "  mv -i '$CRED_BAK_DEFAULT' '$HOME/.claude/.credentials.json'"
        echo "  # or, if you no longer want that login:"
        echo "  rm -i '$CRED_BAK_DEFAULT'"
    } >&2
    exit 1
fi

# Surface the active token in the status line, matching ccy. The hooks-daemon
# account_display status handler reads LAST_TOKEN from ~/.claude/.last-launch.conf
# and renders it (👤 <name>). ccy writes that key via its own launch config; host
# cc previously only echoed the name, so the host status line stayed blank. Write
# the same key here so cc has parity. The file carries only the token NAME (not the
# secret), but is mode 600 to match ccy's convention.
#
# This path deliberately does NOT follow CLAUDE_CONFIG_HOME. The reader is the
# hooks daemon, not claude, and it resolves the location itself as the fixed
# pair (".claude", ".last-launch.conf") under $HOME — see the daemon's
# status_line/account_display.py. Pointing this at a relocated config dir would
# write somewhere the daemon never looks and silently blank the status line.
write_status_token() {
    local _name="$1"
    mkdir -p "$HOME/.claude"
    printf '# Written by cc for hooks-daemon status-line token display\nLAST_TOKEN="%s"\n' \
        "$_name" > "$HOME/.claude/.last-launch.conf"
    chmod 600 "$HOME/.claude/.last-launch.conf"
}

# Host-mode chooser. Always sets SELECTED_TOKEN (path to token file, or ""
# for Desktop). Returns 0 in normal operation; never falls through with an
# unset SELECTED_TOKEN.
SELECTED_TOKEN=""
# Each non-zero return is a DIFFERENT cause and gets its own message — see the
# return-code contract above select_token(). Reporting them all as "expired"
# would name a date that does not exist for an old-format token, or blame the
# pool for a cancelled prompt.
#
# Handled explicitly rather than left to `set -e`: a bare abort exits with no
# closing message, and this is a script a human is sitting in front of. Note
# that this `if !` suppresses errexit for the whole of select_token, which is
# why that function returns every failure explicitly instead of aborting.
#
# Desktop is deliberately NOT offered as a consolation on any of these paths —
# falling through to a different Claude account without being asked is the bug
# this branch exists to prevent. It stays available as the `d` key in the menu.
select_token_rc=0
select_token "$TOKEN_DIR" "host" || select_token_rc=$?
case "$select_token_rc" in
    0) ;;
    2)
        # Cancelled at the prompt. select_token has already said so.
        exit 1
        ;;
    3)
        print_error "No usable token in $TOKEN_DIR"
        {
            echo "  Every token in the pool is past the expiry date recorded in its"
            echo "  filename. That date is a conservative +90d GUESS made at creation,"
            echo "  not the token's real expiry, so one of them may well still work —"
            echo "  but cc will not pick for you, and it will not quietly switch you"
            echo "  to the Desktop account instead."
            echo
            echo "  Mint a fresh token:   ccy --create-token"
            echo "  Use the host account: claude"
        } >&2
        exit 1
        ;;
    *)
        print_error "Token chooser failed (status $select_token_rc)"
        {
            echo "  This is an internal error in select_token, not a verdict about"
            echo "  your tokens. Check $TOKEN_DIR for files that do not match"
            echo "  NAME.YYYY-MM-DD.token — an old-format token reports as unusable."
            echo
            echo "  Use the host account meanwhile: claude"
        } >&2
        exit 1
        ;;
esac

# IMPORTANT: run `claude update` BEFORE exporting the OAuth token so the
# self-updater never sees the chosen token. Then export and exec claude.
claude update

if [ -n "$SELECTED_TOKEN" ]; then
    TOKEN_CONTENT=$(cat "$SELECTED_TOKEN")

    if ! [[ "$TOKEN_CONTENT" =~ ^sk-ant-oat01- ]]; then
        print_error "Invalid token format in file: $SELECTED_TOKEN"
        echo "Token must start with 'sk-ant-oat01-'" >&2
        exit 1
    fi

    TOKEN_BYTES=${#TOKEN_CONTENT}
    if [ "$TOKEN_BYTES" -lt 90 ] || [ "$TOKEN_BYTES" -gt 120 ]; then
        print_error "Invalid token length in file: $SELECTED_TOKEN"
        echo "Length: $TOKEN_BYTES bytes (expected: 90-120 bytes)" >&2
        echo "Token appears truncated or corrupted. Recreate with: ccy --create-token" >&2
        exit 1
    fi

    TOKEN_FILENAME=$(basename "$SELECTED_TOKEN")
    TOKEN_NAME="${TOKEN_FILENAME%.*.token}"
    echo "Token: $TOKEN_NAME"
    write_status_token "$TOKEN_NAME"

    export CLAUDE_CODE_OAUTH_TOKEN="$TOKEN_CONTENT"

    # Claude Code ignores CLAUDE_CODE_OAUTH_TOKEN and drops into the interactive
    # first-run login wizard ("Select login method") whenever onboarding is not
    # marked complete in ~/.claude.json — interactively that shows the login
    # screen, headlessly (-p) it hangs. The ccy container seeds this flag in its
    # entrypoint (hasCompletedOnboarding: true), which is exactly why the same
    # token authenticates inside ccy but is bypassed by host cc. Mirror only the
    # onboarding flag here so the chosen token is honoured. We deliberately do
    # NOT touch bypassPermissionsModeAccepted — that is a container-only YOLO
    # setting and must never be forced onto the host. Idempotent: re-running
    # leaves an already-onboarded config unchanged apart from this flag.
    # Only applied in the token branch; the Desktop branch leaves ~/.claude/
    # untouched so its normal OAuth/onboarding flow is preserved.
    #
    # Left at $HOME and NOT moved under CLAUDE_CONFIG_HOME, because this is not
    # a "~/.claude path": .claude.json is a sibling of that directory, and the
    # documented wording CLAUDE_CONFIG_DIR carries ("every ~/.claude path lives
    # under that directory instead") does not decide it either way. Relocating
    # on a guess would seed an onboarding flag into a file claude may not read,
    # reintroducing the login-wizard bypass this block exists to prevent. If
    # someone establishes the real behaviour, change it then — do not infer it.
    CLAUDE_JSON="$HOME/.claude.json"
    if ! command -v jq >/dev/null 2>&1; then
        print_error "jq is required to mark onboarding complete in $CLAUDE_JSON"
        echo "Install jq on the host (it is part of this distro's standard tool set)." >&2
        exit 1
    fi
    if [ -f "$CLAUDE_JSON" ]; then
        if ! SEEDED_JSON=$(jq '.hasCompletedOnboarding = true' "$CLAUDE_JSON"); then
            print_error "Could not parse/update $CLAUDE_JSON (is it valid JSON?)"
            exit 1
        fi
        printf '%s\n' "$SEEDED_JSON" > "$CLAUDE_JSON"
    else
        printf '%s\n' '{"hasCompletedOnboarding":true}' > "$CLAUDE_JSON"
        chmod 600 "$CLAUDE_JSON"
    fi

    # Shadow-proofing the chosen token. claude consults
    # ~/.claude/.credentials.json even when CLAUDE_CODE_OAUTH_TOKEN is exported,
    # so a stale/expired credential left by a previous Desktop /login produces a
    # 401 "Invalid authentication credentials" — the exact failure that does NOT
    # happen in the clean ccy container (which has no such file). Drop any
    # higher-precedence auth env vars (precedence tiers 2-3 outrank the token at
    # tier 5), then park the credential aside so the injected token is the only
    # credential claude can use, restoring it when cc exits. The Desktop
    # pseudo-option (else-branch) leaves the file untouched.
    unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN
    if [ -f "$CRED_FILE" ]; then
        # `mv` without -f: the both-files-present state is refused near the top
        # of this script, so there is no backup here to overwrite, and -f would
        # re-open exactly the clobber that check exists to close.
        mv "$CRED_FILE" "$CRED_BAK"

        # Assert the park actually took. NOT because a failed `mv` would be
        # walked past — this is inside an `if` BODY, where `set -e` applies, so
        # a non-zero `mv` already aborts with its own message. What is left
        # uncovered is the narrower case of an `mv` that exits 0 and still
        # leaves the source in place (an exotic filesystem, a racing writer).
        # Cheap belt-and-braces against a state that would otherwise launch the
        # session with the credential still shadowing the injected token.
        if [ -e "$CRED_FILE" ]; then
            print_error "Could not park the host credential at $CRED_FILE"
            echo "  The chosen token would be shadowed by it, so cc is stopping" >&2
            echo "  rather than authenticating as an account you did not pick." >&2
            exit 1
        fi

        # Restore on any exit. NOTE: the launch below must NOT use `exec` — exec
        # would replace this shell and the trap would never fire, permanently
        # parking the Desktop credential.
        trap 'if [ -f "$CRED_BAK" ]; then mv -f "$CRED_BAK" "$CRED_FILE"; fi' EXIT INT TERM
    fi
else
    echo "Token: Desktop (host ~/.claude/)"
    write_status_token "Desktop"
fi

# Deliberately NOT `exec`: the EXIT trap set in the named-token branch must run
# after the session to restore the Desktop credential. A lingering parent shell
# is a negligible cost for guaranteed cleanup. `set -e` still propagates claude's
# exit status (the trap's mv does not overwrite it).
claude "$@"
