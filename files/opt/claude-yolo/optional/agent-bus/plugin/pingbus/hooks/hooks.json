{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$PINGBUS_MEMBERSHIP\" ] || [ -e \"$PINGBUS_HOME/active\" ] || exec pingbus hook conversation; exec pingbus hook session-start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$PINGBUS_MEMBERSHIP\" ] || [ -e \"$PINGBUS_HOME/active\" ] || exit 0; exec pingbus hook prompt"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$PINGBUS_MEMBERSHIP\" ] || [ -e \"$PINGBUS_HOME/active\" ] || exit 0; if [ \"$PINGBUS_DELIVERY\" = relay ]; then exec pingbus hook post-tool; fi"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$PINGBUS_MEMBERSHIP\" ] || [ -e \"$PINGBUS_HOME/active\" ] || exit 0; exec pingbus hook stop"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$PINGBUS_MEMBERSHIP\" ] || [ -e \"$PINGBUS_HOME/active\" ] || exit 0; exec pingbus hook session-end",
            "timeout": 6
          }
        ]
      }
    ]
  }
}
