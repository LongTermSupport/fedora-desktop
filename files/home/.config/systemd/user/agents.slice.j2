# Deployed by playbooks/imports/play-claude-yolo.yml. Every ccy and ccc container runs in this
# slice (podman run --cgroup-parent agents.slice), so all of them together stay below MemoryMax,
# which the launcher also reads as each container's default cap (keep the MemoryMax=<n>M form).
# MemoryHigh throttles the slice before MemoryMax, where the kernel kills inside this slice only.
# Nothing here asks systemd-oomd to act: docs/ccy.md, "Container limits".
[Unit]
Description=ccy containers, capped together (docs/ccy.md, Container limits)

[Slice]
MemoryMax={{ ccy_agents_slice_max_mb }}M
MemoryHigh={{ ccy_agents_slice_high_mb }}M
