{{ ansible_managed | comment }}
[Unit]
Description=Schedule for the fedora-desktop host health collection
Documentation=https://github.com/LongTermSupport/fedora-desktop

[Timer]
{% if is_server | bool %}
# SERVER: DAILY, and the cadence is derived rather than picked. The consumer,
# helpers/host_health/login_message.py, reports the document's own age as a finding once
# it passes STALE_AFTER_DAYS = 14 — silence is a claim, and a clean document nobody has
# refreshed for a fortnight describes the host as it was a fortnight ago. Daily gives
# fourteen consecutive misses before that fires, so one failed run, one reboot or a day
# powered off is not a false alarm, while a collector that has genuinely stopped is
# reported well inside the bound. Weekly would allow two attempts inside the same window:
# the margin would be a single missed run. Change one and re-derive the other.
OnCalendar=*-*-* 06:15:00
# Also after the user manager starts, which with linger enabled is boot. This plan exists
# because a reboot into a new kernel left a DKMS module unbuilt and nothing said so;
# waiting up to a day to notice that would reproduce the incident with a delay.
OnStartupSec=5min
# Spreads the daily fetch so hosts provisioned from this repo do not all reach the remote
# at the same second. It applies to EVERY trigger, including OnStartupSec, so the
# post-boot collection actually lands 5-35 minutes after the manager starts — not
# "shortly", and worth stating rather than implying. That window is covered from the
# other end: login_message reports a document collected under a different kernel, so
# whatever is read during it is labelled as predating this boot rather than trusted.
RandomizedDelaySec=30min
# A host that was powered off through 06:15 catches up rather than skipping the day.
Persistent=true
{% else %}
# DESKTOP: HOURLY, because the reader is a panel icon somebody glances at, not a fortnight
# staleness bound. Drift a `git pull` introduces (a moved pin, a play now behind HEAD)
# announces itself to nothing, so this is what makes it reach the icon without a login.
# The cost is one `git fetch` and three cheap local probes per hour. A play run does not
# wait for this: the play-ledger callback restarts the collector when the run ends.
#
# OnStartupSec is not the boot check — the login unit does that, at the end of login. It
# is the arming event OnUnitActiveSec needs, and 15 minutes keeps it clear of the window
# in which DKMS is still building for a new kernel, where a run would report a transient
# as a finding. A desktop that was off simply starts the cycle again at boot; there is no
# Persistent= catch-up because the login unit already covers "first thing after power-on".
OnStartupSec=15min
OnUnitActiveSec=1h
RandomizedDelaySec=5min
{% endif %}
Unit=host-health-collect.service

[Install]
WantedBy=timers.target
