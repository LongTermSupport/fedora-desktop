{{ ansible_managed | comment }}
[Unit]
Description=fedora-desktop host health report (login-time, reporting-only)
Documentation=https://github.com/LongTermSupport/fedora-desktop
# END of login, not boot. The whole point is that somebody is present to read it:
# a report delivered to an empty greeter is a report nobody sees, and the failure
# this exists for was a broken host nobody was told about. After
# graphical-session.target so the session bus exists for the notification.
After=graphical-session.target
# No PartOf=. It propagates stop and restart from the target, and there is nothing to
# propagate to a oneshot that has already exited — it is the idiom for a long-running
# session service, and carrying it here would suggest this is one.

[Service]
Type=oneshot
# Reporting-only. It runs dkms status, systemctl --failed and a git fetch, and it
# writes nothing outside the ledger's own directory. It never re-runs a play,
# never installs anything and never moves the working tree - re-running a play is
# always a human decision (see the plan's Non-Goals).
#
# WorkingDirectory is the repo checkout, templated rather than assumed, so the
# helpers package imports. No path is hardcoded anywhere in this repo.
ExecStart=/usr/bin/python3 -m helpers.host_health.login_report
WorkingDirectory={{ root_dir }}
# Exit 3 means "there are findings", which is a successful run of the check: a
# drifted host must not also show up as a broken service, because two alarms for one
# fact is how both come to be ignored.
#
# 3 and not 1, deliberately. Python exits 1 for any uncaught exception - a wrong
# WorkingDirectory, a renamed helper, a typo - so listing 1 here would declare a
# permanently dead health surface a success, deliver no findings, and leave
# `systemctl --user is-failed` silent about it. 1 and 2 are left as real failures.
SuccessExitStatus=3
# Stated, not inherited. systemd DISABLES the start timeout for Type=oneshot by
# default (src/core/service.c: "Oneshot services have disabled start timeout by
# default"), so without this a hung probe would hold graphical-session.target in
# `activating` for ever. The helpers each bound their own subprocess well inside
# this; this is the backstop for anything that does not.
TimeoutStartSec=120

[Install]
WantedBy=graphical-session.target
