#!/usr/bin/env bash
# ssh-keys-rekey — change the passphrase on every SSH private key in one pass
#
# Premise: ALL targeted keys currently share ONE passphrase. The script collects
# that current passphrase once, then the new passphrase (with confirmation), and:
#
#   1. Discovers the target private keys — every private key in ~/.ssh by
#      default, or the explicit paths/globs you pass.
#   2. SANITY CHECK (fail fast): verifies EVERY target key can be opened with the
#      current passphrase BEFORE touching anything. If even one key cannot, it
#      aborts and changes nothing — mixed passphrases are explicitly unsupported.
#   3. Backs up every target private key (and its .pub) to a timestamped backup
#      directory, so a bad run can be rolled back.
#   4. Rekeys every target key to the new passphrase. If a rekey fails partway,
#      it restores the keys it already changed from the backup and aborts.
#   5. Invalidates each rekeyed key's cached passphrase in the GNOME keyring
#      (gcr Secret Service). A rekey makes that cache STALE: gcr keeps handing
#      ssh-add the OLD passphrase, the decrypt fails, and (a known gcr/ssh-add
#      bug) ssh-add busy-loops at ~100% CPU instead of re-prompting — which
#      manifests as `git push`/ssh hanging forever. Best-effort; needs
#      `secret-tool` (libsecret). Without it there is no gcr cache to clear.
#
# Note: an UNencrypted key opens with any passphrase, so it passes the sanity
# check regardless and is simply (re)encrypted with the new passphrase. The
# "same passphrase" assumption only constrains the encrypted keys.
#
# Usage:
#   ssh-keys-rekey [options] [KEY ...]
#
#   KEY ...            Private key paths or globs to rekey. If omitted, every
#                      private key in ~/.ssh is targeted.
#
# Options:
#   -d, --ssh-dir DIR  Directory scanned for keys when no KEY is given
#                      (default: ~/.ssh).
#   -n, --dry-run      Run discovery + the sanity check only; make no changes.
#   -y, --yes          Skip the final "proceed?" confirmation prompt.
#   -h, --help         Show this help and exit.
#
# Examples:
#   ssh-keys-rekey                       # rekey all keys in ~/.ssh
#   ssh-keys-rekey ~/.ssh/id_ed25519     # rekey one key
#   ssh-keys-rekey '~/.ssh/id_*'         # rekey a glob (quote it!)
#   ssh-keys-rekey --dry-run             # check everything, change nothing
set -euo pipefail

SSH_DIR="${HOME}/.ssh"
DRY_RUN=0
ASSUME_YES=0
MAX_TRIES=3   # bounded retries on recoverable input mistakes (typos, mismatches)

usage() {
    echo "Usage: ssh-keys-rekey [options] [KEY ...]"
    echo ""
    echo "  Rekey (change the passphrase on) SSH private keys in bulk. All"
    echo "  targeted keys must currently share ONE passphrase."
    echo ""
    echo "  KEY ...            Key paths or globs to rekey (default: all of ~/.ssh)."
    echo ""
    echo "  -d, --ssh-dir DIR  Directory scanned when no KEY is given (default: ~/.ssh)."
    echo "  -n, --dry-run      Discovery + sanity check only; make no changes."
    echo "  -y, --yes          Skip the final confirmation prompt."
    echo "  -h, --help         Show this help and exit."
}

# A real SSH/OpenSSL private key file carries a "PRIVATE KEY" header line.
is_private_key() {
    local f="$1"
    [ -f "$f" ] || return 1
    [ -r "$f" ] || return 1
    grep -qI "PRIVATE KEY" "$f"
}

# Read a secret from the controlling terminal (so it works even when stdout is
# captured) and echo it on stdout. The prompt + trailing newline go to stderr.
# Returns non-zero on EOF (Ctrl-D / no TTY) so callers can treat it as cancelled.
prompt_secret() {
    local _prompt="$1" _val
    if ! read -rsp "$_prompt" _val < /dev/tty; then
        echo >&2
        return 1
    fi
    echo >&2
    printf '%s' "$_val"
}

# Discover candidate private keys in SSH_DIR, skipping the well-known non-key
# files, and confirming each really is a private key.
discover_default_keys() {
    local f name
    for f in "$SSH_DIR"/*; do
        [ -f "$f" ] || continue
        name="$(basename "$f")"
        case "$name" in
            *.pub|config|known_hosts|known_hosts.old|authorized_keys|*.swp|*.bak|*.old) continue ;;
        esac
        if is_private_key "$f"; then
            printf '%s\n' "$f"
        fi
    done
}

declare -a KEYS=()

add_key() {
    local f="$1" k
    if [ "${#KEYS[@]}" -gt 0 ]; then
        for k in "${KEYS[@]}"; do
            [ "$k" = "$f" ] && return 0
        done
    fi
    KEYS+=("$f")
}

# --- argument parsing ---
declare -a targets=()
while [ "$#" -gt 0 ]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        -n|--dry-run) DRY_RUN=1; shift ;;
        -y|--yes) ASSUME_YES=1; shift ;;
        -d|--ssh-dir)
            [ "$#" -ge 2 ] || { echo "Error: $1 requires a directory argument" >&2; exit 1; }
            SSH_DIR="$2"; shift 2 ;;
        --) shift; while [ "$#" -gt 0 ]; do targets+=("$1"); shift; done ;;
        -*) echo "Error: unknown option: $1" >&2; usage >&2; exit 1 ;;
        *) targets+=("$1"); shift ;;
    esac
done

# --- build the target key list ---
if [ "${#targets[@]}" -eq 0 ]; then
    while IFS= read -r f; do
        add_key "$f"
    done < <(discover_default_keys)
    if [ "${#KEYS[@]}" -eq 0 ]; then
        echo "No private keys found in $SSH_DIR" >&2
        exit 1
    fi
else
    for pat in "${targets[@]}"; do
        # Expand a leading ~/ ourselves — a quoted glob arg skips shell tilde
        # expansion, so '~/.ssh/id_*' would otherwise keep its literal tilde.
        case "$pat" in
            "~/"*) pat="${HOME}/${pat#\~/}" ;;
            "~")   pat="${HOME}" ;;
        esac
        matched=0
        for f in $pat; do
            [ -e "$f" ] || continue
            if ! is_private_key "$f"; then
                echo "Error: not an SSH private key: $f" >&2
                exit 1
            fi
            add_key "$f"
            matched=1
        done
        if [ "$matched" -eq 0 ]; then
            echo "Error: no matching SSH private key for: $pat" >&2
            exit 1
        fi
    done
fi

# --- show the plan ---
echo "ssh-keys-rekey — targeting ${#KEYS[@]} SSH private key(s):" >&2
printf '  %s\n' "${KEYS[@]}" >&2
echo >&2

# --- collect the current passphrase, retrying on a typo ---
# A passphrase that opens NONE of the keys is almost certainly a typo -> re-prompt
# (bounded). A passphrase that opens SOME but not all means the keys do not share
# one passphrase -> that is unfixable here, so fail fast with guidance.
CUR_PASS=""
attempt=1
while :; do
    if ! CUR_PASS="$(prompt_secret 'Current passphrase (shared by all keys): ')"; then
        echo "Cancelled — no passphrase entered. No changes made." >&2
        exit 1
    fi

    echo "Verifying all keys open with that passphrase..." >&2
    failed=()
    opened=0
    for f in "${KEYS[@]}"; do
        if probe="$(ssh-keygen -y -P "$CUR_PASS" -f "$f" 2>&1)"; then
            opened=$((opened + 1))
        else
            failed+=("$f")
        fi
    done

    if [ "${#failed[@]}" -eq 0 ]; then
        echo "  All ${#KEYS[@]} key(s) opened." >&2
        break
    fi

    if [ "$opened" -gt 0 ]; then
        # Mixed passphrases — a retry cannot fix this. Fail fast with guidance.
        echo "" >&2
        echo "These key(s) did NOT open with that passphrase:" >&2
        printf '    %s\n' "${failed[@]}" >&2
        echo "…but others did, so your keys do not all share one passphrase." >&2
        echo "ssh-keys-rekey only handles a single shared passphrase." >&2
        echo "Rekey the differing key(s) on their own, e.g.:" >&2
        printf '    ssh-keys-rekey %s\n' "${failed[0]}" >&2
        exit 1
    fi

    # Opened none -> almost certainly a typo. Re-prompt within the cap.
    echo "  That passphrase didn't open any key — typo?  (last error: ${probe})" >&2
    attempt=$((attempt + 1))
    if [ "$attempt" -gt "$MAX_TRIES" ]; then
        echo "Giving up after $MAX_TRIES attempts. No changes made." >&2
        exit 1
    fi
    echo "  Try again — attempt $attempt of $MAX_TRIES." >&2
done

if [ "$DRY_RUN" -eq 1 ]; then
    echo "" >&2
    echo "Dry run: all ${#KEYS[@]} key(s) open with the current passphrase. No changes made." >&2
    exit 0
fi

# --- collect and confirm the new passphrase, retrying on a mismatch ---
NEW_PASS=""
attempt=1
while :; do
    if ! NEW_PASS="$(prompt_secret 'New passphrase (empty = remove passphrase): ')"; then
        echo "Cancelled — no new passphrase entered. No changes made." >&2
        exit 1
    fi
    if ! NEW_PASS2="$(prompt_secret 'Confirm new passphrase: ')"; then
        echo "Cancelled. No changes made." >&2
        exit 1
    fi
    [ "$NEW_PASS" = "$NEW_PASS2" ] && break

    echo "  Those didn't match — let's try again." >&2
    attempt=$((attempt + 1))
    if [ "$attempt" -gt "$MAX_TRIES" ]; then
        echo "Giving up after $MAX_TRIES attempts. No changes made." >&2
        exit 1
    fi
done

# --- final confirmation (default: No) ---
if [ "$ASSUME_YES" -ne 1 ]; then
    printf 'Rekey %d key(s) now? [y/N] ' "${#KEYS[@]}" >&2
    if ! read -r reply < /dev/tty; then reply=""; fi
    case "$reply" in
        y|Y|yes|YES) ;;
        *) echo "Aborted — no changes made." >&2; exit 1 ;;
    esac
fi

# --- back up every target key before touching it ---
ts="$(date +%Y%m%d-%H%M%S)"
BACKUP_DIR="${SSH_DIR%/}/rekey-backup-${ts}"
mkdir -p "$BACKUP_DIR"
chmod 700 "$BACKUP_DIR"
echo "Backing up keys to $BACKUP_DIR" >&2

declare -a BACKUPS=()
i=0
for f in "${KEYS[@]}"; do
    b="${BACKUP_DIR}/$(printf '%03d' "$i")-$(basename "$f")"
    cp -p "$f" "$b"
    chmod 600 "$b"
    BACKUPS[i]="$b"
    if [ -f "${f}.pub" ]; then
        cp -p "${f}.pub" "${b}.pub"
    fi
    i=$((i + 1))
done

# --- rekey, rolling back everything already changed on any failure ---
echo "Rekeying..." >&2
i=0
for f in "${KEYS[@]}"; do
    if ssh-keygen -p -P "$CUR_PASS" -N "$NEW_PASS" -f "$f" > /dev/null; then
        echo "  rekeyed  $f" >&2
    else
        echo "  ERROR rekeying $f — rolling back all changes" >&2
        j=0
        while [ "$j" -le "$i" ]; do
            cp -p "${BACKUPS[$j]}" "${KEYS[$j]}"
            chmod 600 "${KEYS[$j]}"
            echo "  restored ${KEYS[$j]}" >&2
            j=$((j + 1))
        done
        echo "Rollback complete. Backups remain in $BACKUP_DIR" >&2
        exit 1
    fi
    i=$((i + 1))
done

# --- invalidate stale gnome-keyring (gcr) passphrase caches (step 5) ---
# gcr caches each key's passphrase as a Secret Service item keyed by
#   unique = ssh-store:<absolute-key-path>
# After the rekey that cached value is WRONG. Left in place, gcr feeds the old
# passphrase to ssh-add on every use; the decrypt fails and ssh-add busy-loops
# at ~100% CPU forever instead of re-prompting (observed: git push hangs, load
# average climbs). Clearing the entry makes gcr prompt once next time and
# re-cache the new passphrase. Best-effort: only when secret-tool is installed.
# Output is captured (not redirected to /dev/null) so a real failure is shown.
if command -v secret-tool >/dev/null; then
    echo "" >&2
    echo "Invalidating stale GNOME-keyring passphrase cache for rekeyed key(s)..." >&2
    for f in "${KEYS[@]}"; do
        abs="$(realpath -- "$f")"
        if clear_out="$(secret-tool clear unique "ssh-store:${abs}" 2>&1)"; then
            echo "  keyring cache cleared: $abs" >&2
        else
            echo "  keyring cache NOT cleared for $abs: ${clear_out}" >&2
        fi
    done
    echo "gcr will prompt for the new passphrase the next time each key is used." >&2
fi

echo "" >&2
echo "Done. Rekeyed ${#KEYS[@]} key(s)." >&2
echo "Backups kept in: $BACKUP_DIR" >&2
echo "Once you've confirmed the new passphrase works, you can remove that directory." >&2
