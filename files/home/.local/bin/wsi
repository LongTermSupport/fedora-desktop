#!/usr/bin/bash
#============================================================================
# WSI (Whisper Speech Input) Script
#============================================================================
# Speech-to-text backend script for the GNOME Shell extension.
#
# ARCHITECTURE:
#   GNOME Extension (extension.js)  -->  This Script (wsi)  -->  faster-whisper
#         |                                    |
#   Handles UI, hotkeys,              Records audio, calls
#   DBus signals, settings            transcriber, outputs text
#
# DEPLOYMENT:
#   Source:  files/home/.local/bin/wsi (this file)
#   Deploy:  ~/.local/bin/wsi
#   Via:     playbooks/imports/optional/common/play-speech-to-text.yml
#
# EXTENSION LOCATION:
#   Source:  extensions/speech-to-text@fedora-desktop/
#   Deploy:  ~/.local/share/gnome-shell/extensions/speech-to-text@fedora-desktop/
#
# The extension calls this script via GLib.spawn_command_line_async().
# Communication back to extension is via DBus signals (StateChanged, Error).
#============================================================================

#============================================================================
# USER CONFIGURATION
#============================================================================
TEMPD='/dev/shm'
ramf="$TEMPD/wfile-$USER.wav"
# The one home of batch mode's recording cap; scripts/qa-stt-limits.bash keeps it single
readonly MAX_RECORDING_SECONDS=30
WHISPERFILE="faster-whisper-transcribe"
CLIPBOARD=false
AUTO_PASTE=false
SKIP_AUTO_ENTER=false  # Auto-enter is ON by default in auto-paste mode
# When set ("0" or "1"), auto-paste uses the CLIPBOARD selection plus Ctrl+V (0) or
# Ctrl+Shift+V (1) instead of the legacy PRIMARY+Shift+Insert path. The extension
# sets this per focused window (browsers/Slack/Discord need Ctrl+V; terminals need
# Ctrl+Shift+V). Empty = legacy mode (PRIMARY + Shift+Insert) for backward compat
# when wsi is invoked directly from the shell.
PASTE_WITH_SHIFT=""
WRAP_MARKER=false
LANGUAGE=""  # Language code for Whisper (empty = use env var or default)
NO_NOTIFY=false  # Suppress desktop notifications
CLAUDE_PROCESS=false  # Post-process through Claude Code
CLAUDE_MODEL="sonnet"  # Claude model: sonnet, opus, haiku
CLAUDE_STYLE="corporate"  # Claude processing style: corporate, natural
WHOST="127.0.0.1"
WPORT="58080"

#============================================================================
# LOG FILE CONFIGURATION
#============================================================================
LOG_DIR="$HOME/.local/share/speech-to-text"
LOG_FILE="$LOG_DIR/debug.log"
MAX_LOG_SIZE=1048576  # 1MB - rotate when exceeded

#============================================================================
# PID FILE FOR SIGNAL HANDLING
#============================================================================
PID_FILE="$TEMPD/stt-recording-$USER.pid"
REC_PID=""

#============================================================================
# RUNTIME VARIABLES
#============================================================================
DEBUG=false
VERBOSE=false
IPnPORT=""
LOG_BUFFER=()  # Buffer for logs in non-debug mode

#============================================================================
# DBUS CONFIGURATION
#============================================================================
DBUS_PATH="/org/fedoradesktop/SpeechToText"
DBUS_INTERFACE="org.fedoradesktop.SpeechToText"
# The panel's own object: it says, for the window focused at that moment, which paste key
# it needs and whether to save after the paste (wsi-stream asks the same)
PANEL_DBUS_PATH="/org/fedoradesktop/SpeechToText/Panel"
PANEL_DBUS_INTERFACE="org.fedoradesktop.SpeechToText.Panel"

# The ydotool daemon's socket. WSI_YDOTOOL_SOCKET exists for the tests.
YDOTOOL_SOCKET_PATH="${WSI_YDOTOOL_SOCKET:-/run/ydotool.socket}"

#============================================================================
# LOGGING FUNCTIONS
#============================================================================

ensure_log_dir() {
    if [ ! -d "$LOG_DIR" ]; then
        mkdir -p "$LOG_DIR"
    fi

    # Rotate log if too large. The size is captured with its status intact: a
    # failing `stat` used to become the literal 0, which reads as "well under the
    # limit" and so silently disables rotation on a log that may be enormous.
    if [ -f "$LOG_FILE" ]; then
        local log_size
        if ! log_size=$(stat -c%s "$LOG_FILE" 2>&1); then
            echo "[WSI] WARNING: cannot read log size, not rotating: $log_size" >&2
        elif [ "$log_size" -gt "$MAX_LOG_SIZE" ]; then
            mv "$LOG_FILE" "${LOG_FILE}.old"
        fi
    fi
}

log_to_file() {
    local log_line
    log_line="[$(date '+%Y-%m-%dT%H:%M:%S')] [WSI] $*"

    if [ "$DEBUG" = true ] || [ "$VERBOSE" = true ]; then
        # Debug mode - write immediately
        ensure_log_dir
        echo "$log_line" >> "$LOG_FILE"
    else
        # Normal mode - buffer logs
        LOG_BUFFER+=("$log_line")
    fi
}

flush_log_buffer() {
    # Write buffered logs to disk
    local buffer_size=${#LOG_BUFFER[@]}
    if [ $buffer_size -gt 0 ]; then
        ensure_log_dir
        for line in "${LOG_BUFFER[@]}"; do
            echo "$line" >> "$LOG_FILE"
        done
        LOG_BUFFER=()
        echo $buffer_size  # Return count for caller
        return 0
    fi
    return 1
}

log() {
    echo "[WSI] $*" >&2
    log_to_file "$*"
}

log_debug() {
    if [ "$DEBUG" = true ] || [ "$VERBOSE" = true ]; then
        echo "[DEBUG] $*" >&2
        log_to_file "[DEBUG] $*"
    fi
}

log_error() {
    echo "[ERROR] $*" >&2
    log_to_file "[ERROR] $*"

    # Flush buffered logs on error
    if [ "$DEBUG" = false ]; then
        local flushed_count
        # flush_log_buffer returns 1 with no output when the buffer is empty, so
        # the fallback is stated explicitly rather than buried in the
        # substitution — and stderr is no longer discarded, so a log write that
        # actually fails is now visible instead of reading as "nothing to flush".
        flushed_count=$(flush_log_buffer) || flushed_count="0"
        if [ "$flushed_count" != "0" ]; then
            # Notify user that logs were saved
            notify_state "ERROR" "$*\n\n📝 Debug logs saved ($flushed_count entries):\n$LOG_FILE"
            # Write flush info to log (will go directly to file now)
            DEBUG=true log_to_file "Flushed $flushed_count buffered log entries to disk on error"
            DEBUG=false
        else
            # Send regular error notification
            notify_state "ERROR" "$*"
        fi
    else
        # Debug mode - logs already written, just notify
        notify_state "ERROR" "$*"
    fi

    # Send error signal for extension
    gdbus emit --session \
        --object-path "$DBUS_PATH" \
        --signal "${DBUS_INTERFACE}.Error" \
        "$*" 2>/dev/null &
}

#============================================================================
# NOTIFICATION AND DBUS SIGNALING
#============================================================================

NOTIFICATION_ID=0

# emit_state <state> — tell the panel extension, which sets its icon from it.
emit_state() {
    gdbus emit --session \
        --object-path "$DBUS_PATH" \
        --signal "${DBUS_INTERFACE}.StateChanged" \
        "$1" 2>/dev/null &
}

# emit_error <text> — the panel shows it beside the error state (its first 30 chars)
emit_error() {
    gdbus emit --session \
        --object-path "$DBUS_PATH" \
        --signal "${DBUS_INTERFACE}.Error" \
        "'$1'" 2>/dev/null &
}

notify_state() {
    local state="$1"
    local message="$2"
    local icon="${3:-audio-input-microphone}"

    log_debug "State: $state - $message"
    emit_state "$state"
    notify_desktop "$message" "$icon" 3000
}

# A desktop notification with no state change, for news the extension has no
# state for (the pending stop). Same replaceable notification as notify_state.
notify_desktop() {
    local message="$1"
    local icon="$2"
    local expire_ms="$3"

    # Skip desktop notification if --no-notify was passed
    if [ "$NO_NOTIFY" = true ]; then
        return
    fi

    # Send notification via gdbus so we can replace it.
    # Using a fixed app name ensures replacement works.
    #
    # An explicit fallback rather than `|| true`: a desktop that refuses the
    # notification must not stop a transcription, but the failure is noted at
    # debug level instead of vanishing, and `result` is emptied so the ID
    # extraction below cannot read a partial reply.
    local result
    result=$(gdbus call --session \
        --dest org.freedesktop.Notifications \
        --object-path /org/freedesktop/Notifications \
        --method org.freedesktop.Notifications.Notify \
        "speech-to-text" \
        "$NOTIFICATION_ID" \
        "$icon" \
        "Speech to Text" \
        "$message" \
        '[]' \
        '{}' \
        "$expire_ms" 2>/dev/null) || {
        result=""
        log_debug "Desktop notification was not accepted (gdbus call failed)"
    }

    # Extract notification ID for replacement
    if [[ "$result" =~ \(uint32\ ([0-9]+),\) ]]; then
        NOTIFICATION_ID="${BASH_REMATCH[1]}"
    fi
}

# paste_target_now — set PASTE_WITH_SHIFT and SAVE_AFTER for the window this dictation
# pastes into, as the panel's PasteKey judges it, and PASTE_TARGET to "ready", or to
# "closed" / "unfocused" when nothing may be pasted.
#
# The panel pins the window focused at Insert. If focus has moved, the panel gives it
# focus back and this asks again every 0.1 s, PASTE_FOCUS_POLLS times (about 2 s), then
# until the window has kept focus for PASTE_FOCUS_SETTLE_POLLS more answers, and sets
# PASTE_REFOCUSED so the Enter waits longer: the panel sees focus move the moment it
# activates the window, but the app takes it, and a terminal app redraws for it, a moment
# later (Plan 00164: pasted, but the Enter lost). The answer is (wm_class, with_shift,
# save_after, focused, gone); a panel that does not pin (loaded before that, until the
# next login) answers the first three. A panel that cannot answer (one loaded before
# PasteKey existed) leaves the key chosen at Insert, which is said in the log, and no save.
# "paste_target_now enter": asked again just before the Enter that follows a paste after
# a retake, and logged as such. It sets only PASTE_TARGET: the keys were chosen for the
# paste, and a panel that cannot answer then changes nothing.
SAVE_AFTER=false
PASTE_TARGET=ready
PASTE_REFOCUSED=false
PASTE_FOCUS_POLLS=20
PASTE_FOCUS_SETTLE_POLLS=5
PASTE_ENTER_DELAY_AFTER_REFOCUS=1.0
paste_target_now() {
    local before="${1:-paste}" reply rc why unfocused=0 settled=0
    local answer="^\('((\\\\.|[^'\\\\])*)', (true|false), (true|false)(, (true|false), (true|false))?\)$"
    while true; do
        if reply=$(timeout 2 gdbus call --session --dest org.gnome.Shell \
                --object-path "$PANEL_DBUS_PATH" --method "${PANEL_DBUS_INTERFACE}.PasteKey" 2>&1); then
            rc=0
        else
            rc=$?
        fi
        if [ "$rc" -ne 0 ] || ! [[ "$reply" =~ $answer ]]; then
            why="$reply"
            [ "$rc" -eq 124 ] && why="no answer within 2 s"
            PASTE_TARGET=ready
            if [ "$before" = enter ]; then
                log "WARN: The panel did not say whether the window has focus before the Enter ($why); sending it"
                return
            fi
            log "WARN: The panel did not say how to paste into the focused window ($why); using the key chosen at Insert"
            SAVE_AFTER=false
            return
        fi
        if [ "${BASH_REMATCH[7]}" = true ]; then
            PASTE_TARGET=closed
            return
        fi
        # Focused, or a panel that does not pin (no fourth field)
        if [ "${BASH_REMATCH[6]}" != false ]; then
            if [ "$unfocused" -eq 0 ] || [ "$settled" -eq "$PASTE_FOCUS_SETTLE_POLLS" ]; then
                PASTE_TARGET=ready
                if [ "$before" = enter ]; then
                    if [ -z "${BASH_REMATCH[6]}" ]; then
                        log "'${BASH_REMATCH[1]}': the panel does not pin focus, so it cannot say whether the window still has it; sending the Enter"
                    elif [ "$unfocused" -eq 0 ]; then
                        log "'${BASH_REMATCH[1]}' still has focus before the Enter"
                    else
                        log "'${BASH_REMATCH[1]}' has kept focus again; sending the Enter"
                    fi
                    return
                fi
                PASTE_WITH_SHIFT=$([ "${BASH_REMATCH[3]}" = true ] && echo 1 || echo 0)
                SAVE_AFTER="${BASH_REMATCH[4]}"
                log "Pasting into '${BASH_REMATCH[1]}': $([ "$PASTE_WITH_SHIFT" = 1 ] && echo Ctrl+Shift+V || echo Ctrl+V)$([ "$SAVE_AFTER" = true ] && echo ', then Ctrl+S')"
                return
            fi
            if [ "$settled" -eq 0 ]; then
                log "'${BASH_REMATCH[1]}' has focus back; $([ "$before" = enter ] && echo 'sending the Enter' || echo pasting) once it has kept it for $PASTE_FOCUS_SETTLE_POLLS more checks, 0.1 s apart"
            fi
            settled=$((settled + 1))
        else
            if [ "$unfocused" -eq 0 ] && [ "$before" = enter ]; then
                log "WARN: '${BASH_REMATCH[1]}' lost focus again after the paste; giving it focus back before the Enter"
            elif [ "$unfocused" -eq 0 ]; then
                log "WARN: '${BASH_REMATCH[1]}' lost focus during the dictation; waiting for the panel to give it focus back"
            elif [ "$settled" -gt 0 ]; then
                log "WARN: '${BASH_REMATCH[1]}' lost focus again before the $([ "$before" = enter ] && echo Enter || echo paste)"
            fi
            PASTE_REFOCUSED=true
            settled=0
            unfocused=$((unfocused + 1))
            if [ "$unfocused" -gt "$PASTE_FOCUS_POLLS" ]; then
                PASTE_TARGET=unfocused
                return
            fi
        fi
        sleep 0.1
    done
}

# paste_target_why — why the window pinned at Insert cannot take the keys (PASTE_TARGET
# "closed" or "unfocused"), printed for a message
paste_target_why() {
    if [ "$PASTE_TARGET" = closed ]; then
        echo "the window this dictation started in was closed"
    else
        echo "the window this dictation started in would not take focus back"
    fi
}

#============================================================================
# CLEANUP AND SIGNAL HANDLING
#============================================================================

STOP_REQUESTED=false

# signal_if_alive <signal> <pid> — signal a background process that may exit at any
# moment. A `kill -0` probe followed by `kill` is a race: the process can be reaped
# between the two, the kill then fails, and under `set -e` that ended the script (exit 1,
# recorder never stopped). The grace timer is the usual sender of the second TERM, so
# it is dying exactly when the trap that handles that TERM goes to cancel it.
signal_if_alive() {
    kill "-$1" "$2" 2>/dev/null || log_debug "Process $2 had already exited; $1 not delivered"
}

cleanup() {
    log_debug "Cleanup triggered"
    # Remove PID file
    rm -f "$PID_FILE"

    # Kill timer if still running (prevents orphaned background process)
    if [ -n "$TIMER_PID" ] && kill -0 "$TIMER_PID" 2>/dev/null; then
        signal_if_alive TERM "$TIMER_PID"
        log_debug "Killed timer process: $TIMER_PID"
    fi
    cancel_grace_timer

    # Signal idle state only if we're actually exiting (not just stopping recording)
    if [ "$STOP_REQUESTED" = false ]; then
        gdbus emit --session \
            --object-path "$DBUS_PATH" \
            --signal "${DBUS_INTERFACE}.StateChanged" \
            "IDLE" 2>/dev/null &
    fi
}

#----------------------------------------------------------------------------
# Delayed stop. The extension stops a recording with SIGTERM the moment Insert
# is pressed, which cut off the words still being spoken. The first TERM now
# starts a grace period (wsi-stop-grace, 0 = none) during which recording
# continues; a timer then sends TERM again, and a second TERM - from that timer
# or from a second Insert - stops at once. The trap returns straight away, so
# the main `wait` loop below is what keeps the recording going, and a second
# TERM is never deferred behind a sleep. INT (Ctrl+C) stays immediate, and the
# extension's Escape abort SIGKILLs the process tree, so neither waits.
#----------------------------------------------------------------------------
STOP_GRACE_SECONDS=""   # Set from wsi-stop-grace before recording starts
STOP_PENDING=false
RECORDING_OVER=false    # The recorder has exited; nothing left to keep open
GRACE_TIMER_PID=""

cancel_grace_timer() {
    if [ -n "$GRACE_TIMER_PID" ] && kill -0 "$GRACE_TIMER_PID" 2>/dev/null; then
        signal_if_alive TERM "$GRACE_TIMER_PID"
        log_debug "Cancelled stop-grace timer: $GRACE_TIMER_PID"
    fi
    GRACE_TIMER_PID=""
}

on_term() {
    # Unset grace (TERM before it was read) behaves as 0: stop now.
    # `return 0`, never a bare `return`: inside a trap a bare return reports the
    # status of the command the trap interrupted (the `wait`, 143), and under
    # `set -e` that ends the script before the recording is transcribed.
    # A press after the recorder has gone (e.g. during transcription) has nothing
    # to delay.
    if [ "$STOP_PENDING" = true ] || [ "$RECORDING_OVER" = true ] \
        || [ "${STOP_GRACE_SECONDS:-0}" -eq 0 ]; then
        stop_recording
        return 0
    fi
    STOP_PENDING=true
    log_debug "Stop requested - recording for ${STOP_GRACE_SECONDS}s more (TERM again stops now)"
    ( sleep "$STOP_GRACE_SECONDS"; kill -TERM $$ ) &
    GRACE_TIMER_PID=$!
    # STOPPING, not RECORDING: the panel shows the press was taken while the microphone
    # stays open for the grace.
    emit_state "STOPPING"
    notify_desktop "Stopping in ${STOP_GRACE_SECONDS}s - finish your sentence.\nInsert: stop now. Escape: discard." \
        "audio-input-microphone" "$((STOP_GRACE_SECONDS * 1000))"
}

stop_recording() {
    log_debug "Stop requested - sending SIGINT to rec process"
    STOP_REQUESTED=true
    cancel_grace_timer
    # Send SIGINT (like Ctrl+C) so rec flushes audio buffers before exiting
    if [ -n "$REC_PID" ] && kill -0 "$REC_PID" 2>/dev/null; then
        log_debug "Sending SIGINT to rec process $REC_PID"
        signal_if_alive INT "$REC_PID"
        # Wait for rec to actually exit and flush buffers
        for i in {1..20}; do
            if ! kill -0 "$REC_PID" 2>/dev/null; then
                log_debug "rec exited after ${i}0ms"
                break
            fi
            sleep 0.1
        done
    fi
}

# EXT-03: refuse to clobber a live recorder's PID file. If one already exists and
# its process is still alive, another instance is already recording. Bail here —
# BEFORE the EXIT-cleanup trap is installed (so we do not delete the live instance's
# PID file) and BEFORE pw-record starts (so we do not orphan a second recorder).
if [ -f "$PID_FILE" ]; then
    existing_pid=$(cat "$PID_FILE" 2>/dev/null) || existing_pid=""
    if [ -n "$existing_pid" ] && kill -0 "$existing_pid" 2>/dev/null; then
        log_debug "Another recorder is already running (PID $existing_pid); refusing to start a second"
        echo "wsi: already recording (PID $existing_pid); not starting a second recorder" >&2
        exit 1
    fi
    log_debug "Stale PID file found (no live process for ${existing_pid:-unknown}); will overwrite"
fi

# Trap EXIT for final cleanup
trap cleanup EXIT
# Trap TERM/INT to stop recording but continue script (TERM after the grace)
trap 'on_term' TERM
trap 'stop_recording' INT

#============================================================================
# UTILITY FUNCTIONS
#============================================================================

print_banner() {
    cat >&2 <<'EOF'
┌─────────────────────────────────────────────────────────────────┐
│  WSI - Whisper Speech Input v2.0 (Enhanced)                    │
│  Speech-to-text orchestrator for GNOME extension               │
└─────────────────────────────────────────────────────────────────┘
EOF
}

check_command() {
    local cmd="$1"
    local package="$2"
    local purpose="$3"

    if command -v "$cmd" &>/dev/null; then
        local version=""
        case "$cmd" in
            sox)
                version=$(sox --version 2>&1 | head -1)
                ;;
            curl)
                version=$(curl --version 2>&1 | head -1)
                ;;
            *)
                version="(installed)"
                ;;
        esac
        log_debug "  $cmd: $version"
        return 0
    else
        log_error "  $cmd: NOT FOUND"
        log_error "    Purpose: $purpose"
        log_error "    Install: sudo dnf install $package"
        return 1
    fi
}

check_dependencies() {
    log_debug "Checking dependencies..."
    local failed=0

    check_command "pw-record" "pipewire" "Audio recording (PipeWire)" || ((failed++))
    check_command "sox" "sox" "Audio resampling" || ((failed++))
    check_command "soxi" "sox" "Audio file info" || ((failed++))
    check_command "curl" "curl" "HTTP requests to whisper.cpp server" || ((failed++))

    local wm="${XDG_SESSION_TYPE:-unknown}"
    log_debug "Window manager: $wm"

    if [[ "$wm" == "wayland" ]]; then
        check_command "wl-copy" "wl-clipboard" "Clipboard management (Wayland)" || ((failed++))
        check_command "ydotool" "ydotool" "Auto-paste (Wayland/X11)" || ((failed++))
    elif [[ "$wm" == "x11" ]]; then
        check_command "xsel" "xsel" "Clipboard management (X11)" || ((failed++))
        check_command "ydotool" "ydotool" "Auto-paste (Wayland/X11)" || ((failed++))
    else
        log_error "Unknown window manager: $wm"
        ((failed++))
    fi

    if command -v "$WHISPERFILE" &>/dev/null; then
        local whisperfile_path
        whisperfile_path=$(command -v "$WHISPERFILE")
        log_debug "  $WHISPERFILE: $whisperfile_path"
    else
        log_error "  $WHISPERFILE: NOT FOUND in PATH"
        ((failed++))
    fi

    if [ -d "$TEMPD" ] && [ -w "$TEMPD" ]; then
        log_debug "  Temp directory: $TEMPD (writable)"
    else
        log_error "  Temp directory: $TEMPD (not writable)"
        ((failed++))
    fi

    if [ $failed -gt 0 ]; then
        log_error "Dependency check failed: $failed errors found"
        return 1
    fi

    log_debug "All dependencies satisfied"
    return 0
}

print_config() {
    local paste_mode="PRIMARY"
    [ "$CLIPBOARD" = true ] && paste_mode="CLIPBOARD"
    [ "$AUTO_PASTE" = true ] && paste_mode="AUTO-PASTE"
    # Resolved before the heredoc: an annotation inside one would be PRINTED,
    # and a failing `command -v` genuinely means the binary is not on PATH — so
    # the fallback states the failure rather than substituting a plausible path.
    local whisperfile_path
    whisperfile_path=$(command -v "$WHISPERFILE") || whisperfile_path="NOT FOUND"
    cat >&2 <<EOF
Configuration:
  Temp directory:     $TEMPD
  Temp audio file:    $ramf
  Whisperfile:        $WHISPERFILE ($whisperfile_path)
  Paste mode:         $paste_mode
  Window manager:     ${XDG_SESSION_TYPE:-unknown}
  Log file:           $LOG_FILE
EOF
}

usage() {
    cat >&2 <<'EOF'
Usage: wsi [OPTIONS]

Options:
  -c, --clipboard     Use CLIPBOARD instead of PRIMARY selection
  -a, --auto-paste    Type text directly at cursor (sends Enter by default)
  --no-auto-enter     Skip sending Enter/Return key after auto-paste
  --paste-with-shift N  Use CLIPBOARD + Ctrl+V (N=0) or Ctrl+Shift+V (N=1)
                      instead of legacy PRIMARY + Shift+Insert. Set by the
                      GNOME extension per focused window; omit when running
                      wsi from the shell to keep the legacy behaviour.
  -w, --wrap-marker   Wrap text with speech-to-text:"..." for LLM context
  -l, --language      Language code for transcription (e.g., 'en')
  -n, --netapi        Use whisper.cpp server (host:port from config)
  --no-notify         Suppress desktop notifications
  --claude-process    Post-process transcription through Claude Code
  --claude-model M    Claude model for processing (sonnet/opus/haiku)
  -d, --debug         Enable debug mode (verbose output + dependency checks)
  -v, --verbose       Enable verbose output only
  -h, --help          Show this help message

  IP:PORT             Use whisper.cpp server at specific address

Examples:
  wsi                 # Record speech and transcribe locally
  wsi -d              # Debug mode with full diagnostics
  wsi -c              # Use CLIPBOARD instead of PRIMARY
  wsi -a              # Auto-paste at cursor (includes Enter)
  wsi -a --no-auto-enter  # Auto-paste without Enter
  wsi -l en           # Force English language
  wsi server.local:8080  # Use remote whisper.cpp server
EOF
}

#============================================================================
# COMMAND LINE ARGUMENT PARSING
#============================================================================

while [ $# -gt 0 ]; do
    case "$1" in
        -c|--clipboard)
            CLIPBOARD=true
            log_debug "Clipboard mode: CLIPBOARD"
            shift
            ;;
        -a|--auto-paste)
            AUTO_PASTE=true
            log_debug "Auto-paste mode enabled"
            shift
            ;;
        --no-auto-enter)
            SKIP_AUTO_ENTER=true
            log_debug "Auto-enter disabled (will not send Enter after paste)"
            shift
            ;;
        --paste-with-shift)
            PASTE_WITH_SHIFT="$2"
            if [ "$PASTE_WITH_SHIFT" != "0" ] && [ "$PASTE_WITH_SHIFT" != "1" ]; then
                log_error "--paste-with-shift requires 0 (Ctrl+V) or 1 (Ctrl+Shift+V), got: $PASTE_WITH_SHIFT"
                exit 1
            fi
            if [ "$PASTE_WITH_SHIFT" = "1" ]; then
                log_debug "Paste mode: CLIPBOARD + Ctrl+Shift+V"
            else
                log_debug "Paste mode: CLIPBOARD + Ctrl+V"
            fi
            shift 2
            ;;
        -w|--wrap-marker)
            WRAP_MARKER=true
            log_debug "Wrap marker enabled"
            shift
            ;;
        -l|--language)
            LANGUAGE="$2"
            log_debug "Language set to: $LANGUAGE"
            shift 2
            ;;
        --no-notify)
            NO_NOTIFY=true
            log_debug "Desktop notifications disabled"
            shift
            ;;
        --claude-process)
            CLAUDE_PROCESS=true
            log_debug "Claude Code post-processing enabled"
            shift
            ;;
        --claude-model)
            CLAUDE_MODEL="$2"
            log_debug "Claude model set to: $CLAUDE_MODEL"
            shift 2
            ;;
        --claude-style)
            CLAUDE_STYLE="$2"
            log_debug "Claude style set to: $CLAUDE_STYLE"
            shift 2
            ;;
        -d|--debug)
            DEBUG=true
            VERBOSE=true
            log_debug "Debug mode enabled"
            shift
            ;;
        -v|--verbose)
            VERBOSE=true
            log_debug "Verbose mode enabled"
            shift
            ;;
        -n|--netapi)
            IPnPORT="$WHOST:$WPORT"
            http_code=$(curl -s -o /dev/null -w '%{http_code}' "$IPnPORT" 2>/dev/null)  # FAIL-FAST-OK: the -z branch below names empty as "connection failed" and exits 1
            if [[ -z "$http_code" ]] || [[ ! "$http_code" =~ ^2 ]]; then
                log_error "Can't connect to whisper.cpp server at $IPnPORT (HTTP: ${http_code:-connection failed})"
                exit 1
            fi
            log_debug "Using whisper.cpp server: $IPnPORT (HTTP $http_code)"
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            IPnPORT="$1"
            # Same probe as -n/--netapi above, in the same shape: a curl that
            # could not connect returns an empty code, which is reported as
            # "connection failed" rather than being collapsed into "not 200".
            http_code=$(curl -s -o /dev/null -w '%{http_code}' "$IPnPORT" 2>/dev/null)  # FAIL-FAST-OK: the -z branch below names empty as "connection failed" and exits 1
            if [[ -z "$http_code" ]] || [[ ! "$http_code" =~ ^2 ]]; then
                log_error "Can't connect to whisper.cpp server at $IPnPORT (HTTP: ${http_code:-connection failed})"
                exit 1
            fi
            log_debug "Using whisper.cpp server: $IPnPORT (HTTP $http_code)"
            shift
            ;;
    esac
done

#============================================================================
# DEBUG MODE INITIALIZATION
#============================================================================

if [ "$DEBUG" = true ]; then
    print_banner
    print_config
    echo "" >&2
    check_dependencies || exit 1
    echo "" >&2
    log "Starting speech recording with full debugging..."
fi

#============================================================================
# ERROR TRAP HANDLER
#============================================================================

trap_handler() {
    local exit_code=$?
    local line_no=$1
    local command="$BASH_COMMAND"

    log_error "Script failed at line $line_no: $command (exit code: $exit_code)"

    # Send error state via DBus
    notify_state "ERROR" "Script error (see log)"

    exit $exit_code
}

# Enable trap for debug mode
if [ "$DEBUG" = true ]; then
    trap 'trap_handler $LINENO' ERR
fi

#============================================================================
# FAIL FAST - PREFLIGHT SANITY CHECKS
#============================================================================
set -e

log_debug "Running preflight sanity checks..."

# Check critical commands exist
for cmd in pw-record sox soxi; do
    if ! command -v "$cmd" &>/dev/null; then
        log_error "Required command not found: $cmd"
        log_to_file "Install with: sudo dnf install $([ "$cmd" = "pw-record" ] && echo "pipewire" || echo "sox")"
        exit 1
    fi
done

# Check Whisper availability if not using network API
if [ -z "$IPnPORT" ]; then
    if ! command -v "$WHISPERFILE" &>/dev/null; then
        log_error "Whisper not found: $WHISPERFILE"
        log_to_file "Install with: pip install --user faster-whisper"
        exit 1
    fi
fi

# Check ydotool if in auto-paste mode
if [ "$AUTO_PASTE" = true ]; then
    if ! command -v ydotool &>/dev/null; then
        log_error "ydotool not found (required for auto-paste)"
        log_to_file "Install with: sudo dnf install ydotool"
        exit 1
    fi

    # Check socket exists
    if [ ! -S "$YDOTOOL_SOCKET_PATH" ]; then
        log_error "ydotool socket not found: $YDOTOOL_SOCKET_PATH"
        log_to_file "ydotool service not running"
        log_to_file "Fix: sudo systemctl restart ydotool"
        exit 1
    fi

    # Check socket is writable
    if [ ! -w "$YDOTOOL_SOCKET_PATH" ]; then
        log_error "ydotool socket not writable"
        log_to_file "Socket permissions: $(ls -l "$YDOTOOL_SOCKET_PATH" 2>&1)"
        log_to_file "Fix: sudo systemctl restart ydotool"
        exit 1
    fi
fi

# Check clipboard tools for non-auto-paste mode
if [ "$AUTO_PASTE" = false ]; then
    wm="${XDG_SESSION_TYPE:-unknown}"
    if [[ "$wm" == "wayland" ]]; then
        if ! command -v wl-copy &>/dev/null; then
            log_error "wl-copy not found (required for Wayland clipboard)"
            log_to_file "Install with: sudo dnf install wl-clipboard"
            exit 1
        fi
    elif [[ "$wm" == "x11" ]]; then
        if ! command -v xsel &>/dev/null; then
            log_error "xsel not found (required for X11 clipboard)"
            log_to_file "Install with: sudo dnf install xsel"
            exit 1
        fi
    fi
fi

# Check temp directory is writable
if [ ! -w "$TEMPD" ]; then
    log_error "Temp directory not writable: $TEMPD"
    exit 1
fi

# Check available disk space (need ~10MB for 30s recording)
available_space=$(df -k "$TEMPD" | tail -1 | awk '{print $4}')
if [ "$available_space" -lt 10240 ]; then
    log_error "Insufficient space in $TEMPD (${available_space}KB available, need 10MB)"
    notify_state "ERROR" "Disk space low - cannot record"
    exit 1
fi
log_debug "Available space: ${available_space}KB"

# Stop grace (see on_term). Read from the sibling reader so the extension's
# GSettings key stays the one source; a reader that fails means the install is
# incomplete, so recording does not start on a guessed value.
STOP_GRACE_READER="$(dirname "${BASH_SOURCE[0]}")/wsi-stop-grace"
if ! STOP_GRACE_SECONDS=$("$STOP_GRACE_READER"); then
    log_error "Cannot read the stop grace ($STOP_GRACE_READER failed; re-run play-speech-to-text.yml)"
    exit 1
fi
log_debug "Stop grace: ${STOP_GRACE_SECONDS}s"

# The model faster-whisper-transcribe loads. WHISPER_MODEL is the panel's Whisper
# Model setting (unset means auto); wsi-resolve-model says what auto means on this
# machine and hands over names older faster-whisper releases lack as their repo.
# Resolved before the microphone opens, so a failure costs no recording.
if [ -z "$IPnPORT" ]; then
    # One language for the resolver and the transcriber: --language (the extension
    # always passes it), else WHISPER_LANGUAGE, else the extension's language setting,
    # as the extension computes it. Exported, so faster-whisper-transcribe never falls
    # back to a different default of its own ("" means language detection in both).
    if [ -z "$LANGUAGE" ]; then
        if [ -n "${WHISPER_LANGUAGE+set}" ]; then
            LANGUAGE="$WHISPER_LANGUAGE"
        else
            SETTING_READER="$(dirname "${BASH_SOURCE[0]}")/wsi-setting"
            if ! language_setting=$("$SETTING_READER" language); then
                log_error "Cannot read the language setting ($SETTING_READER failed; reason above)"
                exit 1
            fi
            if [ "$language_setting" = system ]; then
                system_locale="${LANG:-en_GB.UTF-8}"
                LANGUAGE="${system_locale%%_*}"
            else
                LANGUAGE="$language_setting"
            fi
        fi
    fi
    export WHISPER_LANGUAGE="$LANGUAGE"

    # The resolver exits 3 when the model is not on disk (nothing is downloaded for the
    # user, and faster-whisper must not download it now); its last line says what to
    # download and where, and is the whole message the panel shows.
    MODEL_RESOLVER="$(dirname "${BASH_SOURCE[0]}")/wsi-resolve-model"
    resolver_err=$(mktemp)
    if resolved_model=$("$MODEL_RESOLVER" --mode batch \
            --language "$LANGUAGE" "${WHISPER_MODEL:-auto}" 2>"$resolver_err"); then
        resolver_rc=0
    else
        resolver_rc=$?
    fi
    resolver_said=$(cat "$resolver_err")
    rm -f "$resolver_err"
    if [ -n "$resolver_said" ]; then
        log_debug "$resolver_said"
    fi
    if [ "$resolver_rc" -eq 3 ]; then
        log_error "${resolver_said##*wsi-resolve-model: }"
        exit 1
    elif [ "$resolver_rc" -ne 0 ]; then
        log_error "Cannot choose the Whisper model ($MODEL_RESOLVER failed: $resolver_said)"
        exit 1
    fi
    export WHISPER_MODEL="$resolved_model"
    log_debug "Whisper model: $WHISPER_MODEL"
fi

log_debug "All preflight checks passed"

#============================================================================
# SPEECH RECORDING
#============================================================================

log_debug "Ready! Initializing audio pipeline..."

# Notify that we're preparing (orange icon)
notify_state "PREPARING" "Preparing to record..."

# Use pw-record (PipeWire native) for minimal buffering
# Records directly to wav at 44100Hz, low latency ensures audio is flushed on kill
if [ "$DEBUG" = true ]; then
    pw-record --rate 44100 --channels 2 --latency 50ms "$ramf" &
else
    pw-record --rate 44100 --channels 2 --latency 50ms "$ramf" 2>/dev/null &
fi
REC_PID=$!
log_debug "pw-record started with PID $REC_PID"

# Write PID file with shell PID so extension's SIGTERM triggers our trap
echo $$ > "$PID_FILE"
log_debug "PID file written: $PID_FILE ($$)"

# Brief delay to let audio pipeline initialize before signaling ready
# Prevents clipping the start of speech
sleep 0.3
log_debug "Audio pipeline ready, starting recording indicator"

# Now signal that we're actually recording (red icon + elapsed timer)
notify_state "RECORDING" "Recording... (Insert to stop)"

# Start the recording-limit timer in background
(
    sleep "$MAX_RECORDING_SECONDS"
    if kill -0 "$REC_PID" 2>/dev/null; then
        log_debug "${MAX_RECORDING_SECONDS}-second limit reached, auto-stopping recording"
        signal_if_alive INT "$REC_PID"
    fi
) &
TIMER_PID=$!
log_debug "${MAX_RECORDING_SECONDS}-second timer started with PID $TIMER_PID"

# Wait for recording to complete (or be killed). A non-zero status is the normal
# path — the timer above sends SIGINT — so it is recorded rather than discarded:
# `|| true` threw away the one number that distinguishes "stopped by the timer"
# from "the recorder died".
#
# A trapped signal makes `wait` return early (status > 128) with the recorder
# still running - that is the first TERM of a delayed stop - so it waits again
# until the recorder itself has gone.
REC_STATUS=0
while :; do
    REC_STATUS=0
    wait $REC_PID || REC_STATUS=$?
    if ! kill -0 "$REC_PID" 2>/dev/null; then
        break
    fi
    log_debug "wait interrupted (status $REC_STATUS); recorder $REC_PID still capturing"
done
RECORDING_OVER=true
log_debug "Recorder $REC_PID exited with status $REC_STATUS"

# Cancel the timers if recording stopped early
if kill -0 "$TIMER_PID" 2>/dev/null; then
    signal_if_alive TERM "$TIMER_PID"
    log_debug "Timer cancelled (recording stopped early)"
fi
cancel_grace_timer

log_debug "Recording complete: $ramf"

if [ ! -f "$ramf" ] || [ ! -s "$ramf" ]; then
    log_error "Recording file empty or missing: $ramf"
    notify_state "ERROR" "Recording failed"
    exit 1
fi

if [ -f "$ramf" ]; then
    size=$(du -h "$ramf" 2>/dev/null | cut -f1)  # FAIL-FAST-OK: used only in the debug log below, inside a branch that already proved the file exists
    log_debug "Audio file size: $size"
else
    log_error "Audio file not created: $ramf"
    notify_state "ERROR" "Recording failed"
    exit 1
fi

# Resample from 44100Hz to 16000Hz (whisper requirement)
log_debug "Resampling audio from 44100Hz to 16000Hz..."

if [ "$DEBUG" = true ]; then
    sox "$ramf" "${ramf}.resampled.wav" rate 16k
else
    sox "$ramf" "${ramf}.resampled.wav" rate 16k 2>/dev/null
fi
mv "${ramf}.resampled.wav" "$ramf"

# Check audio duration and pad if needed (whisper requires min 1 second).
#
# The status is checked because an unreadable duration and a duration of zero
# used to look identical: both left the variable empty, and the `-n` test below
# then skipped the padding step silently. Skipping is still the right fallback —
# it is better to attempt transcription than to abort — but a soxi that could
# not run now says so instead of disabling the minimum-length guarantee quietly.
audio_duration=""
if soxi_out=$(soxi -D "$ramf" 2>&1); then
    audio_duration="${soxi_out%%.*}"
else
    log_error "Could not read the audio duration (soxi): $soxi_out"
    log_error "  Skipping the minimum-length pad; transcription may reject short audio."
fi
log_debug "Audio duration: ${audio_duration}s"

if [ -n "$audio_duration" ] && [ "$audio_duration" -lt 1 ]; then
    log_debug "Audio too short, padding to 1 second..."
    sox "$ramf" "${ramf}.padded" pad 0 1 2>/dev/null
    mv "${ramf}.padded" "$ramf"
fi

#============================================================================
# SPEECH TRANSCRIPTION
#============================================================================

notify_state "TRANSCRIBING" "Transcribing..."
log_debug "Starting transcription..."

str=""
whisper_exit=0

if [ -n "$IPnPORT" ]; then
    log_debug "Using whisper.cpp server: $IPnPORT"

    str=$(curl -S -s "$IPnPORT/inference" \
        -H "Content-Type: multipart/form-data" \
        -F file="@$ramf" \
        -F temperature="0.0" \
        -F temperature_inc="0.2" \
        -F response_format="text") || whisper_exit=$?

    log_debug "curl exit code: $whisper_exit"

elif command -v "$WHISPERFILE" &>/dev/null; then
    log_debug "Using faster-whisper: $(command -v "$WHISPERFILE")"
    log_debug "Running: $WHISPERFILE $ramf (language: ${LANGUAGE:-default})"

    # Set language env var if specified
    if [ -n "$LANGUAGE" ]; then
        export WHISPER_LANGUAGE="$LANGUAGE"
    fi

    # Run transcription (batch mode - fast enough that streaming display isn't needed)
    set +e  # Temporarily disable errexit
    str="$("$WHISPERFILE" "$ramf" 2>/dev/null)"  # FAIL-FAST-OK: errexit is suspended around this deliberately and $? is read on the very next line
    whisper_exit=$?
    set -e  # Re-enable errexit

    log_debug "faster-whisper exit code: $whisper_exit"

    if [ $whisper_exit -ne 0 ]; then
        log_error "faster-whisper failed with exit code $whisper_exit"
        notify_state "ERROR" "Transcription failed (code $whisper_exit)"
        exit 1
    fi
else
    log_error "No transcription backend available!"
    log_error "Expected: $WHISPERFILE command in PATH"
    notify_state "ERROR" "No transcription backend"
    exit 1
fi

log_debug "Raw transcription: '$str'"

#============================================================================
# TEXT POST-PROCESSING
#============================================================================

# Remove non-speech artifacts detected by Whisper (non-greedy via sed)
str=$(echo "$str" | sed 's/([^)]*)//g; s/\[[^]]*\]//g')

# Remove leading newlines
str="${str#$'\n'}"
str="${str#$'\n'}"

# Remove leading whitespace and capitalize first letter
if [ -n "$BASH_VERSION" ]; then
    shopt -s extglob
    str="${str##+([[:space:]])}"
    str="${str^}"
else
    str="${str##+([[:space:]])}"
fi

if [ -z "$str" ]; then
    log_error "No transcription result (empty string)"
    log_debug "Possible causes:"
    log_debug "  - No speech detected in recording"
    log_debug "  - Background noise too high"
    log_debug "  - Microphone not working"
    notify_state "ERROR" "No speech detected" "dialog-warning"
    exit 1
fi

log_debug "Processed result: '$str'"

# Post-process through Claude Code if requested
if [ "$CLAUDE_PROCESS" = true ]; then
    log_debug "Post-processing through Claude Code (model: $CLAUDE_MODEL)"

    if command -v wsi-claude-process &>/dev/null; then
        # Call the Claude processing script
        claude_cmd_args=()
        claude_cmd_args+=("--model" "$CLAUDE_MODEL")
        claude_cmd_args+=("--style" "$CLAUDE_STYLE")
        [ "$DEBUG" = true ] && claude_cmd_args+=("--debug")
        claude_cmd_args+=("$str")

        # Never the raw text in Claude's place: on failure it goes to the clipboard,
        # unpasted, and the panel says why (wsi-claude-process prints the reason)
        claude_err=$(mktemp)
        claude_exit=0
        processed_str=$(wsi-claude-process "${claude_cmd_args[@]}" 2>"$claude_err") || claude_exit=$?
        claude_reason=$(tr '\n' ' ' <"$claude_err")
        rm -f "$claude_err"

        if [ "$claude_exit" -eq 0 ] && [ -n "$processed_str" ]; then
            log_debug "Claude processing successful"
            log_debug "Original: '$str'"
            log_debug "Processed: '$processed_str'"
            str="$processed_str"
        else
            claude_reason="${claude_reason#wsi-claude-process: }"
            claude_reason="${claude_reason:-exit $claude_exit, no output}"
            log_error "Claude post-processing failed: $claude_reason"
            echo -n "$str" | wl-copy
            emit_error "Claude: ${claude_reason//\'/}"
            emit_state "ERROR"
            notify_desktop "Claude post-processing failed: $claude_reason. Nothing was pasted. The raw transcript is on the clipboard: Ctrl+V." "dialog-error" 0
            exit 1
        fi
    else
        log_error "wsi-claude-process not found (re-run play-speech-to-text.yml)"
        emit_state "ERROR"
        exit 1
    fi
fi

# Wrap with speech-to-text marker if requested
# BUT: Don't wrap Claude-processed text - it's already clean and formatted
if [ "$WRAP_MARKER" = true ] && [ "$CLAUDE_PROCESS" = false ]; then
    str="speech-to-text:\"$str\""
    log_debug "Wrapped with marker: '$str'"
elif [ "$WRAP_MARKER" = true ] && [ "$CLAUDE_PROCESS" = true ]; then
    log_debug "Skipping marker wrap - Claude processed text is already clean"
fi

#============================================================================
# SAVE TRANSCRIPTION TO FILE
#============================================================================

# Save transcribed text to cache file for later access
TRANSCRIPTION_FILE="$HOME/.cache/speech-to-text/last-transcription.txt"
mkdir -p "$(dirname "$TRANSCRIPTION_FILE")"
echo "$str" > "$TRANSCRIPTION_FILE"
log_debug "Transcription saved to: $TRANSCRIPTION_FILE"

#============================================================================
# CLIPBOARD OUTPUT
#============================================================================

# Check if running in a graphics environment
if [[ -z "${DISPLAY}" ]] && [[ -z "${WAYLAND_DISPLAY}" ]] && [[ -z "${DESKTOP_SESSION}" ]]; then
    echo "$str"
    exit 0
fi

wm="${XDG_SESSION_TYPE:-unknown}"

# Handle auto-paste mode
# Two paste paths:
#   1. PASTE_WITH_SHIFT set ("0" or "1") - extension-driven path:
#      copy to CLIPBOARD selection, then simulate Ctrl+V or Ctrl+Shift+V, as the panel's
#      PasteKey says for the window pinned at Insert once it has focus (the key chosen at
#      Insert if it cannot say), then Enter, then Ctrl+S if the panel asks for a save.
#      That window closed, or never given focus back: the text stays on the clipboard.
#   2. PASTE_WITH_SHIFT empty - legacy direct-shell path:
#      copy to PRIMARY selection, then simulate Shift+Insert (works almost
#      everywhere but loses the per-app distinction the extension makes).
if [ "$AUTO_PASTE" = true ]; then
    if [ -n "$PASTE_WITH_SHIFT" ]; then
        paste_target_now
        log_debug "Auto-pasting text via CLIPBOARD + $([ "$PASTE_WITH_SHIFT" = "1" ] && echo "Ctrl+Shift+V" || echo "Ctrl+V")"
    else
        log_debug "Auto-pasting text via PRIMARY selection + Shift+Insert (legacy)"
    fi
    log_debug "Text length: ${#str} characters"
    log_debug "Text preview: ${str:0:100}"

    # Double-check socket still exists (in case service crashed)
    if [ ! -S "$YDOTOOL_SOCKET_PATH" ]; then
        log_error "ydotool socket disappeared before paste"
        log_to_file "Service may have crashed during recording"
        exit 1
    fi

    # Copy text to the correct selection target for the chosen paste keys
    if [ -n "$PASTE_WITH_SHIFT" ]; then
        case "$wm" in
            "wayland")
                echo -n "$str" | wl-copy
                log_debug "Text copied to CLIPBOARD selection (Wayland)"
                ;;
            "x11")
                echo -n "$str" | xsel -ib
                log_debug "Text copied to CLIPBOARD selection (X11)"
                ;;
            *)
                log_error "Unknown window manager for clipboard: $wm"
                exit 1
                ;;
        esac
    else
        case "$wm" in
            "wayland")
                echo -n "$str" | wl-copy -p
                log_debug "Text copied to PRIMARY selection (Wayland)"
                ;;
            "x11")
                echo -n "$str" | xsel -ip
                log_debug "Text copied to PRIMARY selection (X11)"
                ;;
            *)
                log_error "Unknown window manager for clipboard: $wm"
                exit 1
                ;;
        esac
    fi

    # The window pinned at Insert cannot take the paste: the text stays on the clipboard
    if [ "$PASTE_TARGET" != ready ]; then
        unpasted_why=$(paste_target_why)
        # log_error tells the panel ERROR; the notification then replaces its own with one
        # that stays
        log_error "Nothing was pasted: $unpasted_why"
        notify_desktop "Nothing was pasted: $unpasted_why. The text is on the clipboard: Ctrl+V." "dialog-error" 0
        exit 1
    fi

    # Brief delay to ensure selection is ready
    sleep 0.05

    # Simulate the paste keys via ydotool.
    # Key codes (linux/input-event-codes.h):
    #   29 = Left Ctrl, 42 = Left Shift, 47 = V, 110 = Insert
    # Format: keycode:1 = press, keycode:0 = release.
    if [ "$PASTE_WITH_SHIFT" = "1" ]; then
        log_debug "Simulating Ctrl+Shift+V paste"
        if ! YDOTOOL_SOCKET="$YDOTOOL_SOCKET_PATH" ydotool key 29:1 42:1 47:1 47:0 42:0 29:0; then
            exit_code=$?
            log_error "ydotool Ctrl+Shift+V simulation failed (exit code: $exit_code)"
            exit 1
        fi
    elif [ "$PASTE_WITH_SHIFT" = "0" ]; then
        log_debug "Simulating Ctrl+V paste"
        if ! YDOTOOL_SOCKET="$YDOTOOL_SOCKET_PATH" ydotool key 29:1 47:1 47:0 29:0; then
            exit_code=$?
            log_error "ydotool Ctrl+V simulation failed (exit code: $exit_code)"
            exit 1
        fi
    else
        log_debug "Simulating Shift+Insert paste"
        if ! YDOTOOL_SOCKET="$YDOTOOL_SOCKET_PATH" ydotool key 42:1 110:1 110:0 42:0; then
            exit_code=$?
            log_error "ydotool key simulation failed (exit code: $exit_code)"
            exit 1
        fi
    fi
    log_debug "Paste simulated successfully"
    # Delay to ensure paste completes before sending Enter
    if [ "$PASTE_REFOCUSED" = true ] && [ "$SKIP_AUTO_ENTER" = false ]; then
        log "Waiting ${PASTE_ENTER_DELAY_AFTER_REFOCUS} s before the Enter: focus was given back for this paste"
        sleep "$PASTE_ENTER_DELAY_AFTER_REFOCUS"
        # Focus can move away again after the retake (Plan 00164): asked again, the panel
        # gives it back once more, or there is no window to send the Enter (or save) to
        paste_target_now enter
        if [ "$PASTE_TARGET" != ready ]; then
            unsent_why=$(paste_target_why)
            log_error "The text was pasted but not sent: $unsent_why"
            notify_desktop "The text was pasted but not sent: $unsent_why. No Enter was pressed." "dialog-error" 0
            exit 1
        fi
    else
        sleep 0.3
    fi

    # Send Enter key by default in auto-paste mode (unless disabled)
    if [ "$SKIP_AUTO_ENTER" = false ]; then
        log_debug "Simulating Enter key (default behavior)"
        # Key code: 28 = Enter/Return
        if ! YDOTOOL_SOCKET="$YDOTOOL_SOCKET_PATH" ydotool key 28:1 28:0; then
            exit_code=$?
            log_error "ydotool Enter key simulation failed (exit code: $exit_code)"
            # Don't exit - paste already succeeded
        else
            log_debug "Enter key simulated successfully"
        fi
    else
        log_debug "Enter key skipped (--no-auto-enter)"
    fi

    # After the paste has landed: a failed save is reported, but the paste stands.
    # Never asked for a terminal, where Ctrl+S is XOFF and freezes the screen.
    if [ "$SAVE_AFTER" = true ]; then
        # Key codes: 29 = Left Ctrl, 31 = S
        if YDOTOOL_SOCKET="$YDOTOOL_SOCKET_PATH" ydotool key 29:1 31:1 31:0 29:0; then
            log "Save simulated via Ctrl+S"
        else
            log_error "The text was pasted but the save (Ctrl+S) failed (exit code: $?)"
        fi
    fi

    preview="${str:0:60}"
    [ ${#str} -gt 60 ] && preview="${preview}..."
    notify_state "SUCCESS" "$preview"
else
    # Clipboard mode
    log_debug "Sending to clipboard (window manager: $wm)"
    case "$wm" in
        "x11")
            if [ "$CLIPBOARD" = true ]; then
                echo "$str" | xsel -ib
                log_debug "Text sent to CLIPBOARD"
            else
                echo "$str" | xsel -ip
                log_debug "Text sent to PRIMARY selection"
            fi
            ;;
        "wayland")
            if [ "$CLIPBOARD" = true ]; then
                echo "$str" | wl-copy
                log_debug "Text sent to CLIPBOARD"
            else
                echo "$str" | wl-copy -p
                log_debug "Text sent to PRIMARY selection"
            fi
            ;;
        *)
            log_error "Unknown window manager: $wm"
            echo "$str"
            ;;
    esac

    # Send success notification with preview
    preview="${str:0:60}"
    [ ${#str} -gt 60 ] && preview="${preview}..."

    if [ "$CLIPBOARD" = true ]; then
        notify_state "SUCCESS" "$preview\n\nCtrl+V to paste"
    else
        notify_state "SUCCESS" "$preview\n\nMiddle-click to paste"
    fi
fi

# Signal idle state after brief delay
(sleep 2 && gdbus emit --session \
    --object-path "$DBUS_PATH" \
    --signal "${DBUS_INTERFACE}.StateChanged" \
    "IDLE" 2>/dev/null) &

# Cleanup temporary files
rm -f "$ramf" "${ramf}.resampled.wav" "${ramf}.padded"

log_debug "WSI completed successfully"

exit 0
