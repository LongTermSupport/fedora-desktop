#!/usr/bin/env bash
# ccy-teams — see the agent teams on this machine and look after them: each team's
# homeserver, its members, the people in its room, and the ccy sessions in its seats. It is
# to teams what ccy-sessions is to sessions (Plan 00161, Plan 00177; docs/agent-bus.md,
# "Getting started").
#
# A team is declared in the untracked host_vars localhost.yml (agent_bus_teams) and made by
# play-agent-bus.yml. A ccy session joins one with `ccy --teams <seat>@<team>`, an LXC
# container's agent through agent_bus_lxc_members. ccy-teams holds no team logic of its own:
# it acts through agent-bus, agent-bus-install, ccy and the session registry. It edits the
# host_vars only to add a team (create) or to declare one absent (remove), and every such
# change is applied at once: it runs play-agent-bus.yml for that team alone (its own
# shebang, through run.bash's single-play mode), so no team is left declared but not built.
#
# Each team is a row (its homeserver up, down or not installed yet, its port, and APPLIED:
# whether what runs is what the host_vars declare, DESIGN.md D65), followed by its members:
#   ccy                    a seat of a ccy checkout, with the ccy session holding it and
#                          whether that session is started again after a reboot
#   lxc, host, docker, vm  a member of that type; a ccy member whose checkout is not
#                          known here (no session or registry record names it) is "ccy"
#                          with no checkout
#   human                  a person in the team room: in it or not, and how many Element
#                          sessions they are signed in with
# Keys, shown in the picker's header too (? there shows them all, explained):
#   Enter    on a seat: attach its session (as ccy-sessions does); on a person: set a new
#            Element password and show the login; on a team: this help
#   Ctrl-N   start a new ccy session in a free or new seat of the row's team, here
#   Ctrl-P   a new Element password for the person on the row
#   Ctrl-E   open the team in Element
#   Ctrl-U   update every team that is out of date or not built (never one to take down)
#   Ctrl-R   turn the seat's session's restore after a reboot off or on
#   Ctrl-X   remove a seat, park a member, or take a team down (each after a yes/no)
#   Esc, q   leave
# With no team on this machine, the picker offers to create one; with a team out of date, it
# offers to update it first.
#
# Reading the members needs root (the team's admin token is root's). play-agent-bus.yml
# installs a sudoers rule that lets you run exactly `agent-bus list` and `agent-bus human
# devices` without a password; where that rule is not installed yet and sudo needs a
# password, the picker says why before sudo asks, and stops, saying so, when sudo is
# refused. --list never asks: without sudo it shows the members as "need sudo", and, as with
# any part of the table it could not read, it still prints the rest but exits 1.
#
# Usage:
#   ccy-teams                        the picker (needs a terminal)
#   ccy-teams -l|--list              print the same table, with a heading, and exit
#                                    (colour only on a terminal, and never with NO_COLOR)
#   ccy-teams create [--org ORG] [--team T] [--human NAME]... [--allow-from CIDR]... [--yes]
#                                    add a team to agent_bus_teams in the host_vars and
#                                    install it. On a terminal it asks (with gum) for what
#                                    the flags leave out: the GitHub org (or user) the team
#                                    works within, whose every repository its agents may
#                                    send each other to; the name (the org's, by default);
#                                    the people in the team room (you, by default); other
#                                    machines' subnets. It shows the entry and asks once,
#                                    then writes it and runs play-agent-bus.yml for it,
#                                    and says it is done only when the team's homeserver
#                                    is up. --yes asks nothing: give --org, --team and
#                                    --human. The port is chosen for you
#   ccy-teams apply <team> | --all   run play-agent-bus.yml for the team (or every team
#                                    out of date or not built), then check each now
#                                    matches its declaration. --all never takes a team
#                                    down: a team declared absent, or built but no longer
#                                    declared, needs your decision (ccy-teams remove)
#   ccy-teams remove <team>          take a team down, on a terminal only: it says what is
#                                    lost, offers a backup first, and keeps the team's data
#                                    unless you choose to delete it and type its name
#   ccy-teams backup <team>          back the team's homeserver up now
#   ccy-teams restore <team> [<n>] [--yes]
#                                    restore backup <n> after a yes/no (--yes: none);
#                                    without <n>, choose one from the list
#   ccy-teams -h|--help              this text
#
# Backups stay on this machine (docs/agent-bus.md, "Backups are the root of trust").
# The APPLIED column, from `declare.py status` against the installer's stamps (readable
# without sudo): up to date, out of date (config, software or both), not built, removed,
# or needs your decision (declared absent but still built, or built but not declared).
# Exit 64 for a usage mistake, 130 when cancelled, 1 for a refusal or a failure.
#
# Runs on the HOST, as the desktop user.
set -euo pipefail

# The fedora-desktop checkout this was deployed from (play-claude-yolo.yml): create's
# helper and the host_vars are there.
ROOT_DIR="{{ root_dir }}"
CCY_LIB="${CCY_LIB:-/var/local/claude-yolo/lib}"
# The test points these at stand-ins; nothing else should set them.
HOST_VARS="${CCY_TEAMS_HOST_VARS:-${ROOT_DIR}/environment/localhost/host_vars/localhost.yml}"
CCY_LAUNCHER="${CCY_TEAMS_LAUNCHER:-/var/local/claude-yolo/claude-yolo}"
# The play that applies a team (run by its own shebang), and where agent-bus-install
# leaves each applied team's stamp.
PLAY="${CCY_TEAMS_PLAY:-${ROOT_DIR}/playbooks/imports/play-agent-bus.yml}"
ELEMENT_PLAY="${CCY_TEAMS_ELEMENT_PLAY:-${ROOT_DIR}/playbooks/imports/optional/common/play-agent-bus-element.yml}"
APPLIED_DIR="${CCY_TEAMS_APPLIED_DIR:-/var/lib/agent-bus-applied}"
# What ccy-teams has offered once and been told no: it does not ask again.
DECLINED_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/ccy-teams/declined"
# Root's commands are named by path: sudo's secure_path need not hold /usr/local.
SUDO_AGENT_BUS=/usr/local/bin/agent-bus
SUDO_INSTALLER=/usr/local/sbin/agent-bus-install
MAX_TRIES=3

usage() {
    awk 'NR == 1 { next } /^#/ { print substr($0, 3); next } { exit }' "${BASH_SOURCE[0]}"
}

usage_error() {
    echo "ccy-teams: $1 See ccy-teams --help." >&2
    exit 64
}

subcommand="${1:-}"
case "${subcommand}" in
"" | create | apply | remove | backup | restore) ;;
-l | --list)
    if [[ $# -gt 1 ]]; then
        usage_error "'${subcommand}' takes no further arguments."
    fi
    ;;
-h | --help)
    usage
    exit 0
    ;;
*)
    usage_error "unknown option '${subcommand}'."
    ;;
esac
if [[ -n "${subcommand}" ]]; then
    shift
fi

if [[ ! -f "${CCY_LIB}/tmux-session.bash" ]]; then
    if [[ -d /workspace ]]; then
        echo "ccy-teams runs on the host, not inside a CCY container." >&2
    else
        echo "CCY is not installed here (${CCY_LIB}/tmux-session.bash missing). Run playbooks/imports/play-claude-yolo.yml." >&2
    fi
    exit 1
fi
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../../../var/local/claude-yolo/lib/common-pure.bash
source "${CCY_LIB}/common-pure.bash"
# shellcheck source=../../../var/local/claude-yolo/lib/session-registry.bash
source "${CCY_LIB}/session-registry.bash"
# shellcheck source=../../../var/local/claude-yolo/lib/tmux-session.bash
source "${CCY_LIB}/tmux-session.bash"

need_checkout() {
    if [[ ! -f "${ROOT_DIR}/helpers/agent_bus/declare.py" ]]; then
        print_error "the fedora-desktop checkout ccy-teams was deployed from (${ROOT_DIR}) has gone; re-run playbooks/imports/play-claude-yolo.yml from where it is now."
        exit 1
    fi
}

project_here() {
    local probe
    probe="$(git rev-parse --is-inside-work-tree 2>&1)" && [[ "${probe}" == "true" ]]
}

# declare_helper <args...> — helpers/agent_bus/declare.py from the checkout.
declare_helper() {
    PYTHONPATH="${ROOT_DIR}" python3 -P -m helpers.agent_bus.declare "$@"
}

# ── colour and sudo ──────────────────────────────────────────────────────────────────────

# colour_on <fd> — colour is for a terminal, and never with NO_COLOR (no-color.org): piped
# output stays plain text, column for column.
colour_on() {
    [[ -t "$1" && -z "${NO_COLOR:-}" ]]
}
C_RESET=$'\e[0m'
C_BOLD=$'\e[1m'
C_GREEN=$'\e[32m'
C_YELLOW=$'\e[33m'
C_RED=$'\e[31m'
C_PINK=$'\e[38;5;212m'

# word_colour <status word> — the colour a status cell is shown in: green is well, yellow
# wants a look, red is not working.
word_colour() {
    case "$1" in
    free | invited | no | parked | "never signed in" | *"(stopped)") printf '%s' "${C_YELLOW}" ;;
    up | active | held | "in room" | yes | *" signed in") printf '%s' "${C_GREEN}" ;;
    "out of date"* | "not built") printf '%s' "${C_YELLOW}" ;;
    "up to date") printf '%s' "${C_GREEN}" ;;
    down* | "not installed" | "not in room" | unknown | "need sudo" | "decide:"* | unreadable) printf '%s' "${C_RED}" ;;
    esac
}

# say <text> — a heading line on stderr, bold on a terminal.
say() {
    if colour_on 2; then
        printf '%s%s%s\n' "${C_BOLD}" "$1" "${C_RESET}" >&2
    else
        printf '%s\n' "$1" >&2
    fi
}

# sudo_ready <why> — sudo's credential for the root commands that follow. Passwordless or
# cached sudo asks nothing. Otherwise <why> is said first, then sudo asks for your login
# password. Returns 1, saying so, when sudo is not given it (three wrong passwords, Ctrl-C)
# or there is no terminal to ask on: the caller then says what could not be done, and
# never carries on as if the root command had answered.
sudo_ready() {
    local probe
    if probe="$(sudo -n -v 2>&1)"; then
        return 0
    fi
    if [[ ! -t 0 || ! -t 2 ]]; then
        print_error "$1 That needs sudo, and with no terminal there is nowhere to ask for your password (sudo said: ${probe}). Run sudo -v first."
        return 1
    fi
    printf '\n' >&2
    say "$1"
    echo "sudo asks for your login password." >&2
    if ! sudo -v; then
        print_error "sudo was not given your password (three wrong tries, or cancelled)."
        return 1
    fi
}

# ── a person's sign-in: create offers it, and the picker's Enter and Ctrl-P ─────────────

# show_login <team> <name> <password> — everything needed to sign in to Element, once; then,
# in a Wayland session, a copy to the clipboard. wl-copy is a dependency there
# (play-claude-yolo.yml installs it); with no Wayland session there is no clipboard to offer.
# Callers run this as a condition, where set -e does not reach, so each failure is checked.
show_login() {
    local team="$1" name="$2" password="$3"
    printf '\n' >&2
    say "Element sign-in for ${name}, team ${team}"
    printf '  %-11s %s\n' "Homeserver" "${URL_OF[${team}]:-unknown (not declared)}" "Username" "${name}" \
        "Matrix ID" "@${name}:${SERVER_OF[${team}]:-${team}.agent-bus.internal}" >&2
    if colour_on 2; then
        printf '  %-11s %s%s%s\n' "Password" "${C_BOLD}" "${password}" "${C_RESET}" >&2
    else
        printf '  %-11s %s\n' "Password" "${password}" >&2
    fi
    echo "Shown this once and stored nowhere. The team's Element profile has the homeserver set already." >&2
    [[ -n "${WAYLAND_DISPLAY:-}" ]] || return 0
    if [[ -z "$(command -v wl-copy)" ]]; then
        print_error "wl-copy is not installed, so the password cannot be put on the clipboard; copy it from above. playbooks/imports/play-claude-yolo.yml installs wl-clipboard."
        return 0
    fi
    if ccy_tmux_confirm "Copy the password?" \
        "Put ${name}'s new password on the clipboard, to paste into Element. A clipboard manager may keep a copy." \
        "copy the password"; then
        if printf '%s' "${password}" | wl-copy; then
            echo "The password is on the clipboard." >&2
        else
            print_error "wl-copy failed (above), so the password is not on the clipboard; copy it from above."
        fi
    fi
}

# new_password <team> <name> — set a person's Element password and show it (the yes is the
# caller's). Returns 1 when none was set.
new_password() {
    local team="$1" name="$2" password
    if ! sudo_ready "A password is set as root, by agent-bus (the team's admin token is root's)."; then
        echo "No password was set for ${name}." >&2
        return 1
    fi
    if ! password="$(sudo -n "${SUDO_AGENT_BUS}" human password "${team}" "${name}")"; then
        echo "No password was set for ${name}, for the reason above." >&2
        return 1
    fi
    show_login "${team}" "${name}" "${password}"
}

# set_password <team> <name> — a new Element password for a person of the team, after a yes
# that says what it does. Returns 1 when none was set.
set_password() {
    if ! ccy_tmux_confirm "New Element password for $2?" \
        "Sets a new password for $2 on $1's homeserver and shows it here, once: it is stored nowhere. $2's other Element sessions are signed out." \
        "set a new password for $2"; then
        echo "No password was set for $2." >&2
        return 1
    fi
    new_password "$1" "$2"
}

# ── Element: the team's profile, declared by declare.py and written by its play ──────────

element_launcher() {
    printf '%s\n' "${HOME}/.local/share/applications/agent-bus-$1-element.desktop"
}

# run_element_play — play-agent-bus-element.yml, by its own shebang as run_play does: it
# installs Element Desktop and writes a profile and launcher for every
# agent_bus_element_teams entry. Then each named team's launcher must be there.
run_element_play() {
    local team
    say "Running play-agent-bus-element.yml: it installs Element Desktop (sudo) and writes the Element profile for $*."
    if ! "${ELEMENT_PLAY}"; then
        print_error "play-agent-bus-element.yml failed (above), so $* has no Element profile yet."
        return 1
    fi
    for team in "$@"; do
        if [[ ! -f "$(element_launcher "${team}")" ]]; then
            print_error "play-agent-bus-element.yml finished, but ${team}'s Element launcher is not there."
            return 1
        fi
    done
}

# element_teams <team>... — those of the named teams that have an Element profile declared.
element_teams() {
    local lines team
    declare -A wanted=()
    for team in "$@"; do wanted["${team}"]=1; done
    lines="$(declare_helper element-teams --file "${HOST_VARS}")" || return 1
    while IFS=$'\t' read -r _ team _; do
        [[ -z "${team}" || -z "${wanted[${team}]:-}" ]] || printf '%s\n' "${team}"
    done <<<"${lines}"
}

# set_up_element <team> — declare the team's Element profile and run its play.
set_up_element() {
    declare_helper element --file "${HOST_VARS}" --team "$1" >/dev/null || return 1
    run_element_play "$1"
}

# ── create: the questions, asked with gum; declare.py checks and writes ──────────────────

cancelled() {
    echo "Cancelled; nothing was changed." >&2
    exit 130
}

# need_tool <command> <what installs it> — a hard dependency: missing is a failure, never a
# reason to fall back to something plainer.
need_tool() {
    if [[ -z "$(command -v "$1")" ]]; then
        print_error "$1 is not installed, and ccy-teams needs it here. $2 installs it; run that play and try again."
        exit 1
    fi
}

# need_gum — gum, a hard dependency, in high-contrast colours. gum's defaults draw headers,
# placeholders and prompts in 240-range greys that are barely legible on a black terminal,
# so every element a person reads is set here, once, through gum's own environment
# variables: near-white text, and a bright pink (212) or blue (39) for what is active.
need_gum() {
    need_tool gum playbooks/imports/play-claude-yolo.yml
    export GUM_INPUT_HEADER_FOREGROUND=255 GUM_INPUT_PROMPT_FOREGROUND=39 \
        GUM_INPUT_PLACEHOLDER_FOREGROUND=250 GUM_INPUT_CURSOR_FOREGROUND=212
    export GUM_FILTER_HEADER_FOREGROUND=255 GUM_FILTER_PROMPT_FOREGROUND=39 \
        GUM_FILTER_PLACEHOLDER_FOREGROUND=250 GUM_FILTER_TEXT_FOREGROUND=252 \
        GUM_FILTER_CURSOR_TEXT_FOREGROUND=255 GUM_FILTER_INDICATOR_FOREGROUND=212 \
        GUM_FILTER_SELECTED_PREFIX_FOREGROUND=212 GUM_FILTER_UNSELECTED_PREFIX_FOREGROUND=252 \
        GUM_FILTER_MATCH_FOREGROUND=39
    export GUM_CONFIRM_PROMPT_FOREGROUND=255 GUM_CONFIRM_SELECTED_FOREGROUND=16 \
        GUM_CONFIRM_SELECTED_BACKGROUND=212 GUM_CONFIRM_UNSELECTED_FOREGROUND=255 \
        GUM_CONFIRM_UNSELECTED_BACKGROUND=24
    # gum's key-help line is drawn in a fixed dim grey no flag recolours (0.17, measured), so
    # it is hidden; the questions and the yes/no buttons say what to press.
    export GUM_INPUT_SHOW_HELP=false GUM_FILTER_SHOW_HELP=false GUM_CONFIRM_SHOW_HELP=false \
        GUM_CHOOSE_SHOW_HELP=false
    export GUM_SPIN_TITLE_FOREGROUND=255 GUM_SPIN_SPINNER_FOREGROUND=212
    export GUM_CHOOSE_HEADER_FOREGROUND=255 GUM_CHOOSE_ITEM_FOREGROUND=252 \
        GUM_CHOOSE_CURSOR_FOREGROUND=212 GUM_CHOOSE_SELECTED_FOREGROUND=212
}

# explain <text> [indent] — the explanation before a question, wrapped to the terminal (a
# gum --header is not wrapped, so headers stay one short line), in near-white.
explain() {
    local cols
    if ! cols="$(tput cols 2>&1)" || [[ ! "${cols}" =~ ^[0-9]+$ ]] || ((cols < 44)); then
        cols=80 # a width is only layout: with none to read, a common one serves
    fi
    gum style --foreground 252 --width "$((cols - 4))" --padding "0 0 0 ${2:-0}" "$1" >&2
}

# step <title> <hint> — a question's numbered heading and its hint, indented under it.
# STEP counts up; STEPS is how many questions this run asks.
STEP=0 STEPS=0
step() {
    STEP=$((STEP + 1))
    printf '\n' >&2
    if colour_on 2; then
        printf '%s%s %d/%d  %s%s\n' "${C_BOLD}" "${C_PINK}" "${STEP}" "${STEPS}" "$1" "${C_RESET}" >&2
    else
        printf '%d/%d  %s\n' "${STEP}" "${STEPS}" "$1" >&2
    fi
    explain "$2" 5
}

# answered <value> — the answer, kept on screen under its step once gum's prompt has gone.
answered() {
    if colour_on 2; then
        printf '     %s✓%s %s\n' "${C_GREEN}" "${C_RESET}" "$1" >&2
    else
        printf '     ✓ %s\n' "$1" >&2
    fi
}

# gum_ask <header> <placeholder> <value> — one line of input; prints it. gum 0.17 exits 1 on
# Esc and 130 on Ctrl-C (measured); both are a cancel here. In gum filter Esc does not leave
# (measured), and Ctrl-C exits 130; in gum confirm Esc is a no (1).
gum_ask() {
    gum input --header "$1" --placeholder "$2" --value "$3" --width 0
}

# ask_valid <checker> <header> <placeholder> <value> — ask until <checker> <answer> accepts
# it (it prints the problem on stderr when it does not), MAX_TRIES at most. Prints the
# answer; returns 130 when cancelled, 1 when every try was refused.
ask_valid() {
    local checker="$1" header="$2" placeholder="$3" value="$4" answer try
    for ((try = 1; try <= MAX_TRIES; try++)); do
        answer="$(gum_ask "${header}" "${placeholder}" "${value}")" || return 130
        answer="${answer#"${answer%%[![:space:]]*}"}"
        answer="${answer%"${answer##*[![:space:]]}"}"
        # The checker's output is for the person, never part of the answer.
        if "${checker}" "${answer}" >&2; then
            printf '%s\n' "${answer}"
            return 0
        fi
        value="${answer}"
    done
    echo "Giving up after ${MAX_TRIES} tries; nothing was changed." >&2
    return 1
}

# ask_or_quit — the status of an ask_valid: 130 cancels, any other failure ends the run.
ask_or_quit() {
    case "$1" in
    0) ;;
    130) cancelled ;;
    *) exit 1 ;;
    esac
}

# say_problem <declare's message> — a refused value, as a person would say it.
say_problem() {
    echo "  ${1#declare: }. Try again." >&2
}

check_team() {
    local problem
    if [[ -z "$1" ]]; then
        say_problem "the team needs a name"
        return 1
    fi
    problem="$(declare_helper check --file "${HOST_VARS}" --team "$1" 2>&1)" || {
        say_problem "${problem}"
        return 1
    }
}

# split_commas <text> — one name per line.
split_commas() {
    local part
    while read -r -d , part; do
        [[ -z "${part// /}" ]] || printf '%s\n' "${part// /}"
    done <<<"$1,"
}

check_humans() {
    local -a flags=()
    local name problem
    while read -r name; do
        [[ -z "${name}" ]] || flags+=(--human "${name}")
    done <<<"$(split_commas "$1")"
    if [[ -z "${flags[*]:-}" ]]; then
        say_problem "name at least one person; your own login name is the usual answer"
        return 1
    fi
    problem="$(declare_helper check --file "${HOST_VARS}" "${flags[@]}" 2>&1)" || {
        say_problem "${problem}"
        return 1
    }
}

# check_owner <owner> — a GitHub user or organisation that exists (GitHub's names are not
# case-sensitive, so it is checked lower-cased, as the team file holds it).
check_owner() {
    local owner="${1,,}" problem
    problem="$(declare_helper check --file "${HOST_VARS}" --org "${owner}" 2>&1)" || {
        say_problem "${problem}"
        return 1
    }
    if ! gum spin --title "Looking up ${owner} on GitHub…" -- gh api "users/${owner}" --silent; then
        say_problem "GitHub has no user or organisation called '${owner}' that your gh login can see"
        return 1
    fi
}

check_subnets() {
    local -a flags=()
    local cidr problem
    while read -r cidr; do
        [[ -z "${cidr}" ]] || flags+=(--allow-from "${cidr}")
    done <<<"$(split_commas "$1")"
    [[ -n "${flags[*]:-}" ]] || return 0
    problem="$(declare_helper check --file "${HOST_VARS}" "${flags[@]}" 2>&1)" || {
        say_problem "${problem}"
        return 1
    }
}

# the_remote_repo — this checkout's GitHub OWNER/REPO, lower-case; nothing outside one.
the_remote_repo() {
    local url
    project_here || return 0
    url="$(git remote get-url origin 2>&1)" || return 0
    declare_helper github-remote --url "${url}"
}

# check_repos <list> — comma-separated OWNER/REPO, each well formed, on GitHub, and one your
# gh login can push to (GitHub's own answer for that login: the repository's
# permissions.push). Every entry that fails is named, with why; then the list as a whole is
# checked against the team file's limits.
check_repos() {
    local repo push bad=0 problem
    local -a flags=()
    while read -r repo; do
        [[ -n "${repo}" ]] || continue
        repo="${repo,,}"
        flags+=(--repo "${repo}")
        if ! problem="$(declare_helper check --file "${HOST_VARS}" --repo "${repo}" 2>&1)"; then
            echo "  ${repo}: not OWNER/REPO (lower-case; the name not ., .. or ending .git)." >&2
            bad=1
            continue
        fi
        echo "  Checking ${repo} on GitHub…" >&2
        if ! push="$(gh api "repos/${repo}" --jq .permissions.push 2>&1)"; then
            echo "  ${repo}: not found, or your gh login cannot see it." >&2
            bad=1
        elif [[ "${push}" != true ]]; then
            echo "  ${repo}: read-only for your gh login; a team trusts only repositories you can push to." >&2
            bad=1
        fi
    done <<<"$(split_commas "$1")"
    if [[ -z "${flags[*]:-}" ]]; then
        say_problem "name at least one repository, as owner/repo"
        return 1
    fi
    [[ "${bad}" -eq 0 ]] || {
        echo "  Try again." >&2
        return 1
    }
    problem="$(declare_helper check --file "${HOST_VARS}" "${flags[@]}" 2>&1)" || {
        say_problem "${problem}"
        return 1
    }
}

# The most repositories a team may list (protocol.py REPOS_MAX; declare.py check enforces it).
REPOS_MAX=32
# Create's scope choices, in words.
SCOPE_ONE="One repository" SCOPE_OWNER="Everything one GitHub owner owns" SCOPE_SEVERAL="Several repositories"

# create_wizard [flags] — the questions, for what the flags leave out, then a summary and
# a yes before declare.py writes. Each answer is checked as it is given.
create_wizard() {
    local team="" yes=false text owner="" default_team login probe name rc scope="" here trusts
    local -a humans=() allow_from=() flags=() repos=() choices=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
        --yes) yes=true ;;
        --team | --human | --org | --repo | --allow-from)
            [[ $# -ge 2 ]] || usage_error "create's $1 needs a value."
            case "$1" in
            --team) team="$2" ;;
            --human) humans+=("$2") ;;
            --org) owner="${2,,}" ;;
            --repo) repos+=("${2,,}") ;;
            --allow-from) allow_from+=("$2") ;;
            esac
            shift
            ;;
        *) usage_error "unknown create option '$1'." ;;
        esac
        shift
    done
    here="$(the_remote_repo)"
    if [[ "${yes}" == false ]]; then
        if [[ ! -t 0 || ! -t 2 ]]; then
            usage_error "'create' asks its questions on a terminal; without one give every value as a flag, and --yes."
        fi
        need_gum
        [[ -n "${owner}" || -n "${repos[*]:-}" ]] || need_gh
        gum style --bold --border rounded --padding "0 1" "New agent team" >&2
        explain "Agents and people working together in one private room on this machine, which you follow in Element. Ctrl-C leaves at any point; nothing changes until you say yes at the end."
        # What the team trusts is two questions (which kind, then which) unless a flag says.
        [[ -n "${owner}" || -n "${repos[*]:-}" ]] || STEPS=$((STEPS + 2))
        [[ -n "${team}" ]] || STEPS=$((STEPS + 1))
        [[ -n "${humans[*]:-}" ]] || STEPS=$((STEPS + 1))
        [[ -n "${allow_from[*]:-}" ]] || STEPS=$((STEPS + 1))
    fi
    # What the team works on first: its name defaults to that.
    if [[ -z "${owner}" && -z "${repos[*]:-}" && "${yes}" == false ]]; then
        # Inside a checkout the repository is the default; elsewhere the whole owner.
        if [[ -n "${here}" ]]; then
            choices=("${SCOPE_ONE}: ${here}" "${SCOPE_OWNER}: ${here%%/*}" "${SCOPE_SEVERAL}")
        else
            choices=("${SCOPE_OWNER}" "${SCOPE_ONE}" "${SCOPE_SEVERAL}")
        fi
        step "What the team works on" "Its agents may point each other only at these repositories, on any branch. Anything else reaches them as outside content, marked so."
        rc=0
        scope="$(gum choose --header "Trust" --selected "${choices[0]}" "${choices[@]}")" || rc=$?
        [[ "${rc}" -eq 0 && -n "${scope}" ]] || cancelled
        answered "${scope}"
        case "${scope}" in
        "${SCOPE_OWNER}"*)
            step "GitHub owner" "The organisation or user the team works for: all of its repositories, never forks."
            rc=0
            owner="$(ask_valid check_owner "GitHub owner (organisation or user)" "e.g. example-org" "${here%%/*}")" || rc=$?
            ask_or_quit "${rc}"
            owner="${owner,,}"
            answered "${owner}"
            ;;
        *)
            if [[ "${scope}" == "${SCOPE_SEVERAL}" ]]; then
                step "Repositories" "owner/repo, comma-separated: up to ${REPOS_MAX} of any owners, each one your gh login can push to."
            else
                step "Repository" "owner/repo: one your gh login can push to."
            fi
            rc=0
            text="$(ask_valid check_repos "Repositories (owner/repo, comma-separated)" "e.g. example-org/alpha" "${here}")" || rc=$?
            ask_or_quit "${rc}"
            mapfile -t repos <<<"$(split_commas "${text,,}")"
            answered "${repos[*]}"
            ;;
        esac
    fi
    if [[ -z "${team}" && "${yes}" == false ]]; then
        default_team=""
        if [[ -n "${owner}" ]]; then
            default_team="$(declare_helper suggest-team --file "${HOST_VARS}" --name "${owner}")"
        elif [[ -n "${repos[*]:-}" ]]; then
            default_team="$(declare_helper suggest-team --file "${HOST_VARS}" --name "${repos[0]#*/}")"
        fi
        step "Team name" "Used in the room's name and its agents' names: a-z, 0-9 and -, up to 24."
        rc=0
        team="$(ask_valid check_team "Team name" "e.g. example-org" "${default_team}")" || rc=$?
        ask_or_quit "${rc}"
        answered "${team}"
    fi
    if [[ -z "${humans[*]:-}" && "${yes}" == false ]]; then
        login="$(id -un)"
        if ! probe="$(declare_helper check --file "${HOST_VARS}" --human "${login}" 2>&1)"; then
            echo "Your login name, ${login}, cannot be an account name here (${probe#declare: }), so there is no default." >&2
            login=""
        fi
        step "People" "Each gets an Element login to the room; the installer creates the accounts. Add others after a comma."
        rc=0
        text="$(ask_valid check_humans "People, comma-separated" "e.g. ${login:-yourname}, colleague" "${login}")" || rc=$?
        ask_or_quit "${rc}"
        mapfile -t humans <<<"$(split_commas "${text}")"
        answered "${humans[*]}"
    fi
    if [[ -z "${allow_from[*]:-}" && "${yes}" == false ]]; then
        step "Other machines" "Usually none: ccy sessions are on this machine. Only for LXC containers or other machines running agents, their subnet."
        rc=0
        text="$(ask_valid check_subnets "Subnets (Enter for none)" "e.g. 192.0.2.0/24" "")" || rc=$?
        ask_or_quit "${rc}"
        mapfile -t allow_from <<<"$(split_commas "${text}")"
        answered "${allow_from[*]:-none, this machine only}"
    fi
    [[ -z "${team}" ]] || flags+=(--team "${team}")
    for name in "${humans[@]}"; do [[ -z "${name}" ]] || flags+=(--human "${name}"); done
    [[ -z "${owner}" ]] || flags+=(--org "${owner}")
    for name in "${repos[@]}"; do [[ -z "${name}" ]] || flags+=(--repo "${name}"); done
    for name in "${allow_from[@]}"; do [[ -z "${name}" ]] || flags+=(--allow-from "${name}"); done
    if [[ "${yes}" == false ]]; then
        # The dry run checks the whole entry before anything is asked or written.
        declare_helper create --file "${HOST_VARS}" "${flags[@]}" --dry-run >/dev/null || exit
        if [[ -n "${owner}" ]]; then
            trusts="everything ${owner} owns: any repository, any branch"
        else
            trusts="$(printf '%s, ' "${repos[@]}")"
            trusts="${trusts%, }: any branch"
        fi
        printf '\n' >&2
        summary_confirm "Team ${team}" "$(printf '%-9s %s\n' \
            "Works on" "${trusts}" \
            "People" "${humans[*]}" \
            "Machines" "${allow_from[*]:-this one only}" \
            "Element" "a profile for the team, set up on this desktop")" \
            "Create team ${team}? (saved to ${HOST_VARS/#${HOME}/\~}, then installed: sudo asks for your password)"
    fi
    declare_helper create --file "${HOST_VARS}" "${flags[@]}"
    # Element is set up with the team (Task 4.2): its profile is declared beside it, and
    # apply runs its play.
    declare_helper element --file "${HOST_VARS}" --team "${team}" >/dev/null
    if ! apply_teams "${team}"; then
        print_error "team ${team} is declared in ${HOST_VARS/#${HOME}/\~} but not installed. Once the cause above is fixed, ccy-teams apply ${team} installs it."
        exit 1
    fi
    [[ "${yes}" == true ]] || after_create "${team}" "${humans[@]}"
    declare_helper next-steps --file "${HOST_VARS}" --team "${team}" >&2
    [[ "${yes}" == true ]] || offer_join "${team}"
}

# after_create <team> <human>... — straight after create, on a terminal: each person's
# sign-in (Task 4.3), then Element opened (Task 4.2).
after_create() {
    local team="$1" name
    shift
    for name in "$@"; do
        [[ -n "${name}" ]] || continue
        if ask_yes "Sign ${name} in to Element now? A password is set and shown here once." true; then
            new_password "${team}" "${name}" || true # it has said why; the team is made either way
        fi
    done
    if ask_yes "Open ${team} in Element now?" true; then
        gio launch "$(element_launcher "${team}")"
    fi
}

# join_candidates — the teams this checkout's repository belongs to, by name, each once.
join_candidates() {
    local here lines
    here="$(the_remote_repo)"
    [[ -n "${here}" ]] || return 0
    lines="$(declare_helper teams-for --file "${HOST_VARS}" --repo "${here}")" || return 1
    awk -F '\t' '$1 == "TEAM" { print $2 }' <<<"${lines}"
}

# offer_join <team> — in a checkout of the team's repositories, offer to start a ccy session
# here as a member (Task 4.4): ccy --teams <team>, no seat, so ccy chooses one and says it.
offer_join() {
    local team="$1" top candidate
    project_here || return 0
    candidate="$(join_candidates)" || return 0
    grep -qxF -- "${team}" <<<"${candidate}" || return 0
    top="$(git rev-parse --show-toplevel)"
    if ask_yes "Start a ccy session in ${top/#${HOME}/\~} as a member of ${team}?" true; then
        echo "Starting ccy --teams ${team} in ${top/#${HOME}/\~}." >&2
        cd "${top}"
        exec "${CCY_LAUNCHER}" --teams "${team}"
    fi
}

# need_gh — gh installed and logged in: the org is looked up on GitHub.
need_gh() {
    local probe
    need_tool gh playbooks/imports/play-git-configure-and-tools.yml
    if ! probe="$(gh auth status 2>&1)"; then
        print_error "gh is not logged in to GitHub, and the org is looked up there (gh said: ${probe}). Run gh auth login, then try again."
        exit 1
    fi
}

# summary_confirm <title> <lines to add> <question> — what will be written, in a box, then a
# yes, which covers writing the entry and installing the team. Default yes: the file is backed
# up first. No (or Esc) exits 1, Ctrl-C 130, both having changed nothing.
summary_confirm() {
    local rc=0
    gum style --border rounded --padding "0 1" "$1" "" "$2" >&2
    gum confirm --default=true "$3" || rc=$?
    case "${rc}" in
    0) ;;
    1)
        echo "Nothing was added." >&2
        exit 1
        ;;
    *) cancelled ;;
    esac
}

cmd_create() {
    need_checkout
    create_wizard "$@"
}

# ── apply and remove: the play for named teams, then the stamps read back (D65) ──────────

# The applied state of every team declared or built, from declare.py status: STATUS_OF is
# current, outdated, unbuilt, removed, decide or unreadable; DETAIL_OF says what differs, or
# why. LOADED (collect_teams) names the teams whose homeserver exists.
declare -A STATUS_OF=() DETAIL_OF=()
read_status() {
    local lines team state detail
    local -a installed=()
    for team in "${!LOADED[@]}"; do installed+=(--installed "${team}"); done
    lines="$(declare_helper status --file "${HOST_VARS}" --source "${ROOT_DIR}" --applied "${APPLIED_DIR}" \
        "${installed[@]}")" || {
        print_error "whether each team is applied as declared could not be read (the reason is above)."
        return 1
    }
    STATUS_OF=() DETAIL_OF=()
    while IFS=$'\t' read -r _ team state detail; do
        [[ -n "${team}" ]] || continue
        STATUS_OF["${team}"]="${state}"
        DETAIL_OF["${team}"]="${detail}"
    done <<<"${lines}"
}

# status_word <team> — the APPLIED column, in words.
status_word() {
    local detail="${DETAIL_OF[$1]:-}"
    case "${STATUS_OF[$1]:-}" in
    current) printf 'up to date' ;;
    outdated)
        case "${detail}" in
        unstamped) printf 'out of date' ;;
        config,software) printf 'out of date: both' ;;
        *) printf 'out of date: %s' "${detail}" ;;
        esac
        ;;
    unbuilt) printf 'not built' ;;
    removed) printf 'removed' ;;
    decide) [[ "${detail}" == absent ]] && printf 'decide: absent' || printf 'decide: undeclared' ;;
    unreadable) printf 'unreadable' ;;
    *) printf 'unknown' ;;
    esac
}

# refresh — the teams and their applied state, read again.
refresh() {
    TEAMS=() PORT_OF=() URL_OF=() SERVER_OF=() LOADED=()
    collect_teams && read_status
}

# run_play <team>... — play-agent-bus.yml for those teams alone (agent_bus_only_teams), run
# by the play's own shebang, which is run.bash's single-play mode: it knows how this machine
# gives Ansible its sudo password. Its output is streamed.
run_play() {
    local json
    json="$(python3 -c 'import json, sys; print(json.dumps({"agent_bus_only_teams": sys.argv[1:]}))' "$@")"
    say "Running play-agent-bus.yml for $*: it starts each team's homeserver, and creates its room and its people's accounts."
    "${PLAY}" -e "${json}"
}

# apply_teams <team>... — the play for those teams, then each one's stamp read back: done
# only when every one is up to date (its homeserver started, its room and people made).
apply_teams() {
    local team rc=0
    local -a behind=() watched=()
    run_play "$@" || rc=$?
    if [[ "${rc}" -ne 0 ]]; then
        print_error "play-agent-bus.yml failed (exit ${rc}, above)."
        return 1
    fi
    refresh || return 1
    for team in "$@"; do
        [[ "${STATUS_OF[${team}]:-}" == current ]] || behind+=("${team} ($(status_word "${team}"))")
    done
    if [[ -n "${behind[*]:-}" ]]; then
        print_error "the play finished, but these teams are still not as declared: ${behind[*]}."
        return 1
    fi
    # A team with an Element profile declared has it written by its own play, here too.
    team="$(element_teams "$@")" || return 1
    [[ -z "${team}" ]] || mapfile -t watched <<<"${team}"
    if [[ -n "${watched[*]:-}" ]] && ! run_element_play "${watched[@]}"; then
        print_error "the homeserver side is applied, but the Element profile is not; once the cause above is fixed, ccy-teams apply $* runs both again."
        return 1
    fi
    say "Applied: $*."
}

# cmd_apply <team> | --all — bring a team, or every team out of date or not built, to what
# the host_vars declare. Never a team declared absent or no longer declared: taking a team
# down is ccy-teams remove's, one team at a time.
cmd_apply() {
    local team
    local -a targets=() waiting=() broken=()
    need_checkout
    [[ $# -eq 1 ]] || usage_error "'apply' takes one team, or --all."
    refresh || exit 1
    if [[ "$1" == --all ]]; then
        for team in "${!STATUS_OF[@]}"; do
            case "${STATUS_OF[${team}]}" in
            outdated | unbuilt) targets+=("${team}") ;;
            decide) waiting+=("${team} ($(status_word "${team}"))") ;;
            unreadable) broken+=("${team}: ${DETAIL_OF[${team}]}") ;;
            esac
        done
        if [[ -n "${broken[*]:-}" ]]; then
            print_error "these teams' entries cannot be read, so nothing was applied: ${broken[*]}."
            exit 1
        fi
        [[ -z "${waiting[*]:-}" ]] ||
            echo "Left alone, as they need your decision (ccy-teams remove <team>, or declare them again): ${waiting[*]}." >&2
        if [[ -z "${targets[*]:-}" ]]; then
            echo "No team is out of date or waiting to be built." >&2
            return 0
        fi
        mapfile -t targets < <(printf '%s\n' "${targets[@]}" | sort)
    else
        team="$1"
        case "${STATUS_OF[${team}]:-}" in
        outdated | unbuilt | current) targets=("${team}") ;;
        decide | removed) usage_error "team ${team} is not declared present; ccy-teams remove ${team} takes a team down." ;;
        unreadable) usage_error "team ${team}'s entry cannot be read: ${DETAIL_OF[${team}]}." ;;
        *) usage_error "team ${team} is not declared in ${HOST_VARS/#${HOME}/\~}." ;;
        esac
    fi
    if ! apply_teams "${targets[@]}"; then
        print_error "not applied: ${targets[*]}. Their entries stay as declared; once the cause above is fixed, ccy-teams apply runs the play again."
        exit 1
    fi
}

# ask_yes <question> <default> — gum confirm: 0 yes, 1 no, Ctrl-C cancels the run.
ask_yes() {
    local rc=0
    gum confirm --default="$2" "$1" || rc=$?
    case "${rc}" in
    0 | 1) return "${rc}" ;;
    *) cancelled ;;
    esac
}

# cmd_remove <team> — take one team down, on a terminal, after saying what is lost: a backup
# first (yes by default), then down with its data kept, unless the human chooses to delete
# it and types the team's name. Never with --yes, never in bulk (owner, 2026-10-13).
cmd_remove() {
    local team="${1:-}" state choice typed purge=false
    local -a purge_flag=()
    need_checkout
    [[ $# -eq 1 && "${team}" != -* ]] || usage_error "'remove' takes one team (and no --yes: it always asks)."
    [[ -t 0 && -t 2 ]] || usage_error "'remove' asks on a terminal, always: taking a team down is a human's decision."
    need_gum
    refresh || exit 1
    state="${STATUS_OF[${team}]:-}"
    case "${state}" in
    "" | removed | unbuilt) usage_error "team ${team} is not built here; there is nothing to take down." ;;
    unreadable) usage_error "team ${team}'s entry cannot be read: ${DETAIL_OF[${team}]}." ;;
    esac
    gum style --bold --border rounded --padding "0 1" "Take team ${team} down" >&2
    explain "Its homeserver and its backup timer stop: its agents and people can no longer reach it. Its data (the room's whole history, the accounts, the backups) stays on this machine unless you choose to delete it, which cannot be undone. There may be history in it worth keeping."
    if ask_yes "Back ${team} up first?" true; then
        sudo_ready "A backup is taken as root, by agent-bus-install." || exit 1
        if ! sudo "${SUDO_INSTALLER}" backup-now --team "${team}"; then
            print_error "the backup failed (above), so ${team} was not taken down."
            exit 1
        fi
    fi
    choice="$(gum choose --header "What happens to ${team}?" "Take it down, keep its data" \
        "Take it down and delete its data" "Leave it running")" || cancelled
    case "${choice}" in
    "Take it down, keep its data") ;;
    "Take it down and delete its data")
        typed="$(gum_ask "Type ${team} to delete its data for good" "the team's name" "")" || cancelled
        if [[ "${typed}" != "${team}" ]]; then
            echo "That is not the team's name; nothing was changed." >&2
            exit 1
        fi
        purge=true
        purge_flag=(--purge)
        ;;
    *)
        echo "Nothing was changed." >&2
        exit 1
        ;;
    esac
    if [[ "${DETAIL_OF[${team}]:-}" == undeclared ]]; then
        # Not in the host_vars, so the play cannot take it: the installer does, as the play would.
        sudo_ready "A team that is not declared is taken down as root, by agent-bus-install." || exit 1
        sudo "${SUDO_INSTALLER}" remove --team "${team}" "${purge_flag[@]}" || {
            print_error "${team} was not taken down (above)."
            exit 1
        }
    else
        declare_helper remove --file "${HOST_VARS}" --team "${team}" "${purge_flag[@]}"
        if ! run_play "${team}"; then
            print_error "${team} is declared absent in ${HOST_VARS/#${HOME}/\~} but is still running; once the cause above is fixed, ccy-teams remove ${team} runs the play again."
            exit 1
        fi
    fi
    refresh || exit 1
    if [[ "${STATUS_OF[${team}]:-}" != removed && -n "${STATUS_OF[${team}]:-}" ]]; then
        print_error "${team} is still $(status_word "${team}") after the play."
        exit 1
    fi
    if [[ "${purge}" == true ]]; then
        say "Team ${team} is down and its data deleted."
    else
        say "Team ${team} is down; its data is kept in /var/lib/agent-bus/${team}."
    fi
}

# ── backup, restore: thin wrappers ───────────────────────────────────────────────────────

cmd_backup() {
    [[ $# -eq 1 && "$1" != -* ]] || usage_error "'backup' takes one team."
    sudo_ready "A backup is taken as root, by agent-bus-install." || exit 1
    sudo "${SUDO_INSTALLER}" backup-now --team "$1"
}

# pick_backup <team> <listing> — choose one of the team's backups in the picker; prints its
# number, or returns 1 when none was chosen.
pick_backup() {
    local team="$1" listing="$2" rows="" id when picked
    while IFS=$'\t' read -r _ id when; do
        rows+="$(printf 'Backup %-6s %s' "${id}" "${when}")"$'\n'
    done <<<"${listing}"
    picked="$(ccy_tmux_pick "Restore ${team}" "$(ccy_tmux_header "Enter choose   Esc or q exit" \
        "The homeserver is stopped, the backup's database and state put back, and it is started again.")" \
        "" <<<"${rows%$'\n'}")" || return 1
    picked="${picked#*$'\n'}"
    picked="${picked#Backup }"
    printf '%s\n' "${picked%% *}"
}

cmd_restore() {
    local team="" id="" yes=false listing
    while [[ $# -gt 0 ]]; do
        case "$1" in
        --yes) yes=true ;;
        -*) usage_error "unknown restore option '$1'." ;;
        *)
            if [[ -z "${team}" ]]; then
                team="$1"
            elif [[ -z "${id}" ]]; then
                id="$1"
            else
                usage_error "unexpected argument '$1'."
            fi
            ;;
        esac
        shift
    done
    [[ -n "${team}" ]] || usage_error "'restore' needs a team."
    if [[ -n "${id}" && ! "${id}" =~ ^[1-9][0-9]*$ ]]; then
        usage_error "a backup is named by its number; got '${id}'."
    fi
    sudo_ready "The backups are listed and restored as root, by agent-bus-install." || exit 1
    if [[ -z "${id}" ]]; then
        listing="$(sudo "${SUDO_INSTALLER}" backups --team "${team}")"
        if [[ -z "${listing}" ]]; then
            print_error "team ${team} has no backup to restore."
            return 1
        fi
        if [[ ! -t 0 || ! -t 1 ]]; then
            printf '%s\n' "${listing}"
            usage_error "name the backup to restore: ccy-teams restore ${team} <n> --yes."
        fi
        id="$(pick_backup "${team}" "${listing}")" || {
            echo "Nothing restored." >&2
            return 0
        }
    fi
    if [[ "${yes}" == false ]]; then
        if [[ ! -t 0 || ! -t 1 ]]; then
            usage_error "a restore replaces the team's database and state: confirm it with --yes when there is no terminal."
        fi
        if ! ccy_tmux_confirm "Restore ${team}" \
            "Restore backup ${id} of ${team}? Its homeserver stops, and every message and change since that backup is lost." \
            "restore backup ${id}"; then
            echo "Nothing restored." >&2
            return 0
        fi
    fi
    sudo "${SUDO_INSTALLER}" restore --team "${team}" --backup "${id}"
}


# ── the table ────────────────────────────────────────────────────────────────────────────
#
# One pass gathers everything into the R_* arrays, one entry per row, in the shell itself
# (not a subshell), so a key pressed on a row finds what the row stands for by its index.
# R_TEXT is the row as plain text, which fzf hands back and --list prints when piped;
# R_SHOWN is the same row with its status words in colour.

_row() {
    printf '%-24s  %-36s  %-6s  %-13s  %-18s  %-26s  %-7s  %s' "$@"
}
row_heading() {
    _row TEAM MEMBER KIND STATE APPLIED SESSION RESTORE WHERE
}

# _paint <width> <word> — the word padded to width, in its status colour.
_paint() {
    local colour
    colour="$(word_colour "$2")"
    if [[ -n "${colour}" ]]; then
        printf '%s%-*s%s' "${colour}" "$1" "$2" "${C_RESET}"
    else
        printf '%-*s' "$1" "$2"
    fi
}

# _painted_row — _row's columns, the team's own row in bold and each status word coloured.
_painted_row() {
    local team
    team="$(printf '%-24s' "$1")"
    [[ "$3" != team ]] || team="${C_BOLD}${team}${C_RESET}"
    printf '%s  %-36s  %-6s  %s  %s  %s  %s  %s' "${team}" "$2" "$3" "$(_paint 13 "$4")" \
        "$(_paint 18 "$5")" "$(_paint 26 "$6")" "$(_paint 7 "$7")" "$8"
}

R_TEXT=() R_SHOWN=() R_TEAM=() R_KIND=() R_NAME=() R_HANDLE=() R_DIR=() R_SESSION=()
# add_row <team> <member> <kind> <state> <session> <restore> <where> <handle> <dir> [applied]
add_row() {
    R_TEXT+=("$(_row "$1" "$2" "$3" "$4" "${10:--}" "$5" "$6" "$7")")
    R_SHOWN+=("$(_painted_row "$1" "$2" "$3" "$4" "${10:--}" "$5" "$6" "$7")")
    R_TEAM+=("$1")
    R_NAME+=("$2")
    R_KIND+=("$3")
    R_SESSION+=("$5")
    R_HANDLE+=("$8")
    R_DIR+=("$9")
}

# The teams of this machine: those declared present, then any homeserver unit loaded here
# that is not (one declared absent but still installed, or made by hand). LOADED holds
# the teams with a homeserver unit: a declared team without one is not installed yet.
TEAMS=()
declare -A PORT_OF=() URL_OF=() SERVER_OF=() LOADED=()
collect_teams() {
    local declared units team port state server url unit
    declare -A seen=()
    need_checkout
    declared="$(declare_helper declared --file "${HOST_VARS}")" || {
        print_error "the teams declared in ${HOST_VARS} could not be read (the reason is above)."
        return 1
    }
    while IFS=$'\t' read -r _ team port state server url; do
        [[ -n "${team}" && "${state}" == present ]] || continue
        TEAMS+=("${team}")
        PORT_OF["${team}"]="${port}"
        SERVER_OF["${team}"]="${server}"
        [[ "${url}" == - ]] || URL_OF["${team}"]="${url}"
        seen["${team}"]=1
    done <<<"${declared}"
    units="$(systemctl list-units --all --plain --no-legend --type=service 'agent-bus-hs@*')" || {
        print_error "systemctl could not list the agent-bus homeserver units."
        return 1
    }
    while read -r unit _; do
        [[ "${unit}" == agent-bus-hs@*.service ]] || continue
        team="${unit#agent-bus-hs@}"
        team="${team%.service}"
        LOADED["${team}"]=1
        [[ -z "${seen[${team}]:-}" ]] || continue
        TEAMS+=("${team}")
        seen["${team}"]=1
    done <<<"${units}"
    # A team whose stamp says it is built, though not declared present: it needs a decision.
    for unit in "${APPLIED_DIR}"/*.json; do
        [[ -e "${unit}" ]] || continue
        team="${unit##*/}"
        team="${team%.json}"
        [[ -n "${seen[${team}]:-}" ]] || TEAMS+=("${team}")
        seen["${team}"]=1
    done
}

# The subcommands, now that every function they use is defined.
case "${subcommand}" in
create)
    cmd_create "$@"
    exit
    ;;
apply)
    cmd_apply "$@"
    exit
    ;;
remove)
    cmd_remove "$@"
    exit
    ;;
backup)
    cmd_backup "$@"
    exit
    ;;
restore)
    cmd_restore "$@"
    exit
    ;;
esac

# homeserver_state <team> — up, or down with systemd's word for it.
homeserver_state() {
    local state rc=0
    state="$(systemctl is-active "agent-bus-hs@$1.service")" || rc=$?
    if [[ "${rc}" -eq 0 && "${state}" == active ]]; then
        printf 'up\n'
    else
        printf 'down (%s)\n' "${state:-unknown}"
    fi
}

# The ccy sessions with a registry record: per "<dir>|<seat>@<team>", the session holding it
# and whether it is restored; and every live session's attached count.
declare -A SEAT_SESSION=() SEAT_RESTORE=() LIVE=()
CHECKOUTS=()
declare -A CHECKOUT_SEEN=()
add_checkout() {
    [[ -n "$1" && -z "${CHECKOUT_SEEN[$1]:-}" ]] || return 0
    CHECKOUT_SEEN["$1"]=1
    CHECKOUTS+=("$1")
}
collect_sessions() {
    local listing name attached dir regdir file i list ref
    listing="$(ccy_tmux_list)" || return 1
    while read -r name attached dir; do
        [[ -n "${name}" ]] || continue
        LIVE["${name}"]="${attached}"
        [[ "${name}" != ccy-* ]] || add_checkout "${dir}"
    done <<<"${listing}"
    regdir="$(ccy_registry_dir)" || return 1
    for file in "${regdir}"/*; do
        [[ -e "${file}" && "${file}" != *.tmp.* ]] || continue
        if ! ccy_registry_read "${file}"; then
            print_error "the session record ${file} could not be read; its seats show no session."
            INCOMPLETE="a session record is unreadable"
            continue
        fi
        [[ "${REC_PREFIX}" == ccy ]] || continue
        add_checkout "${REC_DIR}"
        list=""
        for i in "${!REC_ARGS[@]}"; do
            case "${REC_ARGS[i]}" in
            --) break ;;
            --teams) list="${REC_ARGS[i + 1]:-}" ;;
            --teams=*) list="${REC_ARGS[i]#--teams=}" ;;
            esac
        done
        [[ -n "${list}" ]] || continue
        while read -r -d , ref; do
            SEAT_SESSION["${REC_DIR}|${ref}"]="${REC_NAME}"
            SEAT_RESTORE["${REC_DIR}|${ref}"]="${REC_RESTORE}"
        done <<<"${list},"
    done
    if project_here; then
        add_checkout "$(git rev-parse --show-toplevel)"
    fi
}

# Set when a seat or a session record could not be read: every team row then says so, and
# Ctrl-X parks no ccy member whose checkout is unknown, since it may be one of those seats.
INCOMPLETE=""

# seat_lines <dir> — `agent-bus seat list` in a checkout that has seats; nothing otherwise.
# A seat whose bundle cannot be read fails the command, but the others are still printed.
seat_lines() {
    [[ -d "$1/.claude/ccy/pingbus/seats" ]] || return 0
    (cd "$1" && agent-bus seat list)
}

# as_root <command> [args...] — a root command through `sudo -n`, never prompting; its
# stdout in ROOT_OUT. Returns 0 when it ran; 2 when sudo wants a password first (sudo's own
# words, nothing else, so nothing is printed); 1 when the command failed, its error printed.
ROOT_OUT=""
as_root() {
    local errors rc=0
    errors="$(mktemp)"
    ROOT_OUT="$(sudo -n "$@" 2>"${errors}")" || rc=$?
    if [[ "${rc}" -eq 1 && "$(<"${errors}")" == "sudo: "* ]]; then
        rc=2
    elif [[ "${rc}" -ne 0 ]]; then
        cat "${errors}" >&2
        rc=1
    fi
    rm -f "${errors}"
    return "${rc}"
}

# The member lines of each team, from agent-bus list; a team whose members could not be
# read has its reason in MEMBERS_UNKNOWN. NEED_SUDO is set when sudo wanted a password for
# them: the picker then asks, saying why, and --list says how to give it.
declare -A MEMBERS_OF=() MEMBERS_UNKNOWN=() SIGNED_IN=()
NEED_SUDO=""
collect_members() {
    local team="$1" rc=0 kind name devices
    as_root "${SUDO_AGENT_BUS}" list "${team}" || rc=$?
    case "${rc}" in
    0) MEMBERS_OF["${team}"]="${ROOT_OUT}" ;;
    2)
        MEMBERS_UNKNOWN["${team}"]="need sudo"
        NEED_SUDO+=" ${team}"
        return 0
        ;;
    *)
        MEMBERS_UNKNOWN["${team}"]="read failed (above)"
        return 0
        ;;
    esac
    # Each person's Element sessions: read-only, and covered by the same sudoers rule.
    while IFS=$'\t' read -r kind name _; do
        [[ "${kind}" == HUMAN ]] || continue
        rc=0
        as_root "${SUDO_AGENT_BUS}" human devices "${team}" "${name}" || rc=$?
        case "${rc}" in
        0)
            devices="$(grep -c '^DEVICE' <<<"${ROOT_OUT}")" || devices=0
            if [[ "${devices}" -eq 0 ]]; then
                SIGNED_IN["${team}|${name}"]="never signed in"
            else
                SIGNED_IN["${team}|${name}"]="${devices} signed in"
            fi
            ;;
        2)
            SIGNED_IN["${team}|${name}"]="need sudo"
            NEED_SUDO+=" ${team}"
            ;;
        *) SIGNED_IN["${team}|${name}"]=unknown ;;
        esac
    done <<<"${ROOT_OUT}"
}

# room_word <Matrix membership> — whether the person is in the team's room, in words.
room_word() {
    case "$1" in
    join) printf 'in room' ;;
    invite) printf 'invited' ;;
    *) printf 'not in room' ;;
    esac
}

collect() {
    local team state port dir seats kind name membership role activity handle seat seat_state
    local key session restore where seat_activity
    local -a seat_dirs=() seat_rows=()
    local -A activity_of=() shown=()
    R_TEXT=() R_SHOWN=() R_TEAM=() R_KIND=() R_NAME=() R_HANDLE=() R_DIR=() R_SESSION=()
    INCOMPLETE="" NEED_SUDO=""
    TEAMS=() PORT_OF=() URL_OF=() SERVER_OF=() LOADED=()
    SEAT_SESSION=() SEAT_RESTORE=() LIVE=() CHECKOUTS=() CHECKOUT_SEEN=()
    MEMBERS_OF=() MEMBERS_UNKNOWN=() SIGNED_IN=()
    collect_teams || return 1
    [[ -n "${TEAMS[*]:-}" ]] || return 0
    read_status || return 1
    collect_sessions || return 1
    for dir in "${CHECKOUTS[@]}"; do
        if ! seats="$(seat_lines "${dir}")"; then
            print_error "agent-bus seat list could not read every seat in ${dir} (above); those are left out."
            INCOMPLETE="a seat is unreadable"
        fi
        while IFS= read -r seat; do
            [[ -n "${seat}" ]] || continue
            seat_dirs+=("${dir}")
            seat_rows+=("${seat}")
        done <<<"${seats}"
    done
    for team in "${TEAMS[@]}"; do
        port="${PORT_OF[${team}]:-}"
        where="port ${port:-unknown (not declared)}"
        if [[ -z "${LOADED[${team}]:-}" ]]; then
            state="not installed"
            MEMBERS_UNKNOWN["${team}"]="not installed"
            if [[ "${STATUS_OF[${team}]:-}" == decide ]]; then
                where+=", not declared present: ccy-teams remove ${team} takes it down"
            else
                where+=", install it: ccy-teams apply ${team}"
            fi
        else
            state="$(homeserver_state "${team}")"
            if [[ "${state}" == up ]]; then
                collect_members "${team}"
            else
                MEMBERS_UNKNOWN["${team}"]="homeserver down"
            fi
            [[ -z "${MEMBERS_UNKNOWN[${team}]:-}" ]] || where+=", members: ${MEMBERS_UNKNOWN[${team}]}"
        fi
        [[ -z "${INCOMPLETE}" ]] || where+=", ${INCOMPLETE} (above)"
        [[ "${STATUS_OF[${team}]:-}" != unreadable ]] || where+=", entry unreadable: ${DETAIL_OF[${team}]}"
        add_row "${team}" - team "${state}" - - "${where}" - - "$(status_word "${team}")"
        activity_of=()
        shown=()
        while IFS=$'\t' read -r kind name role membership activity; do
            [[ "${kind}" == MEMBER ]] || continue
            activity_of["${name}"]="${activity}"
        done <<<"${MEMBERS_OF[${team}]:-}"
        activity="unknown"
        [[ "${MEMBERS_UNKNOWN[${team}]:-}" != "need sudo" ]] || activity="need sudo"
        for key in "${!seat_rows[@]}"; do
            IFS=$'\t' read -r _ name seat seat_state _ handle <<<"${seat_rows[key]}"
            [[ "${name}" == "${team}" ]] || continue
            dir="${seat_dirs[key]}"
            shown["${handle}"]=1
            session="${SEAT_SESSION[${dir}|${seat}@${team}]:-}"
            restore="${SEAT_RESTORE[${dir}|${seat}@${team}]:--}"
            if [[ -z "${session}" ]]; then
                session="${seat_state}"
                restore=-
            elif [[ -z "${LIVE[${session}]+set}" ]]; then
                session+="(stopped)"
            fi
            seat_activity="${activity_of[${handle}]:-}"
            [[ -n "${seat_activity}" ]] || seat_activity="${activity}"
            add_row "${team}" "${seat}" ccy "${seat_activity}" "${session}" \
                "${restore}" "${dir/#${HOME}/\~}" "${handle}" "${dir}"
        done
        while IFS=$'\t' read -r kind name role membership activity; do
            [[ "${kind}" == MEMBER && -z "${shown[${name}]:-}" ]] || continue
            kind="${name##*.}"
            [[ "${kind}" != podman ]] || kind=ccy
            add_row "${team}" "${name}" "${kind}" "${activity}" - - "${role}" "${name}" -
        done <<<"${MEMBERS_OF[${team}]:-}"
        while IFS=$'\t' read -r kind name membership; do
            [[ "${kind}" == HUMAN ]] || continue
            add_row "${team}" "${name}" human "$(room_word "${membership}")" \
                "${SIGNED_IN[${team}|${name}]:-unknown}" - "Element; Enter: new password" - -
        done <<<"${MEMBERS_OF[${team}]:-}"
    done
}

# need_sudo_note — for --list: which teams' members wait on sudo, and the two ways to give it.
need_sudo_note() {
    echo "The members of${NEED_SUDO} are not shown: reading them needs root. Run sudo -v first, or run play-agent-bus.yml once, which installs a rule that lets ccy-teams read them without a password." >&2
}

if [[ "${subcommand}" == -l || "${subcommand}" == --list ]]; then
    collect || exit 1
    if [[ -z "${R_TEXT[*]:-}" ]]; then
        echo "No agent teams on this machine yet. ccy-teams create starts one." >&2
        exit 0
    fi
    [[ -z "${NEED_SUDO}" ]] || need_sudo_note
    if colour_on 1; then
        printf '%s%s%s\n' "${C_BOLD}" "$(row_heading)" "${C_RESET}"
        printf '%s\n' "${R_SHOWN[@]}"
    else
        row_heading
        printf '\n'
        printf '%s\n' "${R_TEXT[@]}"
    fi
    # A table with a part that could not be read is printed, but is not a success: a
    # homeserver that is down or not installed is a state, a read that failed is not.
    for team in "${!MEMBERS_UNKNOWN[@]}"; do
        case "${MEMBERS_UNKNOWN[${team}]}" in
        "need sudo" | "read failed"*) exit 1 ;;
        esac
    done
    [[ -z "${INCOMPLETE}" && -z "${NEED_SUDO}" ]] || exit 1
    exit 0
fi

# ── the picker ───────────────────────────────────────────────────────────────────────────
if [[ ! -t 0 || ! -t 1 ]]; then
    echo "ccy-teams needs a terminal: it attaches sessions to the one you are in. ccy-teams --list prints the table instead." >&2
    exit 1
fi
trap cancelled INT

# offer_create — no team on this machine: say what a team is, and offer to create one now.
offer_create() {
    local rc=0
    need_gum
    say "No agent teams on this machine yet."
    gum confirm --default=false "Create one now?" || rc=$?
    case "${rc}" in
    0)
        cmd_create
        exit
        ;;
    1)
        echo "Nothing created. ccy-teams create starts one whenever you like." >&2
        exit 0
        ;;
    *) cancelled ;;
    esac
}

# The teams are known without sudo: with none there is nothing to read, so nothing is asked.
collect_teams || exit 1
if [[ -z "${TEAMS[*]:-}" ]]; then
    offer_create
fi

# in_picker <command...> — a subcommand run from the picker, in a subshell so its exit
# ends only it. Ctrl-C (130) ends the picker too; any other failure has said why above,
# and the picker goes on.
in_picker() {
    local rc=0
    ("$@") || rc=$?
    case "${rc}" in
    0) ;;
    130) exit 130 ;;
    *) echo "($1 failed, exit ${rc}: see above.)" >&2 ;;
    esac
}

# offer_update — a team out of date or not built: offer to update it before the list.
offer_update() {
    local team
    local -a behind=()
    read_status || exit 1
    for team in "${!STATUS_OF[@]}"; do
        case "${STATUS_OF[${team}]}" in
        outdated | unbuilt) behind+=("${team} ($(status_word "${team}"))") ;;
        esac
    done
    [[ -n "${behind[*]:-}" ]] || return 0
    need_gum
    say "Not as declared: ${behind[*]}."
    if ask_yes "Update them now (play-agent-bus.yml)?" true; then
        in_picker cmd_apply --all
        back_to_list
    fi
}
# offer_path_limits — a team created before Task 4.7 still names the old default
# path_prefixes, which limits the paths its agents may point each other at. Offered once per
# team: removed, through declare.py, and applied; or, declined, never asked again.
offer_path_limits() {
    local lines line team prefixes
    local -a limited=()
    lines="$(declare_helper limited --file "${HOST_VARS}")" || exit 1
    [[ -z "${lines}" ]] || mapfile -t limited <<<"${lines}"
    for line in "${limited[@]}"; do
        IFS=$'\t' read -r _ team prefixes <<<"${line}"
        [[ ! -e "${DECLINED_DIR}/path-limit-${team}" ]] || continue
        need_gum
        say "Team ${team} lets its agents point each other only at files under ${prefixes}"
        echo "That limit was the default when ${team} was created; new teams have none. Without it, any file in the team's repositories may be named." >&2
        if ask_yes "Remove the limit from ${team}?" true; then
            declare_helper drop-limit --file "${HOST_VARS}" --team "${team}" >/dev/null
            in_picker apply_teams "${team}"
        else
            mkdir -p "${DECLINED_DIR}"
            : >"${DECLINED_DIR}/path-limit-${team}"
            echo "Kept. ccy-teams will not ask about ${team}'s limit again." >&2
        fi
    done
}
offer_path_limits
offer_update

# offer_join_here — run in a checkout of a team's repositories, with no ccy session of this
# checkout in that team running, offer to start one as a member (Task 4.4). Once per run.
offer_join_here() {
    local candidates team top key held
    local -a teams=()
    project_here || return 0
    candidates="$(join_candidates)" || return 0
    [[ -z "${candidates}" ]] || mapfile -t teams <<<"${candidates}"
    top="$(git rev-parse --show-toplevel)"
    for team in "${teams[@]}"; do
        [[ -n "${LOADED[${team}]:-}" && "$(homeserver_state "${team}")" == up ]] || continue
        held=""
        for key in "${!SEAT_SESSION[@]}"; do
            if [[ "${key}" == "${top}|"*"@${team}" && -n "${LIVE[${SEAT_SESSION[${key}]}]+set}" ]]; then
                held=yes
            fi
        done
        [[ -z "${held}" ]] || continue
        need_gum
        offer_join "${team}"
    done
}
join_offered=""

here="${PWD/#${HOME}/\~}"

# row_index <row> — the index of the picked row (fzf hands back the plain text), printed.
row_index() {
    local i
    for i in "${!R_TEXT[@]}"; do
        if [[ "${R_TEXT[i]}" == "$1" ]]; then
            printf '%s\n' "${i}"
            return 0
        fi
    done
    return 1
}

# back_to_list — wait for Enter before the list is drawn over what was just said.
back_to_list() {
    echo "Press Enter to go back to the list." >&2
    if ! read -r _ </dev/tty; then
        echo >&2
    fi
}

# attach_seat <i> — Enter on a seat: attach its live session here, as ccy-sessions does.
attach_seat() {
    local i="$1" session="${R_SESSION[$1]}" rc=0
    if [[ -z "${LIVE[${session}]+set}" ]]; then
        echo "Seat ${R_NAME[i]}@${R_TEAM[i]} has no running session to attach. Ctrl-N starts one." >&2
        return 0
    fi
    if [[ "${LIVE[${session}]}" != 0 ]]; then
        echo "'${session}' is open in another terminal. ccy-sessions takes it over (Ctrl-T)." >&2
        return 0
    fi
    ccy_tmux_attach "${session}" || rc=$?
    case "${rc}" in
    0) exit 0 ;;
    3) ;;
    *) echo "'${session}' was taken or ended just now — the list has been refreshed." >&2 ;;
    esac
}

# new_session <team> — Ctrl-N: ccy --teams in a free seat of this checkout, or a new one
# numbered after every numbered seat the team and this checkout already have.
new_session() {
    local team="$1" top seats line seat seat_state handle next=1 rows="" picked
    if ! project_here; then
        echo "${here} is not a project folder (no git repository), so ccy cannot be started here." >&2
        return 0
    fi
    if [[ "$(homeserver_state "${team}")" != up ]]; then
        echo "${team}'s homeserver is down, so no session can join it." >&2
        return 0
    fi
    # The seats are the checkout's, and ccy mounts the directory it starts in, so it is
    # started at the checkout's top whatever subdirectory this is.
    top="$(git rev-parse --show-toplevel)"
    if ! seats="$(seat_lines "${top}")"; then
        echo "Not every seat of this checkout could be read (above), so no seat is offered: one of them may be the seat a new session would take." >&2
        return 0
    fi
    while IFS=$'\t' read -r _ line seat seat_state _ handle; do
        [[ "${line}" == "${team}" ]] || continue
        [[ ! "${seat}" =~ ^[0-9]+$ ]] || ((seat < next)) || next=$((seat + 1))
        [[ "${seat_state}" != free ]] || rows+="Seat ${seat}@${team}   free"$'\n'
    done <<<"${seats}"
    while IFS=$'\t' read -r line handle _; do
        [[ "${line}" == MEMBER && "${handle}" =~ \.([0-9]+)\+[^+]*\.podman$ ]] || continue
        ((BASH_REMATCH[1] < next)) || next=$((BASH_REMATCH[1] + 1))
    done <<<"${MEMBERS_OF[${team}]:-}"
    rows+="Seat ${next}@${team}   new"
    picked="$(ccy_tmux_pick "New ccy session in ${team}" "$(ccy_tmux_header "Enter start   Esc or q back" \
        "Runs ccy --teams <seat>@${team} in ${top/#${HOME}/\~}; a new seat is created by that launch (sudo).")" "" \
        <<<"${rows}")" || return 0
    picked="${picked#*$'\n'}"
    picked="${picked#Seat }"
    picked="${picked%% *}"
    echo "Starting ccy --teams ${picked} in ${top/#${HOME}/\~}." >&2
    cd "${top}"
    exec "${CCY_LAUNCHER}" --teams "${picked}"
}

# toggle_restore <i> — Ctrl-R on a seat whose session has a record.
toggle_restore() {
    local i="$1" session="${R_SESSION[$1]%(stopped)}" key want
    key="${R_DIR[i]}|${R_NAME[i]}@${R_TEAM[i]}"
    if [[ "${R_KIND[i]}" != ccy || -z "${SEAT_RESTORE[${key}]:-}" ]]; then
        echo "Ctrl-R changes whether a seat's ccy session comes back after a reboot, and this row has no session." >&2
        return 0
    fi
    want=no
    [[ "${SEAT_RESTORE[${key}]}" == yes ]] || want=yes
    ccy_registry_set_restore "${session}" "${want}" || return 0
}

# remove_or_park <i> — Ctrl-X: a seat is removed with agent-bus seat remove in its checkout;
# any other member is parked.
remove_or_park() {
    local i="$1" team="${R_TEAM[$1]}" name="${R_NAME[$1]}" handle="${R_HANDLE[$1]}"
    case "${R_KIND[i]}" in
    team)
        in_picker cmd_remove "${team}"
        back_to_list
        ;;
    human)
        echo "A team's people are its agent_bus_teams entry's humans: change them there, then ccy-teams apply ${team}." >&2
        ;;
    ccy)
        if [[ "${R_DIR[i]}" != - ]]; then
            if ccy_tmux_confirm "Remove seat ${name}@${team}?" \
                "${handle} is parked (its token revoked; its history kept) and the seat's directory in ${R_DIR[i]/#${HOME}/\~} deleted. Launching into ${name}@${team} again brings it back." \
                "remove ${name}@${team}"; then
                if ! (cd "${R_DIR[i]}" && agent-bus seat remove "${name}@${team}"); then
                    echo "The seat was not removed, for the reason above." >&2
                fi
            fi
            return 0
        fi
        if [[ -n "${INCOMPLETE}" ]]; then
            echo "${handle} may be one of the seats that could not be read (above), so it is not parked here: remove it with agent-bus seat remove in its checkout." >&2
            return 0
        fi
        ;&
    *)
        if ccy_tmux_confirm "Park ${handle}?" \
            "Its token is revoked; its account, role and room are kept. add-member --seat returns it, and an agent_bus_lxc_members entry is returned by the next play run unless set absent." \
            "park ${handle}"; then
            if ! sudo_ready "A member is parked as root, by agent-bus."; then
                echo "${handle} was not parked." >&2
            elif ! sudo -n "${SUDO_AGENT_BUS}" park-member "${team}" "${handle}"; then
                echo "${handle} was not parked, for the reason above." >&2
            fi
        fi
        ;;
    esac
}

# password_row <i> — Enter or Ctrl-P on a row: a person's password; on any other row, say
# where the people are.
password_row() {
    if [[ "${R_KIND[$1]}" != human ]]; then
        echo "Ctrl-P sets a person's Element password: choose one of the team's people (KIND human)." >&2
        return 0
    fi
    set_password "${R_TEAM[$1]}" "${R_NAME[$1]}" || true
    back_to_list
}

# open_element <team> — Ctrl-E: the team's Element profile, through the launcher
# play-agent-bus-element.yml writes; with none yet, it offers to set one up first. A person
# of the team who has never signed in is offered a new password first.
open_element() {
    local team="$1" launcher i
    launcher="$(element_launcher "${team}")"
    if [[ ! -f "${launcher}" ]]; then
        need_gum
        echo "${team} has no Element profile on this desktop yet." >&2
        if ! ask_yes "Set one up now? It installs Element Desktop if needed (sudo asks for your password)." true; then
            echo "Nothing set up. Ctrl-E offers it again." >&2
            return 0
        fi
        if ! set_up_element "${team}"; then
            echo "${team} was not set up in Element, for the reason above." >&2
            back_to_list
            return 0
        fi
    fi
    for i in "${!R_TEXT[@]}"; do
        [[ "${R_TEAM[i]}" == "${team}" && "${R_KIND[i]}" == human && "${R_SESSION[i]}" == "never signed in" ]] ||
            continue
        echo "${R_NAME[i]} has never signed in to ${team}." >&2
        if set_password "${team}" "${R_NAME[i]}"; then
            echo "Copy it now. Press Enter to open Element." >&2
            if ! read -r _ </dev/tty; then
                echo >&2
            fi
        fi
    done
    echo "Opening ${team} in Element." >&2
    gio launch "${launcher}"
    exit 0
}

# update_all — Ctrl-U: apply --all, then back to the list.
update_all() {
    in_picker cmd_apply --all
    back_to_list
}

# show_help — every key and every status word, explained.
show_help() {
    printf '\n' >&2
    say "ccy-teams: the agent teams on this machine"
    cat >&2 <<'EOF'
Each team is a bold row: its homeserver (up, down, or not installed yet), its port, and
APPLIED, whether it runs what the host_vars declare:
  up to date          as declared
  out of date: ...    the declaration (config), the bus software, or both changed since;
                      Ctrl-U (or ccy-teams apply) brings it up to date
  not built           declared, never installed: Ctrl-U builds it
  decide: absent      declared absent but still running; decide: undeclared, running but
                      no longer declared. Never updated in bulk: Ctrl-X on the team takes
                      it down (its data kept unless you delete it)
Under it, its members and people:
  ccy      a seat of a ccy checkout: the session in it, and RESTORE, whether that
           session is started again after a reboot (yes or no)
  lxc ...  another member: active, or parked (its token revoked)
  human    a person in the team room: in room, invited or not in room, and how
           many Element sessions they are signed in with

Keys:
  Enter    a seat: attach its session; a person: a new Element password; a team: this
  Ctrl-N   start a ccy session in a free or new seat of the team, in this folder
  Ctrl-P   a new Element password for the person on the row (shown once; their other
           Element sessions are signed out)
  Ctrl-E   open the team in Element
  Ctrl-U   update every team out of date or not built (never takes one down)
  Ctrl-R   restore after a reboot, on or off, for the seat's session
  Ctrl-X   remove a seat, park a member, or take a team down (after a yes/no; a
           backup first, and the data kept unless you type the team's name)
  ?        this help          Esc or q   leave

Colours: green is working, yellow wants a look, red is not working.
"need sudo": reading the members needs root; play-agent-bus.yml installs a rule that
lets ccy-teams read them without a password.
EOF
    back_to_list
}

restore_word="off"
if [[ -e "${HOME}/.config/systemd/user/default.target.wants/ccy-sessions-restore.service" ]]; then
    restore_word="on"
fi
if project_here; then
    new_line="Ctrl-N starts ccy --teams <seat>@<the row's team> in ${here}"
else
    new_line="Ctrl-N unavailable: ${here} is not a project folder (no git repository)"
fi
heading="$(row_heading)"
! colour_on 1 || heading="${C_BOLD}${heading}${C_RESET}"
HEADER="$(ccy_tmux_header "Enter attach a seat / password for a person   Ctrl-P password   Ctrl-E Element   ? help   Esc or q quit" \
    "Ctrl-N new session   Ctrl-U update out-of-date teams   Ctrl-R restore on/off   Ctrl-X remove/park/take down" \
    "${new_line}" \
    "RESTORE: whether the seat's session is started again after a reboot; session restore on this machine is ${restore_word} (ccy_restore_sessions)" \
    "${heading}")"

READ_WHY="Reading who is in each team, and whether its people are signed in, is done as root: the team's admin token is root's. Once play-agent-bus.yml has run, a sudoers rule lets ccy-teams read this without a password; until then, sudo asks."

attempt=1
while :; do
    collect || exit 1
    if [[ -n "${NEED_SUDO}" ]]; then
        if ! sudo_ready "${READ_WHY}"; then
            print_error "so the teams' members cannot be shown, and nothing was changed. ccy-teams --list shows the teams without them."
            exit 1
        fi
        collect || exit 1
        if [[ -n "${NEED_SUDO}" ]]; then
            print_error "sudo took your password but still refuses agent-bus list, so the members cannot be shown."
            exit 1
        fi
    fi
    if [[ -z "${R_TEXT[*]:-}" ]]; then
        offer_create
    fi
    if [[ -z "${join_offered}" ]]; then
        join_offered=yes
        offer_join_here
    fi
    if colour_on 1; then
        rows="$(printf '%s\n' "${R_SHOWN[@]}")"
    else
        rows="$(printf '%s\n' "${R_TEXT[@]}")"
    fi
    if ! picked="$(ccy_tmux_pick "Agent teams" "${HEADER}" "ctrl-n,ctrl-r,ctrl-x,ctrl-e,ctrl-p,ctrl-u,?" <<<"${rows}")"; then
        exit 0 # Esc or q
    fi
    key="${picked%%$'\n'*}"
    row="${picked#*$'\n'}"
    if ! index="$(row_index "${row}")"; then
        echo "That row has changed; the list has been refreshed." >&2
        continue
    fi
    case "${key}:${R_KIND[index]}" in
    ctrl-n:*) new_session "${R_TEAM[index]}" ;;
    ctrl-r:*)
        toggle_restore "${index}"
        continue
        ;;
    ctrl-x:*)
        remove_or_park "${index}"
        continue
        ;;
    ctrl-e:*) open_element "${R_TEAM[index]}" ;;
    ctrl-p:* | :human)
        password_row "${index}"
        continue
        ;;
    ctrl-u:*)
        update_all
        continue
        ;;
    "?:"* | :team)
        show_help
        continue
        ;;
    :ccy) attach_seat "${index}" ;;
    *)
        echo "Enter on ${R_NAME[index]} does nothing: Ctrl-X parks a member. ? shows every key." >&2
        continue
        ;;
    esac
    attempt=$((attempt + 1))
    if [[ "${attempt}" -gt "${MAX_TRIES}" ]]; then
        echo "Nothing attached or started after ${MAX_TRIES} tries." >&2
        exit 1
    fi
done
