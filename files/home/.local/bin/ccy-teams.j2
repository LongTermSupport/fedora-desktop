#!/usr/bin/env bash
# ccy-teams — see the agent teams on this machine and look after them: each team's
# homeserver, its members, and the ccy sessions in its seats. It is to teams what
# ccy-sessions is to sessions (Plan 00161; docs/agent-bus.md, "Getting started").
#
# A team is declared in the untracked host_vars localhost.yml (agent_bus_teams) and made by
# play-agent-bus.yml. A ccy session joins one with `ccy --teams <seat>@<team>`, an LXC
# container's agent through agent_bus_lxc_members. ccy-teams holds no team logic of its own:
# it acts through agent-bus, agent-bus-install, ccy and the session registry, and it edits
# the host_vars only to add a team (create).
#
# Each team is a row (its homeserver up or down, and its port), followed by its members:
#   ccy                    a seat of a ccy checkout, with the ccy session holding it and
#                          whether that session is started again after a reboot
#   lxc, host, docker, vm  a member of that type; a ccy member whose checkout is not
#                          known here (no session or registry record names it) is "ccy"
#                          with no checkout
#   human                  a human of the team, and whether the account is in the room
# Arrow keys move; Enter attaches to the seat's session (as ccy-sessions does); Ctrl-N
# starts a new ccy session in a free or new seat of the row's team, in the current project,
# by running ccy --teams; Ctrl-R turns the restore of the seat's session after a reboot off
# or on; Ctrl-X removes a seat (agent-bus seat remove) or parks a member (agent-bus
# park-member) after a yes/no; Ctrl-E opens the team in Element, offering a new password
# first to a human with no session yet; Esc or q leaves. Nothing needs Enter after it.
#
# The members come from `sudo agent-bus list`, so the picker asks for sudo first. --list
# uses only sudo's cached credential: without one it leaves the members out and says why.
#
# Usage:
#   ccy-teams                        the picker (needs a terminal)
#   ccy-teams -l|--list              print the same table, with a heading, and exit
#   ccy-teams create [--team T] [--human NAME]... [--repo OWNER/REPO=BRANCH[,BRANCH]]...
#                    [--allow-from CIDR]... [--yes]
#                                    add a team to agent_bus_teams in the host_vars. On a
#                                    terminal it asks (with gum) for what the flags leave
#                                    out: the name; the people in the team room (you, by
#                                    default); the GitHub owner, then which of its
#                                    repositories the agents may send each other to,
#                                    each with its default branch (from gh); other
#                                    machines' subnets. It shows the entry and asks
#                                    before writing. --yes asks nothing: give --team,
#                                    --human and --repo. The port is chosen for you; the
#                                    team is made only when play-agent-bus.yml runs
#
# With no team on this machine, the picker offers to create one.
#   ccy-teams backup <team>          back the team's homeserver up now
#   ccy-teams restore <team> [<n>] [--yes]
#                                    restore backup <n> after a yes/no (--yes: none);
#                                    without <n>, choose one from the list
#   ccy-teams -h|--help              this text
#
# Backups stay on this machine (docs/agent-bus.md, "Backups are the root of trust").
# Exit 64 for a usage mistake, 1 for a refusal or a failure.
#
# Runs on the HOST, as the desktop user.
set -euo pipefail

# The fedora-desktop checkout this was deployed from (play-claude-yolo.yml): create's
# helper and the host_vars are there.
ROOT_DIR="{{ root_dir }}"
CCY_LIB="${CCY_LIB:-/var/local/claude-yolo/lib}"
# The test points these at stand-ins; nothing else should set them.
HOST_VARS="${CCY_TEAMS_HOST_VARS:-${ROOT_DIR}/environment/localhost/host_vars/localhost.yml}"
CCY_LAUNCHER="${CCY_TEAMS_LAUNCHER:-/var/local/claude-yolo/claude-yolo}"
# Root's commands are named by path: sudo's secure_path need not hold /usr/local.
SUDO_AGENT_BUS=/usr/local/bin/agent-bus
SUDO_INSTALLER=/usr/local/sbin/agent-bus-install
MAX_TRIES=3

usage() {
    awk 'NR == 1 { next } /^#/ { print substr($0, 3); next } { exit }' "${BASH_SOURCE[0]}"
}

usage_error() {
    echo "ccy-teams: $1 See ccy-teams --help." >&2
    exit 64
}

subcommand="${1:-}"
case "${subcommand}" in
"" | create | backup | restore) ;;
-l | --list)
    if [[ $# -gt 1 ]]; then
        usage_error "'${subcommand}' takes no further arguments."
    fi
    ;;
-h | --help)
    usage
    exit 0
    ;;
*)
    usage_error "unknown option '${subcommand}'."
    ;;
esac
if [[ -n "${subcommand}" ]]; then
    shift
fi

if [[ ! -f "${CCY_LIB}/tmux-session.bash" ]]; then
    if [[ -d /workspace ]]; then
        echo "ccy-teams runs on the host, not inside a CCY container." >&2
    else
        echo "CCY is not installed here (${CCY_LIB}/tmux-session.bash missing). Run playbooks/imports/play-claude-yolo.yml." >&2
    fi
    exit 1
fi
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../../../var/local/claude-yolo/lib/common-pure.bash
source "${CCY_LIB}/common-pure.bash"
# shellcheck source=../../../var/local/claude-yolo/lib/session-registry.bash
source "${CCY_LIB}/session-registry.bash"
# shellcheck source=../../../var/local/claude-yolo/lib/tmux-session.bash
source "${CCY_LIB}/tmux-session.bash"

need_checkout() {
    if [[ ! -f "${ROOT_DIR}/helpers/agent_bus/declare.py" ]]; then
        print_error "the fedora-desktop checkout ccy-teams was deployed from (${ROOT_DIR}) has gone; re-run playbooks/imports/play-claude-yolo.yml from where it is now."
        exit 1
    fi
}

project_here() {
    local probe
    probe="$(git rev-parse --is-inside-work-tree 2>&1)" && [[ "${probe}" == "true" ]]
}

# declare_helper <args...> — helpers/agent_bus/declare.py from the checkout.
declare_helper() {
    PYTHONPATH="${ROOT_DIR}" python3 -P -m helpers.agent_bus.declare "$@"
}

# ── create: the questions, asked with gum; declare.py checks and writes ──────────────────

cancelled() {
    echo "Cancelled; nothing was changed." >&2
    exit 130
}

# need_tool <command> <what installs it> — a hard dependency: missing is a failure, never a
# reason to fall back to something plainer.
need_tool() {
    if [[ -z "$(command -v "$1")" ]]; then
        print_error "$1 is not installed, and ccy-teams needs it here. $2 installs it; run that play and try again."
        exit 1
    fi
}

# gum_ask <header> <placeholder> <value> — one line of input; prints it. Esc or Ctrl-C
# returns non-zero.
gum_ask() {
    gum input --header "$1" --placeholder "$2" --value "$3" --width 0
}

# ask_valid <checker> <header> <placeholder> <value> — ask until <checker> <answer> accepts
# it (it prints the problem on stderr when it does not), MAX_TRIES at most. Prints the
# answer; returns 130 when cancelled, 1 when every try was refused.
ask_valid() {
    local checker="$1" header="$2" placeholder="$3" value="$4" answer try
    for ((try = 1; try <= MAX_TRIES; try++)); do
        answer="$(gum_ask "${header}" "${placeholder}" "${value}")" || return 130
        answer="${answer#"${answer%%[![:space:]]*}"}"
        answer="${answer%"${answer##*[![:space:]]}"}"
        if "${checker}" "${answer}"; then
            printf '%s\n' "${answer}"
            return 0
        fi
        value="${answer}"
    done
    echo "Giving up after ${MAX_TRIES} tries; nothing was changed." >&2
    return 1
}

# ask_or_quit — the status of an ask_valid: 130 cancels, any other failure ends the run.
ask_or_quit() {
    case "$1" in
    0) ;;
    130) cancelled ;;
    *) exit 1 ;;
    esac
}

# say_problem <declare's message> — a refused value, as a person would say it.
say_problem() {
    echo "  ${1#declare: }. Try again." >&2
}

check_team() {
    local problem
    if [[ -z "$1" ]]; then
        say_problem "the team needs a name"
        return 1
    fi
    problem="$(declare_helper check --file "${HOST_VARS}" --team "$1" 2>&1)" || {
        say_problem "${problem}"
        return 1
    }
}

# split_commas <text> — one name per line.
split_commas() {
    local part
    while read -r -d , part; do
        [[ -z "${part// /}" ]] || printf '%s\n' "${part// /}"
    done <<<"$1,"
}

check_humans() {
    local -a flags=()
    local name problem
    while read -r name; do
        [[ -z "${name}" ]] || flags+=(--human "${name}")
    done <<<"$(split_commas "$1")"
    if [[ -z "${flags[*]:-}" ]]; then
        say_problem "name at least one person; your own login name is the usual answer"
        return 1
    fi
    problem="$(declare_helper check --file "${HOST_VARS}" "${flags[@]}" 2>&1)" || {
        say_problem "${problem}"
        return 1
    }
}

# check_owner <owner> — a GitHub user or organisation that exists (GitHub's names are not
# case-sensitive, so it is checked lower-cased, as the team file holds it).
check_owner() {
    local owner="${1,,}" problem
    problem="$(declare_helper check --file "${HOST_VARS}" --owner "${owner}" 2>&1)" || {
        say_problem "${problem}"
        return 1
    }
    if ! gum spin --title "Looking up ${owner} on GitHub…" -- gh api "users/${owner}" --silent; then
        say_problem "GitHub has no user or organisation called '${owner}' that your gh login can see"
        return 1
    fi
}

check_subnets() {
    local -a flags=()
    local cidr problem
    while read -r cidr; do
        [[ -z "${cidr}" ]] || flags+=(--allow-from "${cidr}")
    done <<<"$(split_commas "$1")"
    [[ -n "${flags[*]:-}" ]] || return 0
    problem="$(declare_helper check --file "${HOST_VARS}" "${flags[@]}" 2>&1)" || {
        say_problem "${problem}"
        return 1
    }
}

# the_remote_repo — this checkout's GitHub OWNER/REPO, lower-case; nothing outside one.
the_remote_repo() {
    local url
    project_here || return 0
    url="$(git remote get-url origin 2>&1)" || return 0
    declare_helper github-remote --url "${url}"
}

# pick_repos <owner> <pre-selected> — the owner's repositories in a multi-select; prints
# "<owner/repo>=<default branch>" per chosen one. Returns 130 when cancelled, 1 on failure.
pick_repos() {
    local owner="$1" current="$2" listing errors listing_lines kind name branch count="" picked try
    local -a names=() empty=() selected=()
    local -A branch_of=()
    listing="$(mktemp)"
    errors="$(mktemp)"
    if ! gum spin --title "Listing ${owner}'s repositories on GitHub…" -- \
        bash -c 'gh repo list "$1" --limit 1000 --json name,defaultBranchRef,isArchived >"$2" 2>"$3"' \
        _ "${owner}" "${listing}" "${errors}"; then
        print_error "gh repo list ${owner} failed: $(cat "${errors}")"
        rm -f "${listing}" "${errors}"
        return 1
    fi
    if ! listing_lines="$(declare_helper gh-repos --owner "${owner}" <"${listing}")"; then
        rm -f "${listing}" "${errors}"
        return 1
    fi
    rm -f "${listing}" "${errors}"
    while IFS=$'\t' read -r kind name branch; do
        case "${kind}" in
        COUNT) count="${name}" ;;
        REPO)
            names+=("${name}")
            branch_of["${name}"]="${branch}"
            ;;
        EMPTY) empty+=("${name}") ;;
        esac
    done <<<"${listing_lines}"
    if [[ -z "${names[*]:-}" ]]; then
        print_error "${owner} has no repository with commits that is not archived, so there is nothing a team could work on."
        return 1
    fi
    if [[ "${count}" -ge 1000 ]]; then
        echo "GitHub listed 1000 repositories, the most this asks for, so the list may be cut off; give a missing one with ccy-teams create --repo OWNER/REPO=BRANCH." >&2
    fi
    if [[ -n "${empty[*]:-}" ]]; then
        echo "Left out, as they have no commits yet (so no default branch): ${empty[*]}" >&2
    fi
    [[ -z "${current}" || -z "${branch_of[${current}]:-}" ]] || selected=(--selected "${current}")
    for ((try = 1; try <= MAX_TRIES; try++)); do
        picked="$(printf '%s\n' "${names[@]}" | gum filter --no-limit "${selected[@]}" \
            --header "Which repositories may this team's agents send each other to (review, read)? List every repository the agents work in; you can add more later. Tab marks one, Enter accepts." \
            --placeholder "type to filter")" || return 130
        if [[ -n "${picked}" ]]; then
            while read -r name; do
                [[ -z "${name}" ]] || printf '%s=%s\n' "${name}" "${branch_of[${name}]}"
            done <<<"${picked}"
            return 0
        fi
        echo "  Choose at least one: Tab marks a repository, Enter accepts. Try again." >&2
    done
    echo "Giving up after ${MAX_TRIES} tries; nothing was changed." >&2
    return 1
}

# create_wizard [flags] — the questions, for what the flags leave out, then a summary and
# a yes before declare.py writes. Each answer is checked as it is given.
create_wizard() {
    local team="" yes=false text current default_team login probe entry picked name rc
    local -a humans=() repos=() allow_from=() flags=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
        --yes) yes=true ;;
        --team | --human | --repo | --allow-from)
            [[ $# -ge 2 ]] || usage_error "create's $1 needs a value."
            case "$1" in
            --team) team="$2" ;;
            --human) humans+=("$2") ;;
            --repo) repos+=("$2") ;;
            --allow-from) allow_from+=("$2") ;;
            esac
            shift
            ;;
        *) usage_error "unknown create option '$1'." ;;
        esac
        shift
    done
    if [[ "${yes}" == false ]]; then
        if [[ ! -t 0 || ! -t 2 ]]; then
            usage_error "'create' asks its questions on a terminal; without one give every value as a flag, and --yes."
        fi
        need_tool gum playbooks/imports/play-claude-yolo.yml
        need_tool gh playbooks/imports/play-git-configure-and-tools.yml
        if [[ -z "${repos[*]:-}" ]] && ! probe="$(gh auth status 2>&1)"; then
            print_error "gh is not logged in to GitHub, and the team's repositories are listed from there (gh said: ${probe}). Run gh auth login, then ccy-teams create again."
            exit 1
        fi
        gum style --bold --border rounded --padding "0 1" "New agent team" >&2
        cat >&2 <<EOF
A team is a group of agents (ccy sessions, LXC containers) and people who work
together in a private chat room, on a homeserver on this machine; you watch and talk
to the agents in Element. This adds the team to ${HOST_VARS/#${HOME}/\~}.
Nothing is installed until play-agent-bus.yml runs: the next steps follow at the end.
Esc or Ctrl-C at any question leaves without changing anything.

EOF
        current="$(the_remote_repo)"
    fi
    if [[ -z "${team}" && "${yes}" == false ]]; then
        default_team="${current#*/}"
        if [[ -n "${default_team}" ]] && ! probe="$(declare_helper check --file "${HOST_VARS}" --team "${default_team}" 2>&1)"; then
            default_team=""
        fi
        rc=0
        team="$(ask_valid check_team \
            "Team name: a short name for the team, used in its room and its agents' names. Lower-case letters, digits and -, up to 24." \
            "e.g. website" "${default_team}")" || rc=$?
        ask_or_quit "${rc}"
    fi
    if [[ -z "${humans[*]:-}" && "${yes}" == false ]]; then
        login="$(id -un)"
        if ! probe="$(declare_helper check --file "${HOST_VARS}" --human "${login}" 2>&1)"; then
            echo "Your login name, ${login}, cannot be an account name here (${probe#declare: }), so there is no default." >&2
            login=""
        fi
        rc=0
        text="$(ask_valid check_humans \
            "People in the team room: each gets an Element account on the team's homeserver, to read and write there. The installer creates the accounts; nobody needs one yet. You are in by default; add others' names separated by commas." \
            "e.g. ${login:-yourname}, colleague" "${login}")" || rc=$?
        ask_or_quit "${rc}"
        mapfile -t humans <<<"$(split_commas "${text}")"
    fi
    if [[ -z "${repos[*]:-}" && "${yes}" == false ]]; then
        rc=0
        text="$(ask_valid check_owner \
            "GitHub owner: the organisation or user whose repositories this team works in. A team works within one owner." \
            "e.g. example-org" "${current%%/*}")" || rc=$?
        ask_or_quit "${rc}"
        rc=0
        picked="$(pick_repos "${text,,}" "${current}")" || rc=$?
        ask_or_quit "${rc}"
        mapfile -t repos <<<"${picked}"
    fi
    if [[ -z "${allow_from[*]:-}" && "${yes}" == false ]]; then
        rc=0
        text="$(ask_valid check_subnets \
            "Other machines: leave this empty unless LXC containers or other machines will run this team's agents. If they will, give the subnet they connect from, in CIDR form; separate several with commas." \
            "empty: only this machine (e.g. 192.0.2.0/24)" "")" || rc=$?
        ask_or_quit "${rc}"
        mapfile -t allow_from <<<"$(split_commas "${text}")"
    fi
    [[ -z "${team}" ]] || flags+=(--team "${team}")
    for name in "${humans[@]}"; do [[ -z "${name}" ]] || flags+=(--human "${name}"); done
    for name in "${repos[@]}"; do [[ -z "${name}" ]] || flags+=(--repo "${name}"); done
    for name in "${allow_from[@]}"; do [[ -z "${name}" ]] || flags+=(--allow-from "${name}"); done
    if [[ "${yes}" == true ]]; then
        declare_helper create --file "${HOST_VARS}" "${flags[@]}"
        return
    fi
    entry="$(declare_helper create --file "${HOST_VARS}" "${flags[@]}" --dry-run)" || exit
    gum style --border rounded --padding "0 1" "The entry for ${HOST_VARS/#${HOME}/\~}" "" "${entry}" >&2
    echo "Each repository is listed with its default branch; work on other branches reaches the agents through pull requests, which need no listing." >&2
    rc=0
    # Default yes: the entry is only added (the file is backed up first), and it does
    # nothing until the play runs.
    gum confirm --default=true "Add team ${team} to ${HOST_VARS##*/}?" || rc=$?
    case "${rc}" in
    0) ;;
    1)
        echo "Nothing was added." >&2
        exit 1
        ;;
    *) cancelled ;;
    esac
    declare_helper create --file "${HOST_VARS}" "${flags[@]}"
}

cmd_create() {
    need_checkout
    create_wizard "$@"
}

# ── backup, restore: thin wrappers ───────────────────────────────────────────────────────

cmd_backup() {
    [[ $# -eq 1 && "$1" != -* ]] || usage_error "'backup' takes one team."
    sudo "${SUDO_INSTALLER}" backup-now --team "$1"
}

# pick_backup <team> <listing> — choose one of the team's backups in the picker; prints its
# number, or returns 1 when none was chosen.
pick_backup() {
    local team="$1" listing="$2" rows="" id when picked
    while IFS=$'\t' read -r _ id when; do
        rows+="$(printf 'Backup %-6s %s' "${id}" "${when}")"$'\n'
    done <<<"${listing}"
    picked="$(ccy_tmux_pick "Restore ${team}" "$(ccy_tmux_header "Enter choose   Esc or q exit" \
        "The homeserver is stopped, the backup's database and state put back, and it is started again.")" \
        "" <<<"${rows%$'\n'}")" || return 1
    picked="${picked#*$'\n'}"
    picked="${picked#Backup }"
    printf '%s\n' "${picked%% *}"
}

cmd_restore() {
    local team="" id="" yes=false listing
    while [[ $# -gt 0 ]]; do
        case "$1" in
        --yes) yes=true ;;
        -*) usage_error "unknown restore option '$1'." ;;
        *)
            if [[ -z "${team}" ]]; then
                team="$1"
            elif [[ -z "${id}" ]]; then
                id="$1"
            else
                usage_error "unexpected argument '$1'."
            fi
            ;;
        esac
        shift
    done
    [[ -n "${team}" ]] || usage_error "'restore' needs a team."
    if [[ -n "${id}" && ! "${id}" =~ ^[1-9][0-9]*$ ]]; then
        usage_error "a backup is named by its number; got '${id}'."
    fi
    if [[ -z "${id}" ]]; then
        listing="$(sudo "${SUDO_INSTALLER}" backups --team "${team}")"
        if [[ -z "${listing}" ]]; then
            print_error "team ${team} has no backup to restore."
            return 1
        fi
        if [[ ! -t 0 || ! -t 1 ]]; then
            printf '%s\n' "${listing}"
            usage_error "name the backup to restore: ccy-teams restore ${team} <n> --yes."
        fi
        id="$(pick_backup "${team}" "${listing}")" || {
            echo "Nothing restored." >&2
            return 0
        }
    fi
    if [[ "${yes}" == false ]]; then
        if [[ ! -t 0 || ! -t 1 ]]; then
            usage_error "a restore replaces the team's database and state: confirm it with --yes when there is no terminal."
        fi
        if ! ccy_tmux_confirm "Restore ${team}" \
            "Restore backup ${id} of ${team}? Its homeserver stops, and every message and change since that backup is lost." \
            "restore backup ${id}"; then
            echo "Nothing restored." >&2
            return 0
        fi
    fi
    sudo "${SUDO_INSTALLER}" restore --team "${team}" --backup "${id}"
}

case "${subcommand}" in
create)
    cmd_create "$@"
    exit
    ;;
backup)
    cmd_backup "$@"
    exit
    ;;
restore)
    cmd_restore "$@"
    exit
    ;;
esac

# ── the table ────────────────────────────────────────────────────────────────────────────
#
# One pass gathers everything into the R_* arrays, one entry per row, in the shell itself
# (not a subshell), so a key pressed on a row finds what the row stands for by its index.

_row() {
    printf '%-24s  %-36s  %-6s  %-9s  %-26s  %-7s  %s' "$@"
}
row_heading() {
    _row TEAM MEMBER KIND STATE SESSION RESTORE WHERE
}

R_TEXT=() R_TEAM=() R_KIND=() R_NAME=() R_HANDLE=() R_DIR=() R_SESSION=()
# add_row <team> <member> <kind> <state> <session> <restore> <where> <handle> <dir>
add_row() {
    R_TEXT+=("$(_row "$1" "$2" "$3" "$4" "$5" "$6" "$7")")
    R_TEAM+=("$1")
    R_NAME+=("$2")
    R_KIND+=("$3")
    R_SESSION+=("$5")
    R_HANDLE+=("$8")
    R_DIR+=("$9")
}

# The teams of this machine: those declared present, then any homeserver unit loaded here
# that is not (one declared absent but still installed, or made by hand).
TEAMS=()
declare -A PORT_OF=()
collect_teams() {
    local declared units team port state unit
    declare -A seen=()
    need_checkout
    declared="$(declare_helper declared --file "${HOST_VARS}")" || {
        print_error "the teams declared in ${HOST_VARS} could not be read (the reason is above)."
        return 1
    }
    while IFS=$'\t' read -r _ team port state; do
        [[ -n "${team}" && "${state}" == present ]] || continue
        TEAMS+=("${team}")
        PORT_OF["${team}"]="${port}"
        seen["${team}"]=1
    done <<<"${declared}"
    units="$(systemctl list-units --all --plain --no-legend --type=service 'agent-bus-hs@*')" || {
        print_error "systemctl could not list the agent-bus homeserver units."
        return 1
    }
    while read -r unit _; do
        [[ "${unit}" == agent-bus-hs@*.service ]] || continue
        team="${unit#agent-bus-hs@}"
        team="${team%.service}"
        [[ -z "${seen[${team}]:-}" ]] || continue
        TEAMS+=("${team}")
        seen["${team}"]=1
    done <<<"${units}"
}

# homeserver_state <team> — up, or down with systemd's word for it.
homeserver_state() {
    local state rc=0
    state="$(systemctl is-active "agent-bus-hs@$1.service")" || rc=$?
    if [[ "${rc}" -eq 0 && "${state}" == active ]]; then
        printf 'up\n'
    else
        printf 'down:%s\n' "${state:-unknown}"
    fi
}

# The ccy sessions with a registry record: per "<dir>|<seat>@<team>", the session holding it
# and whether it is restored; and every live session's attached count.
declare -A SEAT_SESSION=() SEAT_RESTORE=() LIVE=()
CHECKOUTS=()
declare -A CHECKOUT_SEEN=()
add_checkout() {
    [[ -n "$1" && -z "${CHECKOUT_SEEN[$1]:-}" ]] || return 0
    CHECKOUT_SEEN["$1"]=1
    CHECKOUTS+=("$1")
}
collect_sessions() {
    local listing name attached dir regdir file i list ref
    listing="$(ccy_tmux_list)" || return 1
    while read -r name attached dir; do
        [[ -n "${name}" ]] || continue
        LIVE["${name}"]="${attached}"
        [[ "${name}" != ccy-* ]] || add_checkout "${dir}"
    done <<<"${listing}"
    regdir="$(ccy_registry_dir)" || return 1
    for file in "${regdir}"/*; do
        [[ -e "${file}" && "${file}" != *.tmp.* ]] || continue
        if ! ccy_registry_read "${file}"; then
            print_error "the session record ${file} could not be read; its seats show no session."
            INCOMPLETE="a session record is unreadable"
            continue
        fi
        [[ "${REC_PREFIX}" == ccy ]] || continue
        add_checkout "${REC_DIR}"
        list=""
        for i in "${!REC_ARGS[@]}"; do
            case "${REC_ARGS[i]}" in
            --) break ;;
            --teams) list="${REC_ARGS[i + 1]:-}" ;;
            --teams=*) list="${REC_ARGS[i]#--teams=}" ;;
            esac
        done
        [[ -n "${list}" ]] || continue
        while read -r -d , ref; do
            SEAT_SESSION["${REC_DIR}|${ref}"]="${REC_NAME}"
            SEAT_RESTORE["${REC_DIR}|${ref}"]="${REC_RESTORE}"
        done <<<"${list},"
    done
    if project_here; then
        add_checkout "$(git rev-parse --show-toplevel)"
    fi
}

# Set when a seat or a session record could not be read: every team row then says so, and
# Ctrl-X parks no ccy member whose checkout is unknown, since it may be one of those seats.
INCOMPLETE=""

# seat_lines <dir> — `agent-bus seat list` in a checkout that has seats; nothing otherwise.
# A seat whose bundle cannot be read fails the command, but the others are still printed.
seat_lines() {
    [[ -d "$1/.claude/ccy/pingbus/seats" ]] || return 0
    (cd "$1" && agent-bus seat list)
}

# The member lines of each team, from sudo agent-bus list with sudo's cached credential
# (the picker asks for one first); a team whose members could not be read is in
# MEMBERS_UNKNOWN, with the reason on stderr.
declare -A MEMBERS_OF=() MEMBERS_UNKNOWN=()
collect_members() {
    local team="$1" out
    if ! out="$(sudo -n "${SUDO_AGENT_BUS}" list "${team}")"; then
        echo "The members of ${team} are left out: sudo agent-bus list ${team} failed (above). Run sudo -v first for --list." >&2
        MEMBERS_UNKNOWN["${team}"]=1
        return 0
    fi
    MEMBERS_OF["${team}"]="${out}"
}

collect() {
    local team state port dir seats kind name membership role activity handle seat seat_state
    local key session restore where
    local -a seat_dirs=() seat_rows=()
    local -A activity_of=() shown=()
    R_TEXT=() R_TEAM=() R_KIND=() R_NAME=() R_HANDLE=() R_DIR=() R_SESSION=()
    INCOMPLETE=""
    TEAMS=() PORT_OF=() SEAT_SESSION=() SEAT_RESTORE=() LIVE=() CHECKOUTS=() CHECKOUT_SEEN=()
    MEMBERS_OF=() MEMBERS_UNKNOWN=()
    collect_teams || return 1
    [[ -n "${TEAMS[*]:-}" ]] || return 0
    collect_sessions || return 1
    for dir in "${CHECKOUTS[@]}"; do
        if ! seats="$(seat_lines "${dir}")"; then
            print_error "agent-bus seat list could not read every seat in ${dir} (above); those are left out."
            INCOMPLETE="a seat is unreadable"
        fi
        while IFS= read -r seat; do
            [[ -n "${seat}" ]] || continue
            seat_dirs+=("${dir}")
            seat_rows+=("${seat}")
        done <<<"${seats}"
    done
    for team in "${TEAMS[@]}"; do
        state="$(homeserver_state "${team}")"
        port="${PORT_OF[${team}]:-}"
        where="port ${port:-unknown (not declared)}"
        if [[ "${state}" == up ]]; then
            collect_members "${team}"
        else
            MEMBERS_UNKNOWN["${team}"]=1
        fi
        [[ -z "${MEMBERS_UNKNOWN[${team}]:-}" ]] || where+=", members unknown"
        [[ -z "${INCOMPLETE}" ]] || where+=", ${INCOMPLETE} (above)"
        add_row "${team}" - team "${state}" - - "${where}" - -
        activity_of=()
        shown=()
        while IFS=$'\t' read -r kind name role membership activity; do
            [[ "${kind}" == MEMBER ]] || continue
            activity_of["${name}"]="${activity}"
        done <<<"${MEMBERS_OF[${team}]:-}"
        for key in "${!seat_rows[@]}"; do
            IFS=$'\t' read -r _ name seat seat_state _ handle <<<"${seat_rows[key]}"
            [[ "${name}" == "${team}" ]] || continue
            dir="${seat_dirs[key]}"
            shown["${handle}"]=1
            session="${SEAT_SESSION[${dir}|${seat}@${team}]:-}"
            restore="${SEAT_RESTORE[${dir}|${seat}@${team}]:--}"
            if [[ -z "${session}" ]]; then
                session="${seat_state}"
                restore=-
            elif [[ -z "${LIVE[${session}]+set}" ]]; then
                session+="(stopped)"
            fi
            add_row "${team}" "${seat}" ccy "${activity_of[${handle}]:-unknown}" "${session}" \
                "${restore}" "${dir/#${HOME}/\~}" "${handle}" "${dir}"
        done
        while IFS=$'\t' read -r kind name role membership activity; do
            [[ "${kind}" == MEMBER && -z "${shown[${name}]:-}" ]] || continue
            kind="${name##*.}"
            [[ "${kind}" != podman ]] || kind=ccy
            add_row "${team}" "${name}" "${kind}" "${activity}" - - "${role}" "${name}" -
        done <<<"${MEMBERS_OF[${team}]:-}"
        while IFS=$'\t' read -r kind name membership; do
            [[ "${kind}" == HUMAN ]] || continue
            add_row "${team}" "${name}" human "${membership}" - - - - -
        done <<<"${MEMBERS_OF[${team}]:-}"
    done
}

if [[ "${subcommand}" == -l || "${subcommand}" == --list ]]; then
    collect || exit 1
    if [[ -z "${R_TEXT[*]:-}" ]]; then
        echo "No agent teams on this machine. ccy-teams create declares one." >&2
        exit 0
    fi
    row_heading
    printf '\n'
    printf '%s\n' "${R_TEXT[@]}"
    exit 0
fi

# ── the picker ───────────────────────────────────────────────────────────────────────────
if [[ ! -t 0 || ! -t 1 ]]; then
    echo "ccy-teams needs a terminal: it attaches sessions to the one you are in. ccy-teams --list prints the table instead." >&2
    exit 1
fi

# offer_create — no team on this machine: say what a team is, and offer to create one now.
offer_create() {
    local rc=0
    need_tool gum playbooks/imports/play-claude-yolo.yml
    cat >&2 <<'EOF'
No agent teams on this machine yet.

A team is a group of agents (ccy sessions, LXC containers) and people who work together
in a private chat room on a homeserver on this machine, which you follow in Element.
EOF
    gum confirm --default=false "Create one now?" || rc=$?
    case "${rc}" in
    0)
        cmd_create
        exit
        ;;
    1)
        echo "Nothing created. ccy-teams create starts one whenever you like." >&2
        exit 0
        ;;
    *) cancelled ;;
    esac
}

# The teams are known without sudo: with none there is nothing to read, so nothing is asked.
collect_teams || exit 1
if [[ -z "${TEAMS[*]:-}" ]]; then
    offer_create
fi
echo "ccy-teams reads each team's members with sudo agent-bus list." >&2

here="${PWD/#${HOME}/\~}"

# row_index <row> — the index of the picked row, printed.
row_index() {
    local i
    for i in "${!R_TEXT[@]}"; do
        if [[ "${R_TEXT[i]}" == "$1" ]]; then
            printf '%s\n' "${i}"
            return 0
        fi
    done
    return 1
}

# attach_seat <i> — Enter on a seat: attach its live session here, as ccy-sessions does.
attach_seat() {
    local i="$1" session="${R_SESSION[$1]}" rc=0
    if [[ "${R_KIND[i]}" != ccy || -z "${LIVE[${session}]+set}" ]]; then
        echo "Enter attaches to a ccy seat's running session, and this row has none. Ctrl-N starts one." >&2
        return 0
    fi
    if [[ "${LIVE[${session}]}" != 0 ]]; then
        echo "'${session}' is open in another terminal. ccy-sessions takes it over (Ctrl-T)." >&2
        return 0
    fi
    ccy_tmux_attach "${session}" || rc=$?
    case "${rc}" in
    0) exit 0 ;;
    3) ;;
    *) echo "'${session}' was taken or ended just now — the list has been refreshed." >&2 ;;
    esac
}

# new_session <team> — Ctrl-N: ccy --teams in a free seat of this checkout, or a new one
# numbered after every numbered seat the team and this checkout already have.
new_session() {
    local team="$1" top seats line seat seat_state handle next=1 rows="" picked
    if ! project_here; then
        echo "${here} is not a project folder (no git repository), so ccy cannot be started here." >&2
        return 0
    fi
    if [[ "$(homeserver_state "${team}")" != up ]]; then
        echo "${team}'s homeserver is down, so no session can join it." >&2
        return 0
    fi
    # The seats are the checkout's, and ccy mounts the directory it starts in, so it is
    # started at the checkout's top whatever subdirectory this is.
    top="$(git rev-parse --show-toplevel)"
    if ! seats="$(seat_lines "${top}")"; then
        echo "Not every seat of this checkout could be read (above), so no seat is offered: one of them may be the seat a new session would take." >&2
        return 0
    fi
    while IFS=$'\t' read -r _ line seat seat_state _ handle; do
        [[ "${line}" == "${team}" ]] || continue
        [[ ! "${seat}" =~ ^[0-9]+$ ]] || ((seat < next)) || next=$((seat + 1))
        [[ "${seat_state}" != free ]] || rows+="Seat ${seat}@${team}   free"$'\n'
    done <<<"${seats}"
    while IFS=$'\t' read -r line handle _; do
        [[ "${line}" == MEMBER && "${handle}" =~ \.([0-9]+)\+[^+]*\.podman$ ]] || continue
        ((BASH_REMATCH[1] < next)) || next=$((BASH_REMATCH[1] + 1))
    done <<<"${MEMBERS_OF[${team}]:-}"
    rows+="Seat ${next}@${team}   new"
    picked="$(ccy_tmux_pick "New ccy session in ${team}" "$(ccy_tmux_header "Enter start   Esc or q back" \
        "Runs ccy --teams <seat>@${team} in ${top/#${HOME}/\~}; a new seat is created by that launch (sudo).")" "" \
        <<<"${rows}")" || return 0
    picked="${picked#*$'\n'}"
    picked="${picked#Seat }"
    picked="${picked%% *}"
    echo "Starting ccy --teams ${picked} in ${top/#${HOME}/\~}." >&2
    cd "${top}"
    exec "${CCY_LAUNCHER}" --teams "${picked}"
}

# toggle_restore <i> — Ctrl-R on a seat whose session has a record.
toggle_restore() {
    local i="$1" session="${R_SESSION[$1]%(stopped)}" key want
    key="${R_DIR[i]}|${R_NAME[i]}@${R_TEAM[i]}"
    if [[ "${R_KIND[i]}" != ccy || -z "${SEAT_RESTORE[${key}]:-}" ]]; then
        echo "Ctrl-R changes whether a seat's ccy session comes back after a reboot, and this row has no session." >&2
        return 0
    fi
    want=no
    [[ "${SEAT_RESTORE[${key}]}" == yes ]] || want=yes
    ccy_registry_set_restore "${session}" "${want}" || return 0
}

# remove_or_park <i> — Ctrl-X: a seat is removed with agent-bus seat remove in its checkout;
# any other member is parked.
remove_or_park() {
    local i="$1" team="${R_TEAM[$1]}" name="${R_NAME[$1]}" handle="${R_HANDLE[$1]}"
    case "${R_KIND[i]}" in
    team)
        echo "A team is removed by setting state: absent on its agent_bus_teams entry and running play-agent-bus.yml." >&2
        ;;
    human)
        echo "A team's humans are its agent_bus_teams entry's humans: change them there and run play-agent-bus.yml." >&2
        ;;
    ccy)
        if [[ "${R_DIR[i]}" != - ]]; then
            if ccy_tmux_confirm "Remove seat ${name}@${team}?" \
                "${handle} is parked (its token revoked; its history kept) and the seat's directory in ${R_DIR[i]/#${HOME}/\~} deleted. Launching into ${name}@${team} again brings it back." \
                "remove ${name}@${team}"; then
                if ! (cd "${R_DIR[i]}" && agent-bus seat remove "${name}@${team}"); then
                    echo "The seat was not removed, for the reason above." >&2
                fi
            fi
            return 0
        fi
        if [[ -n "${INCOMPLETE}" ]]; then
            echo "${handle} may be one of the seats that could not be read (above), so it is not parked here: remove it with agent-bus seat remove in its checkout." >&2
            return 0
        fi
        ;&
    *)
        if ccy_tmux_confirm "Park ${handle}?" \
            "Its token is revoked; its account, role and room are kept. add-member --seat returns it, and an agent_bus_lxc_members entry is returned by the next play run unless set absent." \
            "park ${handle}"; then
            if ! sudo -n "${SUDO_AGENT_BUS}" park-member "${team}" "${handle}"; then
                echo "${handle} was not parked, for the reason above." >&2
            fi
        fi
        ;;
    esac
}

# open_element <team> — Ctrl-E: the team's Element profile, through the launcher
# play-agent-bus-element.yml writes. A human of the team with no session on the homeserver
# has not logged in, and is offered a new password first.
open_element() {
    local team="$1" launcher i name devices
    launcher="${HOME}/.local/share/applications/agent-bus-${team}-element.desktop"
    if [[ ! -f "${launcher}" ]]; then
        echo "${team} has no Element profile on this desktop: add it to agent_bus_element_teams in the host_vars and run playbooks/imports/optional/common/play-agent-bus-element.yml." >&2
        return 0
    fi
    for i in "${!R_TEXT[@]}"; do
        [[ "${R_TEAM[i]}" == "${team}" && "${R_KIND[i]}" == human ]] || continue
        name="${R_NAME[i]}"
        if ! devices="$(sudo -n "${SUDO_AGENT_BUS}" human devices "${team}" "${name}")"; then
            echo "Whether ${name} has a session could not be asked (above), so Element was not opened." >&2
            return 0
        fi
        [[ -z "${devices}" ]] || continue
        if ccy_tmux_confirm "Password for ${name}" \
            "${name} has no session on ${team}'s homeserver. Set a new password? It is printed once, here, and stored nowhere." \
            "set a password for ${name}"; then
            if ! sudo -n "${SUDO_AGENT_BUS}" human password "${team}" "${name}"; then
                echo "No password was set for ${name} (above), so Element was not opened." >&2
                return 0
            fi
            echo "Copy it now. Press Enter to open Element." >&2
            if ! read -r _ </dev/tty; then
                echo >&2
            fi
        fi
    done
    echo "Opening ${team} in Element." >&2
    gio launch "${launcher}"
    exit 0
}

restore_word="off"
if [[ -e "${HOME}/.config/systemd/user/default.target.wants/ccy-sessions-restore.service" ]]; then
    restore_word="on"
fi
if project_here; then
    new_line="Ctrl-N starts ccy --teams <seat>@<the row's team> in ${here}"
else
    new_line="Ctrl-N unavailable: ${here} is not a project folder (no git repository)"
fi
HEADER="$(ccy_tmux_header "Enter attach   Ctrl-N new   Ctrl-R restore on/off   Ctrl-X remove/park   Ctrl-E Element   Esc or q quit" \
    "${new_line}" \
    "RESTORE: whether the seat's session is started again after a reboot; session restore on this machine is ${restore_word} (ccy_restore_sessions)" \
    "$(row_heading)")"

attempt=1
while :; do
    # Refreshed each pass: every later sudo is -n, and the picker may sit idle past the
    # credential's timeout.
    if ! sudo -v; then
        print_error "sudo refused, so the members cannot be read. ccy-teams --list shows the rest."
        exit 1
    fi
    collect || exit 1
    if [[ -z "${R_TEXT[*]:-}" ]]; then
        echo "No agent teams on this machine. ccy-teams create declares one." >&2
        exit 0
    fi
    if ! picked="$(printf '%s\n' "${R_TEXT[@]}" | ccy_tmux_pick "Agent teams" "${HEADER}" "ctrl-n,ctrl-r,ctrl-x,ctrl-e")"; then
        exit 0 # Esc or q
    fi
    key="${picked%%$'\n'*}"
    row="${picked#*$'\n'}"
    if ! index="$(row_index "${row}")"; then
        echo "That row has changed; the list has been refreshed." >&2
        continue
    fi
    case "${key}" in
    ctrl-n) new_session "${R_TEAM[index]}" ;;
    ctrl-r)
        toggle_restore "${index}"
        continue
        ;;
    ctrl-x)
        remove_or_park "${index}"
        continue
        ;;
    ctrl-e) open_element "${R_TEAM[index]}" ;;
    *) attach_seat "${index}" ;;
    esac
    attempt=$((attempt + 1))
    if [[ "${attempt}" -gt "${MAX_TRIES}" ]]; then
        echo "Nothing attached or started after ${MAX_TRIES} tries." >&2
        exit 1
    fi
done
