#!/usr/bin/env python3
"""
WSI-Article - Article Mode on the server's continuous dictation
================================================================
Records for as long as the user wants, through the warm server's continuous dictation
session (the same one Insert uses): the server cuts the speech at pauses, transcribes each
segment in order and journals it. This client keeps the session alive, follows the
journal, and gives wsi-article-window what it reads:

  article-buffer.txt          the phrases of the current chunk, as they commit
  article-raw.txt             flushed chunks, one paragraph each
  article-chunk.trigger       touched at each flush, so the window re-polishes
  article-recording.active    present while the session is recording

Every failure is loud: a notification that stays, a message on stderr and a non-zero exit.
Whatever the journal held is kept in the raw file first.
"""

import argparse
import importlib.machinery
import importlib.util
import json
import os
import signal
import sys
import time
from datetime import datetime
from pathlib import Path

SCRIPT_VERSION = "2.0.0"


def load_sibling(name):
    """Load the script `name` next to this one as a module (wsi-stream has no .py suffix)."""
    path = Path(__file__).resolve().parent / name
    loader = importlib.machinery.SourceFileLoader(f"{name.replace('-', '_')}_module", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


# The server protocol, its limits reader and the notification helpers live in wsi-stream
stream = load_sibling("wsi-stream")

LOG_DIR = stream.LOG_DIR
LOG_FILE = stream.LOG_FILE
CACHE_DIR = stream.CACHE_DIR

# The same PID file as wsi-stream, so the extension sees one recorder at a time
PID_FILE = stream.PID_FILE

ARTICLE_RAW_FILE = CACHE_DIR / "article-raw.txt"
ARTICLE_BUFFER_FILE = CACHE_DIR / "article-buffer.txt"
ARTICLE_TRIGGER_FILE = CACHE_DIR / "article-chunk.trigger"
ARTICLE_RECORDING_ACTIVE_FILE = CACHE_DIR / "article-recording.active"

# How often the buffer is flushed to the raw file, which is how often the window polishes.
# A polishing cadence, not a recording limit: the dictation's limits are in Settings.
FLUSH_SECONDS = 120
POLL_INTERVAL = 0.1

debug_mode = False
stop_requested = False


def log(message, level="INFO"):
    timestamp = datetime.now().strftime("%Y-%m-%dT%H:%M:%S")
    log_line = f"[{timestamp}] [ARTICLE] [{level}] {message}"
    if debug_mode:
        print(log_line, file=sys.stderr)
        LOG_DIR.mkdir(parents=True, exist_ok=True)
        with open(LOG_FILE, "a") as f:
            f.write(log_line + "\n")


def fail(message):
    """A failure the user must see: stderr, the log, a notification that stays, ERROR state."""
    log(message, "ERROR")
    print(f"wsi-article: {message}", file=sys.stderr)
    stream.emit_dbus_signal("StateChanged", "ERROR")
    stream.desktop_notification(message, 0)  # 0: stays until dismissed


def read_new_segments(path, offset):
    """The texts of the segments journaled since byte `offset`, and the new offset.

    A line still being written (no newline yet) is left for the next read. A missing
    journal is nothing yet. A complete line that is not a journal entry raises ValueError.
    """
    try:
        with open(path, "rb") as f:
            f.seek(offset)
            data = f.read()
    except FileNotFoundError:
        return [], offset
    complete = data.rfind(b"\n") + 1
    texts = []
    for line in data[:complete].splitlines():
        if not line.strip():
            continue
        try:
            entry = json.loads(line)
        except ValueError as e:
            raise ValueError(f"{path}: a line is not JSON: {e}") from e
        if not isinstance(entry, dict):
            raise ValueError(f"{path}: a line is not a journal entry: {line[:80]!r}")
        text = (entry.get("text") or "").strip()
        if entry.get("status") == "ok" and text:
            texts.append(text)
    return texts, offset + complete


def write_buffer(phrases):
    """The current chunk's phrases, for the window to show before the chunk is flushed."""
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    ARTICLE_BUFFER_FILE.write_text("\n".join(phrases))


def flush_chunk(phrases):
    """Append the chunk to the raw file as one paragraph and tell the window to polish."""
    if not phrases:
        return
    chunk = " ".join(phrases)
    chunk = chunk[0].upper() + chunk[1:]
    log(f"Flushing a chunk of {len(phrases)} phrase(s), {len(chunk)} chars")
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    with open(ARTICLE_RAW_FILE, "a") as f:
        f.write(chunk + "\n\n")
    ARTICLE_BUFFER_FILE.write_text("")  # its phrases are in the raw file now
    ARTICLE_TRIGGER_FILE.write_text(str(time.time()))


def remove_marker_files():
    for path in (PID_FILE, ARTICLE_BUFFER_FILE, ARTICLE_RECORDING_ACTIVE_FILE):
        path.unlink(missing_ok=True)


def request_stop(signum, frame):
    global stop_requested
    log(f"Signal {signum} received - stopping")
    stop_requested = True


def abort_startup(signum, frame):
    log(f"Signal {signum} received during server startup, aborting")
    raise SystemExit(1)  # the finally in run_article_mode removes the PID file and emits IDLE


def describe_failure(progress, session_dir):
    """The message for a dictation that ended FAILED."""
    lines = [f"Article dictation failed: {progress.get('error') or 'unknown error'}",
             f"The text so far is in the article window; the journal is "
             f"{progress.get('session_dir') or session_dir}/journal.jsonl"]
    if progress.get("kept_audio"):
        lines.append(f"Untranscribed audio kept in {progress.get('session_dir') or session_dir}")
    for unsaved in progress.get("unsaved_audio") or []:
        lines.append(f"Audio NOT kept: {unsaved}")
    return "\n".join(lines)


def run_article_mode(args):
    global debug_mode, stop_requested

    debug_mode = args.debug
    stream.debug_mode = args.debug
    stream.no_notify = args.no_notify
    stop_requested = False
    print(f"wsi-article v{SCRIPT_VERSION} starting (pid={os.getpid()})", file=sys.stderr)

    try:
        max_seconds, silence_seconds = stream.continuous_limits()
    except Exception as e:
        fail(f"Cannot read the dictation settings (re-run play-speech-to-text.yml): {e}")
        return 1
    log(f"Limit {max_seconds} s; no-speech stop {silence_seconds or 'off'}")

    # True from START until the server has acknowledged a STOP, or ended the dictation itself:
    # while it is, every exit sends one, so no exit leaves the microphone open
    recording_active = False
    session_dir = None
    all_texts = []
    phrases = []
    offset = 0
    last_flush = time.monotonic()

    PID_FILE.write_text(str(os.getpid()))
    signal.signal(signal.SIGINT, abort_startup)
    signal.signal(signal.SIGTERM, abort_startup)

    try:
        language = args.language or os.environ.get("WHISPER_LANGUAGE", "en") or "en"
        if not stream.is_server_running():
            stream.notify("PREPARING", "Starting server...")
            try:
                started = stream.start_server(language)
            except Exception as e:
                fail(f"Cannot start the server: {e}")
                return 1
            if not started:
                fail("Failed to start the server")
                return 1

        CACHE_DIR.mkdir(parents=True, exist_ok=True)
        ARTICLE_RAW_FILE.write_text("")
        ARTICLE_BUFFER_FILE.write_text("")
        ARTICLE_TRIGGER_FILE.unlink(missing_ok=True)

        signal.signal(signal.SIGINT, request_stop)
        signal.signal(signal.SIGTERM, request_stop)

        response = stream.send_server_command("START", {
            "continuous": True, "max_seconds": max_seconds, "silence_seconds": silence_seconds})
        if response.get("status") != "recording":
            fail(f"Failed to start the dictation: {response.get('message', response)}")
            return 1
        recording_active = True
        session_dir = response.get("session_dir")
        journal = Path(session_dir) / "journal.jsonl"
        ARTICLE_RECORDING_ACTIVE_FILE.write_text(str(os.getpid()))
        log(f"Article dictation started; journal {journal}")
        if response.get("undelivered"):
            stream.report_undelivered_dictation(response["undelivered"])

        # Not RECORDING on D-Bus: the panel's own recording countdown would stop an
        # article; the window shows the state of an article itself.

        def collect():
            """Read what the server journaled since the last read into the buffer."""
            nonlocal offset
            texts, offset = read_new_segments(journal, offset)
            if texts:
                all_texts.extend(texts)
                phrases.extend(texts)
                write_buffer(phrases)

        progress = {"status": "recording"}
        last_keepalive = last_progress = time.monotonic()
        while not stop_requested and progress.get("status") == "recording":
            now = time.monotonic()
            if now - last_keepalive >= stream.KEEPALIVE_INTERVAL:
                reply = stream.send_server_command("KEEPALIVE")
                last_keepalive = now
                if reply.get("status") == "error":
                    progress = reply
            if progress.get("status") == "recording" \
                    and now - last_progress >= stream.PROGRESS_INTERVAL:
                progress = stream.send_server_command("PROGRESS")
                last_progress = now
            collect()
            if phrases and time.monotonic() - last_flush >= FLUSH_SECONDS:
                flush_chunk(phrases)
                phrases.clear()
                last_flush = time.monotonic()
            time.sleep(POLL_INTERVAL)

        # STOP closes the microphone (or, if the server stopped on its own, just reports);
        # the segments still queued are then transcribed while we poll. A KEEPALIVE or
        # PROGRESS that failed ends up here too: STOP is sent so a server still recording
        # closes the microphone and keeps the text.
        if progress.get("status") in ("recording", "error"):
            if progress.get("status") == "error":
                log(f"Lost touch with the server ({progress}); sending STOP", "ERROR")
            else:
                log("Stop requested, sending STOP")
            progress = stream.send_server_command("STOP")
        else:
            log(f"The server ended the dictation itself: {progress}")
        if progress.get("status") != "error":
            recording_active = False

        # "stopping": the server is still closing the microphone; "draining": the last
        # segments are being transcribed. However long that takes, up to the server's own
        # deadline: nothing here kills the client or the session sooner.
        waiting_for = give_up_at = None
        while progress.get("status") in ("stopping", "draining"):
            status = progress["status"]
            if status != waiting_for:
                waiting_for = status
                allowance = (stream.MIC_CLOSE_SECONDS if status == "stopping"
                             else progress.get("drain_seconds_left", 0))
                give_up_at = time.monotonic() + allowance + stream.DRAIN_GRACE_SECONDS
            if time.monotonic() > give_up_at:
                progress = {"status": "error",
                            "message": "the server never finished transcribing"}
                break
            collect()
            time.sleep(stream.DRAIN_POLL_INTERVAL)
            progress = stream.send_server_command("PROGRESS")
        collect()

        status = progress.get("status")
        if status == "failed":
            flush_chunk(phrases)
            fail(describe_failure(progress, session_dir))
            return 1
        if status != "done":
            flush_chunk(phrases)
            fail(f"The dictation did not complete: {progress.get('message', progress)}. "
                 f"Any text transcribed so far is in {journal}")
            return 1

        final_text = (progress.get("transcription") or "").strip()
        journal_text = " ".join(all_texts)
        flush_chunk(phrases)
        if journal_text != final_text:
            fail(f"The journal and the server's final text disagree: the journal gave "
                 f"{len(journal_text)} chars, the final text {len(final_text)}. What the journal "
                 f"gave is in the article window; the server's text is in {journal}")
            return 1
        reason = progress.get("stop_reason") or ""
        if reason and reason != "stop requested":
            log(f"Stopped: {reason}", "WARN")
            stream.desktop_notification(f"Stopped: {reason}", 0)
        if not all_texts:
            log("No speech detected", "WARN")
        log("Article dictation ended cleanly")
        return 0

    except (OSError, ValueError) as e:
        flush_chunk_error = None
        try:
            flush_chunk(phrases)
        except OSError as flush_error:
            flush_chunk_error = flush_error
        suffix = f" (and the raw file could not be written: {flush_chunk_error})" \
            if flush_chunk_error else ""
        fail(f"Cannot follow the dictation journal {session_dir}/journal.jsonl: {e}{suffix}")
        return 1

    finally:
        if recording_active:
            reply = stream.send_server_command("STOP")
            log(f"Cleanup: STOP answered {reply}", "ERROR" if reply.get("status") == "error"
                else "INFO")
        remove_marker_files()
        stream.emit_dbus_signal("StateChanged", "IDLE")
        log("Marker files removed, IDLE signal sent")


def main():
    global debug_mode
    parser = argparse.ArgumentParser(description="Article mode: long dictation for the article window")
    parser.add_argument("-d", "--debug", action="store_true")
    parser.add_argument("-l", "--language", type=str, default=None)
    parser.add_argument("--no-notify", action="store_true")

    args = parser.parse_args()

    try:
        return run_article_mode(args)
    except Exception as e:
        debug_mode = True
        log(f"FATAL: {e}", "CRITICAL")
        import traceback
        log(traceback.format_exc(), "CRITICAL")
        fail(f"Article mode crashed: {e}")
        return 1


if __name__ == "__main__":
    sys.exit(main())
