#!/usr/bin/env python3
"""Whisper Model Manager — browse and download faster-whisper models.

Usage: wsi-model-manager [--download-auto]

--download-auto downloads the model `auto` picks on this machine for each recorder
mode, with no TUI and no prompt, then checks with wsi-resolve-model that its weights
are on disk. Progress goes to stderr; stdout carries one line per model,
`WSI-MODEL-DOWNLOADED <model_id> <repo>`, written only once every pick is verified.
Exit 0 when all are downloaded, 1 when the resolver cannot choose, a download fails or
the weights are still missing, 2 on a usage error.

Each row says how much GPU memory the model needs and whether this machine's NVIDIA GPU
has that much (wsi-resolve-model --fit, the one home of the sizes and the rule), or that
there is no usable NVIDIA GPU and the models run on the CPU. The cursor starts on the
most capable English-only model that fits. A model that does not fit is refused with
what it needs and what fits instead, and the list stays open for another choice; if
the fit cannot be told, every download is refused with the reason.

Every action is a button on screen, with its key beside it as a shortcut
(CLAUDE/InteractiveScripts.md rule 14): Download (d, or Enter on a row), Remove (r),
Refresh (F5), Clear filter (Esc) and Quit (q). / moves to the filter box; Tab moves
between the filter, the list and the buttons. Removing asks first, with Yes (y) and
No (n, Esc) buttons.
"""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

# ---------------------------------------------------------------------------
# Dependency checks
# ---------------------------------------------------------------------------

try:
    from textual.app import App, ComposeResult
    from textual.binding import Binding
    from textual.containers import Horizontal
    from textual.screen import Screen
    from textual.widgets import Button, DataTable, Footer, Header, Input, Static
    from textual import work
    from rich.text import Text
except ImportError:
    print("Error: 'textual' package is not installed.")
    print("Install with:  pip install --user textual")
    sys.exit(1)

try:
    from huggingface_hub import snapshot_download
except ImportError:
    print("Error: 'huggingface_hub' package is not installed.")
    print("It should be installed as a dependency of faster-whisper.")
    print("Install with:  pip install --user huggingface-hub")
    sys.exit(1)


# ---------------------------------------------------------------------------
# Model catalogue
# ---------------------------------------------------------------------------

# (model_id, label, hf_repo, english_only, description), smallest to most capable within
# each language group: the English-only model preselected is the last one that fits.
# Sizes and GPU memory needs are wsi-resolve-model's (--fit), never kept here.
MODELS: list[tuple[str, str, str, bool, str]] = [
    # Multilingual
    ('tiny',            'Tiny',           'Systran/faster-whisper-tiny',            False, 'Fastest, basic accuracy'),
    ('base',            'Base',           'Systran/faster-whisper-base',            False, 'Fast, good accuracy'),
    ('small',           'Small',          'Systran/faster-whisper-small',           False, 'Balanced speed/accuracy'),
    ('medium',          'Medium',         'Systran/faster-whisper-medium',          False, 'Great accuracy'),
    ('large-v2',        'Large v2',       'Systran/faster-whisper-large-v2',        False, 'Very high accuracy'),
    ('large-v3',        'Large v3',       'Systran/faster-whisper-large-v3',        False, 'Best quality'),
    ('large-v3-turbo',  'Large v3 Turbo', 'mobiuslabsgmbh/faster-whisper-large-v3-turbo', False, 'Distilled, fast + accurate'),
    # English-only
    ('tiny.en',         'Tiny EN',        'Systran/faster-whisper-tiny.en',         True,  'English only — fastest'),
    ('base.en',         'Base EN',        'Systran/faster-whisper-base.en',         True,  'English only — fast'),
    ('small.en',        'Small EN',       'Systran/faster-whisper-small.en',        True,  'English only — balanced'),
    ('medium.en',       'Medium EN',      'Systran/faster-whisper-medium.en',       True,  'English only — great'),
    ('distil-large-v3.5', 'Distil Large v3.5', 'distil-whisper/distil-large-v3.5-ct2', True, 'English only — fewer errors than turbo, faster'),
]
LABEL_FOR = {model_id: label for model_id, label, *_ in MODELS}

CACHE_DIR = Path.home() / '.cache' / 'huggingface' / 'hub'


RESOLVER = Path(__file__).resolve().parent / 'wsi-resolve-model'
SETTING_READER = Path(__file__).resolve().parent / 'wsi-setting'
AUTO_MODES = ('batch', 'streaming')


def session_language() -> str:
    """The language the recorders transcribe in: the Settings value, where `system`
    means the language part of $LANG, as the extension computes it."""
    result = subprocess.run([str(SETTING_READER), 'language'], capture_output=True,
                            text=True, timeout=10, check=False)
    if result.returncode != 0:
        raise RuntimeError(f'cannot read the language setting: {result.stderr.strip()}')
    value = result.stdout.strip()
    if value == 'system':
        return os.environ.get('LANG', 'en_GB.UTF-8').split('_')[0]
    return value


def auto_suggestions(language: str) -> dict[str, list[str]]:
    """The model `auto` picks on this machine, per recorder mode: {model_id: [modes]}.

    Asked of wsi-resolve-model --suggest, the same choice the recorders make, without
    its check that the model is downloaded. Raises RuntimeError with the resolver's
    reason when it cannot choose.
    """
    id_for = {repo: model_id for model_id, _label, repo, *_ in MODELS}
    picks: dict[str, list[str]] = {}
    for mode in AUTO_MODES:
        result = subprocess.run(
            [str(RESOLVER), '--suggest', '--mode', mode, '--language', language, 'auto'],
            capture_output=True, text=True, timeout=30, check=False)
        if result.returncode != 0:
            raise RuntimeError(result.stderr.strip().splitlines()[-1]
                               if result.stderr.strip() else f'{RESOLVER} failed')
        name = result.stdout.strip()
        picks.setdefault(id_for.get(name, name), []).append(mode)
    return picks


def machine_fit() -> dict:
    """wsi-resolve-model --fit: each offered model's size, GPU memory need and whether it
    fits this machine. Raises RuntimeError with the resolver's reason when it cannot tell."""
    result = subprocess.run([str(RESOLVER), '--fit'], capture_output=True, text=True,
                            timeout=60, check=False)
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip().splitlines()[-1]
                           if result.stderr.strip() else f'{RESOLVER} --fit failed')
    return json.loads(result.stdout)


def gb(mb: int) -> str:
    return f'{mb / 1024:.1f} GB'


def human_mb(mb: int) -> str:
    return gb(mb) if mb >= 1024 else f'{mb} MB'


def best_english_fit(fit: dict) -> str | None:
    """The most capable English-only model that fits, or None if none does."""
    fitting = [model_id for model_id, _label, _repo, english_only, _desc in MODELS
               if english_only and fit['models'][model_id]['fits']]
    return fitting[-1] if fitting else None


def fit_unknown_reason(fit_error: str) -> str:
    return (f'Downloads are off: this manager cannot tell which models fit this '
            f'machine ({fit_error}). Fix that, then reopen the manager.')


def download_refusal(model_id: str, fit: dict | None, fit_error: str) -> str | None:
    """Why model_id may not be downloaded here, or None when it may."""
    if fit is None:
        return fit_unknown_reason(fit_error)
    model = fit['models'][model_id]
    if model['fits']:
        return None
    best = best_english_fit(fit)
    instead = (f'{LABEL_FOR[best]} fits and is the best English model here.' if best
               else 'No English model fits this GPU.')
    return (f'{LABEL_FOR[model_id]} needs about {gb(model["needs_mb"])} of GPU memory, '
            f'but the {fit["gpu"]} has {gb(fit["gpu_memory_mb"])}, so it would not load. '
            f'Choose a smaller model: {instead}')


def fit_cell(model_id: str, fit: dict | None) -> str:
    if fit is None:
        return '?'
    if fit['device'] == 'cpu':
        return 'CPU'
    model = fit['models'][model_id]
    verdict = '✓ fits' if model['fits'] else '✗ too big'
    return f'{verdict} ({gb(model["needs_mb"])})'


def machine_line(fit: dict | None, fit_error: str) -> str:
    """One line on what the models are judged against."""
    if fit is None:
        return f'cannot tell which models fit this machine: {fit_error}'
    if fit['device'] == 'cpu':
        return ('No usable NVIDIA GPU: models run on the CPU (slower); no GPU memory '
                'limit applies')
    return f'GPU: {fit["gpu"]}, {gb(fit["gpu_memory_mb"])}'


def repo_cache_dir(repo_id: str) -> Path:
    """Return the HuggingFace cache directory for a given repo ID."""
    # HuggingFace stores repos as: models--{org}--{model}
    return CACHE_DIR / ('models--' + repo_id.replace('/', '--'))


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def get_installed() -> set[str]:
    """Return set of model IDs that are fully present in the HuggingFace cache.

    Present means a snapshot holds model.bin, the file WhisperModel loads: an
    interrupted download leaves a snapshot with only the small config files, and
    that model must show as not installed so it can be downloaded again.
    """
    installed: set[str] = set()
    for model_id, _label, repo_id, *_ in MODELS:
        snapshots = repo_cache_dir(repo_id) / 'snapshots'
        if snapshots.is_dir() and any((rev / 'model.bin').is_file() for rev in snapshots.iterdir()):
            installed.add(model_id)
    return installed


def human_size(path: Path) -> str:
    """Return human-readable size of a directory tree."""
    total = sum(f.stat().st_size for f in path.rglob('*') if f.is_file())
    for unit in ('B', 'KB', 'MB', 'GB'):
        if total < 1024:
            return f'{total:.0f} {unit}'
        total /= 1024.0
    return f'{total:.1f} TB'


# ---------------------------------------------------------------------------
# Confirmation screen
# ---------------------------------------------------------------------------

class ConfirmScreen(Screen):
    """Simple yes/no confirmation before removing a model."""

    BINDINGS = [
        Binding('y', 'confirm', 'Yes, remove'),
        Binding('n', 'cancel', 'No, cancel'),
        Binding('escape', 'cancel', 'Cancel'),
    ]

    def __init__(self, model_id: str) -> None:
        super().__init__()
        self._model_id = model_id

    def compose(self) -> ComposeResult:
        entry = next((m for m in MODELS if m[0] == self._model_id), None)
        repo_id = entry[2] if entry else f'Systran/faster-whisper-{self._model_id}'
        model_dir = repo_cache_dir(repo_id)
        try:
            size = human_size(model_dir)
        except Exception:
            size = '?'
        yield Static(
            f'\n  Remove model: [bold]{self._model_id}[/bold]\n\n'
            f'  Size on disk: {size}\n\n'
            f'  This deletes the model from the HuggingFace cache.\n'
            f'  You can re-download it at any time.\n',
            markup=True,
        )
        yield Horizontal(
            Button('Yes, remove it  (y)', action='screen.confirm', variant='error'),
            Button('No, keep it  (n, Esc)', action='screen.cancel'),
            id='answers',
        )

    def action_confirm(self) -> None:
        self.dismiss((True, self._model_id))

    def action_cancel(self) -> None:
        self.dismiss((False, self._model_id))


# ---------------------------------------------------------------------------
# Main app
# ---------------------------------------------------------------------------

class ModelManagerApp(App):
    """Whisper Model Manager — browse and download faster-whisper models."""

    CSS = """
    Screen {
        layout: vertical;
    }
    Input {
        height: 3;
        margin: 0 1;
    }
    DataTable {
        height: 1fr;
    }
    #status {
        height: auto;
        padding: 0 1;
        background: $surface;
        color: $text-muted;
    }
    #actions {
        height: auto;
    }
    """

    BINDINGS = [
        Binding('q', 'quit', 'Quit'),
        Binding('d', 'download', 'Download'),
        Binding('r', 'remove', 'Remove'),
        Binding('f5', 'refresh', 'Refresh'),
        Binding('/', 'focus_filter', 'Filter'),
        Binding('escape', 'clear_filter', 'Clear'),
    ]

    def __init__(self) -> None:
        super().__init__()
        self._installed: set[str] = set()
        self._downloading: set[str] = set()
        self._filter_text = ''
        self._visible_model_ids: list[str] = []  # tracks row order for cursor lookup
        self._download_progress: dict[str, str] = {}  # model_id → progress string
        self._suggested: dict[str, list[str]] = {}  # model_id → modes auto picks it for
        self._suggest_error = ''
        self._fit: dict | None = None  # wsi-resolve-model --fit; None when it cannot tell
        self._fit_error = ''

    def compose(self) -> ComposeResult:
        yield Header(show_clock=False)
        yield Input(placeholder='Filter models...  (press / to focus)', id='filter')
        yield DataTable(id='table', cursor_type='row', zebra_stripes=True)
        yield Static('', id='status')
        yield Horizontal(
            Button('Download  (d)', action='app.download', variant='primary'),
            Button('Remove  (r)', action='app.remove'),
            Button('Refresh  (F5)', action='app.refresh'),
            Button('Clear filter  (Esc)', action='app.clear_filter'),
            Button('Quit  (q)', action='app.quit'),
            id='actions',
        )
        yield Footer()

    def on_mount(self) -> None:
        self.title = 'Whisper Model Manager'
        self.sub_title = 'faster-whisper (Systran)'
        table = self.query_one('#table', DataTable)
        table.add_columns('Status', 'Model', 'Size', 'GPU memory', 'Lang', 'Description')
        try:
            self._suggested = auto_suggestions(session_language())
        except (RuntimeError, OSError, subprocess.TimeoutExpired) as e:
            self._suggest_error = f'auto cannot choose a model here: {e}'
        try:
            self._fit = machine_fit()
        except (RuntimeError, OSError, ValueError, subprocess.TimeoutExpired) as e:
            self._fit_error = str(e)
            self.notify(fit_unknown_reason(self._fit_error), severity='error', timeout=30)
        self._installed = get_installed()
        self._rebuild_table()
        best = best_english_fit(self._fit) if self._fit else None
        if best in self._visible_model_ids:
            table.move_cursor(row=self._visible_model_ids.index(best))
        table.focus()

    # ------------------------------------------------------------------
    # Table management
    # ------------------------------------------------------------------

    def _rebuild_table(self) -> None:
        table = self.query_one('#table', DataTable)
        table.clear()
        self._visible_model_ids = []
        f = self._filter_text.lower()

        for model_id, label, _repo, english_only, desc in MODELS:
            if f and f not in label.lower() and f not in desc.lower() and f not in model_id.lower():
                continue

            lang = Text('EN only', style='cyan') if english_only else Text('Multi', style='green')

            if model_id in self._downloading:
                prog = self._download_progress.get(model_id, '')
                label_text = f'⬇ {prog}' if prog else '⬇ Downloading…'
                status = Text(label_text, style='bold yellow')
            elif model_id in self._installed:
                status = Text('✓ Installed', style='bold green')
            else:
                status = Text('  Available', style='dim')

            if model_id in self._suggested:
                label = f'{label}  ★ auto'
            size = '?' if self._fit is None else human_mb(self._fit['models'][model_id]['size_mb'])
            cell = fit_cell(model_id, self._fit)
            fit_style = 'red' if cell.startswith('✗') else 'green' if cell.startswith('✓') else 'dim'
            table.add_row(status, label, size, Text(cell, style=fit_style), lang, desc,
                          key=model_id)
            self._visible_model_ids.append(model_id)

        self._update_status()

    def _update_status(self) -> None:
        n = len(self._installed)
        total = len(MODELS)
        dl = len(self._downloading)
        msg = f'{machine_line(self._fit, self._fit_error)}  ·  {n} of {total} models installed'
        if dl:
            msg += f'  ·  {dl} downloading...'
        if self._suggest_error:
            msg += f'  ·  {self._suggest_error}'
        elif self._suggested:
            picks = ', '.join(f"{LABEL_FOR.get(m, m)} ({' and '.join(modes)})"
                              for m, modes in self._suggested.items())
            msg += f'  ·  ★ auto picks {picks} here'
            if not n:
                msg += ': download one to start dictating'
        self.query_one('#status', Static).update(msg)

    def _selected_model_id(self) -> str | None:
        table = self.query_one('#table', DataTable)
        row = table.cursor_row
        if row < 0 or row >= len(self._visible_model_ids):
            return None
        return self._visible_model_ids[row]

    # ------------------------------------------------------------------
    # Input / filter
    # ------------------------------------------------------------------

    def on_input_changed(self, event: Input.Changed) -> None:
        if event.input.id == 'filter':
            self._filter_text = event.value
            self._rebuild_table()

    def action_focus_filter(self) -> None:
        self.query_one('#filter', Input).focus()

    def action_clear_filter(self) -> None:
        inp = self.query_one('#filter', Input)
        if inp.value:
            inp.value = ''
            self._filter_text = ''
            self._rebuild_table()
        self.query_one('#table', DataTable).focus()

    # ------------------------------------------------------------------
    # Refresh
    # ------------------------------------------------------------------

    def action_refresh(self) -> None:
        self._installed = get_installed()
        self._rebuild_table()
        self.notify('Model list refreshed')

    # ------------------------------------------------------------------
    # Download
    # ------------------------------------------------------------------

    def action_download(self) -> None:
        model_id = self._selected_model_id()
        if not model_id:
            self.notify('Select a model first', severity='warning')
            return
        if model_id in self._installed:
            self.notify(f'{model_id} is already installed', severity='warning')
            return
        if model_id in self._downloading:
            self.notify(f'{model_id} is already downloading', severity='warning')
            return
        self._start_download(model_id)

    def _start_download(self, model_id: str) -> None:
        """Download model_id unless it does not fit here; then say why and stay, so
        another model can be chosen."""
        refusal = download_refusal(model_id, self._fit, self._fit_error)
        if refusal:
            self.notify(refusal, title='Too big for this machine' if self._fit else
                        'Cannot check this machine', severity='error', timeout=15)
            return
        entry = next(m for m in MODELS if m[0] == model_id)
        self._downloading.add(model_id)
        self._rebuild_table()
        self.notify(f'Downloading {model_id}… this may take several minutes')
        self._do_download(model_id, entry[2])
        self._poll_progress(model_id)

    @work(thread=True)
    def _do_download(self, model_id: str, repo: str) -> None:
        # token=False: Systran models are public; avoids system keyring password prompts
        try:
            snapshot_download(repo_id=repo, local_files_only=False, token=False)
            self.call_from_thread(self._download_done, model_id, True, '')
        except Exception as exc:
            self.call_from_thread(self._download_done, model_id, False, str(exc))

    @work(thread=True)
    def _poll_progress(self, model_id: str) -> None:
        """Poll blobs directory size every second to show download progress."""
        entry = next((m for m in MODELS if m[0] == model_id), None)
        repo_id = entry[2] if entry else f'Systran/faster-whisper-{model_id}'
        blobs_dir = repo_cache_dir(repo_id) / 'blobs'
        expected = self._fit['models'][model_id]['size_mb'] * 1024 * 1024
        while model_id in self._downloading:
            try:
                if blobs_dir.exists():
                    downloaded = sum(
                        f.stat().st_size for f in blobs_dir.iterdir() if f.is_file()
                    )
                    dl_str = human_size(blobs_dir) if blobs_dir.exists() else '0 B'
                    if expected:
                        pct = min(99, int(downloaded * 100 / expected))
                        progress = f'{dl_str} / {pct}%'
                    else:
                        progress = dl_str
                    self.call_from_thread(self._set_progress, model_id, progress)
            except Exception:
                pass
            time.sleep(1)

    def _set_progress(self, model_id: str, progress: str) -> None:
        self._download_progress[model_id] = progress
        self._rebuild_table()

    def _download_done(self, model_id: str, success: bool, error: str) -> None:
        self._downloading.discard(model_id)
        self._download_progress.pop(model_id, None)
        if success:
            self._installed.add(model_id)
            self.notify(f'✓ {model_id} downloaded successfully')
        else:
            self.notify(f'✗ Download failed: {error}', severity='error')
        self._rebuild_table()

    # ------------------------------------------------------------------
    # Remove
    # ------------------------------------------------------------------

    def action_remove(self) -> None:
        model_id = self._selected_model_id()
        if not model_id:
            self.notify('Select a model first', severity='warning')
            return
        if model_id not in self._installed:
            self.notify(f'{model_id} is not installed', severity='warning')
            return
        self.push_screen(ConfirmScreen(model_id), self._remove_confirmed)

    def _remove_confirmed(self, result: tuple[bool, str]) -> None:
        confirmed, model_id = result
        if not confirmed:
            return
        entry = next((m for m in MODELS if m[0] == model_id), None)
        repo_id = entry[2] if entry else f'Systran/faster-whisper-{model_id}'
        model_dir = repo_cache_dir(repo_id)
        try:
            shutil.rmtree(model_dir)
            self._installed.discard(model_id)
            self._rebuild_table()
            self.notify(f'✓ {model_id} removed')
        except Exception as exc:
            self.notify(f'Failed to remove {model_id}: {exc}', severity='error')

    # ------------------------------------------------------------------
    # Table enter key = download
    # ------------------------------------------------------------------

    def on_data_table_row_selected(self, event: DataTable.RowSelected) -> None:
        # Enter key on an available model triggers download directly
        model_id = event.row_key.value if event.row_key else None
        if not model_id:
            return
        if model_id not in self._installed and model_id not in self._downloading:
            self._start_download(model_id)


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

def download_auto() -> int:
    """Download each model `auto` picks here, then verify its weights are on disk."""
    repo_for = {model_id: repo for model_id, _label, repo, *_ in MODELS}
    try:
        language = session_language()
        picks = auto_suggestions(language)
    except (RuntimeError, OSError, subprocess.TimeoutExpired) as e:
        print(f'wsi-model-manager: auto cannot choose a model here: {e}', file=sys.stderr)
        return 1
    unknown = [model_id for model_id in picks if model_id not in repo_for]
    if unknown:
        print(f'wsi-model-manager: auto picked {", ".join(unknown)}, which this manager '
              'has no download for', file=sys.stderr)
        return 1

    for model_id, modes in picks.items():
        repo = repo_for[model_id]
        print(f'wsi-model-manager: downloading {model_id} ({repo}) '
              f'for {" and ".join(modes)}, language {language}', file=sys.stderr)
        try:
            # token=False: the models are public; avoids system keyring password prompts
            snapshot_download(repo_id=repo, local_files_only=False, token=False)
        except Exception as e:
            print(f'wsi-model-manager: download of {repo} failed: {e}', file=sys.stderr)
            return 1
        print(f'wsi-model-manager: downloaded {model_id}', file=sys.stderr)

    for mode in AUTO_MODES:
        result = subprocess.run(
            [str(RESOLVER), '--mode', mode, '--language', language, 'auto'],
            capture_output=True, text=True, timeout=30, check=False)
        if result.returncode != 0:
            reason = result.stderr.strip() or f'{RESOLVER} exited {result.returncode}'
            print(f'wsi-model-manager: after the download, auto still cannot load a model '
                  f'for {mode}: {reason}', file=sys.stderr)
            return 1
        print(f'wsi-model-manager: {mode} resolves to {result.stdout.strip()}, on disk',
              file=sys.stderr)

    for model_id in picks:
        print(f'WSI-MODEL-DOWNLOADED {model_id} {repo_for[model_id]}')
    return 0


def main(argv: list[str]) -> int:
    if argv == ['--download-auto']:
        return download_auto()
    if argv in (['-h'], ['--help']):
        print(__doc__)
        return 0
    if argv:
        print(f'usage: wsi-model-manager [--download-auto] (got: {" ".join(argv)})',
              file=sys.stderr)
        return 2
    ModelManagerApp().run()
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
