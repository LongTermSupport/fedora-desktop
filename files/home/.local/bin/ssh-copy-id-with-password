#!/usr/bin/env bash
# ssh-copy-id-with-password — install a public key on a remote host, logging in
# with password auth only and offering no keys for the login itself.
#
# The ssh-copy-id companion to ssh-with-password. ssh-copy-id normally tries
# public-key auth first, which is exactly wrong when you are bootstrapping: the
# remote does not have your key yet, so you want the login to use the password.
# This wrapper forces password (or keyboard-interactive) auth and suppresses
# every public-key path for the login — no keys from ~/.ssh, no agent keys, no
# host-based auth — so the install always happens over a password session. The
# public key that gets installed is still chosen the normal ssh-copy-id way
# (its own -i, or your default identities).
#
# Usage:
#   ssh-copy-id-with-password [ssh-copy-id-args...] [user@]host
#   ssh-copy-id-with-password admin@host.example.com
#   ssh-copy-id-with-password -i ~/.ssh/id_ed25519.pub -p 2222 admin@host.example.com
#
# All arguments are passed straight through to ssh-copy-id, after the
# login-key-disabling options — so you can still add -i (key to install), -p,
# -f, -n, -o, etc.
set -euo pipefail

if [ "$#" -eq 0 ] || [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    echo "Usage: ssh-copy-id-with-password [ssh-copy-id-args...] [user@]host"
    echo ""
    echo "  Install a public key on a remote host, logging in with password"
    echo "  authentication only — the login offers no public keys."
    echo ""
    echo "  The key that gets installed is chosen the normal ssh-copy-id way"
    echo "  (-i KEY.pub, or your default identities). All arguments are"
    echo "  forwarded to ssh-copy-id."
    echo ""
    echo "Examples:"
    echo "  ssh-copy-id-with-password admin@host.example.com"
    echo "  ssh-copy-id-with-password -i ~/.ssh/id_ed25519.pub -p 2222 admin@host.example.com"
    [ "$#" -eq 0 ] && exit 1
    exit 0
fi

# PreferredAuthentications  — only ever try password / keyboard-interactive
# PubkeyAuthentication=no   — never attempt public-key auth for the login
# IdentitiesOnly=yes        — ignore identities not given explicitly (none here)
# IdentityAgent=none        — never consult the ssh-agent for login keys
#
# ssh-copy-id forwards every -o option to the ssh calls it makes, so these pin
# the login to password auth without affecting which key it installs.
opts=(
    -o PreferredAuthentications=password,keyboard-interactive
    -o PubkeyAuthentication=no
    -o IdentitiesOnly=yes
    -o IdentityAgent=none
)

exec ssh-copy-id "${opts[@]}" "$@"
