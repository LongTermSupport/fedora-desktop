#!/usr/bin/bash
# vmtest — host CLI for the VM lifecycle acceptance lab (Plan 00110).
#
# A thin executor: every decision (manifest parsing, freshness, the base record)
# lives in the unit-tested helpers that play-vm-test-lab.yml deploys to
# /usr/local/lib/ccy-helpers; this script fetches, verifies, boots and shells
# out. It reads only Ansible-deployed copies — the manifest, the guest scripts,
# the helpers — never the checkout (DESIGN.md §2.3).
#
# Usage:
#   vmtest fetch <base-key>                  download + verify the published artefact(s) a base is built from
#   vmtest build-base <base-key>             build a base from its artefact (fast kind: import, upgrade, clean, flatten)
#   vmtest run <scenario-id> [--commit SHA]  the full lifecycle: freshness gate, overlay, boot, run.bash at the
#                                            pinned commit, in-guest acceptance, transcript, verdict, destroy
#     A host_only scenario additionally REQUIRES, and only accepts:
#       --github-account <user>                a THROWAWAY GitHub account, never a real one
#       --github-token-file <path>             0600 file holding that account's scoped PAT
#       --github-ssh-passphrase-file <path>    0600 file holding the login key's passphrase
#     Secrets are named by PATH, never by value: a value on argv is visible to every user
#     on the host through `ps`. These options are refused on an ordinary scenario.
#   vmtest verify <run-id>                   check a bridge response's signature under the host-only key
#   vmtest refresh-base <base-key|profile|all>   bring a base up to date: a fast base is re-imported from the
#                                            published image (minutes); a full base is reinstalled from its media
#   vmtest freshness-status [--deep]         probe upstream and REPORT every base's freshness; never rebuilds.
#                                            --deep re-hashes every base disk against its record
#   vmtest sweep                             apply the retention policy (runs, failed builds, spool); logs every eviction
#   vmtest nightly                           freshness-status --deep, then sweep — what the nightly timer runs
#   vmtest help
#
# `run` provisions from a PUSHED commit of the public repo (the branch tip on the
# remote by default), never from a checkout — a transcript must point at code a
# human can review (DESIGN.md §3.4). Exit 0 only on verdict pass; the response
# document is written to runs/<run-id>/response.json either way.
#
# Rootless throughout: qemu:///session, user-mode networking with a passt port
# forward to the guest's SSH, the lab's own throwaway ed25519 key. Everything
# lands under ~/.local/share/vmtest and nothing touches the checkout.
#
# Exit codes: 0 success; 1 a step failed and said why; 64 usage.
set -euo pipefail

VMTEST_HOME="${VMTEST_HOME:-${HOME}/.local/share/vmtest}"
VMTEST_HELPERS_LIB="${VMTEST_HELPERS_LIB:-/usr/local/lib/ccy-helpers}"
readonly VMTEST_HOME VMTEST_HELPERS_LIB
readonly LAB_ENV="${VMTEST_HOME}/lab.env"
readonly MANIFEST="${VMTEST_HOME}/scenarios.json"
readonly SSH_KEY="${VMTEST_HOME}/ssh/lab-key"
readonly GUEST_CLEANUP="${VMTEST_HOME}/guest-cleanup.bash"
readonly ALLOWLIST="${VMTEST_HOME}/scenarios.allowlist"
# The scenarios only a human at this CLI may run, because they handle a real credential.
# Disjoint from ALLOWLIST by construction (helpers/vmtest/scenarios.py), and absent rather
# than empty when there are none, so a stale file cannot read as permission.
readonly HOST_ONLY_LIST="${VMTEST_HOME}/scenarios.host-only"
readonly RUNS_DIR="${VMTEST_HOME}/runs"
readonly IMAGES_DIR="${VMTEST_HOME}/images"
readonly BASES_DIR="${VMTEST_HOME}/bases"
readonly GPG_KEYDIR="/usr/share/distribution-gpg-keys/fedora"
readonly ARCH="x86_64"
readonly CLOUD_USER="fedora"
readonly BUILD_DISK_SIZE="20G"
# The base build recipe's version. Bump it whenever the way a base is BUILT
# changes (disk size, cloud-init options, the upgrade step, what is cleaned);
# the recipe digest is this number plus guest-cleanup.bash, so a recipe change
# reinstalls every base (§4.4) while an unrelated edit to this CLI does not.
readonly BUILD_RECIPE_VERSION=1
readonly SSH_WAIT_SECONDS=600
readonly SHUTDOWN_WAIT_SECONDS=300
# An Anaconda install from the network tree, in minutes; virt-install waits this long
# for the installer to power off before the build is declared failed.
readonly INSTALL_WAIT_MINUTES=90
# The VM kickstarts for the full bases and the desktop session runner, Ansible-deployed
# next to the guest scripts; the deployed copies are the authority.
readonly KS_SERVER="${VMTEST_HOME}/ks-vm-server.cfg"
readonly KS_DESKTOP="${VMTEST_HOME}/ks-vm-desktop.cfg"
readonly SESSION_RUNNER="${VMTEST_HOME}/vmtest-session-provision.bash"
# Inside a desktop guest: where the session runner and the host exchange the run.
readonly GUEST_RUN_STATE="/var/lib/vmtest"
readonly PROVISION_TIMEOUT_SECONDS=5400
# A scenario's in-guest fixture. Generous because one of them installs a kernel, which
# is a download and an initramfs build; still bounded, because a wedged fixture must not
# hold a guest open indefinitely.
readonly PREPARE_TIMEOUT_SECONDS=1800
readonly LIBVIRT_URI="qemu:///session"
# RFC 2606 reserved: the guest's git identity is a placeholder by design.
readonly GUEST_USER_EMAIL="vmtest@example.com"

log() { printf '==> %s\n' "$*" >&2; }
die() {
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}
usage() {
    sed -n '2,/^set -euo/p' "${BASH_SOURCE[0]}" | grep -E '^#( |$)' | cut -c3-
}
helper() {
    local module="${1:?helper requires a module}"
    shift
    env PYTHONPATH="${VMTEST_HELPERS_LIB}" python3 -m "helpers.vmtest.${module}" "$@"
}

# ── lab state ─────────────────────────────────────────────────────────────────────────────

load_lab() {
    [[ -r "${LAB_ENV}" ]] || die "no ${LAB_ENV}; deploy the lab with play-vm-test-lab.yml first"
    # shellcheck source=/dev/null
    source "${LAB_ENV}"
    [[ "${VMTEST_FEDORA_VERSION:-}" =~ ^[0-9]+$ ]] || die "${LAB_ENV} does not set VMTEST_FEDORA_VERSION"
    [[ "${VMTEST_REPO_URL:-}" == https://* ]] || die "${LAB_ENV} does not set an https VMTEST_REPO_URL"
    [[ -n "${VMTEST_REPO_BRANCH:-}" ]] || die "${LAB_ENV} does not set VMTEST_REPO_BRANCH"
    [[ -r "${MANIFEST}" ]] || die "no ${MANIFEST}; deploy the lab with play-vm-test-lab.yml first"
    [[ -r "${SSH_KEY}" && -r "${SSH_KEY}.pub" ]] || die "no lab SSH key at ${SSH_KEY}; deploy the lab first"
    [[ -r "${GUEST_CLEANUP}" ]] || die "no ${GUEST_CLEANUP}; deploy the lab first"
    [[ -d "${GPG_KEYDIR}" ]] || die "${GPG_KEYDIR} is missing; distribution-gpg-keys is installed by play-vm-test-lab.yml"
    mkdir -p "${IMAGES_DIR}" "${BASES_DIR}"
}

# base_facts <key> — the base's manifest facts as BASE_* variables, via the validator's marker.
base_facts() {
    local key="${1:?base_facts requires a base key}" line field
    line="$(helper validate_manifest --fedora-version "${VMTEST_FEDORA_VERSION}" --base "${key}" <"${MANIFEST}")"
    [[ "${line}" == VMTEST-BASE* ]] || die "unexpected validator output: ${line}"
    for field in ${line#VMTEST-BASE }; do
        case "${field}" in
            name=*) BASE_NAME="${field#name=}" ;;
            kind=*) BASE_KIND="${field#kind=}" ;;
            profile=*) BASE_PROFILE="${field#profile=}" ;;
            tree=*) BASE_TREE="${field#tree=}" ;;
            vcpus=*) BASE_VCPUS="${field#vcpus=}" ;;
            ram_mib=*) BASE_RAM_MIB="${field#ram_mib=}" ;;
            key=*) ;;
            *) die "unknown field in validator marker: ${field}" ;;
        esac
    done
    : "${BASE_NAME:?}" "${BASE_KIND:?}" "${BASE_PROFILE:?}" "${BASE_TREE:?}" "${BASE_VCPUS:?}" "${BASE_RAM_MIB:?}"
}

# scenario_facts <id> — the scenario's manifest facts as SCENARIO_* variables.
scenario_facts() {
    local id="${1:?scenario_facts requires a scenario id}" line field
    line="$(helper validate_manifest --fedora-version "${VMTEST_FEDORA_VERSION}" --scenario "${id}" <"${MANIFEST}")"
    [[ "${line}" == VMTEST-SCENARIO* ]] || die "unexpected validator output: ${line}"
    for field in ${line#VMTEST-SCENARIO }; do
        case "${field}" in
            base=*) SCENARIO_BASE_KEY="${field#base=}" ;;
            base_name=*) SCENARIO_BASE_NAME="${field#base_name=}" ;;
            profile=*) SCENARIO_PROFILE="${field#profile=}" ;;
            planned=*) SCENARIO_PLANNED="${field#planned=}" ;;
            max_skipped=*) SCENARIO_MAX_SKIPPED="${field#max_skipped=}" ;;
            runnable=*) SCENARIO_RUNNABLE="${field#runnable=}" ;;
            host_only=*) SCENARIO_HOST_ONLY="${field#host_only=}" ;;
            reboot_before_checks=*) SCENARIO_REBOOT_BEFORE_CHECKS="${field#reboot_before_checks=}" ;;
            run_env=*) SCENARIO_RUN_ENV="${field#run_env=}" ;;
            id=*) ;;
            *) die "unknown field in validator marker: ${field}" ;;
        esac
    done
    : "${SCENARIO_BASE_KEY:?}" "${SCENARIO_BASE_NAME:?}" "${SCENARIO_PROFILE:?}" "${SCENARIO_PLANNED:?}" \
        "${SCENARIO_MAX_SKIPPED:?}" "${SCENARIO_RUNNABLE:?}" "${SCENARIO_HOST_ONLY:?}" \
        "${SCENARIO_REBOOT_BEFORE_CHECKS:?}" "${SCENARIO_RUN_ENV:?}"
    # Neither "true" nor "false" means the validator and this CLI disagree about the
    # marker. Defaulting either way would decide whether a credential-bearing run is
    # treated as ordinary, so it is a refusal.
    case "${SCENARIO_HOST_ONLY}" in
        true | false) ;;
        *) die "validator reported host_only='${SCENARIO_HOST_ONLY}', which is neither true nor false" ;;
    esac
    # Same refusal, for the same kind of reason: defaulting this one decides whether a
    # desktop scenario's checks see the session that installed its extensions or the
    # one after it, and both answers look like a run that worked.
    case "${SCENARIO_REBOOT_BEFORE_CHECKS}" in
        true | false) ;;
        *) die "validator reported reboot_before_checks='${SCENARIO_REBOOT_BEFORE_CHECKS}', which is neither true nor false" ;;
    esac
}

# host_only_preflight <scenario-id> <github-account> <token-file> <ssh-passphrase-file>
#
# Every gate a credential-bearing run must pass before anything boots (Plan 00121). A
# host-only scenario puts a REAL GitHub PAT and a real SSH passphrase into a guest, so this
# is the last point at which the run can be stopped for free.
#
# It is one of THREE independent gates, and deliberately not the only one: the scenario is
# absent from the bridge allowlist so the watcher rejects it, and `bridge_run` refuses it
# from the manifest before dispatch. Any one of the three alone would be a single point of
# failure, and a gate that only ever permits is this repo's cardinal defect.
#
# Inputs are parameters rather than globals so the whole gate can be driven from
# scripts/test-vmtest-host-only-gate.bash without standing up a lab.
host_only_preflight() {
    local scenario_id="${1:?host_only_preflight requires a scenario id}"
    local account="${2-}" token_file="${3-}" pp_file="${4-}" secret mode

    # bridge_run declares itself when it launches this CLI. The bridge's own argv is
    # hardcoded and cannot carry the options below, so this is belt to that braces.
    if [[ "${VMTEST_FROM_BRIDGE:-}" == "1" ]]; then
        die "${scenario_id} handles a real credential and was launched by the bridge; it is run by a human at the host CLI only"
    fi

    # Absent, not empty, is how the playbook leaves the file when nothing is host-only, so a
    # missing list must not read as "no restriction".
    if [[ ! -r "${HOST_ONLY_LIST}" ]] || ! grep -qx "${scenario_id}" "${HOST_ONLY_LIST}"; then
        die "${scenario_id} is not in the deployed host-only list ${HOST_ONLY_LIST}; re-run play-vm-test-lab.yml on the host"
    fi

    # The two enumerations are disjoint by construction in scenarios.py. If they are not
    # disjoint ON DISK, a deployed file has been hand-edited — and the file that would have
    # been edited is the one keeping this run's PAT away from the bridge.
    if [[ -r "${ALLOWLIST}" ]] && grep -qx "${scenario_id}" "${ALLOWLIST}"; then
        die "${scenario_id} is on both the bridge allowlist and the host-only list; they are built disjoint, so one of them has been edited by hand"
    fi

    # A GitHub username, which is interpolated into an SSH command line. The grammar is the
    # guard: GitHub's own rule is alphanumerics and single hyphens, never leading or trailing.
    if [[ -z "${account}" ]]; then
        die "${scenario_id} needs --github-account: the throwaway GitHub account this run authenticates as"
    fi
    if [[ ! "${account}" =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$ ]]; then
        die "--github-account '${account}' is not a GitHub username (alphanumerics and single hyphens)"
    fi

    if [[ -z "${token_file}" ]]; then
        die "${scenario_id} needs --github-token-file: a 0600 file holding a scoped PAT for a THROWAWAY account (scopes: vars/github-required-scopes.yml plus admin:public_key)"
    fi
    if [[ -z "${pp_file}" ]]; then
        die "${scenario_id} needs --github-ssh-passphrase-file: a 0600 file holding the passphrase run.bash will protect the generated login key with"
    fi

    # Paths, never values: a secret on argv is visible to every user on the box through `ps`.
    for secret in "${token_file}" "${pp_file}"; do
        if [[ ! -r "${secret}" ]]; then
            die "secret file ${secret} is not readable"
        fi
        if [[ ! -s "${secret}" ]]; then
            die "secret file ${secret} is empty; an empty secret cannot be redacted from the transcript afterwards, nor verified absent from it"
        fi
        mode="$(stat -c '%a' "${secret}")"
        if [[ "${mode}" != "600" && "${mode}" != "400" ]]; then
            die "secret file ${secret} is mode ${mode}; it must be 0600 or 0400, or every account on this host can read it before the run even starts"
        fi
    done
}

# ── host-only scenarios: getting the secrets in, and making sure nothing carries them out ──
#
# GUEST_SECRET_DIR is tmpfs inside the guest, so nothing here touches the overlay that
# outlives the run. The guest is destroyed either way; this bounds what a mid-run snapshot or
# a crashed teardown could hold.
readonly GUEST_SECRET_DIR="/dev/shm/vmtest-secrets"
# The run-log scrubber, deployed with the lab. It sources the commit gate's detection engine
# from a path relative to its own, so the two travel together and there is one matcher.
readonly SCRUB_LIB="${VMTEST_HOME}/lib/run-log-scrub.bash"

# push_guest_secrets <token-file> <passphrase-file> — deliver by scp, name by path.
# scp never puts the CONTENT on a command line, so the bytes are absent from the guest's argv
# and from anything `ps` can show.
push_guest_secrets() {
    local token_file="${1:?}" pp_file="${2:?}"
    guest_ssh "umask 077 && mkdir -p ${GUEST_SECRET_DIR} && chmod 0700 ${GUEST_SECRET_DIR}"
    guest_scp "${token_file}" "${CLOUD_USER}@127.0.0.1:${GUEST_SECRET_DIR}/gh-token"
    guest_scp "${pp_file}" "${CLOUD_USER}@127.0.0.1:${GUEST_SECRET_DIR}/ssh-passphrase"
    guest_ssh "chmod 0600 ${GUEST_SECRET_DIR}/gh-token ${GUEST_SECRET_DIR}/ssh-passphrase"
}

# drop_guest_secrets — remove what the harness delivered, before the checker looks.
# run.bash unlinking its OWN transient files is what the scenario tests; these two are the
# harness's, and leaving them would make the residue checks fail on the harness's own
# fixture rather than on anything run.bash did.
drop_guest_secrets() {
    guest_ssh "rm -f ${GUEST_SECRET_DIR}/gh-token ${GUEST_SECRET_DIR}/ssh-passphrase"
}

# push_guest_needles <token-file> <passphrase-file> — the exact bytes the checker searches
# for, one per line, 0600. Written with `cat` over ssh rather than as an argument, for the
# same reason as above. The checker unlinks it before its first scan and fails if it survives.
push_guest_needles() {
    local token_file="${1:?}" pp_file="${2:?}"
    guest_ssh "umask 077 && mkdir -p ${GUEST_SECRET_DIR} && chmod 0700 ${GUEST_SECRET_DIR}"
    # The trailing newline belongs to the host's file, not to the secret; the checker matches
    # literal bytes, so carrying it in would make every needle fail to match.
    {
        printf '%s\n' "$(cat -- "${token_file}")"
        printf '%s\n' "$(cat -- "${pp_file}")"
    } | guest_ssh "umask 077 && cat > ${GUEST_SECRET_DIR}/needles"
}

# scrub_run_artefacts <token-file> <passphrase-file> <artefact>... — redact the supplied
# secrets from what this run wrote, then REFUSE if any survive (Plan 00121 Phase 1).
#
# The verify half is the point. A scrubber is fail-open by nature: it writes a file it
# believes is clean, and a miss is silent. So a residual secret stops the run here rather than
# leaving a transcript a human will later paste somewhere.
#
# The library is sourced HERE rather than at load: it is only needed by a host-only run, and
# a CLI that refused to start because an optional deployed file was missing would break every
# ordinary scenario too. Absent when it IS needed is a hard failure, never a skipped scrub.
scrub_run_artefacts() {
    local token_file="${1:?}" pp_file="${2:?}"
    shift 2
    local artefact
    if ! declare -F scrub_verify >/dev/null; then
        [[ -r "${SCRUB_LIB}" ]] ||
            die "no ${SCRUB_LIB}: this run handled a real credential and its artefacts cannot be checked for residue; re-run play-vm-test-lab.yml on the host"
        # shellcheck source=/dev/null
        source "${SCRUB_LIB}"
    fi
    for artefact in "$@"; do
        [[ -f "${artefact}" ]] || continue
        scrub_redact "${artefact}" "${token_file}" "github-token"
        scrub_redact "${artefact}" "${pp_file}" "ssh-passphrase"
        if ! scrub_verify "${artefact}" "${token_file}" "${pp_file}"; then
            die "a supplied secret survived redaction in ${artefact}; the run's artefacts are NOT safe to share (they remain under ${RUN_DIR})"
        fi
    done
}

# run_env_assignments — the scenario's RUN_BASH_* overrides as `KEY='value'` words for the
# guest's `env`, from the validator's comma-separated marker field ("-" when none). The
# validator has already confined keys to a closed allowlist and values to plain tokens.
run_env_assignments() {
    local pair
    if [[ "${SCENARIO_RUN_ENV}" == "-" ]]; then
        return 0
    fi
    IFS=',' read -r -a pairs <<<"${SCENARIO_RUN_ENV}"
    for pair in "${pairs[@]}"; do
        [[ "${pair}" =~ ^RUN_BASH_[A-Z_]+=[A-Za-z0-9._,:/=-]+$ ]] || die "malformed run_env entry: ${pair}"
        printf " %s='%s'" "${pair%%=*}" "${pair#*=}"
    done
}

# recipe_digest_now <kind> — the build recipe's digest: the recipe version and the in-guest
# cleanup for every base, plus the kickstart for a full one (§3.2: a change to how a base
# is built invalidates it).
recipe_digest_now() {
    local kind="${1:?recipe_digest_now requires the base kind}" profile="${2:?recipe_digest_now requires the profile}" ks
    {
        printf 'build-recipe-version=%s\n' "${BUILD_RECIPE_VERSION}"
        cat "${GUEST_CLEANUP}"
        if [[ "${kind}" == "full" ]]; then
            ks="$(kickstart_for "${profile}")"
            cat "${ks}"
            if [[ "${profile}" == "desktop" ]]; then
                [[ -r "${SESSION_RUNNER}" ]] || die "no ${SESSION_RUNNER}; deploy the lab first"
                cat "${SESSION_RUNNER}"
            fi
        fi
    } | sha256sum | cut -d' ' -f1
}

# kickstart_for <profile> — the deployed VM kickstart a full base of this profile installs from.
kickstart_for() {
    local profile="${1:?}" ks
    case "${profile}" in
        server) ks="${KS_SERVER}" ;;
        desktop) ks="${KS_DESKTOP}" ;;
        *) die "no VM kickstart for profile ${profile}" ;;
    esac
    [[ -r "${ks}" ]] || die "no ${ks}; deploy the lab first"
    printf '%s\n' "${ks}"
}

# probe_upstream — run the freshness probe once; its marker lines land in PROBE_FILE.
# An unreadable signal is the §4.5 fail-fast case: the lab blocks rather than guessing.
probe_upstream() {
    PROBE_FILE="$(mktemp --tmpdir vmtest-probe.XXXXXX)"
    if ! helper probe_upstream --fedora-version "${VMTEST_FEDORA_VERSION}" --manifest "${MANIFEST}" >"${PROBE_FILE}"; then
        grep '^VMTEST-FRESHNESS-UNREADABLE' "${PROBE_FILE}" >&2
        die "upstream freshness signal unavailable — cannot prove what the published media is"
    fi
}

probe_value() {
    local marker="${1:?probe_value requires a marker}" value
    value="$(grep -E "^${marker} " "${PROBE_FILE}")" || die "probe printed no ${marker} line"
    printf '%s\n' "${value#"${marker}" }"
}

# ── fetch ─────────────────────────────────────────────────────────────────────────────────

# download_file <url> <dest> — curl -z, so a current local copy costs one conditional GET.
download_file() {
    local url="${1:?}" dest="${2:?}" temp
    temp="${dest}.partial"
    rm -f "${temp}"
    local -a args=(-fL --progress-bar -o "${temp}")
    if [[ -f "${dest}" ]]; then
        args+=(-z "${dest}")
    fi
    if ! curl "${args[@]}" "${url}"; then
        rm -f "${temp}"
        die "download failed: ${url}"
    fi
    if [[ -s "${temp}" ]]; then
        mv -f "${temp}" "${dest}"
        log "downloaded $(basename "${dest}") ($(stat -c %s "${dest}") bytes)"
    else
        rm -f "${temp}"
        [[ -f "${dest}" ]] || die "no local copy and the server sent nothing: ${url}"
        log "$(basename "${dest}") is current (not modified upstream)"
    fi
}

# verify_signed_checksum <checksum-file> — GPG-verify a clearsigned CHECKSUM against the
# branch's Fedora release key. Hard failure: an unverifiable CHECKSUM certifies nothing.
verify_signed_checksum() {
    local file="${1:?}" key="${GPG_KEYDIR}/RPM-GPG-KEY-fedora-${VMTEST_FEDORA_VERSION}-primary" home
    [[ -r "${key}" ]] || die "no Fedora ${VMTEST_FEDORA_VERSION} release key at ${key}"
    home="$(mktemp -d --tmpdir vmtest-gnupg.XXXXXX)"
    chmod 700 "${home}"
    if ! gpg2 --homedir "${home}" --quiet --import "${key}" 2>"${home}/import.log"; then
        cat "${home}/import.log" >&2
        rm -rf "${home}"
        die "could not import ${key}"
    fi
    if ! gpg2 --homedir "${home}" --verify "${file}" 2>"${home}/verify.log"; then
        cat "${home}/verify.log" >&2
        rm -rf "${home}"
        die "GPG signature verification FAILED for $(basename "${file}") — refusing the artefact"
    fi
    rm -rf "${home}"
    log "GPG signature verified on $(basename "${file}")"
}

# fetch_artefact <filename> <sha256-from-releases.json> <label> <variant> <url>
fetch_artefact() {
    local filename="${1:?}" sha="${2:?}" label="${3:?}" variant="${4:?}" url="${5:?}"
    local dest="${IMAGES_DIR}/${filename}" checksum_name checksum_url checksum_file expected actual
    download_file "${url}" "${dest}"

    # The signed CHECKSUM sits beside the artefact and its name is structured
    # (variant + compose label + arch), so no directory listing is scraped.
    checksum_name="Fedora-${variant}-${label}-${ARCH}-CHECKSUM"
    checksum_url="${url%/*}/${checksum_name}"
    checksum_file="${IMAGES_DIR}/${checksum_name}"
    download_file "${checksum_url}" "${checksum_file}"
    verify_signed_checksum "${checksum_file}"

    expected="$(grep -E "^SHA256 \(${filename}\) = [0-9a-f]{64}$" "${checksum_file}" | grep -oE '[0-9a-f]{64}$')" ||
        die "${checksum_name} has no SHA256 entry for ${filename}"
    [[ "${expected}" == "${sha}" ]] ||
        die "releases.json (${sha}) and ${checksum_name} (${expected}) disagree about ${filename}"
    log "hashing ${filename}"
    actual="$(sha256sum "${dest}" | cut -d' ' -f1)"
    [[ "${actual}" == "${expected}" ]] ||
        die "SHA-256 MISMATCH for ${filename}: expected ${expected}, got ${actual}"
    log "verified ${filename} against the signed CHECKSUM and releases.json"
}

cmd_fetch() {
    local key="${1:?usage: vmtest fetch <base-key>}" line filename sha label variant url found=0
    load_lab
    base_facts "${key}"
    probe_upstream
    while read -r line; do
        found=1
        # VMTEST-FRESHNESS-ARTEFACT <base> <filename> <sha256> label=<l> variant=<v> url=<u>
        read -r _ _ filename sha label variant url <<<"${line}"
        fetch_artefact "${filename}" "${sha}" "${label#label=}" "${variant#variant=}" "${url#url=}"
    done < <(grep -E "^VMTEST-FRESHNESS-ARTEFACT ${BASE_NAME} " "${PROBE_FILE}")
    [[ "${found}" -eq 1 ]] || die "the probe listed no artefact for ${BASE_NAME}"
}

# ── build-base ────────────────────────────────────────────────────────────────────────────

free_port() {
    python3 -c 'import socket; s = socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1])'
}

# IdentitiesOnly: without it ssh offers every key in the user's agent before the lab
# key, and sshd's MaxAuthTries locks the session out with "Too many authentication
# failures" — measured on the first build.
guest_ssh() {
    ssh -o BatchMode=yes -o IdentitiesOnly=yes -o StrictHostKeyChecking=no \
        -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=5 \
        -i "${SSH_KEY}" -p "${GUEST_PORT}" "${CLOUD_USER}@127.0.0.1" "$@"
}

guest_scp() {
    scp -o BatchMode=yes -o IdentitiesOnly=yes -o StrictHostKeyChecking=no \
        -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR \
        -i "${SSH_KEY}" -P "${GUEST_PORT}" "$@"
}

wait_for_ssh() {
    local waited=0
    log "waiting for SSH on 127.0.0.1:${GUEST_PORT} (up to ${SSH_WAIT_SECONDS}s)"
    while ! guest_ssh true 2>/dev/null; do
        sleep 5
        waited=$((waited + 5))
        if [[ "${waited}" -ge "${SSH_WAIT_SECONDS}" ]]; then
            die "guest did not answer SSH within ${SSH_WAIT_SECONDS}s; see ${BUILD_DIR}/console.log"
        fi
    done
    log "guest answered SSH after ~${waited}s"
}

wait_for_shutoff() {
    local waited=0 state
    while state="$(virsh -c "${LIBVIRT_URI}" domstate "${DOMAIN}")" && [[ "${state}" != "shut off" ]]; do
        sleep 5
        waited=$((waited + 5))
        if [[ "${waited}" -ge "${SHUTDOWN_WAIT_SECONDS}" ]]; then
            die "guest did not shut off within ${SHUTDOWN_WAIT_SECONDS}s (state: ${state})"
        fi
    done
}

# Teardown is armed for EXIT and the signals, so a failed build never leaves a domain
# running. The build directory is kept on failure for diagnosis and removed on success.
DOMAIN=""
BUILD_DIR=""
BUILD_OK=0
teardown_build() {
    local rc=$?
    trap - EXIT INT TERM HUP
    console_follow_stop
    if [[ -n "${DOMAIN}" ]] && virsh -c "${LIBVIRT_URI}" dominfo "${DOMAIN}" >/dev/null 2>&1; then
        if [[ "$(virsh -c "${LIBVIRT_URI}" domstate "${DOMAIN}")" != "shut off" ]]; then
            virsh -c "${LIBVIRT_URI}" destroy "${DOMAIN}" >&2 || log "could not destroy ${DOMAIN}"
        fi
        virsh -c "${LIBVIRT_URI}" undefine --nvram "${DOMAIN}" >&2 || log "could not undefine ${DOMAIN}"
    fi
    if [[ "${BUILD_OK}" -eq 1 && -n "${BUILD_DIR}" ]]; then
        rm -rf "${BUILD_DIR}"
    elif [[ -n "${BUILD_DIR}" ]]; then
        log "build directory kept for diagnosis: ${BUILD_DIR}"
    fi
    rm -f "${PROBE_FILE:-}"
    exit "${rc}"
}

# guest_repo_fact <field> — one field of `dnf repoinfo updates` from inside the guest.
guest_repo_fact() {
    local field="${1:?}"
    printf '%s\n' "${GUEST_REPOINFO}" | grep -E "^\s*${field}\s*:" | sed -E 's/^[^:]*:\s*//' | grep -m1 . ||
        die "guest repoinfo has no ${field} line"
}

# build_seed_fast <image> <disk> — a fast base: seed the build disk from the published Cloud
# image and boot it with the lab key injected through cloud-init (then cloud-init disabled).
build_seed_fast() {
    local image="${1:?}" disk="${2:?}"
    log "seeding build disk from ${image}"
    cp --reflink=auto "${IMAGES_DIR}/${image}" "${disk}"
    qemu-img resize -q "${disk}" "${BUILD_DISK_SIZE}"
    log "booting ${DOMAIN} (${BASE_VCPUS} vCPU, ${BASE_RAM_MIB} MiB, SSH forwarded to 127.0.0.1:${GUEST_PORT})"
    virt-install --connect "${LIBVIRT_URI}" --name "${DOMAIN}" \
        --memory "${BASE_RAM_MIB}" --vcpus "${BASE_VCPUS}" --cpu host-passthrough \
        --import --disk "path=${disk},format=qcow2,bus=virtio,discard=unmap" \
        --osinfo fedora-unknown --boot uefi --memballoon virtio \
        --network "type=user,backend.type=passt,portForward0.proto=tcp,portForward0.range0.start=${GUEST_PORT},portForward0.range0.to=22" \
        --cloud-init "clouduser-ssh-key=${SSH_KEY}.pub,disable=on" \
        --graphics none --serial "file,path=${BUILD_DIR}/console.log" --noautoconsole >&2
}

# ── the serial console of a desktop guest (§5.3a) ─────────────────────────────────────────
# A desktop guest's root is LUKS-wrapped and every boot stops at the passphrase prompt. Its
# serial port is therefore a unix socket the host can WRITE to, driven by
# helpers.vmtest.serial_console: one instance answers the prompt and reports userspace, a
# second follows the rest of the boot into console.log. A server guest keeps the plain file.
CONSOLE_FOLLOWER_PID=""

# serial_spec <dir> — the virt-install --serial argument for this profile.
serial_spec() {
    local dir="${1:?}"
    if [[ "${BASE_PROFILE}" == "desktop" ]]; then
        printf 'unix,path=%s/serial.sock,mode=bind\n' "${dir}"
    else
        printf 'file,path=%s/console.log\n' "${dir}"
    fi
}

# console_follow <dir> — log the serial socket into console.log until the port closes.
console_follow() {
    local dir="${1:?}"
    helper serial_console --socket "${dir}/serial.sock" --log "${dir}/console.log" \
        --until 'VMTEST-NEVER-MATCHES' --follow --timeout 86400 --connect-wait 120 >"${dir}/console-follow.out" 2>&1 &
    CONSOLE_FOLLOWER_PID=$!
}

console_follow_stop() {
    local rc=0
    if [[ -n "${CONSOLE_FOLLOWER_PID}" ]] && [[ -d "/proc/${CONSOLE_FOLLOWER_PID}" ]]; then
        kill "${CONSOLE_FOLLOWER_PID}"
        # 143 = ended by the SIGTERM just sent, which is the expected way a follower stops.
        wait "${CONSOLE_FOLLOWER_PID}" || rc=$?
        if [[ "${rc}" -ne 0 && "${rc}" -ne 143 ]]; then
            log "console follower exited ${rc}"
        fi
    fi
    CONSOLE_FOLLOWER_PID=""
}

# console_unlock <dir> <passphrase-file> — answer the LUKS prompt on this boot and wait for
# a login prompt; a stall is named (stage: boot) with the console excerpt, never a timeout.
console_unlock() {
    local dir="${1:?}" passphrase_file="${2:?}" out rc=0
    out="$(helper serial_console --socket "${dir}/serial.sock" --log "${dir}/console.log" \
        --unlock-with "${passphrase_file}" --until 'login: ' --timeout "${SSH_WAIT_SECONDS}" --connect-wait 60)" || rc=$?
    printf '%s\n' "${out}" | grep -E '^VMTEST-CONSOLE ' >&2
    [[ "${rc}" -eq 0 ]] || die "the guest did not reach userspace (stage: boot): $(printf '%s\n' "${out}" | grep -oE 'reason=.*')"
    console_follow "${dir}"
}

# desktop_artefact <prefix> — the probe's artefact filename for this base starting with <prefix>.
desktop_artefact() {
    local prefix="${1:?}" filename
    filename="$(grep -E "^VMTEST-FRESHNESS-ARTEFACT ${BASE_NAME} ${prefix}" "${PROBE_FILE}" | awk '{print $3}')"
    [[ -n "${filename}" ]] || die "the probe listed no ${prefix}* artefact for ${BASE_NAME}"
    printf '%s\n' "${filename}"
}

# build_install_full <artefact> <disk> — a full base: Anaconda from the ONE named install
# tree, driven by the deployed VM kickstart with the lab key rendered in, on the serial
# console, powering off when done; then the installed system is booted for the upgrade.
# A server base installs packages from the tree; a desktop base deploys the Workstation
# Live filesystem via liveimg from the Live ISO attached as a second CD-ROM (§5.3), under
# a LUKS wrapper whose throwaway passphrase is generated here and kept beside the base.
build_install_full() {
    local artefact="${1:?}" disk="${2:?}" tree_url ks="${BUILD_DIR}/ks.cfg" state iso
    local -a extra_disks=() render_args=()
    tree_url="$(grep -E "^VMTEST-FRESHNESS-TREE-URL ${BASE_TREE} " "${PROBE_FILE}" | awk '{print $3}')"
    [[ "${tree_url}" == https://* ]] || die "the probe printed no URL for tree ${BASE_TREE}"
    render_args=(--set "SSH_PUBKEY=$(cat "${SSH_KEY}.pub")" --set "FEDORA_VERSION=${VMTEST_FEDORA_VERSION}")
    if [[ "${BASE_PROFILE}" == "desktop" ]]; then
        iso="$(desktop_artefact Fedora-Everything-netinst-)"
        local live
        live="$(desktop_artefact Fedora-Workstation-Live-)"
        extra_disks=(--disk "path=${IMAGES_DIR}/${live},device=cdrom,readonly=on")
        # The LUKS passphrase and the user's password are throwaways: generated here,
        # never tracked, the passphrase kept 0600 beside the base for every later boot.
        # Both reach the renderer on stdin, never in argv (SecurityRules: no secrets in argv).
        (umask 077 && head -c 24 /dev/urandom | base64 | tr -d '\n' >"${BUILD_DIR}/luks-passphrase" && printf '\n' >>"${BUILD_DIR}/luks-passphrase")
        {
            printf 'LUKS_PASSPHRASE=%s\n' "$(head -n1 "${BUILD_DIR}/luks-passphrase")"
            printf 'USER_PASSWORD_CRYPT=%s\n' "$(head -c 24 /dev/urandom | base64 | openssl passwd -6 -stdin)"
        } | helper render_kickstart --template "$(kickstart_for "${BASE_PROFILE}")" "${render_args[@]}" --set-stdin >"${ks}"
    else
        iso="${artefact}"
        render_args+=(--set "TREE_URL=${tree_url}")
        helper render_kickstart --template "$(kickstart_for "${BASE_PROFILE}")" "${render_args[@]}" >"${ks}"
    fi
    chmod 0600 "${ks}"
    qemu-img create -q -f qcow2 "${disk}" "${BUILD_DISK_SIZE}"
    # Name the installer's stage-2 medium explicitly. Without inst.stage2 the installer's
    # dracut scans every attached medium for a squashfs, and with the Live ISO attached
    # it found the Workstation LiveOS first and booted a live session instead of Anaconda
    # (the first desktop build). The netinst's volume label pins it.
    local stage2_label
    stage2_label="$(blkid -o value -s LABEL "${IMAGES_DIR}/${iso}")"
    [[ -n "${stage2_label}" ]] || die "could not read the volume label of ${iso}"
    log "installing from ${tree_url} via ${iso} (Anaconda, cmdline mode on the serial console; up to ${INSTALL_WAIT_MINUTES} min)"
    if [[ "${BASE_PROFILE}" == "desktop" ]]; then
        console_follow "${BUILD_DIR}"
    fi
    virt-install --connect "${LIBVIRT_URI}" --name "${DOMAIN}" \
        --memory "${BASE_RAM_MIB}" --vcpus "${BASE_VCPUS}" --cpu host-passthrough \
        --disk "path=${disk},format=qcow2,bus=virtio,discard=unmap" "${extra_disks[@]+"${extra_disks[@]}"}" \
        --location "${IMAGES_DIR}/${iso}" --initrd-inject "${ks}" \
        --extra-args "inst.ks=file:/ks.cfg inst.stage2=hd:LABEL=${stage2_label} console=ttyS0,115200n8 plymouth.enable=0" \
        --osinfo fedora-unknown --memballoon virtio \
        --boot "uefi,firmware.feature0.name=secure-boot,firmware.feature0.enabled=no" \
        --network "type=user,backend.type=passt,portForward0.proto=tcp,portForward0.range0.start=${GUEST_PORT},portForward0.range0.to=22" \
        --graphics none --serial "$(serial_spec "${BUILD_DIR}")" \
        --noautoconsole --noreboot --wait "${INSTALL_WAIT_MINUTES}" >&2
    console_follow_stop
    state="$(virsh -c "${LIBVIRT_URI}" domstate "${DOMAIN}")"
    [[ "${state}" == "shut off" ]] ||
        die "the installer did not power off within ${INSTALL_WAIT_MINUTES} min (state: ${state}); see ${BUILD_DIR}/console.log"
    grep -qE 'Installation complete|Running post-installation scripts' "${BUILD_DIR}/console.log" ||
        die "the installer powered off without reporting completion; see ${BUILD_DIR}/console.log"
    # The rendered kickstart carried the passphrase; it has done its job.
    rm -f "${ks}"
    log "install complete; booting the installed system"
    virsh -c "${LIBVIRT_URI}" start "${DOMAIN}" >&2
    if [[ "${BASE_PROFILE}" == "desktop" ]]; then
        console_unlock "${BUILD_DIR}" "${BUILD_DIR}/luks-passphrase"
    fi
}

cmd_build_base() {
    local key="${1:?usage: vmtest build-base <base-key>}"
    load_lab
    base_facts "${key}"
    case "${BASE_KIND}" in
        fast | full) ;;
        *) die "unknown base kind ${BASE_KIND} for ${BASE_NAME}" ;;
    esac
    [[ "${BASE_KIND}" == "full" || "${BASE_PROFILE}" == "server" ]] || die "a ${BASE_PROFILE} base must be kind full; ${BASE_NAME} is ${BASE_KIND}"
    cmd_fetch "${key}"

    # Every artefact the base is built from is part of its media identity (§4.4): the
    # desktop base has two (netinst + Live ISO), and a record naming only one would
    # differ from the live identity and read as `reinstall` on every run.
    local line filename sha label first=1
    local -a artefact_args=()
    while read -r line; do
        local this_file this_sha this_label
        read -r _ _ this_file this_sha this_label _ <<<"${line}"
        artefact_args+=(--artefact "${this_file}=${this_sha}")
        if [[ "${first}" -eq 1 ]]; then
            filename="${this_file}"
            sha="${this_sha}"
            label="${this_label#label=}"
            first=0
        fi
    done < <(grep -E "^VMTEST-FRESHNESS-ARTEFACT ${BASE_NAME} " "${PROBE_FILE}")
    [[ "${first}" -eq 0 ]] || die "the probe listed no artefact for ${BASE_NAME}"
    local compose_id probe_revision
    compose_id="$(probe_value VMTEST-FRESHNESS-COMPOSE-ID)"
    probe_revision="$(probe_value VMTEST-FRESHNESS-REVISION)"

    # §10: refuse loudly before a rebuild that would exhaust the disk or the host's RAM.
    local floor_size
    floor_size="$(stat -c %s "${IMAGES_DIR}/${filename}")"
    if [[ -r "${BASES_DIR}/${BASE_NAME}/base.qcow2" ]]; then
        floor_size="$(stat -c %s "${BASES_DIR}/${BASE_NAME}/base.qcow2")"
    fi
    helper retention floor --path "${BASES_DIR}" --base-size "${floor_size}" --step rebuild --guest-mib "${BASE_RAM_MIB}" >&2 ||
        die "the host cannot carry a rebuild of ${BASE_NAME} (stage: base); see the VMTEST-DISK/VMTEST-RAM lines above"

    DOMAIN="vmtest-build-${BASE_NAME}"
    BUILD_DIR="${BASES_DIR}/${BASE_NAME}.build"
    trap teardown_build EXIT INT TERM HUP
    if virsh -c "${LIBVIRT_URI}" dominfo "${DOMAIN}" >/dev/null 2>&1; then
        die "a domain named ${DOMAIN} already exists; a previous build did not clean up. Inspect it, then: virsh -c ${LIBVIRT_URI} undefine --nvram ${DOMAIN}"
    fi
    rm -rf "${BUILD_DIR}"
    mkdir -p "${BUILD_DIR}"
    local disk="${BUILD_DIR}/disk.qcow2"
    GUEST_PORT="$(free_port)"
    local installed_at
    installed_at="$(date +%s)"
    if [[ "${BASE_KIND}" == "fast" ]]; then
        build_seed_fast "${filename}" "${disk}"
    else
        build_install_full "${filename}" "${disk}"
    fi

    wait_for_ssh
    log "upgrading packages in the guest"
    guest_ssh sudo dnf -y --refresh upgrade >&2
    GUEST_REPOINFO="$(guest_ssh sudo dnf --quiet repoinfo updates)"
    local guest_revision guest_mirror
    guest_revision="$(guest_repo_fact Revision)"
    guest_mirror="$(guest_repo_fact 'Base URL' | awk '{print $1}')"
    log "guest saw updates revision ${guest_revision} from ${guest_mirror} (probe read ${probe_revision})"

    if [[ "${BASE_PROFILE}" == "desktop" ]]; then
        # The session runner is part of the base: gnome-session launches it through the
        # autostart entry the kickstart wrote, and it waits for the host's run.env.
        log "installing the session runner in the guest"
        guest_scp "${SESSION_RUNNER}" "${CLOUD_USER}@127.0.0.1:/tmp/vmtest-session-provision.bash"
        guest_ssh sudo install -o root -g root -m 0755 /tmp/vmtest-session-provision.bash /usr/local/bin/vmtest-session-provision.bash
        guest_ssh rm -f /tmp/vmtest-session-provision.bash
    fi

    log "cleaning the guest before snapshot"
    guest_scp "${GUEST_CLEANUP}" "${CLOUD_USER}@127.0.0.1:/tmp/guest-cleanup.bash"
    guest_ssh sudo bash /tmp/guest-cleanup.bash | grep -q '^VMTEST-GUEST-CLEANUP-DONE$' ||
        die "guest cleanup did not complete"
    # Schedule the poweroff so the SSH session ends cleanly rather than being severed.
    guest_ssh sudo systemd-run --quiet --on-active=2 systemctl poweroff
    wait_for_shutoff
    console_follow_stop
    virsh -c "${LIBVIRT_URI}" undefine --nvram "${DOMAIN}" >&2
    DOMAIN=""

    local base_dir="${BASES_DIR}/${BASE_NAME}" base_disk base_sha base_size base_mtime last_upgraded_at refresh_state recipe_digest
    base_disk="${base_dir}/base.qcow2"
    mkdir -p "${base_dir}"
    mv -f "${disk}" "${base_disk}"
    if [[ -f "${BUILD_DIR}/luks-passphrase" ]]; then
        mv -f "${BUILD_DIR}/luks-passphrase" "${base_dir}/luks-passphrase"
    fi
    log "hashing the flattened base"
    base_sha="$(sha256sum "${base_disk}" | cut -d' ' -f1)"
    base_size="$(stat -c %s "${base_disk}")"
    base_mtime="$(stat -c %Y "${base_disk}")"
    last_upgraded_at="$(date +%s)"
    # §4.4a: complete only if the guest's mirror had caught up with the canonical host.
    if [[ "${guest_revision}" -ge "${probe_revision}" ]]; then
        refresh_state="complete"
    else
        refresh_state="incomplete"
    fi
    recipe_digest="$(recipe_digest_now "${BASE_KIND}" "${BASE_PROFILE}")"
    # A full base's media identity includes the install tree's checksums (§4.4); the
    # record reads them from the same probe the install was verified against.
    local -a tree_args=()
    if [[ "${BASE_KIND}" == "full" ]]; then
        tree_args=(--treeinfo-probe "${PROBE_FILE}" --tree "${BASE_TREE}")
    fi

    helper write_base_record \
        --fedora-version "${VMTEST_FEDORA_VERSION}" --profile "${BASE_PROFILE}" --kind "${BASE_KIND}" \
        --name "${BASE_NAME}" --compose-id "${compose_id}" --compose-label "${label}" \
        "${artefact_args[@]}" --recipe-digest "${recipe_digest}" "${tree_args[@]+"${tree_args[@]}"}" \
        --installed-at "${installed_at}" --last-upgraded-at "${last_upgraded_at}" \
        --last-upgraded-revision "${guest_revision}" --last-upgraded-mirror "${guest_mirror}" \
        --refresh-state "${refresh_state}" --base-sha256 "${base_sha}" \
        --base-size "${base_size}" --base-mtime "${base_mtime}" >"${base_dir}/base.json.new"
    mv -f "${base_dir}/base.json.new" "${base_dir}/base.json"
    chmod 0444 "${base_disk}"
    BUILD_OK=1
    log "base ${BASE_NAME} built: ${base_disk} (${base_size} bytes, refresh ${refresh_state})"
    printf 'VMTEST-BASE-BUILT %s %s refresh_state=%s\n' "${BASE_NAME}" "${base_disk}" "${refresh_state}"
}

# ── run ───────────────────────────────────────────────────────────────────────────────────

# record_field <marker-line> <field> — one key=value from a marker line.
record_field() {
    local line="${1:?}" key="${2:?}" field
    for field in ${line}; do
        if [[ "${field}" == "${key}="* ]]; then
            printf '%s\n' "${field#"${key}"=}"
            return 0
        fi
    done
    die "marker has no ${key}: ${line}"
}

# verdict_field <verdict-line> <field> — one tab-separated key=value from the gate's marker.
verdict_field() {
    local line="${1:?}" key="${2:?}" field
    line="${line#VMTEST-FRESHNESS-VERDICT }"
    while IFS= read -r -d $'\t' field || [[ -n "${field}" ]]; do
        if [[ "${field}" == "${key}="* ]]; then
            printf '%s\n' "${field#"${key}"=}"
            return 0
        fi
    done <<<"${line}"$'\t'
    die "freshness verdict has no ${key}: ${line}"
}

# freshness_verdict <base.json> <base.qcow2> — the §4.4 verdict for one base, from the
# probe already in PROBE_FILE, as GATE_* variables: DECISION, DEGRADED, DIVERGENCES, RC,
# LINE (the verdict marker) and BASE_SIZE. Dies only when the record or the disk cannot be
# read as ONE base; a refusing verdict is data (GATE_RC != 0), so a caller that only
# reports — freshness-status — can carry on to the next base.
freshness_verdict() {
    local base_json="${1:?}" base_disk="${2:?}" depth="${3:-quick}" record actual_mtime actual_sha gate gate_rc=0
    # The record-only pass needs no recipe digest of its own; the kind it reports selects one.
    record="$(helper freshness_gate --fedora-version "${VMTEST_FEDORA_VERSION}" --manifest "${MANIFEST}" \
        --base-json "${base_json}" --probe "${PROBE_FILE}" --recipe-digest "$(recipe_digest_now fast server)" \
        --actual-base-sha256 "$(printf '%064d' 0)" --record-only)" ||
        die "could not read ${base_json}"
    [[ "${record}" == VMTEST-BASE-RECORD* ]] || die "unexpected gate output: ${record}"
    local kind profile
    kind="$(record_field "${record}" kind)"
    profile="$(record_field "${record}" profile)"
    # §7: size and mtime on every run (a run must not pay to hash a base); the full
    # sha256 only when asked for (`freshness-status --deep`, which the nightly timer is).
    # A quick pass hands the gate the record's own hash, so its hash comparison can only
    # fail on a deep pass — the quick pass's integrity claim is size+mtime, nothing more.
    GATE_BASE_SIZE="$(stat -c %s "${base_disk}")"
    actual_mtime="$(stat -c %Y "${base_disk}")"
    if [[ "${GATE_BASE_SIZE}" == "$(record_field "${record}" base_size)" && "${actual_mtime}" == "$(record_field "${record}" base_mtime)" ]]; then
        actual_sha="$(record_field "${record}" base_sha256)"
    else
        die "base.qcow2 for $(record_field "${record}" name) differs from its record (size/mtime); refusing a base of unknown provenance"
    fi
    if [[ "${depth}" == "deep" ]]; then
        log "hashing ${base_disk} (deep check; this reads the whole base)"
        actual_sha="$(sha256sum "${base_disk}" | cut -d' ' -f1)"
    fi
    GATE_INTEGRITY="${depth}"
    gate="$(helper freshness_gate --fedora-version "${VMTEST_FEDORA_VERSION}" --manifest "${MANIFEST}" \
        --base-json "${base_json}" --probe "${PROBE_FILE}" --recipe-digest "$(recipe_digest_now "${kind}" "${profile}")" \
        --actual-base-sha256 "${actual_sha}" | grep '^VMTEST-FRESHNESS-VERDICT ')" || gate_rc=$?
    [[ "${gate}" == VMTEST-FRESHNESS-VERDICT* ]] || die "the freshness gate printed no verdict (exit ${gate_rc})"
    GATE_LINE="${gate}"
    GATE_RC="${gate_rc}"
    GATE_DECISION="$(verdict_field "${gate}" decision)"
    GATE_DEGRADED="$(verdict_field "${gate}" degraded)"
    GATE_DIVERGENCES="$(verdict_field "${gate}" divergences)"
}

# resolve_commit [sha] — the commit to provision from: the one given, or the branch tip
# on the REMOTE. Never a local checkout (§3.4).
resolve_commit() {
    local given="${1:-}" tip
    if [[ -n "${given}" ]]; then
        [[ "${given}" =~ ^[0-9a-f]{40}$ ]] || die "--commit must be a 40-hex commit, got ${given}"
        printf '%s\n' "${given}"
        return 0
    fi
    tip="$(git ls-remote "${VMTEST_REPO_URL}" "refs/heads/${VMTEST_REPO_BRANCH}" | awk '{print $1}')"
    [[ "${tip}" =~ ^[0-9a-f]{40}$ ]] || die "could not read the tip of ${VMTEST_REPO_BRANCH} from ${VMTEST_REPO_URL}"
    printf '%s\n' "${tip}"
}

# raw_url <commit> <path> — the raw-file URL for a path at a commit of the public repo.
raw_url() {
    local commit="${1:?}" path="${2:?}" repo="${VMTEST_REPO_URL%.git}"
    repo="${repo#https://github.com/}"
    printf 'https://raw.githubusercontent.com/%s/%s/%s\n' "${repo}" "${commit}" "${path}"
}

# scenario_divergences — every known difference between this run and a real install of
# its profile (§6.6 rule 09), comma-separated for judge_run.
scenario_divergences() {
    local list="throwaway-vault-password,lab-ssh-key-baked"
    if [[ "${BASE_PROFILE}" == "desktop" ]]; then
        list="${list},luks-unlock-automated,plymouth-disabled,gdm-autologin-enabled-by-harness,session-runner-autostart"
    fi
    printf '%s\n' "${list}"
}

# session_provision <commit> <run_env_words> <transcript> — run run.bash INSIDE the desktop
# guest's autologin session (§5.3 item 3): hand the session runner its run.env over SSH,
# wait for it to report run.bash's exit, then pull the run log into the transcript. Returns
# run.bash's exit status; dies only when the guest cannot be driven at all.
session_provision() {
    local commit="${1:?}" run_env_words="${2-}" transcript="${3:?}" waited=0 run_rc word
    local -a env_lines=(
        "RUN_BASH_HEADLESS=1"
        "RUN_BASH_USER_EMAIL=${GUEST_USER_EMAIL}"
        "RUN_BASH_GITHUB_ACCOUNTS=none"
        "RUN_BASH_VAULT_PASSWORD_FILE=/home/${CLOUD_USER}/.vmtest/throwaway-pw"
        "RUN_BASH_GIT_REF=${commit}"
        "RUN_BASH_PROVISIONING_PROFILE=${BASE_PROFILE}"
        "TERM=dumb"
    )
    # run_env_assignments renders " KEY='value'" words; the runner sources plain KEY=value lines.
    for word in ${run_env_words}; do
        env_lines+=("$(printf '%s' "${word}" | tr -d "'")")
    done
    log "handing the run to the session runner (waits for ${GUEST_RUN_STATE}/run.exit, up to ${PROVISION_TIMEOUT_SECONDS}s)"
    printf '%s\n' "${env_lines[@]}" | guest_ssh "umask 077 && cat >${GUEST_RUN_STATE}/run.env.tmp && mv -f ${GUEST_RUN_STATE}/run.env.tmp ${GUEST_RUN_STATE}/run.env"
    while ! guest_ssh "test -r ${GUEST_RUN_STATE}/run.exit" 2>/dev/null; do
        sleep 15
        waited=$((waited + 15))
        if [[ "${waited}" -ge "${PROVISION_TIMEOUT_SECONDS}" ]]; then
            guest_ssh "cat ${GUEST_RUN_STATE}/run.log" >>"${transcript}" 2>&1 || log "could not read the run log from the guest"
            printf 'ERROR: the session runner did not finish run.bash within %ss\n' "${PROVISION_TIMEOUT_SECONDS}" | tee -a "${transcript}" >&2
            return 124
        fi
        if ((waited % 300 == 0)); then
            log "still provisioning in the session after ${waited}s"
        fi
    done
    guest_ssh "cat ${GUEST_RUN_STATE}/run.log" | tee -a "${transcript}" >&2
    run_rc="$(guest_ssh "cat ${GUEST_RUN_STATE}/run.exit")"
    [[ "${run_rc}" =~ ^[0-9]+$ ]] || die "the session runner wrote a malformed run.exit: ${run_rc}"
    return "${run_rc}"
}

# desktop_reboot_into_session <base-dir> <transcript> — the reboot a real user does when
# run.bash finishes: reboot the guest, answer the LUKS prompt again, wait for SSH and then
# for the autologin session to be back on seat0, so the checks judge the session GNOME
# starts AFTER provisioning. Recorded in the transcript as a harness step.
desktop_reboot_into_session() {
    local base_dir="${1:?}" transcript="${2:?}" waited=0
    printf '# harness: rebooting the guest after run.bash, as run.bash asks; checks run in the new session\n' | tee -a "${transcript}" >&2
    guest_ssh sudo systemd-run --quiet --on-active=2 systemctl reboot
    sleep 10
    console_follow_stop
    console_unlock "${RUN_DIR}" "${base_dir}/luks-passphrase"
    wait_for_ssh
    log "waiting for the autologin session on seat0 (up to 180s)"
    while ! guest_ssh "loginctl list-sessions --no-legend" 2>&1 | grep -qE "^\s*[0-9]+\s+[0-9]+\s+${CLOUD_USER}\s+seat0"; do
        sleep 5
        waited=$((waited + 5))
        [[ "${waited}" -lt 180 ]] || die "no autologin session on seat0 within 180s after the reboot (stage: boot)"
    done
    # gnome-shell needs a moment after the session appears before its D-Bus interface answers.
    sleep 15
}

# server_reboot <transcript> — the same trip through a reboot for a guest with no session
# to come back to and no LUKS prompt to answer: reboot, wait for SSH.
#
# The boot id is read before and after and REQUIRED to change. Waiting for SSH proves only
# that SSH answers, which it also does when the reboot never happened — the request was
# swallowed, the guest came back before the wait started, or `sleep 10` was not long enough
# for it to go down. Every check after this one assumes a new boot, and a checker run on
# the same boot fails in ways that read as defects in the code under test.
server_reboot() {
    local transcript="${1:?}" before after waited=0
    before="$(guest_ssh cat /proc/sys/kernel/random/boot_id)"
    printf '# harness: rebooting the guest; the checks judge the boot AFTER this one\n' | tee -a "${transcript}" >&2
    guest_ssh sudo systemd-run --quiet --on-active=2 systemctl reboot
    sleep 10
    wait_for_ssh
    # SSH can answer from the OLD boot if the guest was slow to go down, so the identity is
    # polled rather than read once.
    while true; do
        after="$(guest_ssh cat /proc/sys/kernel/random/boot_id)"
        [[ "${after}" == "${before}" ]] || break
        sleep 5
        waited=$((waited + 5))
        [[ "${waited}" -lt 180 ]] ||
            die "the guest still reports boot id ${before} 180s after the reboot request; it never rebooted (stage: boot)"
    done
    printf '# harness: boot id %s -> %s\n' "${before}" "${after}" | tee -a "${transcript}" >&2
}

# reboot_guest <base-dir> <transcript> — bring the guest through a reboot and back, by
# the mechanics its profile needs.
#
# WHETHER to reboot is the scenario's answer (`reboot_before_checks`); this is only HOW.
# A desktop reboots because GNOME loads extensions at session start, a server because
# its scenario changed something only a boot picks up — different reasons, one trip, and
# the profile knows nothing about either. An unknown profile is a refusal: silently not
# rebooting would judge the wrong boot and look exactly like judging the right one.
reboot_guest() {
    local base_dir="${1:?}" transcript="${2:?}"
    case "${BASE_PROFILE}" in
        desktop) desktop_reboot_into_session "${base_dir}" "${transcript}" ;;
        server) server_reboot "${transcript}" ;;
        *) die "no reboot mechanics for profile ${BASE_PROFILE} (stage: boot)" ;;
    esac
}

# guest_prepare <scenario-id> <commit> <transcript> — the scenario's own fixture, run in
# the guest between run.bash and the reboot.
#
# Per-scenario only, with no profile fallback: a fixture is by definition particular to
# one scenario, and a scenario with nothing to set up ships no script. Its absence is
# therefore not an error here — and not a silent one either, because a checker that
# needs a fixture reads the record it leaves and fails loudly when there is none.
#
# It declares no checks. The transcript's accounting allows exactly one planned count,
# so the fixture records what it saw and the checker turns that into checks after the
# reboot. A non-zero exit aborts the run: a half-applied fixture leaves the checker
# judging a guest nobody set up, and its failures would read as defects in the code.
guest_prepare() {
    local scenario_id="${1:?}" commit="${2:?}" transcript="${3:?}" script rc=0
    script="${VMTEST_HOME}/guest-prepare-${scenario_id}.bash"
    if [[ ! -r "${script}" ]]; then
        # SAID OUT LOUD. Most scenarios have no fixture and that is not an error — but a
        # fixture the lab failed to deploy looks identical from here, and silence would
        # leave a reader of the transcript unable to tell "nothing to set up" from
        # "the set-up never arrived".
        printf '# harness: no guest-prepare-%s.bash under %s; this scenario prepares nothing\n' \
            "${scenario_id}" "${VMTEST_HOME}" | tee -a "${transcript}" >&2
        return 0
    fi
    printf '# harness: running the %s fixture in the guest, before the reboot\n' "${scenario_id}" | tee -a "${transcript}" >&2
    guest_scp "${script}" "${CLOUD_USER}@127.0.0.1:/tmp/guest-prepare.bash"
    timeout "${PREPARE_TIMEOUT_SECONDS}" \
        ssh -o BatchMode=yes -o IdentitiesOnly=yes -o StrictHostKeyChecking=no \
        -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ServerAliveInterval=30 \
        -i "${SSH_KEY}" -p "${GUEST_PORT}" "${CLOUD_USER}@127.0.0.1" \
        "env VMTEST_COMMIT='${commit}' TERM=dumb bash /tmp/guest-prepare.bash" \
        2>&1 | tee -a "${transcript}" >&2 || rc="${PIPESTATUS[0]}"
    [[ "${rc}" -eq 0 ]] ||
        die "the ${scenario_id} fixture exited ${rc} (stage: prepare); nothing after it would be judging the scenario it names"
}

# collect_desktop_evidence <transcript> — §5.4 evidence-only items: the session
# environment the runner inherited (T5.3b, diffed against a transient user unit) and a
# screenshot of the framebuffer, with the boundary stated next to it.
collect_desktop_evidence() {
    # virsh screenshot writes PNG for a VNC-backed display whatever the name says.
    local transcript="${1:?}" shot="${RUN_DIR}/screenshot.png"
    guest_ssh "cat ${GUEST_RUN_STATE}/session.env" >"${RUN_DIR}/session.env" 2>&1 || log "no session.env in the guest"
    guest_ssh "systemd-run --user --pipe --quiet --wait env | sort" >"${RUN_DIR}/transient-unit.env" 2>&1 || log "could not probe the transient-unit environment"
    if [[ -s "${RUN_DIR}/session.env" && -s "${RUN_DIR}/transient-unit.env" ]]; then
        # Variables the real session has and a transient user unit does not (§5.3 item 3).
        printf 'VMTEST-EVIDENCE session_only_vars=%s\n' \
            "$(comm -23 <(cut -d= -f1 "${RUN_DIR}/session.env" | sort) <(cut -d= -f1 "${RUN_DIR}/transient-unit.env" | sort) | tr '\n' ',')" >>"${transcript}"
    fi
    if virsh -c "${LIBVIRT_URI}" screenshot "${DOMAIN}" "${shot}" >&2; then
        printf 'VMTEST-EVIDENCE screenshot=runs/%s/screenshot.png (evidence only: proves the compositor produced a frame, not that the frame is correct)\n' \
            "$(basename "${RUN_DIR}")" >>"${transcript}"
    else
        log "screenshot failed (recorded as absent)"
    fi
}

RUN_DIR=""
RUN_OK=0
teardown_run() {
    local rc=$?
    trap - EXIT INT TERM HUP
    console_follow_stop
    if [[ -n "${DOMAIN}" ]] && virsh -c "${LIBVIRT_URI}" dominfo "${DOMAIN}" >/dev/null 2>&1; then
        if [[ "$(virsh -c "${LIBVIRT_URI}" domstate "${DOMAIN}")" != "shut off" ]]; then
            virsh -c "${LIBVIRT_URI}" destroy "${DOMAIN}" >&2 || log "could not destroy ${DOMAIN}"
        fi
        virsh -c "${LIBVIRT_URI}" undefine --nvram "${DOMAIN}" >&2 || log "could not undefine ${DOMAIN}"
    fi
    if [[ "${RUN_OK}" -eq 1 && -n "${RUN_DIR}" ]]; then
        rm -f "${RUN_DIR}/overlay.qcow2"
    elif [[ -n "${RUN_DIR}" ]]; then
        log "overlay and console kept for diagnosis: ${RUN_DIR}"
    fi
    rm -f "${PROBE_FILE:-}"
    exit "${rc}"
}

cmd_run() {
    local scenario_id="${1:?usage: vmtest run <scenario-id> [--commit SHA]}" commit=""
    local github_account="" github_token_file="" github_ssh_pp_file=""
    shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --commit)
                commit="${2:?--commit needs a value}"
                shift 2
                ;;
            --github-account)
                github_account="${2:?--github-account needs a value}"
                shift 2
                ;;
            --github-token-file)
                github_token_file="${2:?--github-token-file needs a path}"
                shift 2
                ;;
            --github-ssh-passphrase-file)
                github_ssh_pp_file="${2:?--github-ssh-passphrase-file needs a path}"
                shift 2
                ;;
            *) die "unknown option: $1" ;;
        esac
    done
    load_lab
    scenario_facts "${scenario_id}"
    [[ "${SCENARIO_RUNNABLE}" == "true" ]] ||
        die "${scenario_id} is not runnable: its guest script has not declared a planned check count"
    if [[ "${SCENARIO_HOST_ONLY}" == "true" ]]; then
        host_only_preflight "${scenario_id}" "${github_account}" "${github_token_file}" "${github_ssh_pp_file}"
    else
        # A credential option on an ordinary scenario is REFUSED, not ignored. The caller
        # believes they are delivering a secret; dropping it silently would leave them
        # thinking the token path had been exercised when it never was.
        if [[ -n "${github_account}${github_token_file}${github_ssh_pp_file}" ]]; then
            die "the --github-* options apply only to a host_only scenario, and ${scenario_id} is not one"
        fi
        # The deployed allowlist is the authority (§2.3): the manifest alone does not admit a run.
        if [[ ! -r "${ALLOWLIST}" ]] || ! grep -qx "${scenario_id}" "${ALLOWLIST}"; then
            die "${scenario_id} is not in the deployed allowlist ${ALLOWLIST}; re-run play-vm-test-lab.yml on the host"
        fi
    fi
    base_facts "${SCENARIO_BASE_KEY}"
    local base_dir="${BASES_DIR}/${BASE_NAME}" base_disk base_json guest_script
    base_disk="${base_dir}/base.qcow2"
    base_json="${base_dir}/base.json"
    [[ -r "${base_disk}" && -r "${base_json}" ]] ||
        die "base ${BASE_NAME} is absent (stage: base); build it with: vmtest build-base ${SCENARIO_BASE_KEY}"
    # Resolution order, not a fallback-on-error: a scenario whose assertions differ from its
    # profile's ships its own checker, and everything else shares the profile's. Both paths
    # are deterministic and the no-match case is a hard failure, never a silent default —
    # `server-github-token` must never be judged by the server checker, whose
    # `github_accounts: {}` assertion is definitionally false when an identity is configured.
    guest_script="${VMTEST_HOME}/guest-acceptance-${scenario_id}.bash"
    if [[ ! -r "${guest_script}" ]]; then
        guest_script="${VMTEST_HOME}/guest-acceptance-${BASE_PROFILE}.bash"
    fi
    [[ -r "${guest_script}" ]] ||
        die "no checker for ${scenario_id}: neither guest-acceptance-${scenario_id}.bash nor guest-acceptance-${BASE_PROFILE}.bash is readable under ${VMTEST_HOME}; deploy the lab first"
    commit="$(resolve_commit "${commit}")"

    # ── freshness gate (§4.4, T6.1) ────────────────────────────────────────────────────
    probe_upstream
    local decision degraded divergences actual_size
    freshness_verdict "${base_json}" "${base_disk}"
    decision="${GATE_DECISION}"
    degraded="${GATE_DEGRADED}"
    divergences="${GATE_DIVERGENCES}"
    actual_size="${GATE_BASE_SIZE}"
    log "freshness: ${decision} (degraded=${degraded})"
    if [[ "${GATE_RC}" -ne 0 ]]; then
        printf '%s\n' "${GATE_LINE}" >&2
        die "base ${BASE_NAME} may not be used (freshness: ${decision}); rebuild it with: vmtest build-base ${SCENARIO_BASE_KEY}"
    fi
    # §10: refuse loudly before an overlay that would exhaust the disk or the host's RAM.
    helper retention floor --path "${RUNS_DIR}" --base-size "${actual_size}" --step run --guest-mib "${BASE_RAM_MIB}" >&2 ||
        die "the host cannot carry a run on ${BASE_NAME} (stage: clone); see the VMTEST-DISK/VMTEST-RAM lines above"

    # ── overlay and boot ───────────────────────────────────────────────────────────────
    local run_id started_at
    run_id="$(date -u +%Y%m%dT%H%M%SZ)-${scenario_id}"
    RUN_DIR="${RUNS_DIR}/${run_id}"
    mkdir -p "${RUN_DIR}"
    DOMAIN="vmtest-run-${run_id}"
    trap teardown_run EXIT INT TERM HUP
    qemu-img create -q -f qcow2 -F qcow2 -b "${base_disk}" "${RUN_DIR}/overlay.qcow2"
    GUEST_PORT="$(free_port)"
    started_at="$(date +%s)"
    log "run ${run_id}: booting ${DOMAIN} on ${BASE_NAME} (SSH forwarded to 127.0.0.1:${GUEST_PORT})"
    # A desktop guest needs a display for GNOME (VNC, local only, also what `virsh
    # screenshot` reads) and a writable serial port for the LUKS unlock; a server guest
    # needs neither.
    local -a display_args=(--graphics none)
    if [[ "${BASE_PROFILE}" == "desktop" ]]; then
        display_args=(--graphics "vnc,listen=127.0.0.1" --video virtio)
    fi
    virt-install --connect "${LIBVIRT_URI}" --name "${DOMAIN}" \
        --memory "${BASE_RAM_MIB}" --vcpus "${BASE_VCPUS}" --cpu host-passthrough \
        --import --disk "path=${RUN_DIR}/overlay.qcow2,format=qcow2,bus=virtio,discard=unmap,cache=unsafe" \
        --osinfo fedora-unknown --boot uefi --memballoon virtio \
        --network "type=user,backend.type=passt,portForward0.proto=tcp,portForward0.range0.start=${GUEST_PORT},portForward0.range0.to=22" \
        "${display_args[@]}" --serial "$(serial_spec "${RUN_DIR}")" --noautoconsole >&2
    if [[ "${BASE_PROFILE}" == "desktop" ]]; then
        [[ -r "${base_dir}/luks-passphrase" ]] || die "no luks-passphrase beside ${BASE_NAME}; rebuild it (stage: boot)"
        console_unlock "${RUN_DIR}" "${base_dir}/luks-passphrase"
    fi
    wait_for_ssh

    # ── provision at the pinned commit ─────────────────────────────────────────────────
    local transcript="${RUN_DIR}/transcript.log" run_rc=0 raw
    {
        printf '# vmtest run %s\n# scenario %s on base %s (%s, %s) freshness=%s commit=%s\n' \
            "${run_id}" "${scenario_id}" "${BASE_NAME}" "${BASE_KIND}" "${BASE_PROFILE}" "${decision}" "${commit}"
    } >"${transcript}"
    raw="$(raw_url "${commit}" run.bash)"
    log "fetching run.bash at ${commit:0:12} into the guest"
    guest_ssh "curl -fsSL -o ~/run.bash '${raw}' && chmod 0755 ~/run.bash"
    # The guest's only secret: a per-run random vault password that decrypts nothing (§10).
    guest_ssh "umask 077 && mkdir -p ~/.vmtest && head -c 32 /dev/urandom | base64 > ~/.vmtest/throwaway-pw"
    # The scenario's run_env overrides come LAST so they win over the defaults
    # (the negative scenarios set an unrecognised profile or a failing play).
    local run_env_words
    run_env_words="$(run_env_assignments)"
    # A host-only scenario replaces the empty-identity defaults with a real one. The secrets
    # travel by scp into guest tmpfs and are named to run.bash by PATH — never as values, so
    # they are absent from the guest's argv and from cloud-init user-data, which the metadata
    # service would serve forever (docs/headless-provisioning.md:128-131).
    local github_env=" RUN_BASH_GITHUB_ACCOUNTS=none"
    if [[ "${SCENARIO_HOST_ONLY}" == "true" ]]; then
        push_guest_secrets "${github_token_file}" "${github_ssh_pp_file}"
        github_env=" RUN_BASH_GITHUB_ACCOUNTS='${github_account}'"
        github_env+=" RUN_BASH_GITHUB_TOKEN_FILE=${GUEST_SECRET_DIR}/gh-token"
        github_env+=" RUN_BASH_GITHUB_SSH_PASSPHRASE_FILE=${GUEST_SECRET_DIR}/ssh-passphrase"
    fi
    log "provisioning (headless run.bash; this is the long part — up to ${PROVISION_TIMEOUT_SECONDS}s)${run_env_words:+; overrides:${run_env_words}}"
    if [[ "${BASE_PROFILE}" == "desktop" ]]; then
        session_provision "${commit}" "${run_env_words}" "${transcript}" || run_rc=$?
    else
        timeout "${PROVISION_TIMEOUT_SECONDS}" ssh -o BatchMode=yes -o IdentitiesOnly=yes -o StrictHostKeyChecking=no \
            -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ServerAliveInterval=30 \
            -i "${SSH_KEY}" -p "${GUEST_PORT}" "${CLOUD_USER}@127.0.0.1" \
            "env RUN_BASH_HEADLESS=1 RUN_BASH_USER_EMAIL='${GUEST_USER_EMAIL}'${github_env} \
                 RUN_BASH_VAULT_PASSWORD_FILE=\$HOME/.vmtest/throwaway-pw RUN_BASH_GIT_REF='${commit}' \
                 RUN_BASH_PROVISIONING_PROFILE='${BASE_PROFILE}'${run_env_words} TERM=dumb bash ~/run.bash" \
            2>&1 | tee -a "${transcript}" >&2 || run_rc="${PIPESTATUS[0]}"
    fi
    printf 'RUN-BASH-EXIT %s\n' "${run_rc}" | tee -a "${transcript}" >&2

    # ── the fixture and the reboot the scenario asked for ──────────────────────────────
    # Declared by the scenario, not inferred from the profile. A desktop is judged after
    # the reboot run.bash itself asks for, because GNOME loads the extensions the run
    # installed at session start and not into the session that installed them (Wayland
    # cannot reload the shell) — the first desktop run showed exactly that, every
    # installed extension unknown to the live shell until a new session. A server
    # scenario reboots for its own reasons, which only it knows: Plan 00109's route has
    # to meet a status document collected under a kernel that is no longer running.
    #
    # The fixture runs first and inside the same `if`: what it sets up is what the boot
    # has to pick up, so a reboot with nothing prepared and a fixture with no reboot are
    # each half a scenario.
    if [[ "${SCENARIO_REBOOT_BEFORE_CHECKS}" == "true" ]]; then
        guest_prepare "${scenario_id}" "${commit}" "${transcript}"
        reboot_guest "${base_dir}" "${transcript}"
    fi
    local accept_rc=0 session_env="" token_env=""
    guest_scp "${guest_script}" "${CLOUD_USER}@127.0.0.1:/tmp/guest-acceptance.bash"
    if [[ "${BASE_PROFILE}" == "desktop" ]]; then
        # The checks must reach the session's GNOME Shell: the bus of the autologin session.
        session_env="XDG_RUNTIME_DIR=/run/user/\$(id -u) DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/\$(id -u)/bus"
    fi
    if [[ "${SCENARIO_HOST_ONLY}" == "true" ]]; then
        # "No secret bytes survived" cannot be checked by a script that does not know the
        # bytes, so the needles go back in — briefly. The checker's first act is to read them
        # and unlink the file, and its last is to fail if that file still exists. The
        # provisioning secrets are removed first: they are what the checker must not find.
        drop_guest_secrets
        push_guest_needles "${github_token_file}" "${github_ssh_pp_file}"
        token_env="VMTEST_GITHUB_USER='${github_account}' VMTEST_NEEDLES_FILE=${GUEST_SECRET_DIR}/needles"
    fi
    guest_ssh "env ${session_env} ${token_env} VMTEST_COMMIT='${commit}' VMTEST_USER_EMAIL='${GUEST_USER_EMAIL}' bash /tmp/guest-acceptance.bash" \
        2>&1 | tee -a "${transcript}" >&2 || accept_rc="${PIPESTATUS[0]}"
    [[ "${accept_rc}" -eq 0 ]] || log "guest acceptance script exited ${accept_rc} (recorded; the transcript decides)"
    if [[ "${BASE_PROFILE}" == "desktop" ]]; then
        collect_desktop_evidence "${transcript}"
    fi

    # ── scrub, for a run that handled a real credential ────────────────────────────────
    # BEFORE the run is judged or reported. run.bash echoes plenty and the serial console
    # captures everything the guest printed, so a secret reaching either is a live
    # possibility rather than a hypothetical. A residual match aborts: the artefacts stay
    # under RUN_DIR for a human, and nothing downstream treats them as safe to pass on.
    if [[ "${SCENARIO_HOST_ONLY}" == "true" ]]; then
        log "scrubbing the run's artefacts and verifying no supplied secret survives"
        scrub_run_artefacts "${github_token_file}" "${github_ssh_pp_file}" \
            "${transcript}" "${RUN_DIR}/console.log"
    fi

    # ── destroy, judge, respond ────────────────────────────────────────────────────────
    console_follow_stop
    virsh -c "${LIBVIRT_URI}" destroy "${DOMAIN}" >&2
    virsh -c "${LIBVIRT_URI}" undefine --nvram "${DOMAIN}" >&2
    DOMAIN=""
    local finished_at verdict_rc=0
    finished_at="$(date +%s)"
    helper judge_run --transcript "${transcript}" --transcript-path "runs/${run_id}/transcript.log" \
        --base-json "${base_json}" --scenario "${scenario_id}" --planned "${SCENARIO_PLANNED}" \
        --max-skipped "${SCENARIO_MAX_SKIPPED}" --run-id "${run_id}" --commit "${commit}" \
        --branch "${VMTEST_REPO_BRANCH}" --freshness-decision "${decision}" --freshness-degraded "${degraded}" \
        --freshness-divergences "${divergences}" --divergences "$(scenario_divergences)" \
        --started-at "${started_at}" --finished-at "${finished_at}" \
        --probe-revision "$(probe_value VMTEST-FRESHNESS-REVISION)" \
        >"${RUN_DIR}/response.json" || verdict_rc=$?
    [[ "${verdict_rc}" -ne 2 ]] || die "could not judge the run; see ${RUN_DIR}"
    local verdict
    verdict="$(grep -m1 -oE '"verdict": "[a-z]+"' "${RUN_DIR}/response.json")"
    verdict="${verdict#*: \"}"
    verdict="${verdict%\"}"
    if [[ "${verdict}" == "pass" ]]; then
        RUN_OK=1
    fi
    # §4.4a: the run was the refresh probe. A passing run whose upgrade changed nothing at a
    # guest-seen revision at or past the probe's certifies the base current — no extra boot.
    local certified
    certified="$(helper refresh certify --response "${RUN_DIR}/response.json" --base-json "${base_json}")" ||
        die "could not apply the run's refresh outcome to ${base_json}"
    log "${certified}"
    if [[ "${certified}" == *"reason=refresh outcome is 'stale'"* ]]; then
        log "base ${BASE_NAME} is stale: refresh it with: vmtest refresh-base ${SCENARIO_BASE_KEY}"
    fi
    log "verdict: ${verdict}; response ${RUN_DIR}/response.json; transcript ${transcript}"
    printf 'VMTEST-RUN %s verdict=%s response=%s\n' "${run_id}" "${verdict}" "${RUN_DIR}/response.json"
    [[ "${verdict}" == "pass" ]]
}

# ── verify: the only place a bridge response signature can be checked (§6.6 rule 11) ─────

cmd_verify() {
    local run_id="${1:?usage: vmtest verify <run-id>}" slug key
    load_lab
    [[ -d "${VMTEST_CHECKOUT:-}" ]] || die "${LAB_ENV} does not name an existing VMTEST_CHECKOUT; re-run play-vm-test-lab.yml"
    slug="$(systemd-escape --path "${VMTEST_CHECKOUT}")"
    key="${HOME}/.config/vmtest-bridge/${slug}/response.key"
    [[ -r "${key}" ]] || die "no bridge signing key at ${key}; re-run play-vm-test-lab.yml"
    helper verify_response --checkout "${VMTEST_CHECKOUT}" --key "${key}" --run-id "${run_id}"
    log "verdict of record: ${HOME}/.local/state/vmtest-bridge/${slug}/service.log"
}

# ── refresh-base (§4.4a, §9 T6.2) ─────────────────────────────────────────────────────────

# cmd_refresh_base <base-key|server|desktop|all> — refresh every matching base that has been
# built. A refresh is a rebuild from the published artefacts — the re-import of a fast
# base's image, the Anaconda install of a full one — because §4.4a forbids flattening a
# provisioned run's overlay into a base. A named target is matched by key before the
# manifest is consulted, so `refresh-base <key>` cannot be aborted by a directory the
# manifest does not know; `all` and the profiles visit every directory and fail on one.
cmd_refresh_base() {
    local target="${1:?usage: vmtest refresh-base <base-key|server|desktop|all>}" base_json base_dir name key done=0
    load_lab
    for base_json in "${BASES_DIR}"/*/base.json; do
        [[ -r "${base_json}" ]] || continue
        base_dir="$(dirname "${base_json}")"
        name="$(basename "${base_dir}")"
        key="${name%-"${VMTEST_FEDORA_VERSION}"}"
        case "${target}" in
            all | server | desktop) ;;
            *) [[ "${key}" == "${target}" ]] || continue ;;
        esac
        base_facts "${key}"
        case "${target}" in
            server | desktop) [[ "${BASE_PROFILE}" == "${target}" ]] || continue ;;
            *) ;;
        esac
        if [[ "${BASE_KIND}" == "fast" ]]; then
            log "refreshing ${name}: re-importing the published image and upgrading"
        else
            log "refreshing ${name}: reinstalling from the verified media and upgrading (a full base; this takes a while)"
        fi
        cmd_build_base "${key}"
        done=$((done + 1))
    done
    [[ "${done}" -gt 0 ]] || die "no built base matches ${target}; build one with: vmtest build-base <base-key>"
    printf 'VMTEST-REFRESH-DONE refreshed=%s\n' "${done}"
}

# ── freshness-status / sweep / nightly (§9 T6.3, T6.4) ───────────────────────────────────

readonly STATUS_FILE="${VMTEST_HOME}/freshness-status.txt"
readonly RETENTION_LOG="${VMTEST_HOME}/retention.log"

# cmd_freshness_status [--deep] — one probe, one verdict line per built base, written to a
# status file and printed. REPORTS ONLY: a `reinstall` here is a line in a file, never a
# rebuild. `--deep` re-hashes every base disk against its record (the nightly timer does).
cmd_freshness_status() {
    local depth=quick
    case "${1:-}" in
        --deep) depth=deep ;;
        "") ;;
        *) die "usage: vmtest freshness-status [--deep]" ;;
    esac
    load_lab
    probe_upstream
    trap 'rm -f "${PROBE_FILE:-}"' EXIT
    local status_new="${STATUS_FILE}.new" base_dir base_json base_disk name worst=0
    {
        printf 'written_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        printf 'integrity=%s\n' "${depth}"
        printf 'probe_revision=%s\n' "$(probe_value VMTEST-FRESHNESS-REVISION)"
        printf 'probe_compose_id=%s\n' "$(probe_value VMTEST-FRESHNESS-COMPOSE-ID)"
    } >"${status_new}"
    for base_json in "${BASES_DIR}"/*/base.json; do
        [[ -r "${base_json}" ]] || continue
        base_dir="$(dirname "${base_json}")"
        base_disk="${base_dir}/base.qcow2"
        name="$(basename "${base_dir}")"
        [[ -r "${base_disk}" ]] || die "${name} has a record but no base.qcow2"
        freshness_verdict "${base_json}" "${base_disk}" "${depth}"
        printf 'base=%s\tdecision=%s\tdegraded=%s\tintegrity=%s\tdivergences=%s\n' \
            "${name}" "${GATE_DECISION}" "${GATE_DEGRADED}" "${GATE_INTEGRITY}" "${GATE_DIVERGENCES}" >>"${status_new}"
        printf 'VMTEST-FRESHNESS-STATUS %s decision=%s degraded=%s integrity=%s\n' "${name}" "${GATE_DECISION}" "${GATE_DEGRADED}" "${GATE_INTEGRITY}"
        if [[ "${GATE_RC}" -gt "${worst}" ]]; then
            worst="${GATE_RC}"
        fi
    done
    mv -f "${status_new}" "${STATUS_FILE}"
    log "freshness status written: ${STATUS_FILE}"
    # The exit reports the worst verdict (a timer's unit state carries it); nothing was changed.
    return "${worst}"
}

# cmd_sweep — the T6.4 retention policy over the lab tree and the bridge spool.
cmd_sweep() {
    load_lab
    [[ -d "${VMTEST_CHECKOUT:-}" ]] || die "${LAB_ENV} does not name an existing VMTEST_CHECKOUT; re-run play-vm-test-lab.yml"
    helper retention sweep --lab-dir "${VMTEST_HOME}" --checkout "${VMTEST_CHECKOUT}" --log "${RETENTION_LOG}"
    log "every eviction is recorded in ${RETENTION_LOG}"
}

cmd_nightly() {
    local rc=0
    cmd_freshness_status --deep || rc=$?
    cmd_sweep
    return "${rc}"
}

# ── dispatch ──────────────────────────────────────────────────────────────────────────────

main() {
    local command="${1:-help}"
    if [[ $# -gt 0 ]]; then
        shift
    fi
    case "${command}" in
        fetch) cmd_fetch "$@" ;;
        build-base) cmd_build_base "$@" ;;
        run) cmd_run "$@" ;;
        verify) cmd_verify "$@" ;;
        refresh-base) cmd_refresh_base "$@" ;;
        freshness-status) cmd_freshness_status "$@" ;;
        sweep) cmd_sweep "$@" ;;
        nightly) cmd_nightly "$@" ;;
        help | -h | --help) usage ;;
        *)
            usage >&2
            printf 'ERROR: unknown command: %s\n' "${command}" >&2
            exit 64
            ;;
    esac
}

main "$@"
