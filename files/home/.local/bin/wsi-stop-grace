#!/usr/bin/bash
#============================================================================
# wsi-stop-grace - print the speech-to-text stop grace, in whole seconds
#============================================================================
# The recorders (wsi, wsi-stream) keep recording for this long after the first
# Insert press, so the words spoken right before it are captured; a second press
# during the grace stops at once. 0 means stop immediately.
#
# Single source: the GSettings key `stop-grace-seconds` in the extension's own
# schema (default 3), read through wsi-setting (which says how to change it).
#
# stdout is the value and nothing else; every diagnostic goes to stderr.
# Not interactive: invoked by the recorders, which treat failure as fatal.
#============================================================================
set -euo pipefail

readonly KEY="stop-grace-seconds"
SETTING_READER="$(dirname -- "${BASH_SOURCE[0]}")/wsi-setting"
readonly SETTING_READER

if [[ $# -ne 0 ]]; then
    echo "usage: wsi-stop-grace (takes no arguments; prints the grace in seconds)" >&2
    exit 2
fi

# wsi-setting names the cause and the play to re-run on stderr
if ! value=$("$SETTING_READER" "$KEY"); then
    echo "wsi-stop-grace: cannot read $KEY" >&2
    exit 1
fi

if [[ ! "$value" =~ ^[0-9]+$ ]]; then
    echo "wsi-stop-grace: $KEY is not a whole number of seconds: '$value'" >&2
    exit 1
fi

echo "$value"
