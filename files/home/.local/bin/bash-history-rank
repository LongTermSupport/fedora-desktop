#!/usr/bin/env bash
# bash-history-rank — rank every command in bash history for the directory given, for the
# Ctrl+R search in ~/.bashrc-includes/history-search.bash (Plan 00138).
#
# Nothing is filtered out. Commands are ordered in three tiers:
#   1. ran in this directory
#   2. ran anywhere inside this directory's git repository
#   3. everything else, including all history from before the recorder existed
# Within a tier, commands whose every recorded run failed sink; then most recent first.
#
# Usage: bash-history-rank <context-file> <history-file> <directory>
#   context-file  the recorder's NUL-terminated records: epoch TAB exit TAB cwd TAB command
#   history-file  a bash HISTFILE, with or without #epoch timestamp lines
#
# stdout: the payload — distinct commands, best first, each NUL-terminated.
# stderr: diagnostics only.
#
# EXIT CODES: 0 ranked; 64 usage error; 66 an input file is missing or unreadable.
set -euo pipefail

if [[ $# -ne 3 ]]; then
    printf 'usage: bash-history-rank <context-file> <history-file> <directory>\n' >&2
    exit 64
fi
context_file="$1"
history_file="$2"
directory="$3"
for f in "${context_file}" "${history_file}"; do
    if [[ ! -r "${f}" ]]; then
        printf 'bash-history-rank: cannot read %s\n' "${f}" >&2
        exit 66
    fi
done

# Outside a repository git exits non-zero; that is an answer, and the repository tier is
# simply empty. git names the top level by its PHYSICAL path, while the recorder stores
# $PWD, the path as the user reached it — through a symlink the two differ. So the
# repository is also named the logical way: the directory with git's prefix (where the
# directory sits inside the repository) taken off the end. A record matches either.
repo=""
repo_logical=""
if repo_out="$(git -C "${directory}" rev-parse --show-toplevel --show-prefix 2>&1)"; then
    repo="${repo_out%%$'\n'*}"
    prefix="${repo_out#*$'\n'}"
    if [[ "${prefix}" == "${repo_out}" ]]; then
        prefix=""
    fi
    prefix="${prefix%/}"
    repo_logical="${directory%/}"
    if [[ -n "${prefix}" ]]; then
        repo_logical="${repo_logical%/"${prefix}"}"
    fi
    # Stripping the prefix is only right when the link sits above the repository. A link
    # INTO it (stow-style dotfiles: ~/.config/nvim -> dotfiles/.config/nvim) ends in the same
    # prefix, and stripping it would name the home directory as the repository. So the
    # logical name counts only if it resolves to the physical top level.
    if [[ "$(cd "${repo_logical}" 2>&1 && pwd -P)" != "${repo}" ]]; then
        repo_logical=""
    fi
fi

# The history file becomes context-shaped records with no directory and no exit status.
# With timestamps an entry is everything between two #epoch lines (lithist keeps embedded
# newlines); lines before the first timestamp are one entry each.
history_as_records() {
    gawk '
        function flush() { if (buf != "") printf "0\t\t\t%s%c", buf, 0; buf = "" }
        /^#[0-9]+$/ && length($0) >= 11 { flush(); stamped = 1; next }
        stamped { buf = (buf == "" ? $0 : buf "\n" $0); next }
        { printf "0\t\t\t%s%c", $0, 0 }
        END { flush() }
    ' "${history_file}"
}

# History first, context second: context rows are newer copies of the same commands and
# carry the directory and exit status, so they update recency and add the tier signals.
{
    history_as_records
    cat "${context_file}"
} |
    gawk -v cwd="${directory}" -v repo="${repo}" -v repo_logical="${repo_logical}" '
        function in_repo(dir, root) { return root != "" && (dir == root || index(dir, root "/") == 1) }
        BEGIN { RS = "\0"; FS = "\t"; ORS = "\0" }
        {
            cmd = $4
            for (i = 5; i <= NF; i++) cmd = cmd "\t" $i
            if (cmd == "") next
            last[cmd] = NR
            if ($3 == "") next
            runs[cmd]++
            if ($2 == "0") ok[cmd] = 1
            if ($3 == cwd) here[cmd] = 1
            else if (in_repo($3, repo) || in_repo($3, repo_logical)) inrepo[cmd] = 1
        }
        END {
            for (cmd in last) {
                tier = (cmd in here) ? 2 : ((cmd in inrepo) ? 1 : 0)
                failed = (runs[cmd] > 0 && !(cmd in ok)) ? 1 : 0
                printf "%d\t%d\t%d\t%s\0", tier, failed, last[cmd], cmd
            }
        }
    ' |
    sort -z -t $'\t' -k1,1nr -k2,2n -k3,3nr |
    cut -z -f4-
