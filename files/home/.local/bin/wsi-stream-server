#!/usr/bin/env python3
"""
WSI-Stream Server - Persistent Speech-to-Text Server
=====================================================
Keeps the Whisper model hot in memory for instant recording startup, and runs each
dictation as a loop and a buffer, so a dictation has no length limit of its own.

    pw-record (16 kHz mono s16) -> capture thread -> Silero VAD -> Segmenter
        -> segment queue -> ONE transcription worker (the selected model)
        -> ordered commit -> text in memory + append-only journal

The segmenter cuts at natural pauses and keeps every segment within one Whisper window
(28 s at most), so the worker transcribes each segment once, in order, while the user is
still speaking; at STOP only the last segment or two remain. Any failure (a segment that
raises, the microphone dying, a backlog past its ceiling, a drain past its deadline, a
journal write) marks the session FAILED: the microphone is closed, the audio not yet
transcribed is kept as WAV and the text so far is reported. Nothing is dropped silently.

That pipeline runs only for START {continuous: true}. Without it no VAD runs: the whole
recording (at most max_seconds) is one clip, transcribed once at STOP by the same
worker and model.

Commands, one JSON line each way over a Unix socket:
    START {max_seconds, silence_seconds, continuous}   KEEPALIVE   PROGRESS
    STOP (closes the microphone, drains; PROGRESS then reports the text)   ABORT   PING
A recording stops itself when the client's KEEPALIVEs stop (15 s), after
silence_seconds without speech (0 = never), and at max_seconds. The client reads those
limits from the extension's settings.

A dictation's text counts as delivered once a STOP or PROGRESS reply carrying it reached
a client. One that never did (the client died, so the heartbeat stopped it) keeps its
journal, holds off the idle shutdown, and is handed to the next START in its reply.

Auto-shuts down after idle timeout (default: 20 minutes; 0 = never). wsi-stream passes
the extension's server-idle-timeout-minutes setting when it starts the server.
"""

import array
import fcntl
import functools
import json
import os
import queue
import shutil
import signal
import socket
import subprocess
import sys
import threading
import time
import wave
from datetime import datetime
from pathlib import Path

# Suppress HuggingFace Hub rate-limit warnings - model downloads are deliberate
os.environ.setdefault("HF_TOKEN", "")
os.environ.setdefault("TRANSFORMERS_OFFLINE", "1")
os.environ.setdefault("HF_DATASETS_OFFLINE", "1")

# Constants
SOCKET_PATH = Path(f"/run/user/{os.getuid()}/wsi-stream.socket")
LOG_DIR = Path.home() / ".local/share/speech-to-text"
LOG_FILE = LOG_DIR / "server.log"
PID_FILE = Path(f"/run/user/{os.getuid()}/wsi-stream-server.pid")
# Journal and kept audio: per-user tmpfs, cleared at logout. Dictated text is not kept
# across logins, so never ~/.cache.
DICTATION_DIR = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}") / "wsi-dictation"
CAPTURE_CMD = ["pw-record", "--rate", "16000", "--channels", "1", "--format", "s16", "-"]

# Configuration
DEFAULT_IDLE_TIMEOUT = 1200  # 20 minutes; 0 means never shut down
SOCKET_TIMEOUT = 0.5  # Check for shutdown every 0.5s
REQUEST_LIMIT_BYTES = 65536

# Audio: Silero VAD judges 512-sample frames (32 ms at 16 kHz)
SAMPLE_RATE = 16000
FRAME_SAMPLES = 512
FRAME_BYTES = FRAME_SAMPLES * 2
VAD_BATCH_FRAMES = 8  # frames judged per VAD call (256 ms)

# Session safety stops and failure limits (Plan 00148 research sections 3.3, 3.4)
HEARTBEAT_SECONDS = 15
BACKLOG_CEILING_SECONDS = 120
DRAIN_BASE_SECONDS = 10
DRAIN_RTF_FACTOR = 3
PROMPT_CHARS = 200
MIN_SEGMENT_SECONDS = 1.0  # shorter segments are padded with silence, as wsi pads

# Global state
debug_mode = False
shutdown_requested = False
last_activity_time = time.time()
idle_timeout = DEFAULT_IDLE_TIMEOUT
server_start_time = None
pid_lock_fd = None  # open PID file whose flock marks this process as the running server
transcriber = None  # WhisperTranscriber, loaded once
make_vad = None     # returns a fresh frame VAD for a session
session = None      # the current or last DictationSession


def log(message, level="INFO"):
    """Log message to file and stderr if debug mode."""
    timestamp = datetime.now().strftime("%Y-%m-%dT%H:%M:%S")
    log_line = f"[{timestamp}] [SERVER] [{level}] {message}"

    if debug_mode:
        print(log_line, file=sys.stderr)

    try:
        LOG_DIR.mkdir(parents=True, exist_ok=True)
        with open(LOG_FILE, "a") as f:
            f.write(log_line + "\n")
    except OSError as e:
        print(f"wsi-stream-server: cannot write {LOG_FILE}: {e}: {log_line}", file=sys.stderr)


def update_activity():
    """Update last activity timestamp."""
    global last_activity_time
    last_activity_time = time.time()


def is_busy():
    """True while a dictation is recording or still being transcribed."""
    return session is not None and session.busy()


def check_idle_timeout():
    """Check if server has been idle too long. A timeout of 0 keeps it running.

    Never while the last dictation's text is still owed to a client: the next START
    hands it over, and a server that exited would forget it was owed.
    """
    if is_busy() or idle_timeout == 0 or (session is not None and session.owes_text()):
        return False

    idle_time = time.time() - last_activity_time
    return idle_time >= idle_timeout


# ---------------------------------------------------------------------------
# Segmenting: pure, testable on synthetic frames
# ---------------------------------------------------------------------------

def frames_for(seconds):
    return max(1, round(seconds * SAMPLE_RATE / FRAME_SAMPLES))


class Segment:
    """One stretch of speech for one transcription: audio, its place, why it was cut."""

    def __init__(self, seq, start_frame, samples, cut, speech_frames):
        self.seq = seq
        self.start_frame = start_frame
        self.samples = samples
        self.cut = cut
        self.speech_frames = speech_frames

    @property
    def duration(self):
        return len(self.samples) / SAMPLE_RATE

    @property
    def start_seconds(self):
        return self.start_frame * FRAME_SAMPLES / SAMPLE_RATE

    @property
    def end_seconds(self):
        return self.start_seconds + self.duration


class Segmenter:
    """Cuts a stream of 512-sample frames into segments, from each frame's speech probability.

    - A segment closes after END_PAUSE_SECONDS without speech once it holds
      MIN_SPEECH_SECONDS of speech; with less speech, after SHORT_END_PAUSE_SECONDS.
    - Past SOFT_MAX_SECONDS it closes at the next pause of SOFT_PAUSE_SECONDS.
    - At HARD_MAX_SECONDS with no pause it is cut at the quietest frame of the last
      HARD_CUT_WINDOW_SECONDS; the rest starts the next segment, so no audio is lost.
    - Until a segment holds speech only PRE_ROLL_SECONDS of what came before is kept:
      pure silence is never queued.
    """

    SPEECH_THRESHOLD = 0.5
    MIN_SPEECH_SECONDS = 1.0
    END_PAUSE_SECONDS = 0.7
    SHORT_END_PAUSE_SECONDS = 2.0
    SOFT_MAX_SECONDS = 20.0
    SOFT_PAUSE_SECONDS = 0.25
    HARD_MAX_SECONDS = 28.0
    HARD_CUT_WINDOW_SECONDS = 2.0
    PRE_ROLL_SECONDS = 0.5

    def __init__(self):
        self._frames = []
        self._speech = []
        self._energy = []
        self._start = 0  # stream frame index of self._frames[0]
        self._seq = 0
        self._speech_frames = 0
        self._trailing_silence = 0
        self.last_frame_was_speech = False
        self.cut_counts = {"pause": 0, "soft": 0, "hard": 0, "stop": 0}
        self._min_speech = frames_for(self.MIN_SPEECH_SECONDS)
        self._end_pause = frames_for(self.END_PAUSE_SECONDS)
        self._short_end_pause = frames_for(self.SHORT_END_PAUSE_SECONDS)
        self._soft_max = frames_for(self.SOFT_MAX_SECONDS)
        self._soft_pause = frames_for(self.SOFT_PAUSE_SECONDS)
        self._hard_max = frames_for(self.HARD_MAX_SECONDS)
        self._hard_window = frames_for(self.HARD_CUT_WINDOW_SECONDS)
        self._pre_roll = frames_for(self.PRE_ROLL_SECONDS)

    def push(self, frame, speech_prob):
        """Add one frame; returns the segments it closed (none or one)."""
        speech = speech_prob >= self.SPEECH_THRESHOLD
        self.last_frame_was_speech = speech
        self._frames.append(frame)
        self._speech.append(speech)
        self._energy.append(sum(s * s for s in frame))
        if speech:
            self._speech_frames += 1
            self._trailing_silence = 0
        else:
            self._trailing_silence += 1

        if self._speech_frames == 0:
            excess = len(self._frames) - self._pre_roll
            if excess > 0:
                self._drop(excess)
            return []

        n = len(self._frames)
        if self._trailing_silence >= self._end_pause and self._speech_frames >= self._min_speech:
            return [self._cut(n, "pause")]
        if self._trailing_silence >= self._short_end_pause:
            return [self._cut(n, "pause")]
        if n >= self._soft_max and self._trailing_silence >= self._soft_pause:
            return [self._cut(n, "soft")]
        if n >= self._hard_max:
            quietest = min(range(n - self._hard_window, n), key=lambda i: self._energy[i])
            return [self._cut(quietest, "hard")]
        return []

    def finish(self):
        """At stop: the open segment, however short, if it holds any speech."""
        if self._speech_frames == 0:
            self._drop(len(self._frames))
            return []
        return [self._cut(len(self._frames), "stop")]

    def _drop(self, count):
        del self._frames[:count], self._speech[:count], self._energy[:count]
        self._start += count

    def _cut(self, at, kind):
        samples = array.array("h")
        for f in self._frames[:at]:
            samples.extend(f)
        segment = Segment(self._seq, self._start, samples, kind, sum(self._speech[:at]))
        self._seq += 1
        self.cut_counts[kind] += 1
        self._drop(at)
        self._speech_frames = sum(self._speech)
        self._trailing_silence = 0
        for was_speech in reversed(self._speech):
            if was_speech:
                break
            self._trailing_silence += 1
        return segment


class WholeClip:
    """Continuous dictation off: the whole recording is one segment, cut only at stop.

    Takes the Segmenter's place without a VAD, so nothing judges speech and nothing is
    dropped as silence; Whisper transcribes the clip as batch `wsi` does.
    """

    def __init__(self):
        self._samples = array.array("h")
        self.last_frame_was_speech = False
        self.cut_counts = {"pause": 0, "soft": 0, "hard": 0, "stop": 0}

    def push(self, frame, _speech_prob=None):
        self._samples.extend(frame)
        return []

    def finish(self):
        if not self._samples:
            return []
        self.cut_counts["stop"] += 1
        return [Segment(0, 0, self._samples, "stop", 0)]


class Transcript:
    """Segment texts committed strictly in sequence order, whatever order they arrive in."""

    def __init__(self):
        self._parts = []
        self._held = {}
        self._next = 0

    def commit(self, seq, text):
        """Store seq's text; returns the (seq, text) pairs that became contiguous."""
        if seq < self._next or seq in self._held:
            raise ValueError(f"segment {seq} committed twice")
        self._held[seq] = text.strip()
        newly = []
        while self._next in self._held:
            part = self._held.pop(self._next)
            self._parts.append(part)
            newly.append((self._next, part))
            self._next += 1
        return newly

    @property
    def committed_count(self):
        return self._next

    @property
    def held(self):
        return sorted(self._held)

    @property
    def text(self):
        return " ".join(p for p in self._parts if p)

    def prompt(self, chars):
        return self.text[-chars:]


class Journal:
    """Append-only JSONL, one line per segment, so a crash leaves the text recoverable."""

    def __init__(self, path):
        self.path = path
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        self._file = os.fdopen(fd, "a", encoding="utf-8")

    def record(self, **entry):
        self._file.write(json.dumps(entry) + "\n")
        self._file.flush()

    def close(self):
        """Close it; a failure is logged, as the session is ending either way."""
        try:
            self._file.close()
        except OSError as e:
            log(f"Closing the journal {self.path} failed: {e}", "ERROR")


def write_wav(path, samples):
    with wave.open(str(path), "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(SAMPLE_RATE)
        w.writeframes(samples.tobytes())


def padded(samples):
    """At least MIN_SEGMENT_SECONDS of audio: Whisper does badly on very short clips."""
    short = int(SAMPLE_RATE * MIN_SEGMENT_SECONDS) - len(samples)
    if short <= 0:
        return samples
    out = array.array("h", samples)
    out.extend([0] * short)
    return out


# ---------------------------------------------------------------------------
# The dictation session
# ---------------------------------------------------------------------------

class DictationSession:
    """One dictation: microphone -> segments -> ordered text, and how it ends.

    States: recording -> draining -> done; any of them -> failed; recording -> aborted.
    Threads: capture (reads the microphone, runs the VAD and the segmenter, never waits
    on transcription), worker (transcribes one segment at a time, in order), supervisor
    (heartbeat, no-speech and absolute stops, backlog ceiling, drain deadline).
    """

    ACTIVE = ("recording", "draining")
    FINISHED = ("done", "failed", "aborted")

    def __init__(self, *, transcribe, vad, runtime_dir, max_seconds, silence_seconds=0,
                 continuous=False, capture_cmd=None, heartbeat_seconds=HEARTBEAT_SECONDS,
                 backlog_ceiling_seconds=BACKLOG_CEILING_SECONDS,
                 drain_base_seconds=DRAIN_BASE_SECONDS, drain_rtf_factor=DRAIN_RTF_FACTOR,
                 tick_seconds=0.2):
        if continuous != (vad is not None):
            raise ValueError("a VAD is required with continuous dictation and refused without it")
        if silence_seconds and not continuous:
            raise ValueError("the no-speech stop needs continuous dictation (it has the VAD)")
        self._transcribe = transcribe
        self._vad = vad
        self._runtime_dir = Path(runtime_dir)
        self._max_seconds = max_seconds
        self._silence_seconds = silence_seconds
        self._continuous = continuous
        self._capture_cmd = list(capture_cmd or CAPTURE_CMD)
        self._heartbeat = heartbeat_seconds
        self._backlog_ceiling = backlog_ceiling_seconds
        self._drain_base = drain_base_seconds
        self._drain_rtf_factor = drain_rtf_factor
        self._tick = tick_seconds

        self._lock = threading.Lock()
        self._queue = queue.Queue()
        self._finished = threading.Event()
        self._segmenter = Segmenter() if continuous else WholeClip()
        self._transcript = Transcript()
        self._journal = None
        self._proc = None
        self._capture_thread = None
        self.session_dir = self._runtime_dir / f"session-{time.time_ns()}"

        self.state = "starting"
        self.stop_reason = None
        self.error = None
        self.captured_bytes = 0
        self.empty_segments = 0
        self.kept_audio = []
        self.unsaved_audio = []
        self._stopping = False
        self._started_at = None
        self._stopped_at = None
        self._last_keepalive = None
        self._last_speech = None
        self._drain_deadline = None
        self._pending = 0
        self._backlog = 0.0
        self._rtf = None
        # Figures for the stats line at the end (see _log_stats).
        self._backlog_max = 0.0
        self._audio_done = 0.0
        self._took_done = 0.0
        self._rtf_max = 0.0
        self._segments_done = 0
        self._in_flight = None
        self._transcribing = False  # the model is in use, whatever the state says
        self.delivered = False      # a reply with the final text reached a client

    # -- lifecycle ----------------------------------------------------------

    def start(self):
        """Open the microphone and start the threads. Raises if the microphone will not open."""
        self._runtime_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
        os.chmod(self._runtime_dir, 0o700)
        self.session_dir.mkdir(mode=0o700)
        try:
            self._journal = Journal(self.session_dir / "journal.jsonl")
            self._proc = subprocess.Popen(self._capture_cmd, stdout=subprocess.PIPE,
                                          stderr=subprocess.DEVNULL)
            time.sleep(0.1)
            if self._proc.poll() is not None:
                raise RuntimeError(f"pw-record exited at once with code {self._proc.returncode}")
        except Exception:
            if self._proc is not None and self._proc.poll() is None:
                self._proc.kill()
                self._proc.wait(timeout=2)
            if self._journal is not None:
                self._journal.close()
            shutil.rmtree(self.session_dir)
            raise
        now = time.monotonic()
        self._started_at = self._last_keepalive = self._last_speech = now
        self.state = "recording"
        log(f"Dictation started (pw-record PID {self._proc.pid}, limit {self._max_seconds} s, "
            f"no-speech stop {self._silence_seconds or 'off'}, journal {self._journal.path})")
        self._capture_thread = threading.Thread(target=self._capture, daemon=True)
        self._capture_thread.start()
        threading.Thread(target=self._work, daemon=True).start()
        threading.Thread(target=self._supervise, daemon=True).start()

    def busy(self):
        """Recording, draining, or a segment still in the model after the session ended.

        A session failed at its drain deadline (or aborted) cannot stop a transcription
        already under way; until it returns, a new session must not share the model.
        """
        return self.state in self.ACTIVE or self._transcribing

    def status(self):
        """The state a client is told: "stopping" while a stop is closing the microphone."""
        with self._lock:
            return self._status_locked()

    def _status_locked(self):
        return "stopping" if self.state == "recording" and self._stopping else self.state

    def keepalive(self):
        self._last_keepalive = time.monotonic()

    def capture_returncode(self):
        return None if self._proc is None else self._proc.poll()

    def stop(self, reason):
        """Close the microphone, keep every captured sample, and drain the queue.

        Idempotent: returns None if the session was not recording (already stopping,
        stopped, failed or aborted). The worker finishes the remaining segments; the
        supervisor fails the session if that takes past the drain deadline.
        """
        with self._lock:
            if self.state != "recording" or self._stopping:
                return None
            self._stopping = True
            self.stop_reason = reason
        log(f"Stopping dictation: {reason}")
        self._proc.terminate()
        self._capture_thread.join(timeout=3)
        if self._capture_thread.is_alive():
            log("pw-record did not close its output in 3 s - killing it", "WARN")
            self._proc.kill()
            self._capture_thread.join(timeout=2)
        if self._capture_thread.is_alive():
            self.fail("the microphone did not close (pw-record ignored SIGTERM and SIGKILL)")
            return False
        with self._lock:
            if self.state != "recording":
                return False
            self.state = "draining"
            self._stopped_at = time.monotonic()
            rtf = self._rtf if self._rtf is not None else 1.0
            budget = self._drain_base + self._drain_rtf_factor * self._backlog * rtf
            self._drain_deadline = self._stopped_at + budget
            self._queue.put(None)
            log(f"Microphone closed ({self.captured_bytes} bytes); draining {self._pending} "
                f"segment(s), {self._backlog:.1f} s of audio, within {budget:.1f} s")
        return True

    def abort(self):
        """Escape: close the microphone at once and discard the text, journal included."""
        with self._lock:
            if self.state in self.FINISHED:
                return
            self.state = "aborted"
            self._drain_queue(keep=False)
            self._queue.put(None)
        log("Dictation aborted - discarding it")
        if self._proc is not None:
            self._proc.kill()
        if self._capture_thread is not None:
            self._capture_thread.join(timeout=3)
        with self._lock:
            self._journal.close()
            shutil.rmtree(self.session_dir)
        self._finished.set()

    def fail(self, message, failed=None):
        """Mark the session FAILED: keep the untranscribed audio, close the microphone.

        `failed` is the segment that caused it, if one did; the segment being
        transcribed and every queued one are kept too. Never raises.
        """
        with self._lock:
            if self.state in self.FINISHED:
                return
            self.state = "failed"
            self.error = message
            self._stopped_at = self._stopped_at or time.monotonic()
            if self._in_flight is not None:
                self._settle_locked(self._in_flight)
                self._keep(self._in_flight, "failed" if self._in_flight is failed else "pending")
                self._in_flight = None
            elif failed is not None:
                self._keep(failed, "failed")
            self._drain_queue(keep=True)
            self._queue.put(None)
            self._journal.close()
            self._log_stats_locked("failed")
        log(f"Dictation FAILED: {message}", "ERROR")
        if self._proc is not None and self._proc.poll() is None:
            self._proc.terminate()
        self._finished.set()

    def mark_delivered(self):
        with self._lock:
            self.delivered = True

    def owes_text(self):
        with self._lock:
            return self._owes_text_locked()

    def _owes_text_locked(self):
        """Ended with something the user has not been given: text, kept audio or a failure."""
        if self.state not in ("done", "failed") or self.delivered:
            return False
        return self.state == "failed" or bool(self._transcript.text) or bool(self.kept_audio)

    def hand_over(self):
        """At the next START: what the user was never given, once, or None.

        A done session a client collected is removed. One nobody collected keeps its
        directory (cleared at logout) and is returned for the START reply. A failed
        session's directory is always kept: it holds the audio.
        """
        with self._lock:
            if self._owes_text_locked():
                self.delivered = True
                return {"status": self.state, "transcription": self._transcript.text,
                        "stop_reason": self.stop_reason, "error": self.error,
                        "journal": str(self.session_dir / "journal.jsonl"),
                        "session_dir": str(self.session_dir),
                        "kept_audio": list(self.kept_audio)}
            if self.state == "done" and self.session_dir.exists():
                shutil.rmtree(self.session_dir)
            return None

    def wait(self, timeout):
        return self._finished.wait(timeout)

    # -- reporting ----------------------------------------------------------

    def progress(self):
        with self._lock:
            now = time.monotonic()
            end = self._stopped_at or now
            report = {
                "status": self._status_locked(),
                "continuous": self._continuous,
                "elapsed_seconds": round(end - self._started_at, 1) if self._started_at else 0,
                "segments_committed": self._transcript.committed_count,
                "segments_pending": self._pending,
                "backlog_seconds": round(self._backlog, 1),
                "rtf": None if self._rtf is None else round(self._rtf, 3),
                "hard_cuts": self._segmenter.cut_counts["hard"],
                "empty_segments": self.empty_segments,
                "kept_audio": list(self.kept_audio),
                "unsaved_audio": list(self.unsaved_audio),
                "stop_reason": self.stop_reason,
                "error": self.error,
                "session_dir": str(self.session_dir),
            }
            if self.state == "draining" and self._drain_deadline:
                report["drain_seconds_left"] = round(max(0.0, self._drain_deadline - now), 1)
            if self.state in ("done", "failed"):
                report["transcription"] = self._transcript.text
            return report

    # -- threads ------------------------------------------------------------

    def _capture(self):
        pending = []
        try:
            while True:
                chunk = self._proc.stdout.read(FRAME_BYTES)
                if not chunk:
                    break
                self.captured_bytes += len(chunk)
                frame = array.array("h", chunk[:len(chunk) - len(chunk) % 2])
                if len(frame) < FRAME_SAMPLES:
                    frame.extend([0] * (FRAME_SAMPLES - len(frame)))
                pending.append(frame)
                if len(pending) >= VAD_BATCH_FRAMES:
                    self._segment(pending)
                    pending = []
            if pending:
                self._segment(pending)
            with self._lock:
                unexpected = self.state == "recording" and not self._stopping
            if unexpected:
                code = self._proc.wait(timeout=2)
                self.fail(f"the microphone (pw-record) stopped unexpectedly (exit code {code})")
            self._enqueue(self._segmenter.finish())
        except Exception as e:
            self.fail(f"audio capture failed: {e}")
            self._enqueue(self._segmenter.finish())

    def _segment(self, frames):
        if self._vad is None:
            for frame in frames:
                self._segmenter.push(frame)
            return
        probs = self._vad.probabilities(frames)
        if len(probs) != len(frames):
            raise RuntimeError(f"the VAD judged {len(probs)} of {len(frames)} frames")
        closed = []
        for frame, prob in zip(frames, probs):
            closed += self._segmenter.push(frame, prob)
            if self._segmenter.last_frame_was_speech:
                self._last_speech = time.monotonic()
        self._enqueue(closed)

    def _enqueue(self, segments):
        with self._lock:
            for segment in segments:
                if self.state in self.ACTIVE:
                    self._queue.put(segment)
                    self._pending += 1
                    self._backlog += segment.duration
                    self._backlog_max = max(self._backlog_max, self._backlog)
                elif self.state == "failed":
                    self._keep(segment, "pending")
                if segment.cut == "hard":
                    log(f"Segment {segment.seq} hard-cut at {segment.duration:.1f} s (no pause)", "WARN")

    def _work(self):
        while True:
            segment = self._queue.get()
            if segment is None:
                with self._lock:
                    if self.state == "draining":
                        self.state = "done"
                        self._journal.close()
                        log(f"Dictation done: {self._transcript.committed_count} segment(s), "
                            f"{len(self._transcript.text)} chars")
                        self._log_stats_locked("done")
                        self._finished.set()
                return
            with self._lock:
                if self.state not in self.ACTIVE:
                    continue
                self._in_flight = segment
                self._transcribing = True
                prompt = self._transcript.prompt(PROMPT_CHARS)
            began = time.monotonic()
            try:
                text = self._transcribe(padded(segment.samples), prompt).strip()
            except Exception as e:
                self._transcribing = False
                self.fail(f"segment {segment.seq} ({segment.start_seconds:.0f}-"
                          f"{segment.end_seconds:.0f} s) failed to transcribe: {e}", failed=segment)
                continue
            self._transcribing = False
            took = time.monotonic() - began
            journal_error = None
            with self._lock:
                if self.state not in self.ACTIVE:
                    continue  # fail() kept this segment's audio while it was in flight
                self._in_flight = None
                self._settle_locked(segment)
                rtf = took / max(segment.duration, 0.001)
                self._rtf = rtf if self._rtf is None else 0.5 * self._rtf + 0.5 * rtf
                status = "ok" if text else "empty"
                try:
                    self._journal.record(seq=segment.seq, t_start=round(segment.start_seconds, 2),
                                         t_end=round(segment.end_seconds, 2), status=status,
                                         cut=segment.cut, text=text)
                except OSError as e:
                    journal_error = e
                else:
                    self._transcript.commit(segment.seq, text)
                    self._segments_done += 1
                    self._audio_done += segment.duration
                    self._took_done += took
                    self._rtf_max = max(self._rtf_max, rtf)
                    if status == "empty":
                        self.empty_segments += 1
                        self._keep(segment, "empty")
            if journal_error is not None:
                self.fail(f"cannot write the journal {self._journal.path}: {journal_error}",
                          failed=segment)

    def _supervise(self):
        while not self._finished.wait(self._tick):
            now = time.monotonic()
            with self._lock:
                state = self.state
                backlog = self._backlog
                deadline = self._drain_deadline
                pending = self._pending
                rtf = self._rtf
            if state == "recording":
                if now - self._last_keepalive > self._heartbeat:
                    self.stop(f"heartbeat lost: no KEEPALIVE for {self._heartbeat:g} s")
                elif self._silence_seconds and now - self._last_speech > self._silence_seconds:
                    self.stop(f"no speech for {self._silence_seconds:g} s")
                elif now - self._started_at >= self._max_seconds:
                    self.stop(f"reached the {self._max_seconds:g} s recording limit")
                elif backlog > self._backlog_ceiling:
                    self.fail(f"transcription cannot keep up: {backlog:.0f} s of audio waiting "
                              f"(real-time factor {rtf or 0:.2f})")
            elif state == "draining" and deadline is not None and now > deadline:
                self.fail(f"transcription did not finish in time: {pending} segment(s) "
                          "still pending")

    # -- helpers (callers hold the lock where named _locked or noted) --------

    def _log_stats_locked(self, outcome):
        """One line of figures for a finished dictation, key=value, read by Plan 00148's
        triage: how real dictation performs, measured by the server that does it, with no
        second model. rtf is transcription time / audio time (above 1 the backlog grows)."""
        audio = self._audio_done
        cuts = ",".join(f"{k}:{v}" for k, v in self._segmenter.cut_counts.items())
        log("Dictation stats: "
            f"outcome={outcome} mode={'continuous' if self._continuous else 'whole'} "
            f"segments={self._segments_done} audio_s={audio:.1f} "
            f"transcribe_s={self._took_done:.1f} "
            f"rtf_mean={self._took_done / audio if audio else 0:.3f} rtf_max={self._rtf_max:.3f} "
            f"backlog_max_s={self._backlog_max:.1f} cuts={cuts}")

    def _settle_locked(self, segment):
        self._pending -= 1
        self._backlog -= segment.duration

    def _drain_queue(self, keep):
        """Empty the queue (lock held); keep each segment's audio if asked."""
        while True:
            try:
                segment = self._queue.get_nowait()
            except queue.Empty:
                return
            if segment is None:
                continue
            self._settle_locked(segment)
            if keep:
                self._keep(segment, "pending")

    def _keep(self, segment, label):
        """Save a segment's audio as WAV beside the journal (lock held)."""
        path = self.session_dir / f"seg-{segment.seq:04d}-{label}.wav"
        try:
            write_wav(path, segment.samples)
        except OSError as e:
            self.unsaved_audio.append(f"segment {segment.seq}: {e}")
            log(f"Cannot keep segment {segment.seq}'s audio at {path}: {e}", "ERROR")
            return
        self.kept_audio.append(str(path))


# ---------------------------------------------------------------------------
# Models: faster-whisper's own model and Silero VAD (no RealtimeSTT)
# ---------------------------------------------------------------------------

class WhisperTranscriber:
    """The selected model, called once per segment: one Whisper window, no seams."""

    def __init__(self, model, language):
        self._model = model
        self._language = language

    def __call__(self, samples, prompt):
        import numpy as np
        audio = np.frombuffer(samples.tobytes(), dtype=np.int16).astype(np.float32) / 32768.0
        segments, _info = self._model.transcribe(
            audio, language=self._language or None, beam_size=5, vad_filter=False,
            condition_on_previous_text=False, initial_prompt=prompt or None)
        return " ".join(s.text.strip() for s in segments).strip()


def checked_probabilities(values, frame_count, source):
    """`values` as floats, if they are exactly one probability per frame. Raises otherwise.

    A VAD fed the wrong input shape can answer with one value per batch, or with
    values that are not probabilities; segmenting on that would cut speech silently.
    """
    probs = [float(v) for v in values]
    if len(probs) != frame_count:
        raise RuntimeError(f"{source} returned {len(probs)} probabilities for {frame_count} frames")
    bad = [p for p in probs if not 0.0 <= p <= 1.0]  # NaN fails the comparison too
    if bad:
        raise RuntimeError(f"{source} returned values that are not probabilities: {bad[:3]}")
    return probs


def select_vad_input(candidates, silence_frames):
    """The first (name, call) whose answer for `silence_frames` is all "no speech".

    Each call takes a list of frames and returns the model's raw output. Raises,
    naming every candidate's failure, if none qualifies.
    """
    failures = []
    for name, call in candidates:
        try:
            probs = checked_probabilities(call(silence_frames), len(silence_frames),
                                          f"Silero VAD ({name} input)")
        except Exception as e:
            failures.append(f"{name} input: {type(e).__name__}: {e}")
            continue
        if max(probs) >= Segmenter.SPEECH_THRESHOLD:
            failures.append(f"{name} input: judged silence as speech (max {max(probs):.2f})")
            continue
        return name, call
    raise RuntimeError("the Silero VAD adapter cannot use this faster-whisper's VAD model: "
                       + "; ".join(failures))


class SileroFrameVad:
    """Speech probability per 512-sample frame, from faster-whisper's bundled Silero VAD.

    Which input shape the model takes ((batch, samples) or samples) differs between
    faster-whisper releases, so it is found by test, on silence, when the adapter is
    built: a shape is used only if it yields one probability per frame, all "no
    speech". Every later answer is checked the same way. Either check failing raises.

    The model keeps no state between calls, so each call also re-reads the last
    CONTEXT_FRAMES frames and only the newest probabilities are used.
    """

    CONTEXT_FRAMES = 32

    def __init__(self, model):
        self._context = []
        silence = [array.array("h", [0] * FRAME_SAMPLES)] * self.CONTEXT_FRAMES
        self.input_shape, self._call = select_vad_input([
            ("(batch, samples)", functools.partial(self._run, model, batched=True)),
            ("(samples)", functools.partial(self._run, model, batched=False)),
        ], silence)

    @staticmethod
    def _run(model, frames, batched):
        import numpy as np
        audio = np.frombuffer(b"".join(f.tobytes() for f in frames), dtype=np.int16)
        audio = audio.astype(np.float32) / 32768.0
        return np.asarray(model(audio[None, :] if batched else audio)).reshape(-1)

    def probabilities(self, frames):
        window = self._context + list(frames)
        probs = checked_probabilities(self._call(window), len(window),
                                      f"Silero VAD ({self.input_shape} input)")
        self._context = window[-self.CONTEXT_FRAMES:]
        return probs[-len(frames):]


_silero_model = None


def make_silero_vad():
    """A fresh adapter for a continuous session; loads the model on first use. Raises."""
    global _silero_model
    if _silero_model is None:
        from faster_whisper.vad import get_vad_model
        _silero_model = get_vad_model()
    vad = SileroFrameVad(_silero_model)
    log(f"Silero VAD ready ({vad.input_shape} input)")
    return vad


def choose_device(device_type):
    """(device, compute_type): `auto` uses CUDA when CTranslate2 counts a GPU."""
    if device_type == "cpu":
        return "cpu", "int8"
    if device_type == "gpu":
        return "cuda", "float16"
    import ctranslate2
    return ("cuda", "float16") if ctranslate2.get_cuda_device_count() > 0 else ("cpu", "int8")


def load_models(model_size="base", language="en", device_type="auto"):
    """Load the Whisper model - the expensive part, done once.

    The VAD is loaded by the first continuous START, so a recording without
    continuous dictation never depends on it.
    """
    global transcriber, make_vad

    try:
        from faster_whisper import WhisperModel

        device, compute_type = choose_device(device_type)
        log(f"Loading model={model_size}, language={language}, device={device} ({compute_type})")
        model = WhisperModel(model_size, device=device, compute_type=compute_type)
    except Exception as e:
        log(f"Model load failed: {e}", "ERROR")
        return False

    transcriber = WhisperTranscriber(model, language)
    make_vad = make_silero_vad
    log("Model loaded - ready for instant recording")
    return True


# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

def start_limits(params):
    """The session limits START carries. Raises ValueError naming what is wrong."""
    max_seconds = params.get("max_seconds")
    if isinstance(max_seconds, bool) or not isinstance(max_seconds, int) or max_seconds <= 0:
        raise ValueError("START needs max_seconds, a whole number of seconds above 0 "
                         f"(got {max_seconds!r})")
    silence_seconds = params.get("silence_seconds", 0)
    if isinstance(silence_seconds, bool) or not isinstance(silence_seconds, int) or silence_seconds < 0:
        raise ValueError("silence_seconds must be a whole number of seconds, 0 for off "
                         f"(got {silence_seconds!r})")
    continuous = params.get("continuous", False)
    if not isinstance(continuous, bool):
        raise ValueError(f"continuous must be true or false (got {continuous!r})")
    if silence_seconds and not continuous:
        raise ValueError("silence_seconds needs continuous dictation (send 0 without it)")
    return {"max_seconds": max_seconds, "silence_seconds": silence_seconds,
            "continuous": continuous}


def handle_start_command(client_socket, params):
    """START: open the microphone and begin a dictation session."""
    global session

    update_activity()
    if is_busy():
        if session.state in DictationSession.ACTIVE:
            message = "Recording already active"
        else:
            message = (f"The previous dictation ({session.state}) is still finishing a "
                       "transcription; the model is in use. Try again in a moment.")
        send_response(client_socket, {"status": "error", "message": message})
        return
    if transcriber is None:
        send_response(client_socket, {"status": "error", "message": "Model not loaded"})
        return
    try:
        limits = start_limits(params)
    except ValueError as e:
        send_response(client_socket, {"status": "error", "message": str(e)})
        return

    vad = None
    if limits["continuous"]:
        try:
            vad = make_vad()
        except Exception as e:
            log(f"Continuous dictation unavailable: the VAD did not load: {e}", "ERROR")
            send_response(client_socket, {"status": "error", "message":
                                          f"Continuous dictation unavailable: {e}"})
            return
    new_session = DictationSession(transcribe=transcriber, vad=vad, runtime_dir=DICTATION_DIR,
                                   capture_cmd=CAPTURE_CMD, heartbeat_seconds=HEARTBEAT_SECONDS,
                                   drain_base_seconds=DRAIN_BASE_SECONDS,
                                   drain_rtf_factor=DRAIN_RTF_FACTOR, **limits)
    try:
        new_session.start()
    except FileNotFoundError:
        log("pw-record not found - PipeWire not installed", "ERROR")
        send_response(client_socket, {"status": "error",
                                      "message": "pw-record not found (PipeWire required)"})
        return
    except Exception as e:
        log(f"Audio capture failed: {e}", "ERROR")
        send_response(client_socket, {"status": "error", "message": f"Audio capture failed: {e}"})
        return
    previous, session = session, new_session
    reply = {"status": "recording", "message": "Recording started",
             "session_dir": str(session.session_dir)}
    undelivered = previous.hand_over() if previous is not None else None
    if undelivered is not None:
        log(f"Handing over a dictation no client collected ({undelivered['status']}, "
            f"{len(undelivered['transcription'])} chars, journal {undelivered['journal']})", "WARN")
        reply["undelivered"] = undelivered
    send_response(client_socket, reply)


def no_session(client_socket):
    send_response(client_socket, {"status": "error", "message": "No active recording"})


def send_progress(client_socket):
    """The session's progress; once a reply carrying the final text is sent, it is delivered."""
    report = session.progress()
    if send_response(client_socket, report) and "transcription" in report:
        session.mark_delivered()


def handle_stop_command(client_socket, params):
    """STOP: close the microphone and drain; the reply is the session's progress."""
    update_activity()
    if session is None:
        no_session(client_socket)
        return
    session.stop("stop requested")
    send_progress(client_socket)


def handle_keepalive_command(client_socket, params):
    """KEEPALIVE: the client is still there; without one for 15 s the recording stops."""
    update_activity()
    if session is None:
        no_session(client_socket)
        return
    session.keepalive()
    send_response(client_socket, {"status": session.status()})


def handle_progress_command(client_socket, params):
    """PROGRESS: the session's state; with the text once it is done or failed."""
    update_activity()
    if session is None:
        no_session(client_socket)
        return
    send_progress(client_socket)


def handle_abort_command(client_socket, params):
    """ABORT (Escape): close the microphone and discard the dictation."""
    update_activity()
    if session is None:
        no_session(client_socket)
        return
    session.abort()
    send_response(client_socket, {"status": session.state})


def handle_ping_command(client_socket, params):
    """Handle PING command - used to check if server is alive."""
    update_activity()

    send_response(client_socket, {
        "status": "alive",
        "recording": is_busy(),
        "uptime_seconds": time.time() - server_start_time,
        "idle_seconds": time.time() - last_activity_time
    })


def handle_shutdown_command(client_socket, params):
    """Handle SHUTDOWN command - graceful server shutdown."""
    global shutdown_requested

    log("SHUTDOWN command received")
    shutdown_requested = True

    send_response(client_socket, {
        "status": "shutting_down"
    })


COMMANDS = {
    "START": handle_start_command,
    "STOP": handle_stop_command,
    "KEEPALIVE": handle_keepalive_command,
    "PROGRESS": handle_progress_command,
    "ABORT": handle_abort_command,
    "PING": handle_ping_command,
    "SHUTDOWN": handle_shutdown_command,
}


def send_response(client_socket, data):
    """Send one JSON line to the client; True if it was sent."""
    try:
        client_socket.sendall((json.dumps(data) + "\n").encode())
    except OSError as e:
        log(f"Failed to send response: {e}", "ERROR")
        return False
    return True


def read_request(client_socket):
    """One request line (up to REQUEST_LIMIT_BYTES), or '' if the client sent nothing."""
    data = b""
    while b"\n" not in data and len(data) < REQUEST_LIMIT_BYTES:
        chunk = client_socket.recv(4096)
        if not chunk:
            break
        data += chunk
    return data.decode().strip()


def handle_client(client_socket):
    """Handle a client connection: one command, one reply."""
    try:
        data = read_request(client_socket)
        if not data:
            log("A client connected and sent nothing")
            return

        try:
            command = json.loads(data)
        except json.JSONDecodeError as e:
            send_response(client_socket, {"status": "error", "message": f"Invalid JSON: {e}"})
            return

        cmd_type = command.get("command")
        params = command.get("params") or {}
        if cmd_type not in ("PING", "PROGRESS", "KEEPALIVE"):
            log(f"Received command: {cmd_type}")

        handler = COMMANDS.get(cmd_type)
        if handler is None:
            send_response(client_socket, {"status": "error",
                                          "message": f"Unknown command: {cmd_type}"})
            return
        handler(client_socket, params)

    except (ConnectionResetError, BrokenPipeError) as e:
        # A recording whose client is gone stops itself when the KEEPALIVEs stop
        log(f"Client connection lost: {e}", "WARN")

    except Exception as e:
        log(f"Error handling client: {e}", "ERROR")
        send_response(client_socket, {"status": "error", "message": f"Server error: {e}"})

    finally:
        client_socket.close()


def idle_monitor_thread():
    """Monitor idle time and shutdown if exceeded."""
    global shutdown_requested

    while not shutdown_requested:
        time.sleep(10)  # Check every 10 seconds

        if check_idle_timeout():
            log(f"Idle timeout ({idle_timeout}s) exceeded - shutting down")
            shutdown_requested = True


cleanup_done = False


def cleanup():
    """Cleanup on exit."""
    global transcriber, make_vad, cleanup_done

    if cleanup_done:
        return
    cleanup_done = True

    log("Server shutting down - cleaning up")

    # A dictation in progress fails loudly: its text so far and its audio stay in the
    # journal directory, and the microphone is released
    if is_busy():
        log("Active dictation during shutdown - failing it and keeping its audio", "WARN")
        session.fail("the speech-to-text server shut down during the dictation")
    if session is not None and session.owes_text():
        log(f"Shutting down with a dictation no client collected; it stays in "
            f"{session.session_dir} until logout", "WARN")

    transcriber = None
    make_vad = None

    # Remove socket
    if SOCKET_PATH.exists():
        try:
            SOCKET_PATH.unlink()
        except OSError as e:
            log(f"Failed to remove the socket {SOCKET_PATH}: {e}", "WARN")

    # Remove PID file and drop the lock (last: the server is gone only now)
    release_pid_file()

    log("Server shutdown complete")


PID_LOCK_GRACE_SECONDS = 0.2
PID_LOCK_RETRY_SECONDS = 0.01


def lock_exclusive_with_grace(fd):
    """Take the exclusive lock, retrying briefly before giving up.

    `wsi-stream` asks whether a server is running by taking a SHARED lock on the PID
    file for an instant. A server that tries to lock inside that instant would
    otherwise conclude another server holds the file and exit. A real server holds
    its lock for its lifetime, so a lock still held after the grace is genuine.
    Raises BlockingIOError if it is.
    """
    deadline = time.monotonic() + PID_LOCK_GRACE_SECONDS
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return
        except BlockingIOError:
            if time.monotonic() >= deadline:
                raise
            time.sleep(PID_LOCK_RETRY_SECONDS)


def claim_pid_file():
    """Hold an exclusive lock on PID_FILE for this server's lifetime, and write our PID.

    The lock, not the PID in the file, is what says a server is running: the kernel
    drops it when the process ends, however it ends. So of any number of servers
    started together (the login unit, an Insert) exactly one gets it; a file left by a
    server that died, or naming a PID since reused by another program, has no lock and
    is simply taken over. Returns False if another server holds the lock or the file
    cannot be used; the reason is logged.
    """
    global pid_lock_fd
    for _attempt in range(3):
        try:
            fd = os.open(PID_FILE, os.O_RDWR | os.O_CREAT, 0o644)
        except OSError as e:
            log(f"ERROR: cannot open the PID file {PID_FILE}: {e}", "ERROR")
            return False
        try:
            lock_exclusive_with_grace(fd)
        except BlockingIOError:
            held = os.read(fd, 32).decode(errors="replace").strip() or "unknown"
            os.close(fd)
            log(f"ERROR: Server already running (PID {held})", "ERROR")
            log(f"PID file: {PID_FILE}", "ERROR")
            log("To force restart, kill the existing server first:", "ERROR")
            log(f"  kill {held}", "ERROR")
            return False
        except OSError as e:
            os.close(fd)
            log(f"ERROR: cannot lock the PID file {PID_FILE}: {e}", "ERROR")
            return False
        # A server that was shutting down may have removed the file between our open and
        # our lock; we would then hold the lock on a file nobody else can see
        try:
            path_stat = os.stat(PID_FILE)
            fd_stat = os.fstat(fd)
            current = (path_stat.st_dev, path_stat.st_ino) == (fd_stat.st_dev, fd_stat.st_ino)
        except FileNotFoundError:
            current = False
        if not current:
            os.close(fd)
            continue
        os.ftruncate(fd, 0)
        os.write(fd, str(os.getpid()).encode())
        pid_lock_fd = fd
        return True
    log(f"ERROR: could not claim {PID_FILE}; it kept being replaced", "ERROR")
    return False


def release_pid_file():
    """Remove PID_FILE and drop its lock, if this process holds it.

    Removed while still locked, so a server that opened it meanwhile sees the path no
    longer matches what it locked, and tries again.
    """
    global pid_lock_fd
    if pid_lock_fd is None:
        return
    try:
        PID_FILE.unlink(missing_ok=True)
    except OSError as e:
        log(f"Failed to remove the PID file {PID_FILE}: {e}", "WARN")
    os.close(pid_lock_fd)
    pid_lock_fd = None


def signal_handler(signum, frame):
    """Handle shutdown signals."""
    global shutdown_requested
    log(f"Received signal {signum} - shutting down")
    shutdown_requested = True


def main():
    global debug_mode, idle_timeout, shutdown_requested, server_start_time

    # Parse arguments
    import argparse
    parser = argparse.ArgumentParser(description="WSI-Stream persistent server")
    parser.add_argument("-d", "--debug", action="store_true",
                        help="Enable debug logging")
    parser.add_argument("-t", "--timeout", type=int, default=DEFAULT_IDLE_TIMEOUT,
                        help="Idle timeout in seconds; 0 = never shut down "
                             f"(default: {DEFAULT_IDLE_TIMEOUT})")
    parser.add_argument("-m", "--model", type=str, default="base",
                        help="Whisper model size (default: base)")
    parser.add_argument("-l", "--language", type=str, default="en",
                        help="Language code (default: en)")
    parser.add_argument("--device", type=str, default="auto",
                        choices=["auto", "gpu", "cpu"],
                        help="Device type (default: auto)")

    args = parser.parse_args()
    if args.timeout < 0:
        parser.error(f"--timeout must be 0 (never) or a positive number of seconds, not {args.timeout}")
    debug_mode = args.debug
    idle_timeout = args.timeout

    server_start_time = time.time()

    # SINGLETON ENFORCEMENT: before the log is truncated and the socket touched, so a
    # second server never wipes the running one's log or removes its socket
    if not claim_pid_file():
        sys.exit(1)

    # Truncate log file on each server start so it doesn't grow unboundedly
    LOG_DIR.mkdir(parents=True, exist_ok=True)
    LOG_FILE.write_text("")

    log("=== WSI-Stream Server Starting ===")
    log(f"Model: {args.model}, Language: {args.language}, Device: {args.device}")
    log(f"Idle timeout: {idle_timeout}s" + (" (never shut down)" if idle_timeout == 0 else ""))

    # Register signal handlers
    signal.signal(signal.SIGTERM, signal_handler)
    signal.signal(signal.SIGINT, signal_handler)

    # Load the models (this is the expensive part - done once!)
    if not load_models(args.model, args.language, args.device):
        log("Failed to load the models - exiting", "ERROR")
        release_pid_file()
        return 1

    # Remove a socket left by a server that died
    if SOCKET_PATH.exists():
        try:
            SOCKET_PATH.unlink()
        except OSError as e:
            log(f"Failed to remove old socket: {e}", "ERROR")
            cleanup()
            return 1

    # Create Unix socket
    try:
        server_socket = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        server_socket.bind(str(SOCKET_PATH))
        server_socket.listen(5)
        server_socket.settimeout(SOCKET_TIMEOUT)  # Non-blocking accept
        log(f"Server listening on {SOCKET_PATH}")
    except OSError as e:
        log(f"Failed to create socket: {e}", "ERROR")
        cleanup()
        return 1

    # Start idle monitor thread
    monitor = threading.Thread(target=idle_monitor_thread, daemon=True)
    monitor.start()

    log("Server ready - waiting for clients")

    # Main server loop
    try:
        while not shutdown_requested:
            try:
                client_socket, _ = server_socket.accept()
                # Handle client in current thread (simple sequential processing)
                handle_client(client_socket)
            except socket.timeout:
                # Normal timeout - check shutdown flag
                continue
            except OSError as e:
                if not shutdown_requested:
                    log(f"Accept error: {e}", "ERROR")

    finally:
        server_socket.close()
        cleanup()

    return 0


if __name__ == "__main__":
    sys.exit(main())
