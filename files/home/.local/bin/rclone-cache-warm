#!/bin/bash
# rclone-cache-warm - warm the VFS file cache for a directory on an rclone mount
#
# Usage: rclone-cache-warm [--fast] [PATH]
#   PATH    directory to warm (default: current directory)
#   --fast  refresh directory metadata only (requires mount started with --rc)
#
# Default mode reads every file through the mount, populating the VFS cache so
# subsequent access (e.g. geeqie browsing RAW files) is local-speed.
#
# --fast mode only refreshes rclone's directory listing cache (metadata, no
# file downloads). Useful after adding files to the remote. Requires the mount
# service to be started with --rc (remote control endpoint).

set -euo pipefail

FAST=false
TARGET=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --fast)
            FAST=true
            shift
            ;;
        --help | -h)
            sed -n '2,/^$/p' "$0" | sed 's/^# \?//'
            exit 0
            ;;
        -*)
            echo "ERROR: Unknown option: $1" >&2
            exit 1
            ;;
        *)
            TARGET="$1"
            shift
            ;;
    esac
done

TARGET="$(realpath "${TARGET:-.}")"

if [[ ! -d "$TARGET" ]]; then
    echo "ERROR: Not a directory: $TARGET" >&2
    exit 1
fi

# Verify the target is under an rclone VFS mount
MOUNT_LINE=$(findmnt -n -o SOURCE,TARGET -t fuse.rclone --target "$TARGET" 2>/dev/null || true)
if [[ -z "$MOUNT_LINE" ]]; then
    echo "ERROR: '$TARGET' is not under an rclone VFS mount" >&2
    echo "  (checked for fuse.rclone filesystem type via findmnt)" >&2
    exit 1
fi

RCLONE_SOURCE=$(awk '{print $1}' <<<"$MOUNT_LINE")
MOUNT_POINT=$(awk '{print $2}' <<<"$MOUNT_LINE")
MOUNT_NAME="${RCLONE_SOURCE%%:*}"
REL_PATH=$(realpath --relative-to="$MOUNT_POINT" "$TARGET")
[[ "$REL_PATH" == "." ]] && REL_PATH=""

echo "Mount:  $RCLONE_SOURCE → $MOUNT_POINT"
echo "Target: $TARGET"
echo ""
rclone-cache-status --label before "$MOUNT_NAME"
echo ""

if [[ "$FAST" == true ]]; then
    echo "Refreshing directory cache (fast mode)..."

    # vfs/refresh is one of the RC endpoints rclone gates behind authentication
    # (unlike vfs/stats and core/stats, which answer unauthenticated). The mount
    # is given the credential as RCLONE_RC_USER/RCLONE_RC_PASS via systemd
    # EnvironmentFile; the client side takes the differently-named --user/--pass.
    # Values are read rather than sourced, so a config file cannot execute code.
    RC_AUTH_FILE="$HOME/.config/rclone/rc-auth.env"
    if [[ ! -r "$RC_AUTH_FILE" ]]; then
        echo "" >&2
        echo "ERROR: RC credential file not found: $RC_AUTH_FILE" >&2
        echo "  --fast calls vfs/refresh, which requires RC authentication." >&2
        echo "  It is generated by play-rclone.yml. Deploy it with:" >&2
        echo "    ansible-playbook playbooks/imports/optional/common/play-rclone.yml" >&2
        echo "  Do NOT create it by hand." >&2
        exit 1
    fi
    RC_USER=$(awk -F= '$1 == "RCLONE_RC_USER" { print $2 }' "$RC_AUTH_FILE")
    RC_PASS=$(awk -F= '$1 == "RCLONE_RC_PASS" { print $2 }' "$RC_AUTH_FILE")
    if [[ -z "$RC_USER" || -z "$RC_PASS" ]]; then
        echo "ERROR: $RC_AUTH_FILE is missing RCLONE_RC_USER or RCLONE_RC_PASS." >&2
        echo "  Re-run play-rclone.yml to regenerate it." >&2
        exit 1
    fi

    RC_ARGS=("fs=$RCLONE_SOURCE" "recursive=true")
    [[ -n "$REL_PATH" ]] && RC_ARGS+=("remote=$REL_PATH")
    if ! rclone rc --user "$RC_USER" --pass "$RC_PASS" vfs/refresh "${RC_ARGS[@]}"; then
        echo "" >&2
        echo "ERROR: rclone rc failed." >&2
        echo "  --fast mode requires the mount to be started with --rc." >&2
        echo "  If the call was refused with HTTP 403, the mount and this script" >&2
        echo "  disagree on the credential — re-run play-rclone.yml, which writes" >&2
        echo "  both the unit and $RC_AUTH_FILE." >&2
        exit 1
    fi
    echo "Directory cache refreshed."
else
    FILE_COUNT=$(find "$TARGET" -type f | wc -l)
    echo "Warming cache: reading $FILE_COUNT files (4 parallel streams)..."
    find "$TARGET" -type f -print0 | xargs -0 -P 4 -I{} sh -c 'cat "$1" > /dev/null && printf "." >&2' -- {}
    echo ""
    echo "Done. $FILE_COUNT files cached."
fi

echo ""
rclone-cache-status --label after "$MOUNT_NAME"
