#!/usr/bin/env bash
# ssh-with-password — ssh to a host using password auth only, offering no keys
#
# Forces interactive password (or keyboard-interactive) authentication and
# suppresses every public-key path: no keys from ~/.ssh, no keys from the
# running ssh-agent, no host-based auth. Useful when a key would otherwise be
# offered/accepted but you specifically want to authenticate with a password
# (e.g. first-time provisioning, a shared account, or testing password login).
#
# Usage:
#   ssh-with-password [ssh-args...] user@host
#   ssh-with-password -p 2222 admin@host.example.com
#
# All arguments are passed straight through to ssh, after the key-disabling
# options — so you can still add -p, -L, commands, etc.
#
# Agent forwarding: pass -A (or -o ForwardAgent=yes) and a fresh, dedicated
# ssh-agent is started for this session — you are asked which keys to add — and
# forwarded to the remote host. The agent is killed again when the connection
# closes. For an interactive login (no remote command given) the remote shell is
# started with GIT_SSH_COMMAND preset, so `git push` over there uses the
# forwarded key even on a machine whose ~/.ssh/config pins IdentitiesOnly to a
# local, push-less key. Auth to THIS host is unaffected: it stays password-only
# because PubkeyAuthentication=no blocks every key regardless of the agent.
set -euo pipefail

if [ "$#" -eq 0 ] || [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    echo "Usage: ssh-with-password [ssh-args...] user@host"
    echo ""
    echo "  SSH using password authentication only — offers no public keys."
    echo "  All arguments are forwarded to ssh."
    echo ""
    echo "Examples:"
    echo "  ssh-with-password admin@server"
    echo "  ssh-with-password -p 2222 admin@host.example.com"
    [ "$#" -eq 0 ] && exit 1
    exit 0
fi

# Shared agent-forwarding helpers live alongside this script in ~/.local/bin.
SWA_LIB="$(dirname "$(readlink -f "$0")")/ssh-with-agent.bash"
if [ ! -r "$SWA_LIB" ]; then
    echo "Error: helper library not found: $SWA_LIB" >&2
    exit 1
fi
source "$SWA_LIB"

# PreferredAuthentications  — only ever try password / keyboard-interactive
# PubkeyAuthentication=no   — never attempt public-key auth
# IdentitiesOnly=yes        — ignore identities not given explicitly (none here)
opts=(
    -o PreferredAuthentications=password,keyboard-interactive
    -o PubkeyAuthentication=no
    -o IdentitiesOnly=yes
)

if swa_wants_agent_forward "$@"; then
    # -A: start a dedicated agent and pick keys. Do NOT disable the agent, and do
    # NOT exec — running ssh as a child lets the EXIT trap kill the agent after.
    swa_start_ephemeral_agent
    rc=0
    if swa_has_remote_command "$@"; then
        # User supplied their own remote command — just forward the agent.
        ssh "${opts[@]}" "$@" || rc=$?
    else
        # Interactive login: preset GIT_SSH_COMMAND on the remote so `git push`
        # there uses the forwarded agent (-t for a real shell, see the lib note).
        ssh -t "${opts[@]}" "$@" "$(swa_remote_git_push_init)" || rc=$?
    fi
    exit "$rc"
fi

# No forwarding — never consult the agent, and exec for a clean handoff.
opts+=(-o IdentityAgent=none)
exec ssh "${opts[@]}" "$@"
