#!/usr/bin/env python3
"""
WSI-Stream - Streaming Speech-to-Text with Real-time Transcription
===================================================================
Transcribes in real-time to a buffer file, then pastes instantly on stop.

WORKFLOW:
  1. Press Insert -> starts recording, transcription runs in parallel
  2. Partial results stream to buffer file (user can watch if desired)
  3. Press Insert again -> instantly pastes final text (no transcription wait)

The key benefit: transcription happens DURING recording, so paste is instant.
"""

import os
import sys
import subprocess
import signal
import time
import argparse
import atexit
import socket
import json
import fcntl
from pathlib import Path
from datetime import datetime

# Suppress HuggingFace Hub rate-limit warnings - model downloads are deliberate
os.environ.setdefault("HF_TOKEN", "")
os.environ.setdefault("TRANSFORMERS_OFFLINE", "1")
os.environ.setdefault("HF_DATASETS_OFFLINE", "1")

# Constants
LOG_DIR = Path.home() / ".local/share/speech-to-text"
LOG_FILE = LOG_DIR / "debug.log"
CACHE_DIR = Path.home() / ".cache/speech-to-text"
TRANSCRIPTION_FILE = CACHE_DIR / "last-transcription.txt"
BUFFER_FILE = CACHE_DIR / "streaming-buffer.txt"
# Use same PID file as wsi so extension can stop us
PID_FILE = Path("/dev/shm") / f"stt-recording-{os.getenv('USER')}.pid"

# Server mode constants
SERVER_SOCKET = Path(f"/run/user/{os.getuid()}/wsi-stream.socket")
SERVER_SCRIPT = Path.home() / ".local/bin/wsi-stream-server"
SERVER_PID_FILE = Path(f"/run/user/{os.getuid()}/wsi-stream-server.pid")

DBUS_PATH = "/org/fedoradesktop/SpeechToText"
DBUS_INTERFACE = "org.fedoradesktop.SpeechToText"

# Prints the stop grace in seconds; reads the extension's GSettings key, the one source
STOP_GRACE_READER = Path(__file__).resolve().parent / "wsi-stop-grace"
# Prints one of the extension's GSettings values
SETTING_READER = Path(__file__).resolve().parent / "wsi-setting"
# Prints the faster-whisper model for the Whisper Model setting (what `auto` means)
MODEL_RESOLVER = Path(__file__).resolve().parent / "wsi-resolve-model"
# After the microphone closes, wait for this many more realtime passes (bounded) so
# the audio captured last is transcribed: RealtimeSTT publishes realtime text only
# while recording, so recorder.stop() freezes whatever the last pass produced.
FINAL_REALTIME_PASSES = 2
FINAL_REALTIME_WAIT_SECONDS = 1.5
# The one home of the streaming recording cap (standard, pre-buffer, and server mode
# without continuous dictation). Batch wsi's is its own; continuous dictation's limits
# are the extension's GSettings keys. scripts/qa-stt-limits.bash keeps it single.
STREAMING_MAX_SECONDS = 120
# Server-mode client: the server stops a recording 15 s after the last KEEPALIVE
KEEPALIVE_INTERVAL = 5.0
PROGRESS_INTERVAL = 1.0
DRAIN_POLL_INTERVAL = 0.5
DRAIN_GRACE_SECONDS = 10  # beyond the server's own drain deadline
SERVER_REPLY_TIMEOUT = 10  # STOP closes the microphone before it replies (up to ~5 s)

# Global state
debug_mode = False
no_notify = False
stop_requested = False
recorder = None
current_text = ""
realtime_updates = 0  # Realtime passes reported, empty ones included


class GracefulStop:
    """Delayed-stop state shared by every wsi-stream mode.

    The extension stops a recording with SIGTERM the moment Insert is pressed, which
    cut off the words still being spoken. The first request() starts a grace period
    during which recording continues; a second request(), or any request when the
    grace is 0, makes the stop due at once. stop_now() is for SIGINT and SIGUSR1
    (Escape, with discard=True), which never wait.

    Called from signal handlers, so it only records times: it never sleeps or
    blocks. Each mode's own loop polls due() and stops there.
    """

    def __init__(self, grace_seconds, clock=time.monotonic):
        if grace_seconds < 0:
            raise ValueError(f"grace_seconds must be >= 0, got {grace_seconds}")
        self.grace_seconds = grace_seconds
        self._clock = clock
        self.deadline = None
        self.discard = False
        self._notice_owed = False
        self.notes = []  # Log lines left by signal handlers for the main loop

    def _due_now(self):
        now = self._clock()
        self.deadline = now if self.deadline is None else min(self.deadline, now)

    def request(self):
        """A stop press. Returns True if it started a grace, False if the stop is due now."""
        if self.deadline is None and self.grace_seconds > 0:
            self.deadline = self._clock() + self.grace_seconds
            self._notice_owed = True
            return True
        self._due_now()
        return False

    def stop_now(self, discard=False):
        self._due_now()
        if discard:
            self.discard = True

    @property
    def requested(self):
        return self.deadline is not None

    def due(self):
        return self.deadline is not None and self._clock() >= self.deadline

    def take_notice(self):
        """True once per grace that has started but not been announced to the user."""
        owed = self._notice_owed and not self.due()
        self._notice_owed = False
        return owed


def read_stop_grace():
    """The stop grace in seconds, from wsi-stop-grace. Raises if it cannot be read."""
    result = subprocess.run([str(STOP_GRACE_READER)], capture_output=True, text=True,
                            timeout=5, check=False)
    if result.returncode != 0:
        raise RuntimeError(f"{STOP_GRACE_READER} failed: {result.stderr.strip()}")
    value = result.stdout.strip()
    if not value.isdigit():
        raise RuntimeError(f"{STOP_GRACE_READER} printed a non-number: '{value}'")
    return int(value)


def read_setting(key):
    """One of the extension's GSettings values, from wsi-setting. Raises if unreadable."""
    result = subprocess.run([str(SETTING_READER), key], capture_output=True, text=True,
                            timeout=5, check=False)
    if result.returncode != 0:
        raise RuntimeError(f"{SETTING_READER} {key} failed: {result.stderr.strip()}")
    return result.stdout.strip()


def read_server_idle_timeout():
    """The warm server's idle timeout in seconds (0 = never), from its minutes setting."""
    value = read_setting("server-idle-timeout-minutes")
    if not value.isdigit():
        raise RuntimeError(f"server-idle-timeout-minutes is not a whole number: '{value}'")
    return int(value) * 60


def resolve_model(mode, language, setting=None):
    """The faster-whisper model for a Whisper Model setting. Raises on failure.

    The setting defaults to WHISPER_MODEL, which the extension sets for any choice but
    auto; unset means auto.
    """
    if setting is None:
        setting = os.environ.get("WHISPER_MODEL", "auto")
    result = subprocess.run(
        [str(MODEL_RESOLVER), "--mode", mode, "--language", language or "", setting],
        capture_output=True, text=True, timeout=30, check=False)
    if result.returncode != 0:
        raise RuntimeError(f"{MODEL_RESOLVER} failed: {result.stderr.strip()}")
    model = result.stdout.strip()
    if not model:
        raise RuntimeError(f"{MODEL_RESOLVER} printed no model")
    if result.stderr.strip():
        log(result.stderr.strip())
    return model


def install_stop_handlers(stop, abort_on_usr1=False):
    """SIGTERM is a stop press (graced); SIGINT stops now; SIGUSR1 discards if asked.

    The handlers do not log: log() can print to stderr, and a handler that
    interrupts a print on the main thread would raise a reentrant-call error. They
    leave a note that announce_pending_stop() logs from the main loop.
    """
    def on_term(signum, frame):
        if stop.request():
            stop.notes.append(f"SIGTERM: recording {stop.grace_seconds}s more (TERM again stops now)")
        else:
            stop.notes.append("SIGTERM: stopping now")

    def on_now(signum, frame):
        discard = signum == signal.SIGUSR1
        stop.notes.append(f"Signal {signum}: stopping now{' and discarding' if discard else ''}")
        stop.stop_now(discard=discard)

    signal.signal(signal.SIGTERM, on_term)
    signal.signal(signal.SIGINT, on_now)
    if abort_on_usr1:
        signal.signal(signal.SIGUSR1, on_now)


def announce_pending_stop(stop):
    """Log the handlers' notes, and tell the user a stop is pending (once per grace).

    Called from the main loop, never from a signal handler.
    """
    while stop.notes:
        log(stop.notes.pop(0))
    if stop.take_notice():
        log(f"Stop pending: {stop.grace_seconds}s grace")
        desktop_notification(
            f"Stopping in {stop.grace_seconds}s - finish your sentence.\n"
            "Insert: stop now. Escape: discard.",
            stop.grace_seconds * 1000,
        )


def wait_for_final_realtime_passes(start_count):
    """Wait (bounded) for realtime passes that began after the microphone closed.

    Call with the count taken after the last audio was fed. The first pass reported
    after that may have started earlier; the one after it cannot have, as the
    realtime worker runs one pass at a time.
    """
    deadline = time.monotonic() + FINAL_REALTIME_WAIT_SECONDS
    while realtime_updates < start_count + FINAL_REALTIME_PASSES and time.monotonic() < deadline:
        time.sleep(0.05)
    log(f"Final realtime passes: {realtime_updates - start_count} of {FINAL_REALTIME_PASSES}")


def read_remaining_audio(proc, chunk_size, feed):
    """Feed the audio pw-record had already captured, after asking it to stop.

    The pipe holds up to ~2 s of 16 kHz mono audio; closing it unread dropped the
    last words. Reading lets a writer blocked on a full pipe exit, and a timer kills
    a pw-record that ignores SIGTERM so the read always reaches EOF.
    """
    import array
    import threading
    proc.terminate()
    killer = threading.Timer(2, proc.kill)
    killer.start()
    fed = 0
    try:
        while True:
            chunk = proc.stdout.read(chunk_size)
            if not chunk:
                break
            usable = len(chunk) - len(chunk) % 2
            if usable:
                feed(array.array('h', chunk[:usable]))
                fed += 1
    finally:
        killer.cancel()
        proc.stdout.close()
    proc.wait(timeout=2)
    log(f"Fed {fed} remaining audio chunks after stop")


def cleanup_on_exit():
    """Ensure IDLE signal is sent and mic is released on any exit."""
    global recorder
    try:
        emit_dbus_signal("StateChanged", "IDLE")
    except Exception:
        pass
    if recorder:
        try:
            recorder.shutdown()
        except Exception:
            pass
    # Clean up PID file
    if PID_FILE.exists():
        try:
            PID_FILE.unlink()
        except Exception:
            pass


def log(message, level="INFO"):
    """Log message to file and stderr if debug mode."""
    timestamp = datetime.now().strftime("%Y-%m-%dT%H:%M:%S")
    log_line = f"[{timestamp}] [STREAM] [{level}] {message}"

    if debug_mode:
        print(log_line, file=sys.stderr)
        LOG_DIR.mkdir(parents=True, exist_ok=True)
        with open(LOG_FILE, "a") as f:
            f.write(log_line + "\n")


def emit_dbus_signal(signal_name, value):
    """Emit DBus signal for extension communication."""
    try:
        subprocess.run([
            "gdbus", "emit", "--session",
            "--object-path", DBUS_PATH,
            "--signal", f"{DBUS_INTERFACE}.{signal_name}",
            value
        ], capture_output=True, timeout=1)
    except Exception as e:
        log(f"DBus signal failed: {e}", "WARN")


def emit_dbus_text(signal_name, text):
    """Emit a signal whose one argument is `text`, quoted so gdbus cannot read it as a number."""
    quoted = "'" + text.replace("\\", "\\\\").replace("'", "\\'") + "'"
    emit_dbus_signal(signal_name, quoted)


def notify(state, message):
    """Send notification and DBus state signal."""
    log(f"State: {state} - {message}")
    emit_dbus_signal("StateChanged", state)
    desktop_notification(message, 2000)


def desktop_notification(message, expire_ms):
    """Desktop notification with no state change (unless --no-notify was passed)."""
    if no_notify:
        return

    try:
        subprocess.run([
            "gdbus", "call", "--session",
            "--dest", "org.freedesktop.Notifications",
            "--object-path", "/org/freedesktop/Notifications",
            "--method", "org.freedesktop.Notifications.Notify",
            "speech-to-text-stream",
            "0",
            "audio-input-microphone",
            "Speech to Text (Streaming)",
            message,
            "[]", "{}", str(expire_ms)
        ], capture_output=True, timeout=1)
    except Exception:
        pass


def copy_to_clipboard(text, use_clipboard=False):
    """Copy text to clipboard selection."""
    wm = os.environ.get("XDG_SESSION_TYPE", "unknown")

    if wm == "wayland":
        cmd = ["wl-copy"] if use_clipboard else ["wl-copy", "-p"]
    elif wm == "x11":
        cmd = ["xsel", "-ib"] if use_clipboard else ["xsel", "-ip"]
    else:
        log(f"Unknown window manager: {wm}", "ERROR")
        return False

    try:
        # Do NOT use communicate() - it waits for wl-copy to exit, which drops
        # clipboard ownership before we can paste. Instead, write to stdin and
        # leave the process running so it holds clipboard ownership until pasted.
        proc = subprocess.Popen(cmd, stdin=subprocess.PIPE)
        proc.stdin.write(text.encode())
        proc.stdin.close()

        # Brief wait for wl-copy to register with the compositor
        time.sleep(0.1)

        # Check process status (but don't wait for it - it should stay alive)
        rc = proc.poll()
        if rc is not None and rc != 0:
            log(f"Clipboard copy failed with exit code {rc}", "ERROR")
            return False

        # Verify clipboard was actually set (debug only)
        try:
            verify = subprocess.run(["wl-paste"], capture_output=True, timeout=1)
            if verify.returncode == 0 and verify.stdout:
                log(f"Clipboard copy successful ({len(text)} chars to {'CLIPBOARD' if use_clipboard else 'PRIMARY'})")
                log(f"Clipboard verified: {len(verify.stdout.decode())} chars readable")
            else:
                log(f"Clipboard copy: wl-copy started but clipboard empty (rc={verify.returncode})", "WARN")
        except Exception as e:
            log(f"Clipboard copy successful ({len(text)} chars) - verify skipped: {e}")

        return True
    except Exception as e:
        log(f"Clipboard copy failed: {e}", "ERROR")
        return False


def auto_paste(text, skip_enter=False, paste_with_shift=True):
    """Paste text at cursor using ydotool."""
    # Copy to CLIPBOARD (Ctrl+Shift+V / Ctrl+V both read from CLIPBOARD)
    if not copy_to_clipboard(text, use_clipboard=True):
        return False

    # Wait for clipboard to be ready
    time.sleep(0.3)

    env = os.environ.copy()
    env["YDOTOOL_SOCKET"] = "/run/ydotool.socket"

    try:
        if paste_with_shift:
            # Ctrl+Shift+V (29=Ctrl, 42=Shift, 47=V) - correct for terminals
            subprocess.run(
                ["ydotool", "key", "29:1", "42:1", "47:1", "47:0", "42:0", "29:0"],
                env=env, check=True, timeout=5
            )
            log("Paste simulated via Ctrl+Shift+V")
        else:
            # Ctrl+V (29=Ctrl, 47=V) - correct for browsers and most GUI apps
            subprocess.run(
                ["ydotool", "key", "29:1", "47:1", "47:0", "29:0"],
                env=env, check=True, timeout=5
            )
            log("Paste simulated via Ctrl+V")

        # Longer delay for longer text
        delay = min(0.3 + len(text) * 0.002, 1.0)
        time.sleep(delay)

        if not skip_enter:
            subprocess.run(
                ["ydotool", "key", "28:1", "28:0"],
                env=env, check=True, timeout=5
            )
            log("Enter key sent")

        return True
    except Exception as e:
        log(f"Auto-paste failed: {e}", "ERROR")
        return False


def on_realtime_update(new_text):
    """
    Callback for real-time transcription - writes to buffer file.
    File is completely replaced each time (no append/diff needed).
    """
    global current_text, realtime_updates

    realtime_updates += 1
    if not new_text:
        return

    new_text = new_text.strip()
    if not new_text:
        return

    # Capitalize first letter
    new_text = new_text[0].upper() + new_text[1:] if len(new_text) > 1 else new_text.upper()

    current_text = new_text
    log(f"Partial: '{new_text}'")

    # Write complete current transcription to buffer file
    # This overwrites previous content - clean and simple
    try:
        CACHE_DIR.mkdir(parents=True, exist_ok=True)
        BUFFER_FILE.write_text(new_text)
    except Exception as e:
        log(f"Buffer write failed: {e}", "WARN")


def check_dependencies():
    """Verify RealtimeSTT and ydotool are available."""
    # Check ydotool for auto-paste mode
    if not Path("/run/ydotool.socket").exists():
        log("ydotool socket not found (needed for auto-paste)", "WARN")

    try:
        import RealtimeSTT
        # Naming the resolved path both proves the import is used and answers
        # the question this check actually gets asked — WHICH RealtimeSTT, when
        # a user has one in ~/.local and another in a venv.
        log(f"RealtimeSTT imported successfully from {RealtimeSTT.__file__}")
        return True
    except ImportError as e:
        log(f"RealtimeSTT not installed: {e}", "ERROR")
        notify("ERROR", "RealtimeSTT not installed\n\npip install --user RealtimeSTT")
        return False


def run_claude_processing(text, args):
    """Post-process transcription through Claude Code."""
    log(f"Post-processing through Claude Code (model: {args.claude_model}, style: {args.claude_style})")
    # Log raw transcription being sent to Claude
    preview = text[:100] + "..." if len(text) > 100 else text
    log(f"Raw transcription to Claude ({len(text)} chars): {preview}")
    try:
        cmd = ["wsi-claude-process", "--model", args.claude_model, "--style", args.claude_style]
        if args.debug:
            cmd.append("--debug")
        cmd.append(text)

        result = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
        if result.returncode == 0 and result.stdout.strip():
            log("Claude processing successful")
            return result.stdout.strip()
        else:
            log(f"Claude processing failed (exit: {result.returncode}), using original text", "WARN")
            if result.stderr:
                log(f"Claude stderr: {result.stderr}", "WARN")
            return text
    except Exception as e:
        log(f"Claude processing error: {e}, using original text", "WARN")
        return text


def is_server_running():
    """Check if wsi-stream-server is running."""
    if not SERVER_SOCKET.exists():
        return False

    sock = None
    try:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(1)
        sock.connect(str(SERVER_SOCKET))

        # Send PING command
        command = json.dumps({"command": "PING"}) + "\n"
        sock.sendall(command.encode())

        # Read response
        response = sock.recv(4096).decode().strip()
        data = json.loads(response)
        return data.get("status") == "alive"
    except Exception as e:
        log(f"Server ping failed: {e}", "DEBUG")
        return False
    finally:
        if sock:
            try:
                sock.close()
            except Exception:
                pass


def server_pid_alive():
    """True if a server process exists (it may still be loading its model).

    Asks the server's lock, not the PID in its file: a running server holds an
    exclusive flock on the PID file, so a file left by a dead server, or naming a PID
    since reused by another program, does not count.
    """
    try:
        fd = os.open(SERVER_PID_FILE, os.O_RDONLY)
    except FileNotFoundError:
        return False
    try:
        fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
    except BlockingIOError:
        return True
    finally:
        os.close(fd)
    return False


def server_command(model, language, idle_timeout_seconds):
    """The wsi-stream-server command line; one builder for Insert and for login."""
    cmd = [str(SERVER_SCRIPT), "--model", model, "--language", language,
           "--timeout", str(idle_timeout_seconds)]
    if debug_mode:
        cmd.append("--debug")
    return cmd


def start_server(language="en"):
    """Start the persistent server if not already running.

    Raises if the model or the idle timeout cannot be read; returns False if the
    server does not come up.
    """
    if is_server_running():
        log("Server already running")
        return True

    # Check if server script exists
    if not SERVER_SCRIPT.exists():
        log(f"Server script not found: {SERVER_SCRIPT}", "ERROR")
        return False

    # Started at login (or by another Insert) and still loading its model: a second
    # server would only refuse to start, so wait for this one
    cmd = None
    if server_pid_alive():
        log("Server process exists but is not answering yet - waiting for it")
    else:
        cmd = server_command(resolve_model("streaming", language), language,
                             read_server_idle_timeout())

    try:
        if cmd:
            log(f"Starting persistent server: {' '.join(cmd)}")
            subprocess.Popen(
                cmd,
                stdout=subprocess.DEVNULL if not debug_mode else None,
                stderr=subprocess.DEVNULL if not debug_mode else None,
                start_new_session=True  # Detach from parent
            )

        # Wait for server to be ready (up to 45 seconds for model loading)
        # Model loading can take 20-30 seconds on first start
        log("Waiting for server to load model (this may take 20-30 seconds)...")
        for i in range(90):  # 90 * 0.5s = 45 seconds max
            time.sleep(0.5)
            if is_server_running():
                log(f"Server started successfully (took {(i+1)*0.5:.1f}s)")
                return True
            # Log progress every 5 seconds so user knows it's working
            if (i + 1) % 10 == 0:
                log(f"Still waiting for server... ({(i+1)*0.5:.0f}s elapsed)")

        log("Server failed to start (timeout after 45s)", "ERROR")
        return False

    except Exception as e:
        log(f"Failed to start server: {e}", "ERROR")
        return False


def session_language(setting):
    """The language code for the `language` setting, as the extension computes it."""
    if setting == "system":
        return (os.environ.get("LANG") or "en_GB.UTF-8").split("_")[0]
    return setting


def server_wanted_at_login():
    """True if Settings ask for the server at login: streaming on, server mode, key on."""
    return (read_setting("streaming-mode") == "true"
            and read_setting("streaming-startup-mode") == "server"
            and read_setting("server-start-at-login") == "true")


def run_server_at_login():
    """ExecStart of wsi-stream-server-at-login.service: become the server, if wanted.

    Exits 0 and starts nothing unless server_wanted_at_login(), or if a server is
    already running or loading (an Insert got there first). Otherwise replaces this
    process with the server, so the unit's main process is the server itself and
    systemd sees its exit status. Diagnostics go to stderr (the journal).
    """
    if not server_wanted_at_login():
        print("wsi-stream: start at login is off, or streaming is not in server mode; "
              "not starting the server", file=sys.stderr)
        return 0
    if is_server_running() or server_pid_alive():
        print("wsi-stream: the server is already running; not starting another",
              file=sys.stderr)
        return 0
    # No extension launched this process, so the Settings are read for what the
    # extension would pass on an Insert: the language code and the Whisper Model
    language = session_language(read_setting("language"))
    model = resolve_model("streaming", language, setting=read_setting("whisper-model"))
    cmd = server_command(model, language, read_server_idle_timeout())
    print(f"wsi-stream: starting the server: {' '.join(cmd)}", file=sys.stderr)
    sys.stderr.flush()
    os.execv(cmd[0], cmd)


def send_server_command(command, params=None):
    """Send one command to the server; its one-line JSON reply, or status "error".

    The reply is read to its newline: a long dictation's text is far larger than one
    read, and a reply cut short would not parse.
    """
    if params is None:
        params = {}

    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.settimeout(SERVER_REPLY_TIMEOUT)
            sock.connect(str(SERVER_SOCKET))
            sock.sendall((json.dumps({"command": command, "params": params}) + "\n").encode())
            reply = b""
            while not reply.endswith(b"\n"):
                chunk = sock.recv(65536)
                if not chunk:
                    break
                reply += chunk
        return json.loads(reply.decode())

    except (OSError, ValueError) as e:
        log(f"Server command {command} failed: {e}", "ERROR")
        return {"status": "error", "message": f"{command}: {e}"}


def dictation_limits(args):
    """START's limits: continuous dictation's from Settings, else the fixed --timeout cap.

    Raises if a setting cannot be read. Returns (continuous, max_seconds, silence_seconds).
    """
    continuous = read_setting("continuous-dictation") == "true"
    if not continuous:
        return False, args.timeout, 0
    minutes = read_setting("max-recording-minutes")
    silence = read_setting("silence-autostop-seconds")
    if not minutes.isdigit() or int(minutes) < 1:
        raise RuntimeError(f"max-recording-minutes is not a whole number above 0: '{minutes}'")
    if not silence.isdigit():
        raise RuntimeError(f"silence-autostop-seconds is not a whole number: '{silence}'")
    return True, int(minutes) * 60, int(silence)


def relay_progress(progress):
    """Hand the panel the dictation's elapsed time and backlog (the Progress signal)."""
    rtf = progress.get("rtf")
    behind = 1 if rtf is not None and rtf > 1 else 0
    emit_dbus_text("Progress", (
        f"elapsed={progress.get('elapsed_seconds', 0):.0f} "
        f"pending={progress.get('segments_pending', 0)} "
        f"backlog={progress.get('backlog_seconds', 0):.0f} behind={behind}"))


def report_failed_dictation(progress):
    """FAILED: the text so far goes to the clipboard (never pasted), and the user is told."""
    text = (progress.get("transcription") or "").strip()
    error = progress.get("error") or "unknown error"
    lines = [f"Dictation failed: {error}"]
    if text and copy_to_clipboard(text, use_clipboard=True):
        lines.append(f"The text so far ({len(text.split())} words) is on the clipboard: Ctrl+V.")
    elif text:
        lines.append("The text so far could not be copied to the clipboard; "
                     f"it is in {progress.get('session_dir')}/journal.jsonl")
    else:
        lines.append("No text had been transcribed yet.")
    if progress.get("kept_audio"):
        lines.append(f"Untranscribed audio kept in {progress.get('session_dir')}")
    for unsaved in progress.get("unsaved_audio") or []:
        lines.append(f"Audio NOT kept: {unsaved}")
    message = "\n".join(lines)
    log(message, "ERROR")
    print(f"wsi-stream: {message}", file=sys.stderr)
    emit_dbus_text("Error", error)
    emit_dbus_signal("StateChanged", "ERROR")
    desktop_notification(message, 0)  # 0: stays until dismissed


def run_server_mode(args):
    """Run in server mode - use persistent server for instant startup."""
    global debug_mode, no_notify

    debug_mode = args.debug
    no_notify = args.no_notify

    if debug_mode:
        LOG_DIR.mkdir(parents=True, exist_ok=True)
        LOG_FILE.write_text("")  # Fresh log each session

    log("=== Server mode requested ===")

    try:
        stop = GracefulStop(read_stop_grace())
    except Exception as e:
        log(f"Cannot read the stop grace: {e}", "ERROR")
        notify("ERROR", "Cannot read the stop grace (re-run play-speech-to-text.yml)")
        return 1

    try:
        continuous, max_seconds, silence_seconds = dictation_limits(args)
    except Exception as e:
        log(f"Cannot read the dictation limits: {e}", "ERROR")
        notify("ERROR", "Cannot read the dictation settings (re-run play-speech-to-text.yml)")
        return 1
    log(f"Continuous dictation: {continuous}; limit {max_seconds} s; "
        f"no-speech stop {silence_seconds or 'off'}")

    # Track whether recording is active (for cleanup)
    recording_active = False
    cleanup_done = False

    def ensure_stop_sent():
        """Ensure STOP command is sent to server - called on exit or signal."""
        nonlocal cleanup_done
        if cleanup_done:
            return
        cleanup_done = True

        if recording_active:
            log("Cleanup: Sending STOP to server")
            try:
                send_server_command("STOP")
                log("Cleanup: STOP sent successfully")
            except Exception as e:
                log(f"Cleanup: Failed to send STOP: {e}", "ERROR")

        # Clean up PID file
        if PID_FILE.exists():
            try:
                PID_FILE.unlink()
            except Exception:
                pass

        # Send IDLE signal to extension
        try:
            emit_dbus_signal("StateChanged", "IDLE")
        except Exception:
            pass

    # Register cleanup function to run on ANY exit (normal or abnormal)
    atexit.register(ensure_stop_sent)

    # The model is resolved only if the server has to be started
    language = args.language or os.environ.get("WHISPER_LANGUAGE", "en") or "en"

    # Write the PID file before a cold server start (20-30s). Without it, an Insert press
    # during PREPARING falls through to the extension's pkill fallback, and the default
    # SIGTERM disposition kills this process without atexit — no IDLE is ever emitted,
    # leaving the extension wedged in PREPARING until logout.
    PID_FILE.write_text(str(os.getpid()))

    def abort_startup(signum, frame):
        log(f"Signal {signum} received during server startup, aborting")
        raise SystemExit(1)  # runs atexit cleanup: PID file removed, IDLE emitted

    signal.signal(signal.SIGINT, abort_startup)
    signal.signal(signal.SIGTERM, abort_startup)
    signal.signal(signal.SIGUSR1, abort_startup)

    # Start server if not running (detached: it keeps loading if we are aborted)
    if not is_server_running():
        notify("PREPARING", "Starting server...")
        try:
            started = start_server(language)
        except Exception as e:
            log(f"Cannot start the server: {e}", "ERROR")
            notify("ERROR", f"Cannot start the server: {e}")
            return 1
        if not started:
            notify("ERROR", "Failed to start server")
            return 1

    log("Server ready - instant recording startup!")

    # From here a stop is a graceful request: the loop below sends STOP once it is due
    # (SIGTERM after the grace). SIGUSR1 is the extension's abort (Escape): ABORT the
    # session at once so the server releases the mic and discards the text. SIGKILLing
    # this client instead would leave the server recording until the KEEPALIVEs are
    # missed, refusing every START in the meantime.
    install_stop_handlers(stop, abort_on_usr1=True)

    # Start recording via server
    notify("RECORDING", "Recording... (server mode)")

    response = send_server_command("START", {
        "continuous": continuous, "max_seconds": max_seconds, "silence_seconds": silence_seconds})

    if response.get("status") != "recording":
        log(f"Server START failed: {response}", "ERROR")
        notify("ERROR", f"Failed to start recording: {response.get('message', response)}")
        if PID_FILE.exists():
            PID_FILE.unlink()
        return 1

    log(f"Recording active (server mode); journal in {response.get('session_dir')}")
    recording_active = True  # Mark as active for cleanup

    # Until the stop is due: KEEPALIVE so the server knows we are here, PROGRESS for the
    # panel. The server applies the limits itself and may stop (or fail) on its own.
    progress = {"status": "recording"}
    last_keepalive = last_progress = time.monotonic()
    while not stop.due() and progress.get("status") == "recording":
        announce_pending_stop(stop)
        now = time.monotonic()
        if now - last_keepalive >= KEEPALIVE_INTERVAL:
            reply = send_server_command("KEEPALIVE")
            last_keepalive = now
            if reply.get("status") == "error":
                progress = reply
        if progress.get("status") == "recording" and now - last_progress >= PROGRESS_INTERVAL:
            progress = send_server_command("PROGRESS")
            last_progress = now
            if progress.get("status") == "recording":
                relay_progress(progress)
        time.sleep(0.1)

    if stop.discard:
        reply = send_server_command("ABORT")
        recording_active = False
        log(f"Recording discarded (abort): {reply}")
        return 0

    # INSTANT VISUAL FEEDBACK: Change to spinner IMMEDIATELY
    # This happens BEFORE server cleanup, so user sees instant response to Insert key
    emit_dbus_signal("StateChanged", "TRANSCRIBING")

    # STOP closes the microphone (or, if the server stopped on its own, just reports);
    # the segments still queued are then transcribed while we poll
    if progress.get("status") == "recording":
        log("Stop due, sending STOP")
        progress = send_server_command("STOP")
    else:
        log(f"The server ended the recording itself: {progress}")
    recording_active = False

    # The PID file stays until exit (atexit removes it): the extension treats a missing
    # PID file as "no recorder", and transcription + paste are still to come.
    give_up_at = None
    while progress.get("status") == "draining":
        relay_progress(progress)
        if give_up_at is None:
            give_up_at = (time.monotonic() + progress.get("drain_seconds_left", 0)
                          + DRAIN_GRACE_SECONDS)
        if time.monotonic() > give_up_at:
            progress = {"status": "error", "message": "the server never finished transcribing"}
            break
        time.sleep(DRAIN_POLL_INTERVAL)
        progress = send_server_command("PROGRESS")

    if progress.get("status") == "failed":
        report_failed_dictation(progress)
        return 1
    if progress.get("status") != "done":
        log(f"Server STOP failed: {progress}", "ERROR")
        message = (f"{progress.get('message', progress)}. Any text transcribed so far is in "
                   f"{response.get('session_dir')}/journal.jsonl")
        print(f"wsi-stream: the dictation did not complete: {message}", file=sys.stderr)
        emit_dbus_signal("StateChanged", "ERROR")
        desktop_notification(f"Failed to finish the dictation: {message}", 0)
        return 1

    text = progress.get("transcription", "").strip()
    stop_reason = progress.get("stop_reason") or ""
    notes = []
    if stop_reason and stop_reason != "stop requested":
        notes.append(f"Stopped: {stop_reason}")
    if progress.get("empty_segments"):
        notes.append(f"{progress['empty_segments']} segment(s) with speech produced no text; "
                     f"their audio is in {progress.get('session_dir')}")
    for note in notes:
        log(note, "WARN")
        desktop_notification(note, 0)

    if not text:
        log("No speech detected", "WARN")
        notify("ERROR", "No speech detected")
        return 1

    # Capitalize first letter
    text = text[0].upper() + text[1:] if len(text) > 1 else text.upper()

    # Post-process through Claude Code if requested
    if args.claude_process:
        text = run_claude_processing(text, args)

    # Wrap with marker if requested
    if args.wrap_marker and not args.claude_process:
        text = f'speech-to-text:"{text}"'

    log(f"Final text ({len(text)} chars): {text}")

    # Save to last-transcription file
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    TRANSCRIPTION_FILE.write_text(text)

    # Output
    if args.auto_paste:
        log("Auto-pasting")
        time.sleep(0.2)
        success = auto_paste(text, skip_enter=args.no_auto_enter, paste_with_shift=args.paste_with_shift)
        if success:
            preview = text[:60] + "..." if len(text) > 60 else text
            notify("SUCCESS", preview)
        else:
            notify("ERROR", "Auto-paste failed")
            return 1
    else:
        log("Copying to clipboard")
        if copy_to_clipboard(text, use_clipboard=args.clipboard):
            preview = text[:60] + "..." if len(text) > 60 else text
            paste_hint = "Ctrl+V" if args.clipboard else "Middle-click"
            notify("SUCCESS", f"{preview}\n\n{paste_hint} to paste")
        else:
            notify("ERROR", "Clipboard copy failed")
            return 1

    # Send IDLE to clear the spinner and return to normal state
    time.sleep(1)
    emit_dbus_signal("StateChanged", "IDLE")

    log("Server mode recording complete!")
    return 0


def run_streaming(args):
    """Main streaming transcription."""
    global debug_mode, no_notify, stop_requested, recorder, current_text
    debug_mode = args.debug
    no_notify = args.no_notify
    stop_requested = False
    current_text = ""

    if debug_mode:
        LOG_DIR.mkdir(parents=True, exist_ok=True)
        LOG_FILE.write_text("")  # Fresh log each session

    log(f"Starting streaming transcription (pre-buffer: {args.pre_buffer})...")

    try:
        stop = GracefulStop(read_stop_grace())
    except Exception as e:
        log(f"Cannot read the stop grace: {e}", "ERROR")
        notify("ERROR", "Cannot read the stop grace (re-run play-speech-to-text.yml)")
        return 1

    # Route to appropriate implementation
    if args.pre_buffer:
        return run_prebuffered_streaming(args, stop)
    else:
        return run_standard_streaming(args, stop)


def run_standard_streaming(args, stop):
    """Standard streaming mode - RealtimeSTT manages audio."""
    global debug_mode, no_notify, stop_requested, recorder, current_text

    if not check_dependencies():
        return 1

    from RealtimeSTT import AudioToTextRecorder
    import threading

    # Write PID file
    PID_FILE.write_text(str(os.getpid()))
    log(f"PID file written: {PID_FILE}")

    # Clear buffer file
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    BUFFER_FILE.write_text("")

    # Language from arg, then env, then default to English
    language = args.language or os.environ.get("WHISPER_LANGUAGE", "en") or None
    model_size = resolve_model("streaming", language)
    log(f"Using model: {model_size}, language: {language or 'auto-detect'}")

    final_text = ""
    recorder_error = None
    recording_done = threading.Event()

    def recording_thread():
        """Run recorder in thread so main thread can handle signals."""
        nonlocal final_text, recorder_error
        try:
            # Blocks until stop() or shutdown() is called
            final_text = recorder.text()
            log(f"Final from recorder: {final_text}")
        except Exception as e:
            recorder_error = e
            log(f"Recorder thread error: {e}", "ERROR")
        finally:
            recording_done.set()

    # SIGTERM starts the grace, SIGINT stops now; the wait loop below calls
    # recorder.stop() once the stop is due. recording_done is left to the
    # recording thread, set after recorder.text() returns with the final
    # transcription: setting it on stop raced ahead of the last audio chunk.
    install_stop_handlers(stop)

    try:
        # Signal PREPARING state (orange icon) while initializing
        notify("PREPARING", "Loading model...")

        recorder_config = {
            "model": model_size,
            "language": language,
            "silero_sensitivity": 0.4,
            # Very long silence duration - manual stop via signal
            "post_speech_silence_duration": 300.0,
            "min_length_of_recording": 0.3,
            "min_gap_between_recordings": 0.1,
            # Real-time transcription streams to buffer file
            "enable_realtime_transcription": True,
            "realtime_processing_pause": 0.2,
            "on_realtime_transcription_update": on_realtime_update,
            "spinner": False,
        }

        # Request GPU - let AudioToTextRecorder handle fallback internally
        recorder_config["device"] = "cuda"
        recorder_config["compute_type"] = "float16"
        log("Requesting GPU (CUDA)")

        recorder = AudioToTextRecorder(**recorder_config)
        log("Recorder initialized, waiting for audio pipeline...")

        # Notify user that model is loaded, now initializing audio
        notify("PREPARING", "Initializing audio...")

        # Brief delay to let microphone and audio pipeline fully initialize
        # RealtimeSTT needs time to open audio device and start processing
        time.sleep(0.5)
        log("Audio pipeline ready, starting recording")

        # Now signal RECORDING state (red icon + countdown)
        notify("RECORDING", "Recording... (transcribing live)")

        # Start recording in thread
        rec_thread = threading.Thread(target=recording_thread, daemon=True)
        rec_thread.start()

        # Wait for completion, a due stop, or the timeout (main thread handles signals)
        timeout = args.timeout
        give_up_at = time.monotonic() + timeout
        while (not recording_done.is_set() and not stop.due()
               and time.monotonic() < give_up_at):
            announce_pending_stop(stop)
            recording_done.wait(timeout=0.1)

        # Stop due: stop the recorder, then give the recording thread a few
        # more seconds for the final transcription
        if stop.due() and not recording_done.is_set():
            stop_requested = True
            try:
                recorder.stop()
                log("Called recorder.stop()")
            except Exception as e:
                log(f"stop() failed: {e}", "WARN")
            log("Waiting for final transcription after stop...")
            recording_done.wait(timeout=5)

        if not recording_done.is_set():
            log(f"Timeout after {timeout}s, stopping gracefully...")
            stop_requested = True
            if recorder:
                try:
                    # First try graceful stop to get final transcription
                    recorder.stop()
                    log("Called recorder.stop() on timeout")
                except Exception as e:
                    log(f"Warning: recorder.stop() failed: {e}")

                # Wait for final transcription
                recording_done.wait(timeout=3)

                # Only abort if stop didn't work
                if not recording_done.is_set():
                    log("Graceful stop failed, aborting...")
                    try:
                        recorder.abort()
                    except Exception:
                        pass
                    try:
                        recorder.shutdown()
                    except Exception:
                        pass
                    # Give thread a moment to finish
                    recording_done.wait(timeout=2)

        # Only raise error if it wasn't a user-requested stop
        if recorder_error and not stop_requested:
            raise recorder_error
        elif recorder_error:
            log(f"Recorder error during stop (expected): {recorder_error}")

    except Exception as e:
        log(f"Recording error: {e}", "ERROR")
        notify("ERROR", f"Recording failed: {e}")
        return 1
    finally:
        if PID_FILE.exists():
            PID_FILE.unlink()
        # Ensure recorder is fully cleaned up - RealtimeSTT can leak audio resources
        if recorder:
            try:
                recorder.abort()
            except Exception:
                pass
            try:
                recorder.stop()
            except Exception:
                pass
            try:
                recorder.shutdown()
            except Exception:
                pass
            # Force garbage collection to release audio resources
            del recorder
            recorder = None
            import gc
            gc.collect()
            log("Recorder cleanup complete")
        # Always send IDLE signal on cleanup so extension resets
        emit_dbus_signal("StateChanged", "IDLE")
        log("Sent IDLE signal")

    # Use final text from recorder, fall back to buffer if empty
    if final_text and final_text.strip():
        text = final_text.strip()
    elif current_text:
        text = current_text
        log("Using buffered text (recorder returned empty)")
    else:
        # Try reading from buffer file as last resort
        try:
            text = BUFFER_FILE.read_text().strip()
            log("Using text from buffer file")
        except Exception:
            text = ""

    if not text:
        log("No speech detected", "WARN")
        notify("ERROR", "No speech detected")
        # Cleanup buffer
        if BUFFER_FILE.exists():
            BUFFER_FILE.unlink()
        return 1

    # Capitalize first letter
    text = text[0].upper() + text[1:] if len(text) > 1 else text.upper()

    # Post-process through Claude Code if requested
    if args.claude_process:
        text = run_claude_processing(text, args)

    # Wrap with marker if requested
    # BUT: Don't wrap Claude-processed text - it's already clean and formatted
    if args.wrap_marker and not args.claude_process:
        text = f'speech-to-text:"{text}"'
        log(f"Wrapped: {text}")
    elif args.wrap_marker and args.claude_process:
        log("Skipping marker wrap - Claude processed text is already clean")

    log(f"Final text ({len(text)} chars): {text}")

    # Save to last-transcription file
    TRANSCRIPTION_FILE.write_text(text)

    # Cleanup buffer file
    if BUFFER_FILE.exists():
        BUFFER_FILE.unlink()

    # Output - instant because transcription already done!
    if args.auto_paste:
        log("Auto-pasting (instant - transcription was real-time)")
        # Small delay to ensure any focus changes from recorder shutdown settle
        time.sleep(0.2)
        success = auto_paste(text, skip_enter=args.no_auto_enter, paste_with_shift=args.paste_with_shift)
        if success:
            preview = text[:60] + "..." if len(text) > 60 else text
            notify("SUCCESS", preview)
        else:
            notify("ERROR", "Auto-paste failed")
            return 1
    else:
        log("Copying to clipboard (instant - transcription was real-time)")
        if copy_to_clipboard(text, use_clipboard=args.clipboard):
            preview = text[:60] + "..." if len(text) > 60 else text
            paste_hint = "Ctrl+V" if args.clipboard else "Middle-click"
            notify("SUCCESS", f"{preview}\n\n{paste_hint} to paste")
        else:
            notify("ERROR", "Clipboard copy failed")
            return 1

    time.sleep(1)
    emit_dbus_signal("StateChanged", "IDLE")

    log("Streaming complete - paste was instant!")
    return 0


def run_prebuffered_streaming(args, stop):
    """
    Pre-buffered streaming mode - starts audio capture immediately while model loads.
    Provides instant startup by recording audio to buffer during model initialization.
    """
    global debug_mode, no_notify, stop_requested, recorder, current_text

    if not check_dependencies():
        return 1

    from RealtimeSTT import AudioToTextRecorder
    import threading
    import array

    # Without handlers SIGTERM's default action killed this process outright: no
    # paste, no IDLE. Installed before the PID file names us as the recorder.
    install_stop_handlers(stop)

    # Write PID file (use main process PID)
    PID_FILE.write_text(str(os.getpid()))
    log(f"PID file written: {PID_FILE}")

    # Clear buffer file
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    BUFFER_FILE.write_text("")

    # The model is resolved in the loading thread, so the microphone opens first
    language = args.language or os.environ.get("WHISPER_LANGUAGE", "en") or None

    # Start audio recording IMMEDIATELY (before model loads!)
    notify("PREPARING", "Starting recorder...")
    log("Starting pw-record immediately (pre-buffering enabled)")

    try:
        # Start pw-record to stdout pipe: 16000 Hz, mono, S16_LE format
        # This is the format RealtimeSTT expects for feed_audio()
        pw_record_cmd = [
            "pw-record",
            "--rate", "16000",
            "--channels", "1",
            "--format", "s16",
            "-"  # Output to stdout
        ]

        audio_process = subprocess.Popen(
            pw_record_cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL if not debug_mode else None
        )
        log(f"pw-record started with PID {audio_process.pid}")

        # Audio buffer for chunks captured while model loads
        audio_buffer = []
        chunk_size = 1024 * 2  # 1024 samples * 2 bytes per sample (S16_LE)
        model_ready = threading.Event()
        model_error = None

        def load_model_thread():
            """Load Whisper model in background thread."""
            global recorder
            nonlocal model_error
            try:
                notify("PREPARING", "Loading model...")
                model_size = resolve_model("streaming", language)
                log(f"Loading model {model_size} (language: {language or 'auto-detect'}) "
                    "in background thread...")

                recorder_config = {
                    "model": model_size,
                    "language": language,
                    "use_microphone": False,  # We'll feed audio manually
                    "silero_sensitivity": 0.4,
                    "enable_realtime_transcription": True,
                    "realtime_processing_pause": 0.2,
                    "on_realtime_transcription_update": on_realtime_update,
                    "spinner": False,
                }

                # Request GPU - let AudioToTextRecorder handle fallback internally
                recorder_config["device"] = "cuda"
                recorder_config["compute_type"] = "float16"
                log("Requesting GPU (CUDA)")

                recorder = AudioToTextRecorder(**recorder_config)
                log("Model loaded successfully!")
                model_ready.set()
            except Exception as e:
                model_error = e
                log(f"Model loading error: {e}", "ERROR")
                model_ready.set()

        # Start model loading in background
        model_thread = threading.Thread(target=load_model_thread, daemon=True)
        model_thread.start()

        # Buffer audio chunks while model loads, until the model is ready or a stop
        # is due - a stop pressed during the load closes the microphone now, not
        # when the model finishes loading
        log("Buffering audio while model loads...")
        while not model_ready.is_set() and not stop.due():
            announce_pending_stop(stop)
            try:
                chunk = audio_process.stdout.read(chunk_size)
                if not chunk:
                    break
                audio_buffer.append(chunk)
                if len(audio_buffer) % 10 == 0:
                    log(f"Buffered {len(audio_buffer)} chunks ({len(audio_buffer) * chunk_size / 16000:.1f}s)")
            except Exception as e:
                log(f"Buffering error: {e}", "WARN")
                break

        # Stopped during the load: close the microphone and keep what it captured,
        # then wait for the model to transcribe exactly that
        stopped_while_loading = stop.due() and not model_ready.is_set()
        if stopped_while_loading:
            announce_pending_stop(stop)
            log("Stop due while the model loads - closing the microphone")
            stop_requested = True
            read_remaining_audio(audio_process, chunk_size, audio_buffer.append)
            model_ready.wait()

        # Check if model loaded successfully
        if model_error:
            raise model_error

        if not recorder:
            raise RuntimeError("Model failed to load")

        log(f"Model ready! Buffered {len(audio_buffer)} chunks ({len(audio_buffer) * chunk_size / 16000:.2f}s)")
        if stopped_while_loading:
            notify("TRANSCRIBING", "Transcribing what was recorded...")
        else:
            notify("RECORDING", "Recording... (transcribing live)")

        # Start the recorder so realtime worker processes audio (sets is_recording=True)
        recorder.start()
        log("Recorder started (realtime transcription active)")

        # Feed every buffered chunk: the buffering loop ended at the model load or at
        # a due stop, so all of it was captured before the microphone closed
        log("Feeding buffered audio to model...")
        for i, chunk in enumerate(audio_buffer):
            # Convert bytes to numpy-like array that RealtimeSTT expects
            audio_array = array.array('h', chunk)  # 'h' = signed short (int16)
            recorder.feed_audio(audio_array)
            if (i + 1) % 20 == 0:
                log(f"Fed {i + 1}/{len(audio_buffer)} buffered chunks")

        audio_buffer.clear()  # Free memory
        log("All buffered audio fed to model")

        # Continue feeding real-time audio until stop (unless it already came)
        log("Feeding real-time audio...")
        timeout_time = time.time() + args.timeout
        while not stopped_while_loading and not stop.due() and time.time() < timeout_time:
            announce_pending_stop(stop)
            try:
                chunk = audio_process.stdout.read(chunk_size)
                if not chunk:
                    log("Audio stream ended")
                    break
                audio_array = array.array('h', chunk)
                recorder.feed_audio(audio_array)
            except Exception as e:
                log(f"Real-time feed error: {e}", "WARN")
                break

        # Stop recording
        log("Stopping audio capture...")
        stop_requested = True

        # Stop pw-record and feed what it had already captured, then let the
        # realtime worker transcribe that tail before recorder.stop() freezes the text
        if not stopped_while_loading:
            read_remaining_audio(audio_process, chunk_size, recorder.feed_audio)
        wait_for_final_realtime_passes(realtime_updates)

        # Get final transcription
        # In prebuffered mode with use_microphone=False, recorder.text() would block
        # forever waiting for audio. The realtime callbacks have already captured
        # the transcription in current_text, so we use that directly.
        log("Getting final transcription...")
        notify("TRANSCRIBING", "Finalizing transcription...")

        try:
            recorder.stop()
            # Use current_text from realtime callbacks - don't call recorder.text()
            # as it blocks indefinitely with use_microphone=False
            final_text = current_text
            log(f"Final text from realtime callbacks: {final_text}")
        except Exception as e:
            log(f"Transcription error: {e}", "ERROR")
            final_text = current_text

        # Cleanup
        if PID_FILE.exists():
            PID_FILE.unlink()

        recorder.shutdown()
        recorder = None

        # Process final text (same as standard mode)
        if not final_text and current_text:
            final_text = current_text
            log("Using buffered text (recorder returned empty)")

        text = final_text.strip() if final_text else ""

        if not text:
            log("No speech detected", "WARN")
            notify("ERROR", "No speech detected")
            if BUFFER_FILE.exists():
                BUFFER_FILE.unlink()
            return 1

        # Capitalize first letter
        text = text[0].upper() + text[1:] if len(text) > 1 else text.upper()

        # Post-process through Claude Code if requested
        if args.claude_process:
            text = run_claude_processing(text, args)

        # Wrap with marker if requested
        # BUT: Don't wrap Claude-processed text - it's already clean and formatted
        if args.wrap_marker and not args.claude_process:
            text = f'speech-to-text:"{text}"'
            log(f"Wrapped: {text}")
        elif args.wrap_marker and args.claude_process:
            log("Skipping marker wrap - Claude processed text is already clean")

        log(f"Final text ({len(text)} chars): {text}")

        # Save to last-transcription file
        TRANSCRIPTION_FILE.write_text(text)

        # Cleanup buffer file
        if BUFFER_FILE.exists():
            BUFFER_FILE.unlink()

        # Output
        if args.auto_paste:
            log("Auto-pasting (instant - transcription was real-time)")
            time.sleep(0.2)
            success = auto_paste(text, skip_enter=args.no_auto_enter, paste_with_shift=args.paste_with_shift)
            if success:
                preview = text[:60] + "..." if len(text) > 60 else text
                notify("SUCCESS", preview)
            else:
                notify("ERROR", "Auto-paste failed")
                return 1
        else:
            log("Copying to clipboard (instant - transcription was real-time)")
            if copy_to_clipboard(text, use_clipboard=args.clipboard):
                preview = text[:60] + "..." if len(text) > 60 else text
                paste_hint = "Ctrl+V" if args.clipboard else "Middle-click"
                notify("SUCCESS", f"{preview}\n\n{paste_hint} to paste")
            else:
                notify("ERROR", "Clipboard copy failed")
                return 1

        time.sleep(1)
        emit_dbus_signal("StateChanged", "IDLE")

        log("Pre-buffered streaming complete!")
        return 0

    except Exception as e:
        log(f"Pre-buffer streaming error: {e}", "ERROR")
        notify("ERROR", f"Recording failed: {e}")

        # Cleanup
        if 'audio_process' in locals() and audio_process:
            try:
                audio_process.kill()
            except Exception:
                pass
        if PID_FILE.exists():
            PID_FILE.unlink()
        if recorder:
            try:
                recorder.shutdown()
            except Exception:
                pass

        emit_dbus_signal("StateChanged", "IDLE")
        return 1


def main():
    global debug_mode
    parser = argparse.ArgumentParser(
        description="Streaming speech-to-text with real-time transcription"
    )
    parser.add_argument("-d", "--debug", action="store_true",
                        help="Enable debug logging")
    parser.add_argument("-c", "--clipboard", action="store_true",
                        help="Use CLIPBOARD instead of PRIMARY selection")
    parser.add_argument("-a", "--auto-paste", action="store_true",
                        help="Auto-paste at cursor position")
    parser.add_argument("--no-auto-enter", action="store_true",
                        help="Skip Enter key after auto-paste")
    parser.add_argument("-w", "--wrap-marker", action="store_true",
                        help="Wrap text with speech-to-text:\"...\"")
    parser.add_argument("-l", "--language", type=str, default=None,
                        help="Language code for transcription (e.g., 'en')")
    parser.add_argument("--timeout", type=int, default=STREAMING_MAX_SECONDS,
                        help="Maximum recording time in seconds, for every streaming mode "
                             "except continuous dictation, whose limits are in Settings "
                             f"(default: {STREAMING_MAX_SECONDS})")
    parser.add_argument("--no-notify", action="store_true",
                        help="Suppress desktop notifications")
    parser.add_argument("--pre-buffer", action="store_true",
                        help="Start recording immediately while model loads (faster startup)")
    parser.add_argument("--server-mode", action="store_true",
                        help="Use persistent server for instant startup (keeps model in memory)")
    parser.add_argument("--claude-process", action="store_true",
                        help="Post-process transcription through Claude Code")
    parser.add_argument("--claude-model", type=str, default="sonnet",
                        help="Claude model for processing (sonnet/opus/haiku)")
    parser.add_argument("--claude-style", type=str, default="corporate",
                        help="Claude processing style (corporate/natural)")
    parser.add_argument("--paste-with-shift", type=int, default=1,
                        help="Paste key: 1=Ctrl+Shift+V (terminals), 0=Ctrl+V (browsers/GUI apps)")
    parser.add_argument("--server-at-login", action="store_true",
                        help="Become the persistent server if Settings ask for it at login "
                             "(run by wsi-stream-server-at-login.service; records nothing)")

    args = parser.parse_args()

    # Before atexit: this path records nothing, and the recorder's exit cleanup would
    # remove the PID file of a recording in progress
    if args.server_at_login:
        debug_mode = args.debug
        return run_server_at_login()

    # Registered here rather than at import, so loading this file for its unit tests
    # emits no D-Bus signal on exit
    atexit.register(cleanup_on_exit)

    try:
        # Route to server mode if requested
        if args.server_mode:
            return run_server_mode(args)
        else:
            return run_streaming(args)
    except Exception as e:
        # Ensure critical errors are ALWAYS logged, even without debug mode
        debug_mode = True  # Force logging for crash reports
        log(f"FATAL ERROR: {e}", "CRITICAL")
        import traceback
        log(traceback.format_exc(), "CRITICAL")
        notify("ERROR", f"Script crashed: {e}")
        return 1


if __name__ == "__main__":
    sys.exit(main())
