#!/usr/bin/env bash
# scp-with-password — scp files using password auth only, offering no keys
#
# Forces interactive password (or keyboard-interactive) authentication and
# suppresses every public-key path: no keys from ~/.ssh, no keys from the
# running ssh-agent, no host-based auth. The scp companion to
# ssh-with-password — useful when a key would otherwise be offered/accepted
# but you specifically want to authenticate with a password (e.g. first-time
# provisioning, a shared account, or testing password login).
#
# Usage:
#   scp-with-password [scp-args...] SRC DEST
#   scp-with-password file.txt admin@host.example.com:/tmp/
#   scp-with-password -P 2222 admin@host.example.com:/etc/motd ./motd
#
# All arguments are passed straight through to scp, after the key-disabling
# options — so you can still add -P, -r, -p, etc.
#
# Note: scp uses -P (uppercase) for the port, unlike ssh's -p.
#
# Agent forwarding: pass -A (or -o ForwardAgent=yes) and the local ssh-agent is
# forwarded to the remote host. Forwarding needs a live agent socket, so when -A
# is requested we do NOT set IdentityAgent=none — auth to THIS host still stays
# password-only because PubkeyAuthentication=no blocks every key regardless.
set -euo pipefail

if [ "$#" -eq 0 ] || [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    echo "Usage: scp-with-password [scp-args...] SRC DEST"
    echo ""
    echo "  scp using password authentication only — offers no public keys."
    echo "  All arguments are forwarded to scp."
    echo ""
    echo "Examples:"
    echo "  scp-with-password file.txt admin@host.example.com:/tmp/"
    echo "  scp-with-password -P 2222 admin@host.example.com:/etc/motd ./motd"
    echo ""
    echo "Note: scp uses -P (uppercase) for the port."
    [ "$#" -eq 0 ] && exit 1
    exit 0
fi

# Detect a request to forward the agent: a short-flag cluster containing A
# (-A, -Ar, …) or an explicit -o ForwardAgent=yes.
forward_agent=0
for arg in "$@"; do
    if [[ "$arg" == -[!-]* && "$arg" == *A* ]] || [[ "$arg" == "ForwardAgent=yes" ]]; then
        forward_agent=1
        break
    fi
done

# PreferredAuthentications  — only ever try password / keyboard-interactive
# PubkeyAuthentication=no   — never attempt public-key auth
# IdentitiesOnly=yes        — ignore identities not given explicitly (none here)
opts=(
    -o PreferredAuthentications=password,keyboard-interactive
    -o PubkeyAuthentication=no
    -o IdentitiesOnly=yes
)
# IdentityAgent=none — do not consult the ssh-agent for keys. Skipped when the
# agent is being forwarded (-A), since forwarding needs the agent socket alive.
if [ "$forward_agent" -eq 0 ]; then
    opts+=(-o IdentityAgent=none)
fi

exec scp "${opts[@]}" "$@"
