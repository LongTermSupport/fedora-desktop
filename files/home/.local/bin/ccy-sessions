#!/usr/bin/env bash
# ccy-sessions — see every CCY session, return to a parked one, or end one.
#
# CCY runs each interactive session inside tmux on its own server (see
# docs/ccy.md "Sessions Survive the Terminal"), so a session outlives the terminal that
# showed it. This is the human way back to those sessions: a numbered list, a number to
# attach, no tmux syntax to remember. `ccy` itself offers to re-attach when run in the
# project directory; this is for when you do not remember which project, or want to see
# everything at once.
#
# A session can be attached from ONE terminal only. One that is open elsewhere is shown
# as such and cannot be selected — the tmux server enforces the same rule, so even a race
# cannot mirror one claude into two terminals.
#
# Usage:
#   ccy-sessions            the menu
#   ccy-sessions -h|--help  this text
#
# Needs a terminal. Runs on the HOST: inside a CCY container there is no tmux server.
set -euo pipefail

CCY_LIB="/var/local/claude-yolo/lib"
MAX_TRIES=3

usage() {
    sed -n '2,19p' "${BASH_SOURCE[0]}" | cut -c3-
}

case "${1:-}" in
"") ;;
-h | --help)
    usage
    exit 0
    ;;
*)
    echo "ccy-sessions: unknown option '${1}'. See ccy-sessions --help." >&2
    exit 64
    ;;
esac

if [[ ! -t 0 || ! -t 1 ]]; then
    echo "ccy-sessions needs a terminal: it attaches sessions to the one you are in." >&2
    exit 1
fi
if [[ ! -f "${CCY_LIB}/tmux-session.bash" ]]; then
    if [[ -d /workspace ]]; then
        echo "ccy-sessions runs on the host, not inside a CCY container." >&2
    else
        echo "CCY is not installed here (${CCY_LIB}/tmux-session.bash missing). Run playbooks/imports/play-claude-yolo.yml." >&2
    fi
    exit 1
fi
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../../../var/local/claude-yolo/lib/common-pure.bash
source "${CCY_LIB}/common-pure.bash"
# shellcheck source=../../../var/local/claude-yolo/lib/tmux-session.bash
source "${CCY_LIB}/tmux-session.bash"

if [[ -t 2 ]]; then
    bold=$'\e[1m' dim=$'\e[2m' reset=$'\e[0m'
else
    bold="" dim="" reset=""
fi

names=()
states=()
dirs=()

# load_sessions — refresh the three parallel arrays from the server. Returns 1 when empty.
load_sessions() {
    local name attached dir
    names=()
    states=()
    dirs=()
    while read -r name attached dir; do
        [[ -n "${name}" ]] || continue
        names+=("${name}")
        if [[ "${attached}" == "0" ]]; then
            states+=("detached")
        else
            states+=("open elsewhere")
        fi
        dirs+=("${dir/#${HOME}/\~}")
    done < <(ccy_tmux_list)
    [[ ${#names[@]} -gt 0 ]]
}

show_table() {
    local i
    printf '\n%sCCY sessions%s\n' "${bold}" "${reset}" >&2
    for i in "${!names[@]}"; do
        printf '  %2d) %-28s %-15s %s%s%s\n' "$((i + 1))" "${names[$i]}" "${states[$i]}" "${dim}" "${dirs[$i]}" "${reset}" >&2
    done
    printf '\n' >&2
}

# kill_one <index> — confirm, then end the session and everything in it.
kill_one() {
    local i="${1}" reply
    printf "End '%s' and everything running in it? [y/N] " "${names[$i]}" >&2
    if ! read -r reply </dev/tty; then
        reply=""
    fi
    case "${reply}" in
    y | Y | yes | YES)
        ccy_tmux kill-session -t "=${names[$i]}"
        echo "Ended '${names[$i]}'." >&2
        ;;
    *)
        echo "Kept '${names[$i]}'." >&2
        ;;
    esac
}

attempt=1
while :; do
    if ! load_sessions; then
        echo "No CCY sessions. Start one with ccy in a project directory." >&2
        exit 0
    fi
    show_table
    printf "Number to attach, k<number> to end one (k2), r to refresh, q to quit [q]: " >&2
    if ! read -r reply </dev/tty; then
        echo >&2
        exit 0
    fi
    case "${reply}" in
    "" | q | Q)
        exit 0
        ;;
    r | R)
        continue
        ;;
    k[0-9]* | K[0-9]*)
        n="${reply:1}"
        if [[ "${n}" =~ ^[0-9]+$ ]] && ((n >= 1 && n <= ${#names[@]})); then
            kill_one "$((n - 1))"
            continue
        fi
        echo "  '${reply}': there is no session ${n} in the list — let's try again." >&2
        ;;
    *)
        if [[ "${reply}" =~ ^[0-9]+$ ]] && ((reply >= 1 && reply <= ${#names[@]})); then
            i=$((reply - 1))
            if [[ "${states[$i]}" != "detached" ]]; then
                echo "  '${names[$i]}' is open in another terminal; a session can be attached from one terminal only. Close it there first, or end it with k${reply}." >&2
            elif ccy_tmux_attach "${names[$i]}"; then
                exit 0
            else
                echo "  '${names[$i]}' was taken or ended just now — the list has been refreshed." >&2
                continue
            fi
        else
            echo "  '${reply}' is not a listed number, k<number>, r or q — let's try again." >&2
        fi
        ;;
    esac
    attempt=$((attempt + 1))
    if [[ "${attempt}" -gt "${MAX_TRIES}" ]]; then
        echo "Giving up after ${MAX_TRIES} attempts. Nothing changed." >&2
        exit 1
    fi
done
