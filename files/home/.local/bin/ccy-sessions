#!/usr/bin/env bash
# ccy-sessions — see every CCY and cc session, return to a detached one, or end one.
#
# ccy and cc run each interactive session inside tmux on CCY's own server (see
# docs/ccy.md "Sessions Survive the Terminal"), so a session outlives the terminal that
# showed it. This is the way back: the same picker ccy and cc show themselves, over every
# session at once. Arrow keys move; Enter attaches; Ctrl-X ends a session; Ctrl-N starts
# a new ccy session in the current project folder (by running ccy the normal way); Esc or
# q leaves. Nothing needs Enter after it.
#
# A session can be attached from ONE terminal only. One that is open elsewhere is shown
# as such and Enter on it is refused — the tmux server enforces the same rule, so even a
# race cannot mirror one claude into two terminals. It can still be ended from here.
#
# Usage:
#   ccy-sessions                     the picker
#   ccy-sessions restore-status      what this machine does with sessions after a reboot
#   ccy-sessions reboot --dry-run    what a reboot would interrupt, and whether each
#                                    session is ready to be warned about it
#   ccy-sessions reboot --in N       warn every session, wait N minutes, then reboot
#                                    — BLOCKED, see below
#   ccy-sessions notify KIND         raise a signal in every session — BLOCKED, see below
#   ccy-sessions -h|--help           this text
#
# BLOCKED: raising the reboot warning needs a `reboot-warning` signal kind and a CLI to
# raise it, both of which live in the hooks daemon and do not exist yet
# (Edmonds-Commerce-Limited/claude-code-hooks-daemon#39). `reboot --in N` and `notify`
# therefore fail fast naming that issue: nothing is signalled and NOTHING IS REBOOTED. A
# command that rebooted without warning anyone, while looking like it had, would be worse
# than one that refuses. `reboot --dry-run` needs none of it and works today.
#
# Needs a terminal and fzf for the picker. The reporting subcommands need neither, so they
# work over a non-interactive ssh. Runs on the HOST: inside a CCY container there is no server.
set -euo pipefail

CCY_LIB="/var/local/claude-yolo/lib"
CCY_LAUNCHER="/var/local/claude-yolo/claude-yolo"
CCY_RESTORE_UNIT="ccy-sessions-restore.service"
MAX_TRIES=3

# The header comment, minus the shebang and the leading "# ". The range is DERIVED — it runs
# to the first line that is not a comment — rather than being a hardcoded line span that goes
# stale the moment the header grows, which is how this text came to stop at line 20 while the
# header ran past it.
usage() {
    awk 'NR == 1 { next } /^[^#]/ { exit } { sub(/^# ?/, ""); print }' "${BASH_SOURCE[0]}"
}

COMMAND="picker"
case "${1:-}" in
"") ;;
restore-status | reboot | notify)
    COMMAND="$1"
    shift
    ;;
-h | --help)
    usage
    exit 0
    ;;
*)
    echo "ccy-sessions: unknown command '${1}'. See ccy-sessions --help." >&2
    exit 64
    ;;
esac

# Only the picker needs a terminal — it attaches sessions to the one you are in. The reporting
# subcommands are useful precisely where there is no terminal: over a non-interactive ssh, or
# piped into something. Requiring a tty for those would make the status of a headless box
# unreadable from anywhere except that box.
if [[ "$COMMAND" == "picker" && ( ! -t 0 || ! -t 1 ) ]]; then
    echo "ccy-sessions needs a terminal: it attaches sessions to the one you are in." >&2
    echo "Without one, try: ccy-sessions restore-status" >&2
    exit 1
fi
# Every library this script sources, checked together. Naming only one of them meant a missing
# sibling produced a bare "No such file or directory" instead of the message written for exactly
# this situation, one line away.
for ccy_required_lib in tmux-session session-registry common-pure; do
    if [[ ! -f "${CCY_LIB}/${ccy_required_lib}.bash" ]]; then
        if [[ -d /workspace ]]; then
            echo "ccy-sessions runs on the host, not inside a CCY container." >&2
        else
            echo "CCY is not installed here (${CCY_LIB}/${ccy_required_lib}.bash missing). Run playbooks/imports/play-claude-yolo.yml." >&2
        fi
        exit 1
    fi
done
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../../../var/local/claude-yolo/lib/common-pure.bash
source "${CCY_LIB}/common-pure.bash"
# shellcheck source=../../../var/local/claude-yolo/lib/tmux-session.bash
source "${CCY_LIB}/tmux-session.bash"
# shellcheck source=../../../var/local/claude-yolo/lib/session-registry.bash
source "${CCY_LIB}/session-registry.bash"

# ── restore-status ────────────────────────────────────────────────────────────────────────
#
# Reports TWO things, and never multiplies them into one verdict: whether this machine will
# restore sessions at all, and what is in the registry. Collapsing those is the defect this
# repository keeps having to fix — on a machine that never opted in, "no sessions will come
# back" must not be the same sentence as "there were no sessions to bring back".
#
# Its whole output is a report a human reads, so that report IS its stdout
# (CLAUDE/StderrHygiene.md's carve-out for status commands).

# restore_installation_state — one of not-installed | installed-not-enabled |
# enabled-no-linger | enabled, on stdout. Four answers, because each needs a different fix.
restore_installation_state() {
    local unit="${HOME}/.config/systemd/user/${CCY_RESTORE_UNIT}" probe
    if [[ ! -f "$unit" ]]; then
        printf 'not-installed\n'
        return 0
    fi
    # "Could not ask" gets its own answer, exactly as the linger probe below does. Folding it
    # into `installed-not-enabled` sent an operator to "re-run the play" for an unreachable user
    # bus, a masked unit or a dangling .wants symlink — none of which the play fixes, and all of
    # which look identical from the advice they were given.
    if ! probe="$(systemctl --user is-enabled "$CCY_RESTORE_UNIT" 2>&1)"; then
        case "$probe" in
        disabled | static | indirect) printf 'installed-not-enabled\n' ;;
        *) printf 'installed-state-unknown:%s\n' "${probe//$'\n'/ }" ;;
        esac
        return 0
    fi
    if [[ "$probe" != "enabled" ]]; then
        printf 'installed-not-enabled\n'
        return 0
    fi
    # The quiet one. Everything looks right, is-enabled says enabled, and the unit never runs
    # because the user manager is not started at boot. Worth its own answer for exactly that
    # reason: it is the state most likely to be mistaken for a working setup.
    if ! probe="$(loginctl show-user "$(id -un)" --property=Linger --value 2>&1)"; then
        printf 'enabled-linger-unknown\n'
        return 0
    fi
    if [[ "$probe" != "yes" ]]; then
        printf 'enabled-no-linger\n'
        return 0
    fi
    printf 'enabled\n'
}

# list_with_reasons <dir> <label> — the retired/quarantined records and why, so a session that
# did not come back is explained rather than merely absent.
#
# `ccy_registry_collect`, never `mapfile < <(ccy_registry_list …)`: a process substitution hides
# the listing's exit status, so a directory this could not read printed as an empty section —
# indistinguishable from one with nothing in it.
list_with_reasons() {
    local dir="$1" label="$2" record reason project
    if ! ccy_registry_collect "$dir"; then
        printf '\n%s: COULD NOT BE READ — see the error above. This is not the same as empty.\n' "$label"
        return 1
    fi
    local -a found=("${CCY_REGISTRY_RECORDS[@]}")
    [[ ${#found[@]} -gt 0 ]] || return 0
    printf '\n%s (%s):\n' "$label" "${#found[@]}"
    for record in "${found[@]}"; do
        reason="$(ccy_registry_field_default "$record" retired_reason unrecorded)"
        project="$(ccy_registry_field_default "$record" project_dir '?')"
        printf '  %-22s %-20s %s\n' "$(basename "${record%.record}")" "$reason" "${project/#${HOME}/\~}"
    done
}

cmd_restore_status() {
    if [[ $# -gt 0 ]]; then
        echo "ccy-sessions restore-status takes no arguments (got '$1')." >&2
        exit 64
    fi
    local sessions_dir restore_dir state
    sessions_dir="$(ccy_registry_sessions_dir)"
    restore_dir="$(ccy_registry_restore_dir)"
    state="$(restore_installation_state)"

    echo "Session restore on this machine: ${state}"
    case "${state%%:*}" in
    not-installed)
        echo "  Nothing will be restored after a reboot — this is the default."
        echo "  Turn it on: ./playbooks/imports/play-claude-yolo.yml -e ccy_restore_sessions=true"
        ;;
    installed-not-enabled)
        echo "  The unit is present but not enabled, so it will not run at boot."
        echo "  Re-run: ./playbooks/imports/play-claude-yolo.yml -e ccy_restore_sessions=true"
        ;;
    enabled-no-linger)
        echo "  Enabled, but lingering is OFF for this user — the user manager does not start"
        echo "  at boot, so the unit will not run. Re-run playbooks/imports/play-systemd-user-tweaks.yml"
        ;;
    enabled-linger-unknown)
        echo "  Enabled, but whether lingering is on could not be determined, so whether this"
        echo "  runs at boot is UNKNOWN. Check: loginctl show-user $(id -un) --property=Linger"
        ;;
    installed-state-unknown)
        echo "  The unit is present but systemctl could not say whether it is enabled:"
        echo "    ${state#*:}"
        echo "  So whether this runs at boot is UNKNOWN — which is not the same as 'it will not'."
        echo "  A masked unit, an unreachable user bus and a dangling .wants symlink all land here."
        ;;
    enabled)
        echo "  Sessions still recorded at boot will be restored with --supervise --continue."
        ;;
    esac

    # Reported separately, always, whatever the state above. ccy records sessions whether or
    # not anything will act on the records, so "3 recorded, restore not installed" is a
    # sentence this command can say — which is the entire point.
    if ! ccy_registry_collect "$sessions_dir"; then
        printf '\nRecorded sessions: COULD NOT BE READ — see the error above.\n'
        echo "  That is not the same as none: whether anything would be restored is UNKNOWN."
        return 1
    fi
    local -a records=("${CCY_REGISTRY_RECORDS[@]}")
    local record project
    printf '\nRecorded sessions: %s\n' "${#records[@]}"
    if [[ ${#records[@]} -gt 0 ]]; then
        for record in "${records[@]}"; do
            project="$(ccy_registry_field_default "$record" project_dir '?')"
            printf '  %-22s %-9s %s\n' \
                "$(basename "${record%.record}")" \
                "$(ccy_registry_field_default "$record" restore '?')" \
                "${project/#${HOME}/\~}"
        done
        if [[ "$state" != "enabled" ]]; then
            echo "  None of these will be restored: see the state above."
        fi
    fi

    list_with_reasons "${restore_dir}/attempted" "Restores attempted at an earlier boot"
    list_with_reasons "${restore_dir}/retired" "Not restored, with the reason"
    list_with_reasons "${restore_dir}/malformed" "Quarantined records"

    if [[ -f "${restore_dir}/last-run" ]]; then
        printf '\nLast restore run:\n'
        awk '{ printf "  %s\n", $0 }' "${restore_dir}/last-run"
    elif [[ "$state" == "enabled" ]]; then
        # Distinguishable from "it ran and did nothing", which would have written the note.
        printf '\nLast restore run: never — no run has been recorded on this machine.\n'
    fi
}

# ── the reboot helper ─────────────────────────────────────────────────────────────────────

# project_daemon_cli <dir> — the hooks-daemon CLI for a project, on stdout; non-zero when the
# project has none. The two layouts a project can use, checked in the order the daemon's own
# docs give them.
project_daemon_cli() {
    local dir="$1" candidate
    for candidate in "${dir}/bin/hooks-daemon" "${dir}/.claude/hooks-daemon/bin/hooks-daemon"; do
        if [[ -x "$candidate" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

# ccy_reboot_signal_blocked <kind> — THE BLOCKED SEAM. Always refuses, today.
#
# Everything else in the reboot helper works. Raising the signal needs a `reboot-warning` kind
# and a daemon CLI command to raise it, neither of which exists:
# Edmonds-Commerce-Limited/claude-code-hooks-daemon#39. Verified against the installed daemon's
# command list, which has no notify and no signal-raising command of any kind.
#
# It is NOT faked with `inject-goal`, the nearest existing mechanism. That takes free text,
# while the whole security argument for this feature is that the signal carries a fixed kind
# and an integer and is therefore not a prompt-injection channel. Routing a reboot warning
# through a free-text command would throw that away to make a command look finished.
#
# Called ONCE, before any per-session loop, and unconditionally. Called from inside such a loop
# it would never run when no sessions were live — so `ccy-sessions reboot --in 5` on an idle
# machine exited 0 having neither warned anyone nor rebooted, which is the one outcome a
# deliberately-blocked command must never produce.
ccy_reboot_signal_blocked() {
    local kind="$1"
    print_error "cannot raise '${kind}': this half of the feature is not built yet."
    cat >&2 <<'BLOCKED'
The reboot-warning signal kind and the CLI that raises it do not exist:
  Edmonds-Commerce-Limited/claude-code-hooks-daemon#39

Nothing was signalled and NOTHING WAS REBOOTED. Reboot by whatever means you normally
would, accepting that running sessions get no warning — or wait for the daemon release
that adds the signal.

`ccy-sessions reboot --dry-run` works today and reports what a reboot would interrupt,
and whether each session's project is ready to be warned when this is unblocked.
BLOCKED
    return 1
}

# live_sessions — "<name> <directory>" per line, for every session on the server.
#
# A listing FAILURE is propagated, never read as "no sessions". `ccy_tmux_list` already returns
# 0 with no output when there is simply no server yet — the normal state — and non-zero only
# when something is actually wrong, so the two are distinguishable here and must stay so.
live_sessions() {
    local listing name attached dir
    listing="$(ccy_tmux_list)" || return 1
    while read -r name attached dir; do
        [[ -n "$name" ]] || continue
        printf '%s %s\n' "$name" "$dir"
    done <<<"$listing"
}

# audit_sessions — the table of what a reboot would interrupt, and whether each session's
# project can be warned. Returns non-zero if ANY project cannot be, because a partial warning
# is the failure mode worth refusing: the operator would believe every session had been told.
#
# The listing is CAPTURED, not consumed from a process substitution. `while read ... < <(cmd)`
# discards cmd's exit status, so a failing `tmux list-sessions` produced an empty loop and this
# printed "no sessions are running" — a confident wrong answer that would tell an operator a
# reboot was safe while sessions were running. Caught by the smoke run on a box with no tmux.
audit_sessions() {
    local name dir missing=0 total=0 listing
    if ! listing="$(live_sessions)"; then
        print_error "could not list the running sessions, so what a reboot would interrupt is UNKNOWN."
        echo "That is not the same as nothing running — fix the reason above before rebooting." >&2
        return 1
    fi
    while read -r name dir; do
        [[ -n "$name" ]] || continue
        total=$((total + 1))
        # The CLI's path is not wanted here, only whether the project has one; stdout is
        # discarded rather than captured into a variable nothing reads.
        if project_daemon_cli "$dir" >/dev/null; then
            printf '  %-28s %-14s %s\n' "$name" "ready" "${dir/#${HOME}/\~}"
        else
            printf '  %-28s %-14s %s\n' "$name" "NO DAEMON CLI" "${dir/#${HOME}/\~}"
            missing=$((missing + 1))
        fi
    done <<<"$listing"

    if [[ "$total" -eq 0 ]]; then
        echo "  (no sessions are running)"
        return 0
    fi
    if [[ "$missing" -gt 0 ]]; then
        printf '\n' >&2
        print_error "${missing} of ${total} session(s) could not be warned — their projects have no hooks-daemon CLI."
        echo "Refusing rather than warning some and not others: you would believe every session had been told." >&2
        return 1
    fi
}

cmd_reboot() {
    local dry_run=false minutes=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
        --dry-run) dry_run=true ;;
        --in)
            # Guarded: `--in` with nothing after it left $# at 0, and the `shift` at the foot of
            # the loop then failed under `set -e` — aborting with no message at all, twelve
            # lines above the friendly one written for this mistake.
            if [[ $# -lt 2 ]]; then
                echo "ccy-sessions reboot: --in needs a number of minutes, e.g. --in 5." >&2
                exit 64
            fi
            shift
            minutes="$1"
            ;;
        --in=*) minutes="${1#--in=}" ;;
        *)
            echo "ccy-sessions reboot: unknown option '$1'. See ccy-sessions --help." >&2
            exit 64
            ;;
        esac
        shift
    done

    if [[ "$dry_run" == false && -z "$minutes" ]]; then
        echo "ccy-sessions reboot needs --in N (minutes) or --dry-run. See ccy-sessions --help." >&2
        exit 64
    fi
    if [[ -n "$minutes" && ! "$minutes" =~ ^[1-9][0-9]*$ ]]; then
        echo "ccy-sessions reboot: --in wants a whole number of minutes, got '${minutes}'." >&2
        exit 64
    fi

    echo "Sessions a reboot would interrupt:"
    audit_sessions || exit 1

    if [[ "$dry_run" == true ]]; then
        printf '\nDry run: nothing was signalled and nothing was rebooted.\n'
        return 0
    fi

    # The audit passed, so every project could be warned — if there were anything to warn them
    # with. The refusal is unconditional and happens here: AFTER the audit, so the operator
    # still gets the useful half of the command, and BEFORE anything is signalled or rebooted.
    ccy_reboot_signal_blocked reboot-warning
    return 1
}

cmd_notify() {
    local kind="${1:-}" minutes=0
    # Guarded rather than `shift || true`: with no arguments `shift` fails, and swallowing that
    # failure is the error-hiding pattern this repo bans. The empty case is handled below, where
    # it gets a message naming the kinds this command knows.
    if [[ $# -gt 0 ]]; then
        shift
    fi
    case "$kind" in
    reboot-warning | reboot-cancelled) ;;
    "")
        echo "ccy-sessions notify needs a signal kind: reboot-warning or reboot-cancelled." >&2
        exit 64
        ;;
    *)
        echo "ccy-sessions notify: unknown signal kind '${kind}'." >&2
        echo "The helper never composes a message; it names a kind and a number. Known kinds: reboot-warning, reboot-cancelled." >&2
        exit 64
        ;;
    esac
    while [[ $# -gt 0 ]]; do
        case "$1" in
        --minutes)
            # Same guard as reboot's --in: a trailing `--minutes` would otherwise abort
            # silently on the loop's own shift.
            if [[ $# -lt 2 ]]; then
                echo "ccy-sessions notify: --minutes needs a number, e.g. --minutes 5." >&2
                exit 64
            fi
            shift
            minutes="$1"
            ;;
        --minutes=*) minutes="${1#--minutes=}" ;;
        *)
            echo "ccy-sessions notify: unknown option '$1'." >&2
            exit 64
            ;;
        esac
        shift
    done
    if [[ ! "$minutes" =~ ^[0-9]+$ ]]; then
        echo "ccy-sessions notify: --minutes wants a whole number, got '${minutes}'." >&2
        exit 64
    fi

    echo "Sessions that would be signalled:"
    audit_sessions || exit 1

    # Unconditional, for the same reason as cmd_reboot: inside a per-session loop this would
    # silently exit 0 on a machine with no sessions, and a blocked command that sometimes
    # succeeds is worse than one that always refuses.
    ccy_reboot_signal_blocked "$kind"
    return 1
}

# `exit $?`, not `exit 0`: these commands report a verdict, and a blocked seam or an unreadable
# registry must reach the shell as a non-zero status rather than being flattened by the dispatch.
case "$COMMAND" in
restore-status)
    cmd_restore_status "$@"
    exit $?
    ;;
reboot)
    cmd_reboot "$@"
    exit $?
    ;;
notify)
    cmd_notify "$@"
    exit $?
    ;;
esac

# ── the picker, reached only with no subcommand ───────────────────────────────────────────

# rows — every session as a picker row, in the library's house format.
rows() {
    local name attached dir
    while read -r name attached dir; do
        [[ -n "${name}" ]] || continue
        ccy_tmux_row "${name}" "${attached}" "${dir}"
        printf '\n'
    done < <(ccy_tmux_list)
}

# confirm_end <name> — end a session and everything in it, after the picker's yes/no
# (no is the default row).
confirm_end() {
    local name="${1}"
    if ccy_tmux_confirm "End ${name}?" "Everything running in it will be killed." "end '${name}'"; then
        ccy_tmux kill-session -t "=${name}"
        echo "Ended '${name}'." >&2
    else
        echo "Kept '${name}'." >&2
    fi
}

# A new session is only ever started the normal way — by running ccy itself, which does
# every check and prompt it always does — and only from a project folder, which for ccy
# means a git work tree. Anywhere else the key is shown as unavailable rather than hidden.
here="${PWD/#${HOME}/\~}"
project_here() {
    local probe
    probe="$(git rev-parse --is-inside-work-tree 2>&1)" && [[ "${probe}" == "true" ]]
}
start_ccy_here() {
    echo "Starting ccy in ${here}." >&2
    exec "${CCY_LAUNCHER}"
}

if project_here; then
    new_line="Ctrl-N starts a new ccy session in ${here}"
else
    new_line="Ctrl-N unavailable: ${here} is not a project folder (no git repository)"
fi
HEADER="$(ccy_tmux_header "Enter attach   Ctrl-X end   Ctrl-N new   Esc or q quit" \
    "${new_line}" \
    "\"open elsewhere\" is attached in another terminal: it can be ended here, not attached")"

attempt=1
while :; do
    listing="$(rows)"
    if [[ -z "${listing}" ]]; then
        if project_here; then
            if ccy_tmux_confirm "CCY sessions" "No sessions are running. Start ccy in ${here}?" "start ccy here"; then
                start_ccy_here
            fi
            exit 0
        fi
        echo "No CCY or cc sessions are running. Start one with ccy or cc in a project directory." >&2
        exit 0
    fi
    # The picker prints the key that closed it (empty for Enter), then the chosen row.
    if ! picked="$(ccy_tmux_pick "CCY sessions" "${HEADER}" "ctrl-x,ctrl-n" <<<"${listing%$'\n'}")"; then
        exit 0 # Esc or q
    fi
    key="${picked%%$'\n'*}"
    row="${picked#*$'\n'}"
    name="${row%% *}"

    case "${key}" in
    ctrl-n)
        if project_here; then
            start_ccy_here
        fi
        echo "${here} is not a project folder (no git repository), so ccy cannot be started here." >&2
        ;;
    ctrl-x)
        confirm_end "${name}"
        continue
        ;;
    *)
        if [[ "${row}" != *"open elsewhere"* ]]; then
            if ccy_tmux_attach "${name}"; then
                exit 0
            fi
            echo "'${name}' was taken or ended just now — the list has been refreshed." >&2
        else
            echo "'${name}' is open in another terminal. Detach it there (F12, Detach), or end it here with Ctrl-X." >&2
        fi
        ;;
    esac
    attempt=$((attempt + 1))
    if [[ "${attempt}" -gt "${MAX_TRIES}" ]]; then
        echo "Nothing attached after ${MAX_TRIES} tries. Nothing changed." >&2
        exit 1
    fi
done
