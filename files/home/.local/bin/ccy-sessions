#!/usr/bin/env bash
# ccy-sessions — see every CCY and cc session, return to a detached one, or end one; warn
# them all before a reboot; bring them back after one.
#
# ccy and cc run each interactive session inside tmux on CCY's own server (see
# docs/ccy.md "Sessions Survive the Terminal"), so a session outlives the terminal that
# showed it. This is the way back: the same picker ccy and cc show themselves, over every
# session at once. Arrow keys move; Enter attaches; Ctrl-T takes over a session open in
# another terminal; Ctrl-X ends a session; Ctrl-N starts a new ccy session in the current
# project folder (by running ccy the normal way); Esc or q leaves. Nothing needs Enter
# after it.
#
# A session can be attached from ONE terminal only. One that is open elsewhere is shown
# as such and Enter on it is refused — the tmux server enforces the same rule, so even a
# race cannot mirror one claude into two terminals. Ctrl-T takes it over: after a yes/no
# naming the other terminal and how long it has been idle, that terminal is detached (the
# way out of a dropped SSH connection still holding the session) and this one attached.
# The session and everything in it keep running. It can also be ended from here.
#
# Each row also names the container network that session is on, asked of the container
# engine itself so it reflects a later ccy --connect and not only the launch flags:
#   <network>      the network the session's container is connected to
#   none           the container is on no named network (ccy --no-network, or a default
#                  that is not a named network)
#   no container   nothing to ask about — a cc session runs claude on the host, and a ccy
#                  session outlives a container that has exited
#   unknown        the question could not be answered; the reason is printed above the list
#
# The token and SSH key columns name the Claude token and the key(s) the session's container
# was started with, read off its ccy-token and ccy-ssh-keys labels: "none" when it has none,
# "-" when there is no container to ask (as for the network), "unknown" as above.
#
# The CPU column is how busy the session is: the CPU time used by everything it runs (its
# container's processes and its own on the host) over a one-second sample, as top shows it,
# so 100% is one whole core. The list therefore takes about a second to appear.
#
# Usage:
#   ccy-sessions                                    the picker (needs a terminal)
#   ccy-sessions -l|--list                          print the same table, with a heading, on
#                                                   stdout and exit; no terminal needed
#   ccy-sessions notify going-down --minutes N [--dry-run]
#                                                   tell every live session's project that
#                                                   the machine goes down in N minutes, as
#                                                   the kind below that is TRUE here
#   ccy-sessions notify reboot-warning --minutes N  "reboot; a session restore will follow"
#   ccy-sessions notify shutdown-warning --minutes N  "shut down; NO restore, leave a handoff"
#   ccy-sessions notify reboot-cancelled            tell them it is not happening after all
#   ccy-sessions reboot --in N [--dry-run]          warn, count down, warn again at one
#                                                   minute, then systemctl reboot; refused
#                                                   up front unless logind lets this account
#                                                   reboot with nobody to authenticate
#   ccy-sessions restore [--dry-run]                start every session recorded as running
#                                                   at the last shutdown (the boot unit)
#   ccy-sessions set-going                          once each session this boot's restore
#                                                   started has drawn Claude's prompt, type
#                                                   its first input: /compact when its
#                                                   context is at or above
#                                                   CCY_RESTORE_COMPACT_FLOOR_TOKENS, else
#                                                   continue (the unit after the restore)
#   ccy-sessions verify-restore [--wait SECONDS]    check every session this boot's restore
#                                                   brought up, one line each on stdout:
#                                                   "<name> OK", "<name> STARTING",
#                                                   "<name> SETTING-GOING",
#                                                   "<name> NOT-SET-GOING <why>",
#                                                   "<name> WAITING-AT-PROMPT <which>" or
#                                                   "<name> DEAD <why>"; exit 0 only if all
#                                                   are OK. --wait polls until the restore
#                                                   has settled (nothing STARTING or
#                                                   SETTING-GOING, and the same answer twice
#                                                   running), or the time is up
#   ccy-sessions -h|--help                          this text
#
# notify and reboot speak to each project through ITS OWN hooks-daemon CLI
# (.claude/hooks-daemon/bin/hooks-daemon signal ...), naming only a signal kind and a
# number of minutes — never a message. It runs inside the container for a project with a
# ccy session, on the host otherwise (set_route). A live session whose project has no
# daemon CLI, or one that cannot run, is a refusal: every such session is named, nothing is
# signalled, and reboot reboots nothing. Exit 64 for a usage mistake, 1 for a refusal.
#
# The daemon's two warning texts differ in what an agent does next — carry on because it
# will be restored, or wind down and hand off because it will not — so `going-down` (and
# `reboot`) choose by whether this user's session restore is enabled, not by the power
# action: reboot-warning when it is, shutdown-warning when it is not. The texts also name
# the action, so a shutdown with restore on reads "will reboot", and a reboot with restore
# off reads "will shut down"; what the agent is asked to do is right either way.
#
# A restore answers only the prompts that have one safe answer (Quick Launch, and the two
# running-container menus); every other prompt still asks, in the pane, where a person can
# attach and answer it. verify-restore is how nobody has to look: it names each session's
# state from what its screen shows and whether its container runs.
#
# A restored session comes back at an empty prompt with a cold prompt cache, and would wait
# there for a person. set-going is what starts it: it waits (CCY_SESSIONS_SET_GOING_WAIT
# seconds at most) for each started session's prompt to draw, reads the context size from
# the conversation's transcript (the --resume'd one, else the newest), and types /compact
# (the supervisor's continue-after-compaction then carries a ccy session on; for one with
# no supervisor, set-going types continue once the compaction is in the transcript) or
# continue. One session per conversation is set going: a second sharing it is left alone.
# A session whose prompt never draws, is already busy, has someone attached or text in its
# box, or whose context cannot be read is left alone and named on stderr; the others go on.
# Exit 0 when every one was set going, 1 when any was not. verify-restore
# reports a session that did not take what was typed within CCY_SESSIONS_START_WINDOW
# seconds as NOT-SET-GOING, and one left alone the same way.
#
# Runs on the HOST: inside a CCY container there is no server.
set -euo pipefail

CCY_LIB="${CCY_LIB:-/var/local/claude-yolo/lib}"
CCY_LAUNCHER="/var/local/claude-yolo/claude-yolo"
MAX_TRIES=3
# A minute, in seconds. Overridable so the countdown can be driven by a test; nothing else
# should ever set it.
MINUTE_SECONDS="${CCY_SESSIONS_MINUTE_SECONDS:-60}"
# How often verify-restore --wait and set-going look again, in seconds. Overridable for the
# same reason, as are the three set-going times below.
POLL_SECONDS="${CCY_SESSIONS_POLL_SECONDS:-5}"
# How long set-going waits, in all, for the restored sessions' prompts to draw. An image
# rebuild after an update is the slow case. fedora-desktop-self-update's verify ceiling
# (helpers/self_update/cycle.py) is this plus START_WINDOW plus margin.
SET_GOING_WAIT="${CCY_SESSIONS_SET_GOING_WAIT:-1200}"
# How long after its first input is typed a session has to take it before verify-restore
# reports it NOT-SET-GOING.
START_WINDOW="${CCY_SESSIONS_START_WINDOW:-120}"
# The pause between typing a line and pressing Enter, the supervisor's _SUBMIT_DELAY_SECONDS:
# an Enter arriving with the text is read as part of it.
SUBMIT_DELAY="${CCY_SESSIONS_SUBMIT_DELAY:-0.2}"
# What set-going types. The compact's instruction is /compact's own argument, as the
# supervisor's is; the space after the command also closes Claude's completion menu, so the
# Enter submits the line instead of completing the command name.
SET_GOING_COMPACT="/compact This session was restored after a reboot. After compacting, carry on with the work that was in progress."
SET_GOING_CONTINUE="continue"

# The help text IS the header comment above, printed back. It stops at the first line that
# is not a comment rather than at a hardcoded line number: the range form printed `t -euo
# pipefail` as its last line, and silently clipped the text whenever the header grew.
usage() {
    awk 'NR == 1 { next } /^#/ { print substr($0, 3); next } { exit }' "${BASH_SOURCE[0]}"
}

usage_error() {
    echo "ccy-sessions: $1 See ccy-sessions --help." >&2
    exit 64
}

subcommand="${1:-}"
case "${subcommand}" in
"" | notify | reboot | restore | set-going | verify-restore) ;;
-l | --list)
    if [[ $# -gt 1 ]]; then
        usage_error "'${subcommand}' takes no further arguments."
    fi
    ;;
-h | --help)
    usage
    exit 0
    ;;
*)
    usage_error "unknown option '${subcommand}'."
    ;;
esac
if [[ -n "${subcommand}" ]]; then
    shift
fi

if [[ ! -f "${CCY_LIB}/tmux-session.bash" ]]; then
    if [[ -d /workspace ]]; then
        echo "ccy-sessions runs on the host, not inside a CCY container." >&2
    else
        echo "CCY is not installed here (${CCY_LIB}/tmux-session.bash missing). Run playbooks/imports/play-claude-yolo.yml." >&2
    fi
    exit 1
fi
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../../../var/local/claude-yolo/lib/common-pure.bash
source "${CCY_LIB}/common-pure.bash"
# shellcheck source=../../../var/local/claude-yolo/lib/session-registry.bash
source "${CCY_LIB}/session-registry.bash"
# shellcheck source=../../../var/local/claude-yolo/lib/tmux-session.bash
source "${CCY_LIB}/tmux-session.bash"

# ── notify / reboot: one signal per live project ─────────────────────────────────────────

# minutes_or_die <value> <flag> — a positive integer, or a usage error naming the flag.
minutes_or_die() {
    if [[ ! "${1}" =~ ^[1-9][0-9]*$ ]]; then
        usage_error "${2} needs a whole number of minutes, at least 1; got '${1}'."
    fi
}

daemon_cli() {
    printf '%s/.claude/hooks-daemon/bin/hooks-daemon' "${1}"
}

# Where ccy mounts the project inside its container.
CCY_CONTAINER_WORKSPACE=/workspace

# session_containers — "<session> <engine> <container>" for every tmux session, from the
# live pane and process tables (ccy_session_containers; "- -" for one with no container).
session_containers() {
    local panes processes
    if ! panes="$(ccy_tmux list-panes -a -F '#{session_name} #{pane_pid}' 2>&1)"; then
        if [[ "${panes}" != *"no server running"* && "${panes}" != *"No such file or directory"* ]]; then
            print_error "tmux list-panes failed: ${panes}"
            return 1
        fi
        panes=""
    fi
    if ! processes="$(ps -ww -eo pid=,ppid=,args= 2>&1)"; then
        print_error "the process table could not be read, so no session can be matched to its container: ${processes}"
        return 1
    fi
    ccy_session_containers "${panes}" "${processes}"
}

# project_containers — "<dir>\t<engine>\t<container>" for each live project that has a ccy
# session with a container, the first such session's.
project_containers() {
    local listing containers name attached dir engine container
    local -A dir_of=() taken=()
    listing="$(ccy_tmux_list)" || return 1
    while read -r name attached dir; do
        [[ -n "${name}" && -n "${dir}" ]] && dir_of["${name}"]="${dir}"
    done <<<"${listing}"
    if ! containers="$(session_containers)"; then
        return 1
    fi
    while read -r name engine container; do
        [[ -n "${name}" && "${container}" != "-" && -n "${dir_of[${name}]:-}" ]] || continue
        dir="${dir_of[${name}]}"
        [[ -z "${taken[${dir}]:-}" ]] || continue
        taken["${dir}"]=1
        printf '%s\t%s\t%s\n' "${dir}" "${engine}" "${container}"
    done <<<"${containers}"
}

# A project's daemon is reached where its venv is. For a project with a ccy session that is
# inside the container: most projects run only ccy, and their daemon has no venv on the
# host at all. A project with only cc sessions is reached on the host. A signal is a file in
# the project's own tree, which the container and the host share, so one delivery per
# project reaches every session in it, ccy and cc alike.
#
# set_route <dir> — sets ROUTE_CMD (the daemon CLI command), ROUTE_ROOT (its project root)
# and ROUTE_VIA (text naming the container, or empty), from ROUTE_ENGINE / ROUTE_CONTAINER.
declare -A ROUTE_ENGINE=() ROUTE_CONTAINER=()
ROUTE_CMD=()
ROUTE_ROOT=""
ROUTE_VIA=""
set_route() {
    local dir="${1}"
    if [[ -n "${ROUTE_CONTAINER[${dir}]:-}" ]]; then
        ROUTE_CMD=("${ROUTE_ENGINE[${dir}]}" exec "${ROUTE_CONTAINER[${dir}]}"
            "$(daemon_cli "${CCY_CONTAINER_WORKSPACE}")")
        ROUTE_ROOT="${CCY_CONTAINER_WORKSPACE}"
        ROUTE_VIA=" (in container ${ROUTE_CONTAINER[${dir}]})"
    else
        ROUTE_CMD=("$(daemon_cli "${dir}")")
        ROUTE_ROOT="${dir}"
        ROUTE_VIA=""
    fi
}

# PROJECTS — every live session's project directory, each once, as check_projects found it.
# deliver_signal sends to these; the routes to each are in ROUTE_ENGINE / ROUTE_CONTAINER.
PROJECTS=()

# check_projects <kind> — find every reason a live session could not be given <kind> BEFORE
# any is: a session list that cannot be read, a project with no hooks-daemon CLI, and (for a
# warning) a CLI that cannot run where its session is reached. Every session that cannot be
# warned is listed, with what to do about it, not just the first one met. Fills PROJECTS and
# the routes. Reports go to stderr.
check_projects() {
    local kind="${1}"
    local listing name attached dir
    local -a missing=() broken=()
    local -A sessions_of=() probe_of=()
    PROJECTS=()
    # Read whole first: a listing that failed inside a process substitution would read as
    # "no sessions", after which a reboot would proceed with every session unwarned.
    if ! listing="$(ccy_tmux_list)"; then
        print_error "the live session list could not be read, so nothing is signalled and nothing may reboot."
        return 1
    fi
    while read -r name attached dir; do
        [[ -n "${name}" && -n "${dir}" ]] || continue
        if [[ -z "${sessions_of[${dir}]+set}" ]]; then
            PROJECTS+=("${dir}")
            sessions_of["${dir}"]="${name}"
        else
            sessions_of["${dir}"]+=$'\n'"${name}"
        fi
    done <<<"${listing}"
    [[ "${#PROJECTS[@]}" -gt 0 ]] || return 0

    local routes route_dir route_engine route_container
    if ! routes="$(project_containers)"; then
        print_error "the live sessions could not be matched to their containers, so nothing is signalled and nothing may reboot."
        return 1
    fi
    ROUTE_ENGINE=()
    ROUTE_CONTAINER=()
    while IFS=$'\t' read -r route_dir route_engine route_container; do
        [[ -n "${route_dir}" ]] || continue
        ROUTE_ENGINE["${route_dir}"]="${route_engine}"
        ROUTE_CONTAINER["${route_dir}"]="${route_container}"
    done <<<"${routes}"

    local probe_out
    for dir in "${PROJECTS[@]}"; do
        if [[ ! -x "$(daemon_cli "${dir}")" ]]; then
            missing+=("${dir}")
            continue
        fi
        # An executable CLI can still be unable to run, as the host's is for a project whose
        # daemon has no venv there. So a warning first asks each route for `signal --help`,
        # which changes nothing but must start the daemon's python. A withdrawal skips this:
        # it reaches every project it can.
        [[ "${kind}" != reboot-cancelled ]] || continue
        set_route "${dir}"
        if ! probe_out="$("${ROUTE_CMD[@]}" signal --help 2>&1)"; then
            broken+=("${dir}")
            probe_of["${dir}"]="${probe_out}"
        fi
    done
    if [[ "${#missing[@]}" -eq 0 && "${#broken[@]}" -eq 0 ]]; then
        return 0
    fi

    if [[ "${#missing[@]}" -gt 0 ]]; then
        print_error "these live sessions cannot be warned: their project has no hooks-daemon CLI."
        for dir in "${missing[@]}"; do
            while read -r name; do
                echo "  ${name}  in ${dir}  (expected $(daemon_cli "${dir}"))" >&2
            done <<<"${sessions_of[${dir}]}"
        done
    fi
    if [[ "${#broken[@]}" -gt 0 ]]; then
        print_error "these live sessions cannot be warned: their project's hooks-daemon CLI cannot run."
        for dir in "${broken[@]}"; do
            set_route "${dir}"
            while read -r name; do
                echo "  ${name}  in ${dir}${ROUTE_VIA}: its hooks-daemon CLI cannot run:" >&2
            done <<<"${sessions_of[${dir}]}"
            printf '%s\n' "${probe_of[${dir}]}" | awk '{ print "      " $0 }' >&2
        done
    fi
    echo "For each session above, either end it (run ccy-sessions and press Ctrl-X on it), or install or repair the daemon in its project (the hooks-daemon skill, 'install'). Nothing was signalled." >&2
    return 1
}

# deliver_signal <kind> <minutes-or-empty> <dry-run> — invoke the daemon CLI of each project
# check_projects found, once. Prints the count of projects reached to stdout; reports go to
# stderr. A warning stops at the first project that refuses, so the caller can withdraw it. A
# withdrawal carries on past a refusal: every project it reaches is one fewer left waiting
# for a reboot that is not coming.
deliver_signal() {
    local kind="${1}" minutes="${2}" dry_run="${3}" dir failed=false
    local -a cli_args=(signal "${kind}")
    if [[ "${#PROJECTS[@]}" -eq 0 ]]; then
        echo "No CCY or cc sessions are running; nothing to signal." >&2
        printf '0\n'
        return 0
    fi
    if [[ -n "${minutes}" ]]; then
        cli_args+=(--minutes "${minutes}")
    fi
    cli_args+=(--all-sessions)
    for dir in "${PROJECTS[@]}"; do
        set_route "${dir}"
        if [[ "${dry_run}" == true ]]; then
            echo "would signal ${kind}${minutes:+ --minutes ${minutes}} to ${dir}${ROUTE_VIA}" >&2
            continue
        fi
        if ! "${ROUTE_CMD[@]}" "${cli_args[@]}" --project-root "${ROUTE_ROOT}"; then
            print_error "signalling ${kind} to ${dir}${ROUTE_VIA} failed."
            [[ "${kind}" == reboot-cancelled ]] || return 1
            failed=true
            continue
        fi
        echo "signalled ${kind}${minutes:+ (${minutes} min)} to ${dir}${ROUTE_VIA}" >&2
    done
    [[ "${failed}" == false ]] || return 1
    printf '%s\n' "${#PROJECTS[@]}"
}

# signal_projects <kind> <minutes-or-empty> <dry-run> — check every live project, then signal
# each once. Every project is checked BEFORE any is signalled, so a refusal leaves no project
# half-warned about a reboot that is then not going to happen. Prints the count of projects
# reached to stdout.
signal_projects() {
    check_projects "${1}" || return 1
    deliver_signal "$@"
}

# reboot_permitted — whether logind lets this account reboot with nobody to authenticate.
# From a login with no terminal polkit refuses `systemctl reboot` ("interactive
# authentication required"), and asked only at the end that refusal came after every session
# had been warned twice. So it is asked first. "yes" is the only answer that reboots
# unattended; anything else is a refusal that names the way round it.
reboot_permitted() {
    local answer
    if ! answer="$(busctl --system call org.freedesktop.login1 /org/freedesktop/login1 \
        org.freedesktop.login1.Manager CanReboot 2>&1)"; then
        print_error "could not ask logind whether this account may reboot: ${answer}"
        return 1
    fi
    # busctl prints a string reply as its signature and the quoted value: s "yes".
    answer="${answer#s \"}"
    answer="${answer%\"}"
    case "${answer}" in
    yes) return 0 ;;
    challenge)
        print_error "this account may reboot only after authenticating to polkit (logind CanReboot: challenge). The reboot comes after the countdown, when nobody may be there to answer, and from a login with no terminal polkit refuses it outright."
        ;;
    *)
        print_error "logind does not let this account reboot (logind CanReboot: ${answer}), so the reboot would be refused after every session had been warned."
        ;;
    esac
    echo "Reboot as root instead, which warns the sessions the same way: sudo /usr/local/bin/reboot-with-update --in N (it applies updates first). Or run ccy-sessions reboot from the machine's own desktop session." >&2
    return 1
}

# going_down_kind — the warning kind that tells this user's sessions the truth about what
# follows: reboot-warning when their restore unit is enabled (the wants-symlink that
# play-claude-yolo.yml manages), shutdown-warning when it is not.
going_down_kind() {
    local wants="${HOME}/.config/systemd/user/default.target.wants/ccy-sessions-restore.service"
    # -e follows the link: a dangling wants-symlink pulls in nothing at boot.
    if [[ -e "${wants}" ]]; then
        printf 'reboot-warning\n'
    else
        printf 'shutdown-warning\n'
    fi
}

cmd_notify() {
    local kind="${1:-}" minutes="" dry_run=false
    case "${kind}" in
    going-down | reboot-warning | shutdown-warning)
        if [[ "${2:-}" != "--minutes" || -z "${3:-}" ]]; then
            usage_error "'notify ${kind}' needs --minutes N."
        fi
        minutes_or_die "${3}" "--minutes"
        minutes="${3}"
        if [[ "${4:-}" == "--dry-run" ]]; then
            dry_run=true
        elif [[ $# -gt 3 ]]; then
            usage_error "unexpected argument '${4}'."
        fi
        if [[ $# -gt 4 ]]; then
            usage_error "unexpected argument '${5}'."
        fi
        if [[ "${kind}" == going-down ]]; then
            kind="$(going_down_kind)"
        fi
        ;;
    reboot-cancelled)
        if [[ $# -gt 1 ]]; then
            usage_error "'notify reboot-cancelled' takes no further arguments."
        fi
        ;;
    "")
        usage_error "'notify' needs a signal kind: going-down, reboot-warning, shutdown-warning or reboot-cancelled."
        ;;
    *)
        usage_error "unknown signal kind '${kind}'."
        ;;
    esac
    signal_projects "${kind}" "${minutes}" "${dry_run}" >/dev/null
}

# Once a warning may have gone out, any exit other than the reboot itself (Ctrl-C, a
# project refusing a warning, systemctl refusing) tells the sessions the reboot is off.
# Never on a dry run. The same shape as shutdown-with-update's withdraw_unless_down.
REBOOT_WARNED=false
REBOOT_FAILED=false
COUNTDOWN_PID=""
withdraw_unless_rebooting() {
    local status=$?
    trap - EXIT
    if [[ "${status}" -ne 0 && "${REBOOT_WARNED}" == true ]]; then
        # The daemon has one withdrawal, reboot-cancelled; what this side says names the cause.
        if [[ "${REBOOT_FAILED}" == true ]]; then
            echo "Telling the sessions the warned reboot is not happening." >&2
        else
            echo "The machine is staying up; telling the sessions the reboot is off." >&2
        fi
        if ! signal_projects reboot-cancelled "" false >/dev/null; then
            print_error "the sessions could not all be told; some still expect the reboot."
        fi
    fi
    exit "${status}"
}

cancel_reboot() {
    trap - INT TERM
    if [[ -n "${COUNTDOWN_PID}" ]] && ! kill "${COUNTDOWN_PID}"; then
        echo "(the countdown had already ended)" >&2
    fi
    echo "" >&2
    echo "Reboot cancelled." >&2
    exit 130
}

# countdown <seconds> — a sleep the trap can interrupt. bash runs a trap handler only once
# the foreground command has finished, so a plain `sleep 120` would make Ctrl-C take effect
# two minutes later, after the reboot. A backgrounded sleep and a `wait` return at once.
countdown() {
    sleep "${1}" &
    COUNTDOWN_PID=$!
    wait "${COUNTDOWN_PID}"
    COUNTDOWN_PID=""
}

cmd_reboot() {
    local minutes="" dry_run=false reached kind
    while [[ $# -gt 0 ]]; do
        case "${1}" in
        --in)
            [[ -n "${2:-}" ]] || usage_error "--in needs a number of minutes."
            minutes_or_die "${2}" "--in"
            minutes="${2}"
            shift 2
            ;;
        --dry-run)
            dry_run=true
            shift
            ;;
        *)
            usage_error "unknown reboot option '${1}'."
            ;;
        esac
    done
    [[ -n "${minutes}" ]] || usage_error "'reboot' needs --in N."
    kind="$(going_down_kind)"

    # Everything that would stop the reboot is found before anyone is warned, and all of it
    # at once: whether this account may reboot unattended, and every session that cannot be
    # warned. A dry run checks the same, so it never says it would reboot when it would not.
    local refused=false
    reboot_permitted || refused=true
    check_projects "${kind}" || refused=true
    if [[ "${refused}" == true ]]; then
        echo "Nothing was signalled and nothing rebooted." >&2
        return 1
    fi

    # The one-minute warning is the last word before the reboot; with --in 1 it is also the
    # first, so it is not sent twice.
    # Armed BEFORE the first warning goes out, so a failure or interrupt that lands mid-loop
    # — some projects warned, some not — still cancels. A cancellation reaching a project
    # that was never warned is harmless; a warned project left uncancelled is not.
    if [[ "${dry_run}" == false ]]; then
        REBOOT_WARNED=true
        trap withdraw_unless_rebooting EXIT
        trap cancel_reboot INT TERM
    fi
    reached="$(deliver_signal "${kind}" "${minutes}" "${dry_run}")" || return 1
    echo "Rebooting in ${minutes} minute(s); ${reached} project(s) warned." >&2
    if [[ "${minutes}" -gt 1 ]]; then
        if [[ "${dry_run}" == true ]]; then
            echo "would wait $((minutes - 1)) minute(s), then warn again at one minute" >&2
        else
            countdown "$(((minutes - 1) * MINUTE_SECONDS))"
            signal_projects "${kind}" 1 false >/dev/null || return 1
            echo "Rebooting in 1 minute." >&2
        fi
    fi
    if [[ "${dry_run}" == true ]]; then
        echo "would reboot (systemctl reboot)" >&2
        return 0
    fi
    countdown "${MINUTE_SECONDS}"
    # From here a signal is the shutdown reaching this process, not a cancellation, so it
    # is ignored rather than allowed to withdraw. A refused reboot is a failure, and is
    # reported as one: nobody cancelled it.
    trap '' INT TERM
    local reboot_rc=0
    systemctl reboot || reboot_rc=$?
    if [[ "${reboot_rc}" -ne 0 ]]; then
        REBOOT_FAILED=true
        print_error "the reboot failed: systemctl reboot exited ${reboot_rc} (its reason is above). The machine is staying up."
        return "${reboot_rc}"
    fi
}

cmd_restore() {
    case "${1:-}" in
    "" | --dry-run) ;;
    *)
        usage_error "unknown restore option '${1}'."
        ;;
    esac
    if [[ $# -gt 1 ]]; then
        usage_error "unexpected argument '${2}'."
    fi
    ccy_registry_restore "$@"
}

# ── set-going: a restored session's first input ──────────────────────────────────────────

# type_into <name> <text> — type the text into the session's pane, then press Enter on its
# own after SUBMIT_DELAY, the way the supervisor submits a line. Reports go to stderr.
type_into() {
    local name="${1}" text="${2}" out
    if ! out="$(ccy_tmux send-keys -t "=${name}:" -l "${text}" 2>&1)"; then
        print_error "typing into ${name} failed: ${out}"
        return 1
    fi
    sleep "${SUBMIT_DELAY}"
    if ! out="$(ccy_tmux send-keys -t "=${name}:" Enter 2>&1)"; then
        print_error "pressing Enter in ${name} failed: ${out}"
        return 1
    fi
}

# The boot set-going works for, and how many sessions it left alone in this run.
SET_GOING_BOOT=""
LEFT_ALONE=0

# going_set <name> <expect-going> <going> <at> <detail> <transcript> — record what was done
# with one session, under the manifest's lock, only while its entry still says
# <expect-going>. Afterwards RM_* hold the manifest as it now is.
going_set() {
    local rc=0
    ccy_restore_manifest_update "${SET_GOING_BOOT}" "$@" || rc=$?
    case "${rc}" in
    0) return 0 ;;
    3)
        echo "${1}: its entry in the restore manifest changed while it was being set going (a second restore this boot); that entry stands." >&2
        return 0
        ;;
    *)
        print_error "the restore manifest could not be updated for ${1}."
        return 1
        ;;
    esac
}

# leave_alone <name> <expect-going> <reason> — set-going will not touch the session: recorded
# as untouched with the reason, and named on stderr.
leave_alone() {
    LEFT_ALONE=$((LEFT_ALONE + 1))
    echo "left ${1} untouched: ${3}" >&2
    going_set "${1}" "${2}" untouched "" "${3}" ""
}

# WAITED_ON — per session, why it is not yet ready, for the reason it is left alone with if
# the wait runs out.
declare -A WAITED_ON=()

# conversation_owner <transcript> <name> — the other session already set going on this
# conversation, printed; nothing when there is none. Two sessions in one project that both
# --continue resume the same conversation: only one may drive it.
conversation_owner() {
    local i
    for i in "${!RM_NAMES[@]}"; do
        [[ "${RM_NAMES[i]}" != "${2}" && "${RM_TRANSCRIPT[i]}" == "${1}" ]] || continue
        case "${RM_GOING[i]}" in
        compacting | compact | continue)
            printf '%s\n' "${RM_NAMES[i]}"
            return 0
            ;;
        esac
    done
}

# look_at <name> <prefix> <attached> — what the session's pane shows, printed as one word:
# unreadable, dead:<why>, waiting:<prompt>, attached, not-drawn, busy, typed or ready.
look_at() {
    local name="${1}" prefix="${2}" attached="${3}" screen state
    if ! screen="$(ccy_tmux capture-pane -p -e -t "=${name}:" 2>&1)"; then
        print_error "the screen of ${name} could not be read: ${screen}"
        printf 'unreadable\n'
        return 0
    fi
    state="$(ccy_restore_verdict "${prefix}" 1 "$(ccy_screen_plain "${screen}")" up)"
    case "${state}" in
    DEAD*)
        printf 'dead:%s\n' "${state#DEAD }"
        return 0
        ;;
    WAITING-AT-PROMPT*)
        printf 'waiting:%s\n' "${state#WAITING-AT-PROMPT }"
        return 0
        ;;
    esac
    # A person attached is at the keyboard: whatever they are doing, nothing is typed over it.
    if [[ "${attached}" -gt 0 ]]; then
        printf 'attached\n'
        return 0
    fi
    ccy_claude_screen_state "${screen}"
}

# set_one_going <name> <floor> <live 0|1> <attached> — one pending session. Once its prompt
# has drawn: /compact at or above the floor (followed by continue when it has no supervisor,
# see continue_after_compaction), else continue. Left pending while there is something to
# wait for; anything that cannot be read or sent leaves it untouched, with the reason.
set_one_going() {
    local name="${1}" floor="${2}" live="${3}" attached="${4}" i state tdir file tokens
    local going text at owner
    i="$(ccy_restore_manifest_index "${name}")" || return 0
    if [[ "${live}" != 1 ]]; then
        leave_alone "${name}" pending session-not-running
        return
    fi
    state="$(look_at "${name}" "${RM_PREFIXES[i]}" "${attached}")"
    case "${state}" in
    unreadable) leave_alone "${name}" pending screen-unreadable || return 1 ;;
    dead:*) leave_alone "${name}" pending "${state#dead:}" || return 1 ;;
    waiting:*) WAITED_ON[${name}]="waiting-at-prompt-${state#waiting:}" ;;
    not-drawn) WAITED_ON[${name}]=prompt-not-drawn ;;
    attached) leave_alone "${name}" pending attached || return 1 ;;
    busy) leave_alone "${name}" pending busy-before-set-going || return 1 ;;
    typed) leave_alone "${name}" pending input-box-not-empty || return 1 ;;
    esac
    [[ "${state}" == ready ]] || return 0
    if ! tdir="$(ccy_transcript_dir "${RM_PREFIXES[i]}" "${RM_DIRS[i]}" "${CLAUDE_CONFIG_DIR:-${HOME}/.claude}")" ||
        ! file="$(ccy_transcript_for "${tdir}" "${RM_RESUME[i]}")"; then
        leave_alone "${name}" pending no-transcript
        return
    fi
    owner="$(conversation_owner "${file}" "${name}")"
    if [[ -n "${owner}" ]]; then
        echo "${name} shares its conversation with ${owner}, which is set going; left alone." >&2
        leave_alone "${name}" pending "shares-conversation-with-${owner}"
        return
    fi
    if ! tokens="$(ccy_transcript_context_tokens "${file}")"; then
        leave_alone "${name}" pending context-unreadable
        return
    fi
    going="continue"
    text="${SET_GOING_CONTINUE}"
    if [[ "${tokens}" -ge "${floor}" ]]; then
        going=compact
        text="${SET_GOING_COMPACT}"
        # Nothing carries a session with no supervisor on after its compaction: it waits as
        # compacting, and continue_after_compaction types continue once the compaction ends.
        [[ "${RM_SUPERVISED[i]}" == yes ]] || going=compacting
    fi
    # Taken before typing, so whatever the input writes to the transcript is at or after it.
    at="${EPOCHSECONDS}"
    if ! type_into "${name}" "${text}"; then
        leave_alone "${name}" pending send-failed
        return
    fi
    echo "set ${name} going: ${going} (context ${tokens} tokens, compact floor ${floor}, supervised: ${RM_SUPERVISED[i]})." >&2
    going_set "${name}" pending "${going}" "${at}" "${tokens}" "${file}"
}

# continue_after_compaction <name> <live 0|1> <attached> — a session with no supervisor that
# was typed /compact: once the transcript shows the compaction finished, type continue.
continue_after_compaction() {
    local name="${1}" live="${2}" attached="${3}" i done_yet state at
    i="$(ccy_restore_manifest_index "${name}")" || return 0
    if [[ "${live}" != 1 ]]; then
        leave_alone "${name}" compacting session-ended-while-compacting
        return
    fi
    if ! done_yet="$(ccy_transcript_compacted_since "${RM_TRANSCRIPT[i]}" "${RM_AT[i]}")"; then
        leave_alone "${name}" compacting context-unreadable
        return
    fi
    if [[ "${done_yet}" != yes ]]; then
        WAITED_ON[${name}]=compaction-not-finished
        return 0
    fi
    state="$(look_at "${name}" "${RM_PREFIXES[i]}" "${attached}")"
    case "${state}" in
    ready) ;;
    busy)
        # Something has already set it working after the compaction; that is the point.
        echo "${name} is already working after its compaction; nothing more typed." >&2
        going_set "${name}" compacting compact "${RM_AT[i]}" "${RM_DETAIL[i]}" "${RM_TRANSCRIPT[i]}"
        return
        ;;
    not-drawn)
        WAITED_ON[${name}]=prompt-not-back-after-compaction
        return 0
        ;;
    attached | typed) leave_alone "${name}" compacting "${state}-after-compaction" || return 1 ;;
    *) leave_alone "${name}" compacting "${state#*:}-after-compaction" || return 1 ;;
    esac
    [[ "${state}" == ready ]] || return 0
    at="${EPOCHSECONDS}"
    if ! type_into "${name}" "${SET_GOING_CONTINUE}"; then
        leave_alone "${name}" compacting send-failed-after-compaction
        return
    fi
    echo "set ${name} going after its compaction: continue." >&2
    going_set "${name}" compacting continue "${at}" "${RM_DETAIL[i]}" "${RM_TRANSCRIPT[i]}"
}

# work_left — the names of the manifest's sessions still to act on (pending or compacting).
work_left() {
    local i
    for i in "${!RM_NAMES[@]}"; do
        case "${RM_GOING[i]}" in
        pending | compacting) printf '%s\n' "${RM_NAMES[i]}" ;;
        esac
    done
}

cmd_set_going() {
    if [[ $# -gt 0 ]]; then
        usage_error "'set-going' takes no arguments."
    fi
    local floor="${CCY_RESTORE_COMPACT_FLOOR_TOKENS:-}" deadline listing name attached _dir lock fd i waited
    local -a work=()
    local -A is_live=() attached_to=()
    # One set-going at a time: a second restore in the same boot starts another, which waits
    # here and then finds whatever that restore added still pending.
    lock="$(ccy_registry_manifest_path).set-going.lock" || return 1
    if ! exec {fd}>>"${lock}"; then
        print_error "could not open set-going's lock ${lock}"
        return 1
    fi
    if ! flock -w "${SET_GOING_WAIT}" "${fd}"; then
        print_error "another set-going still holds ${lock} after ${SET_GOING_WAIT}s; nothing was set going by this one."
        return 1
    fi
    if ! ccy_restore_manifest_read; then
        print_error "this boot's restore recorded no sessions, so nothing can be set going; journalctl --user -u ccy-sessions-restore -b --no-pager | cat says why."
        return 1
    fi
    SET_GOING_BOOT="$(ccy_boot_id)" || return 1
    if [[ "${RM_BOOT}" != "${SET_GOING_BOOT}" ]]; then
        print_error "the restore manifest is from an earlier boot: this boot's restore failed before writing one (journalctl --user -u ccy-sessions-restore -b --no-pager | cat), so nothing is set going."
        return 1
    fi
    mapfile -t work < <(work_left)
    if [[ "${#work[@]}" -eq 0 ]]; then
        echo "No session this boot's restore started is waiting to be set going." >&2
        return 0
    fi
    if [[ ! "${floor}" =~ ^[1-9][0-9]*$ ]]; then
        print_error "CCY_RESTORE_COMPACT_FLOOR_TOKENS is '${floor}', not a whole number of tokens, so no restored session can be set going. ccy-sessions-set-going.service sets it from ccy_restore_compact_floor_tokens (play-claude-yolo.yml)."
        for name in "${work[@]}"; do
            i="$(ccy_restore_manifest_index "${name}")" || continue
            leave_alone "${name}" "${RM_GOING[i]}" no-compact-floor || return 1
        done
        return 1
    fi
    deadline=$((SECONDS + SET_GOING_WAIT))
    while :; do
        is_live=()
        attached_to=()
        if ! listing="$(ccy_tmux_list)"; then
            print_error "the live session list could not be read, so no further session can be set going."
            for name in "${work[@]}"; do
                i="$(ccy_restore_manifest_index "${name}")" || continue
                leave_alone "${name}" "${RM_GOING[i]}" session-list-unreadable || return 1
            done
            return 1
        fi
        while read -r name attached _dir; do
            [[ -n "${name}" ]] || continue
            is_live["${name}"]=1
            attached_to["${name}"]="${attached:-0}"
        done <<<"${listing}"
        for name in "${work[@]}"; do
            i="$(ccy_restore_manifest_index "${name}")" || continue
            case "${RM_GOING[i]}" in
            pending)
                set_one_going "${name}" "${floor}" "${is_live[${name}]:-0}" "${attached_to[${name}]:-0}" || return 1
                ;;
            compacting)
                continue_after_compaction "${name}" "${is_live[${name}]:-0}" "${attached_to[${name}]:-0}" || return 1
                ;;
            esac
        done
        ccy_restore_manifest_read || return 1
        mapfile -t work < <(work_left)
        [[ "${#work[@]}" -gt 0 ]] || break
        if [[ "${SECONDS}" -ge "${deadline}" ]]; then
            for name in "${work[@]}"; do
                i="$(ccy_restore_manifest_index "${name}")" || continue
                waited=prompt-not-drawn
                [[ "${RM_GOING[i]}" != compacting ]] || waited=compaction-not-finished
                leave_alone "${name}" "${RM_GOING[i]}" \
                    "${WAITED_ON[${name}]:-${waited}}-after-${SET_GOING_WAIT}s" || return 1
            done
            break
        fi
        sleep "${POLL_SECONDS}"
    done
    if [[ "${LEFT_ALONE}" -gt 0 ]]; then
        print_error "${LEFT_ALONE} restored session(s) were not set going; each is named above, and verify-restore reports it."
        return 1
    fi
}

# restore_states — "<name> <STATE>[ <detail>]" for every session in the manifest (RM_*),
# from one pass over the host: the live list, one screen capture per live session, one
# process table, one engine query per engine a session uses, and the transcript of each
# session set going. A probe that fails is a failure, never a state: "could not look" must
# not read as "dead" or as "fine".
restore_states() {
    local listing containers name engine container i live screen state took going
    local -A is_live=() client=() running=() engines=()
    listing="$(ccy_tmux_list)" || return 1
    while read -r name _; do
        [[ -n "${name}" ]] && is_live["${name}"]=1
    done <<<"${listing}"

    if ! containers="$(session_containers)"; then
        return 1
    fi
    while read -r name engine container; do
        [[ -n "${name}" && "${container}" != "-" ]] || continue
        client["${name}"]="${container}"
        engines["${engine}"]=1
    done <<<"${containers}"
    for engine in "${!engines[@]}"; do
        if ! listing="$("${engine}" ps --filter label=ccy=true --format '{{.Names}}' 2>&1)"; then
            print_error "${engine} ps failed: ${listing}"
            return 1
        fi
        while read -r container; do
            [[ -n "${container}" ]] && running["${container}"]=1
        done <<<"${listing}"
    done

    for i in "${!RM_NAMES[@]}"; do
        name="${RM_NAMES[i]}"
        live=0
        screen=""
        container="-"
        if [[ -n "${is_live[${name}]:-}" ]]; then
            live=1
            if ! screen="$(ccy_tmux capture-pane -p -t "=${name}:" 2>&1)"; then
                print_error "the screen of ${name} could not be read: ${screen}"
                return 1
            fi
            if [[ -n "${client[${name}]:-}" ]]; then
                container=starting
                if [[ -n "${running[${client[${name}]}]:-}" ]]; then
                    container=up
                fi
            fi
        fi
        took=-
        case "${RM_GOING[i]}" in
        compacting | compact | continue)
            took="$(ccy_transcript_took_input_since "${RM_TRANSCRIPT[i]}" "${RM_AT[i]}")" || return 1
            ;;
        esac
        going="$(ccy_restore_going_state "${RM_GOING[i]}" "${RM_AT[i]}" "${RM_DETAIL[i]}" \
            "${EPOCHSECONDS}" "${START_WINDOW}" "${took}")"
        state="$(ccy_restore_verdict "${RM_PREFIXES[i]}" "${live}" "${screen}" "${container}" "${going}")"
        printf '%s %s\n' "${name}" "${state}"
    done
}

cmd_verify_restore() {
    local wait=0 deadline states boot previous=""
    while [[ $# -gt 0 ]]; do
        case "${1}" in
        --wait)
            [[ "${2:-}" =~ ^[0-9]+$ ]] || usage_error "--wait needs a whole number of seconds; got '${2:-}'."
            wait="${2}"
            shift 2
            ;;
        *)
            usage_error "unknown verify-restore option '${1}'."
            ;;
        esac
    done
    ccy_restore_manifest_read || return 1
    boot="$(ccy_boot_id)" || return 1
    if [[ "${RM_BOOT}" != "${boot}" ]]; then
        print_error "the last session restore ran in an earlier boot, so it says nothing about this one; nothing restored these sessions since this machine started."
        return 1
    fi
    if [[ "${#RM_NAMES[@]}" -eq 0 ]]; then
        echo "This boot's restore brought up no sessions; nothing to verify." >&2
        return 0
    fi
    # Settled: every session OK, or none still STARTING or SETTING-GOING and the same report
    # read twice running, so a prompt seen for one poll while the launcher answers it is
    # not taken for where the session stopped.
    deadline=$((SECONDS + wait))
    while :; do
        states="$(restore_states)" || return 1
        if ! grep -qv ' OK$' <<<"${states}" || [[ "${SECONDS}" -ge "${deadline}" ]]; then
            break
        fi
        if [[ "${states}" == "${previous}" ]] && ! grep -qE ' (STARTING|SETTING-GOING)$' <<<"${states}"; then
            break
        fi
        previous="${states}"
        sleep "${POLL_SECONDS}"
    done
    printf '%s\n' "${states}"
    if grep -qv ' OK$' <<<"${states}"; then
        echo "Not every restored session is running and past its prompts; attach with ccy-sessions to answer or look." >&2
        return 1
    fi
}

case "${subcommand}" in
notify)
    cmd_notify "$@"
    exit
    ;;
reboot)
    cmd_reboot "$@"
    exit
    ;;
restore)
    cmd_restore "$@"
    exit
    ;;
set-going)
    cmd_set_going "$@"
    exit
    ;;
verify-restore)
    cmd_verify_restore "$@"
    exit
    ;;
esac

# ── the table: the picker's rows, and --list ─────────────────────────────────────────────

# rows — every session as a picker row, in the library's house format.
#
# The CPU, network, token and key columns are filled from one pass over the host (see
# ccy_tmux_detail_rows), not one lookup per row, so refreshing the list costs the same with
# ten sessions as with one. A probe that fails leaves those columns reading "unknown" on
# every row: the reason is already on stderr, and a blank there would be read as "none".
rows() {
    local name attached dir word token keys cpu details listing
    local -A network_of=() token_of=() keys_of=() cpu_of=()
    if details="$(ccy_tmux_detail_rows)"; then
        while IFS=$'\t' read -r name word token keys cpu; do
            [[ -n "${name}" ]] || continue
            network_of["${name}"]="${word}"
            token_of["${name}"]="${token}"
            keys_of["${name}"]="${keys}"
            cpu_of["${name}"]="${cpu}"
        done <<<"${details}"
    else
        echo "The CPU, network, token and SSH key columns read 'unknown' for every session — see the error above." >&2
    fi
    # Read whole first: a failed listing read through a process substitution would pass for
    # "no sessions".
    listing="$(ccy_tmux_list)" || return 1
    while read -r name attached dir; do
        [[ -n "${name}" ]] || continue
        ccy_tmux_row "${name}" "${attached}" "${dir}" "${network_of[${name}]:-unknown}" \
            "${token_of[${name}]:-unknown}" "${keys_of[${name}]:-unknown}" "${cpu_of[${name}]:-unknown}"
        printf '\n'
    done <<<"${listing}"
}

if [[ "${subcommand}" == -l || "${subcommand}" == --list ]]; then
    listing="$(rows)" || exit 1
    if [[ -z "${listing}" ]]; then
        echo "No CCY or cc sessions are running." >&2
        exit 0
    fi
    ccy_tmux_row_heading
    printf '\n%s\n' "${listing}"
    exit 0
fi

# ── the picker ───────────────────────────────────────────────────────────────────────────
# Only the picker needs a terminal: it attaches sessions to the one it runs in. The
# subcommands above run headless — the restore unit has no terminal, and a reboot helper
# is as likely to be run over ssh as from a desktop.
if [[ ! -t 0 || ! -t 1 ]]; then
    echo "ccy-sessions needs a terminal: it attaches sessions to the one you are in. ccy-sessions --list prints the table instead." >&2
    exit 1
fi

# confirm_end <name> — end a session and everything in it, after the picker's yes/no
# (no is the default row). An ended session is not a session to restore: its record goes
# with it, since a kill-session never lets the pane's trampoline remove it.
confirm_end() {
    local name="${1}"
    if ccy_tmux_confirm "End ${name}?" "Everything running in it will be killed." "end '${name}'"; then
        ccy_tmux kill-session -t "=${name}"
        ccy_registry_remove "${name}"
        echo "Ended '${name}'." >&2
    else
        echo "Kept '${name}'." >&2
    fi
}

# attach_here <name> — attach a detached session; exits once the user detaches again. Returns
# only when the session was taken or ended between the list and the key, or another terminal
# was on it afterwards (the library said so), which counts as a try.
attach_here() {
    local rc=0
    ccy_tmux_attach "${1}" || rc=$?
    case "${rc}" in
    0) exit 0 ;;
    3) ;;
    *) echo "'${1}' was taken or ended just now — the list has been refreshed." >&2 ;;
    esac
    return 0
}

# The sessions a take-over was tried on without attaching here: it may have detached their
# other terminal, so after the tries run out "Nothing changed" would not be true.
DETACHED_FROM=()

# confirm_take_over <name> — take a session over from the terminal it is open on, after the
# picker's yes/no naming that terminal and how long it has been idle (no is the default row).
# Asks list-clients, the hook's own view, rather than trusting the row's state: a client tmux
# leaves out of the row's count can still hold the session. Nobody holding it: attaches as
# Enter does. Returns 0 when declined, so the list comes back without using a try; 1 when the
# session ended or was taken again meanwhile. Exits 0 after attaching, and 1 on any other
# failure, whose reason the library has already printed.
confirm_take_over() {
    local name="${1}" others rc=0
    others="$(ccy_tmux_other_terminals "${name}")" || rc=$?
    if [[ "${rc}" -eq 2 ]]; then
        echo "'${name}' has ended — the list has been refreshed." >&2
        return 1
    elif [[ "${rc}" -ne 0 ]]; then
        exit 1
    fi
    if [[ -z "${others}" ]]; then
        attach_here "${name}"
        return 1
    fi
    if ! ccy_tmux_confirm "Take over ${name}?" \
        "It is open on ${others}. That terminal is detached, not closed, and the session keeps running." \
        "take over '${name}'"; then
        echo "Left '${name}' where it is." >&2
        return 0
    fi
    rc=0
    ccy_tmux_take_over "${name}" || rc=$?
    case "${rc}" in
    0) exit 0 ;;
    2)
        DETACHED_FROM+=("${name}")
        echo "The list has been refreshed." >&2
        return 1
        ;;
    *) exit 1 ;;
    esac
}

# A new session is only ever started the normal way — by running ccy itself, which does
# every check and prompt it always does — and only from a project folder, which for ccy
# means a git work tree. Anywhere else the key is shown as unavailable rather than hidden.
here="${PWD/#${HOME}/\~}"
project_here() {
    local probe
    probe="$(git rev-parse --is-inside-work-tree 2>&1)" && [[ "${probe}" == "true" ]]
}
start_ccy_here() {
    echo "Starting ccy in ${here}." >&2
    exec "${CCY_LAUNCHER}"
}

if project_here; then
    new_line="Ctrl-N starts a new ccy session in ${here}"
else
    new_line="Ctrl-N unavailable: ${here} is not a project folder (no git repository)"
fi
HEADER="$(ccy_tmux_header "Enter attach   Ctrl-T take over   Ctrl-X end   Ctrl-N new   Esc or q quit" \
    "${new_line}" \
    "\"open elsewhere\" is attached in another terminal: Ctrl-T detaches that terminal and attaches this one; the session keeps running" \
    "CPU: over the last second, 100% is one core" \
    "network, token, SSH key: what its container is on and was started with — \"no container\" and \"-\" mean nothing to ask")"

attempt=1
while :; do
    listing="$(rows)" || exit 1
    if [[ -z "${listing}" ]]; then
        if project_here; then
            if ccy_tmux_confirm "CCY sessions" "No sessions are running. Start ccy in ${here}?" "start ccy here"; then
                start_ccy_here
            fi
            exit 0
        fi
        echo "No CCY or cc sessions are running. Start one with ccy or cc in a project directory." >&2
        exit 0
    fi
    # The picker prints the key that closed it (empty for Enter), then the chosen row.
    if ! picked="$(ccy_tmux_pick "CCY sessions" "${HEADER}" "ctrl-t,ctrl-x,ctrl-n" <<<"${listing%$'\n'}")"; then
        exit 0 # Esc or q
    fi
    key="${picked%%$'\n'*}"
    row="${picked#*$'\n'}"
    name="${row%% *}"

    case "${key}" in
    ctrl-n)
        if project_here; then
            start_ccy_here
        fi
        echo "${here} is not a project folder (no git repository), so ccy cannot be started here." >&2
        ;;
    ctrl-x)
        confirm_end "${name}"
        continue
        ;;
    ctrl-t)
        if confirm_take_over "${name}"; then
            continue
        fi
        ;;
    *)
        if [[ "${row}" != *"open elsewhere"* ]]; then
            attach_here "${name}"
        else
            echo "'${name}' is open in another terminal. Ctrl-T takes it over here; Ctrl-X ends it." >&2
        fi
        ;;
    esac
    attempt=$((attempt + 1))
    if [[ "${attempt}" -gt "${MAX_TRIES}" ]]; then
        if [[ "${#DETACHED_FROM[@]}" -gt 0 ]]; then
            echo "Nothing attached after ${MAX_TRIES} tries. A take-over was tried on ${DETACHED_FROM[*]}; what each one did is above." >&2
        else
            echo "Nothing attached after ${MAX_TRIES} tries. Nothing changed." >&2
        fi
        exit 1
    fi
done
