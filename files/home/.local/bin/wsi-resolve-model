#!/usr/bin/env python3
"""wsi-resolve-model - print the faster-whisper model a recorder should load.

    wsi-resolve-model --mode batch|streaming [--language CODE] [MODEL]

MODEL is the panel's Whisper Model setting (WHISPER_MODEL); empty or `auto` means
choose. `auto` with a CUDA device picks distil-large-v3.5 for English and
large-v3-turbo for any other language (or language detection); without one it picks
small for batch and base for streaming. The CUDA check is CTranslate2's own device
count, the one faster-whisper's engine uses.

stdout is the argument for faster-whisper's WhisperModel and nothing else: a model
name, or a Hugging Face repo ID for a name the installed faster-whisper may not know.
Diagnostics go to stderr. Not interactive: the recorders treat failure as fatal.
"""

import argparse
import sys

AUTO_WITHOUT_GPU = {"batch": "small", "streaming": "base"}
AUTO_GPU_ENGLISH = "distil-large-v3.5"
AUTO_GPU_OTHER = "large-v3-turbo"

# faster-whisper maps distil-large-v3.5 to this repo from 1.2.0 (faster_whisper/utils.py
# _MODELS); 1.1.1, which RealtimeSTT 0.3.x pins, rejects the name as an "Invalid model
# size". A repo ID loads on every version, so the name is never handed over bare.
REPO_FOR_NAME = {"distil-large-v3.5": "distil-whisper/distil-large-v3.5-ct2"}

ENGLISH_ONLY = {"distil-large-v3.5"}


def is_english_only(name):
    return name.endswith(".en") or name in ENGLISH_ONLY


def cuda_device_count():
    """CUDA devices CTranslate2 can use. Raises if CTranslate2 cannot answer."""
    import ctranslate2
    count = int(ctranslate2.get_cuda_device_count())
    if count < 0:
        raise ValueError(f"CTranslate2 reported {count} CUDA devices")
    return count


def choose_auto(mode, language, gpu_count):
    if gpu_count == 0:
        return AUTO_WITHOUT_GPU[mode]
    return AUTO_GPU_ENGLISH if language == "en" else AUTO_GPU_OTHER


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="wsi-resolve-model",
        description="Print the faster-whisper model a speech-to-text recorder should load.")
    parser.add_argument("--mode", required=True, choices=sorted(AUTO_WITHOUT_GPU),
                        help="which recorder asks: batch (wsi) or streaming (wsi-stream)")
    parser.add_argument("--language", default="",
                        help="transcription language code; empty for language detection")
    parser.add_argument("model", nargs="?", default="auto",
                        help="the Whisper Model setting; empty or 'auto' to choose (default: auto)")
    args = parser.parse_args(argv)
    language = args.language.strip().lower()
    name = args.model.strip() or "auto"

    if name == "auto":
        try:
            gpu_count = cuda_device_count()
        except Exception as e:
            print(f"wsi-resolve-model: cannot ask CTranslate2 for CUDA devices: {e}", file=sys.stderr)
            print("wsi-resolve-model: re-run play-speech-to-text.yml (installs faster-whisper)",
                  file=sys.stderr)
            return 1
        name = choose_auto(args.mode, language, gpu_count)
        print(f"wsi-resolve-model: auto -> {name} ({'GPU' if gpu_count else 'no GPU'}, "
              f"{args.mode}, language {language or 'detected'})", file=sys.stderr)

    if is_english_only(name) and language not in ("", "en"):
        print(f"wsi-resolve-model: {name} is English only, but the language is '{language}'. "
              "Choose a multilingual model, or set the language to English.", file=sys.stderr)
        return 1

    print(REPO_FOR_NAME.get(name, name))
    return 0


if __name__ == "__main__":
    sys.exit(main())
