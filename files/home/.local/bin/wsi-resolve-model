#!/usr/bin/env python3
"""wsi-resolve-model - print the faster-whisper model a recorder should load.

    wsi-resolve-model [--suggest] --mode batch|streaming [--language CODE] [MODEL]
    wsi-resolve-model --realtime [--language CODE]
    wsi-resolve-model --realtime-models
    wsi-resolve-model --gpu-count
    wsi-resolve-model --fit

MODEL is the panel's Whisper Model setting (WHISPER_MODEL); empty or `auto` means
choose. `auto` with a CUDA device picks distil-large-v3.5 for English and
large-v3-turbo for any other language (or language detection); without one it picks
small for batch and base for streaming. The CUDA check is CTranslate2's own device
count, the one faster-whisper's engine uses.

CTranslate2 answers 0, not an error, when it cannot reach a GPU that is there (a
broken CUDA or cuDNN install, a driver mismatch). So a count of 0 on a machine with
NVIDIA device nodes (/dev/nvidia0, ...) is a failure, never a quiet CPU fallback.

No model is downloaded for the user, so the model is named only when its weights
(model.bin) are on disk, in the Hugging Face cache or in a model directory given as
MODEL. Otherwise the exit is 3, and the last stderr line says what to download and
where, for the panel to show. A recorder never reaches faster-whisper with a model it
would download. --suggest names the choice without that check, for Settings, the
model manager and the play's verify task.

--realtime names the model wsi-stream's live preview loads beside the main one
(RealtimeSTT's realtime_model_type), checked on disk the same way; --realtime-models
lists every one, for play-speech-to-text.yml's download.

--gpu-count prints the checked count alone, for the play's verify task.

--fit prints one JSON object for the model manager: `device` (cuda or cpu), `gpu` and
`gpu_memory_mb` (nvidia-smi's name and total memory of the smallest NVIDIA GPU, null on
the CPU), and `models`, each offered model's `size_mb`, `needs_mb` (GPU memory, by the
rule at NEED_FACTOR) and `fits`. On the CPU every model fits. It fails, exit 1, when the
GPU check above fails or nvidia-smi cannot answer, never guessing a fit.

stdout is the argument for faster-whisper's WhisperModel (or the count) and nothing
else: a model name, a model directory, or a Hugging Face repo ID for a name the
installed faster-whisper may not know. Diagnostics go to stderr. Not interactive: the
recorders treat failure as fatal.

Exit: 0 resolved; 1 cannot choose (GPU probe, language, unknown name); 2 usage;
3 the model is not downloaded.
"""

import argparse
import glob
import json
import math
import os
import shutil
import subprocess
import sys
from pathlib import Path

AUTO_WITHOUT_GPU = {"batch": "small", "streaming": "base"}
AUTO_GPU_ENGLISH = "distil-large-v3.5"
AUTO_GPU_OTHER = "large-v3-turbo"

# faster-whisper 1.2.1 maps distil-large-v3.5 to this repo (faster_whisper/utils.py
# _MODELS, read in the 1.2.1 wheel); 1.1.1, which RealtimeSTT 0.3.104 pins, has no such
# entry and rejects the name as an "Invalid model size" (read in the 1.1.1 wheel). Both
# load any `org/name` as a repo ID, so the name is never handed over bare.
REPO_FOR_NAME = {"distil-large-v3.5": "distil-whisper/distil-large-v3.5-ct2"}

ENGLISH_ONLY = {"distil-large-v3.5"}

# The live preview re-transcribes the whole utterance every 0.2 s while it is spoken, so
# its model must be the fastest there is; the main model then writes the final text.
# tiny.en is more accurate than tiny in English at the same size. Left unnamed,
# RealtimeSTT loads "tiny", which nothing downloads. 75 MiB each, so the play fetches
# both and a language change in Settings never finds its preview model missing.
REALTIME_ENGLISH = "tiny.en"
REALTIME_OTHER = "tiny"
REALTIME_MODELS = (REALTIME_ENGLISH, REALTIME_OTHER)

# The repo faster-whisper downloads for each name it knows, so the cache can be checked
# without importing it: faster_whisper/utils.py _MODELS in the 1.2.1 wheel (1.1.1's is
# the same less distil-large-v3.5). wsi-model-manager and the Settings list offer a
# subset, and a test holds the three to the same repos.
HF_REPO = {
    "tiny.en": "Systran/faster-whisper-tiny.en",
    "tiny": "Systran/faster-whisper-tiny",
    "base.en": "Systran/faster-whisper-base.en",
    "base": "Systran/faster-whisper-base",
    "small.en": "Systran/faster-whisper-small.en",
    "small": "Systran/faster-whisper-small",
    "medium.en": "Systran/faster-whisper-medium.en",
    "medium": "Systran/faster-whisper-medium",
    "large-v1": "Systran/faster-whisper-large-v1",
    "large-v2": "Systran/faster-whisper-large-v2",
    "large-v3": "Systran/faster-whisper-large-v3",
    "large": "Systran/faster-whisper-large-v3",
    "distil-large-v2": "Systran/faster-distil-whisper-large-v2",
    "distil-medium.en": "Systran/faster-distil-whisper-medium.en",
    "distil-small.en": "Systran/faster-distil-whisper-small.en",
    "distil-large-v3": "Systran/faster-distil-whisper-large-v3",
    "distil-large-v3.5": "distil-whisper/distil-large-v3.5-ct2",
    "large-v3-turbo": "mobiuslabsgmbh/faster-whisper-large-v3-turbo",
    "turbo": "mobiuslabsgmbh/faster-whisper-large-v3-turbo",
}

# What each model the manager offers downloads, in MiB, rounded up: the sum of the repo's
# file sizes from the Hugging Face API (/api/models/<repo>?blobs=true). model.bin is all
# but a few MiB of it, float16, as faster-whisper loads it on CUDA.
SIZE_MB = {
    "tiny": 75, "base": 142, "small": 464, "medium": 1460,
    "large-v2": 2947, "large-v3": 2948, "large-v3-turbo": 1547,
    "tiny.en": 75, "base.en": 141, "small.en": 464, "medium.en": 1460,
    "distil-large-v3.5": 1447,
}

# GPU memory a model needs: its weights x 1.25 plus 850 MiB for the CUDA context and
# decoding. Calibrated on faster-whisper's README figure for large-v2 in float16 with
# beam 5 (4525 MiB); this rule gives 4534.
NEED_FACTOR = 1.25
NEED_OVERHEAD_MB = 850

NOT_DOWNLOADED = 3
MANAGER_HINT = ("Open the model manager (Manage Whisper Models... in the speech-to-text "
                "panel menu, or wsi-model-manager) and download")

# Where the NVIDIA driver creates one node per GPU. WSI_DEV_DIR exists for the tests.
DEV_DIR = os.environ.get("WSI_DEV_DIR", "/dev")


class GpuNotVisible(RuntimeError):
    """NVIDIA GPUs are present but CTranslate2 counts none."""


def is_english_only(name):
    return name.endswith(".en") or name in ENGLISH_ONLY


def nvidia_device_nodes():
    """The NVIDIA GPU device nodes on this machine (/dev/nvidia0, /dev/nvidia1, ...)."""
    return sorted(glob.glob(os.path.join(DEV_DIR, "nvidia[0-9]*")))


def cuda_device_count():
    """CUDA devices CTranslate2 can use.

    Raises if CTranslate2 cannot answer, and GpuNotVisible if it answers 0 while
    NVIDIA GPU device nodes exist.
    """
    import ctranslate2
    count = int(ctranslate2.get_cuda_device_count())
    if count < 0:
        raise ValueError(f"CTranslate2 reported {count} CUDA devices")
    nodes = nvidia_device_nodes()
    if count == 0 and nodes:
        raise GpuNotVisible(
            f"this machine has NVIDIA GPUs ({', '.join(nodes)}) but CTranslate2 counts 0 "
            "CUDA devices, so the GPU cannot be used (a broken CUDA/cuDNN install or a "
            "driver mismatch). Check `nvidia-smi`, then re-run play-nvidia.yml and "
            "play-speech-to-text.yml.")
    return count


def realtime_model(language):
    return REALTIME_ENGLISH if language == "en" else REALTIME_OTHER


def choose_auto(mode, language, gpu_count):
    if gpu_count == 0:
        return AUTO_WITHOUT_GPU[mode]
    return AUTO_GPU_ENGLISH if language == "en" else AUTO_GPU_OTHER


def hub_cache():
    """The Hugging Face hub cache, found as huggingface_hub finds it."""
    if os.environ.get("HF_HUB_CACHE"):
        return Path(os.environ["HF_HUB_CACHE"])
    if os.environ.get("HF_HOME"):
        return Path(os.environ["HF_HOME"]) / "hub"
    cache = os.environ.get("XDG_CACHE_HOME") or os.path.join(os.path.expanduser("~"), ".cache")
    return Path(cache) / "huggingface" / "hub"


def has_weights(model):
    """Whether WhisperModel(model) would load from disk: model.bin in the model
    directory, or in a cache snapshot of the model's repo. is_file() follows the
    snapshot's symlink, so weights whose blob is gone count as absent."""
    if os.path.isdir(model):
        return Path(model, "model.bin").is_file()
    repo = HF_REPO.get(model, model)
    snapshots = hub_cache() / ("models--" + repo.replace("/", "--")) / "snapshots"
    return snapshots.is_dir() and any((rev / "model.bin").is_file()
                                      for rev in snapshots.iterdir())


def downloaded_names():
    """The names this machine can transcribe with, one per repo."""
    names = {}
    for name, repo in HF_REPO.items():
        if repo not in names and has_weights(name):
            names[repo] = name
    return sorted(names.values())


def not_downloaded_reason(name, picked_by_auto):
    """One line: which model is missing, and what to do about it."""
    have = downloaded_names()
    if not have:
        return (f"No speech model is downloaded. {MANAGER_HINT} at least one; "
                f"{name} is the one suggested for this machine.")
    which = (f"auto picked {name} for this machine" if picked_by_auto
             else f"The Whisper Model setting is {name}")
    return (f"{which}, which is not downloaded. {MANAGER_HINT} it, or choose one you "
            f"have in Settings: {', '.join(have)}.")


def realtime_not_downloaded_reason(name):
    return (f"The live preview model {name} is not downloaded. {MANAGER_HINT} it, or "
            "re-run play-speech-to-text.yml, which downloads it.")


def checked_gpu_count():
    """cuda_device_count(), or None after saying why on stderr."""
    try:
        return cuda_device_count()
    except GpuNotVisible as e:
        print(f"wsi-resolve-model: {e}", file=sys.stderr)
    except Exception as e:
        print(f"wsi-resolve-model: cannot ask CTranslate2 for CUDA devices: {e}", file=sys.stderr)
        print("wsi-resolve-model: re-run play-speech-to-text.yml (installs faster-whisper)",
              file=sys.stderr)
    return None


def gpu_memory_needed_mb(name):
    return math.ceil(SIZE_MB[name] * NEED_FACTOR + NEED_OVERHEAD_MB)


def smallest_nvidia_gpu():
    """(name, total MiB) of the NVIDIA GPU with the least memory, from nvidia-smi: with
    several, the one CTranslate2 uses may be any of them. Raises with the reason."""
    smi = shutil.which("nvidia-smi")
    if smi is None:
        raise RuntimeError("nvidia-smi is not installed, so the GPU's memory cannot be read. "
                           "Re-run play-nvidia.yml.")
    result = subprocess.run([smi, "--query-gpu=name,memory.total",
                             "--format=csv,noheader,nounits"],
                            capture_output=True, text=True, timeout=30, check=False)
    if result.returncode != 0:
        reason = result.stderr.strip() or result.stdout.strip()
        raise RuntimeError(f"nvidia-smi failed (exit {result.returncode}): {reason}")
    gpus = []
    for line in result.stdout.splitlines():
        name, _, memory = line.rpartition(",")
        if not name.strip() or not memory.strip().isdigit():
            raise RuntimeError(f"cannot read nvidia-smi's answer {line!r}: expected "
                               "'<name>, <MiB>'")
        gpus.append((name.strip(), int(memory)))
    if not gpus:
        raise RuntimeError("nvidia-smi lists no GPU, but CTranslate2 counts one")
    return min(gpus, key=lambda gpu: gpu[1])


def fit_report(gpu):
    """Each offered model's size, GPU memory need and whether it fits `gpu`, a
    (name, MiB) pair, or None when the CPU is used and every model fits."""
    return {
        "device": "cpu" if gpu is None else "cuda",
        "gpu": None if gpu is None else gpu[0],
        "gpu_memory_mb": None if gpu is None else gpu[1],
        "models": {name: {"size_mb": size, "needs_mb": gpu_memory_needed_mb(name),
                          "fits": gpu is None or gpu_memory_needed_mb(name) <= gpu[1]}
                   for name, size in SIZE_MB.items()},
    }


def print_fit():
    gpu_count = checked_gpu_count()
    if gpu_count is None:
        return 1
    try:
        gpu = smallest_nvidia_gpu() if gpu_count else None
    except (RuntimeError, OSError, subprocess.TimeoutExpired) as e:
        print(f"wsi-resolve-model: {e}", file=sys.stderr)
        return 1
    print(json.dumps(fit_report(gpu)))
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="wsi-resolve-model",
        description="Print the faster-whisper model a speech-to-text recorder should load.")
    parser.add_argument("--gpu-count", action="store_true",
                        help="print the CUDA device count CTranslate2 sees, checked against "
                             "the NVIDIA device nodes, and nothing else")
    parser.add_argument("--fit", action="store_true",
                        help="print, as JSON, which offered models fit this machine's GPU")
    parser.add_argument("--realtime", action="store_true",
                        help="name the live preview model for the language, checked on disk")
    parser.add_argument("--realtime-models", action="store_true",
                        help="print every live preview model, one per line")
    parser.add_argument("--suggest", action="store_true",
                        help="name the model without checking that it is downloaded")
    parser.add_argument("--mode", choices=sorted(AUTO_WITHOUT_GPU),
                        help="which recorder asks: batch (wsi) or streaming (wsi-stream)")
    parser.add_argument("--language", default="",
                        help="transcription language code; empty for language detection")
    parser.add_argument("model", nargs="?", default="auto",
                        help="the Whisper Model setting; empty or 'auto' to choose (default: auto)")
    args = parser.parse_args(argv)

    if args.gpu_count:
        gpu_count = checked_gpu_count()
        if gpu_count is None:
            return 1
        print(gpu_count)
        return 0
    if args.fit:
        return print_fit()
    if args.realtime_models:
        print("\n".join(REALTIME_MODELS))
        return 0
    if args.realtime and args.mode is not None:
        parser.error("--realtime names its own model: give no --mode")
    if args.mode is None and not args.realtime:
        parser.error("--mode is required (or --realtime, --realtime-models, --gpu-count, "
                     "or --fit)")

    language = args.language.strip().lower()
    if args.realtime:
        name = realtime_model(language)
        if not args.suggest and not has_weights(name):
            print(f"wsi-resolve-model: {realtime_not_downloaded_reason(name)}", file=sys.stderr)
            return NOT_DOWNLOADED
        print(name)
        return 0

    name = args.model.strip() or "auto"
    picked_by_auto = name == "auto"

    if picked_by_auto:
        gpu_count = checked_gpu_count()
        if gpu_count is None:
            return 1
        name = choose_auto(args.mode, language, gpu_count)
        print(f"wsi-resolve-model: auto -> {name} ({'GPU' if gpu_count else 'no GPU'}, "
              f"{args.mode}, language {language or 'detected'})", file=sys.stderr)

    if is_english_only(name) and language not in ("", "en"):
        print(f"wsi-resolve-model: {name} is English only, but the language is '{language}'. "
              "Choose a multilingual model, or set the language to English.", file=sys.stderr)
        return 1

    if name not in HF_REPO and "/" not in name and not os.path.isdir(name):
        print(f"wsi-resolve-model: '{name}' is not a model faster-whisper knows. Choose one "
              "in Settings.", file=sys.stderr)
        return 1

    if not args.suggest and not has_weights(name):
        print(f"wsi-resolve-model: {not_downloaded_reason(name, picked_by_auto)}",
              file=sys.stderr)
        return NOT_DOWNLOADED

    print(REPO_FOR_NAME.get(name, name))
    return 0


if __name__ == "__main__":
    sys.exit(main())
