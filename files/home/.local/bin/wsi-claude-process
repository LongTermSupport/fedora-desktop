#!/bin/bash
#
# wsi-claude-process - Post-process speech-to-text transcriptions with Claude Code
#
# Usage:
#   wsi-claude-process [OPTIONS] <transcription-text>
#
# Options:
#   -m, --model MODEL      Claude model (sonnet/opus/haiku, default: sonnet)
#   -s, --style STYLE      Processing style (corporate/natural, default: corporate)
#   -d, --debug            Enable debug logging
#
# Description:
#   Reads prompt template from ~/.config/speech-to-text/claude-prompt-{style}.txt
#   Replaces {TRANSCRIPTION} placeholder with actual transcribed text
#   Calls the Claude Code CLI headless, as the account the `claude-token` setting
#   names (a token in ~/.claude-tokens/ccy/tokens/, as cc and ccy use), or the
#   desktop login when the setting is empty
#   Prints the reformatted text. On any failure it prints nothing, says why on
#   stderr and exits 1: the caller must never mistake the raw text for Claude's.
#

set -euo pipefail

# Configuration
CONFIG_DIR="${HOME}/.config/speech-to-text"
LOG_DIR="${HOME}/.local/share/speech-to-text"
LOG_FILE="${LOG_DIR}/debug.log"
TOKEN_DIR="${HOME}/.claude-tokens/ccy/tokens"
SETTING_READER="$(dirname "$(readlink -f "$0")")/wsi-setting"
# Below the callers' own limits (180 s), so this script reports the timeout itself
CLAUDE_TIMEOUT_SECONDS=170
DEBUG_MODE=false
CLAUDE_MODEL="sonnet"
STYLE="corporate"
TWEAK=""

# Parse arguments
TRANSCRIPTION=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -m|--model)
            CLAUDE_MODEL="$2"
            shift 2
            ;;
        -s|--style)
            STYLE="$2"
            shift 2
            ;;
        -d|--debug)
            DEBUG_MODE=true
            shift
            ;;
        -t|--tweak)
            TWEAK="$2"
            shift 2
            ;;
        *)
            TRANSCRIPTION="$1"
            shift
            ;;
    esac
done

# Logging function
log() {
    if [[ "$DEBUG_MODE" == "true" ]]; then
        echo "[$(date +'%Y-%m-%d %H:%M:%S')] wsi-claude-process: $*" >> "$LOG_FILE"
    fi
}

# Error handling: the reason on stderr (the caller shows it), nothing on stdout
error_exit() {
    log "ERROR: $1"
    echo "wsi-claude-process: $1" >&2
    exit 1
}

# The newest unexpired NAME.YYYY-MM-DD.token for NAME, the format cc checks
export_named_token() {
    local name="$1" today newest="" file expiry token
    today=$(date +%Y-%m-%d)
    for file in "$TOKEN_DIR/$name".*.token; do
        [[ -f "$file" ]] || continue
        expiry="${file%.token}"
        expiry="${expiry##*.}"
        [[ "$expiry" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || continue
        [[ "$expiry" < "$today" ]] && continue
        if [[ -z "$newest" || "$file" > "$newest" ]]; then
            newest="$file"
        fi
    done
    if [[ -z "$newest" ]]; then
        error_exit "no unexpired token named '$name' in $TOKEN_DIR (Settings → Claude token; make one with ccy --create-token)"
    fi
    token=$(<"$newest")
    if ! [[ "$token" =~ ^sk-ant-oat01- ]] || (( ${#token} < 90 || ${#token} > 120 )); then
        error_exit "the token file $newest is not a Claude Code OAuth token"
    fi
    export CLAUDE_CODE_OAUTH_TOKEN="$token"
    log "Using token '$name' ($(basename "$newest"))"
}

# Preflight checks
log "Starting Claude Code post-processing"
log "Model: $CLAUDE_MODEL"
log "Style: $STYLE"
log "Transcription length: ${#TRANSCRIPTION} chars"

# Check if transcription is provided
if [[ -z "$TRANSCRIPTION" ]]; then
    error_exit "No transcription text provided"
fi

# Check if claude is available
if ! command -v claude &>/dev/null; then
    error_exit "claude CLI not found in PATH"
fi

# The account. The desktop login is parked aside while a cc named-token session runs,
# so an empty setting fails then with "Not logged in"; a named token does not.
if ! TOKEN_NAME=$("$SETTING_READER" claude-token); then
    error_exit "cannot read the claude-token setting (re-run play-speech-to-text.yml)"
fi
if [[ -n "$TOKEN_NAME" ]]; then
    export_named_token "$TOKEN_NAME"
else
    log "Using the desktop login (claude-token is empty)"
fi

# Select prompt file based on style
PROMPT_FILE="${CONFIG_DIR}/claude-prompt-${STYLE}.txt"

# Fallback to default corporate prompt if style file doesn't exist
if [[ ! -f "$PROMPT_FILE" ]]; then
    log "Style-specific prompt not found: $PROMPT_FILE"
    PROMPT_FILE="${CONFIG_DIR}/claude-prompt.txt"
    if [[ ! -f "$PROMPT_FILE" ]]; then
        error_exit "No prompt template found"
    fi
fi

# Read prompt template
PROMPT_TEMPLATE=$(cat "$PROMPT_FILE")
log "Loaded prompt template (${#PROMPT_TEMPLATE} chars)"

# Replace {TRANSCRIPTION} placeholder
FULL_PROMPT="${PROMPT_TEMPLATE//\{TRANSCRIPTION\}/$TRANSCRIPTION}"

# Replace {TWEAK} placeholder (used by article prompt; no-op for others)
if [[ -n "$TWEAK" ]]; then
    TWEAK_LINE=$'\nAdditional instruction: '"$TWEAK"
else
    TWEAK_LINE=""
fi
FULL_PROMPT="${FULL_PROMPT//\{TWEAK\}/$TWEAK_LINE}"

log "Constructed full prompt (${#FULL_PROMPT} chars)"

# Call Claude CLI in headless mode. Its stderr is kept apart: it holds the reason a
# failed run gives (e.g. "Not logged in"), which is what the caller must show.
log "Calling claude with model=$CLAUDE_MODEL"
CLAUDE_ERR=$(mktemp)
trap 'rm -f "$CLAUDE_ERR"' EXIT
claude_rc=0
RESULT=$(printf '%s\n' "$FULL_PROMPT" |
    timeout "$CLAUDE_TIMEOUT_SECONDS" claude -p --model "$CLAUDE_MODEL" 2>"$CLAUDE_ERR") || claude_rc=$?
if [[ "$claude_rc" -ne 0 ]]; then
    reason=$(tr '\n' ' ' <"$CLAUDE_ERR")
    [[ -n "$reason" ]] || reason="$RESULT"
    if [[ "$claude_rc" -eq 124 ]]; then
        reason="no answer within ${CLAUDE_TIMEOUT_SECONDS} s"
    fi
    error_exit "claude failed (exit $claude_rc): ${reason:-no message}"
fi

# Clean up result (remove any leading/trailing whitespace)
RESULT=$(echo "$RESULT" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')

# Verify result is not empty
if [[ -z "$RESULT" ]]; then
    error_exit "Claude Code returned empty result"
fi

log "Processing successful (result length: ${#RESULT} chars)"
echo "$RESULT"
