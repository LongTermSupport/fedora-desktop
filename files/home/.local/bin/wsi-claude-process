#!/bin/bash
#
# wsi-claude-process - Post-process speech-to-text transcriptions with Claude Code
#
# Usage:
#   wsi-claude-process [OPTIONS] <transcription-text>
#
# Options:
#   -m, --model MODEL      Claude model (sonnet/opus/haiku, default: sonnet)
#   -s, --style STYLE      Processing style (corporate/natural, default: corporate)
#   -d, --debug            Enable debug logging
#
# Description:
#   Reads prompt template from ~/.config/speech-to-text/claude-prompt-{style}.txt
#   Replaces {TRANSCRIPTION} placeholder with actual transcribed text
#   Calls the Claude Code CLI headless, as the token file wsi-claude-token names
#   (the token Settings name, or the one with the most allowance left), or the
#   desktop login when it names none
#   Prints the reformatted text. On any failure it prints nothing, says why on
#   stderr and exits 1: the caller must never mistake the raw text for Claude's.
#

set -euo pipefail

# Configuration
CONFIG_DIR="${HOME}/.config/speech-to-text"
LOG_DIR="${HOME}/.local/share/speech-to-text"
LOG_FILE="${LOG_DIR}/debug.log"
TOKEN_CHOOSER="$(dirname "$(readlink -f "$0")")/wsi-claude-token"
# The whole run, choosing the token included, stays below the callers' own limits
# (180 s), so this script reports a timeout itself; claude gets what is left of it
CLAUDE_TIMEOUT_SECONDS="${WSI_CLAUDE_TIMEOUT_SECONDS-170}"
DEBUG_MODE=false
CLAUDE_MODEL="sonnet"
STYLE="corporate"
TWEAK=""

# Parse arguments
TRANSCRIPTION=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -m|--model)
            CLAUDE_MODEL="$2"
            shift 2
            ;;
        -s|--style)
            STYLE="$2"
            shift 2
            ;;
        -d|--debug)
            DEBUG_MODE=true
            shift
            ;;
        -t|--tweak)
            TWEAK="$2"
            shift 2
            ;;
        *)
            TRANSCRIPTION="$1"
            shift
            ;;
    esac
done

# Logging function
log() {
    if [[ "$DEBUG_MODE" == "true" ]]; then
        echo "[$(date +'%Y-%m-%d %H:%M:%S')] wsi-claude-process: $*" >> "$LOG_FILE"
    fi
}

# Error handling: the reason on stderr (the caller shows it), nothing on stdout
error_exit() {
    log "ERROR: $1"
    echo "wsi-claude-process: $1" >&2
    exit 1
}

# Preflight checks
log "Starting Claude Code post-processing: model $CLAUDE_MODEL, style $STYLE, ${#TRANSCRIPTION} chars"

# The limit comes from the session environment the callers pass on: above 170 s claude
# could outlast their own 180 s, and 0 or less is not a limit at all
if ! [[ "$CLAUDE_TIMEOUT_SECONDS" =~ ^([1-9][0-9]?|1[0-6][0-9]|170)$ ]]; then
    error_exit "WSI_CLAUDE_TIMEOUT_SECONDS must be a whole number of seconds from 1 to 170, not '$CLAUDE_TIMEOUT_SECONDS'"
fi
[[ -n "$TRANSCRIPTION" ]] || error_exit "No transcription text provided"
command -v claude &>/dev/null || error_exit "claude CLI not found in PATH"

# claude's stderr, and before it the chooser's, are kept apart: a failed run's reason
# (e.g. "Not logged in") is what the caller must show.
CLAUDE_ERR=$(mktemp)
trap 'rm -f "$CLAUDE_ERR"' EXIT

# The account: the token file wsi-claude-token names (it validates it and never prints
# the value), or the desktop login, which cc parks aside while a named-token session runs
if ! TOKEN_FILE=$("$TOKEN_CHOOSER" 2>"$CLAUDE_ERR"); then
    reason=$(tr '\n' ' ' <"$CLAUDE_ERR")
    error_exit "${reason#wsi-claude-token: }"
fi
log "$(tr '\n' ' ' <"$CLAUDE_ERR")"
ACCOUNT="desktop login"
if [[ -n "$TOKEN_FILE" ]]; then
    ACCOUNT=$(basename "$TOKEN_FILE")
    ACCOUNT="token '${ACCOUNT%.*.token}'"
    CLAUDE_CODE_OAUTH_TOKEN=$(<"$TOKEN_FILE")
    export CLAUDE_CODE_OAUTH_TOKEN
fi

# Select prompt file based on style
PROMPT_FILE="${CONFIG_DIR}/claude-prompt-${STYLE}.txt"

# Fallback to default corporate prompt if style file doesn't exist
if [[ ! -f "$PROMPT_FILE" ]]; then
    log "Style-specific prompt not found: $PROMPT_FILE"
    PROMPT_FILE="${CONFIG_DIR}/claude-prompt.txt"
    if [[ ! -f "$PROMPT_FILE" ]]; then
        error_exit "No prompt template found"
    fi
fi

# Read prompt template
PROMPT_TEMPLATE=$(cat "$PROMPT_FILE")

# Replace {TRANSCRIPTION} placeholder
FULL_PROMPT="${PROMPT_TEMPLATE//\{TRANSCRIPTION\}/$TRANSCRIPTION}"

# Replace {TWEAK} placeholder (used by article prompt; no-op for others)
TWEAK_LINE="${TWEAK:+$'\n'Additional instruction: $TWEAK}"
FULL_PROMPT="${FULL_PROMPT//\{TWEAK\}/$TWEAK_LINE}"


# Call Claude CLI in headless mode, within what choosing the token left (SECONDS counts
# from the start of this script; `timeout 0` would mean no limit at all)
CLAUDE_BUDGET=$((CLAUDE_TIMEOUT_SECONDS - SECONDS))
if (( CLAUDE_BUDGET < 1 )); then
    error_exit "choosing the token took ${SECONDS} s of the ${CLAUDE_TIMEOUT_SECONDS} s this run has; claude was not run"
fi
log "Calling claude with model=$CLAUDE_MODEL as the $ACCOUNT, within ${CLAUDE_BUDGET} s (prompt ${#FULL_PROMPT} chars, from a ${#PROMPT_TEMPLATE}-char template)"
claude_rc=0
RESULT=$(printf '%s\n' "$FULL_PROMPT" |
    timeout "$CLAUDE_BUDGET" claude -p --model "$CLAUDE_MODEL" 2>"$CLAUDE_ERR") || claude_rc=$?
if [[ "$claude_rc" -ne 0 ]]; then
    reason=$(tr '\n' ' ' <"$CLAUDE_ERR")
    [[ -n "$reason" ]] || reason="$RESULT"
    if [[ "$claude_rc" -eq 124 ]]; then
        reason="no answer within ${CLAUDE_BUDGET} s of the ${CLAUDE_TIMEOUT_SECONDS} s this run has"
    fi
    error_exit "claude failed as the $ACCOUNT (exit $claude_rc): ${reason:-no message}"
fi

# Clean up result (remove any leading/trailing whitespace)
RESULT=$(echo "$RESULT" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')

# Verify result is not empty
if [[ -z "$RESULT" ]]; then
    error_exit "Claude Code returned empty result"
fi

log "Processing successful (result length: ${#RESULT} chars)"
echo "$RESULT"
