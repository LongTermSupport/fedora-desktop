#!/usr/bin/env bash
# podfreeze — freeze (pause) and thaw (unpause) Podman containers, singly,
#             by network, or as the whole CCY (Claude YOLO) session group.
#
# WHY THIS EXISTS (prior art, and where it falls short):
#
#   podman pause NAME  The underlying mechanism, and all this wrapper ever
#                      calls. It takes --filter, so `--filter network=X` is
#                      already possible — but you have to know the network
#                      exists, know what is on it, and be willing to act on a
#                      set you never saw. There is no preview.
#   podman-tui         Fedora-packaged Podman TUI. Browses and acts on ONE
#                      container at a time; no network-scoped bulk verb, no
#                      concept of a CCY session group.
#   lazydocker / ctop  Docker-oriented, unpackaged for Fedora.
#   Cockpit podman     Web dashboard; same one-at-a-time model.
#
# So this adds the three things that were missing, and delegates the rest:
#
#   1. A named CCY group. CCY >= 3.40.0 labels each session container ccy=true
#      at run time, so --ccy is an exact filter; the session name pattern
#      <project>_yolo[_N] is matched as well, which covers sessions started by
#      an older CCY.
#   2. A menu of GROUPS, not of containers. All CCY containers, all containers,
#      everything on a given network, or every session running as one GitHub
#      account / Anthropic token / SSH key — each row saying what choosing it
#      will do right now ("FREEZE 8", "THAW 3").
#      The identity groups come from labels CCY stamps at launch, so they group
#      by WHO a session is rather than by what it happens to be called.
#      Choosing a group opens it: the first row is "act on all of it", the rest
#      are its members. Acting on the whole group therefore stays one keypress,
#      while the members are visible before anything happens — which is what a
#      group row cannot show, and is where a live Claude session hides inside
#      an app network (F15).
#   3. Refusal to run inside a container. The host's podman is not reachable
#      from in there anyway, and it stops you freezing the session you are
#      typing into.
#
# THE VERB IS DERIVED, NOT ASKED. For any given set there is only one sensible
# move: anything running gets frozen, and a set with nothing running gets
# thawed. So running podfreeze twice on the same target toggles it. An explicit
# `freeze` / `thaw` on the command line still wins, because a script must be
# able to say what it means rather than depend on current state.
#
# THERE IS NO CONFIRMATION PROMPT. Freezing is reversible by running the same
# command again, and in the menu you already chose a row that named the verb
# and the count — a second "are you sure" would guard nothing. Use --dry-run
# when you want to look without acting.
#
# FREEZE IS NOT SUSPEND-TO-DISK. `podman pause` is the cgroup freezer: the
# processes stay resident in RAM and stop being scheduled. Frozen containers do
# NOT survive a reboot. The reboot-surviving equivalent is `podman container
# checkpoint` (CRIU), which requires root and so is unavailable on this
# rootless setup.
#
# Usage:
#   podfreeze [list|freeze|thaw] [target] [options]
#
# Targets (exactly one, or none for the interactive menu). Keep this list in
# step with usage() below — one file with two disagreeing summaries is how the
# identity axes went unmentioned here for two reviews.
#   NAME...            One or more container names.
#   --ccy              Every CCY container (label, or the legacy name pattern).
#   --network NET      Every container attached to network NET.
#   --github ID        Every CCY session running as GitHub account ID.
#   --token LABEL      Every CCY session using that Anthropic token.
#   --ssh-key NAME     Every CCY session with that SSH key mounted.
#   --all              Every running/paused container.
#
# Options:
#   -n, --dry-run      Print the resolved set and exit. Changes nothing.
#   -h, --help         Show this help and exit.
#
# Examples:
#   podfreeze                            # menu: pick a group, it acts, repeat
#   podfreeze list                       # what is running, what is frozen
#   podfreeze --ccy                      # toggle every Claude session
#   podfreeze freeze --ccy               # explicitly freeze them
#   podfreeze freeze --network mynet -n  # preview only
#   podfreeze thaw --all
#
# THE MENU IS NOT IN THIS FILE. The group menu, the drill-down, the derived
# verb, the dry run, the bounded retry and the act loop live in
# ~/.local/lib/freeze/freeze-common.bash, which `lxcfreeze` sources too — so the
# two tools cannot teach different habits for the same job (Plan 00122 Phase 4).
# What stays here is everything that IS podman: the inventory query, the CCY and
# network group axes, the identity labels, and the two state words. The library
# reaches podman only through the freeze_hook_* functions at the bottom of this
# file; it contains no mention of an engine at all.
set -euo pipefail

# What this tool is, in the library's terms. Set BEFORE the library is sourced —
# it refuses to load without them, because a message that named no tool and a
# state comparison against the empty string are both silent failures.
FREEZE_TOOL="podfreeze"
# podman's own two words for the states this tool acts on.
FREEZE_STATE_RUNNING="running"
FREEZE_STATE_FROZEN="paused"
FREEZE_HOST_ONLY_NOTE="  The host's podman is not reachable from in here, so every container would
  look absent. Freezing your own session would also be unrecoverable."
FREEZE_TARGET_HINT="NAME..., --ccy,
  --network NET, or --all"
FREEZE_LIST_NOTE=""

# Where the shared library is. ONE relative path finds it both from a repo
# checkout and from ~/.local/bin once deployed, because files/ mirrors the target
# filesystem. The second candidate is that checkout reached from the ENTRY POINT
# rather than from this file, which is what scripts/test-podfreeze.bash needs: it
# sources the definitions above the argument loop out of a temp file, so by then
# this file's own location is a temp directory.
freeze_lib_path() {
    local src dir candidate
    for src in "${BASH_SOURCE[0]}" "$0"; do
        dir="$(cd -- "$(dirname -- "$src")" 2> /dev/null && pwd -P)" || continue
        for candidate in "$dir/../lib/freeze/freeze-common.bash" \
            "$dir/../files/home/.local/lib/freeze/freeze-common.bash"; do
            if [ -r "$candidate" ]; then
                printf '%s' "$candidate"
                return 0
            fi
        done
    done
    return 1
}

if ! FREEZE_LIB="$(freeze_lib_path)"; then
    echo "podfreeze: the shared freeze library is missing." >&2
    echo "  Expected at ~/.local/lib/freeze/freeze-common.bash — half of this" >&2
    echo "  tool lives there, so nothing here can run without it." >&2
    echo "  Deploy it with:" >&2
    echo "    ansible-playbook playbooks/imports/optional/common/play-podfreeze.yml" >&2
    echo "  Do NOT install it by hand." >&2
    exit 1
fi
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/freeze/freeze-common.bash
source "$FREEZE_LIB"

# Set at `podman run` time by CCY >= 3.40.0, so it cannot be inherited: a
# container carrying it IS a live Claude session. This is the exact, positive
# signal; see files/var/local/claude-yolo/claude-yolo.
CCY_SESSION_LABEL="ccy=true"
# Sessions started by CCY < 3.40.0 have no such label, but CCY names every
# session <project>_yolo[_N] / <project>_browser[_N] by construction — see
# get_next_container_name() in the CCY libs — so the name covers them exactly.
CCY_NAME_PATTERN='^.+_(yolo|browser)(_[0-9]+)?$'

# The image's inherited claude-yolo-version label is DELIBERATELY not consulted.
# It marks anything built FROM the CCY image, session or not, and a host run of
# this plan's acceptance gate caught it selecting a CCY-derived throwaway that
# was no session at all. Dropping it opens no gap: every session has either the
# run-time label (>= 3.40.0) or the name (older), so the image label only ever
# contributed false positives. See CLAUDE/Plan/00079-podman-container-control.

# Field separator for `podman ps --format`. A literal tab in a Go template is
# invisible and easy to mangle on edit; neither a container name nor a network
# name may contain '|', so this is unambiguous and readable for the inventory
# query.
#
# The identity query is a weaker case and worth stating plainly: its fields are
# LABEL VALUES — a username, a token config name, and SSH key basenames. A
# filename may legally contain '|', so a key named `odd|name` would mis-split
# the record and silently mis-group that session. It cannot be a container or
# network name, so the risk is confined to the identity axes; RECORD_SEP-style
# separators are not available in a Go template without the same escaping
# problem the tab has. Mitigated by checking the field count rather than by
# choosing a cleverer byte — a short record is detectable, a mis-split is not.
FIELD_SEP='|'

usage() {
    echo "Usage: podfreeze [list|freeze|thaw] [target] [options]"
    echo ""
    echo "  Freeze (pause) and thaw (unpause) Podman containers — one, a whole"
    echo "  network, or every CCY (Claude) session at once."
    echo ""
    echo "  Run with no target for a menu of GROUPS, each row saying what"
    echo "  choosing it does right now (\"FREEZE 8\", \"THAW 3\"). Choosing one"
    echo "  opens the group: the first row acts on all of it, the rest are its"
    echo "  containers if you want only some. It acts, then returns to the"
    echo "  menu, until you quit."
    echo ""
    echo "  The verb is derived: anything running is frozen, a set with nothing"
    echo "  running is thawed. So the same choice twice toggles it. There is no"
    echo "  confirmation prompt — freezing is undone by doing it again."
    echo ""
    echo "  Freezing is the cgroup freezer, not suspend-to-disk: frozen"
    echo "  containers do not survive a reboot."
    echo ""
    echo "Verbs (optional — omit to let the state decide):"
    echo "  list               Show running and frozen containers, then exit."
    echo "  freeze             Pause the target containers."
    echo "  thaw               Unpause the target containers."
    echo ""
    echo "Targets (exactly one, or none for the menu):"
    echo "  NAME...            One or more container names."
    echo "  --ccy              Every CCY container."
    echo "  --network NET      Every container attached to network NET."
    echo "  --github ID        Every CCY session running as GitHub account ID."
    echo "  --token LABEL      Every CCY session using that Anthropic token."
    echo "  --ssh-key NAME     Every CCY session with that SSH key mounted."
    echo "  --all              Every running/paused container."
    echo ""
    echo "  The last three read labels CCY stamps on each session at launch, so"
    echo "  they only see sessions started by CCY 3.40.0 or later. An unknown"
    echo "  value is an error listing the known ones, never an empty set."
    echo ""
    echo "Options:"
    echo "  -n, --dry-run      Print the resolved set and exit; change nothing."
    echo "  -h, --help         Show this help and exit."
    echo ""
    echo "Examples:"
    echo "  podfreeze                       menu: pick a group, it acts, repeat"
    echo "  podfreeze list"
    echo "  podfreeze --ccy                 toggle every Claude session"
    echo "  podfreeze freeze --ccy          explicitly freeze them"
    echo "  podfreeze freeze --network mynet -n"
    echo "  podfreeze freeze --github <gh-username>"
    echo "  podfreeze thaw --all"
}

# ---------------------------------------------------------------------------
# Preflight. `die`, `have` and `assert_on_host` come from the library — the
# refusal to run inside a container is shared, and only its explanation is
# podman's (FREEZE_HOST_ONLY_NOTE above).
# ---------------------------------------------------------------------------

assert_podman() {
    if ! have podman; then
        die "podman is not installed.
  It is declared in playbooks/imports/play-podman.yml. Deploy it with:
    ansible-playbook playbooks/imports/play-podman.yml
  Do NOT install it by hand."
    fi
}

# ---------------------------------------------------------------------------
# Inventory
#
# INV_NAME and INV_STATE are the library's; INV_NETS is this tool's third
# parallel array, and the lookups below are keyed by name. Only running and paused
# containers are inventoried — an exited container can be neither frozen nor
# thawed, and offering one as a candidate would only invite a confusing no-op.
#
# The identity lookups (github/token/ssh-keys) are populated only for CCY
# sessions, because only CCY sets them. Both an absent label and a literal
# "none" leave the map empty — they are NOT distinguishable from these maps
# alone, which is why INV_HAS_LABELS exists to carry that distinction
# separately.
# ---------------------------------------------------------------------------
declare -a INV_NETS=()
declare -A INV_IS_CCY=()
# 1 for a session that came back from the `label=ccy=true` query — i.e. one
# launched by CCY >= 3.40.0. This is NOT derivable from the identity maps: a
# 3.40.0 session can legitimately carry `none` on all three axes (no gh
# identity, no token, `--no-ssh`), which leaves those maps empty exactly as an
# unlabelled pre-3.40.0 session does. Without this, "has no identity" and
# "predates the labels" collapse into one, and the tool tells the user to
# relaunch a session that is already current.
declare -A INV_HAS_LABELS=()
declare -A INV_GITHUB=()
declare -A INV_TOKEN=()
declare -A INV_SSHKEYS=()

load_inventory() {
    local out ccy_out name state nets github token sshkeys

    if ! out="$(podman ps --all \
        --format "{{.Names}}${FIELD_SEP}{{.State}}${FIELD_SEP}{{.Networks}}" 2>&1)"; then
        die "podman ps failed: $out"
    fi

    INV_NAME=()
    INV_STATE=()
    INV_NETS=()
    INV_IS_CCY=()
    INV_HAS_LABELS=()
    INV_GITHUB=()
    INV_TOKEN=()
    INV_SSHKEYS=()

    while IFS="$FIELD_SEP" read -r name state nets; do
        if [ -z "$name" ]; then
            continue
        fi
        case "$state" in
            "$FREEZE_STATE_RUNNING" | "$FREEZE_STATE_FROZEN") ;;
            *) continue ;;
        esac
        INV_NAME+=("$name")
        INV_STATE+=("$state")
        INV_NETS+=("${nets:-none}")
        if [[ "$name" =~ $CCY_NAME_PATTERN ]]; then
            INV_IS_CCY["$name"]=1
        else
            INV_IS_CCY["$name"]=0
        fi
    done <<< "$out"

    # The run-time session label is the authoritative handle; the name pattern
    # above covers sessions started by a CCY older than 3.40.0. The same query
    # carries the identity labels, so this costs no extra podman call — and it
    # is scoped to ccy=true precisely so a container with no labels at all never
    # has to be distinguished from one whose labels are empty.
    if ! ccy_out="$(podman ps --all --filter "label=$CCY_SESSION_LABEL" \
        --format "{{.Names}}${FIELD_SEP}{{index .Labels \"ccy-github\"}}${FIELD_SEP}{{index .Labels \"ccy-token\"}}${FIELD_SEP}{{index .Labels \"ccy-ssh-keys\"}}" 2>&1)"; then
        die "podman ps --filter label=$CCY_SESSION_LABEL failed: $ccy_out"
    fi
    while IFS="$FIELD_SEP" read -r name github token sshkeys extra; do
        if [ -z "$name" ]; then
            continue
        fi
        # A label value containing FIELD_SEP mis-splits this record, and a
        # mis-split is silent — the session would simply be grouped under the
        # wrong identity. `extra` catches it: with four fields expected, any
        # fifth means a value contained the separator. Fail rather than group
        # a session under an identity it does not have.
        if [ -n "$extra" ]; then
            die "a CCY identity label on '$name' contains '$FIELD_SEP', which
  makes its labels ambiguous to parse. Rename the offending SSH key or token
  config so it has no '$FIELD_SEP', then relaunch that session."
        fi
        INV_IS_CCY["$name"]=1
        INV_HAS_LABELS["$name"]=1
        # "none" is CCY saying the axis does not apply to this session; it is not
        # a value anyone would want to group by, so it is dropped here rather
        # than offered as a group of its own.
        if [ -n "$github" ] && [ "$github" != "none" ]; then
            INV_GITHUB["$name"]="$github"
        fi
        if [ -n "$token" ] && [ "$token" != "none" ]; then
            INV_TOKEN["$name"]="$token"
        fi
        if [ -n "$sshkeys" ] && [ "$sshkeys" != "none" ]; then
            INV_SSHKEYS["$name"]="$sshkeys"
        fi
    done <<< "$ccy_out"
}

ccy_marker() {
    if [ "${INV_IS_CCY[$1]:-0}" = "1" ]; then
        printf 'CCY'
    else
        printf '-'
    fi
}

# ---------------------------------------------------------------------------
# Selection. `select_all` and `select_names` are the library's — they need
# nothing but the inventory. What is here is the group axes podman has and LXC
# does not: a CCY session, a network, an identity label.
#
# The *_names emitters print one name per line so the target menu can size a
# candidate group without disturbing SELECTED.
# ---------------------------------------------------------------------------

ccy_names() {
    local name
    for name in "${INV_NAME[@]}"; do
        if [ "${INV_IS_CCY[$name]:-0}" = "1" ]; then
            printf '%s\n' "$name"
        fi
    done
}

select_ccy() {
    mapfile -t SELECTED < <(ccy_names)
}

# net -> space-separated container names. A container can be on several
# networks, so `{{.Networks}}` is comma-separated and is split here. Built from
# the inventory rather than `podman network ls` so the menu only ever offers a
# network that something is actually attached to — an empty one is a choice
# with no outcome.
declare -A NET_MEMBERS=()

build_network_map() {
    local i name nets net
    local -a parts=()
    NET_MEMBERS=()
    for i in "${!INV_NAME[@]}"; do
        name="${INV_NAME[$i]}"
        nets="${INV_NETS[$i]}"
        if [ "$nets" = "none" ]; then
            continue
        fi
        IFS=',' read -ra parts <<< "$nets"
        for net in "${parts[@]}"; do
            net="${net// /}"
            if [ -n "$net" ]; then
                NET_MEMBERS["$net"]="${NET_MEMBERS[$net]:-} $name"
            fi
        done
    done
}

network_names() {
    local -a members=()
    read -ra members <<< "${NET_MEMBERS[$1]:-}"
    if [ "${#members[@]}" -gt 0 ]; then
        printf '%s\n' "${members[@]}"
    fi
}

# A --filter network= naming a network that does not exist returns an empty set
# and exit 0, which reads as "nothing is on it" — a confident answer to a
# question that was never asked. So the network is verified to exist first.
select_network() {
    local net="$1" known matched name
    if ! known="$(podman network ls --format '{{.Name}}' 2>&1)"; then
        die "podman network ls failed: $known"
    fi
    # -F, because a network NAME is a literal. Without it this is a regex match and
    # `podma.` passes the check by matching `podman`, so a typo containing a
    # metacharacter is reported as "Nothing in that group" instead of as the unknown
    # network it is. select_identity below already gets this right.
    if ! printf '%s\n' "$known" | grep -qxF -- "$net"; then
        echo "podfreeze: no such network: '$net'" >&2
        echo "  Known networks:" >&2
        while read -r name; do
            if [ -n "$name" ]; then
                echo "    $name" >&2
            fi
        done <<< "$known"
        # Non-zero return, not `exit`. From the CLI the caller exits on this
        # status, which is the fail-fast behaviour a script needs. From the
        # menu the network may simply have been removed between the menu being
        # drawn and the row being chosen — a recoverable input situation, where
        # the interactive rules say re-prompt rather than abort the whole run.
        return 1
    fi

    if ! matched="$(podman ps --all --filter "network=$net" --format '{{.Names}}' 2>&1)"; then
        die "podman ps --filter network=$net failed: $matched"
    fi

    SELECTED=()
    while read -r name; do
        if [ -n "$name" ] && inventory_index_of "$name" > /dev/null; then
            SELECTED+=("$name")
        fi
    done <<< "$matched"
}

# --- identity groups: GitHub account, Anthropic token, SSH key ---------------
#
# CCY stamps each session with who it is running as, so "freeze everything
# running as <github id>" is a filter over labels rather than a guess from
# container names. All three work the same way and differ only in which lookup
# they read, so one pair of helpers is parameterised by the axis name — three
# near-identical copies would be three places to fix a bug.
#
# Axis + container -> that container's label value, empty when it has none.
# A case over the three arrays rather than a nameref: the indirection would hide
# every read of INV_GITHUB/INV_TOKEN/INV_SSHKEYS from static analysis, which is
# how a typo'd array name becomes a silent empty group.
identity_value_of() {
    local axis="$1" name="$2"
    case "$axis" in
        github) printf '%s' "${INV_GITHUB[$name]:-}" ;;
        token) printf '%s' "${INV_TOKEN[$name]:-}" ;;
        ssh-key) printf '%s' "${INV_SSHKEYS[$name]:-}" ;;
        *) die "internal error: unknown identity axis '$axis'." ;;
    esac
}

# ccy-ssh-keys can name several keys, so membership is a WORD match on the label
# value; the single-valued axes compare whole. Getting this wrong in the lenient
# direction would silently widen a freeze, so the two cases are explicit.
identity_matches() {
    local axis="$1" want="$2" have="$3" word
    local -a words
    if [ "$axis" != "ssh-key" ]; then
        [ "$have" = "$want" ]
        return
    fi
    # ssh-key is the one axis holding several values, so it is split. `read -ra`
    # rather than an unquoted `for word in $have`: the latter is word splitting AND
    # pathname expansion, so a label value of `*` expands against the working
    # directory and every file in it becomes a key the session appears to hold.
    # A container label is not this tool's to trust that far.
    read -r -a words <<< "$have"
    for word in "${words[@]}"; do
        if [ "$word" = "$want" ]; then
            return 0
        fi
    done
    return 1
}

# Distinct values present in the current inventory, one per line, sorted. Built
# from what is actually running, so the menu never offers a group with no
# members — the same rule the network map follows.
identity_values() {
    local axis="$1" name value word
    {
        for name in "${INV_NAME[@]}"; do
            value="$(identity_value_of "$axis" "$name")"
            if [ -z "$value" ]; then
                continue
            fi
            if [ "$axis" = "ssh-key" ]; then
                for word in $value; do
                    printf '%s\n' "$word"
                done
            else
                printf '%s\n' "$value"
            fi
        done
    } | sort -u
}

identity_names() {
    local axis="$1" want="$2" name
    for name in "${INV_NAME[@]}"; do
        if identity_matches "$axis" "$want" "$(identity_value_of "$axis" "$name")"; then
            printf '%s\n' "$name"
        fi
    done
}

# Does this axis tell any two CCY sessions apart? Exit 0 if the menu should offer
# its rows, 1 if every row would be the same button as "all CCY containers".
#
# "Discriminates" is COVERAGE, not cardinality, and the difference is the whole
# point. Testing `${#values[@]} -lt 2` is only a proxy, and it is wrong in exactly
# the partial-rollout state the axis is most useful in: one labelled account plus
# four unlabelled sessions is a SINGLE distinct value covering 2 of 6, so the
# proxy suppresses the row while `--github X` keeps working on the CLI. The menu
# then offers only the WIDER "all CCY containers", silently steering toward
# freezing sessions the user never asked about.
#
# This lives in its own function because pick_target cannot be called from a test
# — it dies without a TTY — so a predicate inlined there is a predicate the unit
# test can only re-implement, and a re-implementation asserts nothing about the
# code that ships.
identity_axis_discriminates() {
    local axis="$1" values covered ccyTotal
    mapfile -t values < <(identity_values "$axis")
    if [ "${#values[@]}" -eq 0 ]; then
        return 1
    fi
    if [ "${#values[@]}" -gt 1 ]; then
        return 0
    fi
    # One distinct value: it discriminates only if some CCY session is NOT in it.
    covered="$(identity_names "$axis" "${values[0]}" | wc -l)"
    ccyTotal="$(ccy_names | wc -l)"
    [ "$covered" -lt "$ccyTotal" ]
}

# An unknown value must fail loudly. Resolving it to an empty set and exiting 0
# would report "nothing to do" for a question that was never asked — the same
# trap select_network guards against for a non-existent network.
select_identity() {
    local axis="$1" want="$2" values value
    values="$(identity_values "$axis")"
    if [ -z "$values" ] || ! printf '%s\n' "$values" | grep -qxF -- "$want"; then
        echo "podfreeze: no running or frozen CCY session has --$axis '$want'" >&2
        if [ -z "$values" ]; then
            echo "  No session carries a $axis label at all. Sessions started by" >&2
            echo "  a CCY older than 3.40.0 are unlabelled — relaunch to label them." >&2
        else
            echo "  Known values:" >&2
            while read -r value; do
                if [ -n "$value" ]; then
                    echo "    $value" >&2
                fi
            done <<< "$values"
        fi
        exit 1
    fi
    mapfile -t SELECTED < <(identity_names "$axis" "$want")
    warn_identity_blind_spot
}

# A session started before CCY 3.40.0 carries no identity labels, so it is in
# --ccy but in NO identity group. Its account cannot be inferred — the labels
# are the only evidence there is — so the selection is correct as far as it can
# go, and stays silent about the sessions it could not consider.
#
# That silence is the problem. The whole point of the identity axes is "freeze
# everything running as account X", and a partial answer to that reads exactly
# like a complete one. The check above already refuses the case where NOTHING is
# labelled; this is the same guard for the case where only SOME is, which is the
# state a machine is actually in for as long as it takes every session to be
# relaunched. Disclose, do not block: the user may well know the unlabelled ones
# are irrelevant.
unlabelled_ccy_names() {
    local name
    for name in "${INV_NAME[@]}"; do
        # Keyed on label PRESENCE, not on the identity maps being empty. A
        # 3.40.0 session with `none` on every axis leaves those maps empty too,
        # and telling its owner to "relaunch it so it can be labelled" is advice
        # that cannot work — it is already labelled, it simply has no identity.
        if [ "${INV_IS_CCY[$name]:-0}" = "1" ] &&
            [ "${INV_HAS_LABELS[$name]:-0}" != "1" ]; then
            printf '%s\n' "$name"
        fi
    done
}

warn_identity_blind_spot() {
    local -a unlabelled=()
    mapfile -t unlabelled < <(unlabelled_ccy_names)
    if [ "${#unlabelled[@]}" -eq 0 ]; then
        return 0
    fi
    echo "podfreeze: NOTE — ${#unlabelled[@]} CCY session(s) carry no identity labels," >&2
    echo "  so they are in no identity group and are NOT in this selection:" >&2
    printf '    %s\n' "${unlabelled[@]}" >&2
    echo "  They predate CCY 3.40.0. Use --ccy to cover every session regardless" >&2
    echo "  of identity, or relaunch them to make them selectable by identity." >&2
}

# ---------------------------------------------------------------------------
# Reporting. `print_table` is the library's; the two columns after NAME and
# STATE are this tool's, and arrive through the table hooks at the bottom.
# ---------------------------------------------------------------------------

do_list() {
    local -a running=() frozen=()
    local i

    for i in "${!INV_NAME[@]}"; do
        if [ "${INV_STATE[$i]}" = "$FREEZE_STATE_FROZEN" ]; then
            frozen+=("${INV_NAME[$i]}")
        else
            running+=("${INV_NAME[$i]}")
        fi
    done

    echo "=== frozen (${#frozen[@]}) ==="
    if [ "${#frozen[@]}" -eq 0 ]; then
        echo "  (none)"
    else
        print_table "${frozen[@]}"
        echo ""
        echo "  Thaw them all with: podfreeze thaw --all"
    fi
    echo ""
    echo "=== running (${#running[@]}) ==="
    if [ "${#running[@]}" -eq 0 ]; then
        echo "  (none)"
    else
        print_table "${running[@]}"
    fi
}

# ---------------------------------------------------------------------------
# The library's hooks — the only place podman appears below the inventory.
#
# Everything the user actually interacts with (the group menu, the drill-down,
# the member selection, the derived verb, the dry run, the act loop) is in the
# library. These are the named seams it reaches this engine through, and there
# is deliberately no `if podman` inside shared code: the next difference would
# be written beside it, and the shared layer would drift back into two
# implementations sharing a file.
# ---------------------------------------------------------------------------

freeze_hook_preflight() {
    assert_podman
}

# The menu counts must describe the machine as it is NOW, so the network map is
# rebuilt with the inventory on every pass rather than once at startup.
freeze_hook_refresh() {
    load_inventory
    build_network_map
}

# The two columns this tool shows after NAME and STATE. Header and row are
# formatted with the same widths, so they cannot drift out of step — a header
# that no longer sits over its own column is a table that misreads.
freeze_hook_table_header() {
    printf '%-4s %s' "CCY" "NETWORKS"
}

freeze_hook_table_row() {
    local i="$1"
    printf '%-4s %s' "$(ccy_marker "${INV_NAME[$i]}")" "${INV_NETS[$i]}"
}

# The group rows, in menu order: the CCY session group, everything, each network
# in use, then each value of an identity axis that actually discriminates.
#
# An identity row is offered only when the axis tells two CCY sessions apart —
# with a single GitHub account and every session labelled, "github: <id>" and
# "all CCY containers" are the same button, and a menu that says the same thing
# twice is harder to read, not more capable. The predicate is
# identity_axis_discriminates, which the unit test calls directly.
freeze_hook_menu_rows() {
    local net axis value
    local -a group=() nets=() values=()

    mapfile -t group < <(ccy_names)
    freeze_menu_row "ccy" "all CCY (Claude) containers" "${group[@]+${group[@]}}"

    freeze_menu_row "all" "all containers" "${INV_NAME[@]+${INV_NAME[@]}}"

    if [ "${#NET_MEMBERS[@]}" -gt 0 ]; then
        mapfile -t nets < <(printf '%s\n' "${!NET_MEMBERS[@]}" | sort)
        for net in "${nets[@]}"; do
            mapfile -t group < <(network_names "$net")
            freeze_menu_row "net:$net" "network: $net" "${group[@]+${group[@]}}"
        done
    fi

    for axis in github token ssh-key; do
        if ! identity_axis_discriminates "$axis"; then
            continue
        fi
        mapfile -t values < <(identity_values "$axis")
        for value in "${values[@]}"; do
            mapfile -t group < <(identity_names "$axis" "$value")
            freeze_menu_row "id:$axis:$value" "$axis: $value" "${group[@]+${group[@]}}"
        done
    done

    # No "pick individual containers..." row: choosing "all containers" and
    # drilling into it IS that, so a separate entry would be a second route to
    # one screen.
}

# Resolve a chosen menu key into SELECTED. A non-zero return is RECOVERABLE and
# the loop re-prompts; anything genuinely wrong exits from inside the selector.
freeze_hook_select() {
    local key="$1" rest
    case "$key" in
        ccy) select_ccy ;;
        all) select_all ;;
        net:*)
            # A network can be removed between the menu being drawn and this row
            # being chosen. select_network has already explained it, so this is
            # a re-prompt rather than the end of the session.
            if ! select_network "${key#net:}"; then
                return 1
            fi
            ;;
        id:*)
            # id:<axis>:<value> — the value may itself contain a colon, so only
            # the axis is split off.
            rest="${key#id:}"
            select_identity "${rest%%:*}" "${rest#*:}"
            ;;
        *) die "internal error: unknown target key '$key'." ;;
    esac
}

# One container, one call, so a single failure is named rather than collapsing
# the batch. The library captures both streams and reports what podman said.
freeze_hook_act() {
    local action="$1" name="$2"
    if [ "$action" = "freeze" ]; then
        podman pause "$name"
    else
        podman unpause "$name"
    fi
}

# ---------------------------------------------------------------------------
# Argument parsing. ACTION and DRY_RUN are the library's — every decision it
# makes reads one or the other — so the loop below sets them rather than
# declaring them.
# ---------------------------------------------------------------------------

TARGET_MODE=""
TARGET_NETWORK=""
TARGET_IDENTITY_AXIS=""
TARGET_IDENTITY_VALUE=""
declare -a TARGET_NAMES=()

set_target_mode() {
    if [ -n "$TARGET_MODE" ]; then
        die "choose one target only — '$TARGET_MODE' and '$1' are mutually exclusive."
    fi
    TARGET_MODE="$1"
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        -h | --help)
            usage
            exit 0
            ;;
        -n | --dry-run)
            DRY_RUN=1
            shift
            ;;
        --ccy)
            set_target_mode "--ccy"
            shift
            ;;
        --all)
            set_target_mode "--all"
            shift
            ;;
        --network)
            set_target_mode "--network"
            shift
            if [ "$#" -eq 0 ]; then
                die "--network needs a network name — see 'podfreeze --help'."
            fi
            TARGET_NETWORK="$1"
            shift
            ;;
        --github | --token | --ssh-key)
            set_target_mode "$1"
            TARGET_IDENTITY_AXIS="${1#--}"
            shift
            if [ "$#" -eq 0 ]; then
                die "--$TARGET_IDENTITY_AXIS needs a value — see 'podfreeze --help'."
            fi
            TARGET_IDENTITY_VALUE="$1"
            shift
            ;;
        list | freeze | thaw)
            if [ -n "$ACTION" ]; then
                die "only one verb at a time — already have '$ACTION'."
            fi
            ACTION="$1"
            shift
            ;;
        -*)
            die "unknown option '$1' — see 'podfreeze --help'."
            ;;
        *)
            TARGET_NAMES+=("$1")
            shift
            ;;
    esac
done

if [ "${#TARGET_NAMES[@]}" -gt 0 ]; then
    set_target_mode "names"
fi

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

# The hook check comes first: a missing hook is a wiring mistake in THIS file,
# and without it the gap surfaces as `command not found` part-way through a menu
# the user is already looking at.
freeze_assert_contract
assert_on_host
freeze_hook_preflight
load_inventory

if [ "$ACTION" = "list" ]; then
    if [ -n "$TARGET_MODE" ]; then
        die "'list' takes no target — it reports everything."
    fi
    do_list
    exit 0
fi

# No target on the command line means the interactive session, which loops
# until you quit. A named target is the one-shot, scriptable form.
if [ -z "$TARGET_MODE" ]; then
    interactive_loop
    exit $?
fi

case "$TARGET_MODE" in
    "--ccy") select_ccy ;;
    "--all") select_all ;;
    # Explicit exit, because select_network now RETURNS on an unknown network
    # rather than exiting: from a script an unknown network must still be a
    # hard failure, and `set -e` does not apply to a command in a condition.
    "--network")
        if ! select_network "$TARGET_NETWORK"; then
            exit 1
        fi
        ;;
    "--github" | "--token" | "--ssh-key")
        select_identity "$TARGET_IDENTITY_AXIS" "$TARGET_IDENTITY_VALUE"
        ;;
    "names") select_names "${TARGET_NAMES[@]}" ;;
esac

do_action "${ACTION:-$(infer_action)}"
