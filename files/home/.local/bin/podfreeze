#!/usr/bin/env bash
# podfreeze — freeze (pause) and thaw (unpause) Podman containers, singly,
#             by network, or as the whole CCY (Claude YOLO) session group.
#
# WHY THIS EXISTS (prior art, and where it falls short):
#
#   podman pause NAME  The underlying mechanism, and all this wrapper ever
#                      calls. It takes --filter, so `--filter network=X` is
#                      already possible — but you have to know the network
#                      exists, know what is on it, and be willing to act on a
#                      set you never saw. There is no preview.
#   podman-tui         Fedora-packaged Podman TUI. Browses and acts on ONE
#                      container at a time; no network-scoped bulk verb, no
#                      concept of a CCY session group.
#   lazydocker / ctop  Docker-oriented, unpackaged for Fedora.
#   Cockpit podman     Web dashboard; same one-at-a-time model.
#
# So this adds the three things that were missing, and delegates the rest:
#
#   1. A named CCY group. CCY >= 3.40.0 labels each session container ccy=true
#      at run time, so --ccy is an exact filter; the session name pattern
#      <project>_yolo[_N] is matched as well, which covers sessions started by
#      an older CCY.
#   2. A menu of GROUPS, not of containers. All CCY containers, all containers,
#      everything on a given network, or every session running as one GitHub
#      account / Anthropic token / SSH key — each row saying what choosing it
#      will do right now ("FREEZE 8", "THAW 3").
#      The identity groups come from labels CCY stamps at launch, so they group
#      by WHO a session is rather than by what it happens to be called.
#      Choosing a group opens it: the first row is "act on all of it", the rest
#      are its members. Acting on the whole group therefore stays one keypress,
#      while the members are visible before anything happens — which is what a
#      group row cannot show, and is where a live Claude session hides inside
#      an app network (F15).
#   3. Refusal to run inside a container. The host's podman is not reachable
#      from in there anyway, and it stops you freezing the session you are
#      typing into.
#
# THE VERB IS DERIVED, NOT ASKED. For any given set there is only one sensible
# move: anything running gets frozen, and a set with nothing running gets
# thawed. So running podfreeze twice on the same target toggles it. An explicit
# `freeze` / `thaw` on the command line still wins, because a script must be
# able to say what it means rather than depend on current state.
#
# THERE IS NO CONFIRMATION PROMPT. Freezing is reversible by running the same
# command again, and in the menu you already chose a row that named the verb
# and the count — a second "are you sure" would guard nothing. Use --dry-run
# when you want to look without acting.
#
# FREEZE IS NOT SUSPEND-TO-DISK. `podman pause` is the cgroup freezer: the
# processes stay resident in RAM and stop being scheduled. Frozen containers do
# NOT survive a reboot. The reboot-surviving equivalent is `podman container
# checkpoint` (CRIU), which requires root and so is unavailable on this
# rootless setup.
#
# Usage:
#   podfreeze [list|freeze|thaw] [target] [options]
#
# Targets (exactly one, or none for the interactive menu):
#   NAME...            One or more container names.
#   --ccy              Every CCY container (label, or the legacy name pattern).
#   --network NET      Every container attached to network NET.
#   --all              Every running/paused container.
#
# Options:
#   -n, --dry-run      Print the resolved set and exit. Changes nothing.
#   -h, --help         Show this help and exit.
#
# Examples:
#   podfreeze                            # menu: pick a group, it acts, repeat
#   podfreeze list                       # what is running, what is frozen
#   podfreeze --ccy                      # toggle every Claude session
#   podfreeze freeze --ccy               # explicitly freeze them
#   podfreeze freeze --network mynet -n  # preview only
#   podfreeze thaw --all
set -euo pipefail

DRY_RUN=0
MAX_TRIES=3   # bounded retries on a recoverable menu-input mistake

# Set at `podman run` time by CCY >= 3.40.0, so it cannot be inherited: a
# container carrying it IS a live Claude session. This is the exact, positive
# signal; see files/var/local/claude-yolo/claude-yolo.
CCY_SESSION_LABEL="ccy=true"
# Sessions started by CCY < 3.40.0 have no such label, but CCY names every
# session <project>_yolo[_N] / <project>_browser[_N] by construction — see
# get_next_container_name() in the CCY libs — so the name covers them exactly.
CCY_NAME_PATTERN='^.+_(yolo|browser)(_[0-9]+)?$'

# The image's inherited claude-yolo-version label is DELIBERATELY not consulted.
# It marks anything built FROM the CCY image, session or not, and a host run of
# this plan's acceptance gate caught it selecting a CCY-derived throwaway that
# was no session at all. Dropping it opens no gap: every session has either the
# run-time label (>= 3.40.0) or the name (older), so the image label only ever
# contributed false positives. See CLAUDE/Plan/00079-podman-container-control.

# Field separator for `podman ps --format`. A literal tab in a Go template is
# invisible and easy to mangle on edit; neither a container name nor a network
# name may contain '|', so this is both unambiguous and readable.
FIELD_SEP='|'

# First-column marker for the "act on the whole group" row in the drill-down.
# Leading '*' cannot begin a container name (podman requires [a-zA-Z0-9] first),
# so a real container can never be mistaken for this control row.
ALL_ROW_KEY='*all*'

usage() {
    echo "Usage: podfreeze [list|freeze|thaw] [target] [options]"
    echo ""
    echo "  Freeze (pause) and thaw (unpause) Podman containers — one, a whole"
    echo "  network, or every CCY (Claude) session at once."
    echo ""
    echo "  Run with no target for a menu of GROUPS, each row saying what"
    echo "  choosing it does right now (\"FREEZE 8\", \"THAW 3\"). Choosing one"
    echo "  opens the group: the first row acts on all of it, the rest are its"
    echo "  containers if you want only some. It acts, then returns to the"
    echo "  menu, until you quit."
    echo ""
    echo "  The verb is derived: anything running is frozen, a set with nothing"
    echo "  running is thawed. So the same choice twice toggles it. There is no"
    echo "  confirmation prompt — freezing is undone by doing it again."
    echo ""
    echo "  Freezing is the cgroup freezer, not suspend-to-disk: frozen"
    echo "  containers do not survive a reboot."
    echo ""
    echo "Verbs (optional — omit to let the state decide):"
    echo "  list               Show running and frozen containers, then exit."
    echo "  freeze             Pause the target containers."
    echo "  thaw               Unpause the target containers."
    echo ""
    echo "Targets (exactly one, or none for the menu):"
    echo "  NAME...            One or more container names."
    echo "  --ccy              Every CCY container."
    echo "  --network NET      Every container attached to network NET."
    echo "  --github ID        Every CCY session running as GitHub account ID."
    echo "  --token LABEL      Every CCY session using that Anthropic token."
    echo "  --ssh-key NAME     Every CCY session with that SSH key mounted."
    echo "  --all              Every running/paused container."
    echo ""
    echo "  The last three read labels CCY stamps on each session at launch, so"
    echo "  they only see sessions started by CCY 3.40.0 or later. An unknown"
    echo "  value is an error listing the known ones, never an empty set."
    echo ""
    echo "Options:"
    echo "  -n, --dry-run      Print the resolved set and exit; change nothing."
    echo "  -h, --help         Show this help and exit."
    echo ""
    echo "Examples:"
    echo "  podfreeze                       menu: pick a group, it acts, repeat"
    echo "  podfreeze list"
    echo "  podfreeze --ccy                 toggle every Claude session"
    echo "  podfreeze freeze --ccy          explicitly freeze them"
    echo "  podfreeze freeze --network mynet -n"
    echo "  podfreeze freeze --github <gh-username>"
    echo "  podfreeze thaw --all"
}

die() {
    echo "podfreeze: $*" >&2
    exit 1
}

have() {
    command -v "$1" > /dev/null
}

# ---------------------------------------------------------------------------
# Preflight
# ---------------------------------------------------------------------------

# Inside a container the host's podman is not reachable, so every probe below
# would report an empty machine — a misleading empty result, which is worse
# than an error. It also removes any chance of freezing the very session
# issuing the command.
assert_on_host() {
    if [ -f /run/.containerenv ] || [ -f /.dockerenv ] || [ -n "${container:-}" ]; then
        die "this is a container — run podfreeze on the HOST.
  The host's podman is not reachable from in here, so every container would
  look absent. Freezing your own session would also be unrecoverable."
    fi
}

assert_podman() {
    if ! have podman; then
        die "podman is not installed.
  It is declared in playbooks/imports/play-podman.yml. Deploy it with:
    ansible-playbook playbooks/imports/play-podman.yml
  Do NOT install it by hand."
    fi
}

# ---------------------------------------------------------------------------
# Inventory
#
# Three parallel arrays plus per-container lookups. Only running and paused
# containers are inventoried — an exited container can be neither frozen nor
# thawed, and offering one as a candidate would only invite a confusing no-op.
#
# The identity lookups (github/token/ssh-keys) are populated only for CCY
# sessions, because only CCY sets them. A container with no value is absent from
# the map rather than holding an empty string, so "unknown" and "deliberately
# none" stay distinguishable.
# ---------------------------------------------------------------------------
declare -a INV_NAME=()
declare -a INV_STATE=()
declare -a INV_NETS=()
declare -A INV_IS_CCY=()
declare -A INV_GITHUB=()
declare -A INV_TOKEN=()
declare -A INV_SSHKEYS=()

load_inventory() {
    local out ccy_out name state nets github token sshkeys

    if ! out="$(podman ps --all \
        --format "{{.Names}}${FIELD_SEP}{{.State}}${FIELD_SEP}{{.Networks}}" 2>&1)"; then
        die "podman ps failed: $out"
    fi

    INV_NAME=()
    INV_STATE=()
    INV_NETS=()
    INV_IS_CCY=()
    INV_GITHUB=()
    INV_TOKEN=()
    INV_SSHKEYS=()

    while IFS="$FIELD_SEP" read -r name state nets; do
        if [ -z "$name" ]; then
            continue
        fi
        case "$state" in
            running | paused) ;;
            *) continue ;;
        esac
        INV_NAME+=("$name")
        INV_STATE+=("$state")
        INV_NETS+=("${nets:-none}")
        if [[ "$name" =~ $CCY_NAME_PATTERN ]]; then
            INV_IS_CCY["$name"]=1
        else
            INV_IS_CCY["$name"]=0
        fi
    done <<< "$out"

    # The run-time session label is the authoritative handle; the name pattern
    # above covers sessions started by a CCY older than 3.40.0. The same query
    # carries the identity labels, so this costs no extra podman call — and it
    # is scoped to ccy=true precisely so a container with no labels at all never
    # has to be distinguished from one whose labels are empty.
    if ! ccy_out="$(podman ps --all --filter "label=$CCY_SESSION_LABEL" \
        --format "{{.Names}}${FIELD_SEP}{{index .Labels \"ccy-github\"}}${FIELD_SEP}{{index .Labels \"ccy-token\"}}${FIELD_SEP}{{index .Labels \"ccy-ssh-keys\"}}" 2>&1)"; then
        die "podman ps --filter label=$CCY_SESSION_LABEL failed: $ccy_out"
    fi
    while IFS="$FIELD_SEP" read -r name github token sshkeys; do
        if [ -z "$name" ]; then
            continue
        fi
        INV_IS_CCY["$name"]=1
        # "none" is CCY saying the axis does not apply to this session; it is not
        # a value anyone would want to group by, so it is dropped here rather
        # than offered as a group of its own.
        if [ -n "$github" ] && [ "$github" != "none" ]; then
            INV_GITHUB["$name"]="$github"
        fi
        if [ -n "$token" ] && [ "$token" != "none" ]; then
            INV_TOKEN["$name"]="$token"
        fi
        if [ -n "$sshkeys" ] && [ "$sshkeys" != "none" ]; then
            INV_SSHKEYS["$name"]="$sshkeys"
        fi
    done <<< "$ccy_out"
}

inventory_index_of() {
    local wanted="$1" i
    for i in "${!INV_NAME[@]}"; do
        if [ "${INV_NAME[$i]}" = "$wanted" ]; then
            printf '%s' "$i"
            return 0
        fi
    done
    return 1
}

ccy_marker() {
    if [ "${INV_IS_CCY[$1]:-0}" = "1" ]; then
        printf 'CCY'
    else
        printf '-'
    fi
}

# ---------------------------------------------------------------------------
# Selection
# ---------------------------------------------------------------------------
declare -a SELECTED=()

# The *_names emitters print one name per line so the target menu can size a
# candidate group without disturbing SELECTED.

ccy_names() {
    local name
    for name in "${INV_NAME[@]}"; do
        if [ "${INV_IS_CCY[$name]:-0}" = "1" ]; then
            printf '%s\n' "$name"
        fi
    done
}

select_all() {
    SELECTED=("${INV_NAME[@]}")
}

select_ccy() {
    mapfile -t SELECTED < <(ccy_names)
}

# net -> space-separated container names. A container can be on several
# networks, so `{{.Networks}}` is comma-separated and is split here. Built from
# the inventory rather than `podman network ls` so the menu only ever offers a
# network that something is actually attached to — an empty one is a choice
# with no outcome.
declare -A NET_MEMBERS=()

build_network_map() {
    local i name nets net
    local -a parts=()
    NET_MEMBERS=()
    for i in "${!INV_NAME[@]}"; do
        name="${INV_NAME[$i]}"
        nets="${INV_NETS[$i]}"
        if [ "$nets" = "none" ]; then
            continue
        fi
        IFS=',' read -ra parts <<< "$nets"
        for net in "${parts[@]}"; do
            net="${net// /}"
            if [ -n "$net" ]; then
                NET_MEMBERS["$net"]="${NET_MEMBERS[$net]:-} $name"
            fi
        done
    done
}

network_names() {
    local -a members=()
    read -ra members <<< "${NET_MEMBERS[$1]:-}"
    if [ "${#members[@]}" -gt 0 ]; then
        printf '%s\n' "${members[@]}"
    fi
}

# How many of the named containers are in a state the verb can act on. This is
# what makes the target menu worth reading: "0 frozen" says the choice is a
# no-op before you make it.
count_in_state() {
    local want="$1"
    shift
    local name i n=0
    for name in "$@"; do
        if i="$(inventory_index_of "$name")" && [ "${INV_STATE[$i]}" = "$want" ]; then
            n=$(( n + 1 ))
        fi
    done
    printf '%s' "$n"
}

# A --filter network= naming a network that does not exist returns an empty set
# and exit 0, which reads as "nothing is on it" — a confident answer to a
# question that was never asked. So the network is verified to exist first.
select_network() {
    local net="$1" known matched name
    if ! known="$(podman network ls --format '{{.Name}}' 2>&1)"; then
        die "podman network ls failed: $known"
    fi
    if ! printf '%s\n' "$known" | grep -qx -- "$net"; then
        echo "podfreeze: no such network: '$net'" >&2
        echo "  Known networks:" >&2
        while read -r name; do
            if [ -n "$name" ]; then
                echo "    $name" >&2
            fi
        done <<< "$known"
        exit 1
    fi

    if ! matched="$(podman ps --all --filter "network=$net" --format '{{.Names}}' 2>&1)"; then
        die "podman ps --filter network=$net failed: $matched"
    fi

    SELECTED=()
    while read -r name; do
        if [ -n "$name" ] && inventory_index_of "$name" > /dev/null; then
            SELECTED+=("$name")
        fi
    done <<< "$matched"
}

select_names() {
    local name
    local -a unknown=()
    SELECTED=()
    for name in "$@"; do
        if inventory_index_of "$name" > /dev/null; then
            SELECTED+=("$name")
        else
            unknown+=("$name")
        fi
    done
    if [ "${#unknown[@]}" -gt 0 ]; then
        echo "podfreeze: not a running or frozen container: ${unknown[*]}" >&2
        echo "  Run 'podfreeze list' to see what is available." >&2
        exit 1
    fi
}

# --- identity groups: GitHub account, Anthropic token, SSH key ---------------
#
# CCY stamps each session with who it is running as, so "freeze everything
# running as <github id>" is a filter over labels rather than a guess from
# container names. All three work the same way and differ only in which lookup
# they read, so one pair of helpers is parameterised by the axis name — three
# near-identical copies would be three places to fix a bug.
#
# Axis + container -> that container's label value, empty when it has none.
# A case over the three arrays rather than a nameref: the indirection would hide
# every read of INV_GITHUB/INV_TOKEN/INV_SSHKEYS from static analysis, which is
# how a typo'd array name becomes a silent empty group.
identity_value_of() {
    local axis="$1" name="$2"
    case "$axis" in
        github) printf '%s' "${INV_GITHUB[$name]:-}" ;;
        token) printf '%s' "${INV_TOKEN[$name]:-}" ;;
        ssh-key) printf '%s' "${INV_SSHKEYS[$name]:-}" ;;
        *) die "internal error: unknown identity axis '$axis'." ;;
    esac
}

# ccy-ssh-keys can name several keys, so membership is a WORD match on the label
# value; the single-valued axes compare whole. Getting this wrong in the lenient
# direction would silently widen a freeze, so the two cases are explicit.
identity_matches() {
    local axis="$1" want="$2" have="$3" word
    if [ "$axis" != "ssh-key" ]; then
        [ "$have" = "$want" ]
        return
    fi
    for word in $have; do
        if [ "$word" = "$want" ]; then
            return 0
        fi
    done
    return 1
}

# Distinct values present in the current inventory, one per line, sorted. Built
# from what is actually running, so the menu never offers a group with no
# members — the same rule the network map follows.
identity_values() {
    local axis="$1" name value word
    {
        for name in "${INV_NAME[@]}"; do
            value="$(identity_value_of "$axis" "$name")"
            if [ -z "$value" ]; then
                continue
            fi
            if [ "$axis" = "ssh-key" ]; then
                for word in $value; do
                    printf '%s\n' "$word"
                done
            else
                printf '%s\n' "$value"
            fi
        done
    } | sort -u
}

identity_names() {
    local axis="$1" want="$2" name
    for name in "${INV_NAME[@]}"; do
        if identity_matches "$axis" "$want" "$(identity_value_of "$axis" "$name")"; then
            printf '%s\n' "$name"
        fi
    done
}

# An unknown value must fail loudly. Resolving it to an empty set and exiting 0
# would report "nothing to do" for a question that was never asked — the same
# trap select_network guards against for a non-existent network.
select_identity() {
    local axis="$1" want="$2" values value
    values="$(identity_values "$axis")"
    if [ -z "$values" ] || ! printf '%s\n' "$values" | grep -qxF -- "$want"; then
        echo "podfreeze: no running or frozen CCY session has --$axis '$want'" >&2
        if [ -z "$values" ]; then
            echo "  No session carries a $axis label at all. Sessions started by" >&2
            echo "  a CCY older than 3.40.0 are unlabelled — relaunch to label them." >&2
        else
            echo "  Known values:" >&2
            while read -r value; do
                if [ -n "$value" ]; then
                    echo "    $value" >&2
                fi
            done <<< "$values"
        fi
        exit 1
    fi
    mapfile -t SELECTED < <(identity_names "$axis" "$want")
    warn_identity_blind_spot
}

# A session started before CCY 3.40.0 carries no identity labels, so it is in
# --ccy but in NO identity group. Its account cannot be inferred — the labels
# are the only evidence there is — so the selection is correct as far as it can
# go, and stays silent about the sessions it could not consider.
#
# That silence is the problem. The whole point of the identity axes is "freeze
# everything running as account X", and a partial answer to that reads exactly
# like a complete one. The check above already refuses the case where NOTHING is
# labelled; this is the same guard for the case where only SOME is, which is the
# state a machine is actually in for as long as it takes every session to be
# relaunched. Disclose, do not block: the user may well know the unlabelled ones
# are irrelevant.
unlabelled_ccy_names() {
    local name
    for name in "${INV_NAME[@]}"; do
        if [ "${INV_IS_CCY[$name]:-0}" = "1" ] &&
            [ -z "${INV_GITHUB[$name]:-}" ] &&
            [ -z "${INV_TOKEN[$name]:-}" ] &&
            [ -z "${INV_SSHKEYS[$name]:-}" ]; then
            printf '%s\n' "$name"
        fi
    done
}

warn_identity_blind_spot() {
    local -a unlabelled=()
    mapfile -t unlabelled < <(unlabelled_ccy_names)
    if [ "${#unlabelled[@]}" -eq 0 ]; then
        return 0
    fi
    echo "podfreeze: NOTE — ${#unlabelled[@]} CCY session(s) carry no identity labels," >&2
    echo "  so they are in no identity group and are NOT in this selection:" >&2
    printf '    %s\n' "${unlabelled[@]}" >&2
    echo "  They predate CCY 3.40.0. Use --ccy to cover every session regardless" >&2
    echo "  of identity, or relaunch them to make them selectable by identity." >&2
}

# ---------------------------------------------------------------------------
# Reporting
#
# `list` and `--dry-run` exist to print for a human, so their table IS the
# payload and goes to stdout. Everywhere else the caller redirects it to
# stderr, because there it is context around a prompt, not a return value
# (CLAUDE/StderrHygiene.md).
# ---------------------------------------------------------------------------

print_table() {
    local name i
    printf '  %-34s %-8s %-4s %s\n' "NAME" "STATE" "CCY" "NETWORKS"
    for name in "$@"; do
        if ! i="$(inventory_index_of "$name")"; then
            continue
        fi
        printf '  %-34s %-8s %-4s %s\n' \
            "$name" "${INV_STATE[$i]}" "$(ccy_marker "$name")" "${INV_NETS[$i]}"
    done
}

do_list() {
    local -a running=() frozen=()
    local i

    for i in "${!INV_NAME[@]}"; do
        if [ "${INV_STATE[$i]}" = "paused" ]; then
            frozen+=("${INV_NAME[$i]}")
        else
            running+=("${INV_NAME[$i]}")
        fi
    done

    echo "=== frozen (${#frozen[@]}) ==="
    if [ "${#frozen[@]}" -eq 0 ]; then
        echo "  (none)"
    else
        print_table "${frozen[@]}"
        echo ""
        echo "  Thaw them all with: podfreeze thaw --all"
    fi
    echo ""
    echo "=== running (${#running[@]}) ==="
    if [ "${#running[@]}" -eq 0 ]; then
        echo "  (none)"
    else
        print_table "${running[@]}"
    fi
}

# ---------------------------------------------------------------------------
# Interactive picker
# ---------------------------------------------------------------------------

# Echoes a target key on stdout: "ccy", "all", "net:<name>", or "pick".
#
# Groups come FIRST and per-container picking is the last entry, because acting
# on a whole group is the common case — the earlier version opened straight
# into a TAB-to-multi-select container list, which made the group targets
# reachable only by knowing the flag names.

# What choosing a group would do, given what is in it right now. It applies the
# same rule infer_action() does — or an explicit CLI verb when one was given —
# so the label can never disagree with the outcome.
target_effect() {
    local running frozen
    running="$(count_in_state running "$@")"
    frozen="$(count_in_state paused "$@")"

    case "$ACTION" in
        freeze)
            if [ "$running" -gt 0 ]; then
                printf 'FREEZE %s' "$running"
            else
                printf 'nothing to freeze'
            fi
            return 0
            ;;
        thaw)
            if [ "$frozen" -gt 0 ]; then
                printf 'THAW   %s' "$frozen"
            else
                printf 'nothing to thaw'
            fi
            return 0
            ;;
    esac

    if [ "$running" -gt 0 ]; then
        printf 'FREEZE %s' "$running"
    elif [ "$frozen" -gt 0 ]; then
        printf 'THAW   %s' "$frozen"
    else
        printf 'nothing to do'
    fi
}

pick_target() {
    local net selection reply attempt total i axis value
    local -a keys=() labels=() nets=() group=() values=()

    if [ ! -t 2 ] || [ ! -r /dev/tty ]; then
        die "no terminal to ask on — name a target explicitly: NAME..., --ccy,
  --network NET, or --all. See 'podfreeze --help'."
    fi

    mapfile -t group < <(ccy_names)
    keys+=("ccy")
    labels+=("$(printf '%-38s %s' "all CCY (Claude) containers" \
        "$(target_effect "${group[@]+${group[@]}}")")")

    keys+=("all")
    labels+=("$(printf '%-38s %s' "all containers" \
        "$(target_effect "${INV_NAME[@]}")")")

    if [ "${#NET_MEMBERS[@]}" -gt 0 ]; then
        mapfile -t nets < <(printf '%s\n' "${!NET_MEMBERS[@]}" | sort)
        for net in "${nets[@]}"; do
            mapfile -t group < <(network_names "$net")
            keys+=("net:$net")
            labels+=("$(printf '%-38s %s' "network: $net" \
                "$(target_effect "${group[@]+${group[@]}}")")")
        done
    fi

    # Identity groups, one row per distinct value actually present. Offered only
    # when a value does not cover every CCY session — with a single GitHub
    # account on the machine "github: <id>" and "all CCY containers" are the
    # same button, and a menu that says the same thing twice is harder to read,
    # not more capable.
    for axis in github token ssh-key; do
        mapfile -t values < <(identity_values "$axis")
        if [ "${#values[@]}" -lt 2 ]; then
            continue
        fi
        for value in "${values[@]}"; do
            mapfile -t group < <(identity_names "$axis" "$value")
            keys+=("id:$axis:$value")
            labels+=("$(printf '%-38s %s' "$axis: $value" \
                "$(target_effect "${group[@]+${group[@]}}")")")
        done
    done

    # No "pick individual containers..." entry: choosing "all containers" and
    # drilling into it IS that, so a separate row would be a second route to
    # one screen.

    total="${#labels[@]}"

    # Cancelling is a normal way to leave a menu that loops, not an error, so
    # it comes back as a "quit" key rather than as a non-zero exit.
    if have fzf; then
        if ! selection="$(printf '%s\n' "${labels[@]}" |
            fzf --height=50% --reverse \
                --prompt="podfreeze: " \
                --header="ENTER acts on the chosen group — ESC to quit")"; then
            printf 'quit'
            return 0
        fi
        for i in "${!labels[@]}"; do
            if [ "${labels[$i]}" = "$selection" ]; then
                printf '%s' "${keys[$i]}"
                return 0
            fi
        done
        die "internal error: chosen entry not found."
    fi

    echo "What to act on:" >&2
    for i in "${!labels[@]}"; do
        printf '  %2d) %s\n' "$(( i + 1 ))" "${labels[$i]}" >&2
    done

    attempt=1
    while :; do
        printf 'Choice [1-%d, q to quit]: ' "$total" >&2
        if ! read -r reply < /dev/tty; then
            echo >&2
            printf 'quit'
            return 0
        fi
        case "$reply" in
            q | Q | quit)
                printf 'quit'
                return 0
                ;;
            "" | *[!0-9]*) ;;
            *)
                if [ "$reply" -ge 1 ] && [ "$reply" -le "$total" ]; then
                    printf '%s' "${keys[$(( reply - 1 ))]}"
                    return 0
                fi
                ;;
        esac
        echo "  Not one of the options — enter a number between 1 and $total, or q." >&2
        attempt=$(( attempt + 1 ))
        if [ "$attempt" -gt "$MAX_TRIES" ]; then
            die "giving up after $MAX_TRIES attempts — nothing changed."
        fi
    done
}

# Echoes the chosen names on stdout, one per line. The menu is drawn on stderr
# so a caller capturing this gets names and nothing else.
# What this ONE container is about to have done to it. The group row says
# "FREEZE 5"; a row inside the group says which of the five it is.
row_verb() {
    local name="$1" i state
    if ! i="$(inventory_index_of "$name")"; then
        printf '?'
        return 0
    fi
    state="${INV_STATE[$i]}"
    # Written out rather than as `test && printf || printf`: that shape silently
    # runs the third branch when the second one fails, which is the discarded-
    # failure-signal class this repo gates on (CLAUDE/AgentNotes.md).
    case "$ACTION" in
        freeze)
            if [ "$state" = "running" ]; then printf 'FREEZE'; else printf '-'; fi
            ;;
        thaw)
            if [ "$state" = "paused" ]; then printf 'THAW'; else printf '-'; fi
            ;;
        *)
            if [ "$state" = "running" ]; then printf 'FREEZE'; else printf 'THAW'; fi
            ;;
    esac
}

# The second screen: having chosen a group, see WHAT IS IN IT before acting.
#
# The first row is "all N", so the common case — act on the whole group — is
# still one keypress, and the earlier feedback that per-container tabbing was
# being forced on the user is not undone. What it adds is sight of the members:
# a group row says "network: podman — FREEZE 5" and names nothing, which is
# precisely where a live Claude session hides inside an app network (F15).
#
# Emits the chosen names on stdout, one per line. Returns non-zero for back or
# cancel, which the caller treats as "return to the group menu".
drill_into_group() {
    local -a group=("$@")
    local i total line selection reply attempt token ok name
    local -a menu=() picked=() tokens=()

    total="${#group[@]}"
    if [ "$total" -eq 0 ]; then
        return 1
    fi

    if [ ! -t 2 ] || [ ! -r /dev/tty ]; then
        die "no terminal to ask on — name a target explicitly, or use --ccy /
  --network NET / --all. See 'podfreeze --help'."
    fi

    # Sentinel-prefixed so a container can never be mistaken for a control row:
    # the emitters below key on the first field, and a container named "all"
    # would otherwise collide with the "act on everything" row.
    menu+=("$(printf '%-34s %s' "$ALL_ROW_KEY" \
        "$(target_effect "${group[@]}")")")
    for name in "${group[@]}"; do
        i="$(inventory_index_of "$name")" || continue
        menu+=("$(printf '%-34s %-8s %-4s %-22s %s' \
            "$name" "${INV_STATE[$i]}" "$(ccy_marker "$name")" \
            "${INV_NETS[$i]}" "$(row_verb "$name")")")
    done

    if have fzf; then
        if ! selection="$(printf '%s\n' "${menu[@]}" |
            fzf --multi --height=60% --reverse \
                --prompt="In this group: " \
                --header="ENTER on the first row acts on all — TAB picks specific ones, ESC goes back")"; then
            return 1
        fi
        if [ -z "$selection" ]; then
            return 1
        fi
        picked=()
        while read -r line; do
            if [ -z "$line" ]; then
                continue
            fi
            if [ "${line%% *}" = "$ALL_ROW_KEY" ]; then
                printf '%s\n' "${group[@]}"
                return 0
            fi
            picked+=("${line%% *}")
        done <<< "$selection"
        if [ "${#picked[@]}" -eq 0 ]; then
            return 1
        fi
        printf '%s\n' "${picked[@]}"
        return 0
    fi

    echo "In this group:" >&2
    for i in "${!menu[@]}"; do
        printf '  %2d) %s\n' "$(( i + 1 ))" "${menu[$i]}" >&2
    done

    attempt=1
    while :; do
        printf 'Choice [ENTER or 1 for all, numbers for specific, b to go back]: ' >&2
        if ! read -r reply < /dev/tty; then
            echo >&2
            return 1
        fi
        case "$reply" in
            b | B | back | q | Q | quit)
                return 1
                ;;
            "" | 1 | a | A | all)
                printf '%s\n' "${group[@]}"
                return 0
                ;;
        esac

        picked=()
        ok=1
        read -r -a tokens <<< "${reply//,/ }"
        for token in "${tokens[@]+${tokens[@]}}"; do
            case "$token" in
                "" | *[!0-9]*) ok=0 ;;
                *)
                    # Row 1 is "all"; containers start at 2, so shift by two to
                    # index the group.
                    if [ "$token" -ge 2 ] && [ "$token" -le "$(( total + 1 ))" ]; then
                        picked+=("${group[$(( token - 2 ))]}")
                    else
                        ok=0
                    fi
                    ;;
            esac
        done

        if [ "$ok" -eq 1 ] && [ "${#picked[@]}" -gt 0 ]; then
            printf '%s\n' "${picked[@]}"
            return 0
        fi

        echo "  Not a valid choice — 1 (or ENTER) for all, 2-$(( total + 1 )) for" >&2
        echo "  specific containers, or 'b' to go back." >&2
        attempt=$(( attempt + 1 ))
        if [ "$attempt" -gt "$MAX_TRIES" ]; then
            die "giving up after $MAX_TRIES attempts — nothing changed."
        fi
    done
}

# Echoes 'freeze' or 'thaw' on stdout.
# ---------------------------------------------------------------------------
# Action
# ---------------------------------------------------------------------------

# There is only ever one sensible verb for a given set, so it is derived rather
# than asked: anything running gets frozen, and a set with nothing running gets
# thawed. Running it twice on the same target therefore toggles it. An explicit
# `freeze`/`thaw` on the command line still wins — scripts need to say what they
# mean rather than depend on current state.
infer_action() {
    local name i
    for name in "${SELECTED[@]+${SELECTED[@]}}"; do
        if i="$(inventory_index_of "$name")" && [ "${INV_STATE[$i]}" = "running" ]; then
            printf 'freeze'
            return 0
        fi
    done
    printf 'thaw'
}

do_action() {
    local action="$1"
    local name i want_state podman_verb past out
    local failed=0
    local -a targets=() skipped=()

    if [ "$action" = "freeze" ]; then
        want_state="running"
        podman_verb="pause"
        past="FROZEN"
    else
        want_state="paused"
        podman_verb="unpause"
        past="THAWED"
    fi

    if [ "${#SELECTED[@]}" -eq 0 ]; then
        die "nothing matched — the selection is empty.
  Run 'podfreeze list' to see what is running and what is frozen."
    fi

    for name in "${SELECTED[@]}"; do
        if ! i="$(inventory_index_of "$name")"; then
            continue
        fi
        if [ "${INV_STATE[$i]}" = "$want_state" ]; then
            targets+=("$name")
        else
            skipped+=("$name")
        fi
    done

    if [ "${#skipped[@]}" -gt 0 ]; then
        echo "Skipped — not currently $want_state: ${skipped[*]}" >&2
    fi

    if [ "${#targets[@]}" -eq 0 ]; then
        echo "Nothing to do — every selected container is already in the requested state." >&2
        return 0
    fi

    if [ "$DRY_RUN" -eq 1 ]; then
        echo "DRY RUN — ${#targets[@]} container(s) would be $past:"
        print_table "${targets[@]}"
        return 0
    fi

    # Printed before acting, not to ask permission but to leave a record of
    # exactly what was touched. There is deliberately no confirmation prompt:
    # freezing is the cgroup freezer and is undone by running podfreeze again
    # on the same target, so a prompt would be guarding a reversible act — and
    # in the interactive path the menu row already named the verb and the count
    # before it was chosen. The table's CCY column says which rows are Claude
    # sessions; what freezing one implies is left to the reader.
    echo "${#targets[@]} container(s) being $past:" >&2
    print_table "${targets[@]}" >&2

    # Each container is acted on individually so a single failure is NAMED
    # rather than collapsing the batch into one opaque exit status, and so a
    # failure part-way through does not silently abandon the rest. Every
    # failure is printed and the command still exits non-zero.
    for name in "${targets[@]}"; do
        if out="$(podman "$podman_verb" "$name" 2>&1)"; then
            echo "  ✓ $name" >&2
        else
            echo "  ✗ $name — $out" >&2
            failed=$(( failed + 1 ))
        fi
    done

    if [ "$action" = "freeze" ]; then
        echo "" >&2
        echo "  Thaw them with: podfreeze thaw ${targets[*]}" >&2
    fi

    # Returns rather than dies, so the interactive loop can report a failure
    # and carry on. The one-shot path runs this as its last command, so the
    # status still becomes the script's.
    if [ "$failed" -gt 0 ]; then
        echo "podfreeze: $failed of ${#targets[@]} container(s) failed — see above." >&2
        return 1
    fi
    return 0
}

# The interactive session: menu, act, refresh, menu again — the inventory is
# re-read every pass so the counts describe the machine as it is now, not as it
# was when the tool started. Leaves only when you quit.
interactive_loop() {
    local key picked rest status=0

    while :; do
        load_inventory
        build_network_map

        if [ "${#INV_NAME[@]}" -eq 0 ]; then
            echo "No running or frozen containers." >&2
            return 0
        fi

        key="$(pick_target)"
        case "$key" in
            quit) return "$status" ;;
            ccy) select_ccy ;;
            all) select_all ;;
            net:*) select_network "${key#net:}" ;;
            id:*)
                # id:<axis>:<value> — the value may itself contain a colon, so
                # only the axis is split off.
                rest="${key#id:}"
                select_identity "${rest%%:*}" "${rest#*:}"
                ;;
            *) die "internal error: unknown target key '$key'." ;;
        esac

        if [ "${#SELECTED[@]}" -eq 0 ]; then
            echo "Nothing in that group." >&2
            echo "" >&2
            continue
        fi

        # Second screen: see the members, act on all of them or a subset.
        # Backing out returns to the group menu rather than quitting — it is
        # one level down, not a separate command.
        if ! picked="$(drill_into_group "${SELECTED[@]}")"; then
            echo "" >&2
            continue
        fi
        mapfile -t SELECTED <<< "$picked"

        if ! do_action "${ACTION:-$(infer_action)}"; then
            status=1
        fi
        echo "" >&2
    done
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------

ACTION=""
TARGET_MODE=""
TARGET_NETWORK=""
TARGET_IDENTITY_AXIS=""
TARGET_IDENTITY_VALUE=""
declare -a TARGET_NAMES=()

set_target_mode() {
    if [ -n "$TARGET_MODE" ]; then
        die "choose one target only — '$TARGET_MODE' and '$1' are mutually exclusive."
    fi
    TARGET_MODE="$1"
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        -h | --help)
            usage
            exit 0
            ;;
        -n | --dry-run)
            DRY_RUN=1
            shift
            ;;
        --ccy)
            set_target_mode "--ccy"
            shift
            ;;
        --all)
            set_target_mode "--all"
            shift
            ;;
        --network)
            set_target_mode "--network"
            shift
            if [ "$#" -eq 0 ]; then
                die "--network needs a network name — see 'podfreeze --help'."
            fi
            TARGET_NETWORK="$1"
            shift
            ;;
        --github | --token | --ssh-key)
            set_target_mode "$1"
            TARGET_IDENTITY_AXIS="${1#--}"
            shift
            if [ "$#" -eq 0 ]; then
                die "--$TARGET_IDENTITY_AXIS needs a value — see 'podfreeze --help'."
            fi
            TARGET_IDENTITY_VALUE="$1"
            shift
            ;;
        list | freeze | thaw)
            if [ -n "$ACTION" ]; then
                die "only one verb at a time — already have '$ACTION'."
            fi
            ACTION="$1"
            shift
            ;;
        -*)
            die "unknown option '$1' — see 'podfreeze --help'."
            ;;
        *)
            TARGET_NAMES+=("$1")
            shift
            ;;
    esac
done

if [ "${#TARGET_NAMES[@]}" -gt 0 ]; then
    set_target_mode "names"
fi

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

assert_on_host
assert_podman
load_inventory

if [ "$ACTION" = "list" ]; then
    if [ -n "$TARGET_MODE" ]; then
        die "'list' takes no target — it reports everything."
    fi
    do_list
    exit 0
fi

# No target on the command line means the interactive session, which loops
# until you quit. A named target is the one-shot, scriptable form.
if [ -z "$TARGET_MODE" ]; then
    interactive_loop
    exit $?
fi

case "$TARGET_MODE" in
    "--ccy") select_ccy ;;
    "--all") select_all ;;
    "--network") select_network "$TARGET_NETWORK" ;;
    "--github" | "--token" | "--ssh-key")
        select_identity "$TARGET_IDENTITY_AXIS" "$TARGET_IDENTITY_VALUE"
        ;;
    "names") select_names "${TARGET_NAMES[@]}" ;;
esac

do_action "${ACTION:-$(infer_action)}"
