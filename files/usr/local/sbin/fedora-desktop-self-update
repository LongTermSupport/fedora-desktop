#!/usr/bin/env bash
# fedora-desktop-self-update — the unattended self-update cycle on a server (Plan 00137).
#
# Brings the deploy-only clone up to the newest commit signed by the owner's pinned key,
# runs the allowlisted plays whose inputs changed, then warns the ccy/cc sessions and
# reboots so they come back through the boot-time restore. After the boot, `verify` checks
# every restored session came back. Any failure stops the cycle with no reboot.
#
# Usage:
#   fedora-desktop-self-update run [--dry-run]   the timer's cycle; --dry-run names the
#                                                plays it would run and changes nothing
#   fedora-desktop-self-update verify            the post-boot check, when one is owed
#   fedora-desktop-self-update status            the last result, for a human
#   fedora-desktop-self-update -h|--help         this text
#
# Exit codes: 0 done or nothing to do; 20 update or trust gate refused; 21 a play failed;
# 22 a session could not be warned; 23 a restored session is not running; 24 the reboot
# request was refused; 64 usage; 70 config invalid, the allowed-signers file or the system
# ansible-core or its collections are not root-owned, or an ansible search path is in the
# user's home; 75 another play run holds the lock;
# 77 not run as root; 130 the countdown was interrupted.
#
# Root only, and nothing it runs comes from the caller: PATH is fixed, every path is a
# constant below, and the work is done by helpers/self_update/cycle.py from the root-owned
# deploy clone. The contract is CLAUDE/Plan/00137-unattended-server-self-update/DESIGN-cycle.md.
#
# FEDORA_DESKTOP_SELF_UPDATE_TEST_PREFIX exists only for scripts/test-self-update-cycle.bash.
# It roots every path below under a scratch directory and puts its stub bin/ first on PATH.
# It cannot reach a real run: this file is root-only 0700, and sudo's env_reset drops the
# variable for the one command the sudoers drop-in allows.
set -euo pipefail

PREFIX="${FEDORA_DESKTOP_SELF_UPDATE_TEST_PREFIX:-}"
PATH="${PREFIX:+${PREFIX}/bin:}/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
export PATH

ETC="${PREFIX}/etc/fedora-desktop"
CONFIG="${ETC}/self-update.conf"
BECOME="${ETC}/self-update.become"
VAULT="${ETC}/self-update.vault"
ALLOWED_SIGNERS="${ETC}/self-update.allowed_signers"
# Present only when the install declares a Slack webhook; read only when ALERT_SINKS names slack.
SLACK_WEBHOOK="${ETC}/self-update.slack-webhook"
# The root-owned system ansible-core the plays must run (D5), never the user's pipx copy.
ANSIBLE_PLAYBOOK="${PREFIX}/usr/bin/ansible-playbook"
CLONE="${PREFIX}/var/lib/fedora-desktop/deploy"
STATE="${PREFIX}/var/lib/fedora-desktop/self-update"
# The user-readable copy of each result, which the host-health report reads.
PUBLISHED="${PREFIX}/var/lib/fedora-desktop/self-update-status"

usage() {
    awk 'NR == 1 { next } /^#/ { print substr($0, 3); next } { exit }' "${BASH_SOURCE[0]}"
}

case "${1:-}" in
run | verify | status) ;;
-h | --help)
    usage
    exit 0
    ;;
*)
    echo "fedora-desktop-self-update: expected run, verify or status. See --help." >&2
    exit 64
    ;;
esac

if [[ -z "${PREFIX}" && "${EUID}" -ne 0 ]]; then
    echo "fedora-desktop-self-update: must run as root (the timer runs it as root; by hand: sudo fedora-desktop-self-update ${1})" >&2
    exit 77
fi

for dir in "${CLONE}" "${STATE}" "${PUBLISHED}"; do
    if [[ ! -d "${dir}" ]]; then
        echo "fedora-desktop-self-update: ${dir} does not exist; deploy the self-update play first" >&2
        exit 70
    fi
done

# The helpers are imported from the deploy clone, so nothing is imported until its HEAD is
# proven to be a commit the pinned key signed and the clone holds no file that commit does
# not, ignored ones included: Python would import a stray .pyc or a stray module as readily
# as a signed one. The only exception is the host_vars copy the play installs, which is
# data. The cycle's own gate judges only commits ABOVE HEAD, so it cannot vouch for the
# code that runs it. The signing programs are pinned on git's command line, so the clone's
# config cannot choose what judges it, and a non-SSH signature runs `false`, never a signer.
# The key list that judges is itself checked first: whoever could edit it could vouch.
if [[ ! -f "${CONFIG}" ]]; then
    echo "fedora-desktop-self-update: ${CONFIG} does not exist; deploy the self-update play first" >&2
    exit 70
fi
PRINCIPAL="$(awk -F= '$1 == "PRINCIPAL" { print substr($0, length($1) + 2); exit }' "${CONFIG}")"
if [[ -z "${PRINCIPAL}" ]]; then
    echo "fedora-desktop-self-update: ${CONFIG} names no PRINCIPAL; re-run the self-update play" >&2
    exit 70
fi
unwritable_by_others() {
    local owner mode
    read -r owner mode < <(stat -c '%u %a' -- "$1")
    [[ "${owner}" == 0 || "${owner}" == "${EUID}" ]] && ((!(8#${mode} & 8#022)))
}
if [[ -L "${ALLOWED_SIGNERS}" || ! -f "${ALLOWED_SIGNERS}" ]] ||
    ! unwritable_by_others "${ALLOWED_SIGNERS}" || ! unwritable_by_others "${ETC}"; then
    echo "fedora-desktop-self-update: ${ALLOWED_SIGNERS} (the allowed-signers key list) is not a regular file that only root can change; re-run the self-update play" >&2
    exit 70
fi
if ! SSH_KEYGEN="$(command -v ssh-keygen)"; then
    echo "fedora-desktop-self-update: ssh-keygen is not installed, so no signature can be checked" >&2
    exit 70
fi
GIT=(git -C "${CLONE}" -c core.hooksPath=/dev/null -c core.fsmonitor=false -c protocol.ext.allow=never
    -c gpg.program=false -c gpg.openpgp.program=false -c gpg.x509.program=false
    -c "gpg.ssh.program=${SSH_KEYGEN}" -c "gpg.ssh.allowedSignersFile=${ALLOWED_SIGNERS}")
UNTRUSTED="re-run the self-update play: it moves the clone to the newest commit your key signed"
# The play never updates an existing clone (update: false), and its anchor refuses a dirty
# one, so re-running it cannot clear these two. Only a fresh clone can.
RECLONE="re-running the play cannot clear this. Run the self-update play once with self_update_enabled: false in host_vars, which removes the clone and the rest of the automation, then once more with it true, which clones and anchors afresh"
if ! SIGNATURE="$("${GIT[@]}" log -1 --format='%G?:%GS' HEAD 2>&1)" ||
    [[ "${SIGNATURE}" != "G:${PRINCIPAL}" ]]; then
    echo "fedora-desktop-self-update: the deploy clone's HEAD is not a commit signed by ${PRINCIPAL}; nothing from it was run. ${UNTRUSTED}" >&2
    exit 20
fi
if ! DIRT="$("${GIT[@]}" status --porcelain=v1 --untracked-files=all 2>&1)" || [[ -n "${DIRT}" ]]; then
    echo "fedora-desktop-self-update: the deploy clone differs from its signed HEAD; nothing from it was run; ${RECLONE}" >&2
    exit 20
fi
# Without --exclude-standard this lists ignored files too, and a nested repository as `dir/`.
# The host_vars copy is excused by exact path, as the anchor does: a pattern would also
# excuse a directory of that name and everything in it. NUL-separated, so no file name can
# split into lines that each look like the excused one.
EXCUSED=environment/localhost/host_vars/localhost.yml
STRAYS=()
while IFS= read -r -d '' path; do
    [[ "${path}" == "${EXCUSED}" ]] || STRAYS+=("${path}")
done < <("${GIT[@]}" ls-files --others -z)
if ! wait "$!"; then
    echo "fedora-desktop-self-update: git could not list the deploy clone's untracked files; nothing from it was run" >&2
    exit 20
fi
if [[ ${#STRAYS[@]} -gt 0 ]]; then
    SHOWN="$(printf '%s; ' "${STRAYS[@]}")"
    echo "fedora-desktop-self-update: the deploy clone holds files its signed commit does not, ignored ones included; nothing from it was run; ${RECLONE}. They are: ${SHOWN%; }" >&2
    exit 20
fi

# -B writes no bytecode into the clone, and the pycache prefix, in root's own state
# directory, means none beside the sources is ever read. -E and -s ignore PYTHON* and
# the user site. (-I would drop the clone from sys.path, and -m needs it there.)
cd "${CLONE}"
exec python3 -E -s -B -X "pycache_prefix=${STATE}/pycache" -m helpers.self_update.cycle \
    --config "${CONFIG}" --state-dir "${STATE}" --published-dir "${PUBLISHED}" --clone "${CLONE}" \
    --become "${BECOME}" --vault "${VAULT}" --allowed-signers "${ALLOWED_SIGNERS}" \
    --ansible-playbook "${ANSIBLE_PLAYBOOK}" --slack-webhook "${SLACK_WEBHOOK}" "$@"
