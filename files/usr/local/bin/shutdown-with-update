#!/bin/bash
# Shutdown with Update - Updates firmware, dnf packages, Flatpaks, pipx tools and the Rust toolchain before shutdown
#
# Two names, one script. Installed as /usr/local/bin/shutdown-with-update and, by symlink,
# /usr/local/bin/reboot-with-update. Both run the updates, then warn every running ccy/cc
# session through `ccy-sessions notify going-down`, count down N minutes (default 2,
# `--in N`), warn again at one minute, and only then bring the machine down. The name
# decides only the last step:
#   shutdown-with-update [--in N]   shutdown -h now
#   reboot-with-update [--in N]     systemctl reboot
# The warning kind is NOT the name's: ccy-sessions picks it by whether the user's session
# restore is enabled, because that is what decides whether an agent should hand off.
# Both run as root via sudo from the desktop user and need SUDO_USER: the sessions belong
# to that user and are found through that user's tmux server.
#
# How much the sessions may hold the machine up follows the provisioning profile, which
# play-basic-configs.yml records in PROFILE_FILE:
#   desktop  whoever ran it said go down, so it goes down. Sessions are warned and given the
#            countdown, but a session that cannot be warned, a warning that fails or hangs,
#            and an inhibitor are all reported and then gone past (inhibitors with
#            `-i`). Nothing waits without a bound. A failed update step, dnf included,
#            is journalled (journalctl -t shutdown-with-update) and the run goes on.
#   server   session-strict: any of those stops it and leaves the machine up, as does a
#            failed dnf, and a refused shutdown asks whether to force it. `--strict-sessions` asks for this on
#            a desktop too.
set -euo pipefail

MODE="shutdown"
case "$(basename "$0")" in
shutdown-with-update) ;;
reboot-with-update)
    MODE="reboot"
    ;;
*)
    echo "Error: this script must be invoked as shutdown-with-update or reboot-with-update, not $(basename "$0")" >&2
    exit 64
    ;;
esac

# Ctrl+C: stop, and if the sessions have already been told the machine is going down, tell
# them it is not. `reboot-cancelled` is the daemon's one withdrawal signal and covers both
# warning kinds. Sent as the user whose sessions they are.
SESSIONS_WARNED=false
COUNTDOWN_PID=""
cancel() {
    trap - INT TERM
    if [ -n "$COUNTDOWN_PID" ] && ! kill "$COUNTDOWN_PID"; then
        echo "(the countdown had already ended)"
    fi
    echo ""
    echo "${MODE^} cancelled by user."
    # 130, as ccy-sessions exits on the same event. The EXIT trap withdraws the warning.
    exit 130
}
trap cancel INT TERM

# Armed just BEFORE the first warning goes out, so every exit from then on that is not the
# machine going down withdraws it: a warning that failed part-way (some projects already
# signalled), a failed one-minute warning, Ctrl-C in the countdown, a shutdown refused and
# not forced, no terminal to ask on, a power action that fails. A successful power action
# never returns here, or returns 0.
withdraw_unless_down() {
    local status=$?
    if [ "$status" -ne 0 ] && [ "$SESSIONS_WARNED" = true ]; then
        echo "The machine is staying up; telling the sessions the $MODE is off." >&2
        if ! sessions notify reboot-cancelled; then
            echo "Error: the sessions could not be told; they still expect the $MODE." >&2
        fi
    fi
    exit "$status"
}

# A minute, in seconds; the bound on any one ccy-sessions call; and where the profile is
# recorded. Overridable so a test can drive them; nothing else should ever set them.
MINUTE_SECONDS="${WITH_UPDATE_MINUTE_SECONDS:-60}"
SESSIONS_TIMEOUT_SECONDS="${WITH_UPDATE_SESSIONS_TIMEOUT_SECONDS:-120}"
PROFILE_FILE="${WITH_UPDATE_PROFILE_FILE:-/etc/fedora-desktop/provisioning-profile}"

# ccy-sessions as the user whose sessions they are, and never for longer than the bound: a
# daemon CLI that hangs inside a container must not hold the machine up all night.
sessions() {
    timeout --kill-after=10 "$SESSIONS_TIMEOUT_SECONDS" sudo -u "$SUDO_USER" -H "$CCY_SESSIONS" "$@"
}

# warn_sessions <minutes> — tell the sessions the machine goes down in <minutes>. A failure
# stops a strict run (the EXIT trap withdraws whatever was reached) and is reported and gone
# past on a desktop.
warn_sessions() {
    if sessions notify going-down --minutes "$1"; then
        return 0
    fi
    if [ "$STRICT_SESSIONS" = true ]; then
        echo "Error: the sessions could not all be warned (see above), so the machine stays up." >&2
        exit 1
    fi
    echo "Warning: the sessions could not all be warned (see above). Going ahead: on a desktop the $MODE always happens." >&2
}

# journal <text> — record a failure where it is seen after the next boot:
# `journalctl -t shutdown-with-update`. A journal that cannot be written is said on stderr
# and does not stop the run; the text has already been printed.
journal() {
    if ! logger -t shutdown-with-update -p user.err -- "$1"; then
        echo "Warning: could not record this in the system journal: $1" >&2
    fi
}

# step_failed <step> — an update step that failed: said, journalled, and listed in the
# summary printed before the power action. Every update step goes on past a failure; only a
# strict run stops on a failed dnf.
FAILED_STEPS=()
step_failed() {
    FAILED_STEPS+=("$1")
    echo "Warning: $1 failed, continuing..." >&2
    journal "$1 failed"
}

# A firmware step exits 2 when there is nothing to do, which is not a failure.
firmware_step() {
    local step="$1" status=0
    shift
    fwupdmgr "$@" || status=$?
    if [ "$status" -ne 0 ] && [ "$status" -ne 2 ]; then
        step_failed "$step"
    fi
}

# A sleep the trap can interrupt: bash runs a handler only after the foreground command
# finishes, so a plain `sleep 60` would honour Ctrl-C a minute late — after the reboot.
countdown() {
    sleep "$1" &
    COUNTDOWN_PID=$!
    wait "$COUNTDOWN_PID"
    COUNTDOWN_PID=""
}

REBOOT_MINUTES=2
STRICT_FLAG=false
while [ $# -gt 0 ]; do
    case "$1" in
    -h | --help)
        echo "Usage: $(basename "$0") [--in MINUTES] [--strict-sessions]"
        echo "Updates firmware, dnf packages, Flatpaks, pipx tools and the Rust toolchain, then"
        echo "warns every running ccy/cc session (default 2 minutes, again at 1) and"
        if [ "$MODE" = reboot ]; then
            echo "reboots."
        else
            echo "shuts the machine down."
        fi
        echo ""
        echo "On a desktop nothing a session does stops it: a session that cannot be warned"
        echo "is reported and the $MODE goes ahead, past any inhibitor. ccy sessions with no"
        echo "container (still at ccy's startup prompts) are left out altogether. A failed"
        echo "update step, dnf included, is logged (journalctl -t shutdown-with-update) and"
        echo "the $MODE still happens."
        echo "On a server, or with --strict-sessions, a session that cannot be warned stops it"
        echo "before anything is updated, a failed dnf stops it, and a refused shutdown asks"
        echo "before forcing."
        exit 0
        ;;
    --strict-sessions)
        STRICT_FLAG=true
        shift
        ;;
    --in)
        if ! [[ "${2:-}" =~ ^[1-9][0-9]*$ ]]; then
            echo "Error: --in needs a whole number of minutes, at least 1; got '${2:-}'" >&2
            exit 64
        fi
        REBOOT_MINUTES="$2"
        shift 2
        ;;
    *)
        echo "Error: unknown option '$1'" >&2
        exit 64
        ;;
    esac
done

if [ ! -r "$PROFILE_FILE" ]; then
    echo "Error: $PROFILE_FILE is missing, so it is not known whether this is a desktop or a server; playbooks/imports/play-basic-configs.yml deploys it" >&2
    exit 1
fi
PROFILE="$(<"$PROFILE_FILE")"
case "$PROFILE" in
desktop) STRICT_SESSIONS="$STRICT_FLAG" ;;
server) STRICT_SESSIONS=true ;;
*)
    echo "Error: $PROFILE_FILE says '$PROFILE'; expected desktop or server. Re-run playbooks/imports/play-basic-configs.yml" >&2
    exit 1
    ;;
esac
if [ "$STRICT_SESSIONS" = true ]; then
    echo "Session-strict ($PROFILE profile, --strict-sessions $STRICT_FLAG): a session that cannot be warned keeps the machine up." >&2
else
    echo "Desktop: the update and the $MODE always happen; sessions are warned, not waited for." >&2
fi

# The warnings run as the invoking user, whose ccy-sessions is the one that can see that
# user's tmux server. Checked here, and rehearsed with --dry-run, BEFORE the updates: in a
# strict run a live session whose project has no daemon CLI is a refusal, and finding that
# out after twenty minutes of dnf would be the wrong order. The rehearsal is the same notify
# with --dry-run: it signals nothing, and prints the kind the sessions will actually be sent.
if [ -z "${SUDO_USER:-}" ]; then
    echo "Error: $(basename "$0") must be run through sudo from the user whose sessions are to be warned" >&2
    exit 1
fi
# From a root shell sudo reports SUDO_USER=root, and root has no ccy-sessions: the ccy
# sessions are the desktop user's. Refused rather than run unwarned — an agent killed
# mid-step by an unannounced power-off is what the warning exists to prevent.
if [ "$SUDO_USER" = root ]; then
    echo "Error: run $(basename "$0") through sudo from the desktop user whose ccy/cc sessions are to be warned, not from a root shell" >&2
    exit 1
fi
# Status captured explicitly: under strict mode a failed getent would otherwise abort
# with no message at all, two lines before the one that names the problem.
if ! user_home="$(getent passwd "$SUDO_USER" | cut -d: -f6)" || [ -z "$user_home" ]; then
    echo "Error: could not resolve a home directory for $SUDO_USER (getent passwd), so ccy-sessions cannot be found" >&2
    exit 1
fi
CCY_SESSIONS="$user_home/.local/bin/ccy-sessions"
if [ ! -x "$CCY_SESSIONS" ]; then
    echo "Error: $CCY_SESSIONS is missing; playbooks/imports/play-claude-yolo.yml deploys it" >&2
    exit 1
fi
echo "Checking that every running ccy/cc session can be warned..."
if ! sessions notify going-down --minutes "$REBOOT_MINUTES" --dry-run; then
    if [ "$STRICT_SESSIONS" = true ]; then
        echo "Error: not every session can be warned (see above). Nothing was updated and the machine stays up." >&2
        exit 1
    fi
    echo "Warning: not every session can be warned (see above). Going ahead: on a desktop the update and the $MODE always happen (--strict-sessions refuses instead)." >&2
fi

echo "Starting firmware updates..."
firmware_step "firmware refresh" refresh --force
firmware_step "firmware update" update -y

# A desktop powers off even when dnf fails: whoever ran this asked for the machine to go
# down, and the failure is journalled for the next boot. A strict run stops, machine up.
echo "Starting system package updates..."
if ! dnf -y upgrade; then
    if [ "$STRICT_SESSIONS" = true ]; then
        echo "Error: Package updates failed. The machine stays up." >&2
        exit 1
    fi
    step_failed "dnf upgrade"
fi

# Flatpak apps (Slack, videography tools) are installed system-wide by the
# playbooks (become: true) and are NOT covered by dnf, so update them explicitly.
# Update failures are non-fatal here: this runs right before poweroff, and a
# flaky mirror must never leave the machine unable to shut down.
echo "Starting Flatpak updates..."
if command -v flatpak >/dev/null; then
    if ! flatpak update --system -y; then
        step_failed "system Flatpak update"
    fi
    # Prune runtimes no installed app still needs. Updating alone never removes
    # the version it superseded, so every driver bump leaves its old GL runtime
    # behind for ever: this machine had accumulated 14 nvidia GL runtimes at
    # ~900MB each, 13 of them dead, against one loaded driver.
    #
    # Ordered AFTER the update so a runtime orphaned by this very run is
    # collected now rather than surviving until the next shutdown.
    #
    # "Unused" means no installed app depends on it, so this only ever reclaims
    # what nothing can launch. The corollary worth knowing: uninstall the last
    # app using a runtime and the next run reclaims it too, so reinstalling
    # that app later re-downloads its runtime.
    if ! flatpak uninstall --system --unused -y; then
        step_failed "system Flatpak cleanup"
    fi
    # Also update any per-user Flatpaks, as the invoking user rather than root.
    if [ -n "${SUDO_USER:-}" ]; then
        if ! sudo -u "$SUDO_USER" -H flatpak update --user -y; then
            step_failed "user Flatpak update"
        fi
        if ! sudo -u "$SUDO_USER" -H flatpak uninstall --user --unused -y; then
            step_failed "user Flatpak cleanup"
        fi
    fi
else
    echo "flatpak not installed, skipping."
fi

# pipx CLI tools (pdm, huggingface CLI) are installed into the invoking user's
# ~/.local/pipx by play-python.yml — not root's — so upgrade them as that user.
# The QA tools (ruff, semgrep) are pipx-pinned to .qa-versions, so upgrade-all
# skips them. Non-fatal for the same reason as the Flatpak block above.
echo "Starting pipx tool updates..."
update_user="${SUDO_USER:-$USER}"
if sudo -u "$update_user" -H bash -lc 'command -v pipx >/dev/null'; then
    if ! sudo -u "$update_user" -H bash -lc 'pipx upgrade-all'; then
        step_failed "pipx upgrade-all"
    fi
else
    echo "pipx not installed for $update_user, skipping."
fi

# Rust toolchain is installed into the invoking user's ~/.rustup / ~/.cargo by
# play-rust-dev.yml (optional), so update it as that user rather than root.
# Non-fatal for the same reason as the blocks above.
echo "Starting Rust toolchain updates..."
if sudo -u "$update_user" -H bash -lc 'command -v rustup >/dev/null'; then
    if ! sudo -u "$update_user" -H bash -lc 'rustup update'; then
        step_failed "rustup update"
    fi
else
    echo "rustup not installed for $update_user, skipping."
fi

echo "Updates complete. Checking for kernel module builds..."
# akmods is building when its process is present or its unit reports so. A bash pattern
# match, not `| grep -q`: under pipefail a matched grep exits first and the producer dies of
# SIGPIPE, which reports the pipeline as failed on exactly the match it was looking for.
akmods_building() {
    local status
    if pgrep -f "[a]kmods" >/dev/null; then
        return 0
    fi
    # `systemctl status` exits non-zero for an inactive unit; the text is still the answer,
    # so the status is read for its output and its exit code is deliberately not a verdict.
    if status="$(systemctl status akmods 2>&1)"; then :; fi
    [[ "$status" == *"Building"* ]]
}
if akmods_building; then
    echo "Waiting for akmods to complete kernel module builds..."
    echo "(Press Ctrl+C to cancel)"

    count=0
    while akmods_building && [ "$count" -lt 60 ]; do
        sleep 5
        count=$((count + 1))
        echo -n "."
    done
    echo ""
    
    if [ $count -ge 60 ]; then
        echo "Warning: akmods took longer than 5 minutes, proceeding anyway"
    else
        echo "Kernel modules built successfully."
    fi
fi

# Warn, count down, warn at one minute — as the user, through ccy-sessions, so the signals
# reach each project's own daemon. The power action itself is root's: `systemctl reboot`
# as the user is refused by polkit on a session that is not local and active, which an SSH
# login is not, and this command is as likely to be run over SSH as not.
echo "Warning running ccy/cc sessions: $MODE in $REBOOT_MINUTES minute(s)..."
# Set BEFORE the notify: one that fails part-way has already reached some projects.
SESSIONS_WARNED=true
trap withdraw_unless_down EXIT
warn_sessions "$REBOOT_MINUTES"
if [ "$REBOOT_MINUTES" -gt 1 ]; then
    countdown $(((REBOOT_MINUTES - 1) * MINUTE_SECONDS))
    warn_sessions 1
    echo "${MODE^} in 1 minute..."
fi
countdown "$MINUTE_SECONDS"

if [ "${#FAILED_STEPS[@]}" -gt 0 ]; then
    failed_list="$(printf '%s, ' "${FAILED_STEPS[@]}")"
    summary="update steps that failed before the $MODE: ${failed_list%, }"
    echo "Warning: $summary (journalctl -t shutdown-with-update)" >&2
    journal "$summary"
else
    echo "Every update step succeeded."
fi

# The Ctrl-C window is over. While a power action runs, a TERM is the shutdown reaching this
# process, not a cancellation, so it is ignored; letting it exit would withdraw the warning
# from sessions that are about to go down. A refused action still exits non-zero.
trap '' INT TERM

if [ "$MODE" = "reboot" ]; then
    echo "Rebooting..."
    if systemctl reboot; then
        exit 0
    fi
    if [ "$STRICT_SESSIONS" = true ]; then
        exit 1
    fi
    echo "Reboot refused (see above); forcing it past inhibitors, as a desktop always reboots..." >&2
    systemctl reboot -i
    exit 0
fi

echo "Attempting shutdown..."
if ! shutdown -h now 2>&1; then
    echo ""
    echo "Shutdown blocked by inhibitors or logged-in users."
    echo "Current inhibitors:"
    # Listing them is for the reader; a failed listing must not stop the forced shutdown.
    if ! systemd-inhibit --list --no-pager | awk '!/^WHO/'; then
        echo "(the inhibitors could not be listed)" >&2
    fi
    echo ""
    if [ "$STRICT_SESSIONS" = false ]; then
        echo "Forcing shutdown past them, as a desktop always shuts down..." >&2
        systemctl poweroff -i
        exit 0
    fi
    # Nothing is going down now, so the force prompt is interruptible again.
    trap 'exit 130' INT TERM
    read -p "Force shutdown anyway? (y/N): " -n 1 -r
    echo ""
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        echo "Forcing shutdown..."
        trap '' INT TERM
        systemctl poweroff -i
    else
        echo "Shutdown cancelled. The machine stays up." >&2
        exit 1
    fi
fi