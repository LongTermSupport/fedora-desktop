#!/usr/bin/env bash
# resuspend-aborted-suspend — make a suspend request durable.
# Managed by Ansible (play-suspend-and-lid-policy.yml) — do not edit on the host.
#
# systemd runs this as /usr/lib/systemd/system-sleep/<name> with:
#   $1 = pre|post          $2 = suspend|hibernate|hybrid-sleep|suspend-then-hibernate
#
# THE PROBLEM (Plan 00104): a wakeup event arriving during the s2idle transition aborts the
# suspend. logind handles the lid as an EVENT, so a machine whose lid was already shut gets
# no re-evaluation and simply stays awake — in a bag, at full load. Asking for suspend and
# silently not getting it is the defect; this makes the request stick.
#
# THE TEST — both must hold, or we do nothing:
#   1. The resume happened within RESUSPEND_WINDOW seconds of the suspend.
#   2. The lid is KNOWN to be closed (not merely "not known to be open").
#
# Condition 1 is load-bearing and 2 alone is NOT sufficient: a docked laptop is routinely used
# lid-shut on external monitors, and waking it from the keyboard would otherwise be undone.
#
# Re-suspend is scheduled ASYNCHRONOUSLY via systemd-run. Calling `systemctl suspend` inline
# would deadlock: systemd-suspend.service runs every hook in this directory and does not
# continue until they all finish (man 8 systemd-suspend.service).
#
# HIBERNATE IS DELIBERATELY EXCLUDED. Kernel lockdown restricts hibernation on this host
# ("Lockdown: systemd-logind: hibernation is restricted"), so it is not a state this machine
# reaches, and re-issuing a suspend after a hibernate resume would be a different decision
# from the one the user made. Add it here only with evidence that it is wanted.

set -euo pipefail

# Derived from the measured failure, not from taste: Plan 00104 F1 recorded
# `PM: suspend entry` at 11:40:49 and the abort at 11:40:52 — ~3 seconds. The window is that
# plus margin. It is deliberately TIGHT: every extra second is false-positive surface on the
# operator's daily configuration (docked, lid shut, external monitors), where a suspend is
# always an explicit request and a wake is always deliberate.
readonly RESUSPEND_WINDOW=10
readonly RESUSPEND_DELAY=5        # seconds to wait after resume before re-issuing suspend
readonly MAX_ATTEMPTS=3           # give up rather than loop hot against a persistent waker
readonly STALE_COUNT_AFTER=600    # seconds; see the `pre` branch — expiry for the give-up
readonly STAMP=/run/resuspend-aborted-suspend.stamp
readonly COUNT=/run/resuspend-aborted-suspend.count

log() { /usr/bin/logger -t resuspend-aborted-suspend "$*"; }

# Read a state file only if it holds a non-empty integer. Existence is not enough: an empty or
# truncated file would make the arithmetic below a bash syntax error, killing the hook under
# `set -e` — the "existence treated as valid content" trap in CLAUDE/AgentNotes.md.
read_int_or_empty() {
    local path="$1" value=""
    [[ -r "$path" ]] || return 0
    value="$(< "$path")"
    [[ "$value" =~ ^[0-9]+$ ]] || return 0
    printf '%s' "$value"
}

case "${2:-}" in
    suspend | suspend-then-hibernate | hybrid-sleep) ;;
    *) exit 0 ;;
esac

if [[ "${1:-}" == "pre" ]]; then
    # Expire a stale give-up before recording this suspend.
    #
    # WHY THIS IS NOT OPTIONAL: COUNT is otherwise cleared only by a resume outside the window
    # or an observed OPEN lid. On a machine used docked and lid-shut, neither may happen for
    # hours. So one false-positive burst — suspend, change your mind, wake from the external
    # keyboard, three times — would leave layer 2 permanently inert, and the NEXT genuine
    # abort (the bag incident this exists to catch) would be met with "giving up" and nothing
    # else. A suspend requested long after the previous one is a FRESH incident.
    #
    # The retry's own `pre` fires RESUSPEND_DELAY (~5-8s) after the last one, far inside
    # STALE_COUNT_AFTER, so a genuine retry burst does not clear its own counter.
    previous="$(read_int_or_empty "$STAMP")"
    if [[ -n "$previous" ]] && (( $(/usr/bin/date +%s) - previous > STALE_COUNT_AFTER )); then
        rm -f "$COUNT"
    fi
    /usr/bin/date +%s > "$STAMP"
    exit 0
fi

[[ "${1:-}" == "post" ]] || exit 0

slept_at="$(read_int_or_empty "$STAMP")"
if [[ -z "$slept_at" ]]; then
    log "no usable suspend timestamp at ${STAMP}: cannot tell whether this resume was spurious, so taking no action (layer 2 inactive for this cycle)"
    exit 0
fi

elapsed=$(( $(/usr/bin/date +%s) - slept_at ))

# A negative elapsed means the clock stepped backwards across the resume (RTC correction, NTP
# step). The value is then meaningless, and `elapsed > WINDOW` would be false — so without
# this the hook would proceed to act on nonsense.
if (( elapsed < 0 )); then
    log "clock moved backwards across resume (elapsed=${elapsed}s); cannot judge whether this resume was spurious, so taking no action"
    exit 0
fi

if (( elapsed > RESUSPEND_WINDOW )); then
    # A normal, wanted wake. Reset the attempt counter so a later genuine abort starts fresh.
    rm -f "$COUNT"
    exit 0
fi

# ACPI FIRST, logind second. This ordering is a correctness fix, not a preference.
#
# /proc/acpi/button/lid/*/state is a LIVE read of the hardware. logind's LidClosed is a
# CACHED property, updated when logind processes an evdev SW_LID event — and whether it has
# done so by the time the `post` hooks run is not guaranteed. If it has not, a user who woke
# the machine by opening the lid gets LidClosed=true, elapsed is a few seconds, and this hook
# suspends the laptop they just opened. Reading ACPI first removes that race entirely.
#
# logind remains the fallback because /proc/acpi/button/lid does not exist on every machine,
# and "the glob did not match" must NOT be read as "the lid is open" — that would silently
# disable layer 2 while logging that the user is present. This play is imported for every
# host, including ones with no lid at all.
lid_closed="unknown"
for f in /proc/acpi/button/lid/*/state; do
    [[ -r "$f" ]] || continue
    if [[ "$(< "$f")" == *closed* ]]; then lid_closed="yes"; else lid_closed="no"; fi
    break
done

if [[ "$lid_closed" == "unknown" ]]; then
    # --timeout=2 matters: busctl defaults to 25s, and this runs inside a hook that
    # systemd-suspend.service blocks on, so an unresponsive logind would stall the resume.
    if lid_prop="$(/usr/bin/busctl --timeout=2 get-property org.freedesktop.login1 \
            /org/freedesktop/login1 org.freedesktop.login1.Manager LidClosed 2>&1)"; then
        case "$lid_prop" in
            *true*) lid_closed="yes" ;;
            *false*) lid_closed="no" ;;
        esac
    fi
fi

# Every arm is explicit, including the one that proceeds. Re-suspending is the most
# consequential branch here, so it must be reached deliberately rather than by falling out of
# the bottom of a case — and an unanticipated value must stop, not continue.
case "$lid_closed" in
    yes)
        : # lid confirmed closed — fall through to the re-suspend decision below
        ;;
    no)
        log "resumed after ${elapsed}s but the lid is open — user is present, leaving awake"
        rm -f "$COUNT"
        exit 0
        ;;
    unknown)
        log "resumed after ${elapsed}s but the lid state could NOT be determined (no readable /proc/acpi/button/lid interface and the logind query failed) — taking no action rather than guessing"
        exit 0
        ;;
    *)
        log "internal error: unexpected lid state '${lid_closed}' — taking no action"
        exit 0
        ;;
esac

attempts="$(read_int_or_empty "$COUNT")"
: "${attempts:=0}"

if (( attempts >= MAX_ATTEMPTS )); then
    # NOT resetting the counter here. Deleting it would make "giving up" last exactly one
    # cycle, so a persistently-waking machine would restart a full burst on every subsequent
    # suspend, forever. The counter is cleared on the success path above (a resume outside the
    # window), which is the only event meaning the problem has actually stopped.
    log "suspend aborted ${attempts}x in a row within ${RESUSPEND_WINDOW}s each; giving up until a normal resume is seen. Something is holding the system awake — check 'systemd-inhibit --list' and /sys/kernel/debug/wakeup_sources."
    exit 0
fi

echo $(( attempts + 1 )) > "$COUNT"
log "suspend aborted after ${elapsed}s with the lid closed (attempt $(( attempts + 1 ))/${MAX_ATTEMPTS}) — re-suspending in ${RESUSPEND_DELAY}s"

# --collect is REQUIRED, not cosmetic. The unit name is fixed, and without --collect a failed
# run stays loaded in failed state, after which every later systemd-run with the same name
# fails outright — permanently disabling this hook. The most likely failure is documented in
# this plan's own evidence (F12): ssh-suspend-guard holds a block-mode sleep inhibitor while
# an inbound SSH session exists, and logind refuses the suspend. That refusal is correct
# behaviour and must not wedge anything.
if ! /usr/bin/systemd-run \
        --collect \
        --on-active="${RESUSPEND_DELAY}" \
        --timer-property=AccuracySec=1s \
        --unit=resuspend-aborted-suspend-retry \
        /usr/bin/systemctl suspend; then
    log "failed to schedule the re-suspend timer; layer 2 did not fire this cycle"
fi
