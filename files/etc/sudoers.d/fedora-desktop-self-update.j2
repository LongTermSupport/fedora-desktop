# {{ ansible_managed }}
# Plan 00137: the owner may start the self-update cycle by hand, and nothing else. The
# rule names one root-owned, user-unwritable command. With no argument list, sudo allows
# any arguments to it; the script is what refuses an unknown subcommand. This grants no
# general root.
{{ user_login }} ALL=(root) NOPASSWD: /usr/local/sbin/fedora-desktop-self-update
