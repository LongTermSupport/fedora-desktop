# {{ ansible_managed }}
# Plan 00137 — the unattended self-update cycle's configuration. KEY=value, one per line.
# Read with `read` by /usr/local/sbin/fedora-desktop-self-update and never sourced.
# Edit host_vars and re-run playbooks/imports/optional/common/play-self-update.yml, not
# this file.
USER={{ user_login }}
BRANCH={{ self_update_branch }}
REMOTE_URL={{ self_update_remote_url }}
PRINCIPAL={{ self_update_signing_principal }}
WARN_MINUTES={{ self_update_warn_minutes | default(3) }}
ALERT_SINKS={{ 'slack' if (self_update_slack_webhook_url | default('')) | length > 0 else '' }}
ANSIBLE_COLLECTIONS_DIR={{ self_update_collections_dir }}
