// {{ ansible_managed }}
// Plan 00109 Task 5.4a: the dock-recovery-on-unlock GNOME extension starts the DisplayLink
// dock recovery service when the screen is unlocked. This lets the desktop user START that
// one unit, from their own active local session, without a password prompt. It grants
// nothing else: no stop or restart, no other unit, and nothing to an SSH or background
// session.
polkit.addRule(function (action, subject) {
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") === "displaylink-dock-recovery.service" &&
        action.lookup("verb") === "start" &&
        subject.user === "{{ user_login }}" &&
        subject.local && subject.active) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
