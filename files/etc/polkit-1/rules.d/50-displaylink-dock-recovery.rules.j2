// {{ ansible_managed }}
// Plan 00109 Task 5.4a: the dock-recovery-on-unlock GNOME extension starts the DisplayLink
// dock recovery service when the screen is unlocked. This lets the desktop user START that
// one unit, from their own active local session, without a password prompt. No stop or
// restart, no other unit, and nothing for an SSH or background session.
// What one start does is the recovery's call, and it runs as root: while docked it
// repaints the background, and a head that looks wedged gets a driver restart, a USB
// re-authorisation or an evdi module reload. The desktop user can set all of that off.
polkit.addRule(function (action, subject) {
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") === "displaylink-dock-recovery.service" &&
        action.lookup("verb") === "start" &&
        subject.user === "{{ user_login }}" &&
        subject.local && subject.active) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
