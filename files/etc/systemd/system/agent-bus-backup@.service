# Back up the agent team bus homeserver of team %i (Plan 00161, DESIGN.md section 3.7):
# SIGUSR2 makes Tuwunel run admin_signal_execute (server backup-database); the installer
# waits for the new numbered backup and adds a root-only tar of the team's secrets and state
# beside it. Fails when the homeserver is not running, or when no backup appears.
[Unit]
Description=Back up the agent team bus homeserver of team %i
Requisite=agent-bus-hs@%i.service
After=agent-bus-hs@%i.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/agent-bus-install backup-now --team %i
