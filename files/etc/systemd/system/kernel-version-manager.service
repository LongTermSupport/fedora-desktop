[Unit]
Description=Kernel Minor Version Manager
Documentation=file:///usr/local/bin/manage-kernel-versions.py
# After multi-user.target, which wants this unit: it runs dnf, which can wait on the dnf
# lock or the network, and boot must not wait for it (CLAUDE/QA.md unit-holds-boot-target).
After=local-fs.target multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/bin/manage-kernel-versions.py
Environment="NOTIFY_USER={{ user_login }}"
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kernel-version-manager

[Install]
WantedBy=multi-user.target
