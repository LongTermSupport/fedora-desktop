# The agent team bus homeserver (Tuwunel) of team %i (Plan 00161, DESIGN.md section 3.5).
# Installed by agent-bus-install software. The per-team drop-in
# agent-bus-hs@<team>.service.d/network.conf, rendered by `agent-bus render dropin`, adds the
# IP allow list, the socket-bind allow, the restart policy and the listen interfaces' device
# dependencies. The deny-all lines below hold even if that drop-in is missing: the unit
# then reaches nothing and binds nothing.
[Unit]
Description=Agent team bus homeserver for team %i
After=network-online.target
Wants=network-online.target

[Service]
# Tuwunel's systemd feature (on in the release asset) sends READY=1 once its database is open,
# so `active` means ready, and pings the watchdog every WatchdogSec/2 (src/router/run.rs). A
# homeserver that stops pinging (frozen, starved) is sent SIGABRT, then SIGKILL after
# TimeoutAbortSec, since a stopped process holds the SIGABRT pending; the drop-in restarts it.
Type=notify
NotifyAccess=main
WatchdogSec=30s
TimeoutAbortSec=30s
User=agent-bus
Group=agent-bus
Environment=TUWUNEL_CONFIG=/var/lib/agent-bus/%i/tuwunel.toml
ExecStart=/usr/local/lib/agent-bus/tuwunel
TimeoutStopSec=330
UMask=0077

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/agent-bus/%i
# Every team's homeserver runs as the one agent-bus user, so its own team's directory is all
# it may see of /var/lib/agent-bus: an empty read-only tmpfs over the root with that one
# directory bound back (systemd.exec(5), TemporaryFileSystem= and BindPaths=). Its own PID
# namespace hides a sibling team's homeserver, whose /proc/<pid>/root and ptrace would
# otherwise reach that team's secrets as the same user (PrivatePIDs=, systemd 257).
TemporaryFileSystem=/var/lib/agent-bus:ro
BindPaths=/var/lib/agent-bus/%i
PrivatePIDs=yes
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAccounting=yes
IPAddressDeny=any
SocketBindDeny=any

# No resolver: /etc/resolv.conf is a symlink into /run/systemd/resolve/ on Fedora, so an
# empty read-only tmpfs goes over that directory and the stub (nameserver 127.0.0.1, where
# nothing listens) is bound onto both files a lookup could read. D-Bus is hidden too.
TemporaryFileSystem=/run/systemd/resolve:ro
BindReadOnlyPaths=/usr/local/share/agent-bus/resolv.conf:/run/systemd/resolve/stub-resolv.conf
BindReadOnlyPaths=/usr/local/share/agent-bus/resolv.conf:/run/systemd/resolve/resolv.conf
InaccessiblePaths=-/run/dbus

[Install]
WantedBy=multi-user.target
